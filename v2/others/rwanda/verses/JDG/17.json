          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mika yiremera ibishushanyo bisengwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hariho umugabo wo mu gihugu cy'imisozi miremire ya Efurayimu witwaga Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.1",
            "verseOrgIds": [
              "JDG.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabwiye nyina ati “Bya bice by'ifeza igihumbi n'ijana wibwe bigatuma uvumana nkumva uvumana, ndabifite ni jye wabyibye.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyina aravuga ati “Umwana wanjye nahirwe ku Uwiteka.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko asubiza nyina bya bice by'ifeza igihumbi n'ijana, nyina aravuga ati “Ni ukuri izi feza mfite mu ntoki nzereje Uwiteka, kugira ngo umuhungu wanjye azikoreshemo igishushanyo kibajwe n'igishushanyo cy'ibyuma biyagijwe, noneho ndazigushubije.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.3",
            "verseOrgIds": [
              "JDG.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze gusubiza nyina izo feza, nyina yenda ibice by'ifeza magana abiri abishyira umucuzi, azikoramo igishushanyo kibajwe n'igishushanyo cy'ibyuma biyagijwe, nuko biba mu nzu ya Mika.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.4",
            "verseOrgIds": [
              "JDG.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.4",
            "verseOrgIds": [
              "JDG.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi uwo mugabo Mika yari afite inzu yitaga iy'imana, aremesha efodi na terafimu, yereza umwe wo mu bahungu be, ngo abe umutambyi we. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.5",
            "verseOrgIds": [
              "JDG.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.21.25"
              },
              "items": [
                {
                  "text": "Abac 21.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muri iyo minsi Abisirayeli nta mwami bari bafite, umuntu wese yakoraga icyo ashatse.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.6",
            "verseOrgIds": [
              "JDG.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.6",
            "verseOrgIds": [
              "JDG.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Betelehemu y'i Buyuda habagayo umusore w'Umulewi wo mu muryango wa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.7",
            "verseOrgIds": [
              "JDG.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye ava muri uwo mudugudu w'i Betelehemu y'i Buyuda, ajya gushaka aho yasuhukira ajya mu gihugu cy'imisozi miremire ya Efurayimu. Nuko akigenda arasukira kwa Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.8",
            "verseOrgIds": [
              "JDG.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika aramubaza ati “Uraturuka he?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.9",
            "verseOrgIds": [
              "JDG.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramusubiza ati “Ndi Umulewi w'i Betelehemu y'i Buyuda, kandi ndagenda nshaka aho nasuhukira.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.9",
            "verseOrgIds": [
              "JDG.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.9",
            "verseOrgIds": [
              "JDG.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mika aramubwira ati “Ihamiraho umbere data n'umutambyi, nanjye nzajya nguha ibice by'ifeza cumi mu mwaka n'imyambaro n'ibyokurya.” Nuko uwo musore w'Umulewi ajya mu rugo ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.10",
            "verseOrgIds": [
              "JDG.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "yemera kubana na Mika, amubera nk'umwana we. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.11",
            "verseOrgIds": [
              "JDG.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Mika yeza uwo Mulewi ahinduka umutambyi we, akaba mu rugo rwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.12",
            "verseOrgIds": [
              "JDG.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mika aherako aravuga ati “None menye ko Uwiteka azangirira neza, kuko mfite Umulewi ho umutambyi.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.13",
            "verseOrgIds": [
              "JDG.17.13"
            ]
          }
        }
      ]
    }
  ],
