              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Manowa abwira umugore we ati “Ni ukuri turapfa kuko turebye Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
