          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nta bundi marayika w'Uwiteka yongeye kwiyereka Manowa cyangwa umugore we. Ubwo Manowa amenya ko ari marayika w'Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.21",
            "verseOrgIds": [
              "JDG.13.21"
            ]
