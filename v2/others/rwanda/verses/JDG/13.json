          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko hanyuma y'ibyo, umugore abyara umuhungu amwita Samusoni. Umwana arakura, Uwiteka amuha umugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
