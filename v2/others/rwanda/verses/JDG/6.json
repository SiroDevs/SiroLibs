{
  "id": "JDG.6",
  "number": "6",
  "bookId": "JDG",
  "reference": "Abacamanza 6",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "JDG 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abisirayeli baneshwa n'Abamidiyani, Uwiteka ababwira impamvu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bakora ibyangwa n'Uwiteka, Uwiteka abahāna mu maboko y'Abamidiyani imyaka irindwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.1",
            "verseOrgIds": [
              "JDG.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abamidiyani banesha Abisirayeli, batera Abisirayeli gushaka aho kwihisha mu bihanamanga byo mu misozi no mu mavumo no mu bihome. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.2",
            "verseOrgIds": [
              "JDG.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Abisirayeli barangizaga kubiba, Abamidiyani bakazamukana n'Abamaleki n'ab'iburasirazuba bakabatera, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.3",
            "verseOrgIds": [
              "JDG.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakagandikayo bagasiribanga imyaka yabo ukageza i Gaza, ntibabasigire na ruminja naho yaba intama cyangwa inka cyangwa indogobe mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.4",
            "verseOrgIds": [
              "JDG.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazamukanaga n'amatungo yabo n'amahema yabo basa n'amarumbo y'inzige, ubwabo n'ingamiya zabo ntibyagiraga umubare, bazanwaga no kurimbura icyo gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.5",
            "verseOrgIds": [
              "JDG.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abisirayeli bariheba cyane ku bw'Abamidiyani, baherako batakambira Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo gihe Abisirayeli batakambiye Uwiteka ku bw'Abamidiyani, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.7",
            "verseOrgIds": [
              "JDG.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abatumaho umuhanuzi arababwira ati “Uwiteka Imana y'Abisirayeli ivuze iti ‘Nabakuye muri Egiputa no mu nzu y'uburetwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.8",
            "verseOrgIds": [
              "JDG.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko mbakiza amaboko y'Abanyegiputa n'amaboko y'ababarenganyaga bose mbirukana imbere yanyu, mbaha igihugu cyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.9",
            "verseOrgIds": [
              "JDG.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndababwira nti: Ndi Uwiteka Imana yanyu, mwe kubaha imana z'Abamori bene iki gihugu murimo, ariko mwanga kunyumvira.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imana itoranya Gideyoni kuba umukiza w'Abisirayeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko marayika w'Uwiteka araza yicara munsi y'igiti cy'umwela, cyari muri Ofura kwa Yowasi w'Umwabiyezeri. Umuhungu we Gideyoni yasekuraga ingano mu muvure bengeramo vino, ngo azihishe Abamidiyani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.11",
            "verseOrgIds": [
              "JDG.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marayika w'Uwiteka aramubonekera aramubwira ati “Uwiteka ari kumwe nawe wa munyambaraga we, ugira n'ubutwari.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideyoni aramusubiza ati “Mutware, niba Uwiteka ari kumwe natwe ni iki gituma ibyo byose bitubaho? N'imirimo ye yose itangaza iri he, iyo ba sogokuruza batubwiye ngo ‘Uwiteka ni we wadukuye muri Egiputa?’ Ariko noneho Uwiteka yaradutaye, yatugabije Abamidiyani.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Uwiteka aramwitegereza aramubwira ati “Genda uko izo mbaraga zawe zingana, ukize Abisirayeli amaboko y'Abamidiyani. Si jye ugutumye?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideyoni aramusubiza ati “Ariko Uwiteka, Abisirayeli nabakirisha iki? Iwacu ko turi aboroheje mu muryango wa Manase, nkaba ndi umuhererezi mu nzu ya data yose.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka aramubwira ati “Ni ukuri nzabana nawe, kandi uzanesha Abamidiyani nk'unesha umuntu umwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideyoni aramusubiza ati “Niba mpiriwe mu maso yawe, nyereka ikimenyetso kimpamiriza ko ari wowe tuvuganye.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.17",
            "verseOrgIds": [
              "JDG.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideyoni arongera aravuga ati “Ndakwinginze ntuve aha, kugeza aho ndi bugarukire nkuzaniye ituro nkarishyira imbere yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marayika aramusubiza ati “Ndaguma aha kugeza aho uri bugarukire.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideyoni ajya iwe abaga umwana w'ihene, akora n'udutsima tudasembuye twa efa y'ifu. Inyama azishyira mu cyibo, umufa wazo awusuka mu rwabya, abimusangisha munsi y'igiti cy'umwela aramuhereza.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze marayika w'Imana aramubwira ati “Enda iyi nyama n'utwo dutsima ubishyire hejuru y'iki gitare, usukeho n'umufa wazo.” Nuko abigenza atyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.20",
            "verseOrgIds": [
              "JDG.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma marayika w'Uwiteka atunga ipfundo ry'inkoni yari yitwaje, arikoza ku nyama n'utwo dutsima. Uwo mwanya umuriro uva mu gitare, utwika izo nyama n'utwo dutsima. Nuko marayika w'Uwiteka aramubura, ntiyongera kuboneka imbere ye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Gideyoni amenye ko ari marayika w'Uwiteka aravuga ati “Ni ishyano Mwami Imana, kuko mbonye mu maso ha marayika w'Uwiteka, turebanye.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Uwiteka aramubwira ati “Humura, witinya ntupfa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideyoni aherako yubakira Uwiteka igicaniro aho ngaho akita Yehovashalomu, kiracyari ku musozi Ofura w'Abiyezeri na bugingo n'ubu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gideyoni asenya igicaniro cya Bāli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ijoro ry'uwo munsi Uwiteka aramubwira ati “Enda impfizi ya so ntoya, wende n'indi ya kabiri imaze imyaka irindwi, maze usandaze igicaniro so yubakiye Bāli, uteme Ashera",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ashera:",
              "type": "text"
            },
            {
              "text": "reba Kuva 34.13.",
              "type": "text"
            }
          ]
        },
        {
          "text": " iri hafi yacyo, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze wubakire Uwiteka Imana yawe igicaniro ku kanunga kubatsweho igihome ubyitondeye, kandi wende impfizi ya kabiri uyitambeho igitambo cyoswa, ucyosheshe inkwi za Ashera uri buteme.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Gideyoni ajyana abagabo icumi bo mu bagaragu be, abigenza nk'uko Uwiteka yamutegetse. Ariko yabikoze nijoro ntiyatinyutse kubikora ku manywa, kuko yatinyaga abo mu muryango wa se n'abatuye muri uwo mudugudu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye bwaho abo muri uwo mudugudu babyutse mu gitondo kare, basanga igicaniro cya Bāli gisandaye na Ashera yari hafi yacyo yaguye, n'impfizi ya kabiri yatambwe hejuru y'igicaniro cyubatswe muri iryo joro. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.28",
            "verseOrgIds": [
              "JDG.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabazanya bati “Ni nde wakoze ibi?” Barabibaririza bamenya ko ari Gideyoni mwene Yowasi wabikoze. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.29",
            "verseOrgIds": [
              "JDG.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abo muri uwo mudugudu babwira Yowasi bati “Sohora umuhungu wawe apfe kuko yasandaje igicaniro cya Bāli, agatema Ashera yari hafi yacyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowasi asubiza abamuhagurukiye bose ati “Murashaka kuburanira Bāli, cyangwa murashaka kumukiza?” Ati “Ushaka kumuburanira bamwice hakiri kare. Niba ari imana niyiburanire kuko basandaje igicaniro cyayo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.31",
            "verseOrgIds": [
              "JDG.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye uwo munsi Yowasi yita Gideyoni Yerubāli avuga ati “Bāli nimurege” kuko yasandaje igicaniro cyayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gideyoni asaba umuhamya, ngo amenye ko ari we Imana itoranyije gukiza Abisirayeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamidiyani bose n'Abamaleki n'ab'iburasirazuba bateranira hamwe, barambuka bagandika mu kibaya cy'i Yezerēli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.33",
            "verseOrgIds": [
              "JDG.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana iha Gideyoni ku mwuka wayo aherako avuza ikondera, Ababiyezeri bateranyirizwa aho ari. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuma impuruza mu gihugu cya Manase cyose na bo bateranira aho ari, atuma izindi mu Bashēri no mu Bazebuluni no mu Banafutali, barazamuka ngo bahure.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideyoni abwira Imana ati “Niba uzakirisha Abisirayeli ukuboko kwanjye nk'uko wavuze, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.36",
            "verseOrgIds": [
              "JDG.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "dore ngiye kurambika ubwoya bw'intama ku mbuga. Ninsanga ikime gitonze ku bwoya gusa ahandi hose habukikije humye, nzamenyeraho yuko ushaka gukirisha Abisirayeli ukuboko kwanjye nk'uko wavuze.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.37",
            "verseOrgIds": [
              "JDG.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko biba bityo. Gideyoni azindutse mu gitondo kare asanga bwanese, arabukamura avanamo amazi y'ikime yuzura imbehe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.38",
            "verseOrgIds": [
              "JDG.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideyoni arongera abwira Imana ati “Ntundakarire mvuge rimwe gusa: ndakwinginze nongere ngeragereshe ubu bwoya. Noneho ubutaka bwose buneteshwe n'ikime, ariko ubwoya abe ari bwo busigara bwumye.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.39",
            "verseOrgIds": [
              "JDG.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Imana ibigenza ityo muri iryo joro ubwoya bwonyine burakakara, ubutaka bwose buratota.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.40",
            "verseOrgIds": [
              "JDG.6.40"
            ]
          }
        }
      ]
    }
  ],
