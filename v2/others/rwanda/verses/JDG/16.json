          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bene se n'abo mu rugo rwa se bose baramanuka bajyana umurambo we, barawuzamukana bawuhamba hagati y'i Sora na Eshitawoli, mu gituro aho se Manowa yahambwe. Samusoni yari amaze imyaka makumyabiri ari umucamanza w'Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
    }
