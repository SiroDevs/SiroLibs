                "loc": "REV.22.10"
              },
              "items": [
                {
                  "text": "Ibyah 22.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nuko Daniyeli, bumba igitabo ugifatanishe ikimenyetso kugeza igihe cy'imperuka, benshi bazajarajara hirya no hino kandi ubwenge buzagwira.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko jyewe Daniyeli nditegereza mbona abandi bagabo babiri bahagaze, umwe ku nkombe yo hakuno y'uruzi, undi ku yo hakurya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.5",
            "verseOrgIds": [
              "DAN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe abaza wa mugabo wari wambaye umwenda w'igitare wari hejuru y'amazi y'urwo ruzi ati “Ibyo bitangaza bizagarukira he?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
            "verseOrgIds": [
              "DAN.12.6"
            ]
          }
        }
      ]
    },
