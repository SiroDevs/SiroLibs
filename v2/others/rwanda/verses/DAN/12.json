          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko igendere utegereze imperuka, kuko uzaruhuka kandi ukazahagarara mu mugabane wawe iyo minsi nishira.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
