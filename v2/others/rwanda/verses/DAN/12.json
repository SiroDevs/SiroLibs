                "loc": "REV.12.14"
              },
              "items": [
                {
                  "text": "12.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbona wa mugabo wari wambaye umwenda w'igitare wari hejuru y'amazi y'uruzi, atunga ukuboko kw'iburyo n'ukw'imoso ku ijuru, numva arahira Ihoraho iteka ryose ngo bizamara igihe n'ibihe n'igice cy'igihe kandi ati “Nibamara kumenagura imbaraga z'abera, ibyo byose bizaherako birangire.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.7",
            "verseOrgIds": [
              "DAN.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
