              ]
            }
          ]
        },
        {
          "text": " “Uhereye igihe ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "text": " gihoraho kizakurirwaho bagashyiraho ikizira cy'umurimbuzi, hazacaho iminsi igihumbi na magana abiri na mirongo urwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahirwa uzategereza, akageza ku minsi igihumbi na magana atatu na mirongo itatu n'itanu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        }
      ]
