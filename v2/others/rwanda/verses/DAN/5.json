          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi ibyanditswe ni byo ibi: Mene Mene Tekeli Ufarisini. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bisobanurwa bitya: Mene bisobanurwa ngo Imana ibaze imyaka umaze ku ngoma, iyishyiraho iherezo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tekeli bisobanurwa ngo: wapimwe mu bipimo, ugaragara ko udashyitse. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.27",
            "verseOrgIds": [
              "DAN.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Perēsi bisobanurwa ngo: ubwami bwawe buragabwe, buhawe Abamedi n'Abaperesi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.28",
            "verseOrgIds": [
              "DAN.5.28"
            ]
          }
        }
      ]
