              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo bishize, umwami yogeza Saduraka na Meshaki na Abedenego mu gihugu cy'i Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.30",
