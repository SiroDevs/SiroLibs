    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dawidi yihanangiriza abantu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi yateranirije i Yerusalemu abatware ba Isirayeli bose, n'abatware b'imiryango n'abatware b'imitwe yakoreraga umwami bafata ibihe, n'abatware batwara ibihumbi n'abatwara amagana, n'abatware b'ibintu byose n'amatungo by'umwami, n'abahungu be n'inkone, n'abagabo b'abanyambaraga b'intwari bose.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.1",
            "verseOrgIds": [
              "1CH.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
