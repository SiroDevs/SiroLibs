          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Neri abyara Kishi, Kishi abyara Sawuli, Sawuli abyara Yonatani na Malikishuwa, na Abinadabu na Eshibāli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhungu wa Yonatani ni Meribāli, Meribububāli abyara Mika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
