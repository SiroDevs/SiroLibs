        "style": "s1"
      },
      "items": [
        {
          "text": "Abakomoka kuri Simiyoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
