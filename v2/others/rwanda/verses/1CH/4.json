        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.33",
            "verseOrgIds": [
              "1CH.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshobabu na Yamuleki na Yosha mwene Amasiya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
            "verseOrgIds": [
              "1CH.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yoweli na Yehu mwene Yoshibiya mwene Seraya mwene Asiyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Eliyowenayi na Yākoba na Yeshohaya, na Asaya na Adiyeli na Yesimiyeli na Benaya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ziza mwene Shifi mwene Aloni, mwene Yedaya mwene Shimuri mwene Shemaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bavuzwe mu mazina bari abatware mu miryango yabo, kandi amazu ya ba sekuruza babo aragwira cyane.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.38",
            "verseOrgIds": [
              "1CH.4.38"
            ]
          }
        }
      ]
    },
