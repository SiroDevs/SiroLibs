                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uko ni ko Sawuli yatanze azize gucumura yacumuye ku Uwiteka, kuko atitondeye ijambo ry'Uwiteka, kandi kuko yashikishije umushitsi ngo amuhanuze, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntahanuze Uwiteka. Ni cyo cyatumye amutangisha, ubwami akabugabira Dawidi mwene Yesayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
