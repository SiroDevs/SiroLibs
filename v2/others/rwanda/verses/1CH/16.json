            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu bose baherako barataha umuntu wese ajya iwe, Dawidi asubira iwe ajya gusabira inzu ye umugisha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
            "verseOrgIds": [
