          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Shamoti w'Umuharari na Helesi w'Umupeloni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.27",
            "verseOrgIds": [
              "1CH.11.27"
            ]
