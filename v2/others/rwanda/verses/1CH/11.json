              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yari afite icyubahiro kuruta ba bandi mirongo itatu, ariko ntiyari ahwanye na batatu ba mbere. Dawidi amugira umutware w'abarinzi be.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
