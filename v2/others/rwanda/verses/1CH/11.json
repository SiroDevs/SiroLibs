              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Itayi mwene Ribayi w'i Gibeya y'Ababenyamini, na Benaya w'Umunyapiratoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.31",
            "verseOrgIds": [
