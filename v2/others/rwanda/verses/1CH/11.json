          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hurayi wo ku tugezi tw'i Gāshi na Abiyeli w'Umunyaruba, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.32",
