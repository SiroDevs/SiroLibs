          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Seleki w'Umwamoni, na Naharayi w'i Bēroti utwara intwaro za Yowabu mwene Seruya, ",
          "type": "text",
          "attrs": {
