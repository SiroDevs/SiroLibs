          "type": "text",
          "attrs": {
            "verseId": "1CH.2.53",
            "verseOrgIds": [
              "1CH.2.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 2:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Salima ni Betelehemu n'Abanyanetofa na Atarotibetiyowabu, n'igice cy'Abamanahati n'Abasori.",
          "type": "text",
          "attrs": {
