          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Efa inshoreke ya Kalebu abyara Harani na Mosa na Gazezi, Harani abyara Gazezi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
