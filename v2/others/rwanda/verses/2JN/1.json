    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2JN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jyewe Umukuru ndabandikiye, Kuriya watoranijwe,",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.1",
            "verseOrgIds": [
              "2JN.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kuriya watoranijwe:",
              "type": "text"
            },
            {
              "text": "cyangwa, intore y'umugore.",
              "type": "text"
            }
          ]
        },
        {
          "text": " wowe n'abana bawe, abo nkunda by'ukuri, nyamara si jye jyenyine ubakunda ahubwo n'abazi ukuri bose barabakunda, ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.1",
            "verseOrgIds": [
              "2JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku bw'ukuri kuri muri twe kandi kukazaba muri twe iteka ryose.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.2",
            "verseOrgIds": [
              "2JN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.2",
            "verseOrgIds": [
              "2JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuntu n'imbabazi n'amahoro biva ku Mana Data wa twese no kuri Yesu Kristo Umwana we, bibane namwe mu kuri no mu rukundo.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.3",
            "verseOrgIds": [
              "2JN.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Urukundo rwa kivandimwe n'abigisha b'ibinyoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.3",
            "verseOrgIds": [
              "2JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nishimiye cyane kuko nasanze bamwe mu bana bawe bagendera mu kuri, nk'uko twategetswe na Data wa twese. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.4",
            "verseOrgIds": [
              "2JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.34"
              },
              "items": [
                {
                  "text": "Yoh 13.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.12"
              },
              "items": [
                {
                  "text": "15.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko rero ndakwinginga, mubyeyi (si uko nkwandikira itegeko rishya ahubwo ni iryo dusanganywe, dufite uhereye mbere na mbere) kugira ngo dukundane. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.5",
            "verseOrgIds": [
              "2JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru ni rwo rukundo: ni uko tugenda dukurikiza amategeko ye. Itegeko ry'Imana ngiri: ni uko tugendera mu rukundo nk'uko mwigishijwe uhereye mbere na mbere.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.6",
            "verseOrgIds": [
              "2JN.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.6",
            "verseOrgIds": [
              "2JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko abayobya benshi badutse bakaza mu isi, batemera ko Yesu Kristo yaje afite umubiri. Uvuga atyo ni we uyobya kandi ni we Antikristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.7",
            "verseOrgIds": [
              "2JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwirinde mutabura iby'imirimo mwakoze, ahubwo ngo muzahabwe ingororano itagabanije.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.8",
            "verseOrgIds": [
              "2JN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.8",
            "verseOrgIds": [
              "2JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese urengaho ntagume mu byo Kristo yigishije ntafite Imana, naho uguma mu byo yigishije ni we ufite Data wa twese n'Umwana we. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.9",
            "verseOrgIds": [
              "2JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira uza iwanyu atazanye iyo nyigisho, ntimuzamucumbikire kandi ntimuzamuramutse muti “Ni amahoro”, ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.10",
            "verseOrgIds": [
              "2JN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko uzamuramutsa atyo azaba afatanije na we mu mirimo ye mibi.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo mfite byinshi byo kubandikira sinshatse kubyandikisha wino ku rupapuro, ahubwo niringiye kuzaza iwanyu ngo tuvugane duhanganye, umunezero wacu ube mwinshi.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2JN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana b'intore, mwene so, baragutashya.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.13",
            "verseOrgIds": [
              "2JN.1.13"
            ]
          }
        }
      ]
    }
