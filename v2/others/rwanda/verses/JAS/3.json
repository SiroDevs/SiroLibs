  "reference": "Yakobo 3",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JAS 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uburyo ururimi rutagengwa rwuzuye ubusagwe bwica",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JAS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, ntihakabe benshi muri mwe bashaka kuba abigisha: muzi yuko tuzacirwa urubanza ruruta iz'abandi, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.1",
            "verseOrgIds": [
              "JAS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko twese ducumura muri byinshi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.2",
            "verseOrgIds": [
              "JAS.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "muri byinshi:",
              "type": "text"
            },
            {
              "text": "cyangwa, hato na hato.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Umuntu wese udacumura mu byo avuga aba ari umuntu utunganye rwose, yabasha no gutegeka umubiri we wose. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.2",
            "verseOrgIds": [
              "JAS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore dushyira ibyuma byo kuyobora amafarashi mu kanwa kayo kugira ngo atwumvire, kandi dushobora guhindura n'imibiri yayo yose. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.3",
            "verseOrgIds": [
              "JAS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi dore n'inkuge nubwo zaba ari nini zite, zikagendeshwa n'umuyaga uhuha cyane, ingashya ntoya cyane ni yo izerekeza aho umwerekeza ashaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.4",
            "verseOrgIds": [
              "JAS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ururimi na rwo ni ko ruri: ni urugingo ruto rukirarira ibikomeye.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.5",
            "verseOrgIds": [
              "JAS.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murebe namwe ishyamba naho ari rinini rite, uburyo ritwikwa n'agashashi gato cyane! ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.5",
            "verseOrgIds": [
              "JAS.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi koko ururimi ni umuriro. Yemwe ni ububi bungana n'isi! Ururimi rwashyizwe mu ngingo zacu, ni rwo rwonona umubiri wose, rukongeza kamere yacu yose, na rwo rukongezwa na Gehinomu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.6",
            "verseOrgIds": [
              "JAS.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko amoko yose y'inyamaswa n'ibiguruka n'ibikururuka n'ibyo mu nyanja, abantu babasha kubimenyereza kandi barabimenyereje, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.7",
            "verseOrgIds": [
              "JAS.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ururimi rwo nta muntu wabasha kurumenyereza rwose, ni ububi budatuza, rwuzuye ubusagwe bwica. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.8",
            "verseOrgIds": [
              "JAS.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Itang 1.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Urwo ni rwo dushimisha Umwami Data wa twese, kandi ni rwo tuvumisha abantu baremwe mu ishusho y'Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.9",
            "verseOrgIds": [
              "JAS.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu kanwa kamwe havamo gushima no kuvuma. Bene Data, ibyo ntibikwiriye kumera bityo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.10",
            "verseOrgIds": [
              "JAS.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese ye, amazi meza n'akereta yabasha kuva mu isōko imwe? ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.11",
            "verseOrgIds": [
              "JAS.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, umutini wabasha kwera imbuto za elayo,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.12",
            "verseOrgIds": [
              "JAS.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "elayo",
              "type": "text"
            },
            {
              "text": "ni igiti gisa n'umunzenze, ariko cyera imbuto ziribwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " cyangwa umuzabibu wakwera imbuto z'umutini? Ni ko n'isōko itabasha kuvamo amazi y'umunyu kandi ngo ivemo n'ameza.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.12",
            "verseOrgIds": [
              "JAS.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubwenge buva mu ijuru ubwo ari bwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.12",
            "verseOrgIds": [
              "JAS.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde muri mwe w'umunyabwenge kandi w'umuhanga? Niyerekanishe ingeso nziza imirimo ye, afite ubugwaneza n'ubwenge. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.13",
            "verseOrgIds": [
              "JAS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niba muhorana amakimbirane akaze mu mitima yanyu mugahorana intonganya, ntimukabyiratane ngo mubeshyere ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.14",
            "verseOrgIds": [
              "JAS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene ubwo bwenge si bwo bumanuka buvuye mu ijuru, ahubwo ni ubw'isi, ni ubw'inyamaswabantu ndetse ni ubw'abadayimoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.15",
            "verseOrgIds": [
              "JAS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko aho amakimbirane n'intonganya biri, ari ho no kuvurungana kuri no gukora ibibi byose. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.16",
            "verseOrgIds": [
              "JAS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ubwenge buva mu ijuru, irya mbere buraboneye kandi ni ubw'amahoro, n'ubw'ineza, bwemera kugirwa inama, bwuzuye imbabazi n'imbuto nziza, butarobanura ku butoni",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "butarobanura ku butoni:",
              "type": "text"
            },
            {
              "text": "cyangwa, budashidikanya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi butagira uburyarya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Intandaro z'intambara n'amahane yose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi imbuto zo gukiranuka zibibwa mu mahoro n'abahesha abandi amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.18",
            "verseOrgIds": [
              "JAS.3.18"
            ]
          }
        }
      ]
    }
  ],
