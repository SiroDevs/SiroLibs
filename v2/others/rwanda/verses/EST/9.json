          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo ahamye iyo minsi mikuru ya Purimu mu bihe byategetswe, uko Moridekayi Umuyuda n'Umwamikazi Esiteri babitegetse bakabyisezeranira ubwabo n'urubyaro rwabo, ibyo kwiyiriza ubusa no kuboroga kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
