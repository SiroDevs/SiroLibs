          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoherereza inzandiko Abayuda bose bo mu bihugu ijana na makumyabiri na birindwi byo mu gihugu cya Ahasuwerusi, izo nzandiko zavugaga iby'amahoro n'iby'ukuri, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
