              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Umwamikazi Esiteri umukobwa wa Abihayili, na Moridekayi Umuyuda bandikisha ububasha bwose, bahamya urwo rwandiko rwa kabiri rwa Purimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
        },
        {
          "name": "verse",
