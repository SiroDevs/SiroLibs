              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Umwami Ahasuwerusi akoresha ikoro abo mu gihugu n'abo mu birwa byo mu nyanja nini. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibyo yakoreshaga ububasha bwe n'imbaraga ze byose, n'ibyerekana neza uko umwami yakujije Moridekayi akaba umuntu ukomeye, mbese ntibyanditswe mu gitabo cy'ibyo ku ngoma z'abami b'u Bumedi n'u Buperesi? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko uwo Muyuda Moridekayi yari uwa kabiri ku Mwami Ahasuwerusi, kandi yari akomeye mu Bayuda agashimwa na bene se uko bangana, agashakira ubwoko bwabo ibyiza kandi akajya abwira urubyaro rwe amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
