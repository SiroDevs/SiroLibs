              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umwami arategeka ati “Uwo mwana muzima nimumucemo kabiri igice kimwe mugihe umwe, ikindi mugihe undi.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        }
