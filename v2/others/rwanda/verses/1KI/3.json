          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umwami aravuga ati “Yemwe, umwe agira ati ‘Umuzima ni we wanjye, uwapfuye ni uwawe’, n'undi akagira ati‘ Oya, ahubwo uwapfuye ni uwawe, umuzima ni we wanjye.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.23",
            "verseOrgIds": [
