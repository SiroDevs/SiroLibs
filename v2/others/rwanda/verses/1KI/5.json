          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Uwiteka aha Salomo ubwenge nk'uko yamusezeranije, abana amahoro na Hiramu kandi basezerana isezerano ryo gufashanya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.26",
            "verseOrgIds": [
              "1KI.5.26"
            ]
          }
        }
