          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Salomo atoranya abantu b'abanyagihe mu Bisirayeli, bose bari inzovu eshatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.27",
            "verseOrgIds": [
              "1KI.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.18"
              },
              "items": [
                {
                  "text": "1 Abami 12.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akajya abohereza muri Lebanoni uko ukwezi gutashye, abantu inzovu imwe bagafatanya igihe cy'ukwezi kumwe, bacyura igihe bakamara iwabo amezi abiri baruhuka. Adoniramu ni we wari umutware w'abo banyagihe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.28",
            "verseOrgIds": [
              "1KI.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Salomo yari yarashyizeho abikorezi inzovu ndwi, n'abandi babāzaga amabuye ku misozi miremire inzovu munani, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.29",
            "verseOrgIds": [
              "1KI.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "udashyizeho abatware bakuru ba Salomo bategekaga imirimo, bo bari ibihumbi bitatu na magana atatu batwaraga abakozi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.30",
            "verseOrgIds": [
              "1KI.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umwami abategeka ko babāza amabuye manini y'igiciro cyinshi, kugira ngo bubakishe urufatiro rw'inzu amabuye abajwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.31",
            "verseOrgIds": [
              "1KI.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abubatsi ba Salomo n'aba Hiramu n'Abagebali barayabaza, batunganya imbaho n'amabuye kugira ngo babyubakishe iyo nzu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.32",
            "verseOrgIds": [
              "1KI.5.32"
            ]
          }
        }
      ]
