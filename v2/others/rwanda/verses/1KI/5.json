                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.14"
              },
              "items": [
                {
                  "text": "2 Ngoma 1.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.25"
              },
              "items": [
                {
                  "text": "9.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi Salomo yari afite ibiraro by'amafarashi yakururaga amagare ye. Ibyo biraro byari inzovu enye, kandi abantu bagenderaga ku mafarashi bari inzovu imwe n'ibihumbi bibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abo batware bakajya bakoreshereza Umwami Salomo n'abariraga ku meza ye amakoro, umuntu wese ukwe kwezi ntibagire icyo bababurana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakajya bazana sayiri n'ubwatsi bw'ayo mafarashi, n'ayandi y'imbaraga nk'uko byategetswe, bakabizana aho umwami yabaga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Imana iha Salomo ubwenge n'ubuhanga bwinshi cyane n'umutima wagutse, bitagira akagero nk'umusenyi wo mu kibaya cy'inyanja utabarika. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwenge bwa Salomo bwarutaga ubw'abanyabwenge bose b'iburasirazuba n'aba Egiputa bose. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.1"
              },
              "items": [
                {
                  "text": "Zab 89.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yarushaga abandi bantu bose ubwenge nka Etani Umwezerahi, kandi nka Hemani na Kalukoli na Darada bene Maholi, yamamara atyo mu mahanga yose amukikije. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.1"
              },
              "items": [
                {
                  "text": "Imig 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.1"
              },
              "items": [
                {
                  "text": "10.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.25.1"
              },
              "items": [
                {
                  "text": "25.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.1.1"
              },
              "items": [
                {
                  "text": "Ind 1.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yahimbye imigani ibihumbi bitatu n'indirimbo igihumbi n'eshanu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi yari azi gusobanura ibiti uhereye ku myerezi y'i Lebanoni ukageza kuri ezobu imera ku mazu, yari azi gusobanura inyamaswa n'ibisiga n'ibikururuka n'ifi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abantu bakajya bava mu mahanga bazanywe no kumva ubwenge bwa Salomo, boherejwe n'abami bo mu isi yose bumvaga iby'ubwenge bwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Salomo yigira inama yo kubaka inzu y'Uwiteka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Hiramu umwami w'i Tiro yumvise ko bimitse Salomo ngo abe umwami mu cyimbo cya se, amutumaho abagaragu be kuko uhereye kera Hiramu yuzuraga na Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo aherako atuma kuri Hiramu ati ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uzi ko umukambwe wanjye Dawidi atabonye uburyo bwo kubakira izina ry'Uwiteka Imana ye inzu, ku bw'intambara z'ababisha be bari bamuri impande zose, kugeza aho Uwiteka yabashyiriye munsi y'ibirenge bye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko noneho Uwiteka Imana yanjye impaye ihumure impande zose, nta mubisha nta n'ibyago bikiriho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.12+2SA.7.13"
              },
              "items": [
                {
                  "text": "2 Sam 7.12-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.11+1CH.17.12"
              },
              "items": [
                {
                  "text": "1 Ngoma 17.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko ngambiriye kubakira izina ry'Uwiteka Imana yanjye inzu, nk'uko Uwiteka yabwiye umukambwe wanjye Dawidi ati ‘Umuhungu wawe nzashyira ku ngoma yawe mu cyimbo cyawe, ni we uzubakira izina ryanjye inzu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.19",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko none tegeka abantemera imyerezi y'i Lebanoni, kandi bazakorana n'abagaragu banjye. Nuko nzajya nguha ibihembo by'abagaragu bawe uko uzambwira kose, kuko uzi yuko nta n'umwe muri twe w'umuhanga uzi gutema ibiti nk'Abasidoni.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.20",
            "verseOrgIds": [
              "1KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
