              },
              "items": [
                {
                  "text": "2 Ngoma 9.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nuko Salomo ategeka ibihugu byose, uhereye kuri rwa ruzi ukageza ku gihugu cy'Abafilisitiya no ku rugabano rwa Egiputa, bakajya bamuzanira amaturo, bakamukorera iminsi yose yamaze akiriho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.1-14:",
              "type": "text"
            },
            {
              "text": "muri Bibliya Yera ya mbere, iyi mirongo ni 4.21-34; bityo, 5.1-18 ihwanye na 5.15-32 muri iyi Bibliya, nk'uko biri mu Ruheburayo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
