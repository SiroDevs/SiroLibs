          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko akora ibyangwa n'Uwiteka agendana ingeso za se, n'ibyaha yoheje Abisirayeli ngo bacumure.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
