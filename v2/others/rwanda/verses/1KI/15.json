              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "abahoye ibyaha Yerobowamu yakoze, n'ibyo yoheje Abisirayeli ngo bacumure, n'uko yarakazaga Uwiteka Imana ya Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
