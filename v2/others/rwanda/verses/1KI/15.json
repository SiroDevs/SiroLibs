          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka wa gatatu wo ku ngoma ya Asa umwami w'Abayuda ni bwo Bāsha yamwishe, yima mu cyimbo cye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
