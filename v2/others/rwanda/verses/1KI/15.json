              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka wa kabiri wo ku ngoma ya Asa umwami w'Abayuda, Nadabu mwene Yerobowamu yimye muri Isirayeli, amara imyaka ibiri ategeka Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
