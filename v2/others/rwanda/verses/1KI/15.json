              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko indi mirimo yose ya Nadabu n'ibyo yakoze byose, mbese ntibyanditswe mu gitabo cy'ibyo ku ngoma z'abami b'Abisirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
