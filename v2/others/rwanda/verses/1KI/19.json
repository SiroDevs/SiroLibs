          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ararisubiza ati “Nagize ishyaka ryinshi ry'Uwiteka Imana Nyiringabo, kuko Abisirayeli bavuye mu isezerano ryawe bagasenya ibicaniro byawe, kandi bicishije abahanuzi bawe inkota. Ni jye jyenyine usigaye, nanjye baragenza ubugingo bwanjye ngo banyice.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
