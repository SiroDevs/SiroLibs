          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baragenda bajya Ofiri bakurayo italanto z'izahabu magana ane na makumyabiri, bazishyira Umwami Salomo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.28",
