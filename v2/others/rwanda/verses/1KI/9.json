            "number": "27",
            "style": "v",
            "sid": "1KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hiramu yohereza muri izo nkuge abagaragu be b'abasare bamenyereye inyanja, bajyana n'abagaragu ba Salomo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
              "1KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
