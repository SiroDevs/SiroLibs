        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.24",
            "verseOrgIds": [
              "1KI.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 9:25"
          },
          "items": [
