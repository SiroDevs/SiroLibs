              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Umwami Salomo yari yarabaje inkuge nyinshi, azitsika Esiyonigeberi hahereranye na Eloti ku nkengero y'Inyanja Itukura, mu gihugu cya Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
