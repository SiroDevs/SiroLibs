          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mu mwaka wa gatanu wo ku ngoma y'Umwami Rehobowamu, Shishaki umwami wa Egiputa arazamuka atera i Yerusalemu kuharwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
            "verseOrgIds": [
              "1KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 14:26"
          },
          "items": [
