              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.16+1KI.10.17"
              },
              "items": [
                {
                  "text": "1 Abami 10.16-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.15+2CH.9.16"
              },
              "items": [
                {
                  "text": "2 Ngoma 9.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Asahura ibintu by'ubutunzi byo mu nzu y'Uwiteka n'ibyo mu nzu y'umwami arabijyana byose, ajyana n'ingabo z'izahabu zose Salomo yacurishije. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehobowamu aherako acurisha ingabo mu miringa ngo zisubire mu kigwi cyazo, azibitsa abatware b'abarinzi barindaga urugi rw'inzu y'umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi iyo umwami yinjiraga mu nzu y'Uwiteka, abarinzi bamushagaraga barazijyanaga, maze yasohoka bakazisubiza mu nzu y'abarinzi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
    },
