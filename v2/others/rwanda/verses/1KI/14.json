                }
              ]
            }
          ]
        },
        {
          "text": " Kandi muri icyo gihugu hariho abatinganyi, bakoraga ibizira byose by'abanyamahanga Uwiteka yirukanye imbere y'Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        }
      ]
    },
    {
