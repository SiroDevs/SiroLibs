              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe batangiriye kubaka urufatiro rw'inzu y'Uwiteka, hari mu kwezi kwa Zivu k'umwaka wa kane. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
