              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi urugo rw'ingombe arwubakisha amabuye abajwe mu mpushya eshatu, n'uruhushya rumwe rw'ibiti by'imyerezi.",
          "type": "text",
          "attrs": {
