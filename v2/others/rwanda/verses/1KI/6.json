            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburebure bw'ibaba ry'igishushanyo cy'umukerubi rimwe bwari mikono itanu, n'irindi baba na ryo ari uko. Uhereye ku iherezo ry'ibaba rimwe ukageza ku iherezo ry'irindi, yose yari mikono cumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igishushanyo cy'umukerubi cya kabiri uburebure bwacyo bwari mikono cumi. Ibishushanyo by'abakerubi byombi byari ikigero kimwe n'ishusho imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburebure bw'igishushanyo cy'umukerubi kimwe bwari mikono cumi, n'ubw'ikindi ari uko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashyira ibyo bishushanyo by'abakerubi mu mwinjiro w'inzu. Amababa yabyo yari afatanye urunana, bituma rimwe ry'igishushanyo kimwe rifata ku ruhande rumwe rw'inzu, iry'ikindi ku rundi ruhande, kandi ayandi mababa yombi ahurira hagati mu nzu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo bishushanyo by'abakerubi byombi abiteraho izahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
    {
