              "items": [
                {
                  "text": "2 Abami 9.36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi ibya Yezebeli Uwiteka arabihamya atya ati ‘Imbwa zizarira Yezebeli ku nkike z'i Yezerēli.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwa Ahabu wese uzagwa mu mudugudu azaribwa n'imbwa, uzagwa ku gasozi azaribwa n'inkongoro.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        }
      ]
