              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ahabu amaze kumva ayo magambo, atanyaguza imyambaro ye yambara ibigunira, yiyiriza ubusa yirirwa aryamye ku bigunira, akagenda abebera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
