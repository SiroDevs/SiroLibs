          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta wigeze gusa na Ahabu wiguriye gukora ibyangwa n'Uwiteka, yohejwe n'umugore we Yezebeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko yajyaga akora nabi cyane, akurikira ibishushanyo bisengwa nk'uko Abamori babigenzaga kose, abo Uwiteka yirukanye imbere y'Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
