              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma ijambo ry'Uwiteka rigera kuri Eliya w'i Tishubi riramubwira riti ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
