        "style": "s1"
      },
      "items": [
        {
          "text": "Gukizwa n'ubuntu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
