            "verseId": "EPH.2.17",
            "verseOrgIds": [
              "EPH.2.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.19"
              },
              "items": [
                {
                  "text": "Yes 57.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaraje ababwira ubutumwa bwiza bw'amahoro mwebwe abāri kure, kandi abāri bugufi na bo ababwira iby'amahoro, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.17",
            "verseOrgIds": [
              "EPH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ari we uduhesha uko turi amaharakubiri, kwegera Data wa twese turi mu Mwuka umwe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.18",
            "verseOrgIds": [
              "EPH.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.18",
            "verseOrgIds": [
              "EPH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ntimukiri abashyitsi n'abasuhuke, ahubwo muri ubwoko bumwe n'abera ndetse muri abo mu nzu y'Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.19",
            "verseOrgIds": [
              "EPH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mwubatswe ku rufatiro rw'intumwa n'abahanuzi, ariko Kristo Yesu ni we buye rikomeza imfuruka. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.20",
            "verseOrgIds": [
              "EPH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri we inzu yose iteranijwe neza, irakura ngo ibe urusengero rwera mu Mwami Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.21",
            "verseOrgIds": [
              "EPH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri we namwe murubakanwa, kugira ngo mube inzu yo kubabwamo n'Imana mu Mwuka.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.22",
            "verseOrgIds": [
              "EPH.2.22"
            ]
          }
        }
      ]
    }
  ],
