              "items": [
                {
                  "text": "Yer 9.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ahubwo uwirata, niyirate Uwiteka, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko uwiyogeza atari we ushimwa, keretse uwo Umwami wacu yogeza, ni we ushimwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
      ]
