            }
          ]
        },
        {
          "text": "Ariko Sawuli arushaho kugwiza imbaraga, atsinda Abayuda batuye i Damasiko arabamwaza, abahamiriza yuko Yesu ari we Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.22",
            "verseOrgIds": [
              "ACT.9.22"
            ]
          }
        }
      ]
    },
