        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu abonekera Sawuli mu nzira ijya i Damasiko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Sawuli akomeza gukangisha abigishwa b'Umwami ko bicwa, ajya ku mutambyi mukuru ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.1",
            "verseOrgIds": [
              "ACT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "amusaba inzandiko zo guha ab'amasinagogi y'i Damasiko, kugira ngo nabona abantu b'Inzira ya Yesu, abagabo cyangwa abagore, ababohe abajyane i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.2",
            "verseOrgIds": [
              "ACT.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.2",
            "verseOrgIds": [
              "ACT.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akigenda yenda gusohora i Damasiko, umucyo uramutungura uvuye mu ijuru uramugota. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.3",
            "verseOrgIds": [
              "ACT.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwa hasi yumva ijwi rimubaza riti “Sawuli, Sawuli, undenganiriza iki?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.4",
            "verseOrgIds": [
              "ACT.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.4",
            "verseOrgIds": [
              "ACT.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubaza ati “Uri nde, Mwami?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we ati “Ndi Yesu, uwo urenganya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko haguruka ujye mu mudugudu, uzabwirwa ibyo ukwiriye gukora.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.6",
            "verseOrgIds": [
              "ACT.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.6",
            "verseOrgIds": [
              "ACT.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagabo bajyanye na we bahagarara badakoma, kuko bumvise iryo jwi batagize umuntu babona. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.7",
            "verseOrgIds": [
              "ACT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawuli arabyuka arambuye amaso ntiyagira icyo areba, baramurandata bamujyana i Damasiko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.8",
            "verseOrgIds": [
              "ACT.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amarayo gatatu atareba, atarya kandi atanywa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.9",
            "verseOrgIds": [
              "ACT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ananiya abatiza Sawuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.9",
            "verseOrgIds": [
              "ACT.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Damasiko hari umwigishwa witwaga Ananiya. Umwami Yesu aramubonekera aramuhamagara ati “Ananiya.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we ati “Karame, Mwami.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramubwira ati “Haguruka ujye mu nzira yitwa Igororotse, ushakire mu nzu ya Yuda umuntu witwa Sawuli w'i Taruso, kuko ubu ngubu asenga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.11",
            "verseOrgIds": [
              "ACT.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na we abonye mu iyerekwa umuntu witwa Ananiya yinjira, amurambikaho ibiganza kugira ngo ahumuke.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.12",
            "verseOrgIds": [
              "ACT.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.12",
            "verseOrgIds": [
              "ACT.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananiya aramusubiza ati “Mwami, uwo muntu numvise benshi bamuvuga, uko yagiriraga nabi abera bawe bari i Yerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.13",
            "verseOrgIds": [
              "ACT.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'ino afite ubutware abuhawe n'abatambyi bakuru, bwo kuboha abāmbaza izina ryawe.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.14",
            "verseOrgIds": [
              "ACT.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.14",
            "verseOrgIds": [
              "ACT.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramusubiza ati “Genda kuko uwo muntu ari igikoreshwa nitoranirije, ngo yogeze izina ryanjye imbere y'abanyamahanga n'abami n'Abisirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanjye nzamwereka ibyo azababazwa na we uburyo ari byinshi, bamuhora izina ryanjye.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.16",
            "verseOrgIds": [
              "ACT.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.16",
            "verseOrgIds": [
              "ACT.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananiya aragenda yinjira mu nzu, amurambikaho ibiganza aramubwira ati “Sawuli mwene Data, Umwami Yesu wakubonekereye mu nzira waturutsemo, arantumye ngo uhumuke wuzuzwe Umwuka Wera.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.17",
            "verseOrgIds": [
              "ACT.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwanya ibisa n'imboneranyi bimuva ku maso arahumuka, arahaguruka arabatizwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.18",
            "verseOrgIds": [
              "ACT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "amaze gufungura abona intege.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amarana iminsi n'abigishwa b'i Damasiko, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "aherako abwiriza mu masinagogi yuko Yesu ari Umwana w'Imana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.20",
            "verseOrgIds": [
              "ACT.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.20",
            "verseOrgIds": [
              "ACT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamwumvise bose barumirwa bati “Uyu si we warimburiraga i Yerusalemu abāmbaza iryo zina? Kandi icyamuzanye n'ino si ukugira ngo ababohe, abashyīre abatambyi bakuru?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.21",
            "verseOrgIds": [
              "ACT.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.21",
            "verseOrgIds": [
              "ACT.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 9:22"
          },
          "items": [
