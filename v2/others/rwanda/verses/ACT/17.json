          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ari muri yo dufite ubugingo bwacu, tugenda turiho, nk'uko bamwe bo mu bahimbyi b'indirimbo banyu bavuze bati ‘Turi urubyaro rwayo.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
