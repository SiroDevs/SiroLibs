        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko rero ubwo turi urubyaro rw'Imana, ntidukwiriye kwibwira yuko Imana isa n'izahabu cyangwa ifeza cyangwa ibuye, cyangwa ikindi kibajijwe n'ubukorikori bw'abantu n'ubwenge bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.29",
            "verseOrgIds": [
              "ACT.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko iyo minsi yo kujijwa Imana yarayirengagije, ariko noneho itegeka abantu bose bari hose kwihana, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.30",
            "verseOrgIds": [
              "ACT.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko yashyizeho umunsi wo gucira ho urubanza rw'ukuri rw'abari mu isi bose, izarucisha umuntu yatoranije kandi ibyo yabihamirije abantu bose ubwo yamuzuye.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        }
      ]
    },
