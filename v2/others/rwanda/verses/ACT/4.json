        },
        {
          "text": "Bamaze gusenga, aho bari bateraniye haba umushyitsi, bose buzuzwa Umwuka Wera, bavuga ijambo ry'Imana bashize amanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.31",
            "verseOrgIds": [
              "ACT.4.31"
            ]
          }
        }
      ]
    },
    {
