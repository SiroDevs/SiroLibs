          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta mukene wababagamo, kuko abari bafite amasambu bose cyangwa amazu babiguraga, bakazana ibiguzi by'ibyo baguze ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
            "verseOrgIds": [
              "ACT.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
