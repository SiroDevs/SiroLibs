              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abizeye bose bahuzaga umutima n'inama, kandi nta n'umwe wagiraga ubwiko ku kintu, ahubwo byose barabisangiraga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.32",
            "verseOrgIds": [
              "ACT.4.32"
            ]
          }
