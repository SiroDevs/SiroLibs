          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi intumwa zagiraga imbaraga nyinshi zo guhamya kuzuka k'Umwami Yesu, nuko rero ubuntu bw'Imana bwinshi bukaba kuri bo bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
