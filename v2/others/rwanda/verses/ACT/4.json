              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosefu Umulewi wavukiye i Kupuro, uwo intumwa zahimbye Barinaba, risobanurwa ngo “Umwana wo guhugura”, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.36",
