            "style": "v",
            "sid": "ACT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.25",
            "verseOrgIds": [
              "ACT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Pawulo ajyana abo bagabo bukeye bwaho berezwa hamwe, yinjirana na bo mu rusengero, avuga igihe iminsi yo kwezwa izashirira, ari bwo igitambo cy'umuntu wese muri bo kizatangwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abasirikare b'Abaroma bakiza Pawulo Abayuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko iyo minsi irindwi yenda gusohora, Abayuda bavuye muri Asiya bamubonye mu rusengero, batera abantu bose imidugararo baramusumira, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.27",
            "verseOrgIds": [
              "ACT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "barasakuza bati “Bagabo ba Isirayeli, nimudutabare! Uyu ni wa muntu wigisha hose abantu bose gusuzugura ubu bwoko n'amategeko n'aha hantu, kandi yazanye n'Abagiriki mu rusengero, ahumanya aha hantu hera.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.28",
            "verseOrgIds": [
              "ACT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.4"
              },
              "items": [
                {
                  "text": "Ibyak 20.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (Babivugiye batyo kuko bari babonye Tirofimo Umunyefeso ari kumwe na we mu murwa, bībwira yuko Pawulo yamujyanye mu rusengero.)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umurwa wose uravurungana, abantu baterana birukanka bafata Pawulo, baramukurubana bamukura mu rusengero, uwo mwanya bakinga inzugi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.30",
            "verseOrgIds": [
              "ACT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagishaka kumwica, inkuru igera ku mutware w'ingabo z'abasirikare, yuko i Yerusalemu hose hari hagize imidugararo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.31",
            "verseOrgIds": [
              "ACT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri ako kanya ajyana abasirikare n'abatwara imitwe, amanuka yirukanka abīrohamo. Na bo babonye umutware w'ingabo n'abasirikare, barorera gukubita Pawulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.32",
            "verseOrgIds": [
              "ACT.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umutware w'ingabo arabegera aramufata, ategeka ko bamubohesha iminyururu ibiri, abaza uwo ari we n'icyo akoze icyo ari cyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.33",
            "verseOrgIds": [
              "ACT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo mu iteraniro barasakuza, bamwe bavuga bimwe, abandi ibindi. Ananizwa n'urusaku kumenya ukuri, ategeka ko bamujyana mu rugo rw'igihome. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.34",
            "verseOrgIds": [
              "ACT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ageze ku rwuririro, umujinya w'abantu utuma abasirikare bamuterura, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.35",
            "verseOrgIds": [
              "ACT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko abantu benshi babakurikiraga basakuza bati “Mukureho!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benda kumwinjiza mu rugo rw'igihome, Pawulo abaza umutware w'ingabo ati “Ntiwakwemera ko nkubwira ijambo?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we aramubaza ati “Uzi Urugiriki? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si wowe wa Munyegiputa wagomesheje abantu mu gihe gishize, ukajyana mu butayu abantu b'abicanyi ibihumbi bine?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulo aramusubiza ati “Ndi Umuyuda w'i Taruso, ari wo mudugudu w'i Kilikiya w'ikimenywabose, kandi ndakwinginze unkundire mbwire abantu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pawulo yiregura imbere y'abashakaga kumwica",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramukundira. Pawulo ahagarara ku rwuririro, amama abantu barahora rwose. Ababwira mu Ruheburayo ati:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.40",
            "verseOrgIds": [
              "ACT.21.40"
            ]
          }
        }
      ]
    }
