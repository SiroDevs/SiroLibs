              "items": [
                {
                  "text": "Ibyah 16.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko umunsi w'Umwami wacu uzaza nk'umujura, ubwo ijuru rizavaho hakaba n'umuriri ukomeye, maze iby'ishingiro, ibyo byose biremeshwa bikayengeshwa no gushya cyane, isi n'imirimo iyirimo bigashirīra.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.10",
            "verseOrgIds": [
              "2PE.3.10"
            ]
          }
        }
