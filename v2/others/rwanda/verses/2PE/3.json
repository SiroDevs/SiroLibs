            "number": "14",
            "style": "v",
            "sid": "2PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma bakundwa, ubwo mutegereje ibyo, mukwiriye kugira umwete wo kuzasangwa mu mahoro, mutagira ikizinga, mutariho umugayo mu maso ye. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.14",
            "verseOrgIds": [
              "2PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumenye yuko kwihangana k'Umwami wacu ari agakiza, nk'uko mwene Data ukundwa Pawulo yabandikiye abwirijwe n'ubwenge yahawe, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.15",
            "verseOrgIds": [
              "2PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndetse no mu nzandiko ze zose yavuze ibyerekeye ibyo. Icyakora zirimo bimwe biruhije gusobanukirwa, ibyo abaswa bahindagurika bagoreka, nk'uko bagira ibyanditswe bindi bakizanira kurimbuka.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.16",
            "verseOrgIds": [
              "2PE.3.16"
            ]
          }
        }
      ]
    },
