                "loc": "GEN.1.6+GEN.1.7+GEN.1.8+GEN.1.9"
              },
              "items": [
                {
                  "text": "Itang 1.6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko biyibagiza nkana yuko ijuru ryahozeho uhereye kera kose, n'isi yakuwe mu mazi ikazengurukwa na yo ku bw'ijambo ry'Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.5",
            "verseOrgIds": [
              "2PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.11"
              },
              "items": [
                {
                  "text": "Itang 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ari byo byatumye isi ya kera irengwaho n'amazi ikarimbuka. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.6",
            "verseOrgIds": [
              "2PE.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ijuru n'isi bya none, iryo jambo ni ryo na none ryabibikiye umuriro uzatera ku munsi w'amateka, urimbure abatubaha Imana.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.7",
            "verseOrgIds": [
              "2PE.3.7"
            ]
          }
        }
      ]
    },
