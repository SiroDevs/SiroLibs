            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mubanze kumenya iki, yuko mu minsi y'imperuka hazaza abakobanyi bakobana, bakurikiza irari ryabo, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.3",
            "verseOrgIds": [
              "2PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "babaza bati “Isezerano ryo kuza kwe riri he? Ko uhereye aho ba sogokuruza basinziririye, byose bihora uko byahoze, uhereye ku kuremwa kw'isi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.4",
            "verseOrgIds": [
              "2PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
