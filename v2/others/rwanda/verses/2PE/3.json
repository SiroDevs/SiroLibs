          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakundwa, uru ni rwo rwandiko rwa kabiri mbandikiye. Muri izo zombi imigambi yanjye yari iyo gukangura imitima yanyu itarimo uburiganya, mbibutsa ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.1",
            "verseOrgIds": [
              "2PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo mwibuke amagambo yavuzwe kera n'abahanuzi bera, mwibuke n'itegeko ry'Umwami ari we Mukiza mwabwiwe n'intumwa zabatumweho.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.2",
            "verseOrgIds": [
              "2PE.3.2"
            ]
          }
        }
      ]
    },
