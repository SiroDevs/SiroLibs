          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero bakundwa, ubwo muburiwe hakiri kare, mwirinde mutayobywa n'uburiganya bw'abanyabyaha mukareka gushikama kwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.17",
            "verseOrgIds": [
              "2PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo mukurire mu buntu bw'Imana no kumenya Yesu Kristo Umwami wacu n'Umukiza. Icyubahiro kibe icye none n'iteka ryose. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.18",
            "verseOrgIds": [
              "2PE.3.18"
            ]
          }
        }
      ]
