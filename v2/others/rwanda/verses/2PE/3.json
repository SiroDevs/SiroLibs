                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi nk'uko yasezeranije dutegereje ijuru rishya n'isi nshya, ibyo gukiranuka kuzabamo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.13",
