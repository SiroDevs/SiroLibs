            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.3"
              },
              "items": [
                {
                  "text": "Ibyah 21.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ihema ryanjye ni ryo rizaba hamwe na bo, kandi nzaba Imana yabo na bo babe ubwoko bwanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.27",
            "verseOrgIds": [
              "EZK.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga yose azamenya yuko ari jye Uwiteka weza Isirayeli, igihe ubuturo bwanjye bwera buzaba muri bo hagati iteka ryose.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
