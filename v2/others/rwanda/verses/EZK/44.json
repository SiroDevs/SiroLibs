            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihaba urubanza bajye baruca bakurikije ibihwanye n'amategeko yanjye, kandi bajye bakomereza amategeko yanjye n'amateka yanjye mu birori byanjye byategetswe byose, beze n'amasabato yanjye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        }
      ]
    },
