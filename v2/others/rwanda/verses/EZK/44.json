                  "text": "Lewi 21.1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “ ‘Ntibakegere intumbi y'umuntu kugira ngo badahumana, keretse se w'uwo mutambyi cyangwa nyina, cyangwa umuhungu we cyangwa umukobwa we, cyangwa uwo bava inda imwe cyangwa mushiki we udafite umugabo, abo ni bo bakwihumanisha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namara guhumanuka bamubarire iminsi irindwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunsi azasubira mu buturo bwera mu rugo rw'imbere kugira ngo ahakorere, azatanga igitambo cye gitambirirwa ibyaha. Ni ko Umwami Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
      ]
    },
