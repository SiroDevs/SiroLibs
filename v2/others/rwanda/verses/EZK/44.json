          ]
        },
        {
          "text": " “ ‘Bajye bigisha ubwoko bwanjye gutandukanya ibyera n'ibitejejwe, kandi babumenyeshe ibyanduye n'ibitanduye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
