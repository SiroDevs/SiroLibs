              "EZK.44.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.5"
              },
              "items": [
                {
                  "text": "Lewi 21.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “ ‘Kandi ntibakimoze cyangwa ngo batereke umusatsi, bajye biyogoshesha gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.9"
              },
              "items": [
                {
                  "text": "Lewi 10.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntihakagire uwo mu batambyi unywa inzoga igihe bagiye kwinjira mu rugo rw'imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.7"
              },
              "items": [
                {
                  "text": "Lewi 21.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.13+LEV.21.14"
              },
              "items": [
                {
                  "text": "13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi ntibagacyure abapfakazi cyangwa abagore basenzw, ahubwo bajye barongora abageni bo mu rubyaro rw'ab'inzu ya Isirayeli, cyangwa se bacyure abapfakazi barongowe n'abatambyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
