        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.5",
            "verseOrgIds": [
              "EZK.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Umwami Uwiteka aravuga ngo: Kuko wakomye mu mashyi ukiyerekana umuhamirizo, kandi ukishima hejuru y'igihugu cya Isirayeli, ukakigayisha umutima wawe wose, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.6",
            "verseOrgIds": [
              "EZK.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko dore nkuramburiyeho ukuboko kwanjye, kandi ngiye kugutanga ube umunyago w'amahanga, kandi nzaguca mu moko ngutsembe mu bihugu, nkurimbure maze umenye yuko ndi Uwiteka.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.7",
            "verseOrgIds": [
              "EZK.25.7"
            ]
          }
        }
      ]
    },
