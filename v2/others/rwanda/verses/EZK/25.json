                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze ijambo ry'Uwiteka rinzaho riti ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.1",
            "verseOrgIds": [
              "EZK.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w'umuntu, erekeza amaso yawe kuri bene Amoni maze ubahanurire. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwire bene Amoni uti ‘Nimwumve ijambo ry'Umwami Uwiteka ngo: Uku ni ko Umwami Uwiteka avuga ati: Kuko wagize ngo “Awa!” ukishima hejuru y'ubuturo bwanjye bwera igihe bwanduzwaga, kandi n'igihugu cya Isirayeli igihe cyahindukaga amatongo, n'inzu ya Yuda igihe bajyanwaga ari imbohe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.3",
            "verseOrgIds": [
              "EZK.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni cyo gituma ngiye kukugabiza ab'iburasirazuba baguhindūre, bazagerereza iwawe, bazakubakamo amazu, bazakurira imyaka, bazakunywera n'amata. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.4",
            "verseOrgIds": [
              "EZK.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi i Raba nzahagira ikiraro cy'ingamiya, n'aha bene Amoni mpagire icyarire cy'imikumbi, maze muzamenye yuko ndi Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.5",
            "verseOrgIds": [
              "EZK.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
