          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Umwami Uwiteka aravuga ati “Igihe nzakugira umudugudu w'amatongo ukamera nk'imidugudu yashizemo abantu, igihe nzakurengeza amazi y'imuhengeri n'amazi menshi akakurenga hejuru, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.19",
            "verseOrgIds": [
              "EZK.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni bwo nzakumanurira hamwe n'abamanuka bajya mu rwobo mu bantu ba kera, ntume utura ikuzimu ahantu habaye amatongo uhereye kera, hamwe n'abamanuka bajya mu rwobo kugira ngo utazongera guturwamo, kandi utongera kubyuka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.20",
            "verseOrgIds": [
              "EZK.26.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "utongera kubyuka:",
              "type": "text"
            },
            {
              "text": "cyangwa, nzakomeza icyubahiro.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mu gihugu cy'ababaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.20",
            "verseOrgIds": [
              "EZK.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.21"
              },
              "items": [
                {
                  "text": "Ibyah 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nzakugira igiteye ubwoba kandi ntabwo uzongera kubaho; naho uzashakwa, ntuzongera kurebwa.” Ni ko Umwami Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.21",
            "verseOrgIds": [
              "EZK.26.21"
            ]
          }
        }
      ]
    }
  ],
