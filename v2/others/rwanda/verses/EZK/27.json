        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.28",
            "verseOrgIds": [
              "EZK.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘N'abavugama bose n'abasare n'aberekeza bose bo mu nyanja, bazururuka bave mu nkuge zabo bahagarare ku butaka, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.29",
            "verseOrgIds": [
              "EZK.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ijwi ryabo rizumvikana bakuririra, bazaboroga cyane birenze imikungugu ku mutwe, kandi bazigaragura mu ivu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.30",
            "verseOrgIds": [
              "EZK.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "bimoze ku bwawe kandi bakenyere ibigunira, bazakuririra bafite umutima ubabaye bakuborogere cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mubabaro wabo bazacura umuborogo, bakuborogere bavuge bati “Ni nde uhwanye n'i Tiro, akamera nkawe wajimirijwe hagati y'inyanja?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.32",
            "verseOrgIds": [
              "EZK.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo iby'ubugenza bwawe byavaga mu nyanja wahazaga amahanga menshi, abami bo mu isi wabagiraga abatunzi, wabahaye ku butunzi bwawe n'iby'ubugenza byawe kuko ari byinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.33",
            "verseOrgIds": [
              "EZK.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe uvunaguwe n'inyanja uri imuhengeri, ibintu byawe by'ubugenza n'ingabo zawe zose byakuguyemo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.34",
            "verseOrgIds": [
              "EZK.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatuye mu birwa bose baragutangariye n'abami babo bafatwa n'ubwoba bwinshi, mu maso habo harasuherwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.35",
            "verseOrgIds": [
              "EZK.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagenza bo mu mahanga barakwimyoje, uhindutse igishishana kandi ntabwo uzongera kubaho ukundi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.36",
            "verseOrgIds": [
              "EZK.27.36"
            ]
          }
        }
      ]
    }
