        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.11+REV.18.12+REV.18.13+REV.18.14+REV.18.15+REV.18.16+REV.18.17+REV.18.18+REV.18.19"
              },
              "items": [
                {
                  "text": "Ibyah 18.11-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “ ‘Inkuge z'i Tarushishi zajyanaga ibintu byawe by'ubugenza nuko ugira byinshi cyane, ugira n'icyubahiro kinini uri hagati y'inyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasare bawe bakujyanye mu mazi menshi, umuyaga w'iburasirazuba wakuvunaguriye mu nyanja hagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
            "verseOrgIds": [
              "EZK.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubutunzi bwawe n'ibintu byawe n'ubugenza bwawe, n'abasare bawe n'aberekeza bawe n'abahomyi bawe, n'abagenza b'ibintu byawe n'abantu bawe bose b'intwari bakuriho, hamwe n'ingabo zose zikurimo, mu munsi wo kurimburwa kwawe byose bizarohama mu nyanja hagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imihana yawe izatigiswa n'urusaku rwo gutaka kw'aberekeza bawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.28",
            "verseOrgIds": [
              "EZK.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
