              "items": [
                {
                  "text": "19.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi ubwo byagendaga numvaga guhorera kw'amababa yabyo ari nko guhorera kw'amazi menshi, nk'ijwi ry'Ishoborabyose, urusaku rw'ikiriri rumeze nk'urusaku rw'ingabo. Iyo byahagararaga byabumbaga amababa yabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
