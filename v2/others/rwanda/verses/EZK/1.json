          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munsi y'iryo juru amababa yabyo yari arambuye rimwe ryerekeye irindi, buri kimwe cyari gifite abiri atwikiriye uruhande rumwe, kandi buri kimwe gifite abiri atwikiriye urundi ruhande ku mibiri yabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
