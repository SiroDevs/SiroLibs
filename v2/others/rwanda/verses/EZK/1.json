              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hejuru y'ikirere cyari hejuru y'imitwe yabyo hari ijwi, nuko byahagarara bikabumba amababa yabyo.",
          "type": "text",
          "attrs": {
