        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.24",
            "verseOrgIds": [
              "EZK.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
