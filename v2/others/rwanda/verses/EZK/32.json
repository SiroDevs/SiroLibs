              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ariko uzavunagurikira hagati y'abatakebwe, uryamishwe hamwe n'abicishijwe inkota.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
