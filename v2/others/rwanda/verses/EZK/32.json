          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aho ni ho Mesheki na Tubali bari bo n'inteko zabo zose, ibituro byabo bibakikijeho. Abo bose ni abatakebwe bicishijwe inkota kuko bateraga ubwoba mu gihugu cy'abariho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntibazaryamana n'intwari zaguye mu batakebwe, zamanutse zikajya ikuzimu zifite intwaro zazo z'intambara, zikisegura inkota zabo, ibicumuro byabo bigahambanwa n'amagufwa yabo, kuko bateraga abakomeye ubwoba mu gihugu cy'abariho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        }
      ]
    },
