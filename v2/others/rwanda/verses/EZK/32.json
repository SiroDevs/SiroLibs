              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Farawo azababona ahumurizwe ku bw'inteko ze zose, ari we Farawo n'ingabo ze zose bicishijwe inkota. Ni ko Umwami Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
