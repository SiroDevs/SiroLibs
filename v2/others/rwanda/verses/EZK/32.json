                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.24+MRK.13.25"
              },
              "items": [
                {
                  "text": "Mar 13.24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.25"
              },
              "items": [
                {
                  "text": "Luka 21.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12+REV.6.13"
              },
              "items": [
                {
                  "text": "Ibyah 6.12-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.12"
              },
              "items": [
                {
                  "text": "8.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ubwo nzakuzimya, nzakingiriza ijuru n'inyenyeri zo kuri ryo nzazizimya, izuba nzaritwikiriza igicu kandi ukwezi na ko ntikuzava. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imuri zose zimurikira mu ijuru nzazihindura umwijima hejuru yawe, igihugu cyawe ngikwizemo umwijima. Byavuzwe n'Umwami Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Nzarakaza imitima y'amoko menshi igihe nzakurimburira mu mahanga, mu bihugu utigeze kumenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ukuri nzatuma abantu benshi bagutangarira, kandi abami babo bazamarwa n'ubwoba babutewe nawe mu gihe nzabuhira inkota yanjye, kandi umuntu wese azahora ahindira umushyitsi ubugingo bwe ku munsi wo kurimbuka kwawe.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umwami Uwiteka aravuga ati ‘Inkota y'umwami w'i Babuloni izakugeraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzatuma inteko z'ingabo zawe zisenyurwa n'inkota z'intwari, izo zose ni zo zitera amahanga ubwoba. Ubwibone bwa Egiputa bazabuhindura ubusa, kandi inteko zaho zose zizarimburwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzarimbura amatungo yaho yose ari iruhande rw'amazi menshi, kandi nta kirenge cy'umuntu kizongera kuyatoba, habe n'inzara z'amatungo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni bwo nzatunganya amazi yaho, inzuzi zaho nkazitembesha nk'amavuta ya elayo. Byavuzwe n'Umwami Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
              "EZK.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe nzahindura igihugu cya Egiputa ikidaturwa n'amatongo, igihugu kikabura ibyari bicyuzuyemo, abagituyemo bose nkabarimbura, ni bwo bazamenya yuko ndi Uwiteka.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo ni wo muborogo bazaboroga, abakobwa b'amahanga ni wo bazaboroga baborogera Egiputa n'inteko zaho zose.” Ni ko Umwami Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mu mwaka wa cumi n'ibiri, ku munsi wa cumi n'itanu w'ukwezi, ijambo ry'Uwiteka rinzaho riti ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.17",
            "verseOrgIds": [
              "EZK.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w'umuntu, ririra inteko zo muri Egiputa, uzijugunye hasi zo n'abakobwa b'amahanga ashimwa, bagere ikuzimu hamwe n'abamanuka bajya mu rwobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.18",
            "verseOrgIds": [
              "EZK.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo uruta ubwiza ni nde? Noneho manuka ujugunywe mu batakebwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.19",
            "verseOrgIds": [
              "EZK.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.19",
            "verseOrgIds": [
              "EZK.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abanyegiputa bazagwa hagati y'abicishijwe inkota bategekewe inkota, nimubakururane n'inteko zabo zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.20",
            "verseOrgIds": [
              "EZK.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intwari zikomeye ziri ikuzimu zizamubwirana n'ababafashaga ziti ‘Abatakebwe baramanutse barambaraye badakoma, bicishijwe inkota.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aho ni ho Ashuri ari we n'ingabo ze zose, akikijwe n'ibituro bye. Abo bose bishwe bagushijwe n'inkota, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.22",
            "verseOrgIds": [
              "EZK.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibituro byabo biri mu ndiba y'urwobo, kandi bikikije igituro cye. Abo bose bishwe bagushijwe n'inkota, kandi ari bo bateraga ubwoba mu gihugu cy'abariho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aho ni ho Elamu ari we n'inteko ze zose zikikije ku gituro cye, abo bose bishwe bagushijwe n'inkota, bamanutse batakebwe bagera mu ndiba y'isi kandi ari bo bateraga abantu ubwoba mu gihugu cy'abariho, batwaye ikimwaro cyabo bari kumwe n'abamanuka bajya mu rwobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.24",
