          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aho ni ho ibikomangoma byose by'ikasikazi biri, n'ab'i Sidoni bose bamanukanye n'abishwe, bamwazwa n'uko batezaga ubwoba amaboko yabo kandi barambarara badakebwe bari hamwe n'abishwe n'inkota, batwara ikimwaro cyabo bari kumwe n'abamanuka bajya mu rwobo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
