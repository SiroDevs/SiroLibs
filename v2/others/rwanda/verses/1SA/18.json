              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawuli abibonye amenya ko Uwiteka ari kumwe na Dawidi, kandi Mikali umukobwa wa Sawuli yakundaga Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Sawuli arushaho gutinya Dawidi, ahinduka umwanzi we iteka ryose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
