              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abantu bose batera hejuru bati “Umwami aragahoraho!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        }
      ]
    },
    {
