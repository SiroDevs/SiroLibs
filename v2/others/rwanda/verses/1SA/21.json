            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.56.1"
              },
              "items": [
                {
                  "text": "Zab 56.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko Dawidi abika ayo magambo mu mutima we, atinya cyane Akishi umwami w'i Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.13",
            "verseOrgIds": [
              "1SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.1"
              },
              "items": [
                {
                  "text": "Zab 34.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dawidi aherako yihinduriza imbere yabo, yisarishiriza mu maboko yabo, agaharamba ku nzugi z'irembo, agahoboba inkonda zigatembera mu bwanwa. ",
          "type": "text",
          "attrs": {
