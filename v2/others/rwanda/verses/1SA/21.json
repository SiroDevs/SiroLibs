        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi arahaguruka aragenda, Yonatani asubira mu mudugudu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21.1:",
              "type": "text"
            },
            {
              "text": "muri Bibliya Yera ya mbere, uyu murongo uboneka kuri 20.42; ariko, muri Bibliya y'Uruheburayo, ni 21.1. Bityo, 21.1-15 ihwanye na 21.2-16, muri iyi Bibliya.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dawidi arya ku mitsima yejejwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
