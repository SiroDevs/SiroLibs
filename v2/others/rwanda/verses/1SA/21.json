              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Akishi abwira abagaragu be ati “Yemwe, ntimureba ko uyu mugabo yasaze! Mwamunzaniriye iki? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.15",
            "verseOrgIds": [
