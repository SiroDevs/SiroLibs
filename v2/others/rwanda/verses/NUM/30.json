              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose abwira Abisirayeli ibyo Uwiteka yamutegetse byose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "30.1",
              "type": "text"
            },
            {
              "text": "muri Bibliya Yera ya mbere, uyu murongo ni 29.40; bityo, 30.1-16 ihwanye na 30.2-17 muri iyi Bibliya, nk'uko biri mu Ruheburayo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amategeko y'imihigo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
