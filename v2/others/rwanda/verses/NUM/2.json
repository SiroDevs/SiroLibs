              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mu ruhande rw'ikasikazi hajye haba icyiciro cya Dani, kirimo ibendera ryacyo n'imitwe yacyo, umutware w'Abadani abe Ahiyezeri mwene Amishadayi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.25",
            "verseOrgIds": [
              "NUM.2.25"
            ]
          }
        },
        {
