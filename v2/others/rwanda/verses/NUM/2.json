          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutwe we warimo abagabo inzovu enye n'igihumbi na magana atanu nk'uko babazwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.28",
            "verseOrgIds": [
              "NUM.2.28"
