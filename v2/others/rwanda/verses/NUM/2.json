          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'umuryango wa Asheri abe ari bo bahererana na bo, umutware w'Abashēri abe Pagiyeli mwene Okirani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
