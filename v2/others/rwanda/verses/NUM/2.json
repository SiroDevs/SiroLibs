          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Maze ihema ry'ibonaniro rijye rihagurukana n'icyiciro cy'Abalewi kigenda hagati y'ibindi byiciro. Uko babambye amahema abe ari ko bahaguruka, umuntu wese muri gahunda ye, bahereranye n'amabendera y'ababo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        }
      ]
