        },
        {
          "text": "Umutwe we warimo abagabo inzovu eshanu n'ibihumbi bitatu na magana ane nk'uko babazwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
            "verseOrgIds": [
              "NUM.2.30"
            ]
          }
        },
        {
