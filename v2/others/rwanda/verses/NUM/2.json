          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutwe we warimo abagabo inzovu eshatu n'ibihumbi bitanu na magana ane nk'uko babazwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
            "verseOrgIds": [
              "NUM.2.23"
            ]
          }
        },
