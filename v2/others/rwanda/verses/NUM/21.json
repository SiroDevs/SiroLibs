              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barahindukira, barazamuka baca mu nzira ijya i Bashani. Ogi umwami w'i Bashani abasanganiza ingabo ze zose muri Edureyi ngo abarwanirizeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.33",
            "verseOrgIds": [
              "NUM.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati “Ntumutinye, kuko mukugabizanije n'abantu be bose n'igihugu cye. Nawe umugirire uko wagiriye Sihoni umwami w'Abamori, wa wundi wari utuye i Heshiboni.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.34",
            "verseOrgIds": [
              "NUM.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamurimburana n'abahungu be n'abantu be bose, ntihasigara n'uwa kirazira, bahindūra igihugu cye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.35",
            "verseOrgIds": [
              "NUM.21.35"
            ]
          }
        }
