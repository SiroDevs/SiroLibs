          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo bibabere itegeko ritegeka uko muca imanza, mu bihe byanyu byose no mu buturo bwanyu bwose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        }
