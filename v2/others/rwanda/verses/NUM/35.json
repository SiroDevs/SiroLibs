              "type": "text"
            }
          ]
        },
        {
          "text": "kuko uwo yari akwiriye kuguma mu mudugudu w'ubuhungiro bwe, akageza aho umutambyi mukuru azapfira. Maze umutambyi namara gupfa, gatozi uwo azasubire mu isambu ya gakondo ye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
