          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ntimukemere ikarabo ry'uwishe umuntu akaba akwiye guhōrwa, ahubwo ntakabure guhōrwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntimukemere ikarabo ry'uwahungiye mu mudugudu w'ubuhungiro bwe ngo asubire gutura mu gihugu, umutambyi atarapfa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        }
      ]
    },
