          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Nuko ntimuzanduze igihugu muzabamo, kuko amaraso yanduza igihugu, ntihabe impongano yagihongererwa ku bw'amaraso yakiviriyemo, itari ay'uwayavushije. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuzanduze igihugu muzaturamo nkaba hagati muri cyo, kuko ndi Uwiteka uba hagati mu Bisirayeli.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
