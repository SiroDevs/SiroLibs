  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "NUM 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abisirayeli baritotomba, umuriro w'Uwiteka wicamo benshi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo bwoko buritotomba, Uwiteka yumva ko ari bibi. Abyumvise uburakari bwe burakongezwa, umuriro w'Uwiteka wicāna muri bo, ukongora abo ku iherezo ry'amagando yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu batakira Mose, asenga Uwiteka uwo muriro urazima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.2",
            "verseOrgIds": [
              "NUM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hantu bahita Tabera, kuko umuriro w'Uwiteka wicānye muri bo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abisirayeli banga manu basaba Mose inyama, ariganyira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamahanga y'ikivange bari hagati y'Abisirayeli batangira kwifuza, Abisirayeli na bo bongera kurira, baravuga bati “Ni nde uzaduha inyama zo kurya? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.4",
            "verseOrgIds": [
              "NUM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twibutse ya mafi twariraga ubusa tukiri muri Egiputa, n'amadegede n'amapapayi, n'ubutunguru bw'ibibabi by'ibibati n'ubutunguru bw'ibijumba, n'udutungurucumu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.5",
            "verseOrgIds": [
              "NUM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko none turumye nta cyo dufite, nta kindi tureba kitari manu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.7",
            "verseOrgIds": [
              "NUM.11.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.31"
              },
              "items": [
                {
                  "text": "Kuva 16.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Manu iyo yasaga n'utubuto tw'ibyatsi byitwa gadi, ishusho yayo yasaga n'iy'ubushishi buva ku giti bwitwa budola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.7",
            "verseOrgIds": [
              "NUM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu barazereraga bakayiteranya, bakayisya cyangwa bakayisekura, bakayiteka mu nkono bakayihindura udutsima. Kuryoha kwayo kwari nk'uk'udutsima twavuganywe n'amavuta ya elayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.8",
            "verseOrgIds": [
              "NUM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.13+EXO.16.14+EXO.16.15"
              },
              "items": [
                {
                  "text": "Kuva 16.13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikime nijoro cyatonda aho babambye amahema, manu igatondana na cyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose yumva abantu barira, umuntu wese arirana n'inzu ye barira mu miryango y'amahema yabo. Uburakari bw'Uwiteka bukongezwa cyane, bibabaza Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.10",
            "verseOrgIds": [
              "NUM.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abwira Uwiteka ati “Ni iki gituma ugirira nabi umugaragu wawe? Ni iki kimbujije kukugiriraho umugisha, ukanyikoreza aba bantu bose ho umutwaro? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.11",
            "verseOrgIds": [
              "NUM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasamye inda y'ubu bwoko bwose se, ni jye wababyaye ko untegeka kubaterura, nkabatengamatira mu gituza, nk'uko umurezi w'umugabo atengamatira umwana wonka, nkabajyana mu gihugu wasezeranije ba sekuruza? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.12",
            "verseOrgIds": [
              "NUM.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakura he inyama zo kugaburira ubu bwoko bwose, ko bandirira imbere bati ‘Duhe inyama tuzirye’? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.13",
            "verseOrgIds": [
              "NUM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sinabasha guheka ubu bwoko bwose jyenyine, kuko buremereye simbushobore. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.14",
            "verseOrgIds": [
              "NUM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niba ungenza uty ndakwingize nyica mveho, niba nkugiriyeho umugisha ne kubona ibyago byanjye.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uwiteka aha Mose abafasha mirongo irindwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati “Nteraniriza abagabo mirongo irindwi bo mu bakuru b'Abisirayeli, abo uzi ko ari abakuru b'abantu koko n'abatware babo, ubazane ku ihema ry'ibonaniro bahagararaneho nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanjye ndi bumanuke mvuganireyo nawe, nende ku Mwuka ukuriho mubashyireho. Na bo bazajya bahekana nawe uwo mutwaro w'abantu, we kuwuheka wenyine. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.17",
            "verseOrgIds": [
              "NUM.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bwira abantu uti: Mwiyereze umunsi w'ejo kandi muzarya inyama, kuko muririye ku matwi y'Uwiteka mukavuga muti ‘Ni nde uzaduha inyama zo kurya, ko twari tumereye neza muri Egiputa?’ Ni cyo gitumye Uwiteka azabaha inyama mukazirya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuzazirya umunsi umwe cyangwa ibiri cyangwa itanu, cyangwa icumi cyangwa makumyabiri, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.19",
            "verseOrgIds": [
              "NUM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahubwo muzazirya ukwezi kose mugeze aho zizabatungukira mu mazuru zikababihira, kuko mwanze Uwiteka uri muri mwe, mukamuririra imbere muti ‘Twaviriye iki muri Egiputa?’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aramusubiza ati “Ubwoko ndi hagati ni abagabo bigenza uduhumbi dutandatu, umva ko uvuze uti ‘Nzabaha inyama bazirye ukwezi kose.’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.21",
            "verseOrgIds": [
              "NUM.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazababagira imikumbi n'amashyo byo kubahaza? Cyangwa amafi yo mu nyanja yose azabateranirizwa yo kubahaza?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati “Mbese amaboko y'Uwiteka abaye magufi? None urareba yuko ijambo ryanjye rigusohorera, cyangwa ritagusohorera.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abafasha ba Mose barahanura: yanga kugira ishyari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose arasohoka abwira abantu ayo magambo y'Uwiteka, kandi ateranya abagabo mirongo irindwi bo mu bakuru b'abantu, abagotesha ihema ryera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.24",
            "verseOrgIds": [
              "NUM.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka amanukira muri cya gicu avugana na we, yenda ku Mwuka umuriho, amushyira kuri abo bakuru uko ari mirongo irindwi. Nuko Umwuka abaguyeho barahanura, bagarukiriza aho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mu ngando zabo hasigara abagabo babiri, umwe yitwa Eludadi, undi yitwa Medadi. Umwuka abagwaho, kandi bari mu mubare w'abanditswe ariko batavuye aho ngo bajye ku ihema ryera, bahanurira aho mu ngando. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.26",
            "verseOrgIds": [
              "NUM.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhungu w'umusore agenda yiruka abwira Mose ati “Eludadi na Medadi barahanurira mu ngando.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.27",
            "verseOrgIds": [
              "NUM.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.27",
            "verseOrgIds": [
              "NUM.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa mwene Nuni, wari umufasha wa Mose uhereye mu busore bwe, aramubwira ati “Databuja Mose, babuze.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.28",
            "verseOrgIds": [
              "NUM.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.28",
            "verseOrgIds": [
              "NUM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aramubaza ati “Ni jye urwaniye ishyaka? Icyampa ab'ubwoko bw'Uwiteka bose bakaba abahanuzi, Uwiteka akabashyiraho Umwuka we!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose asubirana mu ngando n'abakuru ba Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abisirayeli bahabwa inyama, bahanwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuyaga uturuka ku Uwiteka, uzana inturumbutsi zivuye ku nyanja, uzigusha aho babambye amahema n'impande zose, zigeza aho umuntu yagenda urugendo rw'umunsi umwe, ikirundo cyazo kireshya n'intambwe enye z'intoki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu barahaguruka, biriza uwo munsi bazitoragura bakesha ijoro, biriza n'undi munsi. Uwatoraguye nke aba atoraguye homeru cumi. Bazanika hose impande zose z'ingando zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.32",
            "verseOrgIds": [
              "NUM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama bakizishinze amenyo bataramara kuzitapfuna, uburakari bw'Uwiteka bukongerezwa abantu, abatera mugiga ikomeye cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hantu bahita Kiburotihatava",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kiburotihatava",
              "type": "text"
            },
            {
              "text": "risobanurwa ngo Imva z'abifuzaga.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kuko ari ho bahambye abifuzaga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        }
      ]
    },
