            "number": "1",
            "style": "v",
            "sid": "NUM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.1",
            "verseOrgIds": [
              "NUM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tegeka Abisirayeli bakure mu mahema yanyu umubembe wese n'uninda wese, n'uhumanyijwe n'intumbi wese. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.2",
            "verseOrgIds": [
              "NUM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho baba abagabo cyangwa abagore, mujye mubakuramo mubajyane inyuma yaho, kugira ngo batanduza aho mubambye amahema ntuye hagati.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.3",
            "verseOrgIds": [
              "NUM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bagenza batyo, babakura mu ngando zabo. Uko Uwiteka yategetse Mose aba ari ko Abisirayeli bakora.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 5:5"
          },
          "items": [
