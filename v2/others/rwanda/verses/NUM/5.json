            "sid": "NUM 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niba atanduye, ahubwo akaba adahumanye nta cyo azaba, ntibizamubuza gusama inda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        }
