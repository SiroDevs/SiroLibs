              "type": "text"
            }
          ]
        },
        {
          "text": "no ku mugabo ufatwa n'ifuhe agafuhira umugore we. Ashyire uwo mugore imbere y'Uwiteka, umutambyi amugirire ibitegekwa n'iryo tegeko byose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
