          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.12",
            "verseOrgIds": [
              "NUM.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose atakira Uwiteka ati “Mana ndakwingize, mukize.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
