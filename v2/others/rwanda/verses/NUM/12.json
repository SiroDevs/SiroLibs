            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.15",
            "verseOrgIds": [
              "NUM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ubwo bwoko burahaguruka buva i Haseroti, bubamba amahema mu butayu bwa Parani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.16",
            "verseOrgIds": [
              "NUM.12.16"
            ]
          }
        }
