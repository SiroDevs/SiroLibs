            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.28"
              },
              "items": [
                {
                  "text": "Lewi 27.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ituro ryose riturwa burundu rizabe iryawe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uburiza bwose bw'ibifite umubiri byose bazatura Uwiteka, ubw'abantu n'ubw'amatungo bujye buba ubwawe, ariko uburiza bw'abantu ntukabure kubucungurisha, n'ubw'amatungo azira na bwo ujye ubucungurisha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.15",
            "verseOrgIds": [
              "NUM.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibikwiriye gucungurwa, ujye ubicungurisha bihereye ku kwezi bivutse, bicunguzwe igiciro uzacira cya shekeli eshanu zigezwe ku y'Ahera, ari yo gera makumyabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.16",
            "verseOrgIds": [
              "NUM.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko uburiza bw'inka cyangwa ubw'intama cyangwa ubw'ihene ntukabucungurishe, ubw'izo ni ubwera. Ujye umisha amaraso yabwo ku gicaniro, wose urugimbu rwabwo rube igitambo gikongorwa n'umuriro, cy'umubabwe uhumurira Uwiteka neza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.17",
            "verseOrgIds": [
              "NUM.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama zabwo zijye ziba umwanya wawe, nk'uko inkoro izunguzwa n'urushyi rw'ukuboko rw'iburyo ari umwanya wawe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.18",
            "verseOrgIds": [
              "NUM.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.18",
            "verseOrgIds": [
              "NUM.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibyererezwa byose byo mu byera Abisirayeli bazatura Uwiteka, mbiguhanye n'abahungu bawe n'abakobwa bawe. Iryo ni itegeko ritazakuka iteka. Ni isezerano risezeranishwa umunyu, rizahamira iteka imbere y'Uwiteka, risezeraniwe wowe n'urubyaro rwawe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
