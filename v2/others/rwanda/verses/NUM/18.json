            "sid": "NUM 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uwiteka abwira Aroni ati “Ntuzagire gakondo mu gihugu cy'Abisirayeli, ntuzagire umugabane muri bo, ni jye mugabane wawe na gakondo yawe mu Bisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        }
      ]
    },
