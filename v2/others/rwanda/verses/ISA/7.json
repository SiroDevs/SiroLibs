          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Icyo gihe umuntu azaragira inka y'iriza n'intama ebyiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko kuko amata azaba ari menshi, azatungwa n'amavuta, ndetse abazasigara mu gihugu bose bazatungwa n'amavuta n'ubuki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
            "verseOrgIds": [
              "ISA.7.22"
            ]
          }
        }
