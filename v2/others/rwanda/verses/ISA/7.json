    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahazi aterwa na Resini na Peka, Yesaya amuhanurira ibyo kumukomeza",
          "type": "text"
        }
      ]
    },
    {
