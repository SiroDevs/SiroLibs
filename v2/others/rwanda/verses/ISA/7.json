          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi icyo gihe ahabaga imizabibu igihumbi igura shekeli igihumbi, hose hazamera imifatangwe n'amahwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.23",
            "verseOrgIds": [
              "ISA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwitwaje umuheto n'imyambi ni we uzahagera, kuko igihugu cyose kizaba ari imifatangwe n'amahwa gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
            "verseOrgIds": [
              "ISA.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'imisozi yahingwaga yose, uzayitinyishwa n'imifatangwe n'amahwa, ahubwo hazaba urwuri rw'inka n'intama.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.25",
            "verseOrgIds": [
              "ISA.7.25"
            ]
          }
