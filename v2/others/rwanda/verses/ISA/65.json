              "ISA.65.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.22"
              },
              "items": [
                {
                  "text": "Yes 66.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.13"
              },
              "items": [
                {
                  "text": "2 Pet 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.1"
              },
              "items": [
                {
                  "text": "Ibyah 21.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Dore ndarema ijuru rishya n'isi nshya, ibya kera ntibizibukwa kandi ntibizatekerezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.17",
            "verseOrgIds": [
              "ISA.65.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 65:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo nimunezerwe mujye mwishimira ibyo ndema, kuko ndema i Yerusalemu ngo mpagire ibyishimo, nkarema abantu baho bakaba umunezero. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.18",
            "verseOrgIds": [
              "ISA.65.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 65:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.4"
              },
              "items": [
                {
                  "text": "Ibyah 21.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nzanezererwa i Yerusalemu nishimire abantu banjye, kandi ijwi ryo kurira n'imiborogo ntibizahumvikana ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.19",
            "verseOrgIds": [
              "ISA.65.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 65:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihazongera kubamo umwana umaze iminsi mike, cyangwa umusaza udashyikije imyaka ye, kuko umwana azapfa amaze imyaka ijana, ariko umunyabyaha azavumwa, apfe atamaze imyaka ijana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.20",
            "verseOrgIds": [
              "ISA.65.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 65:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazubaka amazu bayabemo, kandi bazatera inzabibu barye imbuto zazo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.21",
            "verseOrgIds": [
              "ISA.65.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 65:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibazubaka amazu ngo abandi bayabemo, ntibazatera inzabibu ngo ziribwe n'abandi, kuko bazamara imyaka nk'ibiti, kandi abatoni banjye bazashyira kera bishimira imirimo y'intoki zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.22",
            "verseOrgIds": [
              "ISA.65.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 65:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibazaruhira ubusa kandi ntibazabyara abana bo kubona amakuba, kuko bazaba ari urubyaro rw'abahawe umugisha n'Uwiteka, hamwe n'abazabakomokaho. ",
