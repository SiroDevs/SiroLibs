            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.14"
              },
              "items": [
                {
                  "text": "Zab 118.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dore Imana ni yo gakiza kanjye nzajya niringira ne gutinya, kuko Uwiteka Yehova ari we mbaraga zanjye n'indirimbo yanjye agahinduka agakiza kanjye.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma muzavomana ibyishimo mu mariba y'agakiza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        }
      ]
    },
    {
