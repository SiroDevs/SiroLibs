              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo munsi uzavuga uti “Uwiteka, ndagushimira yuko nubwo wandakariraga, uburakari bwawe bushize ukampumuriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        },
        {
