        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.21",
            "verseOrgIds": [
              "ISA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nzabahagurukira”, ni ko Uwiteka Nyiringabo avuga, “Kandi i Babuloni nzahatsemba izina ryaho n'abasigaye bacitse ku icumu, abana n'abuzukuru.” Ni ko Uwiteka avuga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nzahahindura igihugu cy'ibinyogote n'ibidendezi by'amazi, nzahakubuza umweyo urimbura.” Ni ko Uwiteka Nyiringabo avuga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uwiteka aburira Ashuri n'i Bufilisitiya",
          "type": "text"
        }
      ]
    },
