                "loc": "REV.8.10"
              },
              "items": [
                {
                  "text": "Ibyah 8.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.1"
              },
              "items": [
                {
                  "text": "9.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Wa nyenyeri yo mu ruturuturu we, mwana w'umuseke ko uvuye mu ijuru, ukagwa! Uwaneshaga amahanga ko baguciye bakakugeza ku butaka! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.12",
            "verseOrgIds": [
              "ISA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.23"
              },
              "items": [
                {
                  "text": "Mat 11.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.15"
              },
              "items": [
                {
                  "text": "Luka 10.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waribwiraga uti ‘Nzazamuka njye mu ijuru nkuze intebe yanjye y'ubwami isumbe inyenyeri z'Imana’, kandi uti ‘Nzicara ku musozi w'iteraniro mu ruhande rw'impera y'ikasikazi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.13",
            "verseOrgIds": [
              "ISA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nzazamuka ndenge aho ibicu bigarukira, nzaba nk'Isumbabyose.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.14",
            "verseOrgIds": [
              "ISA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko uzamanuka ikuzimu ugere ku ndiba ya rwa rwobo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.15",
            "verseOrgIds": [
              "ISA.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.15",
            "verseOrgIds": [
              "ISA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abazakubona bazakwitegereza cyane bagutekerezeho bati ‘Uyu ni we wahindishaga isi umushyitsi akanyeganyeza ubwami, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.16",
            "verseOrgIds": [
              "ISA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "agahindura isi ubutayu, asenya imidugudu yo muri yo, ntarekure abanyagano ngo basubire iwabo?’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.17",
            "verseOrgIds": [
              "ISA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abami b'amahanga bose uko bangana basinzirira mu cyubahiro, umwami wese mu nzu ye bwite. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.18",
            "verseOrgIds": [
              "ISA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho wowe bagutesheje imva yawe, utabwa nk'ishami ryanzwe urunuka, uri mu ntumbi zihinguranijwe n'inkota zijugunywa mu mabuye yo mu rwobo, kandi umeze nk'intumbi bakandagira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.19",
            "verseOrgIds": [
              "ISA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntuzahambanwa n'abandi bami kuko watsembye igihugu cyawe ukica abantu bawe, urubyaro rw'inkozi z'ibibi ntiruzibukwa iteka ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.20",
            "verseOrgIds": [
              "ISA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimutegure aho kwicira abana bazira gukiranirwa kwa ba se, kugira ngo badahaguruka bagahindūra isi bakayikwizamo imidugudu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.21",
            "verseOrgIds": [
              "ISA.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
