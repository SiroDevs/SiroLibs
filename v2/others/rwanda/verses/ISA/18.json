          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo gihe bazazanira Uwiteka Nyiringabo abantu barebare b'umubiri urembekereye ho indabukirano, ari bo bantu bahoze batera ubwoba na bugingo n'ubu, ishyanga risenya rigasiribanga igihugu cyaryo kigabanywa n'imigezi, babazane ahantu h'izina ry'Uwiteka Nyiringabo, ari wo musozi wa Siyoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
