            "sid": "ISA 49:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana wanyazwe bazakuvugira mu matwi hanyuma bati ‘Hano hambereye imfungane, mpa aho gutura.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.20",
            "verseOrgIds": [
              "ISA.49.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzaherako wibaze mu mutima uti ‘Mbese aba bana nababyariwe na nde, ko abanjye banyazwe nkaba ndi impfusha n'igicibwa n'inzererezi? Mbese aba barezwe na nde? Ariko se ko nasigaye ndi umwe, aba bahoze he?’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.21",
            "verseOrgIds": [
              "ISA.49.21"
            ]
          }
        }
      ]
