              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese abakomeye bānyagwa iminyago, cyangwa abajyanwa ari imbohe bazira ukuri bararekurwa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.24",
            "verseOrgIds": [
              "ISA.49.24"
            ]
