          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 47:8"
          },
          "items": [
