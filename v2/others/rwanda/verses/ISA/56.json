            "number": "5",
            "style": "v",
            "sid": "ISA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi abanyamahanga bahakwa ku Uwiteka bakamukorera bakunze izina rye bakaba abagaragu be, umuntu wese akeza isabato ntayice agakomeza isezerano ryanjye, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
