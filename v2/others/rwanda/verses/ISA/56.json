              "items": [
                {
                  "text": "Luka 19.46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " abo na bo nzabageza ku musozi wanjye wera, mbanezereze mu nzu yanjye y'urusengero. Ibitambo byabo byoswa n'amaturo yabo bizemerwa bitambirwe ku gicaniro cyanjye kuko inzu yanjye izitwa inzu yo gusengerwamo n'amahanga yose.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
