          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ririmba wa juru we, kuko Uwiteka yabikoze. Rangurura wa kuzimu ko hasi we. Nimuturagare muririmbe mwa misozi mwe, nawe shyamba n'igiti cyose kiririmo, kuko Uwiteka yacunguye Yakobo kandi azibonera icyubahiro muri Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.23",
            "verseOrgIds": [
              "ISA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
