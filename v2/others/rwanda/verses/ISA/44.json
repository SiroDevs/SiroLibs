                "loc": "2CH.36.23"
              },
              "items": [
                {
                  "text": "2 Ngoma 36.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.1.2"
              },
              "items": [
                {
                  "text": "Ezira 1.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi avuga ibya Kuro ati ‘Ni umushumba wanjye, azasohoza ibyo nshaka byose.’ Akavuga iby'i Yerusalemu ati ‘Hazubakwa’, kandi avuga iby'urusengero ati ‘Urufatiro rwawe ruzashyirwaho.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.28",
            "verseOrgIds": [
