          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndavuga nti “Ni ishyano, ndapfuye we! Kuko ndi umunyaminwa yanduye, kandi ntuye hagati y'ubwoko bufite iminwa yanduye, kandi amaso yanjye abonye Umwami Uwiteka Nyiringabo.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
