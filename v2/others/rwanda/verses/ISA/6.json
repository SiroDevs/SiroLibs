                "loc": "2CH.26.23"
              },
              "items": [
                {
                  "text": "2 Ngoma 26.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwaka umwami Uziya yatanzemo, nabonye Umwami Imana yicaye ku ntebe y'ubwami ndende ishyizwe hejuru, igishura cyayo gikwira urusengero. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaserafi bari bahagaze hejuru yayo, umuserafi wese afite amababa atandatu. Abiri yayatwikirizaga mu maso he, yandi abiri yayatwikirizaga ibirenge bye, ayandi abiri yarayagurukishaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Ibyah 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umwe avuga ijwi rirenga abwira mugenzi we asingiza ati “Uwiteka Nyiringabo arera, arera, arera. Isi yose yuzuye icyubahiro cye.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
