                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Irambwira iti “Genda ubwire ubu bwoko uti ‘Kumva muzajye mwumva, ariko mwe kubimenya, kureba muzajye mureba, ariko mwe kubyitegereza.’ 28.26-27 ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye unangira imitima y'ubu bwoko, uhindure amatwi yabo ibihuri, upfuke amaso yabo kugira ngo batarebesha amaso, batumvisha amatwi, batamenyesha imitima, bagahindukira bagakira.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        }
      ]
    },
