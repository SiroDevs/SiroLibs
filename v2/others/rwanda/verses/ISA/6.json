              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imfatiro z'irebe ry'umuryango zinyeganyezwa n'ijwi ry'uwavuze ijwi rirenga, inzu yose yuzura umwotsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        }
      ]
