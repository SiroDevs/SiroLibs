            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.15"
              },
              "items": [
                {
                  "text": "Yow 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimuboroge kuko umunsi w'Uwiteka uri bugufi. Uzaza ari umunsi wo kurimbuka uturutse ku Ishoborabyose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo bizatuma amaboko yose atentebuka, n'umutima w'umuntu wese ukuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baziheba, umubabaro n'uburibwe bizabafata, bazababara nk'umugore uri ku nda, bazarebana bumirwe kandi mu maso habo hazatugengeza hase n'umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore umunsi w'Uwiteka uraje, uzazana uburakari bw'inkazi n'umujinya mwinshi uhindure igihugu imyirare, urimbure n'abanyabyaha bo muri cyo bagishiremo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.7"
              },
              "items": [
                {
                  "text": "Ezek 32.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.29"
              },
              "items": [
                {
                  "text": "Mat 24.29",
