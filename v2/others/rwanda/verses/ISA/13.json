                "loc": "MRK.13.24+MRK.13.25"
              },
              "items": [
                {
                  "text": "Mar 13.24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.15"
              },
              "items": [
                {
                  "text": "Luka 21.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12+REV.6.13"
              },
              "items": [
                {
                  "text": "Ibyah 6.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Inyenyeri zo mu ijuru n'ubukaga bwazo ntibizaka, izuba rizijima rikirasa, n'ukwezi ntikuzava umwezi wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzahana ab'isi mbahora ibyo bakoze bibi, n'abanyabyaha nzabahana mbahora gukiranirwa kwabo, nzamaraho ubwibone bw'abibone, n'agasuzuguro k'abanyagitinyiro nzagacisha bugufi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzatubya abantu babe ingume kurusha izahabu nziza, ndetse umuntu azaba ingume arushe izahabu nziza ya Ofiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.12",
            "verseOrgIds": [
              "ISA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo kizatuma mpindisha ijuru umushyitsi, isi na yo nkayinyeganyeza ikava ahayo, mbikoreshejwe n'umujinya w'Uwiteka Nyiringabo ku munsi w'uburakari bwe bukaze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.13",
            "verseOrgIds": [
              "ISA.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.13",
            "verseOrgIds": [
              "ISA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umuntu wese azasubira iwabo yiruka nk'isha ihigwa cyangwa intama itagira umwungeri, umuntu wese azahungira mu gihugu cyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.14",
            "verseOrgIds": [
              "ISA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo bazabona wese bazamusogota, kandi uzafatwa wese bazamwicisha inkota. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.15",
            "verseOrgIds": [
              "ISA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impinja zabo na zo bazazibahondera imbere, amazu yabo azasahurwa kandi abagore babo bazendwa ku gahato.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.16",
            "verseOrgIds": [
              "ISA.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.16",
            "verseOrgIds": [
              "ISA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore nzabateza Abamedi, ntibazita ku ifeza, kabone n'izahabu ntizabanezeza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.17",
            "verseOrgIds": [
              "ISA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamiheto bazavunagura abasore, ntibazababarira urubyaro rwabo, ntibazagirira imbabazi n'abana babo batoya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.18",
            "verseOrgIds": [
              "ISA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Itang 19.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi i Babuloni ari ho cyubahiro cy'amahanga y'abami, ari ho bwiza bw'ubwibone bw'Abakaludaya, hazamera nk'uko Imana yarimburaga i Sodomu n'i Gomora. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.19",
            "verseOrgIds": [
              "ISA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihazongera guturwa kandi ntihazongera kubabwa uko ingoma yimye. Abarabu ntibazahashinga amahema, kandi n'abungeri ntibazahabyagiza imikumbi yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.20",
            "verseOrgIds": [
              "ISA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
