                }
              ]
            }
          ]
        },
        {
          "text": " Kuko kuri uyu musozi ari ho ukuboko k'Uwiteka kuzaruhukira, i Mowabu hazaribatirwa aho ari nk'uko inganagano ziribatirwa mu ngerera y'amase. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi azaramburiramo amaboko nk'uko uwoga arambura amaboko ngo yoge, azareka ubwibone bwe n'ubugambanyi yagambanaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihome cy'umunara cyo ku nkike zawe z'amabuye Imana yaragishenye, irakirambika ikigeza ku butaka no mu mukungugu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
          }
        }
