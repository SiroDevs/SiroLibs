                "loc": "1CO.15.54"
              },
              "items": [
                {
                  "text": "1 Kor 15.54",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.17"
              },
              "items": [
                {
                  "text": "Ibyah 7.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.4"
              },
              "items": [
                {
                  "text": "21.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kandi urupfu azarumira bunguri kugeza iteka ryose. Uwiteka Imana izahanagura amarira ku maso yose, n'igitutsi batuka ubwoko bwayo azagikura ku isi hose. Uwiteka ni we ubivuze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
