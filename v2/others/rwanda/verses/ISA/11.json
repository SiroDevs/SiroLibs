              },
              "items": [
                {
                  "text": "22.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu gitsina cya Yesayi hazakomoka agashami, mu mizi ye hazumbura ishami ryere imbuto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwuka w'Uwiteka azaba kuri we, umwuka w'ubwenge n'uw'ubuhanga, umwuka wo kujya inama n'uw'imbaraga, umwuka wo kumenya Uwiteka n'uwo kumwubaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azanezezwa no kubaha Uwiteka, ntace imanza z'ibyo yeretswe gusa, kandi ntazumva urw'umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.8"
              },
              "items": [
                {
                  "text": "2 Tes 2.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ahubwo azacira abakene imanza zitabera, n'abagwaneza bo mu isi azabategekesha ukuri, kandi isi azayikubitisha inkoni yo mu kanwa ke, n'abanyabyaha azabicisha umwuka unyura mu minwa ye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.14"
              },
              "items": [
                {
                  "text": "Ef 6.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gukiranuka kuzaba umushumi akenyeza, kandi umurava uzaba umushumi wo mu rukenyerero rwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
