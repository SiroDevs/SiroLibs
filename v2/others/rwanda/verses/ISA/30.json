              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka azumvikanisha ijwi rye ry'icyubahiro, kandi kumanuka k'ukuboko kwe azakwerekanisha uburakari bwe n'umujinya we, n'ikirimi cy'umuriro ukongora n'inkubi y'umuyaga n'urubura. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.30",
            "verseOrgIds": [
              "ISA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashuri bazakurwa umutima n'ijwi ry'Uwiteka, azabakubita inkoni ye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi uko bazajya babakubita inkoni zitegetswe, izo bazaba bategetswe n'Uwiteka, hazajya habaho ishako n'inanga, kandi azabarwanya intambara akorera ukuboko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.32",
            "verseOrgIds": [
              "ISA.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tofeti hiteguwe uhereye kera, hiteguriwe umwami. Uwiteka yahagize harehare kandi hagari, ikome ry'aho ni umuriro n'inkwi nyinshi, umwuka w'Uwiteka umeze nk'umugezi w'amazuku ari wo urikongeza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.33",
            "verseOrgIds": [
              "ISA.30.33"
            ]
          }
        }
      ]
