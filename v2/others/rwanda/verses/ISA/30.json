        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwiringira ab'isi nta mumaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abana b'abagome bazabona ishyano”, ni ko Uwiteka avuga, “Bagisha abandi inama batari jye bakifatanya n'abandi baretse Umwuka wanjye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.1",
            "verseOrgIds": [
              "ISA.30.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "baretse Umwuka wanjye:",
              "type": "text"
            },
            {
              "text": "cyangwa, bakitwikira igitwikirizo kitari Umwuka wanjye.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kugira ngo bongere icyaha ku kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.1",
            "verseOrgIds": [
              "ISA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahagurukira kujya muri Egiputa batangishije inama kugira ngo bisunge imbaraga za Farawo, bakiringira igicucu cya Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.2",
            "verseOrgIds": [
              "ISA.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko izo mbaraga za Farawo zizabakoza isoni, no kwiringira igicucu cya Egiputa kuzababera ikimwaro, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.3",
            "verseOrgIds": [
              "ISA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko abatware babo bari i Sowani, n'intumwa zabo zikaba zigeze i Hanesi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.4",
            "verseOrgIds": [
              "ISA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bose bazakorwa n'isoni kuko bazasanga ari abantu batabasha kubagirira umumaro ntibabarengere, kandi nta kamaro, ahubwo ari abo kubakoza isoni no kubatukisha.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.5",
            "verseOrgIds": [
              "ISA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.5",
            "verseOrgIds": [
              "ISA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibihanurirwa inyamaswa z'ikusi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.6",
            "verseOrgIds": [
              "ISA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banyura mu gihugu cy'amakuba n'uburibwe, aho intare y'ingore n'iy'ingabo zituruka, hakaba incira n'inzoka ziguruka z'ubumara butwika, bahekesheje ubutunzi bwabo ku migongo y'indogobe nto, bashyize n'ibintu byabo ku mapfupfu y'ingamiya, babishyira abantu batazabagirira umumaro, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.6",
            "verseOrgIds": [
              "ISA.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko imifashirize ya Egiputa ari nta kavuro, kandi nta cyo hamara, ni cyo gituma mpita izina Rahabu wicaye gusa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.7",
            "verseOrgIds": [
              "ISA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.7",
            "verseOrgIds": [
              "ISA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko genda ubyandikire ku gisate imbere yabo, ubyandike no mu gitabo, bibe iby'igihe kizaza kugeza iteka ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.8",
            "verseOrgIds": [
              "ISA.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ari ubwoko bugoma, abana babeshya, abana badakunda kumva amategeko y'Uwiteka, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.9",
            "verseOrgIds": [
              "ISA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "babwira bamenya bati “Ntimukarebe”, bakabwira n'abahanuzi bati “Ntimukaduhanurire iby'ukuri, ahubwo mujye mutubwiriza ibyoroheje muhanure ibinyoma, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.10",
            "verseOrgIds": [
              "ISA.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "muve mu nzira muteshuke, mutume Uwera wa Isirayeli atuvamo rwose.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.11",
            "verseOrgIds": [
              "ISA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.11",
            "verseOrgIds": [
              "ISA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Uwera wa Isirayeli aravuze ngo “Kuko muhinyuye iri jambo, mukiringira agahato n'ubugoryi mukaba ari byo mwishingikirizaho, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.12",
            "verseOrgIds": [
              "ISA.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni cyo gituma uku gikiranirwa kuzababera nk'inkike ihubanye igiye kugwa, nk'ahabogamye ho ku nkike ndende, kugwa kwayo kuzatungurana kutajuyaje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.13",
            "verseOrgIds": [
              "ISA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi azakimena nk'uko inkono y'umubumbyi imeneka, yayimena atayibabarira, mu njyo zayo zose ntihasigare n'uruganzo rwayora umuriro mu ziko cyangwa rwadahishwa amazi mu iriba.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.14",
            "verseOrgIds": [
              "ISA.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kugarukira Imana ni ko kudukiza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.14",
            "verseOrgIds": [
              "ISA.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka Imana, Uwera wa Isirayeli yavuze ati “Nimugaruka mugatuza muzakizwa, mu ituze no mu byiringiro ni mo muzaherwa imbaraga, ariko mwaranze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.15",
            "verseOrgIds": [
              "ISA.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo muravuga muti ‘Oya, kuko tuziruka ku mafarashi’. Ni koko ariko muzaba muhunze kandi muti ‘Tuzagendera ku y'imbaraga’. Ni koko n'abazabakurikira na bo bazaba abanyambaraga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.16",
            "verseOrgIds": [
              "ISA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu igihumbi bazirukanwa n'umuntu umwe ubakangisha, abantu batanu nibabakangisha muzahunga, kugeza ubwo muzasigara mumeze nk'igiti kirekire gishinze mu mpinga y'umusozi, cyangwa ibendera rishinze ku gasozi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.17",
            "verseOrgIds": [
              "ISA.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.17",
            "verseOrgIds": [
              "ISA.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igituma Uwiteka yihangana ni ukugira ngo abagirire neza, kandi igituma ashyirwa hejuru ni uko abagirira ibambe, kuko Uwiteka ari Imana ica imanza zitabera. Hahirwa abamutegereza bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.18",
            "verseOrgIds": [
              "ISA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko abantu bazatura i Siyoni h'i Yerusalemu ntuzongera kurira, ntazabura kukugirira neza numutakira, nakumva azagusubiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.19",
            "verseOrgIds": [
              "ISA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nubwo Uwiteka akugaburira ibyokurya by'amakuba n'amazi y'agahimano, abakwigisha ntibazongera guhishwa ahubwo amaso yawe azajya areba abakwigisha, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.20",
            "verseOrgIds": [
              "ISA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nimujya kunyura iburyo cyangwa ibumoso, amatwi yawe azajya yumva ijambo riguturutse inyuma rivuga riti “Iyi ni yo nzira mube ari yo mukomeza.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.21",
            "verseOrgIds": [
              "ISA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muzahumanya ifeza itewe ku bishushanyo byawe bibajwe, n'izahabu zitewe ku bishushanyo byawe biyagijwe. Uzabijugunya rwose nk'ikintu gihumanye ukibwire uti “Hoshi, vaho.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.22",
            "verseOrgIds": [
              "ISA.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.22",
            "verseOrgIds": [
              "ISA.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbuto uzabiba mu butaka azazivubira imvura, kandi imyaka y'umwero w'ubutaka izarumbuka ibe myinshi. Icyo gihe imikumbi yawe izarisha mu byanya bigari. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.23",
            "verseOrgIds": [
              "ISA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inka n'indogobe nto bihinga bizarya ibyokurya birimo umunyu, bigosojwe intara n'inkōko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.24",
            "verseOrgIds": [
              "ISA.30.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "bigosojwe . . . inkōko:",
              "type": "text"
            },
            {
              "text": "mu Ruheburayo ni bihungizwa n'inkōko ku ntara igosora.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.24",
            "verseOrgIds": [
              "ISA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku munsi w'icyorezo ubwo iminara izariduka, ku kirunga cyose no ku musozi wose muremure hazaturuka imigezi n'amasōko y'amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.25",
            "verseOrgIds": [
              "ISA.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwezi w'ukwezi uzamera nk'umucyo w'izuba, kandi umucyo w'izuba uzongerwa karindwi uhwane n'umucyo w'iminsi irindwi, ubwo Uwiteka azapfuka ibisebe by'abantu be akavura n'inguma zabo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore izina ry'Uwiteka riraza rituruka kure, rigurumana uburakari bwe, ricumba umwotsi mwinshi, iminwa ye yuzuye uburakari n'ururimi rwe rumeze nk'umuriro ukongora. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.27",
            "verseOrgIds": [
              "ISA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwuka we umeze nk'umugezi wuzuye ukagera mu ijosi, uzagosoza amahanga intara imaraho kandi icyuma n'umukoba biyobya bizaba mu nzasaya z'amahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.28",
            "verseOrgIds": [
              "ISA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko muzaririmba indirimbo nk'iyo baririmba nijoro ku munsi mukuru wera, muzagira n'umunezero wo mu mutima nk'uw'umuntu ufite umwironge, ajya ku musozi w'Uwiteka gusanga Igitare cya Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
