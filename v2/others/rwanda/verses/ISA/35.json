              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mukomeze amaboko atentebutse, mukomeze amavi asukuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubwire abafite imitima itinya muti “Mukomere ntimutinye, dore Imana yanyu izazana guhōra, ari ko kwitura kw'Imana, izaza ibakize.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
