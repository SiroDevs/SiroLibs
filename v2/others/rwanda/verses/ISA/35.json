              "items": [
                {
                  "text": "Luka 7.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Icyo gihe impumyi zizahumurwa, n'ibipfamatwi bizaziburwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo gihe ikirema kizasimbuka nk'impara, ururimi rw'ikiragi ruzaririmba kuko amazi azadudubiriza mu butayu, imigezi igatembera mu kidaturwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umusenyi wotsa utera ibishashi uzahinduka ikidendezi, n'umutarwe uzahinduka amasōko. Mu ikutiro ry'ingunzu, aho zaryamaga, hazaba ubwatsi n'uruberanya n'urufunzo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hazabayo inzira nyabagendwa, iyo nzira izitwa inzira yo kwera. Abanduye ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        },
        {
          "text": " ntibazayicamo, ahubwo izaba iya ba bandi. Abagenzi naho baba ari abaswa ntibazayiyoba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta ntare izahaba, inyamaswa yose y'inkazi ntizayigeramo, ntibizayibonekamo, ahubwo abacunguwe ni bo bazayinyuramo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.11"
              },
              "items": [
                {
                  "text": "Yes 51.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abacunguwe n'Uwiteka bazagaruka bagere i Siyoni baririmba, ibyishimo bihoraho bizaba kuri bo, bazabona umunezero n'ibyishimo kandi umubabaro no gusuhuza umutima bizahunga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
