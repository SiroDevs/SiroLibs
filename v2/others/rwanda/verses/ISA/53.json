              "ISA.53.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 53:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Uwiteka yashimye kumushenjagura, yaramubabaje. Ubwo ubugingo bwe buzitamba ho igitambo cyo gukuraho ibyaha, azabona urubyaro, azarama, ibyo Uwiteka ashaka bizasohozwa neza n'ukuboko kwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.10",
            "verseOrgIds": [
              "ISA.53.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 53:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azabona ibituruka mu bise by'ubugingo bwe bimwishimishe, bimuhaze. Umugaragu wanjye ukiranuka azatuma benshi baheshwa gukiranuka no kumenya, kandi azīshyiraho gukiranirwa kwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.11",
            "verseOrgIds": [
              "ISA.53.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 53:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.28"
              },
              "items": [
                {
                  "text": "Mar 15.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.37"
              },
              "items": [
                {
                  "text": "Luka 22.37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni cyo gituma nzamugabanya umugabane n'abakomeye, azagabana iminyago n'abanyamaboko, kuko yasutse ubugingo bwe akageza ku gupfa akabaranwa n'abagome, ariko ubwe yishyizeho ibyaha bya benshi kandi asabira abagome.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.12",
            "verseOrgIds": [
              "ISA.53.12"
            ]
