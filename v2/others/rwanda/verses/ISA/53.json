              },
              "items": [
                {
                  "text": "Rom 10.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni nde wizeye ibyo twumvise, kandi ukuboko k'Uwiteka kwahishuriwe nde? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yakuriye imbere ye nk'ikigejigeji, nk'igishyitsi cyumburira mu butaka bwumye, ntiyari afite ishusho nziza cyangwa igikundiro, kandi ubwo twamubonaga ntiyari afite ubwiza bwatuma tumwifuza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarasuzugurwaga akangwa n'abantu, yari umunyamibabaro wamenyereye intimba, yasuzugurwaga nk'umuntu abandi bima amaso natwe ntitumwubahe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.3",
            "verseOrgIds": [
              "ISA.53.3"
            ]
          }
        }
      ]
    },
    {
