          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.21",
            "verseOrgIds": [
              "ISA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimureke kwishingikiriza ku bantu bafite umwuka mu mazuru. Mbese mubaca iki?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.22",
            "verseOrgIds": [
              "ISA.2.22"
            ]
          }
        }
      ]
    }
