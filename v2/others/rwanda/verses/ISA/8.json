          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nibababwira ngo “Nimushake abashitsi mubashikishe, mushake n'abapfumu banwigira bakongorera”, mbese abantu ntibari bakwiriye gushaka Imana yabo, bakaba ari yo babaza? Mbese iby'abazima byabazwa abapfuye?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.19",
            "verseOrgIds": [
              "ISA.8.19"
            ]
          }
        }
      ]
    },
