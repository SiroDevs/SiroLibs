                "loc": "HEB.2.13"
              },
              "items": [
                {
                  "text": "Heb 2.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko Uwiteka wimaga amaso ab'inzu ya Yakobo, nzamutegereza murindire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.17",
            "verseOrgIds": [
              "ISA.8.17"
            ]
          }
        }
