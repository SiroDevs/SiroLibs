              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bumba Ibihamya, amategeko uyafatanishe ikimenyetso mu bigishwa banjye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
            "verseOrgIds": [
              "ISA.8.16"
            ]
          }
        },
        {
