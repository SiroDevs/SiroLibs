          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimusange amategeko y'Imana n'ibiyihamya. Nibatavuga ibihwanye n'iryo jambo nta museke uzabatambikira.",
          "type": "text",
          "attrs": {
