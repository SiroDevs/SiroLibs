            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo dushimira Imana ubudasiba ni uko ubwo twabahaga ijambo ry'ubutumwa bwiza, ari ryo jambo ry'Imana, mutaryemeye nk'aho ari ijambo ry'abantu, ahubwo mwaryemeye nk'ijambo ry'Imana nk'uko riri koko kandi rigakorera no muri mwe abizera, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.13",
            "verseOrgIds": [
              "1TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.5"
              },
              "items": [
                {
                  "text": "Ibyak 17.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko bene Data mwigānye amatorero y'Imana y'i Yudaya ari muri Kristo Yesu, kuko ibyo mwababajwe n'ubwoko bwanyu ari bimwe n'ibyo abo bababajwe n'Abayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.14",
            "verseOrgIds": [
              "1TH.2.14"
            ]
          }
        },
