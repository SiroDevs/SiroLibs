                "loc": "MAT.2.15"
              },
              "items": [
                {
                  "text": "Mat 2.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Isirayeli akiri umwana naramukundaga, hanyuma mpamagara umwana wanjye ngo ave muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bitandukanije n'ababahamagaraga bagatambirira ibigirwamana bya Bāli, kandi bakosereza ibishushanyo bibajwe imibavu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni jye wigishije Abefurayimu gutambuka ndabahagatira, ariko ntibamenye ko ari jye wabakijije. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabiyegereje n'imigozi nk'umuntu, mbakuruza imirunga y'urukundo, kandi nabamereye nk'abakura imikoba mu nzasaya zabo, mbashyira ibyokurya imbere.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ntibazasubira mu gihugu cya Egiputa, ariko Umwashuri ni we uzaba umwami wabo, kuko banze kungarukira. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkota izagwira imidugudu yabo, izavunagura imyugariro yabo iyitsembeho, bazize imigambi yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwoko bwanjye bwishimira kungomera, nubwo bahamagarirwa kwerekeza amaso ku Isumbabyose, ariko nta n'umwe uyihimbaza.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.22"
              },
              "items": [
                {
                  "text": "Guteg 29.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Efurayimu we, nabasha nte kukureka? Nawe Isirayeli we, naguhana nte? Mbese nakugenza nka Adima? Nakugira nk'uko nagize i Seboyimu? Umutima wanjye urabagarukiye, n'imbabazi zanjye zose ziragurumana. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sinzakurikiza uburakari bwanjye bukaze, kandi sinzagarurwa no gutsemba Efurayimu, kuko ndi Imana, sindi nk'umuntu. Ni jye Uwera uri hagati yanyu, sinzatwarana kuri uwo mudugudu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bazakurikira Uwiteka, azivuga nk'intare, ni ukuri azivuga. Abana bazaza bahinda umushyitsi bavuye iburengerazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazaza bavuye muri Egiputa bameze nk'uruhūri, no muri Ashuri bameze nk'inuma, kandi nzabaha kuba mu mazu yabo.” Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
    }
  ],
