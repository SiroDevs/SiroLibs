              "HOS.10.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.19.1+JDG.19.2+JDG.19.3+JDG.19.4+JDG.19.5+JDG.19.6+JDG.19.7+JDG.19.8+JDG.19.9+JDG.19.10+JDG.19.11+JDG.19.12+JDG.19.13+JDG.19.14+JDG.19.15+JDG.19.16+JDG.19.17+JDG.19.18+JDG.19.19+JDG.19.20+JDG.19.21+JDG.19.22+JDG.19.23+JDG.19.24+JDG.19.25+JDG.19.26+JDG.19.27+JDG.19.28+JDG.19.29+JDG.19.30"
              },
              "items": [
                {
                  "text": "Abac 19.1-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Isirayeli we, wacumuye uhereye igihe cy'i Gibeya, ni ko bakomeje kugira ngo intambara yabaye ku bakiranirwa b'i Gibeya itabageraho. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.9",
            "verseOrgIds": [
              "HOS.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzabahana uko nshaka, kandi abanyamahanga bazateranira kubarwanya, igihe bazaba baboshywe ku bicumuro byabo uko ari bibiri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.10",
            "verseOrgIds": [
              "HOS.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Efurayimu ni nk'ishashi yamenyerejwe, ikunda kuvunga ingano, ariko nzashyira ingiga y'igiti ku ijosi rye ryiza. Efurayimu nzamushyiraho umugenda hejuru, Yuda azarima, Yakobo na we azacoca. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.3"
              },
              "items": [
                {
                  "text": "Yer 4.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwibibire mukurikiza gukiranuka, musarure mukurikiza imbabazi, murime imishike yanyu kuko ari igihe cyo gushaka Uwiteka, kugeza igihe azaza akabavubira gukiranuka. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwahinze gukiranirwa musarura ibibi, mwariye imbuto z'ibinyoma, kuko wiringiye imigambi yawe n'ubwinshi bw'intwari zawe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma hazaba imivurungano mu bwoko bwawe, kandi ibihome byawe byose bizasenywa, nk'uko Shalumani yarimbuye i Betarubeli ku munsi w'intambara, ubwo umubyeyi yavungaguranwaga n'abana be. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.14",
            "verseOrgIds": [
              "HOS.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ko i Beteli muzagenzwa muzize ibibi byanyu bikabije. Mu museke umwami wa Isirayeli azaba amaze kurimburwa rwose.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.15",
            "verseOrgIds": [
              "HOS.10.15"
            ]
          }
        }
      ]
    }
  ],
