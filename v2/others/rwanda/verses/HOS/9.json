            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.16",
            "verseOrgIds": [
              "HOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HOS 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana yanjye izabica kuko batayumviye, kandi bazarorongotanira mu mahanga yose.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.17",
            "verseOrgIds": [
              "HOS.9.17"
            ]
          }
        }
      ]
