                  "text": "Guteg 7.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi muri iyo minsi mbona Abayuda bashatse abagore b'Abanyashidodikazi n'Abamonikazi n'Abamowabukazi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
