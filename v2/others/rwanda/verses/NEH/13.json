                "loc": "DEU.23.4+DEU.23.5+DEU.23.6"
              },
              "items": [
                {
                  "text": "Guteg 23.4-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uwo munsi basomera abantu mu gitabo cya Mose, basanga handitswemo yuko nta Mwamoni cyangwa Umumowabu uzajya mu iteraniro ry'Imana iteka ryose, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.1",
            "verseOrgIds": [
              "NEH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.1+NUM.22.2+NUM.22.3+NUM.22.4+NUM.22.5+NUM.22.6"
              },
              "items": [
                {
                  "text": "Kub 22.1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko batasanganije Abisirayeli imitsima n'amazi, ahubwo bakabaguririra kuri Balāmu ngo abavume, ariko Imana yacu ihindura umuvumo kuba umugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bumvise amategeko, baherako barobanura mu Bisirayeli ikivange cy'abanyamahanga cyose.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nehemiya yirukana Tobiya mu nzu y'Imana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibyo bitaraba, Eliyashibu umutambyi washyiriweho gutegeka ibyumba byo mu nzu y'Imana yacu ubwo yari yuzuye na Tobiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.4",
            "verseOrgIds": [
              "NEH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "yari yamutunganirije icyumba kinini aho kera babikaga amaturo y'amafu n'icyome, n'ibikoreshwa n'ibice bya kimwe mu icumi by'imyaka y'impeke na vino n'amavuta, ibyagererwaga Abalewi n'abaririmbyi n'abakumirizi ku bw'itegeko, hamwe n'amaturo azunguzwa aturirwa abatambyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.5",
            "verseOrgIds": [
              "NEH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko muri iyo minsi yose sinari ndi i Yerusalemu, kuko mu mwaka wa mirongo itatu n'ibiri wo ku ngoma y'umwami w'i Babuloni Aritazeruzi nari narasanze umwami, maze hashize iminsi nsaba umwami yuko ansezerera. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.6",
            "verseOrgIds": [
              "NEH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njya i Yerusalemu menya icyaha Eliyashibu yakoze, kuko yatunganirije Tobiya icyumba mu bikari by'inzu y'Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.7",
            "verseOrgIds": [
              "NEH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "birambabaza cyane. Ni cyo cyatumye ibintu bya Tobiya byose mbisahura mu nzu nkabijugunya hanze. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.8",
            "verseOrgIds": [
              "NEH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mperako ntegeka yuko beza ibyumba, maze nsubizamo ibintu by'inzu y'Imana n'amaturo y'amafu n'icyome.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
