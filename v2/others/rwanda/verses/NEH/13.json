          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abana babo bavugaga ururimi rwabo baruvanga n'urw'Abanyashidodi, ntibabashe kuvuga Uruyuda ahubwo bakavuga ururimi rw'ishyanga ribonetse ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
          "name": "verse",
