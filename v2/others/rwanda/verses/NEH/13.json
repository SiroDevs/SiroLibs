              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntegeka n'iby'amaturo y'inkwi mu bihe bitegetswe n'iby'umuganura.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
