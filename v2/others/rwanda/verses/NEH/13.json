            }
          ]
        },
        {
          "text": "Uko ni ko nabatunganije mbakuramo abanyamahanga bose, ntegeka ibihe by'abatambyi n'iby'Abalewi ngo umuntu wese ajye ku murimo we, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
