                "loc": "2SA.12.24+2SA.12.25"
              },
              "items": [
                {
                  "text": "2 Sam 12.24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1+1KI.11.2+1KI.11.3+1KI.11.4+1KI.11.5+1KI.11.6+1KI.11.7+1KI.11.8"
              },
              "items": [
                {
                  "text": "1 Abami 11.1-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbese Salomo umwami w'Abisirayeli ntiyacumuraga muri bene ibyo? Nubwo mu mahanga yose nta mwami wahwanye na we, agakundwa n'Imana ye ikamwimika ingoma y'Abisirayeli bose, ariko na we abagore b'abanyamahangakazi baramucumuje. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "None namwe tubemerere se mukore iki cyaha gikomeye ngo mucumure ku Mana yacu, murongore abakobwa b'abanyamahanga?”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        }
      ]
