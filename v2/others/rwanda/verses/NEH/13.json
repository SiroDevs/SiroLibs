            "number": "25",
            "style": "v",
            "sid": "NEH 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndabatonganya ndabavuma, ndetse bamwe muri bo ndabakubita mbapfura umusatsi mbarahiza Imana nti “Ntimugashyingirane na bo kandi namwe ntimukabarongoremo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
