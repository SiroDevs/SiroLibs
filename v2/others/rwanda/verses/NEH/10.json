            "sid": "NEH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ubwo bimeze bityo byose turasezerana isezerano ridakuka turyandike, abatware bacu n'Abalewi bacu n'abatambyi bacu barishyireho ikimenyetso.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10.1:",
              "type": "text"
            },
            {
              "text": "muri Bibliya Yera ya mbere, uyu murongo ni 9.38; bityo, 10.1-39 ihwanye na 10.2-40 muri iyi Bibliya, nk'uko biri mu Ruheburayo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abashyize ikimenyetso ku isezerano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
