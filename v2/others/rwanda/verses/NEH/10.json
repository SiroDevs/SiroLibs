                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Kuva 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kandi no kuzana impfura z'abahungu bacu n'uburiza bw'amatungo yacu nk'uko byanditswe mu mategeko, uburiza bw'inka zacu n'ubw'intama zacu ngo tubuzane mu nzu y'Imana yacu, tubishyire abatambyi bakora umurimo w'ubutambyi mu nzu y'Imana yacu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
