            "sid": "NEH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Daniyeli na Ginetoni na Baruki, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.7",
            "verseOrgIds": [
              "NEH.10.7"
            ]
          }
        },
        {
          "name": "verse",
