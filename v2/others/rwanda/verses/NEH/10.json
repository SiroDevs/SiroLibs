          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalewi ni aba: Yoshuwa mwene Azariya na Binuwi wo muri bene Henadadi na Kadimiyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.10",
            "verseOrgIds": [
              "NEH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bene wabo Shebaniya na Hodiya na Kelita, na Pelaya na Hanāni, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.11",
            "verseOrgIds": [
              "NEH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mika na Rehobu na Hashabiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.12",
            "verseOrgIds": [
              "NEH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
