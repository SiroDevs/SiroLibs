        },
        {
          "text": " “Kandi twishyiriraho amategeko yo gutanga kimwe cya gatatu cya shekeli uko umwaka utashye, byo gukoresha umurimo w'inzu y'Imana yacu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
