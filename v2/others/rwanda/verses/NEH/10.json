            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'iby'imitsima ihora iterekwa imbere y'Imana, n'iby'amaturo y'ifu idasiba guturwa, n'iby'ibitambo byoswa bidasiba gutambwa, n'iby'amasabato n'iby'imboneko z'amezi, n'iby'iminsi mikuru yategetswe, n'iby'ibintu byera n'iby'ibitambo byo gukuraho icyaha bihongererwa Abisirayeli, n'iby'imirimo yose yo mu nzu y'Imana yacu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        }
