                "loc": "DEU.1.21"
              },
              "items": [
                {
                  "text": "Guteg 1.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bashonje ubaha ibyokurya bivuye mu ijuru, bagize inyota ubakurira amazi mu rutare, utegeka ko bajya mu gihugu warahiriye kuzakibaha ngo bagihindūre. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.15",
            "verseOrgIds": [
              "NEH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.1+NUM.14.2+NUM.14.3+NUM.14.4"
              },
              "items": [
                {
                  "text": "Kub 14.1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.26+DEU.1.27+DEU.1.28+DEU.1.29+DEU.1.30+DEU.1.31+DEU.1.32+DEU.1.33"
              },
              "items": [
                {
                  "text": "Guteg 1.26-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko abo na ba sogokuruza baribona, bagamika amajosi ntibumva amategeko yawe, ",
          "type": "text",
          "attrs": {
