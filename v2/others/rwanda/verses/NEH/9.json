                {
                  "text": "Kuva 32.1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi nubwo biremeraga igishushanyo cy'inyana kiyagijwe bakavuga bati ‘Iyi ni yo Mana yawe yagukuye muri Egiputa’ bagakora ibirakaza bikabije, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.18",
            "verseOrgIds": [
              "NEH.9.18"
            ]
          }
        },
        {
          "name": "verse",
