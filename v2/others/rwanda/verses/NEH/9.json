                "loc": "JOS.3.14+JOS.3.15+JOS.3.16+JOS.3.17"
              },
              "items": [
                {
                  "text": "Yos 3.14-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi abana babo warabagwije bangana n'inyenyeri zo mu ijuru, ubashyira mu gihugu wabwiye ba sekuruza ko bazakijyamo bakagihindūra. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.23",
            "verseOrgIds": [
              "NEH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.23"
              },
              "items": [
                {
                  "text": "Yos 11.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko abana babo bajya mu gihugu baragihindūra, uneshereza imbere yabo Abanyakanāni bari abaturage bo muri icyo gihugu, wabagabirije hamwe n'abami babo n'amahanga yo mu gihugu ngo babagire uko bashaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.24",
            "verseOrgIds": [
              "NEH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.10+DEU.6.11"
              },
              "items": [
                {
                  "text": "Guteg 6.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Batsinda imidugudu igoswe n'inkike n'igihugu cyera cyane, bihindūrira amazu yuzuye ibintu byiza byose, n'amariba yafukuwe imusozi, n'inzabibu n'inzelayo n'ibiti byinshi byera imbuto. Nuko bararya barahaga barabyibuha, bishimira kugira neza kwawe kwinshi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.25",
            "verseOrgIds": [
