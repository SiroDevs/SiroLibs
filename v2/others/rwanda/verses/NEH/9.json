            "sid": "NEH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.2+DEU.8.3+DEU.8.4"
              },
              "items": [
                {
                  "text": "Guteg 8.2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ariko wowe ku bw'imbabazi zawe zitari zimwe ntiwabataye mu butayu, inkingi y'igicu yo kubayobora ku manywa ntiyabavaga imbere, cyangwa inkingi y'umuriro yo kubamurikira nijoro ikabereka inzira bakwiriye kunyuramo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.19",
            "verseOrgIds": [
              "NEH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi watanze umwuka wawe mwiza wo kubigisha, ntiwabimye manu yawe yo kurya, bagize inyota ubaha amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.20",
            "verseOrgIds": [
              "NEH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ubatungira mu butayu imyaka mirongo ine ntibagira icyo bakena, imyambaro yabo ntiyasazaga n'ibirenge byabo ntibyabyimbaga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.21",
            "verseOrgIds": [
              "NEH.9.21"
            ]
          }
        }
      ]
