            "number": "1",
            "style": "v",
            "sid": "ZEP 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuteranire hamwe, ni ukuri muterane mwa bwoko butagira isoni mwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibyategetswe bitarasohora, umunsi utarahita nk'umurama ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "text": ", kandi uburakari bukaze bw'Uwiteka butarabageraho, n'umunsi w'uburakari bw'Uwiteka utarabageraho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushake Uwiteka mwa bagwaneza bo mu isi mwese mwe, bakomeza amategeko ye. Mushake gukiranuka, mushake no kugwa neza, ahari muzahishwa ku munsi w'uburakari bw'Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
