                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.15"
              },
              "items": [
                {
                  "text": "Yoh 12.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nezerwa cyane wa mukobwa w'i Siyoni we, rangurura wa mukobwa w'i Yerusalemu we, dore umwami wawe aje aho uri. Ni we mukiranutsi kandi azanye agakiza, yicishije bugufi agendera ku ndogobe, ndetse no ku cyana cyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.8"
              },
              "items": [
                {
                  "text": "Zab 72.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Efurayimu nzahakura amagare, n'i Yerusalemu nzahakura amafarashi, n'imiheto y'intambara izahashira. Azabwira amahanga iby'amahoro kandi ubwami bwe buzahera ku nyanja bugere ku yindi, buzahera no ku ruzi bugere no ku mpera y'isi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
