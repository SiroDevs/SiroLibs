              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "no ku b'i Hamati hegeranye na ho, n'ab'i Tiro n'ab'i Sidoni nubwo ari abanyabwenge cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'i Tiro bariyubakira igihome, bakarunda ifeza nk'urunda umukungugu, n'izahabu nziza bakayirunda nk'urunda ibyondo byo mu nzira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore Umwami Imana izahanyaga, itsinde imbaraga zaho zo ku nyanja kandi hazatwikwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
