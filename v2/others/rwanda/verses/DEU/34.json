          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
