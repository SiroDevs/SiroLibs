          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.11"
              },
              "items": [
                {
                  "text": "Kuva 33.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mu Bisirayeli ntihabonetse ukundi umuhanuzi uhwanye na Mose, uwo Uwiteka yamenyaga barebana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntawagereranywa na we, ku bw'ibimenyetso n'ibitangaza byose Uwiteka yamutumye gukorera mu gihugu cya Egiputa, ngo abigirire Farawo n'abagaragu be bose n'igihugu cye cyose, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "no ku bw'iby'amaboko menshi byose n'ibiteye ubwoba byose, Mose yakoreye mu maso y'Abisirayeli bose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
