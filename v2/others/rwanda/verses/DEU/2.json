          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka arambwira ati ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Igihe mwazengurukiye uyu musozi kirahagije, nimucyamike mugende mwerekeje ikasikazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.3",
            "verseOrgIds": [
              "DEU.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.8"
              },
              "items": [
                {
                  "text": "Itang 36.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi utegeke abantu uti ‘Mugiye kunyura mu gihugu cya bene wanyu Abesawu batuye kuri Seyiri, bo bazabatinya. Nuko mwirinde cyane ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.4",
            "verseOrgIds": [
              "DEU.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntimubarwanye, kuko ntazabaha ku gihugu cyabo naho yaba intambwe imwe y'ikirenge, kuko nahaye Esawu umusozi wa Seyiri ho gakondo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.5",
            "verseOrgIds": [
              "DEU.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzabahaheho ibyokurya n'amazi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
