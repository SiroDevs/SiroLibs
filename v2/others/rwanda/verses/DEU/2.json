            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ndi mu butayu bw'i Kedemoti, ntuma intumwa kuri Sihoni umwami w'i Heshiboni kumubwira amagambo y'amahoro ziti ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.26",
            "verseOrgIds": [
              "DEU.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Reka anyure mu gihugu cyawe, azaca mu nzira nini ye gutambikira iburyo cyangwa ibumoso. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzamuhahishe ibyokurya n'amazi, umwemerere gucishamo amaguru gusa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk'uko Abesawu batuye kuri Seyiri n'Abamowabu batuye muri Ari bamugiriye, agende ageze aho azambukira Yorodani, agere mu gihugu Uwiteka Imana yacu iduha.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        }
      ]
    },
