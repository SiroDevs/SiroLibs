                "loc": "JOS.1.12+JOS.1.13+JOS.1.14+JOS.1.15"
              },
              "items": [
                {
                  "text": "Yos 1.12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Icyo gihe ndabategeka nti “Uwiteka Imana yanyu yabahaye iki gihugu kugihindūra. Intwari mwese mwambuke, mujye bene wanyu Abisirayeli imbere mufite intwaro. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abagore banyu n'abana banyu bato, n'amatungo yanyu (nzi yuko mufite menshi), bisigare mu midugudu yanyu mbahaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugeze aho Uwiteka azahera bene wanyu kuruhuka nk'uko yakubahaye namwe, bagahindūra igihugu Uwiteka Imana yanyu ibaha hakurya ya Yorodani, maze muzabone uko mugaruka umuntu wese muri gakondo ye, mu gihugu nabahaye.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        }
      ]
    },
    {
