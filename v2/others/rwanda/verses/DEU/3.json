            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko icyo gihe duhindūra icyo gihugu: igihugu gihereye kuri Aroweri iri mu mutwe w'igikombe cyo kuri Arunoni, n'igice kingana n'ikindi cy'igihugu cy'imisozi cy'i Galeyadi, mbiha Abarubeni n'Abagadi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.12",
            "verseOrgIds": [
              "DEU.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igice gisigaye cy'i Galeyadi n'i Bashani yose, ubwami bwa Ogi, mbiha igice kingana n'ikindi cy'umuryango wa Manase, mbaha igihugu cya Arugobu cyose na Bashani yose, cyitwaga igihugu cy'Abarafa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.13",
            "verseOrgIds": [
              "DEU.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
