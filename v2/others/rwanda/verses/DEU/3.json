              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo gihe ntegeka Yosuwa nti “Amaso yawe yiboneye ibyo Uwiteka Imana yanyu yagiriye ba bami bombi byose. Uko ni ko Uwiteka azagirira ubwami bwose mwambuka mujyamo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
