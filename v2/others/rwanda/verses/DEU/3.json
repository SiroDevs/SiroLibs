              "DEU.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mpa Abamakiri i Galeyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.15",
            "verseOrgIds": [
              "DEU.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarubeni n'Abagadi mbaha igice cy'i Galeyadi gihereye ku gikombe cyo kuri Arunoni, urugabano ruri hagati muri cyo kikageza ku mugezi Yaboki. Ni wo rugabano rw'Abamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.16",
            "verseOrgIds": [
              "DEU.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mbaha Araba na Yorodani ho urugabano, ihereye i Kinereti ikageza ku nyanja yo muri Araba. Ni yo Nyanja y'Umunyu iri hepfo y'agacuri ka Pisiga mu ruhande rw'iburasirazuba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.17",
            "verseOrgIds": [
              "DEU.3.17"
            ]
          }
        }
      ]
    },
