                }
              ]
            }
          ]
        },
        {
          "text": " Icyo gihe ninginga Uwiteka nti ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwami Uwiteka, utangiye kwereka umugaragu wawe gukomera kwawe n'amaboko yawe menshi. Ni iyihe mana yo mu ijuru cyangwa yo mu isi, ishobora gukora ibihwanye n'ibyo ukora n'imirimo yawe ikomeye? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakwinginze, emera ko nambuka nkareba igihugu cyiza kiri hakurya ya Yorodani, iriya misozi myiza na Lebanoni.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
      ]
