              "DEU.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.13+DEU.11.14+DEU.11.15+DEU.11.16+DEU.11.17"
              },
              "items": [
                {
                  "text": "Guteg 11.13-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Niwumvira ayo mateka, ukayitondera ugakora ibyo agutegeka, bizatuma Uwiteka Imana yawe ikomeza kugusohoreza isezerano, no kukugirira ibambe yarahiye ba sekuruza banyu ko izakugirira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izagukunda iguhe umugisha ikugwize, kandi imbuto zo mu nda yawe n'imyaka yo ku butaka bwawe, imyaka y'impeke yawe na vino yawe n'amavuta ya elayo yawe, no kororoka kw'inka zawe n'ukw'imikumbi yawe, izabihera umugisha mu gihugu yarahiye ba sekuruza banyu ko izaguha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.13",
            "verseOrgIds": [
              "DEU.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzagira umugisha uruta uw'ayandi mahanga yose: ntihazaba ingumba y'umugabo cyangwa y'umugore muri mwe, cyangwa mu matungo yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.14",
            "verseOrgIds": [
              "DEU.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka azagukuraho indwara zose, ntazaguteza n'imwe muri za ndwara mbi z'Abanyegiputa uzi, ahubwo azaziteza abakwanga bose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.15",
            "verseOrgIds": [
              "DEU.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzarimbura amahanga yose Uwiteka Imana yawe izakugabiza, ntuzabababarire kandi ntuzakorere imana zabo, kuko icyo cyakubera umutego.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahari wakwibwira uti “Ayo mahanga anduta ubwinshi, nabasha nte kuyanyaga igihugu cyayo?” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.17",
            "verseOrgIds": [
              "DEU.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntuzayatinye; uzibuke neza ibyo Uwiteka Imana yawe yagiriye Farawo na Egiputa hose, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
            "verseOrgIds": [
              "DEU.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibigerageresho bikomeye amaso yawe yiboneye, n'ibimenyetso n'ibitangaza n'amaboko menshi n'ukuboko kurambutse Uwiteka Imana yawe yagukujeyo. Uko ni ko Uwiteka Imana yawe izagenza amahanga yose utinya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.19",
            "verseOrgIds": [
              "DEU.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uwiteka Imana yawe izaboherezamo amavubi, ageze aho abasigaye bakwihishe bazarimbukira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.20",
            "verseOrgIds": [
              "DEU.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntuzabakukire umutima, kuko Uwiteka Imana yawe iri hagati muri mwe, ari Imana ikomeye iteye ubwoba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.21",
            "verseOrgIds": [
              "DEU.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka Imana yawe izirukana imbere yawe ayo mahanga ni ruto ni ruto, ntiwayarimbura vuba cyane, inyamaswa zo mu ishyamba zitagwira zikagutera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.22",
            "verseOrgIds": [
              "DEU.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Uwiteka Imana yawe izabakugabiza, ibaneshe rwose igeze aho barimbukira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.23",
            "verseOrgIds": [
              "DEU.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi izakugabiza abami babo nawe ubarimbure, izina ryabo ryibagirane munsi y'ijuru. Ntihazagira umuntu ubasha kuguhagarara imbere kugeza aho uzamarira kubarimbura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.24",
            "verseOrgIds": [
              "DEU.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibishushanyo bibajwe by'imana zabo uzabitwike; ntuzifuze ifeza cyangwa izahabu zabiyagirijweho, ntuzazijyane we gutegwa na zo, kuko ari ikizira Uwiteka Imana yanyu yanga urunuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntuzajyane ikizira mu nzu yawe utagibwaho n'umuvumo nka cyo, ahubwo uzacyange urunuka, uzakigire umuziro kuko ari ikintu kiriho umuvumo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.26",
            "verseOrgIds": [
              "DEU.7.26"
            ]
          }
        }
      ]
    }
