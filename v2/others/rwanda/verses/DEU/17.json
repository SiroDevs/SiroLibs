                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.15"
              },
              "items": [
                {
                  "text": "2 Ngoma 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.27"
              },
              "items": [
                {
                  "text": "9.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi ye kuzishakira abagore benshi, kugira ngo umutima we udahinduka ukava ku Uwiteka, kandi ye kuzarushaho kwishakira ifeza n'izahabu byinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi namara kwima ingoma ye aziyandikire aya mategeko mu gitabo, ayakuye mu gifitwe n'abatambyi b'Abalewi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo gitabo azakibane ajye agisomamo iminsi yose akiriho, kugira ngo yige kubaha Uwiteka Imana ye, no kwitondera amagambo yose y'ibi byategetswe n'aya mategeko, no kuyumvira, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "umutima we utishyira hejuru ya bene wabo, adateshuka iburyo cyangwa ibumoso ngo ave muri aya mategeko, ahubwo ngo arame mu bwami bwe we n'urubyaro rwe, hagati mu Bisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.20",
            "verseOrgIds": [
              "DEU.17.20"
            ]
          }
        }
      ]
