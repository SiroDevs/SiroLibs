                "loc": "NUM.35.30"
              },
              "items": [
                {
                  "text": "Kub 35.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
