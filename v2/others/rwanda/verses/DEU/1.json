              "items": [
                {
                  "text": "Heb 3.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko mwe ntimwemera kuzamuka, ahubwo mwanga itegeko ry'Uwiteka Imana yanyu, murayigomera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
