              },
              "items": [
                {
                  "text": "Ibyak 13.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " no mu butayu aho mwabonaga mugenda Uwiteka Imana yanyu ibahetse, nk'uko umugabo aheka umuhungu we, mu rugendo mwagenze rwose mukageza aho mwagereye ino.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
