              "items": [
                {
                  "text": "Heb 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze ibyo ntibyatuma mwizera Uwiteka Imana yanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
