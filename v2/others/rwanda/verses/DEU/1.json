          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze muransubiza muti “Twacumuye ku Uwiteka, turazamuka turwane dukore ibyo Uwiteka Imana yacu yadutegetse byose.” Nuko mwese muringaniza intwaro zanyu, mugambirira kuzamuka uwo musozi nkaho byoroshye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
