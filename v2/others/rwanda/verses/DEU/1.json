          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barahaguruka bazamuka uwo musozi, bagera mu gikombe cya Eshikoli baragitata. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.24",
            "verseOrgIds": [
              "DEU.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
