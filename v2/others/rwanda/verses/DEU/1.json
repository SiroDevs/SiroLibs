          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "yabagīraga imbere mu nzira kubashakira aho mubamba amahema, igendera mu muriro nijoro ngo ibayobore inzira mucamo, ikagendera mu gicu ku manywa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
