          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benda ku mbuto z'icyo gihugu barazituzanira, batubarira inkuru bati “Igihugu Uwiteka Imana yacu iduha ni cyiza.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
