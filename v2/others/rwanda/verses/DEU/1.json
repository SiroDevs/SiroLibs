              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo nama ndayishima, mbatoranyamo abagabo cumi na babiri, umwe umwe mu miryango yose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.23",
