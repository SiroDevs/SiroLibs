        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26+NUM.28.27+NUM.28.28+NUM.28.29+NUM.28.30+NUM.28.31"
              },
              "items": [
                {
                  "text": "Kub 28.26-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi ujye ubara iminsi y'amasabato arindwi uhereye igihe utangiriraho gutemesha imyaka umuhoro, ujye utangira kubara iminsi y'ayo masabato uko ari irindwi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye uziriririza Uwiteka Imana yawe umunsi mukuru ukurikira ayo masabato uko ari arindwi, uwuziririsha gutura amaturo umutima ukunze uguturisha, ahwanye n'uko Uwiteka Imana yawe yaguhaye umugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wishimirane imbere y'Uwiteka Imana yawe n'umuhungu wawe n'umukobwa wawe, n'umugaragu wawe n'umuja wawe, n'Umulewi w'iwanyu n'umusuhuke w'umunyamahanga, n'impfubyi n'umupfakazi bari hagati muri mwe, mwishimire ahantu Uwiteka Imana yawe izatoraniriza kuhashyira izina ryayo ngo rihabe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi uzajye wibuka yuko wari umuretwa muri Egiputa, witondere ayo mategeko uyumvire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
