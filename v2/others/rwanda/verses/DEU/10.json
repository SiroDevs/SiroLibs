                "loc": "ROM.2.11"
              },
              "items": [
                {
                  "text": "Rom 2.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.6"
              },
              "items": [
                {
                  "text": "Gal 2.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.9"
              },
              "items": [
                {
                  "text": "Ef 6.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko Uwiteka Imana yanyu ari Imana nyamana, ni Umwami w'abami, ni Imana ikomeye y'inyambaraga nyinshi, iteye ubwoba, itita ku cyubahiro cy'umuntu, idahongerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icīra impfubyi n'abapfakazi imanza zibarengera, ikunda umusuhuke w'umunyamahanga ikamugaburira, ikamwambika. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
            "verseOrgIds": [
              "DEU.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mukunde umusuhuke w'umunyamahanga, kuko namwe mwari abasuhuke mu gihugu cya Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wubahe Uwiteka Imana yawe abe ari yo ukorera, abe ari yo wifatanyaho akaramata, izina ryayo abe ari ryo urahira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
