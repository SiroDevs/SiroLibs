          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihaba imburanya ku bantu, bakajya kuburana bakabacira urubanza, batsindishirize uwakiranutse, batsindishe uwakoze icyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi niba uwo munyabyaha yakoze ibikwiriye kumukubitisha, umucamanza amurambike ategeke ko bamukubitira imbere ye inkoni zihwanye n'icyaha cye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.24"
              },
              "items": [
                {
                  "text": "2 Kor 11.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yemererwa kumukubita inkoni mirongo ine, ntazazirenze kugira ngo mwene wanyu atakubera umunyagisuzuguriro, nibarenza izo bakamukubita inkoni nyinshi zizirenze.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
      ]
    },
