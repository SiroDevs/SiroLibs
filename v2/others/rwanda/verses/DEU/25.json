              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uhore wibuka ibyo Abamaleki babagiriye mu rugendo ubwo mwavaga muri Egiputa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "uko babasanganiriraga mu rugendo bakica ab'inyuma banyu, abatakaye inyuma bose b'abanyantegenke ubwo mwananirwaga mukaruha, ntibatinye Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma Uwiteka Imana yawe nimara kugukiza ababisha bawe bose bakugose, ikaguha kuruhukira mu gihugu Uwiteka Imana yawe iguha ho gakondo ngo ugihindūre, uzaba ukwiriye gukuraho rwose kwibukwa kw'Abamaleki, ngo bibagirane mu bo munsi y'ijuru bose. Ntuzabyibagirwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        }
      ]
    }
