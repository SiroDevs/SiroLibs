            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.35+LEV.19.36"
              },
              "items": [
                {
                  "text": "Lewi 19.35-36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ntukagire mu isaho yawe ibyuma upimisha indatira imwe biciye ukubiri, ikinini n'igito. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukagire mu nzu yawe ibyibo b'urugero rumwe biciye ukubiri, ikinini n'igito. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo icyuma gitunganye kingana rwose n'uko cyitwa abe ari cyo upimisha, icyibo gitunganye kingana rwose n'uko cyitwa abe ari cyo ugeresha, kugira ngo uramire mu gihugu Uwiteka Imana yawe iguha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko abakora ibimeze nka bya bindi bose, abakora ibidatunganye bose, ari ikizira Uwiteka Imana yawe yanga urunuka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
