            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ntuzahine imbago z'urubibi rwa mugenzi wawe zashinzwe n'aba kera, muri gakondo yawe uzahabwa mu gihugu Uwiteka aguha guhindūra.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
