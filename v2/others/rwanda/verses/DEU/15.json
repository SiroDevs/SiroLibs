              "DEU.15.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.12"
              },
              "items": [
                {
                  "text": "Kuva 13.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uburiza bw'ikigabo bwose bwo mu mashyo yawe no mu mikumbi yawe, uzajye ubwereza Uwiteka Imana yawe. Ntugakoreshe uburiza bw'inka yawe, ntukogoshe uburiza bwo mu mukumbi wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye ubusangirira n'abo mu rugo rwawe imbere y'Uwiteka Imana yawe uko umwaka utashye, ahantu Uwiteka azatoranya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibugira inenge yose, nibucumbagira cyangwa nibuhuma, cyangwa nibugira indi nenge mbi yose, ntuzabutambire Uwiteka Imana yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzaburīre iwanyu, uhumanye n'udahumanye bahwanye kuburya nk'uko barya isirabo n'impara. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.22",
            "verseOrgIds": [
              "DEU.15.22"
            ]
          }
