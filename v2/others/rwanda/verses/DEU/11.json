          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore uyu munsi mbashyize imbere umugisha n'umuvumo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugisha muzawuhabwa nimwitondera amategeko y'Uwiteka Imana yanyu, mbategeka uyu munsi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo muvumo muzawuvumwa nimutumvira amategeko y'Uwiteka Imana yanyu, mugateshuka inzira mbategeka uyu munsi, ngo muhindukirire izindi mana mutigeze kumenya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
