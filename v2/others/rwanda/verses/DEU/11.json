              },
              "items": [
                {
                  "text": "Yos 1.3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ahantu hose muzakandagira hazaba ahanyu, urugabano rwanyu ruzahera ku butayu rugeze kuri Lebanoni, kandi ruzahera ku ruzi Ufurate rugeze ku Nyanja y'iburengerazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihazagira umuntu ubasha kubahagarara imbere, Uwiteka Imana yanyu izateza ubwoba igihugu muzakandagiramo cyose, ngo babatinye uko yababwiye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
      ]
    },
    {
