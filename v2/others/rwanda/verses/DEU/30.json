                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "28.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ukunde Uwiteka Imana yawe uyumvire, uyifatanyeho akaramata kuko ari yo bugingo bwawe no kurama kwawe, kugira ngo ubone kuba mu gihugu Uwiteka yarahiye ba sekuruza banyu, Aburahamu na Isaka na Yakobo ko azabaha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.20",
            "verseOrgIds": [
              "DEU.30.20"
            ]
          }
        }
