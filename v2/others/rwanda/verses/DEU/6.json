              },
              "items": [
                {
                  "text": "28.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uwiteka Imana yawe, nimara kukujyana mu gihugu yarahiye ba sekuruza banyu Aburahamu na Isaka na Yakobo ko izaguha, ukagira imidugudu minini myiza utubatse, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'amazu yuzuye ibyiza byose utujuje, n'amariba yafukuwemo amazi mutafukuye, n'inzabibu n'imyelayo utateye ukarya ugahaga, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "uzirinde we kwibagirwa Uwiteka wagukuye mu gihugu cya Egiputa, mu nzu y'uburetwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.12",
            "verseOrgIds": [
              "DEU.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.10"
              },
              "items": [
                {
                  "text": "Mat 4.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.8"
              },
              "items": [
                {
                  "text": "Luka 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wubahe Uwiteka Imana yawe abe ari yo ukorera, izina ryayo abe ari ryo urahira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.13",
            "verseOrgIds": [
              "DEU.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimugahindukirire izindi mana zo mu mana z'amahanga abagose, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko Uwiteka Imana yanyu iri hagati muri mwe ari Imana ifuha, kugira ngo utikongereza uburakari bw'Uwiteka akakurimbura, akagukura mu isi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        }
      ]
    },
