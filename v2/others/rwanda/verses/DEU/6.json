              "attrs": {
                "loc": "LUK.4.12"
              },
              "items": [
                {
                  "text": "Luka 4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntimukagerageze Uwiteka Imana yanyu nk'uko mwayigeragereje i Masa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujye mugira umwete wo kwitondera ibyo Uwiteka Imana yanyu yabategetse n'ibyo yahamije, n'amategeko yayo yabategetse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye ukora ibyo Uwiteka abona ko bitunganye kandi ari byiza, kugira ngo ubone ibyiza ujye mu gihugu cyiza ugihindūre, icyo Uwiteka yarahiye ba sekuruza banyu ko izaguha, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "namara kwirukana ababisha bawe bose imbere yawe, uko yavuze.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
    },
