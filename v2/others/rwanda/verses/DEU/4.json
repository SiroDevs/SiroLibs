          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.8+JOS.20.9"
              },
              "items": [
                {
                  "text": "Yos 20.8-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maze Mose arobanura imidugudu itatu hakurya ya Yorodani mu ruhande rw'iburasirazuba, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.41",
            "verseOrgIds": [
              "DEU.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "yo guhungirwamo na gatozi wishe undi atabyitumye, adasanzwe amwanga, ngo ahungire muri umwe muri iyo midugudu, abeho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.42",
            "verseOrgIds": [
              "DEU.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ni Beseri iri mu butayu bwo mu kibaya, y'ubuhungiro bw'Abarubeni, n'i Ramoti iri i Galeyadi ngo ibe ubw'Abagadi, n'i Golani iri Bashani ngo ibe ubw'Abamanase.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        }
      ]
    },
