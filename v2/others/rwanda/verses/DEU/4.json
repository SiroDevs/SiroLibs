          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni byo Bihamya n'amategeko n'amateka, Mose yabwiye Abisirayeli ubwo bavaga muri Egiputa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.45",
            "verseOrgIds": [
              "DEU.4.45"
            ]
          }
        },
