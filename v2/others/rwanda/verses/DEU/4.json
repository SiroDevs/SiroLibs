              "type": "text"
            }
          ]
        },
        {
          "text": "bari hakurya ya Yorodani mu gikombe ahateganye n'i Betipewori, cyo mu gihugu cya Sihoni umwami w'Abamori waturaga i Heshiboni, uwo Mose n'Abisirayeli batsinze ubwo bavaga mu Egiputa ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.46",
            "verseOrgIds": [
