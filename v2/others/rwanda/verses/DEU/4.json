        },
        {
          "text": "Aya ni yo mategeko Mose yashyize imbere y'Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.44",
            "verseOrgIds": [
              "DEU.4.44"
            ]
          }
