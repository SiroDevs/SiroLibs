  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "ECC 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imana igenera ikintu cyose igihe cyacyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikintu cyose kigenerwa igihe cyacyo, n'icyagambiriwe munsi y'ijuru cyose gifite umwanya wacyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.1",
            "verseOrgIds": [
              "ECC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hariho igihe cyo kuvuka n'igihe cyo gupfa, igihe cyo gutera n'igihe cyo kurandura ibikūri. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.2",
            "verseOrgIds": [
              "ECC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe cyo kwica n'igihe cyo gukiza, igihe cyo gusenya n'igihe cyo kubaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.3",
            "verseOrgIds": [
              "ECC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe cyo kurira n'igihe cyo guseka, igihe cyo kuboroga n'igihe cyo kubyina. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.4",
            "verseOrgIds": [
              "ECC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.5"
              },
              "items": [
                {
                  "text": "1 Kor 7.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Igihe cyo kujugunya amabuye n'igihe cyo kuyarunda, igihe cyo guhoberana n'igihe cyo kwirinda guhoberana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.5",
            "verseOrgIds": [
              "ECC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe cyo gushaka n'igihe cyo kuzimiza, igihe cyo kwimana n'igihe cyo gutanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.6",
            "verseOrgIds": [
              "ECC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe cyo gutabura n'igihe cyo kudoda, igihe cyo guceceka n'igihe cyo kuvuga igihe cyo gukunda n'igihe cyo kwanga, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.7",
            "verseOrgIds": [
              "ECC.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihe cy'intambara n'igihe cy'amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
            "verseOrgIds": [
              "ECC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
            "verseOrgIds": [
              "ECC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.3"
              },
              "items": [
                {
                  "text": "Umubw 1.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ibyo umuntu akora yirushya bimumarira iki? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabonye umuruho Imana yahaye abantu ngo barushywe na wo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.10",
            "verseOrgIds": [
              "ECC.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikintu cyose yakiremye ari cyiza mu gihe cyacyo. Kandi yashyize ibitekerezo by'igihe cy'iteka mu mitima yabo, uburyo umuntu atabasha gusesengura imirimo Imana yakoze, uhereye mbere na mbere ukazageza ku iherezo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzi yuko ari nta cyiza kiriho kibarutira kunezerwa, no gukora neza igihe bakiriho cyose. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ko umuntu wese akwiriye kurya no kunywa, no kunezezwa n'ibyiza by'imirimo ye yose, kuko na byo ari ubuntu bw'Imana.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzi yuko icyo Imana ikora cyose kizahoraho iteka ryose, ntibishoboka kucyongeraho cyangwa kukigabanyaho, kandi Imana yakiremeye kugira ngo abantu bayubahe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.14",
            "verseOrgIds": [
              "ECC.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiriho cyahozeho na kera kandi ikizabaho cyahozeho uhereye kera, kandi Imana yongera kugarura ibyakuweho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze kandi nabonye munsi y'ijuru, aho kubona imanza zitabera habaye ibyaha, ahahoze ibyo gukiranuka, ibyaha ni ho byasubiye. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ko kwibwira mu mutima wanjye nti “Imana izacira urubanza abakiranutsi n'abanyabyaha, kuko aho ari ho hazaba igihe cy'ikintu cyose n'umurimo wose.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibwiye mu mutima nti “Bimera bityo ku bw'abantu kugira ngo Imana ibagerageze, kandi ngo bīmenyeho yuko na bo ubwabo bameze nk'inyamaswa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.18",
            "verseOrgIds": [
              "ECC.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ikiba ku bantu ari cyo kiba no ku nyamaswa, ikibibaho ni kimwe, nk'uko bapfa ni ko zipfa. Ni ukuri byose bihumeka kumwe, umuntu nta cyo arusha inyamaswa kuko byose ari ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.19",
            "verseOrgIds": [
              "ECC.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Byose bijya hamwe, byose byavuye mu mukungugu kandi byose bizawusubiramo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.20",
            "verseOrgIds": [
              "ECC.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde uzi yuko umwuka w'umuntu uzamuka ukajya hejuru, kandi akamenya yuko uw'inyamaswa umanuka ukajya mu butaka?” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.21",
            "verseOrgIds": [
              "ECC.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma mbona yuko nta kirenze ibi: umuntu kunezezwa n'imirimo ye, ibyo ni byo mugabane we. Ni nde wamugarura ngo arebe ibizaba mu nyuma ze?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.22",
            "verseOrgIds": [
              "ECC.3.22"
            ]
          }
        }
      ]
    }
  ],
