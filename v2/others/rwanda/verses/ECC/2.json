          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "None se ni nde wabasha kurya no kwinezeza akandusha? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
              "ECC.2.25"
            ]
          }
        },
