        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibihimbano n'ubutunzi nta mahoro bitera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibwiye mu mutima wanjye nti “Henga nkugeragereshe ibyishimo, nuko ishimire kugubwa neza.” Maze mbona ko na byo ari ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.1",
            "verseOrgIds": [
              "ECC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuze ibyo guseka nti “Ni ubusazi”, n'iby'ibitwenge nti “Bimaze iki?” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nishatse mu mutima uko nakwishimisha umubiri wanjye vino, ariko ngo umutima wanjye ukomeze kunyoboza ubwenge, ngashaka n'uburyo nakora iby'ubupfapfa, kugira ngo menye icyo bumarira abantu babukorera munsi y'ijuru mu minsi bakiriho yose.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
