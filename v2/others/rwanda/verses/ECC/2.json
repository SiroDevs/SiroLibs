                }
              ]
            }
          ]
        },
        {
          "text": " Ntakigirira umuntu akamaro kiruta kurya no kunywa, no kunezeresha ubugingo bwe ibyiza bituruka mu miruho ye. Nabonye yuko ibyo na byo biva mu kuboko kw'Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.24",
            "verseOrgIds": [
              "ECC.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
