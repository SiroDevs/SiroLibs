{
  "id": "REV.1",
  "number": "1",
  "bookId": "REV",
  "reference": "Mulʼata 1",
  "copyright": "Biblica® Hiikkaa Ammayyaa Banamaa Haaraa™, Loqoda Dhiʼaa Mirgi seeraan eegama © 2022 Biblica, Inc. Biblica® Open New Oromo Contemporary Version™, Western Copyright © 2022 by Biblica, Inc. \"Biblica\" jechuun mallattoo eenyummaa kan Biblica, Inc., Waajjira Eeyyamaa fi Mallattoo Eenyummaa kan Ameerikaa keessaatti galmeessee dha. Eeyyamaan itti fayyadamu. \"Biblica\" is trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "REV 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seensa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun mulʼata Yesuus Kiristoos, kan akka inni waan dhiʼootti taʼuu qabu garboota isaatti argisiisuuf jedhee Waaqni isaaf kennee dha. Innis ergamaa isaa gara garbicha isaa Yohannisitti ergee akka mulʼanni sun beekamu godhe;",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohannis isa waan arge hundumaa jechuunis dubbii Waaqaatii fi dhuga baʼumsa Yesuus Kiristoos dhugaa baʼuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni dubbii raajii kana dubbisu eebbifamaa dha; warri waan raajii sana keessatti barreeffame dhagaʼanii eeganis eebbifamoo dha; barichi dhiʼaateeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nagaa Gaafachuu fi Waaqa Galateeffachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohannis irraa,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po",
        "vid": "REV 1:4"
      },
      "items": [
        {
          "text": "Gara waldoota kiristaanaa kanneen biyya Asiyaa keessa jiran torbaniitti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po",
        "vid": "REV 1:4"
      },
      "items": [
        {
          "text": "Isa jiru, isa ture, Isa dhufuuf jiruu fi Hafuurota torban fuula teessoo isaa dura jiran irraa,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas Yesuus Kiristoos dhuga baatuu amanamaa, hangafa warra duʼaniitii fi bulchaa mootota lafaa taʼe sana irraa ayyaannii fi nagaan isiniif haa taʼu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:5"
      },
      "items": [
        {
          "text": "Isa nu jaallatuu fi isa dhiiga isaatiin cubbuu keenya irraa bilisa nu baase,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "isa akka nu Waaqa isaatii fi Abbaa isaa tajaajilluuf mootummaa fi luboota nu taasise sanaaf ulfinnii fi humni bara baraa hamma bara baraatti haa taʼu! Ameen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunoo, inni duumessa wajjin dhufa;",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "iji hundinuu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "warri isa waraanan iyyuu isa ni argu;\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "saboonni lafaa hundinuus \"sababii isaatiif ni wawwaatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "Akkasuma taʼa! Ameen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni Gooftaan Waan Hunda Dandaʼu, \"Ani Alfaa fi Omeegaa dha; isa jiru, isa turee fi isa dhufuuf jiruu dha\" jedha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yohannis Mulʼataan Kiristoosin Arguu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani obboleessi keessan Yohannis dhiphina keessatti, mootummaa fi obsa Yesuus Kiristoos keessattis isin wajjin kan hirmaadhu sababii dubbii Waaqaatii fi sababii dhuga baʼumsa Yesuus Kiristoosiif Phaaximoos biyya bishaaniin marfamte irran ture.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis guyyaa Gooftaatti Hafuuraanin ture; dugda koo duubaanis sagalee guddaa akka malakataa tokko nan dhagaʼe;",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "sagaleen sunis,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waan argitu kitaaba maramaa irratti barreessiitii gara waldoota kiristaanaa torbaniitti jechuunis Efesoonitti, Samirnaatti, Phergaamoonitti, Tiyaatiraatti, Sardeesitti, Filaadelfiyaattii fi Lodooqiyaatti ergi\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.11",
                "verseOrgIds": [
                  "REV.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis sagalee natti dubbachaa ture sana ilaaluuf jedheen of irra gara gale. Ani yommuun of irra gara galetti baattuuwwan ibsaa kanneen warqee irraa hojjetaman torba nan arge;",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "baattuuwwan ibsaa sana gidduus kan, \"ilma namaa fakkaatu\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "text": "tokkotu ture; innis uffata dheeraa miilla gaʼu uffatee, naannoo qoma isaatti immoo sabbata warqee hidhatee ture.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataan isaatii fi rifeensi mataa isaa adii akka rifeensa hoolaa, adii akka cabbii ture; iji isaas akka arraba ibiddaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miilli isaas naasii boolla ibiddaa keessatti diimeffame fakkaata ture; sagaleen isaa immoo akkuma sagalee bishaan baayʼee ti.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harka isaa mirgaatiin urjiiwwan torba qabatee ture; afaan isaa keessaas goraadee qara lama qabutu baʼaa ture. Fuulli isaas biiftuu humna guutuun iftu fakkaata ture.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yommuun isa argetti akka nama duʼee miilla isaa jalattin kufe. Inni immoo harka isaa mirgaa narra kaaʼee akkana naan jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hin sodaatin. Ani kan Jalqabaatii fi kan Dhumaa ti.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.17",
                "verseOrgIds": [
                  "REV.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isa jiraataa dhas; ani duʼeen ture; kunoo, bara baraa hamma bara baraatti nan jiraadha! Furtuu duʼaatii fi kan Siiʼoolis qaba.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.18",
                "verseOrgIds": [
                  "REV.1.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kanaafuu ati waan argite, waan amma jiruu fi waan gara fuulduraatti taʼu barreessi.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.19",
                "verseOrgIds": [
                  "REV.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.19",
            "verseOrgIds": [
              "REV.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Icciitiin urjiiwwan torbaa kanneen ati harka koo mirgaa keessatti argiteetii fi baattuuwwan ibsaa kanneen warqee irraa hojjetaman torbanii isa kana: Urjiiwwan torban ergamoota waldaa kiristaanaa torbaa ti; baattuuwwan ibsaa torban immoo waldoota kiristaanaa torbanii dha.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.20",
                "verseOrgIds": [
                  "REV.1.20"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "next": {
    "id": "REV.2",
