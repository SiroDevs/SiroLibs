              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ergamaa Waaqaa kan Waaqaa kan waldaa Kiristaanaa Tiyaatiraatti",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.18",
                "verseOrgIds": [
