            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ergamaa Waaqaa kan waldaa kiristaanaa Efesoonitti",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.1",
                "verseOrgIds": [
                  "REV.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
