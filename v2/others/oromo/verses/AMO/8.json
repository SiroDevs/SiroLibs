                "verseId": "AMO.8.11",
                "verseOrgIds": [
                  "AMO.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan akkana jedha;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:11"
      },
      "items": [
        {
          "text": "\"Yeroon ani biyyattiitti beela fidu tokko ni dhufa;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
