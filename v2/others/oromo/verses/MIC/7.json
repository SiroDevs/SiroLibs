  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MIC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhiphachuu Israaʼel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaaf wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "Ani akkuma nama yeroo qarmii bonaa funaananitti",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "wayinii walitti qabu tokkoo taʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "hurbuun wayinii kan nyaatamu tokko iyyuu hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "iji harbuu jalqabaa kan ani dharraʼu tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni gaariin lafa irraa badeera;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "namni qajeelaan tokko iyyuu hin hafne.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "Namoonni hundinuu dhiiga",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "dhangalaasuuf riphanii eeggatu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "tokkoon tokkoon namaa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "kiyyoodhaan obboleessa isaa eeggata.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harki lachuu waan hamaa hojjechuu barateera;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "bulchaan kennaa barbaada;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "abbaan murtiis mattaʼaa fudhata;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "namni humna qabu waanuma fedhe dubbata;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "hundi isaanii walii wajjin malatu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kan isaan hunda caalaa gaarii taʼe akka sokorruu ti;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "inni akka malee qajeelaan immoo dallaa qoraattii caala.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Guyyaan eegdota keetii,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "guyyaan itti Waaqni si ilaalu dhufeera.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Amma yeroo itti isaan joonjaʼanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ollaa hin amanatin;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "michuus hin abdatin.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "Ishee hammattee ciiftu biratti iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "arraba kee eeggadhu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmi abbaa isaa tuffata;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "intalli haadha isheetti,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "niitiin ilmaas amaatii isheetti kaati;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "diinonni namaa miseensotuma mana isaa taʼuutii.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu abdiidhaan",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.7",
                "verseOrgIds": [
                  "MIC.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nan eeggadha;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "fayyisaa koo Waaqa nan eeggadha;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "Waaqni koo na dhagaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israaʼel ni Kaati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa diina koo natti hin gammadin!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Ani yoon kufe iyyuu nan kaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Ani dukkana keessa taaʼu iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.8",
                "verseOrgIds": [
                  "MIC.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ifa naaf taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani sababiin cubbuu isatti hojjedheef,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "hamma inni dubbii koo ilaalee naaf murteessutti",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "dheekkamsa Waaqayyoo nan baadha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "Inni ifatti na baasa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "anis qajeelummaa isaa nan arga.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
