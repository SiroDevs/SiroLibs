  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MIC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yootaam, Aahaazii fi Hisqiyaas mootota Yihuudaa turan keessa dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.1.1",
                "verseOrgIds": [
                  "MIC.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gara Miikiyaas namicha Mooresheet dhufe; kunis mulʼata inni waaʼee Samaariyaatii fi waaʼee Yerusaalem argee dha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa namoota, isin hundinuu dhagaʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "lafaa fi wantoonni ishee irra jiraattan hundinuu dhaggeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.1.2",
                "verseOrgIds": [
                  "MIC.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftichi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "Gooftaan mana qulqullummaa isaa qulqulluu sana keessaa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "dhugaa isinitti baʼa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Murtii Samaariyaa fi Yerusaalemin Eeggatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.1.3",
                "verseOrgIds": [
                  "MIC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "iddoo jireenya isaatii dhufaa jira;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:3"
      },
      "items": [
        {
          "text": "inni gad dhufee iddoo ol kaʼaa lafaa irra ni ejjeta.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma gagaa fuula ibiddaa dura jiruu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "akkuma bishaan tabba irraa gad yaaʼuu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "tulluuwwan isa jalatti ni baqu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "sululawwanis gargar baqaqu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kun hundi sababii dogoggora Yaaqoobiif,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "sababii cubbuu mana Israaʼeliif taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Dogoggorri Yaaqoob maali?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Samaariyaa mitii?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Iddoon sagadaa Yihuudaa maali?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Yerusaalem mitii?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu ani Samaariyaa tuullaa diigamaa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "lafa wayinii itti dhaabbatan nan godha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "Ani dhagaawwan ishee sululatti naqee,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "hundee ishee qullaa nan hambisa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqonni ishee tolfamoon hundinuu ni hurreeffamu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "kennaawwan mana qulqullummaa ishee hundinuu ibiddaan gubamu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "ani fakkii ishee hunda nan barbadeessa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "Isheen gatii sagaagaltootaa irraa kennaa ishee walitti waan qabatteef,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "kennaan sun ammas gatii sagaagaltootaa taʼee ni deebiʼa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Booʼuu fi Gadduu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii waan kanaatiif ani booʼee nan wawwaadha;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "ani miilla duwwaa fi qullaa nan deema.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "Ani akkuma waangoo iyyee,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "akkuma urunguu nan aada.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madaan ishee waan hin fayyineef,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "Yihuudaattis darbeera.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "Karra saba koo dura gaʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "Yerusaalemittis dhufeera.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin waan kana Gaati keessatti hin dubbatinaa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "gonkumaa hin booʼinaa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "Beet Leʼafraatti,",
