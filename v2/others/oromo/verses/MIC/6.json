          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.1",
                "verseOrgIds": [
                  "MIC.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhu dhaggeeffadhaa:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "\"Ol kakkaʼaatii fuula tulluuwwanii duratti dubbii keessan dhiʼeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "gaarranis waan isin jettan haa dhagaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa tulluuwwan himata",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.2",
                "verseOrgIds": [
                  "MIC.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dhagaʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "hundeewwan lafaa kanneen bara baraa isinis dhaggeeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.2",
                "verseOrgIds": [
                  "MIC.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "saba isaa irraa dubbii qabaatii;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "inni Israaʼel wajjin falmii qaba.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa saba ko, ani maalan si godhe?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:3"
      },
      "items": [
        {
          "text": "Ani maaliinan si dadhabsiise? Mee deebii naaf kenni.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani biyya Gibxii sin baasee",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "biyya garbummaa keessaa sin fure.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "Ani akka inni si qajeelchuuf Musee,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "akkasumas Aroonii fi Miiriyaamin siifan erge.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa saba ko, mee gorsa Baalaaq mootiin Moʼaab gaafatee fi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "deebii Balaʼaam ilmi Beʼoor kenneef yaadadhu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "Ati akka hojii qajeelummaa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.5",
                "verseOrgIds": [
                  "MIC.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "beektuuf",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "karaa ati Shixiimii hamma Gilgaalitti deemte sana yaadadhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani maaliinan fuula",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.6",
                "verseOrgIds": [
                  "MIC.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dura dhufee",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "fuula Waaqa ol gubbaa jiruu duratti sagada?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "Ani aarsaa gubamuun,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "jabbii waggaa tokkootiin fuula isaa duratti dhiʼaadhuu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.7",
                "verseOrgIds": [
                  "MIC.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "korbeeyyii hoolaa kuma hedduutti,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "zayitii laga kuma kudhaniitti ni gammadaa?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "Ani ilma koo hangafa, sababii yakka kootiitiif,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "sababii cubbuu lubbuu kootiitiifis dhala garaa koo aarsaa dhiʼeessuu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa nama, inni waan gaarii si argisiiseera.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.8",
                "verseOrgIds": [
                  "MIC.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "maal sirraa barbaada?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "Murtii qajeelaa kennuu fi araara jaallachuu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "akka ati gad of qabdee Waaqa kee wajjin deemtu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "sirraa barbaada mitii?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakkaa fi Adabamuu Israaʼel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin dhaggeeffadhaa!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.9",
                "verseOrgIds": [
                  "MIC.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee magaalattii waama:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "Maqaa kee sodaachuun ogummaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
