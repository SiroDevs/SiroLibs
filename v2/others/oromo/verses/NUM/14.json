        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sabni Finciluu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkan sana namoonni waldaa sanaa hundinuu sagalee isaanii ol fudhatanii booʼan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.1",
            "verseOrgIds": [
              "NUM.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni hundinuu Musee fi Aroonitti guunguman; waldaan guutuunis akkana isaaniin jedhe; \"Nu utuu biyyuma Gibxitti dhumnee jiraannee! Yookaan utuu gammoojjii kana keessatti dhumnee jiraannee!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.2",
            "verseOrgIds": [
              "NUM.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.3",
                "verseOrgIds": [
                  "NUM.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "maaliif akka nu goraadeedhaan dhumnuuf jedhee biyya kanatti nu fida? Niitonni keenyaa fi ijoolleen keenya ni boojiʼamu. Biyya Gibxitti deebiʼuun nuu hin wayyuu?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.3",
            "verseOrgIds": [
              "NUM.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Amma hoogganaa filannee biyya Gibxitti haa deebinu\" waliin jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.4",
            "verseOrgIds": [
              "NUM.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Musee fi Aroon fuula guutummaa yaaʼii Israaʼel kanneen achitti walitti qabamanii duratti addaan lafatti gombifaman.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.5",
            "verseOrgIds": [
              "NUM.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarreen biyyattii keessa deemanii basaasan keessaa Iyyaasuun ilmi Nuuniitii fi Kaaleb ilmi Yefunee uffata ofii tarsaasanii,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.6",
            "verseOrgIds": [
              "NUM.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "guutummaa yaaʼii Israaʼelootaatiin akkana jedhan; \"Biyyi nu keessa deemnee basaasne sun akka malee gaarii dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.7",
            "verseOrgIds": [
              "NUM.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.8",
                "verseOrgIds": [
                  "NUM.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "yoo nutti gammade biyya sanatti nu galchee biyyattii aannanii fi damma baaftu sana nuu kenna.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.8",
            "verseOrgIds": [
              "NUM.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin garuu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.9",
            "verseOrgIds": [
              "NUM.14.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.9",
                "verseOrgIds": [
                  "NUM.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "hin fincilinaa. Waan nu isaan lilliqimsinuuf namoota biyya sanaa hin sodaatinaa. Gaaddisni isaan irraa kaʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.9",
            "verseOrgIds": [
              "NUM.14.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.9",
                "verseOrgIds": [
                  "NUM.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nu wajjin jira. Isaan hin sodaatinaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.9",
            "verseOrgIds": [
              "NUM.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waldaan guutuun garuu dhagaan isaan tumuudhaaf mariʼate. Ulfinni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.10",
            "verseOrgIds": [
              "NUM.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.10",
                "verseOrgIds": [
                  "NUM.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula dunkaana wal gaʼii duratti Israaʼeloota hundatti mulʼate.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.10",
            "verseOrgIds": [
              "NUM.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.11",
                "verseOrgIds": [
                  "NUM.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe; \"Sabni kun hamma yoomiitti akkana na tuffata? Utuma ani mallattoowwan kanneen hunda gidduu isaaniitti hojjedhuu isaan hamma yoomiitti na amanuu didu?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.11",
            "verseOrgIds": [
              "NUM.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani golfaadhaan dhaʼee isaan nan balleessa; siʼi garuu saba isaan caalaa guddaa fi jabaa sin godha.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.12",
            "verseOrgIds": [
              "NUM.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.13",
            "verseOrgIds": [
              "NUM.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.13",
                "verseOrgIds": [
                  "NUM.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe; \"Warri Gibxi waaʼee waan kanaa ni dhagaʼu! Ati humna keetiin saba kana gidduu isaaniitii baaftee fiddeertaatii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.13",
            "verseOrgIds": [
              "NUM.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waaʼee waan kanaa saba biyya sana keessa jiraatutti ni odeessu. Yaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.14",
            "verseOrgIds": [
              "NUM.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.14",
                "verseOrgIds": [
                  "NUM.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", isaan akka ati saba kana gidduu jirtu dhagaʼaniiru; yaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.14",
            "verseOrgIds": [
              "NUM.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.14",
                "verseOrgIds": [
                  "NUM.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "isaan akka ati fuuluma isaaniitti mulʼatu, akka duumessi kee isaaniin ol jiruu fi akka ati guyyaa utubaa duumessaatiin, halkan immoo utubaa ibiddaatiin isaan dura deemtu dhagaʼanii jiru.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.14",
            "verseOrgIds": [
              "NUM.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati saba kana yeruma tokkotti barbadeessite, saboonni oduu waaʼee keetii dhagaʼan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.15",
            "verseOrgIds": [
              "NUM.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.16",
            "verseOrgIds": [
              "NUM.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.16",
                "verseOrgIds": [
                  "NUM.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "biyya kakuudhaan waadaa isaaniif gale sanatti saba kana galchuu hin dandeenye; inni kanumaaf gammoojjii keessatti isaan gogorraʼe' jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.16",
            "verseOrgIds": [
              "NUM.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Egaa akkuma ati akkana jettee dubbatte sanatti jabinni Gooftaa haa argisiifamu:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.17",
            "verseOrgIds": [
              "NUM.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.18",
            "verseOrgIds": [
              "NUM.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.18",
                "verseOrgIds": [
                  "NUM.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dafee hin aaru; jaalalli isaa immoo guddaa dha; inni cubbuu fi fincila namaaf dhiisa. Taʼu illee inni nama yakka hojjetu adabu malee hin dhiisu; inni hamma dhaloota sadaffaa fi afuraffaatti sababii cubbuu abbootii isaaniitiif jedhee ijoollee ni adaba.'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.18",
            "verseOrgIds": [
              "NUM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma yeroo isaan biyya Gibxii baʼanii jalqabdee hamma ammaatti dhiifama isaaniif goote sana akkuma jaalala kee guddaa sanaatti cubbuu saba kanaa dhiisiif.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.20",
                "verseOrgIds": [
                  "NUM.14.20"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee deebiseef; \"Ani akkuma ati kadhatte sana isaaniif dhiiseera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.20",
            "verseOrgIds": [
              "NUM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼu illee akkuma ani dhugumaan jiraataa taʼee fi akkuma ulfinni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.21",
            "verseOrgIds": [
              "NUM.14.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.21",
                "verseOrgIds": [
                  "NUM.14.21"
                ]
              }
            }
          ]
        },
        {
          "text": "dhugumaan lafa hunda guute sana,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.21",
            "verseOrgIds": [
              "NUM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoota ulfina koo arganii, mallattoowwan ani biyya Gibxiitii fi gammoojjii keessatti hojjedhe arganii garuu naa ajajamuu didanii yeroo kudhan na qoran sana keessaa namni tokko iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.22",
            "verseOrgIds": [
              "NUM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "tokkoon isaanii biyya ani kakuudhaan abbootii isaaniitiif waadaa gale sana hin argan. Namni na tuffate tokko biyya sana hin argu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.23",
            "verseOrgIds": [
              "NUM.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garbicha koo Kaaleb garuu sababii inni hafuura addaa qabuu fi sababii garaa guutuudhaan na duukaa buʼaa jiruuf, ani biyya inni dhaqe sanatti isa galcha; sanyiin isaas biyya sana ni dhaala.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.24",
            "verseOrgIds": [
              "NUM.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Amaaleqoonnii fi Kanaʼaanonni Sululoota keessa jiraataniif, isin bor deebiʼaatii karaa Galaana Diimaatiin gammoojjiitti qajeelaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.25",
            "verseOrgIds": [
              "NUM.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.26",
                "verseOrgIds": [
                  "NUM.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee fi Arooniin akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.26",
            "verseOrgIds": [
              "NUM.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waldaan hamaan kun hamma yoomiitti natti guunguma? Ani guungummii Israaʼeloota guungumtoota sanaa dhagaʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.27",
            "verseOrgIds": [
              "NUM.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkana jedhii isaanitti himi; '",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.28",
            "verseOrgIds": [
              "NUM.14.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.28",
                "verseOrgIds": [
                  "NUM.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha; ani jiraataadhaatii, akkuma isin gurra kootti dubbattan sana anis isinitti godha:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.28",
            "verseOrgIds": [
              "NUM.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reeffi keessan jechuunis reeffi warra umuriin isaanii waggaa digdamaa fi digdamaa olii kanneen lakkoobsa uummataa keessatti lakkaaʼamanii natti guunguman hundaa gammoojjii kana keessatti harcaʼee hafa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.29",
            "verseOrgIds": [
              "NUM.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaaleb ilma Yefuneetii fi Iyyaasuu ilma Nuuni malee tokkoon keessan iyyuu biyya ani keessa isin qubachiisuuf kakadhe sanatti hin galtan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.30",
            "verseOrgIds": [
              "NUM.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu ijoollee keessan warra isin ni boojiʼamu jettan sana itti nan galcha; isaanis biyya isin tuffattan sana ni beeku.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.31",
            "verseOrgIds": [
              "NUM.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin garuu, reeffi keessan gammoojjuma kana keessatti harcaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.32",
            "verseOrgIds": [
              "NUM.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen keessan waggaa afurtama gammoojjii kana keessa ni jooru; hamma isin hundi gammoojjii keessatti dhumtanitti isaan sababii amanamummaa dhabuu keessaniitiif achitti rakkatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.33",
            "verseOrgIds": [
              "NUM.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin akkuma bultii afurtama biyya sana basaastan, akkasuma bultiin tokko akka waggaa tokkootti lakkaaʼamee waggaa afurtama cubbuu keessaniif dhiphattu; yeroo sana isin akka ani isiniin mormu ni beektu.'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.34",
            "verseOrgIds": [
              "NUM.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.35",
                "verseOrgIds": [
                  "NUM.14.35"
                ]
              }
            }
          ]
        },
        {
          "text": "waan kana dubbadheen jira; ani dhugumaan waan kana waldaa hamaa naan mormuuf walitti gurmaaʼe kana guutuutti nan fida. Isaan gammoojjii kana keessatti dhumu; asumattis ni duʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Museen akka isaan biyyattii basaasaniif erge yommuu achii deebiʼanitti waaʼee biyya sanaa gabaasa hamaa waldaatti gabaasanii akka waldaan Museetti guungumu godhan jechuunis",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.36",
            "verseOrgIds": [
              "NUM.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni waaʼee biyyattii gabaasa hamaa gabaasuutti gaafataman sun dhaʼichaan fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.37",
            "verseOrgIds": [
              "NUM.14.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.37",
                "verseOrgIds": [
                  "NUM.14.37"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti dhuman.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.37",
            "verseOrgIds": [
              "NUM.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoota biyyattii basaasuu dhaqan keessaa Iyyaasuu ilma Nuunitii fi Kaaleb ilma Yefunee qofatu duʼa oole.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen waan kana hunda Israaʼelootatti himnaan isaan akka malee booʼan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.39",
            "verseOrgIds": [
              "NUM.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis guyyaa itti aanu ganamaan fiixee biyya gaaraatti ol baʼanii, \"Nu cubbuu hojjenneerra; nu amma gara lafa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.40",
            "verseOrgIds": [
              "NUM.14.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.40",
                "verseOrgIds": [
                  "NUM.14.40"
                ]
              }
            }
          ]
        },
        {
          "text": "waadaa nuu gale sanaa dhaqna\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.40",
            "verseOrgIds": [
              "NUM.14.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen garuu akkana jedhe; \"Isin maaliif ajaja",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.41",
            "verseOrgIds": [
              "NUM.14.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.41",
                "verseOrgIds": [
                  "NUM.14.41"
                ]
              }
            }
          ]
        },
        {
          "text": "cabsitu? Wanni kun isiniif hin milkaaʼu!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.41",
            "verseOrgIds": [
              "NUM.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka diinota keessaniin hin moʼatamneef ol hin baʼinaa;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.42",
            "verseOrgIds": [
              "NUM.14.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.42",
                "verseOrgIds": [
                  "NUM.14.42"
                ]
              }
            }
          ]
        },
        {
          "text": "isin wajjin hin jiruutii;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.42",
            "verseOrgIds": [
              "NUM.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaaleqoonnii fi Kanaʼaanonni achitti isinitti dhufuutii. Sababii isin",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.43",
                "verseOrgIds": [
                  "NUM.14.43"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa garagaltaniif inni isin wajjin hin jiraatu; goraadeedhaan barbadeeffamtu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu utuu Musee fi taabonni kakuu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.14.44",
                "verseOrgIds": [
                  "NUM.14.44"
                ]
              }
            }
          ]
        },
        {
          "text": "qubata keessaa gad hin baʼin yaaduma isaaniitiin kaʼanii fiixee biyya gaaraatti ol baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommus Amaaleqoonnii fi Kanaʼaanonni gaara sana irra jiraatan gad buʼanii isaan dhaʼanii hamma Hormaatti isaan ariʼan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.45",
            "verseOrgIds": [
              "NUM.14.45"
            ]
          }
        }
      ]
    }
