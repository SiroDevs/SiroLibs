      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 2:18"
      },
      "items": [
        {
          "text": "Hoogganaan ilmaan Efreem Eliishaamaa ilma Amiihuudii ti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.18",
            "verseOrgIds": [
              "NUM.2.18"
            ]
          }
        },
