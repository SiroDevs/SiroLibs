                "verseOrgIds": [
                  "NUM.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee fi Arooniin akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Israaʼeloonnis tokkoon tokkoon namaa faajjii ofii isaanii jalatti faajjii maatii isaa wajjin dunkaana irraa xinnuma fagaatee naannoo dunkaana wal gaʼii haa qubatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
