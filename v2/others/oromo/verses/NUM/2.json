            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakkoobsi kutaa isaas namoota 45,650.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
