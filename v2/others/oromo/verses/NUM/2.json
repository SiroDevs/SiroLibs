        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gama baʼaatiin, karaa baʼa biiftuutiin:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NUM 2:3"
      },
      "items": [
        {
          "text": "kutaawwan qubata Yihuudaa faajjii isaanii jala haa qubatan. Hoogganaan ijoollee Yihuudaa Nahishoon ilma Amiinaadaabii ti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakkoobsi kutaa isaas namoota 74,600.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
