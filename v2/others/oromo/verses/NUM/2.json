            "number": "33",
            "style": "v",
            "sid": "NUM 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni garuu akkuma",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
