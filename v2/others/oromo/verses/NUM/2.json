      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis dunkaanni wal gaʼiitii fi qubanni Lewwotaa qubatawwan gidduu haa deeman. Isaanis akkuma toora qubata isaaniitti tokkoon tokkoon isaanii iddoo isaanii eeggatanii faajjii isaanii jala haa deeman.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        }
      ]
