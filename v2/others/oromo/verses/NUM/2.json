        {
          "text": "Gosti Niftaalemitti haa aanu. Hoogganaan ijoollee Niftaalem Ahiiraa ilma Eenaanii ti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
            "verseOrgIds": [
