        {
          "text": "Gosti Minaasee isaanitti haa aanu. Hoogganaan ijoollee Minaasee Gamaaliʼeel ilma Phedaasuurii ti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
