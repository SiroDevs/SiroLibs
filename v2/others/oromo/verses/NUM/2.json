        {
          "text": "Gosti Simiʼoon isaanitti aanee haa qubatu. Hoogganaan gosa Simiʼoon Shilumiiʼeel ilma Zuriishadaayii ti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
