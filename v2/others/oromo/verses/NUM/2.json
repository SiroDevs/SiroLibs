            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakkoobsi kutaa isaas namoota 59,300.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
