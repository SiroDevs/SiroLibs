          ]
        },
        {
          "text": "Israaʼeloonni akkuma",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.54",
            "verseOrgIds": [
              "NUM.1.54"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
