            }
          ]
        },
        {
          "text": "\"Ati gosa Lewwii hin lakkaaʼin yookaan lakkoobsa saba Israaʼeloota kaaniitti hin dabalin.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.49",
            "verseOrgIds": [
              "NUM.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda kanaa akka Lewwonni itti gaafatamtoota dunkaana dhuga baʼumsaa, miʼa isaa hundaa fi waan inni qabu hundaa taʼaniif isaan muudi. Isaanis dunkaana qulqulluu fi miʼa isaa hunda haa baatan; dunkaanicha haa tajaajilan; naannoo isaas haa qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.50",
            "verseOrgIds": [
              "NUM.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo dunkaanni qulqulluun deemuu qabutti Lewwonni dunkaana sana haa buqqisan; yeroo dunkaanichi dhaabamus Lewwonni haa dhaaban. Namni dunkaanichatti dhiʼaatu biraa haa ajjeefamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.51",
            "verseOrgIds": [
              "NUM.1.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonnis tokkoon tokkoon namaa qubata isaa keessaa fi faajjii isaa jalatti kutaa kutaadhaan dunkaana isaanii haa dhaabbatan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.52",
            "verseOrgIds": [
              "NUM.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus Lewwonni akka dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.53",
            "verseOrgIds": [
              "NUM.1.53"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.1.53",
                "verseOrgIds": [
                  "NUM.1.53"
                ]
              }
            }
          ]
        },
        {
          "text": "waldaa Israaʼelitti gad hin buuneef dunkaanota isaanii naannoo dunkaana dhuga baʼumsaa haa dhadhaabatan. Lewwonni eegumsa dunkaana dhuga baʼumsaatti itti gaafatamtoota taʼuu qabu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.53",
            "verseOrgIds": [
              "NUM.1.53"
            ]
          }
        }
      ]
    },
