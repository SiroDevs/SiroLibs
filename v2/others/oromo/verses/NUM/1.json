          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii Simiʼoon keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        }
      ]
