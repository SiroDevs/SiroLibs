    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bultii kudha shanaffaa jiʼa torbaffaatti wal gaʼii qulqulluu godhadhaa; hojii idilee hin hojjetinaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoofis",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.12",
                "verseOrgIds": [
                  "NUM.29.12"
                ]
              }
            }
          ]
        },
        {
          "text": "bultii torba ayyaana ayyaaneffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiboota loonii kudha sadii, korbeeyyii hoolaa lamaa fi xobbaallaawwan hoolaa kudha afur kanneen umuriin isaanii waggaa tokko tokko taʼee fi kanneen hundi isaanii hirʼina hin qabne aarsaa gubamu kan fooliin isaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.13",
                "verseOrgIds": [
                  "NUM.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": "toluu fi kan ibiddaan dhiʼeeffamu dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoo tokkoo jiboota kudha sadanii wajjinis kennaa midhaanii kan daakuu bullaaʼaa iifii tokkoo irraa harka kudhan keessaa harki sadii zayitiidhaan sukkuumame dhiʼeessaa; tokkoo tokkoo korbeeyyii hoolaa lamaan sanaa wajjinis iifii tokko irraa harka kudhan keessaa harka lama,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "tokkoo tokkoo xobbaallaawwan hoolaa kudha afran sanaa wajjinis iifii tokko irraa harka kudhan keessaa harka tokko dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas aarsaa gubamu kan yeroo hunda dhiʼeeffamu kennaa midhaan isaattii fi dhibaayyuu isaatti dabalaatii korbeessa reʼee tokko aarsaa cubbuutiif dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
            "verseOrgIds": [
              "NUM.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
