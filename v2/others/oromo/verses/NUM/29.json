      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Guyyaa jalqaba jiʼa torbaffaatti wal gaʼii qulqulluu godhadhaa; gaafas hojii idilee hin hojjetinaa. Guyyaan kun guyyaa isin itti malakata afuuftanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dibicha loonii tokko, korbeessa hoolaa tokkoo fi xobbaallaawwan hoolaa torba kanneen umuriin isaanii waggaa tokko tokko taʼee fi kanneen hundi isaanii hirʼina hin qabne aarsaa gubamu kan fooliin isaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.2",
                "verseOrgIds": [
                  "NUM.29.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tolu dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dibicha sana wajjinis kennaa midhaanii kan daakuu bullaaʼaa iifii",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "text": "tokkoo irraa harka kudhan keessaa harka sadii zayitiidhaan sukkuumame dhiʼeessaa. Korbeessa hoolaa wajjinis iifii tokko irraa harka kudhan keessaa harka lama,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "xobbaallaawwan hoolaa torban sana wajjinis iifii tokko harka kudhan keessaa harka tokko dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas akka araarri isinii buufamuuf korbeessa reʼee tokko itti dabalaatii aarsaa cubbuutiif dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarsaawwan kunneen akkuma amala isaaniitti aarsaawwan gubaman kanneen jiʼa jiʼattii fi guyyaa guyyaatti dhiʼeeffamanii fi kennaawwan midhaaniittii fi dhibaayyuu isaaniitti dabalamanii dhiʼeeffamanii dha. Isaanis aarsaawwan ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.6",
                "verseOrgIds": [
                  "NUM.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffaman kanneen fooliin isaanii toluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Guyyaa Araarri Itti Buufamu",
          "type": "text"
        }
      ]
    },
