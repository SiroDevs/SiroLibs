    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo isin utuu hin beekin ajajawwan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.22",
            "verseOrgIds": [
              "NUM.15.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.22",
                "verseOrgIds": [
                  "NUM.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Museetti kenne kanneen keessaa tokko illee",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.22",
            "verseOrgIds": [
              "NUM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "jechuunis yoo isin ajaja",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.23",
                "verseOrgIds": [
                  "NUM.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "kan gaafa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.23",
                "verseOrgIds": [
                  "NUM.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ajaja kana kennee jalqabee dhaloota dhufu keessa illee ittuma fufuudhaan karaa Museetiin isin ajaje kam iyyuu cabsitan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo wanti kun dogoggoraan utuu waldaan hin beekin hojjetamee jiraate waldaan sun hundi dibicha loonii aarsaa gubamu kan urgaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.24",
            "verseOrgIds": [
              "NUM.15.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.24",
                "verseOrgIds": [
                  "NUM.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": "tolu, kennaa midhaaniitii fi dhibaayyuu ajajame wajjin, aarsaa cubbuutiif immoo korbeessa reʼee haa dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.24",
            "verseOrgIds": [
              "NUM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubnis waldaa saba Israaʼel hundaaf araara haa buusu; isaanis waan utuu hin beekin cubbuu hojjetaniif, balleessaa isaaniitiifis waan aarsaa ibiddaan dhiʼeeffamuu fi aarsaa cubbuu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.25",
            "verseOrgIds": [
              "NUM.15.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.25",
                "verseOrgIds": [
                  "NUM.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": "fidaniif dhiifama ni argatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.25",
            "verseOrgIds": [
              "NUM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii sabni hundi balleessaa dogoggoraan hojjetame sana keessatti hirmaateefis waldaan saba Israaʼel hundii fi alagaawwan isaan gidduu jiraatan dhiifama ni argatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Garuu yoo namni tokko qofti utuu hin beekin cubbuu hojjete inni goromtii reʼee kan umuriin ishee waggaa tokkoo aarsaa cubbuutiif haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.27",
            "verseOrgIds": [
              "NUM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni sunis namicha utuu itti hin yaadin cubbuu hojjete sanaaf fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
            "verseOrgIds": [
              "NUM.15.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.28",
                "verseOrgIds": [
                  "NUM.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti araara haa buusu; erga araarri isaaf buʼee booddee immoo namichi sun dhiifama ni argata.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
            "verseOrgIds": [
              "NUM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhalataa Israaʼeliifis taʼu yookaan alagaa isin gidduu jiraatuuf, nama utuu itti hin yaadin cubbuu hojjete hundaaf seerri tokkuma haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.29",
            "verseOrgIds": [
              "NUM.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Garuu dhalataa biyyaas taʼu yookaan alagaan, namni beekaa cubbuu hojjetu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.30",
                "verseOrgIds": [
                  "NUM.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": "arrabsuu isaa ti; namichi sun saba isaa keessaa haa balleeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi sun sababii dubbii",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.31",
                "verseOrgIds": [
                  "NUM.15.31"
                ]
              }
            }
          ]
        },
        {
          "text": "tuffatee fi sababii ajaja isaa cabseef inni haa balleeffamu; balleessaa isaattis isatu gaafatama.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Namni Sanbata Cabse Tokko Ajjeefame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sabni Israaʼel gammoojjii keessa turetti, namni tokko utuu guyyaa Sanbataatiin qoraan walitti qabatuu argame.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.32",
            "verseOrgIds": [
              "NUM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri utuu inni qoraan walitti qabatuu arganis Museetti, Arooniitii fi waldaa guutuutti isa geessan;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.33",
            "verseOrgIds": [
              "NUM.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "sababii wanni isa godhan hin beekaminiif hidhanii isa tursan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.34",
            "verseOrgIds": [
              "NUM.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.35",
                "verseOrgIds": [
                  "NUM.15.35"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan, \"Namichi duʼuu qaba. Waldaan sun guutuun qubataan alatti dhagaadhaan isa haa tumu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.35",
            "verseOrgIds": [
              "NUM.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waldaan sun akkuma",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.36",
                "verseOrgIds": [
                  "NUM.15.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee ajajetti namicha sana qubata keessaa gad baasee dhagaadhaan tumee ajjeese.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Handaara Wayyaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.37",
                "verseOrgIds": [
                  "NUM.15.37"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.37",
            "verseOrgIds": [
              "NUM.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akkana jedhii Israaʼelootatti dubbadhu: 'Dhaloota dhufu hunda keessa qarqara wayyaa keessanii irratti handaara tolfadhaa; tokkoon tokkoon handaara sanaas foʼaa bifa cuquliisaa haa qabaatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.38",
            "verseOrgIds": [
              "NUM.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin handaara kana ilaaltanii ajaja",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
            "verseOrgIds": [
              "NUM.15.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.39",
                "verseOrgIds": [
                  "NUM.15.39"
                ]
              }
            }
          ]
        },
        {
          "text": "hunda yaadattu; kunis akka ajaja kana eegdanii hawwii garaa keessaniitii fi hawwii ija keessanii duukaa buʼuudhaan hin sagaagalleef.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
            "verseOrgIds": [
              "NUM.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoos isin ajaja koo hunda yaadattanii ni eegdu; Waaqa keessaniifis qulqulloota ni taatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.40",
            "verseOrgIds": [
              "NUM.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.41",
                "verseOrgIds": [
                  "NUM.15.41"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan kan Waaqa isinii taʼuuf jedhee biyya Gibxii isin baasee dha. Ani",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.15.41",
                "verseOrgIds": [
                  "NUM.15.41"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        }
      ]
    }
