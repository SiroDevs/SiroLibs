              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Meraarota balbala balbalaa fi maatii maatii isaaniitiin lakkaaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiirota umuriin isaanii waggaa soddomaa hamma shantamaa kanneen hojii dunkaana wal gaʼii hojjechuuf dhufan hunda lakkaaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni isaan yeroo hojii dunkaana wal gaʼii hojjetanitti godhan kanaa dha: kunis tuggeewwan dunkaana qulqulluu, dagaleewwan isaa, utubootaa fi miillawwan isaanii,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "utuboota oobdiitti naannaʼanii jiran miillawwan isaanii wajjin, qofoowwan dunkaanaa, funyoowwan, miʼa isaanii hundaa fi wantoota hojii kanaaf fayyadan hunda baachuu dha. Isinis waan tokkoon tokkoon namaa baatu addaan baasaatii ramadaafii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
              "NUM.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajaajilli balbalawwan Meraarotaa qajeelfama Iitaamaar ilma Aroon lubichaa jala dunkaana wal gaʼii keessatti kennan kanaa dha.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
            "verseOrgIds": [
              "NUM.4.33"
            ]
          }
        }
      ]
    },
