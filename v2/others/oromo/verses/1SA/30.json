          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra Raakaal akkasumas warra magaalaa Yeramiʼeelotaatii fi magaalaa Qeenotaa keessa jiraataniif,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
