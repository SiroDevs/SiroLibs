  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "1SA 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daawit Ammas Saaʼolin Ajjeesuu Irraa Of Qabe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Ziif gara Gibeʼaa Saaʼol bira dhaqanii, \"Kunoo Daawit gaara Hakiilaa kan Yasemoonitti garagaltu irra dhokatee jira mitii?\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.1",
            "verseOrgIds": [
              "1SA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Saaʼol namoota Israaʼel keessaa filataman kuma sadii wajjin Daawitin barbaacha Gammoojjii Ziifitti gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.2",
            "verseOrgIds": [
              "1SA.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol qubata isaa daandii gaara Hakiilaa kan Yasemoonitti garagalu sana cina dhaabbate; Daawit garuu gammoojjii keessa ture. Innis yeroo akka Saaʼol isa duukaa buʼaa jiru beeketti,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.3",
            "verseOrgIds": [
              "1SA.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "basaastota ergee akka Saaʼol dhugumaan achi gaʼe mirkaneeffate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.4",
            "verseOrgIds": [
              "1SA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis achii baʼee iddoo Saaʼol qubate dhaqe. Innis iddoo Saaʼolii fi Abneer ilmi Neer ajajaan loltootaa ciciisan arge. Saaʼol qubata keessa rafe; loltoonnis isa marsanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.5",
            "verseOrgIds": [
              "1SA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis Ahiimelek namicha Heetii fi Abiishaayi ilma Zeruuyaa obboleessa Yooʼaabiin, \"Eenyutu na wajjin gara qubata kanaa Saaʼolitti seena?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:6"
      },
      "items": [
        {
          "text": "Abiishaayis, \"Anatu si wajjin seena\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.6",
            "verseOrgIds": [
              "1SA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Daawitii fi Abiishaayi halkaniin gara loltootaa dhaqan; Saaʼol eeboo isaa mataa isaa bira lafatti dhaabee qubata keessa rafaa ture. Abneerii fi loltoonni immoo isa marsanii ciciisaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.7",
            "verseOrgIds": [
              "1SA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiishaayis Daawitiin, \"Harʼa Waaqni diinota kee dabarsee harka keetti kenneera. Mee akka ani utuu itti hin deebiʼin yeruma tokkoon eeboo kootiin waraanee lafatti isa hodhu naa eeyyami; irra deebiʼee dhaʼuus na hin barbaachisu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit garuu Abiishaayiin akkana jedhe; \"Isa hin ajjeesin! Namni nama",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.9",
                "verseOrgIds": [
                  "1SA.26.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dibetti harka ol fudhatee yakka malee hafu jiraa?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.10",
            "verseOrgIds": [
              "1SA.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.10",
                "verseOrgIds": [
                  "1SA.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraataa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.10",
            "verseOrgIds": [
              "1SA.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.10",
                "verseOrgIds": [
                  "1SA.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "mataan isaa iyyuu isa ni galaafata yookaan inni yeroon isaa gaʼee ni duʼa yookaan duula dhaqee achitti ni duʼa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.10",
            "verseOrgIds": [
              "1SA.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akka ani dibamaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.11",
                "verseOrgIds": [
                  "1SA.26.11"
                ]
              }
            }
          ]
        },
        {
          "text": "harka koo ol hin kaafanne",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.11",
                "verseOrgIds": [
                  "1SA.26.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na haa eegu; amma garuu eeboo fi cuggee bishaanii kan mataa isaa bira jiru fuudhiitii haa deemnu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Daawit eeboo fi cuggee bishaanii kan mataa Saaʼol bira ture sana fudhatee kaʼanii deeman. Namni waan kana arge yookaan beeke tokko iyyuu hin turre yookaan namni tokko iyyuu hin dammaqne. Sababii",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.12",
            "verseOrgIds": [
              "1SA.26.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.12",
                "verseOrgIds": [
                  "1SA.26.12"
                ]
              }
            }
          ]
        },
        {
          "text": "hirriba cimaa isaanitti gad dhiiseef hundi isaanii rafanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.12",
            "verseOrgIds": [
              "1SA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Daawit gamatti ceʼee fagaatee fiixee gaara irra dhaabate; gidduu isaaniis lafa balʼaatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.13",
            "verseOrgIds": [
              "1SA.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis loltootaa fi Abneer ilma Neeriitiin, \"Yaa Abneer, ati deebii naaf hin kennituu?\" jedhee lallabe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:14"
      },
      "items": [
        {
          "text": "Abneeris deebisee, \"Ati kan mootiitti iyyitu eenyu?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit akkana jedhe; \"Abneer, ati jagna mitii? Israaʼel keessatti namni siin qixxaatu eenyu? Ati maaliif gooftaa kee mooticha sirriitti hin eegne? Kunoo namni tokko gooftaa kee mooticha ajjeesuuf dhufee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.15",
            "verseOrgIds": [
              "1SA.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni ati goote gaarii miti. Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.16",
                "verseOrgIds": [
                  "1SA.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraataa, atii fi namoonni kee duʼuu qabdu; isin gooftaa keessan dibamaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.16",
                "verseOrgIds": [
                  "1SA.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sana hin eegneetii. Mee naannoo kee ilaali. Eeboo fi cuggeen bishaanii kan mataa mootichaa bira ture sun meerre?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol sagalee Daawit beekee, \"Yaa ilma koo Daawit, kun sagalee keetii?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:17"
      },
      "items": [
        {
          "text": "Daawitis, \"Eeyyee; sagalee koo ti; yaa gooftaa koo mootii\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti fufees akkana jedhe; \"Gooftaan koo maaliif tajaajilaa isaa ariʼa? Ani maalin godhe? Ani yakka maalin qaba?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.18",
            "verseOrgIds": [
              "1SA.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa mee gooftaan koo mootichi dubbii tajaajilaa isaa haa dhagaʼu. Yoo",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.19",
                "verseOrgIds": [
                  "1SA.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "natti si kakaasee jiraate inni aarsaa haa fudhatu. Garuu namoonni yoo waan kana godhanii jiraatan fuula",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.19",
                "verseOrgIds": [
                  "1SA.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti haa abaaraman! Isaan akka ani dhaala",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.19",
                "verseOrgIds": [
                  "1SA.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "keessaa qooda hin qabaanneef na ariʼanii, 'Dhaqiitii waaqota biraa tajaajili' jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiigni koo fuula",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.20",
                "verseOrgIds": [
                  "1SA.26.20"
                ]
              }
            }
          ]
        },
        {
          "text": "duraa fagaatee akka lafatti dhangalaʼu hin godhin. Akkuma namni tokko gaara gubbaatti gogorrii adamsu sana mootiin Israaʼel tafkii barbaaduu baʼeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis, \"Ani yakka hojjedheera. Yaa ilma koo Daawit kottuu deebiʼi. Sababii harʼa lubbuun koo fuula kee duratti ulfina argatteef ani lammata si miidhuu hin yaalu. Ani dhugumaan hojii gowwummaa hojjedheera; guddaas dogoggoreera jedhe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.21",
            "verseOrgIds": [
              "1SA.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis akkana jedhee deebise; \"Eeboon mootichaa kunoo ti; dargaggoota kee keessaa namni tokko dhufee haa fuudhu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
              "1SA.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.23",
                "verseOrgIds": [
                  "1SA.26.23"
                ]
              }
            }
          ]
        },
        {
          "text": "nama hundaaf qajeelummaa isaatii fi amanamummaa isaatiif gatii ni kenna.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.23",
                "verseOrgIds": [
                  "1SA.26.23"
                ]
              }
            }
          ]
        },
        {
          "text": "harʼa dabarsee harka kootti si kennee ture; ani garuu dibamaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.23",
                "verseOrgIds": [
                  "1SA.26.23"
                ]
              }
            }
          ]
        },
        {
          "text": "harka ol hin fudhadhu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma ani harʼa lubbuu kee ulfeesse kana,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1SA.26.24",
                "verseOrgIds": [
                  "1SA.26.24"
                ]
              }
            }
          ]
        },
        {
          "text": "lubbuu koo ulfeessee rakkina hunda jalaa na haa baasu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
