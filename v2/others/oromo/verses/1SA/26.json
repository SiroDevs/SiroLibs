          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Saaʼol Daawitiin, \"Yaa ilma koo Daawit eebbifami; ati waan guddaa hojjetta; dhugumaanis ni moʼatta\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 26:25"
      },
      "items": [
        {
          "text": "Kanaafuu Daawit karaa isaa itti fufe; Saaʼolis gara manaatti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    }
