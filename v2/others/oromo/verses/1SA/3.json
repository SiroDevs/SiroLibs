          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf Saamuʼeel waan tokko illee utuu hin dhoksin waan hundumaa isatti hime. Eeliinis, \"Inni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        },
        {
          "name": "char",
