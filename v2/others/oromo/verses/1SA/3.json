          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.18",
                "verseOrgIds": [
                  "1SA.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dha; waan isatti tole haa godhu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        }
      ]
    },
