  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1SA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daawit Adulaamii fi Miisphaa Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit Gaatii kaʼee gara holqa Adulaamitti baqate. Obboloonni isaatii fi maatiin abbaa isaa hundi yeroo waan kana dhagaʼanitti gara isaa dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.1",
            "verseOrgIds": [
              "1SA.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni rakkatan hundi yookaan kanneen gatiin irra jiru hundii fi warri of jibban hundi isa biratti wal gaʼan; innis hoogganaa isaanii taʼe. Namoonni isa wajjin turanis gara dhibba afurii ti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit achii kaʼee Miisphaa ishee biyya Moʼaabitti argamtuu dhaqee mooticha Moʼaabiin, \"Hamma ani waan Waaqni naaf godhu beekutti akka abbaan koo fi haati koo dhufanii si bira jiraatan ni eeyyamtaa?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.3",
            "verseOrgIds": [
              "1SA.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis mootii Moʼaab biratti isaan dhiise; isaanis yeroo Daawit iddoo daʼannoo keessa turetti mooticha bira jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.4",
            "verseOrgIds": [
              "1SA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus Gaad raajichi Daawitiin, \"Daʼannoo keessa hin turin. Biyya Yihuudaatti gali\" jedhe. Kanaafuu Daawit achii baʼee bosona Hereeti seene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saaʼol Luboota Noob Fixuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol akka Daawitii fi namoonni isaa argaman dhagaʼe. Saaʼolis eeboo harkatti qabatee gaara Gibeʼaa irra muka tamirii jala taaʼaa ture. Qondaaltonni isaa hundinuus isa bira dhaabachaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.6",
            "verseOrgIds": [
              "1SA.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis akkana isaaniin jedhe; \"Yaa namoota Beniyaam dhagaʼaa! Dhugumaan ilmi Isseey lafa qotiisaatii fi iddoo dhaabaa wayinii hunda keessaniif ni kennaa? Hunda keessanis ajajjuuwwan kumaatii fi ajajjuuwwan dhibbaa ni godhaa?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.7",
            "verseOrgIds": [
              "1SA.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin isin hundi natti malattaniif kanaa? Yeroo ilmi koo ilma Isseey wajjin kakuu galutti namni tokko iyyuu natti hin himu. Isin keessaa namni tokko iyyuu dhimma koo hin qabu yookaan akka ilmi koo akka inni akkuma harʼa gochaa jiru kana akka tajaajilaan koo riphee na eeggatuuf isa natti kakaasu isin keessaa namni tokko iyyuu natti hin himu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.8",
            "verseOrgIds": [
              "1SA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu Dooʼeeg Edoomichi kan qondaaltota Saaʼol wajjin dhaabachaa ture sun akkana jedhee deebise; \"Ani ilma Isseey isaa gara Noob Ahiimelek ilma Ahiixuub bira dhufuu nan arge.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiimelekis",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1SA.22.10",
                "verseOrgIds": [
                  "1SA.22.10"
                ]
              }
            }
          ]
        },
        {
          "text": "isaaf kadhate; akkasumas galaa fi goraadee Gooliyaad Filisxeemichaa kenneef.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootichi Ahiimelek lubicha ilma Ahiixuubitti nama ergee isaa fi maatii abbaa isaa kanneen Noobitti luboota turan hunda waamsise; isaanis gara mootichaa dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.11",
            "verseOrgIds": [
              "1SA.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis, \"Yaa ilma Ahiixuub dhagaʼi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 22:12"
      },
      "items": [
        {
          "text": "Innis, \"Yaa gooftaa, ani kunoo ti\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis akkana isaan jedhe; \"Ati maaliif buddeenaa fi goraadee kenniteefii Waaqa kadhachuufiidhaan akka inni natti fincilee akkuma harʼa gochaa jiru kana riphee na eeggatu isa gootee ilma Isseey wajjin natti malatte?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.13",
            "verseOrgIds": [
              "1SA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiimelekis deebisee mootichaan akkana jedhe; \"Dhirsi intala mootichaa, ajajaa loltoota si eeganiitii fi namni mana kee keessatti akka malee kabajamu tajaajiltoota kee hunda keessaa amanamaan akka Daawit eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.14",
            "verseOrgIds": [
              "1SA.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa isaaf kadhachuun koo harʼa guyyaa jalqabaatii? Miti! Mootichi garbicha kee yookaan maatii abbaa isaa keessaa nama tokko illee yakkamaa hin godhin; garbichi kee waaʼee waan kana hundaa homaa hin beekuutii.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.15",
            "verseOrgIds": [
              "1SA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi garuu, \"Yaa Ahiimelek, dhugumaan ati ni duuta; atis, maatiin abbaa keetii hundinuus ni duutu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.16",
            "verseOrgIds": [
              "1SA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis mootichi waardiyyoota isa bira turaniin, \"Sababii luboonni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.22.17",
                "verseOrgIds": [
                  "1SA.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": "kunneen Daawitiif tumsaniif, itti garagalaatii isaan fixaa. Isaan akka inni baqachaa ture ni beeku; taʼus natti hin himne\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 22:17"
      },
      "items": [
        {
          "text": "Qondaaltonni mootichaa garuu luboota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.22.17",
                "verseOrgIds": [
                  "1SA.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": "dhaʼuudhaaf harka isaanii ol fudhachuu hin feene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Itti garagaliitii luboota fixi\" jedhee Dooʼeeg Edoomicha ajaje. Kanaafuu Dooʼeeg Edoomichi itti garagalee isaan dhaʼe. Inni gaafas luboota dirata quncee talbaa irraa hojjetame uffatan saddeettamii shan fixe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.18",
            "verseOrgIds": [
              "1SA.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noob magaalaa lubootaas, dhiirotaa fi dubartoota ishee, ijoollee fi daaʼimman ishee, loon, harrootaa fi hoolota ishee goraadeedhaan barbadeesse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu Abiyaataar ilmi Ahiimelek ilma Ahiixuub sun miliqee gara Daawititti baqate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.20",
            "verseOrgIds": [
              "1SA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka Saaʼol luboota",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
              "1SA.22.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.22.21",
                "verseOrgIds": [
                  "1SA.22.21"
                ]
              }
            }
          ]
        },
        {
          "text": "fixe Daawititti hime.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
              "1SA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis Abiyaataariin akkana jedhe; \"Ani gaafas yeroo Dooʼeeg Edoomichi achi turetti akka inni dhugumaan Saaʼolitti odeessu beekeera. Badiisa maatii abbaa keetii hundaaf anatu gaafatama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.22",
            "verseOrgIds": [
              "1SA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana wajjin turi; hin sodaatin; namni lubbuu kee barbaadu, lubbuu koos ni barbaada. Ati na wajjin nagumaan jiraatta.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.23",
            "verseOrgIds": [
              "1SA.22.23"
            ]
          }
