    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis Faraʼoon mooticha Gibxi wajjin walii galtee uummatee intala isaa fuudhe. Innis hamma masaraa mootummaa ofii isaatii fi mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.1",
            "verseOrgIds": [
              "1KI.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.1",
                "verseOrgIds": [
                  "1KI.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ijaaree, naannoo Yerusaalemittis dallaa ijaaruu fixutti magaalaa Daawititti ishee fide.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.1",
            "verseOrgIds": [
              "1KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus sababii hamma gaafasiitti manni qulqullummaa Maqaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiif",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.2",
                "verseOrgIds": [
                  "1KI.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "hin ijaaraminiif namoonni iddoo ol kaʼaa irratti aarsaa dhiʼeessaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon akkuma ajaja abbaan isaa Daawit isaaf kenneetti jiraachaa jaalala",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.3",
            "verseOrgIds": [
              "1KI.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.3",
                "verseOrgIds": [
                  "1KI.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": "qabu argisiise; garuu aarsaa fi ixaana aarfamu iddoo ol kaʼaa irratti dhiʼeessaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.3",
            "verseOrgIds": [
              "1KI.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi aarsaa dhiʼeessuuf gara Gibeʼoon dhaqe; iddoon sunis iddoo sagadaa kan gaara irraa isa baayʼee jaalatamaa isa Solomoon aarsaa gubamu kuma tokko irratti dhiʼeesse tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.4",
            "verseOrgIds": [
              "1KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.5",
                "verseOrgIds": [
                  "1KI.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Gibeʼoonitti halkan abjuu keessa Solomoonitti mulʼate; Waaqnis, \"Waan akka ani siif kennu feetu kam iyyuu na kadhadhu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.5",
            "verseOrgIds": [
              "1KI.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon immoo akkana jedhee deebise; \"Ati sababii inni amanamummaa fi qajeelummaadhaan fuula kee dura jiraatee gara tolina siif qabaateef garbicha kee, abbaa koo Daawitiif arjummaa guddaa goote. Arjummaa guddaa kanas ittuma fufteefii harʼa ilma teessoo isaa irra taaʼu kenniteefii jirta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.6",
            "verseOrgIds": [
              "1KI.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Egaa yaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.7",
                "verseOrgIds": [
                  "1KI.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa ko, ati iddoo abbaa koo Daawit, garbicha kee mootii gooteerta. Ani garuu daaʼima xinnaa dha; hojii koos akkan itti hojjedhu hin beeku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garbichi kee kunoo saba ati filatte saba guddaa, kan lakkaaʼamuu hin dandeenye yookaan herregamuudhaaf akka malee baayʼatu keessa jira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.8",
            "verseOrgIds": [
              "1KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu hubannaa ani ittiin saba kee bulchuu fi waan gaarii fi waan hamaa ittiin gargar baasee beeku garbicha keetiif kenni. Yoo akkas taʼuu baate eenyutu saba kee guddaa kana bulchuu dandaʼa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.9",
            "verseOrgIds": [
              "1KI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon waan kana kadhachuun isaa fuula Gooftaa duratti gammachiisaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.10",
            "verseOrgIds": [
              "1KI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Waaqni akkana jedheen; \"Ati waan kana kadhatte malee ofii keetiif bara dheeraa yookaan sooroma yookaan lubbuu diinota keetii hin kadhanne; garuu waan murtii qajeelaa kennuuf hubannaa kadhatteef,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.11",
            "verseOrgIds": [
              "1KI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani waan ati kadhatte kana siifin kenna. Qalbii ogeessa waa hubatu kan namoonni si dura turan hin qabaatin, kan warri si duubaan dhufanis hin qabaanne siifin kenna.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.12",
            "verseOrgIds": [
              "1KI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana malee iyyuu akka bara jireenya keetii keessa mootota gidduudhaa tokko illee siin hin qixxaanneef ani waan ati hin kadhatin sooromaa fi ulfina siifin kenna.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.13",
            "verseOrgIds": [
              "1KI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati karaa koo irra deemtee akkuma abbaan kee Daawit hojjete sana seeraa fi ajaja koo eegde, ani umurii kee nan dheeressa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.14",
            "verseOrgIds": [
              "1KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon ergasii dammaqee akka wanni sun abjuu taʼe hubate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.15",
            "verseOrgIds": [
              "1KI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:15"
      },
      "items": [
        {
          "text": "Innis gara Yerusaalemitti deebiʼee taabota kakuu Gooftaa dura dhaabatee aarsaa gubamuu fi aarsaa nagaa dhiʼeesse. Ergasiis garboota isaa hundaaf cidha qopheesse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.15",
            "verseOrgIds": [
              "1KI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogummaadhaan Murtii Kennuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti sagaagaltoonni lama dhufanii fuula mootichaa dura dhaabatan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.16",
            "verseOrgIds": [
              "1KI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen tokko akkana jette; \"Yaa Gooftaa ko, anii fi dubartiin kun manuma tokko keessa jiraanna. Utuma isheen na wajjin jirtuu ani mucaan daʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.17",
            "verseOrgIds": [
              "1KI.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga ani daʼee guyyaa sadii booddee dubartiin kunis mucaa deesse. Nu kophaa keenya turre; nu lamaan malee namni tokko iyyuu mana sana keessa hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.18",
            "verseOrgIds": [
              "1KI.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ilmi dubartii kanaa sababii isheen halkan irra ciifteef jalaa duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.19",
            "verseOrgIds": [
              "1KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isheen utuu ani garbittiin kee rafuu halkan walakkaa kaatee mucaa koo na biraa fudhatte. Isheenis laphee ishee jala isa kaaʼattee ilma ishee kan duʼe sana laphee koo jala keesse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.20",
            "verseOrgIds": [
              "1KI.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganama itti aanutti ani ilma koo hoosifachuufan kaʼe; kunoo inni duʼee jira! Ani garuu yommuun ifa ganamaatiin itti dhiʼaadhee ilaaletti akka inni ilma ani daʼe sana hin taʼin nan hubadhe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.21",
            "verseOrgIds": [
              "1KI.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin kaanis, \"Akkas miti! Inni jiru kun ilma koo ti; kan duʼe sun immoo kan kee ti\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:22"
      },
      "items": [
        {
          "text": "Isheen jalqabaa sun garuu ittuma cimsitee, \"Akkas miti! Kan duʼe sun kan kee ti; kan jiru kun immoo koo ti\" jette. Isaanis akkasiin fuula mootichaa duratti wal falman.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Isheen kun, 'Ilmi koo ni jira; kan kee immoo duʼeera' jetti; isheen kaanis, 'Akkas miti! Ilmi kee duʼeera; kan koo immoo ni jira' jetti\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.23",
            "verseOrgIds": [
              "1KI.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootichis, \"Goraadee naa fidaa\" jedhe. Isaanis mootichaaf goraadee fidan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.24",
            "verseOrgIds": [
              "1KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Mucaa jiru kana iddoo lamatti wal qixxeetti kutaatii walakkaa isaa ishee tokkoof kennaa; walakkaa immoo ishee kaaniif kennaa\" jedhee ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin ilmi ishee lubbuun jiru sun mucaa isheetiif akka malee garaa laaftee mootichaan, \"Maaloo yaa Gooftaa ko, mucaa lubbuun jiru kana isheef kenni malee hin ajjeesin\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:26"
      },
      "items": [
        {
          "text": "Isheen kaan immoo, \"Inni iddoo lamatti haa muramuu malee anaafis siifis hin taʼu!\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootichi, \"Mucaa lubbuun jiru kana dubartii duraa sanaaf kennaa malee hin ajjeesinaa; haati isaa isheedhaatii\" jedhee ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.27",
            "verseOrgIds": [
              "1KI.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼel hundi murtii mootichi kenne ni dhagaʼan; isaanis sababii akka inni murtii qajeelaa kennuuf Waaqa irraa ogummaa argate hubataniif mooticha ni sodaatan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.28",
            "verseOrgIds": [
              "1KI.3.28"
            ]
          }
        }
      ]
