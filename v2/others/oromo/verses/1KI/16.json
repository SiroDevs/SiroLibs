                "verseOrgIds": [
                  "1KI.16.30"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti hammina hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.30",
            "verseOrgIds": [
              "1KI.16.30"
            ]
          }
        },
        {
