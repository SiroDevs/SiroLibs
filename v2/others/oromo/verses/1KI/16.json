          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaab ammas siidaa Aasheeraa dhaabee waan mootonni Israaʼel kanneen isa duraan turan hundi hojjetan caalaa hojjetee",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.33",
            "verseOrgIds": [
