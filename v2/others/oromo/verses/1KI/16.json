          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis mana Baʼaal itti waaqeffatamu tokko Samaariyaatti ijaaree iddoo aarsaa tokko achi keessa dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.32",
            "verseOrgIds": [
              "1KI.16.32"
            ]
          }
        },
        {
