            }
          ]
        },
        {
          "text": "Bara Ahaab keessa Hiiʼeel namichi Beetʼeel tokko Yerikoo deebisee ijaare. Akkuma dubbii",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        },
        {
