          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omriin garuu fuula",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.25",
            "verseOrgIds": [
              "1KI.16.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.25",
                "verseOrgIds": [
                  "1KI.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti hammina hojjetee namoota isa duraan turan hunda caalaa cubbame.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.25",
            "verseOrgIds": [
              "1KI.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis karaa Yerobiʼaam ilma Nebaat hunda irra deemee cubbuu Yerobiʼaam hojjetee saba Israaʼelis hojjechiisee akka isaan waaqota isaanii tolfamoo kanneen faayidaa hin qabneen",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.26",
            "verseOrgIds": [
              "1KI.16.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.26",
                "verseOrgIds": [
                  "1KI.16.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼel aariif kakaasan godhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.26",
            "verseOrgIds": [
              "1KI.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
