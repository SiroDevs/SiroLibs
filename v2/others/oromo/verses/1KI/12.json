                "verseOrgIds": [
                  "1KI.12.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ajaje sanatti mana ofii isaaniitti dachaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
