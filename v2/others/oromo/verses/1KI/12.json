    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jabbiiwwan Warqee Irraa Tolfaman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobiʼaamis ergasii biyya gaaraa Efreem keessatti Sheekemin jabeessee ijaaree achi jiraate. Achiis baʼee Phenuuʼeelin ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
            "verseOrgIds": [
              "1KI.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobiʼaam akkana jedhee garaa isaatti yaade; \"Amma mootummaan mana Daawitiif ni deebiʼa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
            "verseOrgIds": [
              "1KI.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni kunneen yoo mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.27",
                "verseOrgIds": [
                  "1KI.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "kan Yerusaalem jiru sanatti aarsaa dhiʼeessuuf ol baʼan amma illee gara gooftaa isaanii Rehooboʼaam mooticha Yihuudaatti garagalu. Isaan na ajjeesanii gara Rehooboʼaam Mootichaatti deebiʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi mariʼatee jabbiiwwan lama warqee irraa tolche. Namoota sanaanis, \"Yerusaalemitti ol baʼuun akka malee isinitti ulfaata. Yaa Israaʼel waaqonni keessan kanneen Gibxii baasanii isin fidan kunoo ti\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis jabbii tokko Beetʼeel keessa, kaan immoo Daan keessa dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.29",
            "verseOrgIds": [
              "1KI.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kunis cubbuu itti taʼe; namoonnis jabbii achi jiru sana waaqeffachuuf hamma Daanitti deeman.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobiʼaamis gaara irratti iddoo sagadaa ijaaree saboota Lewwota hin taʼin keessaa luboota muude.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis bultii kudha shanaffaa jiʼa saddeettaffaa keessa ayyaana akkuma ayyaana Yihuudaa keessatti ayyaaneffame sanaa tokko hundeessee iddoo aarsaa irratti qalma dhiʼeesse. Kanas fakkiiwwan jabbii kanneen tolchee ture sanaatiif aarsaa dhiʼeessuudhaan Beetʼeelitti hojjete. Akkasumas Beetʼeelitti iddoo sagadaa kan gaara irratti ijaaree ture sanatti luboota ramade.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis bultii kudha shanaffaa jiʼa saddeettaffaatti jiʼuma ofii filate keessa gara iddoo aarsaa kan Beetʼeelitti ijaare sanaatti ol baʼe. Saba Israaʼeliifis guyyaa ayyaanaa hundeessee ixaana aarsuuf gara iddoo aarsaatti ol baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
      ]
    }
