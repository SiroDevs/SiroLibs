  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EPH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ijoollee fi Warra Isaanii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ijoolle, Gooftaaf jedhaatii abbootii fi haadhota keessaniif ajajamaa; kun qajeelaadhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.1",
            "verseOrgIds": [
              "EPH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajni jalqabaa kan waadaa qabu, \"Abbaa keetii fi haadha keetiif ulfina kenni\" jedha;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.2",
            "verseOrgIds": [
              "EPH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis, \"Akka sitti toluu fi akka lafa irra bara dheeraa jiraattuuf.\"",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.3",
            "verseOrgIds": [
              "EPH.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa abbootii, isinis ijoollee keessan barsiisaa fi gorsa Gooftaatiin guddisaa malee hin aarsinaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Garbootaa fi Gooftota",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa garboota, akkuma Kiristoosiif ajajamtanitti kabajaa fi sodaadhaan, garaa qulqulluunis gooftota keessan warra addunyaa kanaatiif ajajamaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.5",
            "verseOrgIds": [
              "EPH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo iji isaanii isin argutti isaan biratti fudhatama argachuu qofaaf utuu hin taʼin garaa guutuun fedhii Waaqaa raawwachaa akka garboota Kiristoositti isaaniif ajajamaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.6",
            "verseOrgIds": [
              "EPH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka waan nama tajaajiltaniitti utuu hin taʼin akka waan Gooftaa tajaajiltaniitti garaa guutuun hojjedhaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.7",
            "verseOrgIds": [
              "EPH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "sababiin isaas isin akka Gooftaan tokkoo tokkoo namaatiif garbas taʼu yookaan birmaduu, waan gaarii inni hojjetu kamiif iyyuu gatii kennu ni beektu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.8",
            "verseOrgIds": [
              "EPH.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa gooftota, isinis garboota keessaniif akkasuma godhaa. Isin akka inni isaanii fi isiniif Gooftaa taʼe sun samii irra jiruu fi akka nama wal caalchisuunis isa bira hin jirre waan beektaniif isaan hin doorsisinaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.9",
            "verseOrgIds": [
              "EPH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miʼa Lolaa Kan Waaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaa achi Gooftaa fi humna isaa jabaa sanaan cimaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.10",
            "verseOrgIds": [
              "EPH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haxxummaa diiyaabiloosiin akka mormuu dandeessaniif miʼa lolaa kan Waaqaa guutuu hidhadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.11",
            "verseOrgIds": [
              "EPH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walʼaansoon keenya bulchitoota wajjin, abbootii taayitaa wajjin, humnoota addunyaa dukkanaa kanaa fi humnoota hafuura hamaa iddoo samii keessa jiruu wajjin malee foonii fi dhiiga wajjin mitii.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.12",
            "verseOrgIds": [
              "EPH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu akka yommuu guyyaan hamaan sun dhufutti obsaan dhaabachuu dandeessaniif, waan kana hunda gochuunis akka jabaattanii dhaabattaniif miʼa lolaa kan Waaqaa guutuu hidhadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.13",
            "verseOrgIds": [
              "EPH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa mudhii keessan dhugaan hidhadhaatii, qomee sibiilaa kan qajeelummaas uffadhaatii jabaadhaa dhaabadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.14",
            "verseOrgIds": [
              "EPH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "qophaaʼummaa wangeela nagaa akka kopheetti miilla keessanitti kaaʼadhaa dhaabadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.15",
            "verseOrgIds": [
              "EPH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana hundumaa irrattis gaachana amantii kan xiyya bobaʼaa hamaa sanaa hunda ittiin dhaamsuu dandeessan qabadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.16",
            "verseOrgIds": [
              "EPH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoobii sibiilaa kan fayyinaa kaaʼadhaa; goraadee Hafuuraas qabadhaa; innis dubbii Waaqaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.17",
            "verseOrgIds": [
              "EPH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadhannaa fi waammata gosa hundaa keessatti yeroo hunda Hafuuraan kadhadhaa. Kanas yaadatti qabachaa yeroo hunda dammaqaatii qulqulloota hundaaf jabaadhaa kadhadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.18",
            "verseOrgIds": [
              "EPH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuun afaan saaqqadhu hunda ija jabinaan icciitii wangeelaa akkan beeksisuuf dubbiin akka naa kennamu anaafis kadhadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.19",
            "verseOrgIds": [
              "EPH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wangeelli kunis isuma ani isaaf jedhee ergamaa taʼee foncaan hidhamee dha. Isinis akka ani akkuma narraa eegamutti sodaa malee isa lallabuu dandaʼuuf naa kadhadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.20",
            "verseOrgIds": [
              "EPH.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhaamsa Nagaa Xumuraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xikiqoos obboleessi jaallatamaan, Gooftaattis tajaajilaan amanamaan haala ani keessa jiruu fi maal akka ani hojjechaa jiru akka beektaniif waan hundumaa isinitti hima.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.21",
            "verseOrgIds": [
              "EPH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka isin haala nu keessa jirru beektanii fi akka inni isin jajjabeessuuf, waanuma kanaaf jedhee ani gara keessanitti isa ergeera.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa Abbaa fi Yesuus Kiristoos Gooftaa irraa nagaan, jaalallis amantii wajjin obboloota hundaaf haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
            "verseOrgIds": [
              "EPH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra jaalala hin badneen Gooftaa keenya Yesuus Kiristoosin jaallatan hundaaf ayyaanni haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.24",
            "verseOrgIds": [
              "EPH.6.24"
            ]
          }
        }
      ]
    }
  ],
