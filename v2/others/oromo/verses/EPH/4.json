  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "EPH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhagna Kiristoos Keessatti Tokko Taʼuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani kan Gooftaaf jedhee hidhame, isin waamicha itti waamamtan sanaaf akka malutti akka jiraattan isin nan kadhadha.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
            "verseOrgIds": [
              "EPH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guutumaan guutuutti gad of qabaa; garraamota taʼaa; obsa qabaadhaa; jaalalaanis wal dandaʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hidhaa nagaatiin tokkummaa Hafuuraa eeguuf carraaqaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.3",
            "verseOrgIds": [
              "EPH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma yeroo waamamtanitti gara abdii tokkootti waamamtan sana, dhagna tokkoo fi Hafuura tokkotu jira;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.4",
            "verseOrgIds": [
              "EPH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaa tokko, amantii tokkoo fi cuuphaa tokkotu jira;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.5",
            "verseOrgIds": [
              "EPH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqaa fi Abbaan waan hundaa, inni waan hundaa ol taʼe, kan waan hunda keessatti hojjetuu fi kan waan hunda keessa jiru tokkichatu jira.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akkuma safara kennaa Kiristoositti tokkoo tokkoo keenyaaf ayyaanni kennameera.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
              "EPH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EPH 4:8"
      },
      "items": [
        {
          "text": "\"Inni yommuu ol gubbaa baʼetti,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EPH 4:8"
      },
      "items": [
        {
          "text": "boojuu boojiʼe;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EPH 4:8"
      },
      "items": [
        {
          "text": "namootaafis kennaa kenne\"",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        },
        {
          "text": "jedha.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa, \"Inni ol baʼe\" jechuun isaa dhidhima lafaatti gad buʼe jechuu malee maal jechuu isaa ti?",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.9",
            "verseOrgIds": [
              "EPH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gad buʼe sun isuma waan hunda guutuuf jedhee samiiwwan hundaa olitti ol baʼee dha.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.10",
            "verseOrgIds": [
              "EPH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis namoota tokko tokko ergamoota, kaan raajota, kaan lallabdoota wangeelaa, kaan immoo tiksootaa fi barsiistota taasisee kenne;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.11",
            "verseOrgIds": [
              "EPH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan kanas akka dhagni Kiristoos ijaaramuuf qulqulloota hojii tajaajilaatiif qopheessuuf jedhee godhe;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.12",
            "verseOrgIds": [
              "EPH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis waan hamma hundi keenya tokkummaa amantiitii fi tokkummaa Ilma Waaqaa beekuu bira geenyutti, akka guddannee sadarkaa guutama Kiristoos bira gaʼuudhaan namoota bilchaatoo taanuuf.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.13",
            "verseOrgIds": [
              "EPH.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa nu siʼachi duraa duubatti dadarbatamaa bubbee barsiisa gosa hundaatiin, haxxummaa fi jalʼina marii gowwoomsitootaatiin asii fi achi oofamaa daaʼimman hin taanu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.14",
            "verseOrgIds": [
              "EPH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda kanaa jaalalaan dhugaa dubbachaa gara isa mataa taʼe sanaatti waan hundaan ni guddanna; innis Kiristoos.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.15",
            "verseOrgIds": [
              "EPH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isumaanis kutaaleen dhagnaa guutuun ribuu walitti isaan qabuun hidhamaniiru; yommuu kutaaleen dhagnaa sun hundi hojii isaanii hojjetanittis dhagni sun jaalalaan guddatee of ijaara.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.16",
            "verseOrgIds": [
              "EPH.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akka Ijoollee Ifaatti Jiraachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani waan kana isinitti nan hima; maqaa Gooftaatiinis jabeessee isinitti nan dubbadha; isin siʼachi akka Namoonni Ormaa warri yaadni isaanii faayidaa hin qabne sun jiraatanitti hin jiraatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.17",
            "verseOrgIds": [
              "EPH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii mata jabina isaaniitiinis waan wallaalummaan isaan keessa jiruuf hubannaan isaanii dukkaneeffameera; jireenya Waaqaa keessaas baʼaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.18",
            "verseOrgIds": [
              "EPH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waan qalbiin isaanii hadoodeef hamma xuraaʼummaa gosa hundaa keessa galanitti sassattummaan guutaman.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.19",
            "verseOrgIds": [
              "EPH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin garuu akkasitti Kiristoosin hin barre;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.20",
            "verseOrgIds": [
              "EPH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "isin dhugumaan akkuma dhugaa Yesuus keessa jiru sanaatti waaʼee Kiristoos dhageessanii isumaanis barsiifamtaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.21",
            "verseOrgIds": [
              "EPH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haala jireenya keessan kan durii, eenyummaa keessan moofaa hawwii gowwoomsaa isaatiin xuraaʼe sana dhabamsiisaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
            "verseOrgIds": [
              "EPH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hafuura yaada keessaniitiinis haaromfamaa;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.23",
            "verseOrgIds": [
              "EPH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "namummaa haaraa isa qajeelummaa fi qulqullina dhugaatiin fakkeenya Waaqaatiin uumame sana uffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EPH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu waan nu hundi miseensa walii taaneef tokkoon tokkoon keessan soba of keessaa baastanii ollaa keessanitti dhugaa dubbachuu qabdu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aaraa malee cubbuu hin hojjetinaa;\"",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
        {
          "text": "utuma aartanii jirtaniis aduun hin lixin;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "diiyaabiloosiifis carraa hin kenninaa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.27",
            "verseOrgIds": [
              "EPH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni kanaan dura hataa ture siʼachi hin hatin; qooda kanaa akka warra rakkatan gargaaruu dandaʼuuf harkuma ofii isaatiin waan faayidaa qabu haa hojjetu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.28",
            "verseOrgIds": [
              "EPH.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan nama ijaaruuf gargaaru, akkuma barbaachisaa taʼettis waan warra dhaggeeffataniif ayyaana kennu malee dubbiin hamaan tokko iyyuu afaan keessanii hin baʼin.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.29",
            "verseOrgIds": [
              "EPH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
