  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ACT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Xiimotewos Phaawulosii fi Siilaasitti makame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos ittuma fufee gara Darbeenii fi Lisxiraanii dhaqe; barataan Xiimotewos jedhamu kan haati isaa Yihuudii amantuu taate tokkos achi ture; abbaan isaa garuu nama Giriik ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.1",
            "verseOrgIds": [
              "ACT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni Lisxiraanii fi Iqooniyoon keessa jiraatan waaʼee isaa waan gaarii dubbatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.2",
            "verseOrgIds": [
              "ACT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos akka Xiimotewos isa faana deemu barbaade; kanaaf sababii Yihuudoota naannoo sana jiraataniitiif jedhee dhagna isa qabe; isaan hundinuu akka abbaan Xiimotewos nama Giriik taʼe beeku turaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.3",
            "verseOrgIds": [
              "ACT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkuma magaalaa tokkoo gara magaalaa kaaniitti darbaniin akka namoonni ajajamaniif jedhanii murtii ergamoonnii fi maanguddoonni Yerusaalem keessa jiraatan murteessan sana namootatti himan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu waldoonni kiristaanaa amantiitti cimaa, baayʼinaanis guyyuma guyyaan itti dabalamaa deeman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Mulʼataan Namicha Maqedooniyaa Tokko Arge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Hafuurri Qulqulluun akka isaan biyya Asiyaa keessatti dubbicha hin lallabne isaan dhowwinaan biyya Firiigiyaatii fi Galaatiyaa keessa darban.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Miisiyaa gaʼanittis Biitaaniyaa seenuu yaalan; Hafuurri Yesuus garuu isaanii hin eeyyamne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.7",
            "verseOrgIds": [
              "ACT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf Miisiyaa keessa baʼanii Xirooʼaasitti gad buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.8",
            "verseOrgIds": [
              "ACT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis halkan sana namicha Maqedooniyaa tokko isaa dhaabatee, \"Maqedooniyaa kottuutii nu gargaari\" jedhee isa kadhatu mulʼataan arge.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.9",
            "verseOrgIds": [
              "ACT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus erga Phaawulos mulʼata sana argee booddee, Waaqni akka nu wangeela isaanitti lallabnuuf nu waamuu isaati jennee Maqedooniyaa dhaquuf qophoofnee kaane.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lidiyaan Kiristoositti Amante",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xirooʼaasii dooniidhaan kaanee Saamotraaqeetti fuula deebifannee qajeelle; guyyaa itti aanu immoo Neʼaphoolisitti dabarre.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.11",
            "verseOrgIds": [
              "ACT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achii kaanees Fiiliphisiyuus dhaqne; isheenis magaalaa beekamtuu aanaa Maqedooniyaa kan kolonii mootummaa Roomaa jala turtee dha; nus magaalattii keessa guyyaa muraasa turre.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.12",
            "verseOrgIds": [
              "ACT.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa Sanbataa immoo magaalattii keessaa baanee gara lagaa iddoo akka lafa kadhannaa itti argannu abdanne tokkootti gad buune; teteenyees dubartoota achitti walitti qabamanitti dubbachuu jalqabne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.13",
            "verseOrgIds": [
              "ACT.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra nu dhaggeeffachaa turan keessaas dubartii Liidiyaa jedhamtu tokkotu ture; isheen daldaltuu wayyaa dhiilgee kan magaalaa Tiyaatiraatii dhuftee, Waaqas waaqeffattu turte. Gooftaan akka isheen waan Phaawulos dubbatu qalbeeffattuuf qalbii ishee baneef.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.14",
            "verseOrgIds": [
              "ACT.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis erga warra mana ishee jiraatan wajjin cuuphamtee booddee, \"Yoo akka nama Gooftaatti amanu tokkootti na ilaaltan, kottaatii mana koo turaa\" jettee nu waamte; jabeessitees nu kadhatte.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulosii fi Siilaas Mana Hidhaa Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko utuu iddoo itti kadhatan dhaqnuu xomboree hafuura waa himsiisuun guutamte tokkoon walitti dhufne; isheen waa namaa himuun gooftota isheetiif maallaqa guddaa galchiti turte.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.16",
            "verseOrgIds": [
              "ACT.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis, \"Namoonni kunneen tajaajiltoota Waaqa Waan Hundaa Olii kanneen karaa fayyinaa isinitti himanii dha\" jettee iyyaa Phaawulosii fi nu duukaa buute.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.17",
            "verseOrgIds": [
              "ACT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kanas guyyaa hedduu itti fufte; Phaawulos garuu waan akka malee aareef itti garagalee hafuura sanaan, \"Ani akka ati ishee keessaa baatu maqaa Yesuus Kiristoosiitiin sin ajaja\" jedhe; hafuurichis yommusuma ishee keessaa baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftonni xomboree sanaas yommuu akka abdiin galii isaanii citte hubatanitti Phaawulosii fi Siilaasin qabanii fuula abbootii taayitaa duratti dhiʼeessuuf jedhanii lafa irra harkisaa iddoo gabaatti isaan geessan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.19",
            "verseOrgIds": [
              "ACT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuula qondaaltotaa durattis isaan dhiʼeessanii akkana jedhan; \"Namoonni kunneen Yihuudoota; magaalaa keenyas jeequutti jiru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.20",
            "verseOrgIds": [
              "ACT.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis duudhaa fudhachuun yookaan itti buluun nuu warra Roomaatiif hin eeyyamamne barsiisu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.21",
            "verseOrgIds": [
              "ACT.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonnis tokkummaadhaan Phaawulosii fi Siilaasitti kaʼan; qondaaltonni sunis akka wayyaan isaan irraa baafamee uleedhaan tumaman ajajan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.22",
            "verseOrgIds": [
              "ACT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarris erga akka malee garafamanii booddee mana hidhaatti darbataman; eegduun mana hidhaa sanaas akka jabeessee isaan eegu ajajame.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.23",
            "verseOrgIds": [
              "ACT.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis ajaja kana fudhatee gola mana hidhaa keessa isaan galche; miilla isaaniis jirma gidduu galchee hidhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara halkan walakkaatti Phaawulosii fi Siilaas kadhachaa, faarfannaadhaanis Waaqa galateeffachaa turan; hidhamtoonni kaanis isaan dhaggeeffachaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.25",
            "verseOrgIds": [
              "ACT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma tasaa sochiin lafaa cimaan tokko taʼe; kanaanis hundeen mana hidhaa sanaa raafame; yommusuma balballi hundinuu ni baname; foncaan nama hundaas ni hiikame.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.26",
            "verseOrgIds": [
              "ACT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegduun mana hidhaa sunis yommuu dammaqee akka balballi mana hidhaa baname argetti waan hidhamtoonni baʼanii badan seʼee of ajjeesuuf goraadee isaa luqqifate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.27",
            "verseOrgIds": [
              "ACT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos garuu sagalee guddaadhaan iyyee, \"Nu hundi asuma jirraatii of hin miidhin\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegduun sunis ibsaa fichisiifatee fiigaa ol gale; sodaadhaanis hollachaa Phaawulosii fi Siilaas duratti kufe;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.29",
            "verseOrgIds": [
              "ACT.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "gad isaan baasees, \"Yaa Gooftota ko, ani akka fayyuuf maal gochuun qaba?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis deebisanii, \"Gooftaa Yesuusitti amani; ati ni fayyitaa; warri mana kee jiraatanis ni fayyuutii\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.31",
            "verseOrgIds": [
              "ACT.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbii Gooftaas isaa fi warra mana isaa jiraatan hundatti himan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.32",
            "verseOrgIds": [
              "ACT.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegduun mana hidhaa sunis saʼaatuma halkanii sana isaan fuudhee madaa isaanii dhiqeef; yommusumas innii fi maatiin isaa hundinuu cuuphaman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.33",
            "verseOrgIds": [
              "ACT.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegduun sunis mana isaatti isaan geessee nyaata dhiʼeesseef; sababii maatiin isaa hundi gara Waaqa amanuutti dhufaniif warri mana isaa jiraatan hundi akka malee gammadan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu bariʼetti qondaaltonni sun, \"Namoota sana gad dhiisi\" jedhanii eegduu mana hidhaa sanatti poolisii ergan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegduun sunis, \"Qondaaltonni akka isin hiikamtan ajajaniiru; kanaaf amma deemuu ni dandeessu; nagaan galaa\" jedhee Phaawulositti hime.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
              "ACT.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos garuu poolisoota sanaan akkana jedhe; \"Isaan utuma nu lammiiwwan Roomaa taanee jirruu, murtii tokko malee nu garafanii mana hidhaatti nu darbatan; amma immoo dhoksaan nu baasuu barbaaduu? Kun hin taʼu! Isaanumti mataan isaanii dhufanii nu haa baasanii!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poolisoonnis dubbii kana qondaaltotatti himan; qondaaltonnis yommuu akka Phaawulosii fi Siilaas lammiiwwan Roomaa taʼan dhagaʼanitti ni rifatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.38",
            "verseOrgIds": [
              "ACT.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dhufanii dhiifama isaan gaafatan; mana hidhaatii isaan baasanii akka isaan magaalattii keessaa baʼanii deemaniif isaan kadhatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.39",
            "verseOrgIds": [
              "ACT.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosii fi Siilaas mana hidhaatii baʼanii mana Liidiyaa dhaqan; isaanis yommuu obboloota arganitti isaan jajjabeessan; achiis baʼanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.40",
            "verseOrgIds": [
              "ACT.16.40"
            ]
          }
        }
      ]
    }
  ],
