  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ACT 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis ajjeefamuu Isxifaanos irratti namootaan walii galee ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "ACT 8:1"
      },
      "items": [
        {
          "text": "Ariʼatama Waldaa Kiristaanaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 8:1"
      },
      "items": [
        {
          "text": "Guyyuma sana waldaa Kiristaanaa ishee Yerusaalem jirtutti ariʼatamni guddaan kaʼe; ergamoota malee warri kaan hundinuu biyya Yihuudaatii fi Samaariyaa hunda keessa bibittinnaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Waaqa sodaatanis Isxifaanosin awwaalan; booʼicha guddaas booʼaniif.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.2",
            "verseOrgIds": [
              "ACT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol garuu waldaa kiristaanaa balleessuu jalqabe; innis mana tokko irraa gara mana biraa dhaqee dhiiraa fi dubartii lafa irra harkisee mana hidhaatti galchaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fiiliphoos Samaariyaa Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri bittinnaaʼan sun lafa dhaqan hundatti dubbii sana lallaban.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.4",
            "verseOrgIds": [
              "ACT.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiiliphoosis gara magaalaa Samaariyaa tokkootti gad buʼee achitti Kiristoos lallabe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.5",
            "verseOrgIds": [
              "ACT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni sunis yommuu waan Fiiliphoos dubbatu dhagaʼanii dinqii inni hojjetu arganitti hundi isaanii qalbeeffatanii isa dhagaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.6",
            "verseOrgIds": [
              "ACT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri xuraaʼaanis sagalee guddaan iyyee nama hedduu keessaa baʼe; warri laamshaʼanii fi warri naafatan baayʼeenis ni fayyan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.7",
            "verseOrgIds": [
              "ACT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafis gammachuu guddaatu magaalaa sana keessatti taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Simoon Falfalticha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo sanaan dura namichi Simoon jedhamu tokko magaalaa sana keessatti falfala hojjetee namoota Samaariyaa hunda dinqisiisaa ture; innis akka waan nama guddaa taʼeetti of hedaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.9",
            "verseOrgIds": [
              "ACT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni hundinuu xinnaa guddaan qalbii isaanii gara isaatti deebifatanii, \"Namichi kun humna Waaqaa isa 'humna guddaa' jedhamu sanaa dha\" jedhanii isa saadan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.10",
            "verseOrgIds": [
              "ACT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni sunis sababii inni yeroo dheeraa falfala isaatiin isaan dinqisiiseef qalbii isaanii gara isaatti deebifatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.11",
            "verseOrgIds": [
              "ACT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yommuu Fiiliphoos wangeela waaʼee mootummaa Waaqaatii fi maqaa Yesuus Kiristoos lallabetti amananii dhiiraa dubartiin cuuphaman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.12",
            "verseOrgIds": [
              "ACT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoon mataan isaa iyyuu amanee cuuphame. Innis mallattoo fi dinqii arge sana dinqifachaa Fiiliphoos wajjin deeme.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamoonni Yerusaalem turan akka warri Samaariyaa dubbii Waaqaa fudhatan dhagaʼanii Phexrosii fi Yohannisin isaanitti ergan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.14",
            "verseOrgIds": [
              "ACT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamoonni sunis yommuu achi gaʼanitti akka isaan Hafuura Qulqulluu argataniif ni kadhataniif;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.15",
            "verseOrgIds": [
              "ACT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuuri Qulqulluun isaan keessaa nama tokko irra illee hin buune tureetii; isaan maqaa Gooftaa Yesuus qofaan cuuphamanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.16",
            "verseOrgIds": [
              "ACT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phexrosii fi Yohannis harka isaanii jara sana irra kakaaʼan; isaanis Hafuura Qulqulluu argatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.17",
            "verseOrgIds": [
              "ACT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoon falfaltichis akka yeroo ergamoonni harka isaanii nama irra kaaʼan Hafuurri Qulqulluun namaa kennamu arginaan ergamootaaf horii kennee,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.18",
            "verseOrgIds": [
              "ACT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akka namni ani harka irra kaaʼu hundi Hafuura Qulqulluu argatuuf dandeettii kana anaaf illee kennaa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.19",
            "verseOrgIds": [
              "ACT.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phexros garuu akkana jedhee deebiseef; \"Sababii ati kennaa Waaqaa waan horiin bitachuu dandeessu seeteef horiin kee suma wajjin haa badu!",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.20",
            "verseOrgIds": [
              "ACT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garaan kee fuula Waaqaa duratti waan qajeelaa hin taʼiniif ati tajaajila kana keessatti qooda yookaan carraa hin qabdu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.21",
            "verseOrgIds": [
              "ACT.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf hammina kee kana irraa deebiʼiitii gooftaa kadhadhu; inni yaada garaa keetii kana siif dhiisa taʼaatii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.22",
            "verseOrgIds": [
              "ACT.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka ati yaada hadhaaʼaan guutamtee fi akka ati garbicha cubbuu taate nan arga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.23",
            "verseOrgIds": [
              "ACT.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoonis, \"Akka wanni isin jettan kun tokko iyyuu narra hin geenyeef Gooftaa naa kadhadhaa\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
            "verseOrgIds": [
              "ACT.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phexrosii fi Yohannis erga dhugaa baʼanii dubbii Gooftaas labsanii booddee gandoota Samaariyaa hedduu keessatti wangeela lallabaa Yerusaalemitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.25",
            "verseOrgIds": [
              "ACT.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fiiliphoosii fi Namicha Itoophiyaa Tokko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan Gooftaa tokko Fiiliphoosiin, \"Kaʼiitii karaa Kibbaatiin gara daandii Yerusaalemii baʼee Gaazaatti gad buʼu sanaa dhaqi\" jedhe; daandiin sunis daandii gammoojjii ti.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.26",
            "verseOrgIds": [
              "ACT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis kaʼee deeme; karaa isaa irrattis xuʼaashii Itoophiyaa tokko jechuunis qondaalticha Kandakee mootittii saba Itoophiyaa kan qabeenya ishee hunda irratti itti gaafatamaa taʼe arge; qondaalli sun sagaduuf jedhee Yerusaalem dhaqee ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.27",
            "verseOrgIds": [
              "ACT.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yeroo biyya isaatti deebiʼu gaarii isaa irra taaʼee kitaaba Isaayyaas raajichaa dubbifachaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.28",
            "verseOrgIds": [
              "ACT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri Qulqulluunis Fiiliphoosiin, \"Dhaqiitii gaarii sanatti dhiʼaadhu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.29",
            "verseOrgIds": [
              "ACT.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiiliphoosis gaarii sanatti fiigee utuu namichi sun kitaaba Isaayyaas raajichaa dubbifatuu dhagaʼee, \"Ati waan dubbiftu kana ni hubattaa?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.30",
            "verseOrgIds": [
              "ACT.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichis, \"Yoo namni naa hin ibsin ani akkamiin hubachuu dandaʼa?\" jedhe. Innis akka Fiiliphoos ol baʼee isa bira taaʼuuf waammate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.31",
            "verseOrgIds": [
              "ACT.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutaan kitaabaa kan xuʼaashiin sun dubbisaa ture isa kana:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 8:32"
      },
      "items": [
        {
          "text": "\"Inni akkuma hoolaa iddoo qalmaatti geeffamee,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 8:32"
      },
      "items": [
        {
          "text": "yookaan akkuma ilmoo hoolaa",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 8:32"
      },
      "items": [
        {
          "text": "kan fuula nama rifeensa irraa murmuruu duratti calʼisuu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 8:32"
      },
      "items": [
        {
          "text": "akkasuma afaan isaa hin saaqqanne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni cunqurfamuu isaatiin murtii qajeelaa dhowwatame;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 8:33"
      },
      "items": [
        {
          "text": "eenyutu waaʼee sanyii isaa dubbachuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 8:33"
      },
      "items": [
        {
          "text": "Jireenyi isaa lafa irraa fudhatameeraatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xuʼaashiin sunis Fiiliphoosiin, \"Raajiin sun waaʼee eenyuu dubbata? Waaʼee mataa isaa moo waaʼee nama biraa ti? Maaloo mee natti himi!\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.34",
            "verseOrgIds": [
              "ACT.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiiliphoosis kutaadhuma kitaabaa sanaan afaan saaqatee oduu gaarii waaʼee Yesuus isatti hime.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.35",
            "verseOrgIds": [
              "ACT.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis utuu karaa deemanuu bishaanitti baʼan; xuʼaashiin sunis, \"Kunoo bishaan as jira; yoos maaltu cuuphamuu na dhowwa ree?\" jedheen. [",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.36",
            "verseOrgIds": [
              "ACT.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiiliphoosis, \"Ati yoo garaa kee guutuun amante cuuphamuu ni dandeessa\" jedheen. Namichis deebisee, \"Akka Yesuus Kiristoos ilma Waaqaa taʼe ani nan amana\" jedhe.]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka gaariin sun dhaabatu ajaje; isaan lamaanuu dhaqanii bishaan seenan; Fiiliphoosis isa cuuphe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.38",
            "verseOrgIds": [
              "ACT.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isaan bishaan keessaa baʼanittis Hafuurri Gooftaa Fiiliphoosin fudhate; xuʼaashiin sunis ergasii isa hin argine; garuu gammadaa karaa isaa itti fufe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.39",
            "verseOrgIds": [
              "ACT.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiiliphoos immoo Azooxoonitti argame; innis hamma Qiisaariyaa gaʼutti magaalaawwan hunda keessatti wangeela lallabaa darbe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.40",
            "verseOrgIds": [
              "ACT.8.40"
            ]
          }
        }
      ]
    }
  ],
