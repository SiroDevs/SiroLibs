  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "EXO 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eegumsa Qabeenyaaf Godhamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni tokko yoo sangaa yookaan hoolaa hatee qalate yookaan gurgurate, qooda qotiyyoo tokkoo sangaa shan, qooda hoolaa tokkoo immoo hoolaa afur haa baasu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hattuun tokko utuu cabsee seenuu yoo qabamee tumamee kanumaan duʼe, namichi isa ajjeese sun dhiiga isaatti yakkaan hin gaafatamu;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.2",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "garuu yoo wanni kun erga aduun baatee taʼe, namichi dhiiga sanatti yakkaan ni gaafatama.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 22:3"
      },
      "items": [
        {
          "text": "\"Hattuun waan hate haa deebisu; homaa hin qabu yoo taʼe garuu hanna isaatiif gatii baasuudhaaf haa gurguramu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Horiin hatame sun sangaa yookaan harree yookaan hoolaa taanaan yoo utuu lubbuun jiruu harka isaatti argame hattuun sun dachaa baasuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni tokko yoo utuu lafa qotiisaa yookaan dhaabaa wayinii keessa horii tikfatuu horii isaa gad lakkisee horiin sun dhaqee kaloo nama biraa dheede, inni lafa qotiisaa ofii isaa irraa yookaan dhaabaa wayinii ofii isaa irraa kan waan hunda caalu iddoo haa buusuuf.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yoo ibiddi kaʼee daggala seenee akkasiin midhaan tuulame yookaan midhaan dhaabatu yookaan lafa qotiisaa gube, namichi ibidda qabsiise sun gatii baasuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni tokko yoo maallaqa yookaan miʼa imaanaa namatti kennatee, wanni sun mana namichaatii hatamee hattuun sun qabame, hattichi dachaa kaffaluu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.7",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo hattuun sun hin argamin garuu abbaan mana sanaa akka miʼa nama kaanii tuqee fi akka hin tuqin mirkaneessuuf fuula abbootii murtii duratti haa dhiʼeeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko yoo qotiyyoo, harree, hoolaa, uffata yookaan miʼa bade tokko miliqsee namni tokko dhufee, 'Kun kan koo ti' jedhe, falmiin isaanii fuula abbootii murtii duratti haa dhiʼeeffamu. Namichi abbootiin murtii itti muran sunis ollaa isaatiif harka lama haa baasu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yoo namni tokko ollaa isaatiif harree, qotiyyoo, hoolaa yookaan horii biraa imaanaa kennatee horiin suni utuu namni hin argin duʼe yookaan miidhame yookaan hatame,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.10",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "namichi sun akka qabeenya ollaa isaa hin tuqin mirkaneessuuf fuula",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.22.11",
                "verseOrgIds": [
                  "EXO.22.10"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti haa kakatu; abbaan qabeenyaa sunis kakuu kana fudhachuu qaba; gatiis hin gaafatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo horiin sun isa jalaa hatamee jiraate garuu namichi abbaa horii sanaatiif baasuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.12",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo horii sana bineensatu nyaate taʼe immoo akka ragaa taʼuuf waan bineensa irraa hafe haa dhiʼeessu malee horii nyaatame sanaaf gatii hin baasin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni tokko yoo ollaa isaa irraa horii ergifatee horiin sun iddoo abbaan horii hin jirretti miidhame yookaan duʼe, namichi ergifate sun gatii haa baasu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo abbaan horii sanaa achi jiraate garuu namichi ergifate sun gatii baasuu hin qabu. Yoo horiin sun kireeffamee jiraate immoo maallaqni baafame sun kiraa horii duʼe sanaa haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Itti Gaafatama Hawaasummaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni tokko yoo durba hin kaadhimatamin gowwoomsee ishee wajjin ciise, inni gabbara misirrittiif malu baaseefii ishee haa fuudhu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo abbaan ishee intalattii namichaaf kennuu dide immoo namichi sun gabbara durbaaf malu baasuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati akka dubartiin falfaltuun lubbuun jiraattu hin eeyyamin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni horii wajjin ciisu kam iyyuu ajjeefamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.19",
            "verseOrgIds": [
              "EXO.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.22.20",
                "verseOrgIds": [
                  "EXO.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "tokkichaaf malee Waaqa biraatiif aarsaa dhiʼeessu galaafatamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isinis waan biyya Gibxii keessatti alagoota turtaniif alagaatti daba hin hojjetinaa; hin cunqursinaas.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haadha hiyyeessaatii fi ijoollee abbaan irraa duʼe hin hacuucinaa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isin isaan miitanii isaan immoo natti booʼan ani dhugumaan booʼicha isaanii nan dhagaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aariin koo ni bobaʼa; anis goraadeedhaanan isin fixa; niitonni keessan haadhota hiyyeessaa taʼu; ijoolleen keessanis kanneen abbaa hin qabne taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati yoo saba koo keessaa hiyyeessa si bira jiraatu tokkoof maallaqa liqeessite, akka nama hiiqii argachuuf kennuu hin taʼin; dhalas hin gaafatin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati yoo wayyaa nama biraa qabdii qabatte, utuu aduun hin dhiʼin deebisiif;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "wanni inni dhagna isaatti uffatu wayuma sanaatii. Wanni inni uffatee rafu biraa maali? Ani waanan gara laafessa taʼeef, yoo inni natti ol iyyate nan dhagaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waaqa hin arrabsin; bulchaa saba keetiis hin abaarin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mataa midhaan keetiitii fi dhangalaʼaa wayinii keetii irraa aarsaa dhiʼeessuu hin tursin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 22:29"
      },
      "items": [
        {
          "text": "\"Ilmaan kee keessaas hangafa naa kennuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loon keetii fi hoolota kee akkanuma godhi. Isaanis bultii torba haadha isaanii bira haa turan; guyyaa saddeettaffaatti garuu naa kenni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin saba koo qulqulluu ni taatu. Kanaafuu foon horii bineensi alatti cabsee kam iyyuu hin nyaatinaa; foon akkanaa saree dura buusaa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
      ]
    }
  ],
