    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bishaan Kattaa Keessaa Burqe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waldaan ijoollee Israaʼel hundi akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.1",
                "verseOrgIds": [
                  "EXO.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ajajetti Gammoojjii Siiniitii kaʼanii iddoo tokko irraa gara iddoo biraatti darbaa dhaqanii Refiidiim qubatan. Garuu sabni sun bishaan dhugaatii hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isaan, \"Bishaan dhugnu nuu kenni\" jedhanii Musee lolan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 17:2"
      },
      "items": [
        {
          "text": "Museen immoo deebisee, \"Isin maaliif na loltu?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.2",
                "verseOrgIds": [
                  "EXO.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "maaliif qortu?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarris bishaan dheebotanii Museetti guunguman; akkanas jedhan; \"Ati maaliif akka nu, ijoolleen keenyaa fi horiin keenya dheebuun dhumnuuf biyya Gibxiitii nu baafte?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.3",
            "verseOrgIds": [
              "EXO.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Museen gara",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.4",
                "verseOrgIds": [
                  "EXO.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "iyyee, \"Ani saba kana maal godha? Isaan dhagaan na tumuuf xinnumatu hafe\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.5",
                "verseOrgIds": [
                  "EXO.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "immoo akkana jedhee Museef deebii kenne; \"Saba kana dura darbii deemi. Maanguddoota Israaʼel keessaa tokko tokko of faana fudhadhuutii ulee ittiin laga Abbayyaa dhoofte sana harkatti qabadhuu deemi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo ani kattaa Kooreeb sana bira fuula kee dura achi nan dhaabadha; akka namoonni bishaan dhuganiif ati kattaa sana dhaʼi; bishaanis isa keessaa ni baʼa.\" Kanaafuu Museen fuula maanguddoota Israaʼel duratti akkasuma godhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Israaʼeloonni lola kaasanii fi sababii isaan, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.7",
                "verseOrgIds": [
                  "EXO.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nu wajjin jira moo hin jiru?\" jechuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.7",
                "verseOrgIds": [
                  "EXO.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "qoraniif Museen iddoo sana Maasaahii fi Mariibaa jedhee moggaase.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amaaleqoonni Moʼataman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaaleqoonni dhufanii Refiidiimitti Israaʼeloota lolan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis Iyyaasuudhaan, \"Namoota keenya keessaa muraasa filadhuutii dhaqii Amaaleqoota loli. Ani bor ulee Waaqaa harka kootti qabadhee fiixee gaara irra nan dhaabadha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.9",
            "verseOrgIds": [
              "EXO.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Museen, Aroonii fi Huuri fiixee gaaratti ol baʼanitti, Iyyaasuun akkuma Museen ajajetti Amaaleqoota lola ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.10",
            "verseOrgIds": [
              "EXO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Museen harka isaa ol qabatutti Israaʼeloonni ni moʼatu turan; yeroo inni harka isaa gad buufatu immoo Amaaleqoonni ni moʼatu turan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.11",
            "verseOrgIds": [
              "EXO.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis yeroo harki Musee dadhabaa deemetti dhagaa tokko fuudhanii isa jala kaaʼan; innis irra taaʼe. Aroonii fi Huuri inni tokko garanaan inni kaan immoo garasiin goranii akka harki isaa hamma aduun dhiitutti gad hin deebineef ol qabaniif.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.12",
            "verseOrgIds": [
              "EXO.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin Iyyaasuun loltoota Amaaleqootaa goraadeedhaan moʼate.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.13",
            "verseOrgIds": [
              "EXO.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.14",
                "verseOrgIds": [
                  "EXO.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe; \"Akka wanni kun yaadatamuuf kitaabatti barreessi; Iyyaasuun waan kana dhagaʼuu isaa mirkaneessi; ani guutumaan guutuutti yaadannoo Amaaleqootaa samii jalaa nan balleessaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis iddoo aarsaa ijaaree, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.15",
                "verseOrgIds": [
                  "EXO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Faajjii koo ti\" jedhee moggaase.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Harki gara teessoo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.16",
                "verseOrgIds": [
                  "EXO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ol kaafameera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.17.16",
                "verseOrgIds": [
                  "EXO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "dhaloota tokkoo gara dhaloota kaaniitti Amaaleqoota ni lola\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
      ]
    }
  ],
