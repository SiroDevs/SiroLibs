        "vid": "EXO 39:40"
      },
      "items": [
        {
          "text": "golgaa karra oobdii sanaa, funyoowwanii fi qofoowwan oobdii,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
