        },
        {
          "text": "taabota kakuu seeraa, danqaraa isaatii fi teessoo araaraa wajjin;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        }
