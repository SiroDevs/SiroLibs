          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas quncee talbaa qalʼaa isaatiin marata mataa, quncee talbaatiin gonfoo, quncee talbaa kan qalʼifamee foʼameen immoo uffata wayyaa jalaa hojjetaniif.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
              "EXO.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabbannis quncee talbaa kan qalʼifamee foʼamee fi kirrii bifa cuquliisaa, dhiilgee fi bildiimaan faayeffame akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.39.29",
                "verseOrgIds": [
                  "EXO.39.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee ajajetti hojjetame.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        }
      ]
    },
    {
