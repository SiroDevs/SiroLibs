      "attrs": {
        "style": "li1",
        "vid": "EXO 39:33"
      },
      "items": [
        {
          "text": "dunkaanaa fi miʼa isaa hunda, hokkoowwan isaa, tuggeewwan isaa, dagaleewwan isaa, utuboota isaatii fi miillawwan isaa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        }
