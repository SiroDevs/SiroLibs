          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "irra buusa kalʼee korbeessa hoolaa kan halluu diimaa cuuphame, irra buusa gogaa duugameetii fi golgaa daʼeessu;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        }
