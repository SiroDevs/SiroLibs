              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin hojiin dunkaana qulqulluu kan dunkaana wal gaʼii hundi xumurame. Israaʼeloonnis akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.39.32",
                "verseOrgIds": [
                  "EXO.39.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee ajajetti waan hunda hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dunkaana qulqulluu sana Museetti fidan:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
