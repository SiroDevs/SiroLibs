          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroonii fi ilmaan isaatiif immoo kittaa quncee talbaa kan qalʼifamee foʼameen dhoofsisanii hojjetan;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
            "verseOrgIds": [
              "EXO.39.27"
            ]
          }
        },
        {
          "name": "verse",
