        "style": "s1"
      },
      "items": [
        {
          "text": "Uffata Lubummaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis uffata kirrii bifa cuquliisaa, dhiilgee fi bildiimaan dhaʼame kan iddoo qulqulluu keessa tajaajiluuf fayyadu hojjetan. Akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.39.1",
                "verseOrgIds": [
                  "EXO.39.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee ajajettis uffata qulqulluu Arooniif hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Efuudii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
