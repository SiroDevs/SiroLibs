              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "iddoo aarsaa kan warqee irraa hojjetame, zayitii ittiin diban, ixaana urgaaʼu, golgaa balbala dunkaanaa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.38",
