              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "iddoo aarsaa kan naasii irraa hojjetame, gingilchaa isaa kan naasii irraa hojjetame wajjin,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
