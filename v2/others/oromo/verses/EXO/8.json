          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis ergasii Faraʼoon biraa baʼee",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.30",
                "verseOrgIds": [
                  "EXO.8.26"
                ]
              }
            }
          ]
        },
        {
          "text": "kadhate;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.31",
                "verseOrgIds": [
                  "EXO.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": "akkuma Museen isa kadhate sana godhe; tisiisni sunis Faraʼoonin, qondaaltota isaatii fi saba isaa gad dhiisee deeme; tisiisni tokko iyyuu hin hafne.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraʼoon garuu ammas mata jabeessa taʼe; saba sanas gad dhiisuu dide.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.32",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        }
      ]
