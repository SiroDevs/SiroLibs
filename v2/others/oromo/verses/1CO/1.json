  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1CO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos isa akka ergamaa Kiristoos Yesuus taʼuuf fedhii Waaqaatiin waamamee fi obboleessa keenya Soosteenes irraa,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara waldaa Waaqaa ishee Qorontos keessa jirtuutti, gara warra Kiristoos Yesuusiin qulqulleeffamanii fi warra lafa hundaa kanneen maqaa Gooftaa keenya Yesuus Kiristoos isa Gooftaa isaaniitii fi Gooftaa keenyas taʼe sanaa waammatan hunda wajjin qulqulloota taʼuuf waamamaniitti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayyaannii fi nagaan Abbaa keenya Waaqaa fi Yesuus Kiristoos Gooftaa irraa isiniif haa taʼu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Galata Galchuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yeroo hunda ayyaana Waaqaa isa Kiristoos Yesuusiin isinii kennameef waaʼee keessaniif Waaqa nan galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis karaa hundaan jechuunis dubbii fi beekumsa hundaan isaan badhaataniirtu;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wanti nu waaʼee Kiristoos dhugaa baane sun isin gidduutti mirkaneeffameeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.6",
            "verseOrgIds": [
              "1CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu utuu mulʼachuu Gooftaa keenya Yesuus Kiristoos eeggachaa jirtanuu kennaan hafuuraa tokko iyyuu isin jalaa hin hirʼatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isin guyyaa Gooftaa keenya Yesuus Kiristoositti warra mudaa hin qabne taataniifis inni hamma dhumaatti jabeessee isin eega.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
            "verseOrgIds": [
              "1CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni gara tokkummaa Ilma isaa Gooftaa keenya Yesuus Kiristoositti isin waame sun amanamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gargar Baʼuu Waldaa Kiristaanaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota, ani akka isin gidduu gargar baʼuun hin jiraannee fi akka qalbii fi yaada tokko qabaattanii hundi keessan walii galtaniif maqaa Gooftaa keenya Yesuus Kiristoosiin isin kadhadha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota ko, akka isin gidduu lolli jiru warri mana Kiloʼee jiraatan tokko tokko natti himaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanti ani jedhus kana: Isin keessaa namni tokko, \"Ani kan Phaawulos\" jedha; inni kaan, \"Ani kan Apholoos\" jedha; kaanis, \"Ani kan Keefaa ti\" jedha; kaan immoo, \"Ani kan Kiristoos\" jedha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiristoos gargar qoodameeraa? Phaawulositu isinii fannifame ree? Yookaan maqaa Phaawulosiin cuuphamtanii?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani Kiriisphoosii fi Gaayoosin malee isin keessaa nama tokko illee waan hin cuuphiniif Waaqa nan galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf namni akka isin maqaa kootiin cuuphamtan dubbachuu dandaʼu tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeyyee, ani warra mana Isxiifaanaas jiraatanis akkasuma cuupheera; sanaan alatti nama biraa tokko illee cuuphuu koo hin yaadadhu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiristoos akka ani wangeela lallabuuf malee akka ani cuuphuuf na hin ergineetii; anis akka fannoon Kiristoos humna hin dhabneef dubbii ogummaa namaatiin hin lallabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiristoos Ogummaa fi Humna Waaqaa ti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin fannoo warra baduuf jiraniif gowwummaadhaatii; nu warra fayyinuuf garuu humna Waaqaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 1:19"
      },
      "items": [
        {
          "text": "\"Ani ogummaa ogeeyyii nan balleessa;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 1:19"
      },
      "items": [
        {
          "text": "hubannaa hubattootaas nan fashaleessa\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1CO 1:19"
      },
      "items": [
        {
          "text": "jedhamee barreeffameera.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni ogeessi eessa jira? Hayyuun eessa jira? Falaasamaan bara kanaa eessa jira? Waaqni ogummaa addunyaa kanaa gowwummaa hin goonee ree?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.20",
            "verseOrgIds": [
              "1CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii ogummaa Waaqaatiin addunyaan karaa ogummaa isheetiin Waaqa waan hin beekiniif, Waaqni gowwummaa lallabaatiin warra amanan fayyisuu jaallate.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni mallattoo fedhu; Giriikonni immoo ogummaa barbaadu;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.22",
            "verseOrgIds": [
              "1CO.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nu garuu Kiristoos isa fannifame sana lallabna; innis Yihuudootatti gufuu dha; Namoota Ormaatiif immoo gowwummaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.23",
            "verseOrgIds": [
              "1CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra waamamaniif garuu Yihuudootaafis taʼu Giriikotaaf Kiristoos humna Waaqaatii fi ogummaa Waaqaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.24",
            "verseOrgIds": [
              "1CO.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gowwummaan Waaqaa ogummaa namaa caalaa ogeessaatii; dadhabbiin Waaqaas jabina namaa irra jabaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota, isin yeroo waamamtanitti maal akka turtan yaadadhaa. Akka ilaalcha namaatti baayʼeen keessan ogeeyyii hin turre; baayʼeen keessanis beekamoo hin turre; baayʼeen keessan immoo sanyii warra gurguddaa irraa hin dhalanne.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.26",
            "verseOrgIds": [
              "1CO.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni garuu ogeeyyii qaanessuuf jedhee waan addunyaa irratti gowwaa taʼe filate; Waaqni warra jajjabeeyyii qaanessuuf jedhee waan addunyaa irratti dadhabaa taʼe filate.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.27",
            "verseOrgIds": [
              "1CO.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni waan jiru waan hin jirre gochuuf, waan addunyaa kana irratti gad aanaa fi tuffatamaa taʼe, waan iddoo hin qabnes filate;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.28",
            "verseOrgIds": [
              "1CO.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka eenyu iyyuu isa duratti of hin jajneef.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.29",
            "verseOrgIds": [
