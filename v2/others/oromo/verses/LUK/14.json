        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Soogiddi gaarii dha; garuu yoo inni miʼaa isaa dhabe, miʼaan isaa akkamiin deebifamuu dandaʼa?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.34",
                "verseOrgIds": [
                  "LUK.14.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.34",
            "verseOrgIds": [
              "LUK.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inni biyyoof yookaan tuulaa kosiitiif faayidaa hin qabu; inni gad gatama.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
                  "LUK.14.35"
                ]
              }
            }
          ]
        }
