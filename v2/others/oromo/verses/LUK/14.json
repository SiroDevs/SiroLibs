              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mee isin keessaa namni tokko gamoo ijaarrachuu barbaada haa jennuu; namichi sun gamoo sana ijaaree fixuuf horii gaʼaa qabaachuu fi qabaachuu baachuu isaa beekuuf duraan dursee taaʼee gatii isaa hin herregatuu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.28",
                "verseOrgIds": [
                  "LUK.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.28",
            "verseOrgIds": [
              "LUK.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo kanaa achii yommuu inni hundee kaaʼee fixuu dadhabutti, namoonni argan hundi itti qoosu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.29",
                "verseOrgIds": [
                  "LUK.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.29",
            "verseOrgIds": [
              "LUK.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaanis, 'Namichi kun ijaaruu jalqabee fixuu dadhabe' jedhu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.30",
                "verseOrgIds": [
                  "LUK.14.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 14:31"
