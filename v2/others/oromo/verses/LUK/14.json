          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namni gurra dhagaʼu qabu kam iyyuu haa dhagaʼu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
                  "LUK.14.35"
                ]
