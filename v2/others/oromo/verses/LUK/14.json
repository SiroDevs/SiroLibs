  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LUK 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Mana Fariisicha Tokkootti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa Sanbataa tokko yommuu Yesuus buddeena nyaachuuf mana Fariisicha beekamaa tokkoo dhaqetti, namoonni xiyyeeffatanii isa ilaalaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi dhagni isaa dhiitaʼe tokkos fuula isaa dura ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.2",
            "verseOrgIds": [
              "LUK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Guyyaa Sanbataatiin nama fayyisuun ni eeyyamama moo hin eeyyamamu?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.3",
                "verseOrgIds": [
                  "LUK.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee Fariisotaa fi hayyoota seeraa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu ni calʼisan; innis namicha harkaan qaqqabee fayyisee gad isa lakkise.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.4",
            "verseOrgIds": [
              "LUK.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin keessaa namni tokko yoo ilma yookaan qotiyyoo guyyaa Sanbataatiin boolla keessa buʼe qabaate, inni yeruma sana harkisee boolla keessaa hin baasuu?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.5",
                "verseOrgIds": [
                  "LUK.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee isaan gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu deebii kennuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yommuu akka keessumoonni sun iddoo ulfinaa filatan hubatetti akkana jedhee fakkeenya kana isaanitti hime;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yoo namni tokko cidha fuudhaa fi heerumaatti si waame, iddoo ulfinaa hin taaʼin; tarii namni si caalaa ulfina qabu tokko waamameera taʼaatii.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.8",
                "verseOrgIds": [
                  "LUK.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.8",
            "verseOrgIds": [
              "LUK.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namichi isin lamaanuu waame sun dhufee, 'Namicha kanaaf kaʼi' siin jedha; atis qaanoftee dhaqxee lafa iddoo hundumaa gad taʼe teessa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.9",
                "verseOrgIds": [
                  "LUK.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.9",
            "verseOrgIds": [
              "LUK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ati garuu yommuu waamamtu akka namichi si waame sun yeroo dhufutti, 'Yaa michuu koo iddoo ol aanutti hiiqi' siin jedhuuf dhaqii lafa iddoo hundumaa gad taʼe taaʼi; yoos fuula warra si wajjin maaddiitti dhiʼaatan hundumaa duratti ulfina argattaatii.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.10",
                "verseOrgIds": [
                  "LUK.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.10",
            "verseOrgIds": [
              "LUK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni ol of qabu hundinuu gad qabamaatii; namni gad of qabu hundinuu immoo ol qabama.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.11",
                "verseOrgIds": [
                  "LUK.14.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis namicha isa waame sanaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ati yommuu laaqana yookaan irbaata qopheessitu michoota kee yookaan obboloota kee, yookaan firoota kee, yookaan olloota kee warra sooreyyii hin waamin; yoo akkas goote isaanis deebisanii si waamu; gatiin kees siif deebifama.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.12",
                "verseOrgIds": [
                  "LUK.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garuu yommuu cidha qopheessitu hiyyeeyyii, naafa, okkolaa fi jaamaa waami.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.13",
                "verseOrgIds": [
                  "LUK.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.13",
            "verseOrgIds": [
              "LUK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sababii isaan waan siif deebisan hin qabneef ati ni eebbifamta; gatiin kee guyyaa duʼaa kaʼuu qajeeltotaatti siif deebifamaatii.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.14",
                "verseOrgIds": [
                  "LUK.14.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Cidha Guddaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.14.16-LUK.14.24"
          },
          "items": [
            {
              "text": "14:16‑24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwi –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MAT.22.2-MAT.22.14"
              },
              "items": [
                {
                  "text": "Mat 22:2‑14",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra isa wajjin maaddiitti dhiʼaatan keessaa namichi tokko yommuu waan kana dhagaʼetti Yesuusiin, \"Namni mootummaa Waaqaa keessatti maaddiitti dhiʼaatu eebbifamaa dha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo akkana jedhee deebise;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namichi tokko cidha guddaa qopheessee keessumoota hedduu affeere.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.16",
                "verseOrgIds": [
                  "LUK.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namichi sunis saʼaatii nyaataatti akka inni, 'Kunoo, wanni hundinuu qopheeffameeraatii kottaa' jedhee warra affeeraman sanatti himuuf garbicha isaa erge.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.17",
                "verseOrgIds": [
                  "LUK.14.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Garuu isaan hundi bifuma tokkoon sababa dhiʼeeffachuu jalqaban; inni jalqabaa, 'Ani lafa qotiisaa bitadheera; kanaafuu dhaqeen ilaaluu qabaatii maaloo na hin komatin' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.18",
                "verseOrgIds": [
                  "LUK.14.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inni kaan, 'Ani qotiyyoo cimdii shan bitadheera; isaan leenjisuuf deemuuttin jiraatii, maaloo na hin komatin' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.19",
                "verseOrgIds": [
                  "LUK.14.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amma illee inni kaan, 'Ani dhiʼoon niitii fuudhe; kanaafuu dhufuu hin dandaʼu' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.20",
                "verseOrgIds": [
                  "LUK.14.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Garbichi sunis deebiʼee waan kana gooftaa isaatti hime. Abbaan mana sanaas aaree, 'Dafii karaa guddaa fi daandii qalʼaa magaalaatti achi baʼiitii hiyyeeyyii, naafa, jaamaa fi okkolaa fidii ol seensis' jedhee garbicha isaa ajaje.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.21",
