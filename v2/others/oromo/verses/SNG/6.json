          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Michoota",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ishee dubartoota hunda caalaa bareeddu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "michuun kee eessa dhaqe?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "Akka nu si wajjin barbaannuuf",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "michuun kee garamitti gore?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ishee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Michuun koo iddoo biqiltuu keessa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "hoolota isaa tikfachuu fi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "daraaraa walitti qabachuuf jedhee gara iddoo biqiltuu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "lafa madabiin biqiltuu urgooftuuwwanii jirutti gad buʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kan michuu koo ti; michuun koos kanuma koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:3"
      },
      "items": [
        {
          "text": "inni daraaraa keessa dheechifata.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Isa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa jaalallee ko, ati akkuma Tiirzaa bareedduu dha;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "akkuma Yerusaalem namatti tolta;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "akkuma loltoota faajjii baataniis ulfina qabda.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ija kee narraa buqqisi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "inni na jeeqeeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "Rifeensi mataa keetii akkuma karra reʼoota",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "Giliʼaad irraa gad buʼanii ti.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilkaan kee akkuma karra hoolotaa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "kan dhiqamee ol dhufaa jiruu ti.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "Tokkoon tokkoon isaanii lakkuu qabu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "isaan keessa maseenni tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maddiin kee lamaan haguuggii kee keessatti",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:7"
      },
      "items": [
        {
          "text": "roomaanii tokkicha iddoo lamatti qoodame fakkaata.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootittiiwwan jaatamni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "saajjatoon saddeettamnii fi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "dubarran lakkoobsa hin qabne qulqulluun",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "jiraachuu dandaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "gugeen koo kan mudaa tokko iyyuu hin qabne sun kan addaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "isheen haadha isheetiif intala tokkittii dha;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "haadha ishee deesseefis filatamtuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "Dubarran ishee arganii ishee eebbisan;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "mootittiiwwanii fi saajjatoowwanis ishee jajan.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Michoota",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kan akka boruu baqaquutti mulʼattu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "kan akka jiʼaa bareeddu, kan akka biiftuu iftu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "kan akka urjiiwwan tooraan yaaʼanii ulfina qabdu kun eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Isa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis daraaraa sulula keessatti dhiʼoo biqile arguuf,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "akka wayiniin hudhaa baase",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "yookaan akka roomaaniin daraare ilaaluuf",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "gara lafa qotiisaa ocholooniitti gad nan buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 6:12"
          },
