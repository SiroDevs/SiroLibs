  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HOS 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Obboloota keessaniin, 'Saba koo' obboleettota keessaniin immoo, 'Jaallatamtuu koo' jedhaa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adabamuu fi Haaromfamuu Israaʼel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haadha keessanitti dheekkamaa; isheetti dheekkamaa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "isheen niitii koo mitiitii;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "anis dhirsa ishee miti.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "Isheen fuula ishee irraa ilaalcha ejjummaa haa balleessitu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "amanamummaa dhabuus harma ishee gidduudhaa haa balleessitu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo kanaa achii ani wayyaa ishee irraa baasee",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "akkuma guyyaa isheen dhalatte sanaa qullaa ishee nan hambisaa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "akkuma gammoojjii ishee nan godha;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "lafa goggogaatti ishee nan geeddara;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "dheebuudhaanis ishee nan ajjeesa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan ijoollee ejjummaa waan taʼaniif,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:4"
      },
      "items": [
        {
          "text": "ani ijoollee isheetiif garaa hin laafu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haati isaanii amanamummaa dhabdee",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "karaa salphinaatiin isaan ulfoofte.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "Isheen, 'Ani warra na jaallatu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "warra nyaata koo fi bishaan koo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "warra suufii koo fi wayyaa quncee talbaa irraa hojjetame,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "warra dibataa fi dhugaatii koo naaf kennan",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "duukaa nan buʼa' jette.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani haafa qoraattiitiin daandii ishee nan cufa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:6"
      },
      "items": [
        {
          "text": "akka isheen karaa ittiin baatu hin arganneef dallaa itti nan ijaara.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen michoota ishee duukaa buuti; garuu isaan hin qaqqabdu;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "isaan barbaaddi; garuu hin argitu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "Ergasii isheen, 'Ani akkuma duraa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "gara dhirsa kootti nan deebiʼa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "amma caalaa yeroo sana wayya tureetii' jetti.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen akka ani midhaan,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "daadhii wayinii haaraa fi zayitii isheedhaaf kenne,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "meetii fi warqee isaan Baʼaaliif dhiʼeessanis",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "kan ishee irratti dhangalaase anuma akka taʼe hin beekne.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu ani yeroo inni bilchaatutti midhaan koo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "daadhii wayinii koo haaraa illee yeroo inni qophaaʼutti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "irraa nan fudhadha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "Ani suufii koo fi wayyaa koo kan quncee talbaa irraa hojjetame",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "kanan qullaa ishee dhoksuudhaaf kenneefis",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "amma ishee irraa nan fudhadha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani amma ijuma michoota ishee duratti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:10"
      },
      "items": [
        {
          "text": "addaggummaa ishee nan saaxila;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:10"
      },
      "items": [
        {
          "text": "namni tokko iyyuu harka koo keessaa ishee hin baasu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ayyaana ishee hunda jechuunis,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
