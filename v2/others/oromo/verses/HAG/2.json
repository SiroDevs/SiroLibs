              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.23",
                "verseOrgIds": [
                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu.\"",
          "type": "text",
          "attrs": {
