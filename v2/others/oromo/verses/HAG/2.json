          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa kanaa jalqabaatii jechuunis guyyaa digdamii afuraffaa jiʼa saglaffaa kanaa jalqabaatii hamma guyyaa hundeen mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.18",
            "verseOrgIds": [
              "HAG.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.18",
                "verseOrgIds": [
                  "HAG.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "buufameetti of eeggannaadhaan qalbeeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.18",
            "verseOrgIds": [
              "HAG.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HAG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma iyyuu sanyiin gombisaa keessatti hafe tokko iyyuu jiraa? Hamma ammaatti mukni wayiniitii fi mukni harbuu, roomaanii fi mukni ejersaa ija hin naqanne.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HAG 2:19"
      },
      "items": [
        {
          "text": "\" 'Ani guyyaa kanaa jalqabee isin nan eebbisa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
