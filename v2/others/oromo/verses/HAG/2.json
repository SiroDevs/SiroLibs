                "verseOrgIds": [
                  "HAG.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "bultii digdamii afuraffaa jiʼa sanaatti yeroo lammaffaa akkana jedhee gara Haagee dhufe;",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
