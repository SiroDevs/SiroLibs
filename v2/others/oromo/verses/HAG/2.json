            "number": "21",
            "style": "v",
            "sid": "HAG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akka ani samiiwwanii fi lafa raasuuf jiru Zarubaabel bulchaa Yihuudaatti himi.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.21",
            "verseOrgIds": [
              "HAG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HAG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani teessoo moototaa nan garagalcha; humna mootummoota biyya alaas nan barbadeessa. Ani gaariiwwanii fi ooftota isaanii nan garagalcha; fardeenii fi warra fardeen yaabbatan ni kufu; tokkoon tokkoon isaanii goraadee obboleessa isaaniitiin ni kufu.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.22",
            "verseOrgIds": [
              "HAG.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
