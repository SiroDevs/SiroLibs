          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Guyyaa sana' jedha",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.23",
                "verseOrgIds": [
                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu; 'Yaa tajaajilaa koo Zarubaabel ilma Sheʼaltiiʼeel, ani sin fudhadha' jedha",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.23",
                "verseOrgIds": [
                  "HAG.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "; 'Ani waanan si filadheef akka qubeelaa chaappaa koo sin godhadha' jedha",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
