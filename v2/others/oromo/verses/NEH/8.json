    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Izraan Seera Dubbise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo jiʼi torbaffaan gaʼee Israaʼeloonni magaalaawwan ofii isaanii keessa qubatanitti, uummanni hundinuu akkuma nama tokkootti oobdii Karra Bishaanii duratti walitti qabame. Isaanis akka inni Kitaaba Seera Musee kan",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.1",
                "verseOrgIds": [
                  "NEH.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼeliif ajaje sana fiduuf Izraa barsiisaa seeraa sanatti himan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.1",
            "verseOrgIds": [
              "NEH.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Izraan lubichi guyyaa jalqaba jiʼa torbaffaatti fuula waldaa dhiiraa fi dubartii warra waa hubachuu dandaʼan hundaa duratti Seera sana fide.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.2",
            "verseOrgIds": [
              "NEH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis barii ganamaa jalqabee hamma saafaatti gara oobdii Karra Bishaaniin duratti garagalee fuula dhiirotaa, dubartootaa fi namoota waa hubachuu dandaʼan kaanii duratti sagalee isaa ol fudhatee seera sana dubbise. Uummanni hundis kitaaba Seeraa sana qalbeeffatee dhaggeeffate.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.3",
            "verseOrgIds": [
              "NEH.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izraan barsiisaan seeraa sun waltajjii mukaa kan kaayyoo kanaaf hojjetame irra dhaabate. Isa biras karaa mirga isaa Matiitiyaa, Shemaa, Anaayaa, Uuriyaa, Hilqiyaa fi Maʼaseyaatu dhaabate; karaa bitaa isaa immoo Phedaayaa, Miishaaʼeel, Malkiyaa, Haashum, Hashbadaanaa, Zakkaariyaasii fi Meshulaamitu dhaabatee ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.4",
            "verseOrgIds": [
              "NEH.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izraan Kitaabicha bane. Sababii inni isaanii ol dhaabachaa tureef namoonni hundi isa arguu dandaʼan; akkuma inni kitaabicha baneenis sabni hundi kaʼee dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.5",
            "verseOrgIds": [
              "NEH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izraanis",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.6",
                "verseOrgIds": [
                  "NEH.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa guddicha galateeffate; namoonni hundinuus harka ol qabatanii, \"Ameen! Ameen!\" jedhanii jalaa qaban. Ergasiis gad jedhanii addaan lafatti gombifamanii",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.6",
                "verseOrgIds": [
                  "NEH.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sagadan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni jechuunis Yeeshuuʼaan, Baaniin, Sheereebiyaan, Yaamiin, Aquub, Shaabetaayi, Hoodiyaa, Maʼaseyaan, Qeliixaa, Azaariyaa, Yoozaabaad, Haanaanii fi Phelaayaan utuma waldaan achi dhaabatee jiruu seera sana ibsaniif.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akka sabni waan dubbifame sana hubatuuf Kitaaba Seera Waaqaa keessaa dubbisanii ibsuudhaan hiikkaa isaa kennaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.8",
            "verseOrgIds": [
              "NEH.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achii immoo Nahimiyaan bulchaan biyyaa, Izraan lubichi barsiisaan seeraa sunii fi Lewwonni uummataaf ibsa kennaa turan sun hunda isaaniitiin, \"Guyyaan kun guyyaa",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.9",
            "verseOrgIds": [
              "NEH.8.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.9",
                "verseOrgIds": [
                  "NEH.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessaniif qulqulleeffamee dha. Hin gaddinaa yookaan hin booʼinaa\" jedhan. Sabni hundi yeroo dubbii seera sanaa dhagaʼetti booʼaa tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.9",
            "verseOrgIds": [
              "NEH.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Nahimiyaan akkana jedhe; \"Dhaqaatii nyaata filatamaa nyaadhaa; dhugaatii miʼaawaas dhugaa; warra waan qophaaʼe tokko illee hin qabneefis waa ergaa. Guyyaan kun guyyaa Gooftaa keenyaaf qulqulleeffamee dha. Sababii gammachuun",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.10",
                "verseOrgIds": [
                  "NEH.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "jabina keessan taʼeef hin gaddinaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.10",
            "verseOrgIds": [
              "NEH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonnis, \"Calʼisaa; guyyaan kun guyyaa qulqulluudhaatii hin gaddinaa\" jedhanii uummata hunda ni tasgabbeessan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.11",
            "verseOrgIds": [
              "NEH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis sabni hundi sababii dubbii itti himame sana hubateef nyaatee dhuguuf, nyaata isaa irraa qoodee warra kaaniif illee erguu fi gammachuu guddaan ayyaaneffachuudhaaf kaʼee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.12",
            "verseOrgIds": [
              "NEH.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii lammaffaa jiʼa sanaatti abbootiin maatiiwwanii hundinuu dubbii Seera sanaa qalbeeffachuuf lubootaa fi Lewwota wajjin Izraa barsiisaa sana biratti walitti qabaman.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akka ajajni",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.8.14",
                "verseOrgIds": [
                  "NEH.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Museen kenne kan, Israaʼeloonni yeroo ayyaana jiʼa torbaffaatti daasii keessa turuu qabu jedhu sun seera keessatti barreeffamee jiru argatan;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas akka isaan akkuma barreeffamee jirutti, \"Daasii ijaaruudhaaf biyya gaaraatti ol baʼaatii damee ejersaa fi damee ejersa bosonaa, damee kusaayee, damee meexxii fi damee mukkeen baala qabanii fidaa\" jedhanii magaalaawwan isaanii fi Yerusaalem keessatti labsuu qaban ni argatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu uummanni sun gad baʼee dameelee fidee tokkoon tokkoon isaanii bantii mana ofii isaanii irratti, oobdii ofii isaanii irratti, oobdii mana Waaqaa irratti, oobdii Karra Bishaanii fi oobdii Karra Efreem bira jiru irratti daasii ijaarratan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waldaan boojuudhaa deebiʼe hundi daasii ijaarratee keessa jiraate. Bara Iyyaasuu ilma Nuuniitii jalqabee hamma gaafasitti Israaʼeloonni akkasitti hin ayyaaneffanne. Gammachuun isaaniis akka malee guddaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.17",
            "verseOrgIds": [
              "NEH.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izraanis guyyaa jalqabaatii hamma guyyaa dhumaatti guyyuma guyyaan Kitaaba Seera Waaqaa keessaa dubbise. Isaanis guyyaa torba ayyaana sana ayyaaneffatanii guyyaa saddeettaffaatti immoo akkuma seeraatti yaaʼii guddaa godhatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.18",
            "verseOrgIds": [
              "NEH.8.18"
            ]
          }
        }
      ]
    }
  ],
