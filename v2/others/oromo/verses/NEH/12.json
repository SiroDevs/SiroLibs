          "text": "maatii Aamoq keessaa Eeber;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.20",
            "verseOrgIds": [
              "NEH.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "maatii Hilqiyaa keessaa Hashabiyaa;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:21"
      },
      "items": [
        {
          "text": "maatii Yedaaʼiyaa keessaa Naatnaaʼel.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbootiin maatii Lewwotaa bara Eliyaashiib, Yooyaadaa, Yoohaanaanii fi bara Yaaduʼaa keessa akkasumas abbootiin maatii lubootaa bara mootummaa Daariyoos namicha Faares sanaa keessa galmeeffaman.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni warri abbootii maatii turan hamma bara Yoohaanaan ilma Eliyaashiibitti kitaaba seenaa keessatti galmeeffaman.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangafoonni Lewwotaas Hashabiyaa, Sheereebiyaa, Yeeshuʼaa ilma Qadmiiʼeel akkasumas obboloota isaanii warra akkuma Daawit namni Waaqaa sun ajajetti faarfannaa fi galata dhiʼeessuudhaaf fuullee isaanii dhaabatanii gareen tokko garee kaan jalaa qabu sana turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataaniyaan, Baqbuqiyaan, Obaadiyaan, Meshulaam, Talmoonii fi Aquub mankuusaalee karrawwan bira jiran eegu turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis bara Yooyaaqiim ilma Iyyaasuu, ilma Yoozaadaaq keessa, bara Nahimiyaa bulchaa biyyaatii fi bara Izraa lubicha barreessaa sanaa keessa tajaajilaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eebba Dallaa Yerusaalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo eebba dallaa Yerusaalemitti Lewwonni akka faarfannaa galataatiin, kililleedhaan, baganaa fi kiraaraan ayyaana eebbaa sana gammachuun ayyaaneffataniif iddoo jiraatan hundaa barbaadamanii gara Yerusaalem fidaman.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faarfattoonnis biyya naannoo Yerusaalem jechuunis gandoota Netoofotaatii,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beet Gilgaalii, naannoo Gebaatii fi Azmaawetitti walitti fidaman; faarfattoonni naannoo Yerusaalemitti gandoota ofii isaanii ijaarratanii turaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonnii fi Lewwonnis erga akka seeraatti of qulqulleessanii booddee saba, karrawwanii fi dallaa sana qulqulleessan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka hooggantoonni Yihuudaa dallaatti ol baʼan nan godhe. Akkasumas akka isaan galata dhiʼeessaniif tuuta faarfattootaa lama nan ramade. Tuunni tokko karaa mirgaatiin dallaa irraan gara Karra Dikee dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hooshaʼiyaa fi hooggantoota Yihuudaa keessaa walakkaan,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaariyaa, Izraa, Meshulaam,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudaa, Beniyaam, Shemaaʼiyaa fi Ermiyaas wajjin isaan duukaa buʼan;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas luboonni malakata qabatan tokko tokkoo fi Zakkaariyaas ilmi Yoonaataan, ilmi Shemaaʼiyaa, ilmi Mataaniyaa, Miikaayaa, ilmi Zakuur, ilmi Asaaf isaan duukaa buʼan;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "amma illee obboloota isaa jechuunis Shemaaʼiyaan, Azariʼeel, Miilaalaayi, Gilaalayi, Maaʼayi, Naatnaaʼel, Yihuudaa fi Hanaaniim akkuma Daawit namni Waaqaa sun ajajetti meeshaa faarfannaa fudhatanii dhaqan. Izraan barreessaan sun immoo isaan hoogganaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Karra Burqaa biraa kaʼanii gulantaawwan Magaalaa Daawit iddoo dallaan ittiin ol kaʼu sanaan mana Daawit irraan qajeelanii gara Karra Bishaanii kan gama baʼa biiftuutti ol baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuunni faarfattootaa lammaffaan immoo gara bitaatti qajeele. Anis gartokkee sabaa wajjin dallaa gubbaadhaan gara Gamoo ol dheeraa Iddoo Ibiddaatii fi Dallaa Balʼaatti isaan duukaa buʼe;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas ani Karra Efreem irraan, karaa Karra Moofaa, karaa Karra Qurxummii, karaa Gamoo ol dheeraa Hanaaniʼeelii fi Karaa Gamoo ol dheeraa Dhibbaatiin hamma Karra Hoolotaatti isaan duukaa nan buʼe. Isaanis Karra Eegdotaa bira gaʼanii dhaabatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuunni faarfattootaa kan galata dhiʼeesse sun lachuu mana Waaqaa keessatti iddoo isaa qabate; anis qondaaltota gartokko wajjin iddoo nan qabadhe;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "amma illee luboonni jechuunis Eliiyaaqiim, Maʼaseyaan, Miiniyaamiin, Miikaayaan, Eliiyooʼeenayin, Zakkaariyaasii fi Hanaaniyaan malakata isaanii qabatanii",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maʼaseyaan, Shemaaʼiyaan, Eleʼaazaar, Ooziin, Yehohaanaaniin, Malkiyaan, Eelaamii fi Eezer iddoo iddoo isaanii qabatan. Faarfattoonni immoo Yizrahiyaadhaan qajeelfamanii faarfatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis sababii Waaqni gammachuu guddaa isaaniif kenneef gaafas gammadaa aarsaa guddaa dhiʼeessan. Dubartoonnii fi ijoolleenis ni gammadan. Sagaleen gammachuu Yerusaalem keessaas fagootti dhagaʼame.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NEH 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti namoonni mankuusaalee gumaachi, mataan midhaaniitii fi kennaan harka kudhan keessaa tokkoo itti galfamu irratti itti gaafatamtoota taʼanii muudaman. Isaanis lafa qotiisaa naannoo magaalaawwanitti argaman irraa qooda Seerri lubootaa fi Lewwotaaf ajaju sana fidanii mankuusaaleetti galchan; Yihuudaan lubootaa fi Lewwota tajaajilanitti gammadee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.44",
            "verseOrgIds": [
              "NEH.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis tajaajila Waaqa isaaniitii fi tajaajila sirna qulqullessuu sana akkuma faarfattoonnii fi eegdonni karraa godhan sana akkuma Daawitii fi ilmi isaa Solomoon ajajanitti raawwatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabana durii bara Daawitii fi Asaaf keessa qajeelchitoota faarfattootaa, kan faarfannaa Waaqa leellisuutii fi kan Waaqa galateeffachuutu tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu bara Zarubaabelii fi bara Nahimiyaa keessa Israaʼeloonni hundi qooda guyyuma guyyaadhaan faarfattootaa fi karra eegdotaaf barbaachisu kennan. Akkasumas Lewwota kaaniif qooda isaanii kophaatti baasan; Lewwonnis qooda sanyiiwwan Aroon kophaatti baasan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
      ]
    }
  ],
