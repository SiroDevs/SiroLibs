    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 12:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf",
        "vid": "NEH 12:7"
      },
      "items": [
        {
          "text": "Warri kun bara Iyyaasuu keessa hooggantoota lubootaatii fi obboloota isaanii turan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni immoo Yeeshuuʼaa, Binuuyii, Qadmiiʼeel, Sheereebiyaa, Yihuudaa akkasumas Mataaniyaa isa obboloota isaa wajjin faarfannaa galataatti itti gaafatamaa ture sana turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.8",
            "verseOrgIds": [
              "NEH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboleeyyan isaanii Baqbuqiyaa fi Unniin yeroo tajaajilaatti fuullee isaanii dhadhaabachaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        }
      ]
    },
