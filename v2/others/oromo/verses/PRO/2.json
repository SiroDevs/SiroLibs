    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Badhaasa Ogummaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ilma ko, yoo ati dubbii koo fudhattee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:1"
      },
      "items": [
        {
          "text": "ajaja koos of keessatti kuufatte,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo ati gurra kee ogummaatti garagalfattee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:2"
      },
      "items": [
        {
          "text": "yaada kee hubannaatti deebifatte,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo ati jabaattee qalbeeffannaa barbaaddee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:3"
      },
      "items": [
        {
          "text": "hubannaa argachuuf jettee iyyitee kadhatte,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo ati akkuma meetiitti isa barbaaddattee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:4"
      },
      "items": [
        {
          "text": "akkuma qabeenya dhokfameetti isa barbaadde,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PRO.2.5",
                "verseOrgIds": [
                  "PRO.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuu ni hubatta;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:5"
      },
      "items": [
        {
          "text": "Waaqa beekuus ni argatta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PRO.2.6",
                "verseOrgIds": [
                  "PRO.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ogummaa namaa kennaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:6"
      },
      "items": [
        {
          "text": "afaan isaa keessaa illee beekumsaa fi hubannaatu baʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni qajeeltotaaf ogummaa dhugaa kuusa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.7",
            "verseOrgIds": [
              "PRO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:7"
      },
      "items": [
        {
          "text": "warra adeemsi isaanii mudaa hin qabneef gaachana;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.7",
            "verseOrgIds": [
              "PRO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni daandii tolootaa ni eega;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:8"
      },
      "items": [
        {
          "text": "karaa qulqulloota isaa illee ni tiksa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.8",
            "verseOrgIds": [
              "PRO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
