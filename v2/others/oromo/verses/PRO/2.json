      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:17"
      },
      "items": [
        {
          "text": "kakuu fuula Waaqaa duratti galte sana dagatte jalaa si baraara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.17",
            "verseOrgIds": [
              "PRO.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
