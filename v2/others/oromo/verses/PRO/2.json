          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra daandiin isaanii jalʼate,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.15",
            "verseOrgIds": [
              "PRO.2.15"
            ]
          }
        }
      ]
    },
