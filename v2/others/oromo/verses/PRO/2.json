          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra waan hamaa hojjechuutti gammadan,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        }
      ]
