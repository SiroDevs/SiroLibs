      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:13"
      },
      "items": [
        {
          "text": "daandii qajeelaa dhiisan,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.13",
            "verseOrgIds": [
              "PRO.2.13"
            ]
          }
        }
      ]
