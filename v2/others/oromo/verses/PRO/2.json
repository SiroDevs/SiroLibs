      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:14"
      },
      "items": [
        {
          "text": "warra jalʼina hojjechuun itti tolu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.14",
            "verseOrgIds": [
              "PRO.2.14"
            ]
          }
        }
      ]
    },
