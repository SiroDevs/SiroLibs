            "sid": "PRO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii ati qajeelummaa fi murtii qajeelaa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.9",
            "verseOrgIds": [
              "PRO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:9"
      },
      "items": [
        {
          "text": "nama wal qixxeessuu, karaa qajeelaa hundas ni hubatta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.9",
            "verseOrgIds": [
              "PRO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaan garaa kee seena;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.10",
            "verseOrgIds": [
              "PRO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:10"
      },
      "items": [
        {
          "text": "beekumsis lubbuu kee gammachiisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.10",
            "verseOrgIds": [
              "PRO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
