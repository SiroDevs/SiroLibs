          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra karaa dukkanaa irra deemuudhaaf jedhanii",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.13",
            "verseOrgIds": [
              "PRO.2.13"
            ]
          }
        }
      ]
