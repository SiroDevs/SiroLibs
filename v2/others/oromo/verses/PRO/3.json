      "attrs": {
        "style": "q2",
        "vid": "PRO 3:5"
      },
      "items": [
        {
          "text": "hubannaa kees hin abdatin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        }
      ]
