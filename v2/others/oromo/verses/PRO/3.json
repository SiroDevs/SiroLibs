          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kun dhagna keetiif fayyaa kenna;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
