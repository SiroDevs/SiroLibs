            "sid": "PRO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ilma ko, barumsa ani siif kennu hin dagatin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:1"
      },
      "items": [
        {
          "text": "ajaja koos garaatti qabadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan bara baayʼee fi umurii dheeraa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:2"
      },
      "items": [
        {
          "text": "nagaa fi badhaadhummaa siif dabaluutii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
