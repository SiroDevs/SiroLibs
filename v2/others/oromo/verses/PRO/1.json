    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kaayyoo Ijoo Dubbii Kitaabichaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fakkeenya Solomoon Ilma Daawit, mootii Israaʼel:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.1",
            "verseOrgIds": [
              "PRO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaa fi qajeelfama qabaachuudhaaf,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:2"
      },
      "items": [
        {
          "text": "dubbii beekumsa guddaa hubachuudhaaf;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.2",
            "verseOrgIds": [
              "PRO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogummaadhaan jiraachuudhaan, qajeelummaadhaan,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:3"
      },
      "items": [
        {
          "text": "murtii qajeelaa kennuu fi nama wal qixxeessuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "qajeelfama argachuudhaaf;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.3",
            "verseOrgIds": [
              "PRO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra waa hin beekneef of eeggannoo kennuudhaaf,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:4"
      },
      "items": [
        {
          "text": "dargaggootaaf immoo beekumsaa fi hubannaa kennuudhaaf,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.4",
            "verseOrgIds": [
              "PRO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogeeyyiin dhaggeeffatanii barumsa isaanii irratti waa haa dabalatan;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:5"
      },
      "items": [
        {
          "text": "warri qalbii qabanis qajeelfama haa argatan;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.5",
            "verseOrgIds": [
              "PRO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis fakkeenyaa fi hiikkaa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:6"
      },
      "items": [
        {
          "text": "jechaa fi hibboo ogeeyyii hubachuudhaaf.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.6",
            "verseOrgIds": [
              "PRO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PRO.1.7",
                "verseOrgIds": [
                  "PRO.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuun jalqaba ogummaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:7"
      },
      "items": [
        {
          "text": "gowwoonni garuu ogummaa fi adabamuu tuffatu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.7",
            "verseOrgIds": [
              "PRO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Gorsa Akka Namni Ogummaa Argatuuf Kenname",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gowwoomfamuu Irraa Of Eeguu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ilma ko, gorsa abbaa keetii dhaggeeffadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:8"
      },
      "items": [
        {
          "text": "barsiisa haadha keetii illee hin gatin.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.8",
            "verseOrgIds": [
              "PRO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kun mataa kee miidhagsuudhaaf gonfoo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:9"
      },
      "items": [
        {
          "text": "morma kee bareechuudhaaf immoo faaya siif taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.9",
            "verseOrgIds": [
              "PRO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ilma ko, yoo cubbamoonni sossobanii",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:10"
      },
      "items": [
        {
          "text": "ofitti si harkisan, tole hin jedhiniif.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.10",
            "verseOrgIds": [
              "PRO.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isaan, \"Nu wajjin kottu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "riphnee dhiiga namaa dhangalaasnaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:11"
      },
      "items": [
        {
          "text": "nama balleessaa hin qabne galaafachuudhaafis",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "dhokannee eeggannaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.11",
            "verseOrgIds": [
              "PRO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kottu akkuma awwaalaa jiraatti isaan liqimsinaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:12"
      },
      "items": [
        {
          "text": "akkuma warra boolla keessa buufamaniis",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:12"
      },
      "items": [
        {
          "text": "guutumaan guutuutti isaan liqimsinaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.12",
            "verseOrgIds": [
              "PRO.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nu waan gatii qabu kan gosa hundaa ni arganna;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:13"
      },
      "items": [
        {
          "text": "manneen keenya illee boojuudhaan guuttanna;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.13",
            "verseOrgIds": [
              "PRO.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ixaa kee nu wajjin buufadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:14"
      },
      "items": [
        {
          "text": "nus korojoo tokko si wajjin qooddannaa\" siin jedhan,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.14",
            "verseOrgIds": [
              "PRO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaa ilma ko, ati isaan wajjin hin deemin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:15"
      },
      "items": [
        {
          "text": "miilla keetiin karaa isaanii irra illee hin ejjetin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.15",
            "verseOrgIds": [
              "PRO.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "miilli isaanii cubbuutti ariifataatii;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 1:16"
      },
      "items": [
        {
          "text": "isaan dhiiga dhangalaasuuf jarjaru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.16",
            "verseOrgIds": [
              "PRO.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma simbirroonni hundi arganuu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.1.17",
            "verseOrgIds": [
              "PRO.1.17"
            ]
          }
        }
      ]
