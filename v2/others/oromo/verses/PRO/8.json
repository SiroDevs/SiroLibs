      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waamicha Ogummaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaan hin iyyuu?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:1"
      },
      "items": [
        {
          "text": "Hubannaanis sagalee isaa ol hin fudhatuu?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen qarqara karaa, lafa ol kaʼaa irra,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:2"
      },
      "items": [
        {
          "text": "iddoo daandiin itti wal gaʼu dhaabatti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "karra magaalaatti nama galchu bira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:3"
      },
      "items": [
        {
          "text": "balbala dura dhaabattee akkana jettee iyyiti:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa namoota, ani iyyeen isin waama;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:4"
      },
      "items": [
        {
          "text": "ani ilmaan namaa hundatti sagalee koo ol nan fudhadha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin warri homaa hin beekne, qalbii horadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:5"
      },
      "items": [
        {
          "text": "isin warri gowwaan hubannaa argadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waan faayidaa qabu nan dubbadhaatii, dhagaʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:6"
      },
      "items": [
        {
          "text": "waan qajeelaa dubbachuufis afaan koo nan banadha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afaan koo dhugaa dubbata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:7"
      },
      "items": [
        {
          "text": "arrabni koo hammina jibbaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin afaan koo hundinuu qajeelaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:8"
      },
      "items": [
        {
          "text": "dubbii koo keessaa tokko iyyuu jalʼaa yookaan micciiramaa miti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama waa hubatuuf dubbiin koo hundinuu qajeelaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:9"
      },
      "items": [
        {
          "text": "warra beekumsa qabuufis hirʼina hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda meetii gorsa koo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:10"
      },
      "items": [
        {
          "text": "warqee qulqulluu caalaas beekumsa filadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogummaan lula diimaa caalaa gatii guddaa qabdii;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:11"
      },
      "items": [
        {
          "text": "wanni ati hawwitu tokko iyyuu isheedhaan wal hin madaalu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani ogummaan, qalbii wajjin nan jiraadha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:12"
      },
      "items": [
        {
          "text": "ani beekumsaa fi hubannaa qaba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.13",
                "verseOrgIds": [
                  "PRO.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuun jibbuu dha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "hammina ani of tuulummaa fi of guddisuu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:13"
      },
      "items": [
        {
          "text": "amala hamaa fi haasaa jalʼaa nan jibba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gorsaa fi murtiin dhugaa kan koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:14"
      },
      "items": [
        {
          "text": "ani hubannaa fi humna qaba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootonni anaan moʼu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:15"
      },
      "items": [
        {
          "text": "bulchitoonnis anaan seera qajeelaa baasu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan moototaa anaan bulchu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:16"
      },
      "items": [
        {
          "text": "namoonni bebeekamoon hundis anaan biyya bulchu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani warra na jaallatan nan jaalladha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:17"
      },
      "items": [
        {
          "text": "warri na barbaadanis na argatu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soorumnii fi ulfinni, qabeenyii fi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 8:18"
      },
      "items": [
        {
          "text": "badhaadhummaan dhuma hin qabne harkuma koo jiru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
