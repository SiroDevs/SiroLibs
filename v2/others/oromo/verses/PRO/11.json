          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni sammuu hin qabne ollaa isaa tuffata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.12",
            "verseOrgIds": [
              "PRO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 11:12"
      },
      "items": [
        {
          "text": "kan hubannaa qabu garuu ni calʼisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.12",
            "verseOrgIds": [
              "PRO.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
