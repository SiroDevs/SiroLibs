  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "1CH 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eegdota Balbalaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka itti eegdonni karraa qoodaman:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 26:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh",
        "vid": "1CH 26:1"
      },
      "items": [
        {
          "text": "Gosa qoree keessaa:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 26:1"
      },
      "items": [
        {
          "text": "Ilmaan Asaaf keessaa Mesheleemiyaa ilma Qooraahi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.1",
            "verseOrgIds": [
              "1CH.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesheleemiyaa ilmaan qaba ture; isaanis:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:2"
      },
      "items": [
        {
          "text": "Inni hangafti Zakkaariyaas, lammaffaan Yediiʼeel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:2"
      },
      "items": [
        {
          "text": "sadaffaan Zabaadiyaa, Afuraffaan Yatniiʼeel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni shanaffaan Eelaam, jaʼaffaan Yehohaanaan,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:3"
      },
      "items": [
        {
          "text": "torbaffaan Eliihooʼeenayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oobeed Edoomis akkasuma ilmaan qaba ture; isaanis:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:4"
      },
      "items": [
        {
          "text": "Inni hangafti Shemaaʼiyaa, lammaffaan Yehoozaabaad,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:4"
      },
      "items": [
        {
          "text": "sadaffaan Yooʼaa, afuraffaan Saakaar,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:4"
      },
      "items": [
        {
          "text": "shanaffaan Naatnaaʼel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "jaʼaffaan Amiiʼeel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:5"
      },
      "items": [
        {
          "text": "torbaffaan Yisaakor, saddeettaffaan Pheʼuletii;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:5"
      },
      "items": [
        {
          "text": "Waaqni Oobeed Edoomin eebbiseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemaaʼiyaan ilmi isaas ilmaan qaba ture; isaanis waan dandeettii guddaa qabaniif qajeelchitoota maatii abbaa isaanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.6",
            "verseOrgIds": [
              "1CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Shemaaʼiyaa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.7",
            "verseOrgIds": [
              "1CH.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:7"
      },
      "items": [
        {
          "text": "Otnii, Raafaaʼeel, Oobeedii fi Elzaabaad;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.7",
            "verseOrgIds": [
              "1CH.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:7"
      },
      "items": [
        {
          "text": "firoonni isaa Eliihuu fi Samaakiyaanis dandeettii guddaa qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.7",
            "verseOrgIds": [
              "1CH.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan kunneen hundi ilmaan Oobeed Edoom; isaan, ilmaan isaaniitii fi firoonni isaanii namoota jajjaboo dandeettii hojii qaban turan; ilmaan Oobeed Edoom; walumatti nama 62 turan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesheleemiyaa fi firoota dandeettii guddaa qaban qaba ture; isaanis walumatti nama 18 turan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoosaan inni gosa Meraarii sun ilmaan qaba ture; isaanis:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.10",
            "verseOrgIds": [
              "1CH.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:10"
      },
      "items": [
        {
          "text": "Shimriin dura buʼaa ture; inni hangafa taʼuu baatu iyyuu abbaan isaa dura buʼaa isa godhee ture;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.10",
            "verseOrgIds": [
              "1CH.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni lammaffaan Hilqiyaa, inni sadaffaan Xibaliyaa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:11"
      },
      "items": [
        {
          "text": "inni afuraffaan Zakkaariyaas.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf",
        "vid": "1CH 26:11"
      },
      "items": [
        {
          "text": "Ilmaanii fi firoonni Hoosaa walumatti nama 13 turan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garee eegdota karraa kana keessaa hangafoota isaaniitiif hojiin akkuma firoonni isaanii hojjetan sanaa mana",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text"
            }
          ]
        },
        {
          "text": "keessa tajaajiluu ni kennameef.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoo tokkoo balbalaatiifis akkuma maatii maatii isaaniitti xinnaa guddaaf ixaan buʼe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ixaan Karra Baʼa Biiftuu Shelemiyaaf baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.14",
            "verseOrgIds": [
              "1CH.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 26:14"
      },
      "items": [
        {
          "text": "Ergasii immoo Zakkaariyaas ilma isaa gorsituu ogeessa sanaaf ixaan buʼe; ixaan balbala kaabaa isaaf baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.14",
            "verseOrgIds": [
              "1CH.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ixaan Karra gama kibbaa Oobeed Edoomiif, kan mankuusaa immoo ilmaan isaatiif baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.15",
            "verseOrgIds": [
              "1CH.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ixaan Karra Lixa biiftuutii fi Karra Shaleekeet kan daandii olii irratti argamu Shufiimii fi Hoosaaf baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.16",
            "verseOrgIds": [
              "1CH.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 26:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh",
        "vid": "1CH 26:16"
      },
      "items": [
        {
          "text": "Eegumsa tokko fuulleedhaan eegumsa biraatu ture:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa baʼa biiftuutiin guyyaa guyyaatti Lewwota jaʼa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 26:17"
      },
      "items": [
        {
          "text": "karaa kaabaatiin guyyaa guyyaatti afur,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 26:17"
      },
      "items": [
        {
          "text": "karaa kibbaatiin guyyaa guyyaatti afur",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 26:17"
      },
      "items": [
        {
          "text": "karaa mankuusaa immoo yeroo tokkotti lamatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oobdii gama lixa biiftuutiin jiruuf daandii irra afur, waltajjicha gubbaa immoo lamatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.18",
            "verseOrgIds": [
              "1CH.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan kunneen garee eegdota karraa kanneen ilmaan Qooraahiitii fi Meraarii keessaa dhufanii dha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Toʼattoota Qabeenyaatii fi Qondaaltota Biraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwota keessaa Ahiiyaan itti gaafatamaa qabeenya mana Waaqaatii fi itti gaafatamaa miʼoota qulqulleeffamanii ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.20",
            "verseOrgIds": [
              "1CH.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyiiwwan Laʼadaan kanneen karaa Laʼadaaniitiin Geershoonota taʼan warri hangafoota maatii Laʼadaan namicha gosa Geershoon sanaa turan: Yehiiʼeelii,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.21",
            "verseOrgIds": [
              "1CH.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilmaan Yehiiʼeelii, Zeetaamii fi obboleessa isaa Yooʼeel. Isaan kunis itti gaafatamtoota qabeenya mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.22",
            "verseOrgIds": [
              "1CH.26.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.26.22",
                "verseOrgIds": [
                  "1CH.26.22"
                ]
              }
            }
          ]
        },
        {
          "text": "turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.22",
            "verseOrgIds": [
              "1CH.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amraamota keessaa, Yizihaarota keessaa, Kebroonota keessaa, Uziiʼeel keessaa:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebuuʼeel ilmi Geershoom ilma Musee sanaa itti gaafatamaa qabeenyaa hangafa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
            "verseOrgIds": [
              "1CH.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni karaa Eliiʼezeriitiin firoota isaa taʼan immoo: ilma isaa Rehaabiyaa, ilma isaa Isaayyaas, ilma isaa Yooraam, ilma isaa Zikrii fi ilma isaa Sheloomiit.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheloomiitii fi firoonni isaa mankuusaa miʼoota Daawit mootichi, hangafoonni maatiiwwanii kanneen ajajjuuwwan kumaatii fi ajajjuuwwan dhibbaa turan, akkasumas ajajjoonni loltootaa biraa Waaqaaf addaan baasan irratti itti gaafatamtoota turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan boojuu waraanaan argame keessaa gara tokko haaromsuu mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
            "verseOrgIds": [
              "1CH.26.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiif",
              "type": "text",
              "attrs": {
                "verseId": "1CH.26.27",
                "verseOrgIds": [
                  "1CH.26.27"
                ]
              }
            }
          ]
        },
        {
          "text": "addaan baasanii kennan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
            "verseOrgIds": [
              "1CH.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Saamuʼeel namichi mulʼata argu sun, Saaʼol ilmi Qiish, Abneer ilmi Neerii fi Yooʼaab ilmi Zeruuyaa dhiʼeessanii fi waan Waaqaaf addaan baafame hunda Sheloomiitii fi firoota isaatu eega ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yizihaarota keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:29"
      },
      "items": [
        {
          "text": "Kenaaniyaa fi ilmaan isaa hojii mana qulqullummaatiin ala taʼetti Israaʼeloota irratti qondaaltotaa fi abbootii murtii taʼanii ramadaman.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kebroonota keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:30"
      },
      "items": [
        {
          "text": "Hashabiyaa fi firoonni isaa kanneen dandeettii qaban kuma tokkoo fi dhibba torba biyya Israaʼel kan Yordaanosiin gama lixa biiftuu jirutti hojii",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.26.30",
                "verseOrgIds": [
                  "1CH.26.30"
                ]
              }
            }
          ]
        },
        {
          "text": "hundaa fi tajaajila mootichaa irratti itti gaafatamtoota turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kebroonota keessaa akkuma galmee hiddaa dhaloota maatii isaaniitti Yeriyaan hangafa isaanii ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:31"
      },
      "items": [
        {
          "text": "Bara mootummaa Daawit keessa waggaa afurtamaffaatti galmeewwan ilaalamanii gosa Kebroon keessaa namoonni dandeettii qaban Yaʼizeer biyya Giliʼaadi keessaa sanatti argaman.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiriiyaan firoota dandeettii qaban kanneen hangafoota maatii turan kuma lamaa fi dhibba torba qaba ture; Daawit mootichis waan kan Waaqaa taʼeef dhimma mootichaa hunda irratti gosa Ruubeen gosa Gaadii fi walakkaa gosa Minaasee toʼattoota godhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.32",
            "verseOrgIds": [
              "1CH.26.32"
            ]
          }
        }
      ]
    }
  ],
