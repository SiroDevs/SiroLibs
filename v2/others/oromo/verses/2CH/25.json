    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiyaa yeroo mootii taʼetti nama waggaa digdamii shan ture; innis Yerusaalem keessa taaʼee waggaa digdamii sagal ni bulche. Maqaan haadha isaa, Yoʼaadaan ture; isheenis nama Yerusaalem turte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis waan fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.2",
                "verseOrgIds": [
                  "2CH.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti qajeelaa taʼe ni hojjete; garuu garaa guutuudhaan miti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni erga jabeessee toʼannaa isaa jalatti mootummaa qabatee booddee qondaaltota abbaa isaa mooticha ajjeesan sana fixe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus inni akka waan Seera keessatti, Kitaaba Musee keessatti kan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.4",
                "verseOrgIds": [
                  "2CH.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Abbootiin sababii ijoollee isaaniitiif ajjeefamuu hin qaban yookaan ijoolleen sababii abbootii isaaniitiif ajjeefamuu hin qaban; tokkoon tokkoon namaa sababii cubbuu ofii isaatiif duʼa\" jedhee ajaje sanaatti tarkaanfii fudhate malee ilmaan warra abbaa isaa ajjeesan sanaa hin fixne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiyaa saba Yihuudaa walitti waamee akkuma maatii isaaniitti ajajjuuwwan kumaatii fi ajajjuuwwan dhibbaa guutummaa Yihuudaa fi Beniyaam keessatti ramade. Sana booddees warra umuriin isaanii waggaa digdamaa fi sanaa ol taʼe walitti qabee akka namoonni duulaaf qophaaʼan kanneen eeboo fi gaachana qabachuu dandaʼan kuma dhibba sadii taʼan argate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas Israaʼel keessaa loltoota jajjaboo kuma dhibba tokko meetii taalaantii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        },
        {
          "text": "dhibba tokkoon ni qaxarate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu namni Waaqaa tokko isa bira dhufee akkana jedheen; \"Yaa mootii, sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.7",
                "verseOrgIds": [
                  "2CH.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼel wajjinis taʼu namoota Efreem kam iyyuu wajjin hin jirreef loltoonni Israaʼel kunneen si wajjin hin duulin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati sodaa malee lola dhaqxe illee Waaqni fuula diinota keetii duratti si kuffisa; Waaqni gargaaruufis kuffisuufis humna qabaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiyaa immoo, \"Garuu taalaantiin dhibbi ani loltoota Israaʼeliif baase sun maal haa taʼu ree?\" jedhee nama Waaqaa sana ni gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "Namni Waaqaa sun immoo deebisee, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.9",
                "verseOrgIds": [
                  "2CH.25.9"
                ]
              }
            }
          ]
        },
        {
          "text": "waan sana caalu iyyuu siif kennuu ni dandaʼa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Amasiyaa loltoota biyya Efreemii isa bira dhufan sana akka isaan biyya isaaniitti deebiʼaniif gad dhiise. Isaanis Yihuudaatti aaranii akka malee dheekkamaa gara biyya isaaniitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiyaa humna isaa jabeeffatee loltoota isaa gara Sulula Soogiddaatti erge; achittis namoota Seeʼiir kuma kudhan ni fixe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonni Yihuudaas namoota kuma kudhan biraa boojiʼan; fiixee kattaa tokkoottis ol baasanii achi irraa gad isaan dadarbatan; hundi isaaniis caccabanii hurraaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonni Amasiyaa akka isaan isa wajjin hin duulleef gara biyya isaaniitti deebisee erge sun garuu magaalaawwan Yihuudaa kanneen Samaariyaadhaa hamma Beet Horoonitti jiran ni dhaʼan. Isaanis namoota kuma sadii ajjeesanii boojuu baayʼee fudhatanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiyaa yommuu namoota Edoom fixee deebiʼetti waaqota saba Seeʼiir fudhatee gale. Innis akkuma waaqota isaatti dhaabbatee sagadeefii aarsaa gubamu isaaniif ni dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.15",
                "verseOrgIds": [
                  "2CH.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "akka malee Amasiyaatti aaree raajii tokko itti erge; raajiin sunis, \"Ati maaliif waaqota saba kanaa kanneen saba ofii isaa iyyuu harka keetii baasuu hin dandeenye gorsa gaafatta?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis utuma inni dubbachaa jiruu, \"Nu akka ati mootii gorsituuf si muudneerraa? Calʼisi! Maaliif rukutamta?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "Raajiin sunis ni calʼise; garuu, \"Sababii ati gorsa koo dhagaʼuu diddee waan kana gooteef, ani akka Waaqni si balleessuuf murteesse nan beeka\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiyaa mootichi Yihuudaa erga gorsitoota isaatiin mariʼatee booddee, \"Kottu mee waraana keessatti wal ilaallaa\" jedhee qoosaa kana gara Yooʼaash ilma Yehooʼaahaaz, ilma Yehuu, mooticha Israaʼelitti ni erge.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaash mootichi Israaʼel garuu akkana jedhee Amasiyaa mooticha Yihuudaatiif deebii kenne; \"Sokorruun Libaanoon keessaa tokko ergaa ergee birbirsaa Libaanooniin, 'Intala kee ilma kootti heerumsiisi' jedhe. Ergasii bineensi bosona Libaanoon keessaa tokko dhufee sokorruu sana irra miilaan deeme.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati, 'Kunoo ati dhugumaan Edoomin moʼatteerta' ofiin jettee amma of tuulaa jirta. Amma garuu mana kee taaʼi! Ati maaliif rakkina barbaaddee ofii keetii fi Yihuudaattis kufaatii fidda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiyaa garuu dhagaʼuu dide; sababii isaan waaqota Edoom duukaa buʼaniif Waaqni harka Yooʼaashitti dabarsee isaan kennuuf murteesseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Yooʼaash mootichi Israaʼel kaʼee lola bane. Innii fi Amasiyaa mootichi Yihuudaa biyya Yihuudaa keessatti Beet Shemeshitti walitti baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Yihuudaas warra Israaʼeliin moʼatamanii tokkoon tokkoon namaas gara mana ofii isaatti baqate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaash mootichi Israaʼel, Amasiyaa mooticha Yihuudaa ilma Iyooʼas ilma Ahaaziyaa sana Beet Shemeshitti qabe. Iyooʼasis gara Yerusaalemitti isa fidee Karra Efreemiitii jalqabee hamma Karra Goleetti dallaa Yerusaalem kan dhagaa sana diige; kutaan diigame kun dhundhuma dhibba afur lafa irra dheerata ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis warqee fi meetii hunda, akkasumas miʼa mana qulqullummaa Waaqaa keessatti argamu kan Oobeed Edoom eegaa ture hunda, qabeenya masaraa mootummaa fi namoota boojiʼe illee fudhatee gara Samaariyaatti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiyaa ilmi Yooʼaash mootichi Yihuudaa erga Yooʼaash ilmi Yehooʼaahaaz mootichi Israaʼel duʼee booddee waggaa kudha shan jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Amasiyaa keessa jalqabaa hamma dhumaatti hojjetaman kanneen biraa kitaaba mootota Yihuudaa fi Israaʼel keessatti barreeffamaniiru mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Amasiyaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.27",
                "verseOrgIds": [
                  "2CH.25.27"
                ]
              }
            }
          ]
        },
        {
          "text": "duukaa buʼuu irraa garagalee jalqabee isaan Yerusaalem keessatti isatti malatan; innis gara Laakkiishitti baqate; isaan immoo faanuma isaa Laakkiishitti namoota erganii achitti isa ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis fardaan isa fidanii Magaalaa Yihuudaatti abbootii isaa biratti isa ni awwaalan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
    }
