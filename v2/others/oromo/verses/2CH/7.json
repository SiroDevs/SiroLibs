    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Solomoon mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.11",
                "verseOrgIds": [
                  "2CH.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "fi masaraa mootummaa fixee waan mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.11",
                "verseOrgIds": [
                  "2CH.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "fi masaraa ofii isaa keessatti hojjechuu barbaade hunda raawwatetti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.12",
                "verseOrgIds": [
                  "2CH.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "halkaniin isatti mulʼatee akkana jedheen:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 7:12"
      },
      "items": [
        {
          "text": "\"Ani kadhannaa kee dhagaʼeera; iddoo kana illee mana qulqullummaa kan aarsaan itti dhiʼeeffamu godhee ofii kootiif filadheera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani yommuun akka bokkaan hin roobneef samii cufutti yookaan akka inni lafa balleessuuf hawwaannisa ergutti yookaan ani yommuun saba kootti dhaʼicha ergutti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo sabni koo kan maqaa kootiin waamamu gad of qabee na kadhate, yoo inni fuula koo barbaadee karaa isaa hamaa sana irraa deebiʼe, ani samii irraa dhagaʼee cubbuu isaa dhiiseefii biyya isaa nan fayyisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas kadhannaa iddoo kanatti dhiʼaatuuf iji koo ni banama; gurri koos ni dhagaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka Maqaan koo bara baraan achi jiraatuuf mana qulqullummaa kana filadhee eebbiseera. Iji koo fi garaan koo yeroo hunda achuma jira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yoo ati akkuma Daawit abbaan kee godhe sana fuula koo dura deemtee waan ani ajaje hunda hojjette, yoo qajeelchawwanii fi seerawwan koo eegde,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani akkuman yeroo, 'Ati nama Israaʼelin bulchu hin dhabdu' jedhee abbaa kee Daawit wajjin kakuu gale sana teessoo mootummaa keetii jabeessee nan dhaaba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Garuu yoo isin duubatti garagaltanii seeraa fi ajaja ani isinii kenne sana irraa gara waaqota biraa tajaajiluu fi isaan waaqeffachuu dhaqxan,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.19",
            "verseOrgIds": [
              "2CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani biyya koo kanan isaaniif kenne keessaa Israaʼelin nan buqqisa; mana qulqullummaa kanan Maqaa kootiif qulqulleesse kana illee nan balfa; saboota hunda birattis waan kolfaatii fi waan qoosaa isa nan godha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.20",
            "verseOrgIds": [
              "2CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manni qulqullummaa kunis tuullaa waan diigamee taʼa. Namni achiin darbu hundis, '",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.21",
                "verseOrgIds": [
                  "2CH.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "maaliif biyya kanaa fi mana qulqullummaa kanatti waan akkasii hojjete?' jedhee itti qoosa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonnis, 'Sababiin inni balaa kana hunda isaanitti fideef waan isaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.22",
                "verseOrgIds": [
                  "2CH.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaanii kan Gibxii isaan baase sana dhiisanii, waaqota biraa hammatanii, isaanin waaqeffatanii tajaajilaniif' jedhanii ni deebisu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        }
      ]
    }
  ],
