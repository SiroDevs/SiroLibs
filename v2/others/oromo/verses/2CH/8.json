    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuma waggaa digdamaatti yeroo itti Solomoon mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.1",
                "verseOrgIds": [
                  "2CH.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "fi mana ofii isaa ijaaretti,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon gandoota Huuraam isaaf kennee ture sana haaromsee ijaaree Israaʼeloota achi keessa ni qubachiise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo Solomoon Hamaati Zoobaatti duulee ishee ni qabate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.3",
            "verseOrgIds": [
              "2CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas gammoojjii keessatti Tadmoorii fi magaalaawwan waa itti kuusan kanneen duraan Hamaatitti ijaaree ture hunda ni ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beet Horoon oliitii fi Beet Horoon gadii magaalaawwan daʼannoo godhee dallaa dhagaa, balbalawwanii fi danqaraawwan ittiin cufan itti tolche;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.5",
            "verseOrgIds": [
              "2CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana malees Baaʼilaatii fi magaalaawwan isaa kanneen waa itti kuusan hunda, magaalaawwan gaariiwwan isaatii fi magaalaawwan fardeen isaa hunda, waanuma Yerusaalemitti, Libaanoonittii fi biyya bulchu hunda keessatti ijaaruu barbaade hundumaa ni ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas namoota Israaʼeloota hin taʼin jechuunis Heetota, Amoorota, Feerzota, Hiiwotaa fi Yebuusota jalaa hafanitu jira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis sanyiiwwan namoota kanneen hundaa warra biyyattii keessatti hafan kanneen Israaʼeloonni hin barbadeessin sana akkuma hamma harʼaatti illee jiru kana akka isaan hojii garbummaa hojjetaniif dirqisiise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon garuu hojii isaatiif jedhee Israaʼeloota hin garboomsine; isaan loltoota isaa, abbootii duulaa, ajajjuuwwan gaariiwwanii fi abbootii fardaa isaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.9",
            "verseOrgIds": [
              "2CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akkasumas qondaaltota Solomoon Mootichaa kanneen nama hojjechiisan dhibba lamaa fi shantaman keessaa qondaaltota hangafoota turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis, \"Sababii iddoon taabonni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.11",
                "verseOrgIds": [
                  "2CH.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "seene hundi qulqulluu taʼeef, niitiin koo masaraa mootummaa Daawit Mooticha Israaʼel keessa jiraachuu hin qabdu\" jedhee intala Faraʼoon sana magaalaa Daawit keessaa baasee gara mana isheef ijaare sanaatti ni fide.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon iddoo aarsaa kan gardaafoo mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.12",
                "verseOrgIds": [
                  "2CH.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti ijaare sana irratti aarsaa gubamu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.12",
                "verseOrgIds": [
                  "2CH.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ni dhiʼeesse;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanas akkuma seera waaʼee aarsaa kan guyyaa guyyaa kan Museen Sanbataaf, Ayyaana Baatii Haaraa fi ayyaanota waggaa keessaa sadaniif jechuunis Ayyaana Maxinoo, Ayyaana Torbanootaa fi Ayyaana Daasiif kenne sanaatti ni dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma seera abbaa isaa Daawititti gareewwan lubootaa hojii isaaniitti, Lewwota immoo akka isaan akkuma seera guyyaa guyyaatti tajaajila galataa kennanii fi akka isaan hojii lubootaa gargaaraniif filate. Akkasumas tokkoo tokkoo karraatti garee eegdota karraa ni ramade; Daawit namni Waaqaa sun waan kana ajajeetii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waan mootichi waaʼee mankuusaa fi waaʼee waan biraa irratti lubootaa fi Lewwota ajaje irraa hin jalʼanne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojiin Solomoon hundi gaafa hundeen mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.16",
                "verseOrgIds": [
                  "2CH.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "buufamee jalqabee hamma dhuma manichaatti haala tolaadhaan hojjetame. Akkasiinis manni qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.8.16",
                "verseOrgIds": [
                  "2CH.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ni xumurame.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Solomoon gara magaalaawwan Eziyoon Geberii fi Eelooti kanneen biyya Edoom keessa qarqara galaanaatti argaman sanaa dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huuraamis dooniiwwan ajajjoonni ofii isaa kanneen galaanicha beekan ajajan ergeef. Isaanis namoota Solomoon wajjin dooniidhaan Oofiir dhaqanii warqee taalaantii dhibba afurii fi shantama fidanii Solomoon Mootichatti kennan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
  ],
