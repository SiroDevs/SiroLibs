    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri Waaqaa Azaariyaa ilma Oodeed irra ni buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.1",
            "verseOrgIds": [
              "2CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Asaatti gad baʼee akkana jedheen; \"Aasaa fi Yihuudaan hundi, Beniyaamis na dhagaʼaa. Yoo isin isa wajjin jiraattan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.2",
                "verseOrgIds": [
                  "2CH.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "isin wajjin ni jiraata. Yoo isin isa barbaaddan inni isiniif ni argama; yoo isin isa dhiiftan immoo innis isin dhiisa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo dheeraadhaaf Israaʼeloonni Waaqa dhugaa malee luba isaan barsiisuu fi seera malee jiraachaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo rakkina isaaniitti garuu gara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.4",
                "verseOrgIds": [
                  "2CH.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼelitti deebiʼanii isa barbaadan; innis isaaniif ni argame.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii bara sana keessa jiraattonni biyyattii hundi raafama keessa turaniif baʼuu fi deebiʼanii galuun amansiisaa hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Waaqni rakkina gosa hundaatiin isaan dhiphisaa tureef sabni tokko saba biraatiin, magaalaan tokko magaalaa biraatiin barbadeeffamaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.6",
            "verseOrgIds": [
              "2CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin garuu jabaadhaa; harki keessanis hin laafin; hojiin keessan badhaasa argataatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaan yommuu dubbii kanaa fi raajii Azaariyaa ilma Oodeed dhagaʼetti ni jajjabaate. Innis waaqota jibbisiisoo harka namaatiin hojjetaman biyya Yihuudaa, Beniyaamii fi magaalaawwan biyya gaaraa Efreem keessatti qabate hunda keessaa balleesse. Iddoo aarsaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.8",
                "verseOrgIds": [
                  "2CH.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kan gardaafoo mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.8",
                "verseOrgIds": [
                  "2CH.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "dura jiru illee ni haaromse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Yihuudaa fi Beniyaam akkasumas warra biyya Efreem, Minaasee fi Simiʼoonii dhufanii alagummaadhaan isaan gidduu jiraachaa turan hunda walitti qabe; namoonni akka malee baayʼeen akka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.9",
                "verseOrgIds": [
                  "2CH.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni isaa isa wajjin jiru arganii Israaʼel keessaa gara isaa dhufaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waggaa kudha shanaffaa Aasaan mootii taʼetti jiʼa sadaffaa keessa Yerusaalemitti walitti qabaman.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanattis waan boojiʼanii fidan keessaa sangoota dhibba torbaa fi hoolota kuma torba",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.11",
                "verseOrgIds": [
                  "2CH.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "aarsaa godhan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis garaa fi lubbuu isaanii guutuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.12",
                "verseOrgIds": [
                  "2CH.15.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii isaanii barbaaduudhaaf kakuu ni galan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.13",
                "verseOrgIds": [
                  "2CH.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼel hin barbaanne hundi xinnaas taʼu guddaan, dhiiras taʼu dubartiin ni ajjeefama ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis sagalee guddaa fi iyyaan, malakataa fi gaanfa afuufuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.14",
                "verseOrgIds": [
                  "2CH.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ni kakatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni hundinuu waan garaa guutuudhaan kakataniif kakuu kanatti akka malee gammadan. Isaan fedhiidhaan Waaqa ni barbaadan; innis isaaniif argame. Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.15",
                "verseOrgIds": [
                  "2CH.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa hundaan boqonnaa isaaniif ni kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aasaan Mootichi akkoo isaa Maʼakaa iyyuu waan isheen fakkii Asheeraa jibbisiisaa tokko tolfatteef iddoo ulfinaa kan isheen akka haadha mootiitti qabaatte sana irra ishee buuse. Aasaan fakkii sana caccabsee Sulula Qeedroon keessatti ni gube.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.16",
            "verseOrgIds": [
              "2CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo inni iddoowwan sagadaa kanneen gaarran irraa guutumaan guutuutti Israaʼel keessaa balleessuu baate iyyuu garaan Aasaa bara jireenya isaa guutuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "2CH.15.17",
                "verseOrgIds": [
                  "2CH.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "kennamee ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis meetii fi warqee akkasumas miʼoota innii fi abbaan isaa Waaqaaf addaan baasan gara mana qulqullummaa Waaqayyootti ni galche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.18",
            "verseOrgIds": [
              "2CH.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamma bara mootummaa Aasaa waggaa soddomii shanaffaatti lolli tokko iyyuu hin kaane.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.19",
            "verseOrgIds": [
              "2CH.15.19"
            ]
          }
        }
      ]
    }
  ],
