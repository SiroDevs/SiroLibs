  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JHN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Ayyaana Daasii Irratti Argamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana booddee Yesuus Galiilaa keessa deddeebiʼaa ture; sababii Yihuudoonni isa ajjeesuu barbaadaniif inni Yihuudaa keessa hin deddeebine.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.1",
            "verseOrgIds": [
              "JHN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayyaanni Daasii Yihuudootaa dhiʼaatee ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.2",
            "verseOrgIds": [
              "JHN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni isaas akkana jedhaniin; \"Akka barattoonni kee warri achii waan ati hojjettu arganiif kaʼiitii Yihuudaa dhaqi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.3",
            "verseOrgIds": [
              "JHN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni utuu ifaan ifatti beekamuu barbaaduu dhoksaatti waa hojjetu hin jiruutii. Atis sababii waan kana hojjettuuf addunyaatti of mulʼisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.4",
            "verseOrgIds": [
              "JHN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni isaa iyyuu isatti hin amanne tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.5",
            "verseOrgIds": [
              "JHN.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yeroon koo amma illee hin geenye; isiniif garuu yeroon hundi mijaaʼaa dha.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.6",
                "verseOrgIds": [
                  "JHN.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Addunyaan isin jibbuu hin dandaʼu; ana garuu akka hojiin isaa hamaa taʼe waanan itti dhugaa baʼuuf na jibba.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.7",
                "verseOrgIds": [
                  "JHN.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.7",
            "verseOrgIds": [
              "JHN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin gara Ayyaana sanaa dhaqaa. Ani garuu waan yeroon koo amma illee hin gaʼiniif gara Ayyaanichaatti ol hin baʼu.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.8",
                "verseOrgIds": [
                  "JHN.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.8",
            "verseOrgIds": [
              "JHN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan kana isaanitti dubbatee Galiilaatti hafe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.9",
            "verseOrgIds": [
              "JHN.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu erga obboloonni isaa gara Ayyaanichaatti ol baʼanii booddee innis utuu ifaan ifatti hin taʼin dhoksaadhaan ol baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.10",
            "verseOrgIds": [
              "JHN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonnis Ayyaanicha irratti, \"Namichi sun eessa jira?\" jedhanii gaafachaa isa barbaadaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.11",
            "verseOrgIds": [
              "JHN.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoota gidduuttis waaʼee isaa guungummii guddaatu ture. Namoonni tokko tokko, \"Inni nama gaarii dha\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 7:12"
      },
      "items": [
        {
          "text": "Warri kaan immoo, \"Akkas miti; inni nama dogoggorsa\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu waan Yihuudoota sodaataniif namni tokko iyyuu ifaan ifatti waaʼee isaa hin dubbanne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.13",
            "verseOrgIds": [
              "JHN.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Ayyaana Irratti Barsiisuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara walakkaa Ayyaanichaattis Yesuus mana qulqullummaa seenee barsiisuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.14",
            "verseOrgIds": [
              "JHN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonnis dinqifatanii, \"Namichi kun akkamitti utuu hin baratin beekumsa akkanaa qabaate?\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.15",
            "verseOrgIds": [
              "JHN.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedhee deebiseef;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.16",
            "verseOrgIds": [
              "JHN.7.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Barsiisni koo kan isa na ergeeti malee kan koo miti.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.16",
                "verseOrgIds": [
                  "JHN.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.16",
            "verseOrgIds": [
              "JHN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni fedhii Waaqaa gochuu barbaadu kam iyyuu barsiisni koo Waaqa biraa dhufuu fi dhufuu baachuu isaa yookaan ani ofuma kootiin dubbachuu fi dubbachuu baachuu koo ni beeka.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.17",
                "verseOrgIds": [
                  "JHN.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.17",
            "verseOrgIds": [
              "JHN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni ofuma isaatiin dubbatu inni ofuma isaatii ulfina argachuu barbaada; namni ulfina kan isa erge sanaa barbaadu garuu inni nama dhugaa ti; jalʼinnis isa keessa hin jiru.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.18",
                "verseOrgIds": [
                  "JHN.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.18",
            "verseOrgIds": [
              "JHN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Museen seera isinii kenneera mitii? Isin keessaa garuu namni tokko iyyuu seera sana hin eegu. Isin maaliif na ajjeesuu barbaaddu?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.19",
                "verseOrgIds": [
                  "JHN.7.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarris deebisanii, \"Hafuura hamaatu si keessa jira; eenyutu si ajjeesuu barbaada?\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.20",
            "verseOrgIds": [
              "JHN.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis deebisee akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.21",
            "verseOrgIds": [
              "JHN.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani hojii tokko hojjennaan hundi keessan dinqifattan.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.21",
                "verseOrgIds": [
                  "JHN.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.21",
            "verseOrgIds": [
              "JHN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Museen seera dhagna qabaa isinii kenne; dhagna qabaa garuu abbootiitu jalqabe malee Musee miti; isinis Sanbataan nama dhagna qabdu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.22",
                "verseOrgIds": [
                  "JHN.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.22",
            "verseOrgIds": [
              "JHN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akka seerri Musee hin cabneef erga namni tokko Sanbataan dhagna qabachuu dandaʼee, isin maaliif sababii ani Sanbataan dhagna namaa guutuu fayyiseef natti aartu?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.23",
                "verseOrgIds": [
                  "JHN.7.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.23",
            "verseOrgIds": [
              "JHN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Murtii qajeelaa kennaa malee, bifa qofa ilaaltanii hin murteessinaa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.24",
                "verseOrgIds": [
                  "JHN.7.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Kun inni Kiristoosii dha?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti namoota Yerusaalem keessaa tokko tokko akkana jedhan; \"Inni kun namicha isaan ajjeesuuf barbaadan sana mitii?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.25",
            "verseOrgIds": [
              "JHN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo inni ifatti baʼee dubbata; isaanis homaa isaan hin jenne. Abbootiin taayitaa akka inni Kiristoos",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.26",
            "verseOrgIds": [
              "JHN.7.26"
            ]
          }
        },
        {
          "text": "taʼe sirriitti beekaniiruu laata?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.26",
            "verseOrgIds": [
              "JHN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus namichi kun nama eessaa akka taʼe nu beekna. Kiristoos yommuu dhufutti garuu inni eessaa akka dhufu namni tokko iyyuu hin beeku.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.27",
            "verseOrgIds": [
              "JHN.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus utuu mana qulqullummaa keessatti barsiisuu sagalee isaa ol fudhatee akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.28",
            "verseOrgIds": [
              "JHN.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin na beektu; akka ani eessaa dhufe illee beektu. Ani ofii kootiin hin dhufne; inni na erge sun dhuga qabeessa. Isin garuu isa hin beektan;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.28",
                "verseOrgIds": [
                  "JHN.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.28",
            "verseOrgIds": [
              "JHN.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ani garuu sababiin isa biraa dhufee fi sababii inni na ergeef isa nan beeka.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.29",
                "verseOrgIds": [
                  "JHN.7.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti isaan isa qabuu yaalan; garuu waan saʼaatiin isaa hin gaʼiniif namni tokko iyyuu harkaan isa hin tuqne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.30",
            "verseOrgIds": [
              "JHN.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus namoonni baayʼeen isatti amanan. Isaanis, \"Kiristoos yommuu dhufutti namicha kana caalaa mallattoo hojjetaa?\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.31",
            "verseOrgIds": [
              "JHN.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnis utuu namoonni waaʼee isaa waan akkanaa guungumanuu dhagaʼan. Luboonni hangafoonnii fi Fariisonni Yesuusin qabsiisuudhaaf eegdota mana qulqullummaa ergan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.32",
            "verseOrgIds": [
              "JHN.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.33",
            "verseOrgIds": [
              "JHN.7.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani yeroo gabaabaa isin wajjin jira; ergasii gara isa na erge sanaa nan dhaqa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.33",
                "verseOrgIds": [
                  "JHN.7.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.33",
            "verseOrgIds": [
              "JHN.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin na barbaaddu; garuu na hin argattan; iddoo ani jirus dhufuu hin dandeessan.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.34",
                "verseOrgIds": [
                  "JHN.7.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonnis akkana waliin jedhan; \"Namichi kun akka nu isa hin argineef eessa dhaquu yaade laata? Gara saba keenya warra Giriikota keessa faffacaʼanii dhaqee Giriikota barsiisaa?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.35",
            "verseOrgIds": [
              "JHN.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Isin na barbaaddu; garuu na hin argattan; iddoo ani jirus dhufuu hin dandeessan'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.36",
                "verseOrgIds": [
                  "JHN.7.36"
                ]
              }
            }
          ]
        },
        {
          "text": "jechuun isaas maal jechuu isaatii?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.36",
            "verseOrgIds": [
              "JHN.7.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa Ayyaanichi itti hobbaʼu, guyyaa guddaa sana, Yesuus kaʼee dhaabatee sagalee guddaadhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.37",
            "verseOrgIds": [
              "JHN.7.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Eenyu iyyuu yoo dheebote, gara koo dhufee haa dhugu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.37",
                "verseOrgIds": [
                  "JHN.7.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.37",
            "verseOrgIds": [
              "JHN.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akkuma Katabbiin Qulqulluun jedhe nama natti amanu kam iyyuu laga bishaan jireenyaatu garaa isaa keessaa burqa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.38",
                "verseOrgIds": [
                  "JHN.7.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.38",
            "verseOrgIds": [
              "JHN.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis waaʼee Hafuura Qulqulluu warri isatti amanan argachuuf jiranii dubbachuu isaa ti. Sababii Yesuus amma illee ulfina hin argatiniif Hafuuri Qulqulluun hamma yeroo sanaatti hin kennamne tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.39",
            "verseOrgIds": [
              "JHN.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoota sana keessaa tokko tokko yommuu dubbii kana dhagaʼanitti, \"Kun dhugumaanuu Raajicha\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.40",
            "verseOrgIds": [
              "JHN.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri kaan immoo, \"Inni Kiristoosii dha\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.41",
            "verseOrgIds": [
              "JHN.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 7:41"
      },
      "items": [
        {
          "text": "Namoonni kaanis akkana jedhan; \"Kiristoos Galiilaadhaa dhufaa?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.41",
            "verseOrgIds": [
              "JHN.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka Kiristoos sanyii Daawit keessaa dhalatuu fi akka inni Beetlihemii, ganda Daawitii dhufu Katabbiin Qulqulluun ni dubbata mitii?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.42",
            "verseOrgIds": [
              "JHN.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin waaʼee Yesuus irratti garaa garummaan waldaa gidduutti uumame.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.43",
            "verseOrgIds": [
              "JHN.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaas tokko tokko isa qabuu barbaadan; garuu namni tokko iyyuu harkaan isa hin tuqne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.44",
            "verseOrgIds": [
              "JHN.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amantii Dhabuu Dura Buʼoota Yihuudootaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegdonni sun gara luboota hangafootaatii fi gara Fariisotaatti deebiʼan; isaanis, \"Isin maaliif isa hin fidin?\" jedhanii eegdota sana gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.45",
            "verseOrgIds": [
              "JHN.7.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegdonnis, \"Takkumaa namni akka namicha kanaatti hin dubbanne\" jedhanii deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.46",
            "verseOrgIds": [
              "JHN.7.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnis deebisanii akkana jedhan, \"Isinis gowwoomfamtaniirtuu?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.47",
            "verseOrgIds": [
              "JHN.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulchitoota keessaa yookaan Fariisota keessaa namni tokko iyyuu isatti amaneeraa?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.48",
            "verseOrgIds": [
              "JHN.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni seera hin beekne kun garuu abaaramaa dha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.49",
            "verseOrgIds": [
              "JHN.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niqoodemoos inni duraan Yesuus bira dhaqee fi isaan keessaas tokko taʼe sun akkana isaaniin jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.50",
            "verseOrgIds": [
              "JHN.7.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 7:51"
          },
          "items": [
            {
              "text": "51",
