  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "RUT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naaʼomiinii fi Ruut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara abbootiin murtii bulchaa turanitti beelli biyyatti buʼe; namichi Beetlihem Yihuudaa keessa jiraatu tokko niitii isaatii fi ilmaan isaa lamaan fudhatee biyya Moʼaab jiraachuu dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.1",
            "verseOrgIds": [
              "RUT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaan namichaa Eliimelek, maqaan niitii isaa Naaʼomiin, maqaan ilmaan isaa lamaanii immoo Mahiloonii fi Kiliiyoon jedhama ture. Isaanis namoota Efraataa kan biyya Yihuudaa Beetlihem keessa jiraatan turan. Jarris biyya Moʼaab dhaqanii achi jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.2",
            "verseOrgIds": [
              "RUT.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliimelek dhirsi Naaʼomiin ni duʼe; isheenis ilmaan ishee lamaan wajjin hafte.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.3",
            "verseOrgIds": [
              "RUT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dubartoota Moʼaab fuudhan; isheen tokko Orphaa kaan immoo Ruut jedhamti. Erga isaan waggaa kudhan achi jiraatanii booddee,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.4",
            "verseOrgIds": [
              "RUT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahiloonii fi Kiliiyoon ni duʼan. Naaʼomiinis ilmaan ishee lamaanii fi dhirsa ishee dhabdee kophaa hafte.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.5",
            "verseOrgIds": [
              "RUT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis utuu Moʼaab jirtuu akka",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.6",
            "verseOrgIds": [
              "RUT.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.6",
                "verseOrgIds": [
                  "RUT.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "saba isaa yaadatee nyaata kenneef dhageesse; Naaʼomiinii fi Niitonni ilmaan ishees gara biyya isheetti deebiʼuuf qophaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.6",
            "verseOrgIds": [
              "RUT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis iddoo jiraachaa turtee kaatee niitota ilmaan ishee wajjin gara biyya Yihuudaatti deebiʼuuf karaa qabatte.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.7",
            "verseOrgIds": [
              "RUT.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Naaʼomiin niitota ilmaan ishee lamaaniin akkana jette; \"Tokkoon tokkoon keessan gara mana haadhota keessaniitti deebiʼaa. Akkuma dhirsoota keessan kanneen duʼanii fi anaafis arjoomtan sana",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.8",
                "verseOrgIds": [
                  "RUT.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "isiniif haa arjoomu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.9",
                "verseOrgIds": [
                  "RUT.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "tokkoo tokkoo keessaniifis mana dhirsa itti heerumtaniitti boqonnaa isinii haa kennu.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 1:9"
      },
      "items": [
        {
          "text": "Isheenis ergasii isaan dhungate; isaanis sagalee ol fudhatanii booʼanii",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waawuu, nu si wajjin gara saba keetiitti deebina\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.10",
            "verseOrgIds": [
              "RUT.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaʼomiin garuu akkana jette; \"Yaa intallan ko, gara mana keessaniitti deebiʼaa. Maaliif na wajjin deemtu? Ani siʼachi ilmaan dhirsa isiniif taʼuu dandaʼan daʼaa?",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.11",
            "verseOrgIds": [
              "RUT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa intallan koo gara mana keessaniitti deebiʼaa; ani dhirsa biraatti heerumuudhaaf dulloomeera. Yoo ani abdii qaba jedhee halkanuma kana heerumee ilmaan daʼe illee,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.12",
            "verseOrgIds": [
              "RUT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "isin hamma isaan guddatanitti ni eeggattuu? Isaan eeggachuuf jettanii utuu hin heerumin haftuu ree? Lakkii yaa intallan koo. Kun isin caalaa natti ulfaata; harki",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.13",
            "verseOrgIds": [
              "RUT.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.13",
                "verseOrgIds": [
                  "RUT.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "natti garagaleeraatii!\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.13",
            "verseOrgIds": [
              "RUT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan amma illee sagalee isaanii ol fudhatanii booʼan. Kana irratti Orphaan haadha dhirsa ishee dhungattee nagaatti jetteen; Ruut garuu isheetti marmite.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.14",
            "verseOrgIds": [
              "RUT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaʼomiinis, \"Kunoo, waarsaan kee gara saba isheetii fi waaqota isheetti deebiʼaa jirti. Atis ishee wajjin deebiʼi\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.15",
            "verseOrgIds": [
              "RUT.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruut garuu akkana jettee deebifte; \"Akka ani si dhiisu yookaan si biraa deebiʼu na hin dirqisiisin. Iddoo ati deemtu nan deema; iddoo ati jiraattus nan jiraadha. Sabni kee saba koo ni taʼa; Waaqni kees Waaqa koo ni taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.16",
            "verseOrgIds": [
              "RUT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo ati itti duututti anis nan duʼa; achittis nan awwaalama. Siʼachi yoo duuti gargari nu baase malee yoo ani si dhiisee deeme",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
              "RUT.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.17",
                "verseOrgIds": [
                  "RUT.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "na haa adabu; adabbiin sunis akka malee haa cimu.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
              "RUT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naaʼomiinis yeroo akka Ruut ishee wajjin deemuuf murteessite hubattetti ishee dirqisiisuu dhiifte.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu dubartoonni lachuu hamma Beetlihemitti deeman. Yommuu isaan Beetlihem gaʼanittis sababii isaaniitiif guutummaan magaalattii raafamte; dubartoonnis, \"Isheen kun Naaʼomiinii?\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.19",
            "verseOrgIds": [
              "RUT.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis akkana isaaniin jette; \"Naaʼomiin jettanii na hin waaminaa! Sababii Waaqni Waan Hunda Dandaʼu jireenya koo hadheesseef Maaraa jedhaatii na waamaa.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani harka guutuudhaan baʼe;",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.21",
                "verseOrgIds": [
                  "RUT.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu harka duwwaa na deebise. Isin maaliif Naaʼomiin naan jettu?",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.21",
                "verseOrgIds": [
                  "RUT.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "na dhiphiseera; Waaqni Waan Hunda Dandaʼu rakkina natti fideeraatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Naaʼomiin, niitii ilma ishee Ruut Moʼaabittii wajjin yeroo garbuun haamamuu jalqabutti Moʼaabii gara Beetlihemitti deebite.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.22",
            "verseOrgIds": [
              "RUT.1.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "RUT.2",
