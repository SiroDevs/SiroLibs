          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaafuu Ilmi Namaa Sanbataaf illee Gooftaa dha.\"",
              "type": "text",
              "attrs": {
