              "text": "2:18‑22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MAT.9.14-MAT.9.17"
              },
              "items": [
                {
                  "text": "Mat 9:14‑17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
