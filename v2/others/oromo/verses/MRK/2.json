          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa Sanbataa tokko Yesuus lafa qotiisaa midhaanii keessa darbaa ture; barattoonni isaas utuu isa wajjin deemaa jiranuu asheetii midhaanii cirachuu jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnis, \"Ilaa, isaan maaliif waan Sanbataan hojjechuun hin eeyyamamne hojjetu?\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee deebise;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin waan Daawit yeroo innii fi miiltonni isaa beelaʼanii fi rakkatanitti godhe sana takkumaa hin dubbifnee?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.25",
                "verseOrgIds": [
                  "MRK.2.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bara Abiyaataar luba ol aanaa ture keessa, inni mana Waaqaa seenee buddeena qulqulleeffame kan akka luboonni qofti nyaataniif eeyyamame sana nyaate. Warra isa wajjin jiraniifis ni kenne.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.26",
                "verseOrgIds": [
                  "MRK.2.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sanbatatu namaaf uumame malee namni Sanbataaf hin uumamne.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.27",
                "verseOrgIds": [
                  "MRK.2.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
