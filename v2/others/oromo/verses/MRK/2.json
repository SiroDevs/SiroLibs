    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus guyyaa muraasa booddee Qifirnaahomitti deebiʼe; namoonnis akka inni mana jiru dhagaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.1",
            "verseOrgIds": [
              "MRK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni akka malee baayʼatan walitti qabamnaan iddoon dhabamee balballi durris dhiphate; innis dubbicha isaanitti lallabaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.2",
            "verseOrgIds": [
              "MRK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarri tokko nama dhagni irratti duʼe kan namoota afuriin baatame tokko gara isaa fidan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.3",
            "verseOrgIds": [
              "MRK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis sababii baayʼina namaatiif namicha sana Yesuusitti dhiʼeessuu dadhabanii qixa Yesuus tureen bantii manaa saaqanii siree namichi dhagni irratti duʼe irra ciise sana gad buusan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.4",
            "verseOrgIds": [
              "MRK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis yommuu amantii isaanii argetti namicha dhagni irratti duʼe sanaan,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.5",
            "verseOrgIds": [
              "MRK.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gurbaa, cubbuun kee siif dhiifameera\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.5",
                "verseOrgIds": [
                  "MRK.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.5",
            "verseOrgIds": [
              "MRK.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barsiistota seeraa keessaa tokko tokko achi tataaʼanii garaa isaanii keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.6",
            "verseOrgIds": [
              "MRK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namichi kun maaliif akkana dubbata? Inni Waaqa arrabsa! Waaqa tokkicha malee eenyutu cubbuu namaaf dhiisuu dandaʼa?\" jedhanii yaadan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.7",
            "verseOrgIds": [
              "MRK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis yeruma sana akka wanni isaan garaa isaanii keessatti yaadaa turan kana taʼe hafuuraan beekee akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin maaliif waan kana yaaddu?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.8",
                "verseOrgIds": [
                  "MRK.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namicha dhagni irratti duʼe kanaan, 'Cubbuun kee siif dhiifameera' jechuu moo 'Kaʼii siree kee fudhadhuu deemi' jechuutu salphaa dha?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.9",
                "verseOrgIds": [
                  "MRK.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.9",
            "verseOrgIds": [
              "MRK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani garuu akka Ilmi Namaa cubbuu namaaf dhiisuudhaaf lafa irratti taayitaa qabu akka beektan nan barbaada.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.10",
                "verseOrgIds": [
                  "MRK.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Kanaafuu inni namicha sanaan,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.10",
            "verseOrgIds": [
              "MRK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani sitti nan hima; kaʼi; siree kee fudhadhuutii mana keetti gali\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.11",
                "verseOrgIds": [
                  "MRK.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.11",
            "verseOrgIds": [
              "MRK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis kaʼee, yommusuma siree isaa fudhatee utuma isaan hundinuu arganuu baʼe deeme. Kunis hunda isaanii dinqisiise; isaanis, \"Nu takkumaa waan akkanaa arginee hin beeknu!\" jedhanii Waaqa jajan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.12",
            "verseOrgIds": [
              "MRK.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waamamuu Lewwii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.2.14-MRK.2.17"
          },
          "items": [
            {
              "text": "2:14‑17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MAT.9.9-MAT.9.13"
              },
              "items": [
                {
                  "text": "Mat 9:9‑13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.5.27-LUK.5.32"
              },
              "items": [
                {
                  "text": "Luq 5:27‑32",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus amma illee gara qarqara galaanichaatti gad baʼe. Namoonni baayʼeenis isa biratti walitti qabaman; innis isaan barsiisuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.13",
            "verseOrgIds": [
              "MRK.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis utuu achiin darbaa jiruu, Lewwii ilma Alfewoos utuu inni iddoo itti qaraxa walitti qaban taaʼuu argee,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na duukaa buʼi\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.14",
                "verseOrgIds": [
                  "MRK.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen. Lewwiinis kaʼee isa duukaa buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Yesuus mana Lewwiitti irbaata nyaachaa turetti, qaraxxoonnii fi cubbamoonni baayʼeen isaa fi barattoota isaa wajjin nyaachaa turan; namoonni isa duukaa buʼan baayʼee turaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.15",
            "verseOrgIds": [
              "MRK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barsiistonni seeraa warri Fariisota turan yommuu isaa cubbamootaa fi qaraxxoota wajjin nyaatu arganitti, \"Inni maaliif qaraxxootaa fi cubbamoota wajjin nyaata?\" jedhanii barattoota isaa gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.16",
            "verseOrgIds": [
              "MRK.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo waan kana dhageenyaan,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.17",
            "verseOrgIds": [
              "MRK.2.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ogeessi fayyaa tokko warra dhukkubsataniif malee warra fayyaa qabaniif hin barbaachisu. Ani cubbamoota waamuufin dhufe malee qajeeltota waamuuf hin dhufne\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.2.17",
                "verseOrgIds": [
                  "MRK.2.17"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.17",
            "verseOrgIds": [
              "MRK.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Waaʼee Soomaa Gaafatame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
