  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "DAN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nebukadnezar Abjuudhaan Muka Tokko Arge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezar Mooticha irraa,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Sabootaa fi namoota afaan garaa garaa dubbatan kanneen guutummaa addunyaa irra jiraatan hundaaf:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Nagaan isiniif haa baayʼatu!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mallattoowwanii fi hojiiwwan dinqii kanneen Waaqni Waan Hundaa Olii naaf godhe isinitti himuun na gammachiisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.2",
            "verseOrgIds": [
              "DAN.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mallattoowwan isaa akkam gurguddaa dha;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "dinqiin isaas akkam jabaa dha!",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "Mootummaan isaa mootummaa bara baraa ti;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "bulchiinsi isaas dhalootaa hamma dhalootaatti jabaatee dhaabata.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani Nebukadnezar natti tolee masaraa mootummaa koottis qananiidhaan mana koo nan jiraadhan ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.4",
            "verseOrgIds": [
              "DAN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani abjuu na sodaachise tokko nan arge. Utuu ani siree koo irra ciisee jiruu fakkii fi mulʼanni qalbii koo keessa darbu na sodaachise.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.5",
            "verseOrgIds": [
              "DAN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani akka isaan abjuu sana naa hiikaniif akka ogeeyyiin Baabilon hundi fuula koo duratti dhiʼeeffaman nan ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.6",
            "verseOrgIds": [
              "DAN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu tolchitoonni, mortoonni, warri urjii ilaalanii fi waa himtoonni dhufanitti abjuu sana isaanitti nan hime; isaan garuu naaf hiikuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.7",
            "verseOrgIds": [
              "DAN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuma irratti Daaniʼel fuula duratti dhiʼaate; anis abjuu sana isatti nan hime. Inni Beelxishaazaari jedhamee maqaa waaqa kootiin waamama; hafuurri waaqota qulqulluu isa keessa ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.8",
            "verseOrgIds": [
              "DAN.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akkanan jedhe; \"Yaa Beelxishaazaari, hangafa tolchitootaa, ani akka hafuurri waaqota qulqulluu si keessa jiru nan beeka; icciitiin kam iyyuu sitti hin ulfaatu. Abjuun ani arge kana; hiikkaa isaa natti himi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.9",
            "verseOrgIds": [
              "DAN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulʼanni utuun siree koo irra ciisee jiruu arge isa kanaa dha: Ani nan ilaale; mukni tokko fuula koo dura walakkaa lafaa dhaabatee ture. Dheerinni isaas guddaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.10",
            "verseOrgIds": [
              "DAN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukni sun akka malee guddatee jabaate; fiixeen isaas samii tuqe; hamma daarii lafaattis ni mulʼata ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.11",
            "verseOrgIds": [
              "DAN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalli isaa bareedaa, iji isaa akka malee baayʼee ture; mukicha irras nyaata waan hundaaf taʼutu ture. Bineensonni gaaddisa isaa jala boqotu; simbirroon samiis dameellee isaa irra jiraatu; lubbuu qabeeyyiin hundinuus isa irraa nyaatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.12",
            "verseOrgIds": [
              "DAN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani mulʼata utuun siree koo irra ciisee jiruu arge sana keessatti nan ilaale; fuula koo duras ergamaa qulqulluu samiidhaa gad buʼaa jiru tokkotu ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.13",
            "verseOrgIds": [
              "DAN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis sagalee guddaadhaan akkana jedhe: 'Mukicha muraa; dameewwan isaa cicciraa; baala isaa harcaasaa; ija isaa bittinneessaa. Bineensonni isa jalaa, simbirroonnis dameewwan isaa irraa haa baqatani.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.14",
            "verseOrgIds": [
              "DAN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gufuu fi hiddi isaa garuu sibiilaa fi naasiidhaan hidhamee lafa keessa, marga dirree keessa haa turu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:15"
      },
      "items": [
        {
          "text": "\" 'Inni fixeensa samiitiin haa jiidhu; biqiltuu keessas bineensota wajjin haa jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qalbiin isaas qalbii namaa irraa geeddaramee qalbiin horii isaaf haa kennamu; kunis hamma waggaan torba darbutti haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.16",
            "verseOrgIds": [
              "DAN.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Akka namni lubbuun jiraatu hundinuu akka Waaqni Waan Hundaa Olii mootummoota namootaa irratti bulchaa taʼee fi akka inni abbaa barbaadeef isaan kennee nama namoota hundaa gad taʼe isaanitti muudu beekaniif ergatamtoonni murtii labsanii qulqulloonni murtoo lallaban.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.17",
            "verseOrgIds": [
              "DAN.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abjuun ani Nebukadnezar mootiin arge kanaa dha. Egaa yaa Beelxishaazaari waan namoota mootummaa kootii qaqqaroo keessaa tokko iyyuu naa hiikuu hin dandeenyeef abjuun sun maal akka taʼe natti himi. Ati garuu sababii hafuurri waaqota qulqulluu si keessa jiruuf ni dandeessa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.18",
            "verseOrgIds": [
              "DAN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s3"
      },
      "items": [
        {
          "text": "Daaniʼel Abjuu Hiikuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Daaniʼel inni Beelxishaazaari jedhamu sun yeroodhaaf akka malee jeeqamee yaadni isaas isa rifachiise. Kanaafuu mootichi, \"Yaa Beelxishaazaar, abjuun kun yookaan hiikkaan isaa si hin rifachiisin\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:19"
      },
      "items": [
        {
          "text": "Beelxishaazaaris akkana jedhee deebise; \"Yaa gooftaa koo abjuun kun warra si jibbaniif, hiikkaan isaa immoo diinota keetiif haa taʼu!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukni ati argite kan akka malee guddatee fi cimaan, kan fiixeen isaa samii tuqee hamma daarii lafaatti mulʼatu,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.20",
            "verseOrgIds": [
              "DAN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kan baalli isaa bareedu, kan ija baayʼee qabu, kan iji isaa waan hundaaf nyaata taʼu, kan bineensotaaf gaaddisa, kan damee isaa irratti simbirroonni samii mandhee ijaarratan,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.21",
            "verseOrgIds": [
              "DAN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaa Mootii, mukni sun siʼi! Ati guddaa fi jabaa taateerta; guddinni kee hamma samii gaʼutti ol baʼee bulchiinsi kees hamma daarii lafaatti balʼata.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.22",
            "verseOrgIds": [
              "DAN.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Mootii, ati ergamaa qulqulluu tokko utuu inni, 'Mukicha muraa balleessaa; gufuu fi hidda isaa garuu sibiilaa fi naasiidhaan hidhaatii lafa keessatti marga dirree irratti dhiisaa; inni fixeensa samiitiin haa jiidhu; akka bineensota bosonaatti haa jiraatu; waggaan torbas isa haa darbu' jechaa samiidhaa buʼu argite.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.23",
            "verseOrgIds": [
              "DAN.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Mootii hiikkaan isaa kana; labsiin Waaqni Waan Hundaa Olii gooftaa koo irratti baases kana:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.24",
            "verseOrgIds": [
              "DAN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati saba keessaa ariʼamtee bineensota bosonaa wajjin jiraatta; akka loonii marga nyaatta; fixeensa samiitiinis ni jiita. Ati hamma akka Waaqni Waan Hundaa Olii mootummoota namootaa irratti bulchaa taʼee fi akka inni mootummoota kanas abbaa barbaadeef kennuu dandaʼu beektutti waggaan torba si darba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.25",
            "verseOrgIds": [
              "DAN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajni akka gufuun muka sanaa hidda isaa wajjin hafuuf kenname sunis akka mootummaan kee yeroo ati ol aantummaan kan samii taʼe beektutti siif deebifamu argisiisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.26",
            "verseOrgIds": [
              "DAN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu yaa Mootii, gorsa koo fudhadhu: Waan qajeelaa hojjechuudhaan cubbuu kee of irraa haqi; hammina kees cunqurfamtootaaf garaa laafuudhaan of irraa balleessi; yoos barri jireenya keetii ni dheerataa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s3"
      },
      "items": [
        {
          "text": "Abjuun Fiixaan Baʼuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun hundi Nebukadnezar Mooticha irra gaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiʼa kudha lama booddee mootichi utuu gubbaa masaraa mootummaa Baabilon irra asii fi achi deddeebiʼaa jiruu,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kun Baabilon guddittii ani akka isheen mana jireenya mootii taatuuf ulfina maqaa kootiif jedhee humna koo jabaadhaan ijaare sanaa mitii?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu inni dubbii isaa afaanii hin fixatin sagaleen akkana jedhu tokko samiidhaa dhufe; \"Yaa Nebukadnezar Mooticha, wanni sirratti labsame kana: Aangoon mootummaa keetii sirraa fudhatameera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati uummata keessaa ariʼamtee bineensota bosonaa wajjin jiraatta. Akka looniis marga nyaatta. Hamma ati akka Waaqni Waan Hundaa Olii mootummoota namootaa irratti Gooftaa taʼee fi akka inni mootummoota sana abbaa fedheef kennu beektutti waggaan torba si darba.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommusuma wanni waaʼee Nebukadnezar dubbatame sun ni raawwatame. Innis uummata keessaa ariʼamee akka loonii marga nyaate. Inni hamma rifeensi isaa akka baallee risaa guddatee qeensi isaa akka qeensa allaattii fakkaatutti dhagni isaa fixeensa samiitiin jiidhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuma yeroon sanaatti, ani Nebukadnezar gara samii ol nan ilaale; qalbiin koos naa deebiʼe. Anis Waaqa Waan Hundaa Olii nan galateeffadhe; isa bara baraan jiraatus nan jajadhe; ulfinas nan kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "Bulchiinsi isaa bulchiinsa bara baraa ti;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "mootummaan isaas dhalootaa hamma dhalootaatti itti fufee dhaabata.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uummanni lafaa hundi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "wayittuu hin hedaman.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "Inni humnoota samii irratti,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "namoota lafaa irrattis,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "waanuma fedhe hojjeta.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "Namni harka isaa dhowwuu yookaan \"Ati maal hojjechaa jirta?\" jedhee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "isa gaafachuu dandaʼu tokko iyyuu hin jiru.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma qalbiin koo naaf deebiʼeenis, ulfina mootummaa kootiitiif ulfinnii fi miidhaginni koo yommusuma naaf deebiʼan. Gorsitoonnii fi qondaaltonni koo na barbaadan; anis teessoo kootti deebifamee kan durii caalaas guddaa nan taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii wanni inni hojjetu hundi dhugaa, karaan isaa hundinuus qajeelaa taʼeef ani Nebukadnezar, Mooticha samii sana nan jajadha; isa nan leellisa; ulfinas nan kennaaf. Inni warra of tuulan gad deebisuu dandaʼaatii.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
      ]
    }
  ],
