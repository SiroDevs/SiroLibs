          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ixaan torbaffaan gosa Daaniif balbala balbalaan baʼe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyi isaan Dhaalanis:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:41"
      },
      "items": [
        {
          "text": "Zoraa, Eshitaaʼol, Iir Shemeshi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
