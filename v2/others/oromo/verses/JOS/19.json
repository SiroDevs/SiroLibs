          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunneen biyyoota Eleʼaazaar lubichi, Iyyaasuun ilmi Nuunitii fi hangafoonni gosoota Israaʼel Shiilootti fuula",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text"
            }
          ]
        },
        {
          "text": "duratti balbala dunkaana wal gaʼii irratti ixaadhaan kennanii dha. Isaanis akkasiin biyyattii qooduu xumuran.",
          "type": "text"
        }
      ]
    }
