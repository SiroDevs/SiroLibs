          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elteqee, Gibetoon, Baaʼilaati,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuud, Benee Beraaq, Gat Rimoon,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meyaarqoonii fi Raqoon Yoopheetti garagalee argamu sanaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen Daan garuu sababii lafti dhaalan sun isaanitti dhiphatteef ol baʼanii Lesheemin waraananii qabatan; erga goraadeedhaan dhaʼanii booddee ishee dhuunfatan. Isaanis Lesheem keessa qubatanii Daan jedhanii maqaa abbaa isaaniitiin ishee moggaasan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan kunneenii fi gandoonni isaanii dhaala gosti Daan balbala balbalaan argatee dha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qooda Iyyaasuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 19:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonnis erga biyyattii ixaadhaan qoodamte sana hiranii fixanii booddee gidduu isaaniitti Iyyaasuu ilma Nuunitiif dhaala kennan;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "dhaala kanas akkuma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.19.50",
                "verseOrgIds": [
                  "JOS.19.50"
                ]
              }
            }
          ]
        },
        {
          "text": "ajajetti kennan. Isaanis magaalaa inni gaafatee kennaniif; magaalaan sunis Timnaat Seeraa kan biyya gaaraa Efreemitti argamtuu dha. Innis magaalaa sana ijaaree keessa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
