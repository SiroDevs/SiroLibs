  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOS 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aduun Idduma Jirtu Dhaabatte",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoonii-Zedeq Mootiin Yerusaalem akka Iyyaasuun Aayin qabatee guutumaan guutuutti barbadeesse, akka inni akkuma Yerikoo fi mootii ishee godhe sana Aayii fi Mootii ishee godhe, akkasumas akka namoonni Gibeʼoon Israaʼeloota wajjin walii galtee nagaa godhatanii isaan bira jiraatan dhagaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.1",
            "verseOrgIds": [
              "JOS.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii magaalaan Gibeʼoon akkuma magaalaa moototaa tokkootti magaalaa hangafa taateef innii fi namoonni isaa akka malee rifatan; magaalaan Gibeʼoon magaalaa Aayi caalaa guddoo turte; namoonni ishees loltoota jajjaboo turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.2",
            "verseOrgIds": [
              "JOS.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Adoonii-Zedeq mootichi Yerusaalem sun Hoohaam mooticha Kebroonitti, Phiraam mooticha Yarmuutitti, Yaafiiyaa mooticha Laakkiishii fi Debiir mooticha Egloonitti ergee,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.3",
            "verseOrgIds": [
              "JOS.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sababii isheen Iyyaasuu fi Israaʼel wajjin walii galtee nagaa godhatteef ol kottaatii Gibeʼoonin waraanuu na gargaaraa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.4",
            "verseOrgIds": [
              "JOS.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootonni Amoorotaa shananuu jechuunis mootiin Yerusaalem, mootiin Kebroon, mootiin Yarmuut, mootiin Laakkiishii fi mootiin Egloon humna waraanaa walitti dabalatan. Isaanis loltoota isaanii hunda fudhatanii ol baʼanii Gibeʼoonin marsanii waraanan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.5",
            "verseOrgIds": [
              "JOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Gibeʼoonis qubata Gilgaal gara Iyyaasuutti ergaa erganii akkana jedhaniin; \"Ati garboota kee hin dhiisin. Dafii nu qaqqabiitii nu oolchi; sababii mootonni Amoorotaa kanneen biyya gaaraa keessa jiraatan hundi nu waraanuuf loltoota walitti dabalataniif nu gargaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.6",
            "verseOrgIds": [
              "JOS.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Iyyaasuun loltoota isaa hunda wajjin, namoota waraanaa jajjabeeyyii hundas dabalatee Gilgaalii ol baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.7",
            "verseOrgIds": [
              "JOS.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.8",
                "verseOrgIds": [
                  "JOS.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Iyyaasuudhaan, \"Isaan hin sodaatin; ani harka keetti dabarsee isaan kenneera. Tokkoon isaanii iyyuu fuula kee dura dhaabachuu hin dandaʼan\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.8",
            "verseOrgIds": [
              "JOS.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Iyyaasuun Gilgaalii baʼee halkan guutuu deemaa bulee tasuma isaanitti dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.9",
            "verseOrgIds": [
              "JOS.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.10",
                "verseOrgIds": [
                  "JOS.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula Israaʼelootaa duratti isaan burjaajesse; Israaʼeloonnis Gibeʼoonitti moʼannaa guddaadhaan isaan moʼatan. Karaa Beet Horoonitti geessu irra isaan ariʼaa hamma Azeeqaa fi Maqeedaatti isaan gogorraʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.10",
            "verseOrgIds": [
              "JOS.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma isaan Israaʼeloota duraa karaa Beet Horooniin gara Azeeqaatti gad baqachaa jiranuu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.11",
                "verseOrgIds": [
                  "JOS.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "samiidhaa cabbii gurguddaa itti roobse; warra goraadee Israaʼelootaatiin dhuman caalaa kanneen cabbii kanaan dhumanitu baayʼata.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.12",
                "verseOrgIds": [
                  "JOS.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Amoorota dabarsee Israaʼelootatti kenne sana Iyyaasuun fuula Israaʼelootaa duratti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.12",
                "verseOrgIds": [
                  "JOS.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 10:12"
      },
      "items": [
        {
          "text": "\"Yaa aduu, Gibeʼoon gubbaa dhaabadhu;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:12"
      },
      "items": [
        {
          "text": "yaa jiʼa, atis Sulula Ayaaloon gubbaa dhaabadhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu hamma sabni diinota isaa haaloo baafatutti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "aduun idduma jirtu dhaabatte;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "jiʼis ni dhaabate;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "wanni kun Kitaaba Yaashaar keessatti barreeffameera mitii?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 10:13"
      },
      "items": [
        {
          "text": "Aduun walakkaa samii keessa dhaabattee guyyaa tokko guutuu utuu hin dhiʼin turte.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaan",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.14",
                "verseOrgIds": [
                  "JOS.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nama dhagaʼe kan akkasii gaafasiin dura yookaan ergasii takkumaa taʼee hin beeku.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.14",
                "verseOrgIds": [
                  "JOS.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dhugumaan Israaʼeliif lolaa ture!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Iyyaasuun Israaʼeloota hunda wajjin qubata Gilgaal jiru sanatti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.15",
            "verseOrgIds": [
              "JOS.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mootonni Amoorotaa Shanan Ajjeefaman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootonni shanan sun baqatanii holqa Maqeedaa keessatti dhokatanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.16",
            "verseOrgIds": [
              "JOS.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka mootonni shanan holqa Maqeedaa keessatti dhokatan Iyyaasuutti himame;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.17",
            "verseOrgIds": [
              "JOS.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis akkana jedhe; \"Dhagaa guddaa isaa afaan holqa sanaatti gangalchaatii akka isaan eeganiif namoota achitti ramadaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.18",
            "verseOrgIds": [
              "JOS.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin diinota keessan ariʼaatii karaa dugda duubaatiin rukutaa malee hin dhaabatinaa! Sababii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.19",
            "verseOrgIds": [
              "JOS.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.19",
                "verseOrgIds": [
                  "JOS.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan dabarsee harka keessanitti isaan kenneef akka isaan magaalaawwan isaanii seenan hin godhinaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.19",
            "verseOrgIds": [
              "JOS.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Iyyaasuu fi Israaʼeloonni hamma namni muraasni hafutti guutumaan guutuutti isaan barbadeessan. Warri hafan immoo magaalaawwan isaanii kanneen jajjabeeffamanii ijaaramanitti galan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.20",
            "verseOrgIds": [
              "JOS.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonni hundi nagumaan gara qubata Maqeedaa gara Iyyaasuutti deebiʼan; namni tokko iyyuu afaan isaa Israaʼelootatti hin bananne.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.21",
            "verseOrgIds": [
              "JOS.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis, \"Mee afaan holqa sanaa banaatii mootota shanan sana gad naa baasaa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.22",
            "verseOrgIds": [
              "JOS.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis mootota shanan sana jechuunis mootii Yerusaalem, mootii Kebroon, mootii Yarmuut, mootii Laakkiishii fi mootii Egloon holqa keessaa baasanii fidan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.23",
            "verseOrgIds": [
              "JOS.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isaan mootota kana shanan Iyyaasuutti fidan, inni namoota Israaʼel hunda walitti waamee ajajjoota loltootaa kanneen isa wajjin dhufaniin, \"Kottaatii miilla keessaniin morma mootota kanneenii irra ejjadhaa\" jedhe. Isaanis gara fuula duraatti baʼanii miilla isaaniitiin morma mootota sanaa irra ejjetan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.24",
            "verseOrgIds": [
              "JOS.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun, \"Hin sodaatinaa; abdiis hin kutatinaa. Jabaadhaa; cimaas. Wanni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.25",
            "verseOrgIds": [
              "JOS.10.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.25",
                "verseOrgIds": [
                  "JOS.10.25"
                ]
              }
            }
          ]
        },
        {
          "text": "diinota isin loluuf deemtan hunda irratti godhuuf jirus kanuma\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.25",
            "verseOrgIds": [
              "JOS.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun ergasii mootota sana dhaʼee ajjeesee mukkeen shan irratti isaan fannise; isaanis hamma lafti galgalooftutti akkuma muka irratti fannifamanitti turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.26",
            "verseOrgIds": [
              "JOS.10.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo aduun dhiitetti Iyyaasuun ajaja kenne; jarris mukkeen irraa gad isaan buusanii holqa isaan keessa dhokatanii turan sanatti isaan daddarbatan. Afaan holqa sanaa irras dhagaa gurguddaa hamma guyyaa harʼaatti illee achuma jiru naqan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.27",
            "verseOrgIds": [
              "JOS.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis guyyuma sana Maqeedaa qabate. Innis magaalaa sanaa fi mootii ishee goraadeedhaan dhaʼee nama achi keessa jiru hunda fixe. Nama tokko iyyuu hin hambifne. Mootii Maqeedaas akkuma mootii Yerikoo godhe sana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magaalaawwan Kibbaa Qabaman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuu fi Israaʼeloonni isa wajjin turan hundi Maqeedaadhaa baʼanii dhaqanii Libnaa lolan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.30",
                "verseOrgIds": [
                  "JOS.10.30"
                ]
              }
            }
          ]
        },
        {
          "text": "magaalaa sanaa fi mootii ishee dabarsee harka Israaʼelootaatti kenne. Iyyaasuun magaalattii fi nama ishee keessa jiru hunda goraadeedhaan fixe. Inni nama tokko illee achitti hin hambifne. Mootii ishee illee akkuma mootii Yerikoo godhe sana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuu fi Israaʼeloonni hundi isa wajjin Libnaadhaa kaʼanii Laakkiish dhaqan; isaanis magaalaa sana marsanii waraanan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.32",
                "verseOrgIds": [
                  "JOS.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Laakkiish dabarsee harka Israaʼelootaatti kenne; Iyyaasuunis guyyaa lammaffaatti ishee qabate. Akkuma Libnaa godhe sana magaalaa sanaa fi warra ishee keessa jiraatan hunda goraadeedhaan fixe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti Hooraam mootichi Geezir, Laakkiish gargaaruudhaaf dhufee ture; Iyyaasuun garuu isaa fi loltoota isaa ni moʼate; namni tokko iyyuu hin hafne.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.33",
            "verseOrgIds": [
              "JOS.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Iyyaasuu fi Israaʼeloonni hundi Laakkiishii kaʼanii gara Egloon dhaqan; marsaniis ishee waraanan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.34",
            "verseOrgIds": [
              "JOS.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyuma sana ishee qabatanii akkuma Laakkiish godhan sana ishee fi nama ishee keessa jiru hunda goraadeedhaan fixan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuu fi Israaʼeloonni hundis isa wajjin Egloonii kaʼanii gara Kebroonitti ol baʼanii ishee waraanan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis magaalattii qabatanii mootii ishee, gandoota isheetii fi nama ishee keessa jiru hunda goraadeedhaan fixan. Nama tokko iyyuu hin hambifne. Akkuma Egloon godhan sana ishee fi nama ishee keessa jiru hunda guutumaan guutuutti barbadeessan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Iyyaasuu fi Israaʼeloonni hundi isa wajjin of irra deebiʼanii Debiirin dhaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis magaalattii, mootii isheetii fi gandoota ishee qabatanii goraadeedhaan fixan. Namoota ishee keessa jiraatan hundas guutumaan guutuutti fixan. Nama tokko iyyuu hin hambifne. Akkuma Libnaa, mootii isheetii fi Kebroon godhan sana Debiirii fi mootii ishee godhan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis akkasiin guutummaa biyya sanaa, biyya gaaraa, Negeebi, biyya gammoojjii, tabbawwan tulluutii fi mootota isaanii hundas moʼate. Inni akkuma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.40",
                "verseOrgIds": [
                  "JOS.10.40"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel ajajetti waan hafuura baafatu hunda guutumaan guutuutti balleesse malee nama tokko illee hin hambifne.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun Qaadesh Barnee irraa jalqabee hamma Gaazaatti, guutummaa biyya Gooshen hamma Gibeʼoonitti qabate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.10.42",
                "verseOrgIds": [
                  "JOS.10.42"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel Israaʼeliif loleef Iyyaasuun mootota kanneenii fi lafa isaanii loluma tokkoon moʼate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Iyyaasuun Israaʼeloota hunda wajjin gara qubata Gilgaalitti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.43",
            "verseOrgIds": [
              "JOS.10.43"
            ]
          }
        }
      ]
    }
