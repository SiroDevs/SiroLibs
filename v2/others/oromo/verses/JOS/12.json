    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maqaa Mootota Moʼatamanii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Kunneen mootota Israaʼeloonni moʼatanii biyyoota isaanii jechuunis gama baʼa Arabbaa hunda dabalatee, baʼa Yordaanos, Sulula Arnooniitii hamma Tulluu Hermoonitti irraa fudhatanii dha:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihoon mootiin Amoorotaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 12:2"
      },
      "items": [
        {
          "text": "Heshboon keessa taaʼee Aroʼeer ishee qarqara sulula Arnoonitti argamtu sanaa jalqabee hamma Laga Yaaboq kana daarii Amoonotaatti bulchaa ture; kunis walakkaa Giliʼaad dabalata.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas baʼa Arabbaa Galaana Kinereetiitii jalqabee hamma Galaana Arabbaa yookaan Galaana Soogiddaatti, hamma Beet Yashiimootitti, achii immoo karaa Kibbaatiin hamma tabba Phisgaatti bulchaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oogi mootichi Baashaan kan sanyii Refaayim keessaa isa dhumaa taʼe sun Ashtaarotii fi Edreyii bulchaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.4",
            "verseOrgIds": [
              "JOS.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Tulluu Hermoon, Salkaa, guutummaa Baashaan hamma Geshuurotaattii fi Maʼakaataatti, walakkaa Giliʼaad immoo hamma daangaa Sihoon mooticha Heshboonitti bulchaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen garbichi",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text"
            }
          ]
        },
        {
          "text": "fi Israaʼeloonni isaan moʼatan. Museen garbichi",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text"
            }
          ]
        },
        {
          "text": "biyya isaanii Ruubeenotaaf, gosa Gaadiitii fi walakkaa gosa Minaaseetiif dhaala godhee kenne.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootonni biyya Iyyaasuu fi Israaʼeloonni Yordaanosiin gama lixa biiftuutti moʼatanii kanneenii dha: biyyi isaaniis Baʼaal Gaad Sulula Libaanoon keessa jirtu sanaa jalqabee hamma Tulluu Halaaq kan gara Seeʼiir lafa Iyyaasuun akkuma gosa gosa isaaniitti dhaala godhee Israaʼelootaaf kenne sanaatti ol kaʼuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyoonni kunneenis biyya gaaraa, biyya karaa lixaa, Arabbaa, tabba tulluu, lafa alootii fi Negeebi jechuunis biyyoota Heetotaa, Amoorotaa, Kanaʼaanotaa, Feerzotaa, Hiiwotaatii fi Yebuusotaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOS 12:8"
      },
      "items": []
    },
