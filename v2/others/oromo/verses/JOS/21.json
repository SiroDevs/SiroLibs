          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan Lewwotaa kanneen biyya Israaʼeloonni dhuunfatan keessatti argaman lafa tikaa wajjin walumaa galatti afurtamii saddeet turan.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoon tokkoon magaalaawwan kanneenii naannoo isaaniitii lafa tikaa qabu turan; magaalaawwan hundinuu akkanuma.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
