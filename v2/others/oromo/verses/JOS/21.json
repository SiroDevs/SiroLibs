      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:28"
      },
      "items": [
        {
          "text": "Kishoon, Daaberaati,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
