          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosoota Geershoonotaatiif immoo magaalaawwan kudha sadiitu lafa tikaa wajjin kenname.",
          "type": "text"
        }
      ]
    },
