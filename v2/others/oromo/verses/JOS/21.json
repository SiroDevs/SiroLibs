      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:32"
      },
      "items": [
        {
          "text": "Qaadesh ishee Galiilaa keessaa, magaalaan namni nama ajjeesee himatamu tokko itti kooluu galuu akkasumas Hamoot Doorii fi Qartaan, magaalaawwan sadii lafa tikaa isaanii wajjin kennameef.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.32",
            "verseOrgIds": [
              "JOS.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
