    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangafoonni maatii Lewwotaa Eleʼaazaar lubichatti, Iyyaasuu ilma Nuunittii fi hangafoota maatiiwwan gosoota Israaʼel kaanitti dhiʼaatanii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.1",
            "verseOrgIds": [
              "JOS.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiiloo Kanaʼaan keessatti argamtu sana keessatti, \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.2",
                "verseOrgIds": [
                  "JOS.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akka isin magaalaa nu keessa jiraannu lafa tikaa kan horii keenyaaf taʼu wajjin nuu kennitan karaa Museetiin ajajee ture\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Israaʼeloonni akkuma",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text"
            }
          ]
        },
        {
          "text": "ajajetti dhaala ofii isaanii keessaa magaalaawwan kanneenii fi lafa tikaa Lewwotaaf kennan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ixaan jalqabaa gosa Qohaatiif balbala balbalaan baʼe. Lewwota sanyii Aroon lubichaatiifis gosa Yihuudaa, gosa Simiʼoonii fi gosa Beniyaam keessaa magaalaawwan kudha sadii ixaadhaan argatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.4",
            "verseOrgIds": [
              "JOS.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii Qohaati warra hafaniif immoo balbala gosa Efreem, gosa Daanii fi walakkaa gosa Minaasee keessaa magaalaawwan kudhan ixaadhaan argatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyiiwwan Geershooniif balbala gosa Yisaakor, gosa Aasheer, gosa Niftaalemii fi walakkaa gosa Minaasee kan Baashaan keessaa sana irraa magaalaawwan kudha sadii ixaadhaan argatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.6",
            "verseOrgIds": [
              "JOS.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyiiwwan Meraariis balbala balbalaan gosa Ruubeen, gosa Gaadii fi gosa Zebuuloon keessaa magaalaawwan kudha lama ixaadhaan argatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.7",
            "verseOrgIds": [
              "JOS.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Israaʼeloonni akkuma",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text"
            }
          ]
        },
        {
          "text": "karaa Museetiin ajaje sanatti magaalaawwan kanneenii fi lafa tikaa ixaadhaan Lewwotaaf kennan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa Yihuudaa fi gosa Simiʼoon irraa magaalaawwan kanneen maqaa maqaadhaan qoodan;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.9",
            "verseOrgIds": [
              "JOS.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sababii ixaan jalqabaa isaaniif baʼeef magaalaawwan kunneen sanyiiwwan Aroon warra Lewwotaa keessaa balbala Qohaati taʼaniif kennaman:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.10",
            "verseOrgIds": [
              "JOS.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Kiriyaati Arbaaq jechuunis Kebroon ishee biyya gaaraa Yihuudaa keessaa sana lafa tikaa naannoo ishee wajjin kennaniif. Arbaaq abbaa Anaaq ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.11",
            "verseOrgIds": [
              "JOS.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa qotiisaa fi gandoota naannoo magaalattii jiran garuu Kaaleb ilma Yefuneetiif handhuuraa godhanii kennan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.12",
            "verseOrgIds": [
              "JOS.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu sanyiiwwan Aroon lubichaatiif Kebroon jechuunis magaalaa namni nama ajjeesee himatamu tokko itti baqatuu fi Libnaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.13",
            "verseOrgIds": [
              "JOS.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatiir, Eshtimoʼaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.14",
            "verseOrgIds": [
              "JOS.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hooloon, Debiir,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.15",
            "verseOrgIds": [
              "JOS.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aayin, Yutaanii fi Beet Shemeshi lafa tikaa wajjin kennameef; isaan kunneen magaalaawwan sagallan gosoota lamaan irraa qoodamaniifii dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.16",
            "verseOrgIds": [
              "JOS.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa Beniyaam irraas",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.17",
            "verseOrgIds": [
              "JOS.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:17"
      },
      "items": [
        {
          "text": "Gibeʼoon, Gebaaʼi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.17",
            "verseOrgIds": [
              "JOS.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaatootii fi Almoon lafa tikaa wajjin kennaniif; isaanis magaalaawwan afurii dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.18",
            "verseOrgIds": [
              "JOS.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan lafa tikaa wajjin sanyiiwwan Aroon kanneen luboota taʼaniif kennaman hundi kudha sadii turan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qohaatota balbala Lewwii warra hafaniif gosa Efreem irraa magaalaawwan kanneentu ixaadhaan argatan:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis biyya gaaraa Efreem keessaa Sheekem jechuunis",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.21",
            "verseOrgIds": [
              "JOS.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:21"
      },
      "items": [
        {
          "text": "magaalaa namni nama ajjeesee himatamu itti baqatu sanaa fi Geezir,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.21",
            "verseOrgIds": [
              "JOS.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qibxaayimii fi Beet Horoon, walumatti magaalaawwan afur lafa tikaa wajjin fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.22",
            "verseOrgIds": [
              "JOS.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas gosa Daan keessaa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.23",
            "verseOrgIds": [
              "JOS.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:23"
      },
      "items": [
        {
          "text": "Elteqee, Gibetoon,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.23",
            "verseOrgIds": [
              "JOS.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayaaloonii fi Gat Rimoon, walumaa galatti magaalaawwan afur lafa tikaa wajjin fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.24",
            "verseOrgIds": [
              "JOS.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walakkaa gosa Minaasee keessaa immoo",
          "type": "text",
          "attrs": {
