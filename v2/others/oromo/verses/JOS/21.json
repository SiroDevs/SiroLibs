      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:38"
      },
      "items": [
        {
          "text": "Raamooti ishee Giliʼaad keessaa jechuunis magaalaa namni nama ajjeesee himatamu tokko itti kooluu galu, Mahanayiim,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heshboonii fi Yaʼizeer, walumaa galatti magaalaawwan afurtu lafa tikaa wajjin kennameef.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
            "verseOrgIds": [
              "JOS.21.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwota hafan warra balbala Meraarii taʼaniif walumaa galatti magaalaawwan kudha lamatu ixaadhaan kenname.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
