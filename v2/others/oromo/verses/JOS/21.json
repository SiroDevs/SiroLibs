      "attrs": {
        "style": "li2",
        "vid": "JOS 21:30"
      },
      "items": [
        {
          "text": "Mishiʼaal, Abdoon,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
              "JOS.21.30"
            ]
          }
