            "style": "v",
            "sid": "JOS 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.43",
                "verseOrgIds": [
                  "JOS.21.43"
                ]
              }
            }
          ]
        },
        {
          "text": "biyya abbootii isaaniitiif kennuuf kakate hunda saba Israaʼeliif kenne; isaanis biyya sana qabatanii achi jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.44",
                "verseOrgIds": [
                  "JOS.21.44"
                ]
              }
            }
          ]
        },
        {
          "text": "akkuma abbootii isaaniitiif kakate sana karaa hundaan boqonnaa isaanii kenne. Diinni isaanii tokko iyyuu fuula isaanii dura dhaabachuu hin dandeenye;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.44",
                "verseOrgIds": [
                  "JOS.21.44"
                ]
              }
            }
          ]
        },
        {
          "text": "diinota isaanii hunda dabarsee harka isaaniitti kenne.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waadaa gaarii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.21.45",
                "verseOrgIds": [
                  "JOS.21.45"
                ]
              }
            }
          ]
        },
        {
          "text": "mana Israaʼeliif gale keessaa tokko iyyuu hin hafne; hundinuu guutameera.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
