              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qidemootii fi Meefiʼaat, magaalaawwan afur lafa tikaa wajjin kennameef;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
          }
