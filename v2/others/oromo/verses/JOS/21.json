          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarmuutii fi Een Ganiim, magaalaawwan afurii fi lafa tikaa isaaniitu kennameef;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.29",
            "verseOrgIds": [
              "JOS.21.29"
            ]
          }
        }
      ]
