      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:27"
      },
      "items": [
        {
          "text": "Goolaan ishee Baashaan keessaa jechuunis magaalaa namni nama ajjeesee himatamu tokko itti baqatu sanaa fi Beʼeshitiraa, magaalaawwan lamaa fi lafa tikaa isaaniitu kennameef;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.27",
            "verseOrgIds": [
              "JOS.21.27"
            ]
          }
        }
      ]
    },
