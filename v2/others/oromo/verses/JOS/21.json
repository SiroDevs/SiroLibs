        "vid": "JOS 21:25"
      },
      "items": [
        {
          "text": "Taʼanaakii fi Gat Rimoon, magaalaawwan lama lafa tikaa wajjin fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.25",
            "verseOrgIds": [
