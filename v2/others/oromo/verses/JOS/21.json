          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimnaa fi Naahaalal, magaalaawwan afurtu lafa tikaa wajjin kenname;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.35",
            "verseOrgIds": [
              "JOS.21.35"
            ]
          }
        }
