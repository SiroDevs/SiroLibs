          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaalaawwan kurnan kunneen hundii fi lafti tikaa isaanii balbala gosa Qohaati warra hafaniif kennaman.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
