          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus yommuu tuuta namoota baayʼee naannoo isaatti argetti akka gama ceʼaniif ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.18",
            "verseOrgIds": [
              "MAT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barsiisaan seeraa tokkos gara isaa dhufee, \"Yaa barsiisaa, ani iddoo ati dhaqxu hundatti si duukaa nan buʼa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.19",
            "verseOrgIds": [
              "MAT.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis deebisee,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.20",
            "verseOrgIds": [
              "MAT.8.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waangoonni boolla qabu; simbirroonnis manʼee qabu; Ilmi Namaa garuu iddoo itti mataa isaa irkifatu illee hin qabu\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.20",
                "verseOrgIds": [
                  "MAT.8.20"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.20",
            "verseOrgIds": [
              "MAT.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoota isaa keessaas inni tokko, \"Yaa Gooftaa, dura akka ani dhaqee abbaa koo awwaalladhu naa eeyyami!\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
            "verseOrgIds": [
              "MAT.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus garuu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.22",
            "verseOrgIds": [
              "MAT.8.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Warri duʼan duʼaa isaanii haa awwaallatan; ati immoo na duukaa buʼi\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.22",
                "verseOrgIds": [
                  "MAT.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.22",
            "verseOrgIds": [
              "MAT.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Bubbee Jabaa Gab gochuu Isaa",
          "type": "text"
        }
      ]
    },
