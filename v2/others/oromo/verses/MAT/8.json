    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu inni bidiruu yaabbatettis, barattoonni isaa isa duukaa buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.23",
            "verseOrgIds": [
              "MAT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma tasaa bubbeen hamaan tokko galaana irratti kaʼe; dambaliinis bidiruu sana irra gara gale. Yesuus garuu rafaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.24",
            "verseOrgIds": [
              "MAT.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonni isaa gara isaa dhufanii, \"Yaa Gooftaa, nu oolchi! Nu dhumuufii!\" jedhanii isa dammaqsan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.25",
            "verseOrgIds": [
              "MAT.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis deebisee,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin warra amantii xinnoo nana; maaliif akkana sodaattu?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.8.26",
                "verseOrgIds": [
                  "MAT.8.26"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen. Kaʼees bubbee sanaa fi galaana sana ifate; tasgabbiin guddaanis ni taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonnis dinqifatanii, \"Namni bubbee fi galaanni ajajamaniif kun nama akkamii ti?\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.27",
            "verseOrgIds": [
              "MAT.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Namoota Hafuura Hamaan Qabaman Fayyisuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
