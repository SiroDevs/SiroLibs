          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani furtuu mootummaa samii siifin kenna; wanni ati lafa irratti hiitu kam iyyuu samii irratti ni hidhama; wanni ati lafa irratti hiiktu kam iyyuu samii irrattis ni hiikama.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.19",
                "verseOrgIds": [
                  "MAT.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
