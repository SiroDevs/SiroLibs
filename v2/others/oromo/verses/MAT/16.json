        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mallattoon Gaafatamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.16.1-MAT.16.12"
          },
          "items": [
            {
              "text": "16:1‑12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MRK.8.11-MRK.8.21"
              },
              "items": [
                {
                  "text": "Mar 8:11‑21",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnii fi Saduuqonni gara Yesuus dhufanii akka inni samii irraa mallattoo isaan argisiisu gaafachuudhaan isa qoran.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
              "MAT.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee deebise;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin yeroo galgalaaʼutti, 'Samiin diimateera; caama taʼa' jettu;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.2",
                "verseOrgIds": [
                  "MAT.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ganama immoo, 'Samiin diimatee duumessaaʼeeraatii harʼa bokkaan jabaan ni rooba' jettu. Isin bifa samii addaan baasuu ni beektu; garuu mallattoo baraa addaan baasuu hin dandeessan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.3",
                "verseOrgIds": [
                  "MAT.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.3",
            "verseOrgIds": [
              "MAT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dhaloonni hamaa fi ejjaan mallattoo barbaada; garuu mallattoo Yoonaas malee mallattoon hin kennamuuf.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.4",
                "verseOrgIds": [
                  "MAT.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Yesuusis isaan dhiisee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Raacitii Fariisotaatii fi Saduuqotaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonni yommuu galaanicha ceʼanitti buddeena fudhachuu irraanfatan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.5",
            "verseOrgIds": [
              "MAT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Beekkadhaa; raacitii Fariisotaatii fi Saduuqotaa irraa of eeggadhaa\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.6",
                "verseOrgIds": [
                  "MAT.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "isaaniin jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Kun sababii nu buddeena hin fidatiniif\" jedhanii waan kana walii wajjin haasaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.7",
            "verseOrgIds": [
              "MAT.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis waan isaan haasaʼan beekee akkana jedhee gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa warra amantii xinnoo nana, isin maaliif waaʼee buddeena dhabuu keessanii walii wajjin dudubbattu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.8",
                "verseOrgIds": [
                  "MAT.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin amma iyyuu hin hubattanii? Buddeenni shan nama kuma shaniif dhiʼeeffamee gundoo hammam guutuu akka walitti qabdan hin yaadattanii?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.9",
                "verseOrgIds": [
                  "MAT.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.9",
            "verseOrgIds": [
              "MAT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yookaan buddeenni torba nama kuma afuriif dhiʼeeffamee hambaa gundoo hammam guutuu akka walitti qabdan hin yaadattanii?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.10",
                "verseOrgIds": [
                  "MAT.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.10",
            "verseOrgIds": [
              "MAT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akka ani waaʼee buddeenaa isinitti dubbachaa hin turin isin akkamitti hin hubanne? Garuu raacitii Fariisotaatii fi Saduuqotaa irraa of eeggadhaa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.11",
                "verseOrgIds": [
                  "MAT.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.11",
            "verseOrgIds": [
              "MAT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis ergasii akka inni akka isaan raacitii buddeenaa irraa of eeggataniif utuu hin taʼin akka barsiisa Fariisotaatii fi Saduuqotaa irraa of eeggataniif isaanitti himaa ture hubatan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phexros Eenyummaa Kiristoos Beeksise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.16.13-MAT.16.16"
          },
          "items": [
            {
              "text": "16:13‑16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MRK.8.27-MRK.8.29"
              },
              "items": [
                {
                  "text": "Mar 8:27‑29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.9.18-LUK.9.20"
              },
              "items": [
                {
                  "text": "Luq 9:18‑20",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus yeroo gara biyya Fiiliphoos Qiisaariyaa dhufetti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namoonni Ilma Namaatiin eenyu jedhu?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.13",
                "verseOrgIds": [
                  "MAT.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee barattoota isaa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Namoonni tokko tokko inni Yohannis Cuuphaa dha jedhu; warri kaan inni Eeliyaas jedhu; kaan immoo inni Ermiyaas yookaan raajota keessaa isa tokko dha jedhu\" jedhanii deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.15",
            "verseOrgIds": [
              "MAT.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin hoo? Eenyu anaan jettu?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.15",
                "verseOrgIds": [
                  "MAT.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.15",
            "verseOrgIds": [
              "MAT.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoon Phexrosis, \"Ati Kiristoos, Ilma Waaqa jiraataa ti\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo akkana jedhee deebiseef;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa Simoon ilma Yoonaa, ati eebbifamaa dha; kana abbaa koo isa samii irraatu siif ibse malee nama miti.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.17",
                "verseOrgIds": [
                  "MAT.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.17",
            "verseOrgIds": [
              "MAT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani sittin hima; ati Phexrosii dha; kattaa kana irratti waldaa kiristaanaa koo nan ijaara; karri gahaannamis ishee hin moʼatu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.16.18",
                "verseOrgIds": [
                  "MAT.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 16:19"
          },
          "items": [
