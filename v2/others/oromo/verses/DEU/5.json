      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen Israaʼeloota hunda walitti qabee akkana isaaniin jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DEU 5:1"
      },
      "items": [
        {
          "text": "Yaa Israaʼel ajajawwanii fi seerawwan ani harʼa utuma isin dhageessanuu labsu kana dhagaʼaa. Baradhaatii jabeessaa isaan duukaa buʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.2",
                "verseOrgIds": [
                  "DEU.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keenya Kooreebitti nu wajjin kakuu gale.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.3",
                "verseOrgIds": [
                  "DEU.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kakuu kana nu wajjin, nu warra harʼa lubbuudhaan as jiraannu hunda wajjin gale malee abbootii keenya wajjin hin galle.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.4",
                "verseOrgIds": [
                  "DEU.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "tulluu irratti ibidda keessaa ifaan ifatti isinitti dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.4",
            "verseOrgIds": [
              "DEU.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti waan isin ibidda sodaattanii tulluutti ol hin baʼiniif ani dubbii",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.5",
                "verseOrgIds": [
                  "DEU.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "isinitti himuuf isinii fi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.5",
                "verseOrgIds": [
                  "DEU.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "gidduun dhaabadhe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DEU 5:5"
      },
      "items": [
        {
          "text": "Innis akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa kee kan Gibxii, biyya garbummaatii si baasee dha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati ana malee waaqota biraa tokko illee hin qabaatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.7",
            "verseOrgIds": [
              "DEU.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati bifa waan ol samii gubbaa yookaan gad lafa irra yookaan bishaan lafa jalaa keessa jiru waaqa tolfamaa kamiitiin iyyuu ofii keetiif hin tolfatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaniif hin sagadin yookaan isaan hin waaqeffatin; ani",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.9",
                "verseOrgIds": [
                  "DEU.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee, Waaqa hinaafu kan ijoollee warra na jibbanii sababii cubbuu abbootiitiif jedhee hamma dhaloota sadii fi afuriitti adabee",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra na jaallatanii ajajawwan koo eegan immoo hamma dhaloota kumaatti jaallatuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.11",
                "verseOrgIds": [
                  "DEU.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii akkasumaan hin dhaʼin;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.11",
                "verseOrgIds": [
                  "DEU.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "warra akkuma argan maqaa isaa dhaʼan utuu hin adabin hin dhiisuutii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.12",
                "verseOrgIds": [
                  "DEU.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee si ajajetti guyyaa Sanbataa qulqulleessuudhaan eegi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyoota jaʼa hojjedhu; hojii kee hundas hojjetadhu;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "guyyaan torbaffaan garuu sanbata",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.14",
                "verseOrgIds": [
                  "DEU.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii ti. Gaafas hojii tokko illee hin hojjetin; ati yookaan ilmi kee yookaan intalli kee yookaan hojjetaan kee yookaan xomboreen kee yookaan qotiyyoon kee yookaan harreen kee yookaan horiin kee kam iyyuu yookaan alagaan magaalaa kee keessa jiraatu tokko iyyuu homaa hin hojjetin. Hojjetaan keetii fi hojjettuun kee akkuma kee haa boqotan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka atis biyya Gibxitti garba turtee fi ergasii immoo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.15",
                "verseOrgIds": [
                  "DEU.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee harka jabaa fi irree diriirfameen achii si baase yaadadhu. Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.15",
                "verseOrgIds": [
                  "DEU.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee akka ati Sanbata eegdu si ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka biyya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.16",
                "verseOrgIds": [
                  "DEU.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee siif kennu keessa bara dheeraa jiraattuu fi akka sitti toluuf akkuma",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.16",
                "verseOrgIds": [
                  "DEU.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee si ajajetti abbaa keetii fi haadha keetiif ulfina kenni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
