          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deebiin isaas kana taʼa; \"Kun sababii sabni kun kakuu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.25",
                "verseOrgIds": [
                  "DEU.29.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni abbootii isaanii yeroo Gibxii isaan baasetti isaan wajjin gale sana dhiisaniif.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dhaqanii waaqota biraa, kanneen hin beekiniif waaqota inni isaaniif hin kennin waaqeffatan; gad jedhaniis sagadaniif.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
            "verseOrgIds": [
              "DEU.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.27",
                "verseOrgIds": [
                  "DEU.29.26"
                ]
              }
            }
          ]
        },
        {
          "text": "biyya kanatti bobaʼee akka inni abaarsa kitaaba kana keessatti barreeffame hunda itti fidu godhe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.28",
                "verseOrgIds": [
                  "DEU.29.27"
                ]
              }
            }
          ]
        },
        {
          "text": "aarii sodaachisaa fi dheekkamsa guddaadhaan biyya isaaniitii isaan buqqise; akkuma amma jiru kanattis biyya biraatti isaan darbate.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        }
      ]
    },
    {
