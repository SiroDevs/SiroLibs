  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "DEU 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kakuun Haaromfamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin kakuu kan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.28.69"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.1",
                "verseOrgIds": [
                  "DEU.28.69"
                ]
              }
            }
          ]
        },
        {
          "text": "kakuu Kooreebitti isaan wajjin gale sana irratti dabalee akka inni Moʼaab keessatti Israaʼeloota wajjin galuuf Musee ajaje kanaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.28.69"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen Israaʼeloota hunda walitti waamee akkana jedheen:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "DEU 29:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DEU 29:2"
      },
      "items": [
        {
          "text": "Waan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.2",
                "verseOrgIds": [
                  "DEU.29.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Gibxi keessatti Faraʼoon irratti, qondaaltota isaa hundaa fi guutummaa biyya isaa irratti hojjete hunda iji keessan argeera.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin qorumsawwan gurguddaa sana, mallattoowwanii fi dinqiiwwan gurguddaa sana ijuma keessaniin argitaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.3",
            "verseOrgIds": [
              "DEU.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.4",
                "verseOrgIds": [
                  "DEU.29.3"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu hamma harʼaatti qalbii hubatu yookaan ija argitu yookaan gurra dhagaʼu isinii hin kennine.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.4",
            "verseOrgIds": [
              "DEU.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo waggoota afurtamman ani gammoojjii keessa isin geggeesse sanatti uffanni keessan isin irratti hin dhumne yookaan kopheen miilla keessan irratti hin ciccinne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.5",
            "verseOrgIds": [
              "DEU.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin buddeena hin nyaanne; daadhii wayinii yookaan dhugaatii nama macheessu hin dhugne. Ani akka isin akka ani",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.6",
                "verseOrgIds": [
                  "DEU.29.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan taʼe beektaniifan waan kana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isin as geessanitti Sihoon mootiin Heshboonii fi Oogi mootiin Baashaan nu loluuf nutti baʼan; nu garuu isaan moʼanne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.7",
            "verseOrgIds": [
              "DEU.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya isaaniis fudhannee gosa Ruubeeniif, gosa Gaadii fi walakkaa gosa Minaaseetiif dhaala goonee kennine.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.8",
            "verseOrgIds": [
              "DEU.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin akka waan hojjettan hundaan milkooftaniif dubbiiwwan kakuu kanaa of eeggannaadhaan duukaa buʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundi keessan jechuunis qajeelchitoonnii fi hooggantoonni keessan, maanguddoonnii fi qondaaltonni keessan akkasumas namoonni Israaʼel kanneen biraa hundinuu harʼa fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.10",
                "verseOrgIds": [
                  "DEU.29.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessanii dura dhaabattaniirtu;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ijoolleen keessanii fi niitonni keessan akkasumas alagoonni muka kee ciraa, bishaan kees waraabaa qubata kee keessa jiraatan si wajjin dhaabataniiru.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.11",
            "verseOrgIds": [
              "DEU.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atis kakuu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.12",
                "verseOrgIds": [
                  "DEU.29.11"
                ]
              }
            }
          ]
        },
        {
          "text": "harʼa si wajjin galee kakaadhaan siif mirkaneessu kana",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.12",
                "verseOrgIds": [
                  "DEU.29.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee wajjin galuuf as dhaabatteerta;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis akkuma si abdachiisee abbootii kee Abrahaamiif, Yisihaaqii fi Yaaqoobiif waadaa gale sanatti akka ati saba isaa taatee innis Waaqa kee taʼuuf jabeessee si dhaabuuf waan kana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.13",
            "verseOrgIds": [
              "DEU.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis kakuu kakaadhaan mirkanaaʼe kana isin qofa wajjin utuu hin taʼin,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.14",
            "verseOrgIds": [
              "DEU.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "warra nu wajjin as fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.15",
                "verseOrgIds": [
                  "DEU.29.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaa dura dhaabatan warra harʼa as hin jirre wajjinis nan gala.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka nu itti Gibxi keessa jiraannee fi yommuu as dhufnus akka nu itti biyyoota keessa dabarre isin mataan keessanuu ni beektu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.16",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis gidduu isaaniitti fakkiiwwan isaanii jibbisiisoo, waaqota isaanii tolfamoo kanneen muka, dhagaa, meetii fi warqee irraa hojjetaman argitaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.17",
            "verseOrgIds": [
              "DEU.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka dhiirri yookaan dubartiin balballi yookaan gosti garaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.18",
                "verseOrgIds": [
                  "DEU.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenya irraa garagalee waaqota saboota sanaa faana buʼe isin gidduu hin jiraanne mirkaneeffadhaa; akka hiddi summii hadhaaʼaa akkasii baasu tokko iyyuu isin gidduu hin jiraanne qulqulleeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni akkasii yommuu dubbii kakuu kanaa dhagaʼutti, garaa isaatti of eebbisee, \"Ani yoon akka fedhii kootti deeme illee nagaa qaba\" jedhee yaada. Kun immoo lafa jiidhaa irrattis taʼu lafa goggogaa irratti badiisa fida.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.19",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.20",
                "verseOrgIds": [
                  "DEU.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "nama sanaaf gonkumaa dhiifama hin godhu; dheekkamsi isaatii fi hinaaffaan isaa namicha sana irratti bobaʼa. Abaarsi kitaaba kana keessatti barreeffame hundi isa qaqqaba;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.20",
                "verseOrgIds": [
                  "DEU.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "samii jalaa maqaa isaa ni dhabamsiisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma kakuu abaarsa Kitaaba Seeraa kana keessatti barreeffame hundaatti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.21",
                "verseOrgIds": [
                  "DEU.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": "gosoota Israaʼel hunda keessaa badiisaaf kophaatti isa baasa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaloonni itti aanu jechuunis ijoolleen keessan warri isiniin duuba dhufan akkasumas keessummoonni biyyoota fagootii dhufan dhaʼicha guddaa biyyattii irra gaʼee fi dhukkuba",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.22",
                "verseOrgIds": [
                  "DEU.29.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ittiin ishee dhaʼe ni argu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guutummaan biyyattii gammoojjii gubduu kan soogiddaa fi dinyiin guutamte kan wanni tokko iyyuu irra hin dhaabamne, kan wanni tokko iyyuu irratti hin biqille, kan biqiltuun tokko iyyuu irratti hin guddanne taati. Badiisni ishee irra gaʼus akka badiisa Sodoomiitii fi Gomoraa, Adimaatii fi Zebooʼiim kanneen",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.23",
                "verseOrgIds": [
                  "DEU.29.22"
                ]
              }
            }
          ]
        },
        {
          "text": "dheekkamsa guddaadhaan isaan barbadeesse sanaa ni taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni hundinuu, \"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.24",
                "verseOrgIds": [
                  "DEU.29.23"
                ]
              }
            }
          ]
        },
        {
          "text": "maaliif waan akkasii biyya kanatti fide? Dheekkamsi sodaachisaan bobaʼu kunis maaliif dhufe?\" jedhanii gaafatu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
