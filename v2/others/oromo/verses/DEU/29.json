              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanti dhoksaan kan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.29",
                "verseOrgIds": [
                  "DEU.29.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaa ti; kan mulʼifame garuu akka nu dubbii seera kanaa hunda eegnuuf bara baraan kan keenyaa fi kan ijoollee keenyaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.28"
            ]
