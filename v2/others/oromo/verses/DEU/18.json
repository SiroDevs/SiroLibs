          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dubbii koo kan raajiin maqaa kootiin dubbatu dhagaʼuu didu kam iyyuu, ani mataan koo isa nan gaafadha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.19",
            "verseOrgIds": [
