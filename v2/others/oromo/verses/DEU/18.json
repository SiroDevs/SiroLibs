              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu raajiin waan maqaa kootiin dubbatu fakkeessee waan ani akka inni dubbatu isa hin ajajin kam iyyuu dubbatu yookaan kan maqaa waaqota biraatiin dubbatu haa ajjeefamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.20",
            "verseOrgIds": [
              "DEU.18.20"
            ]
