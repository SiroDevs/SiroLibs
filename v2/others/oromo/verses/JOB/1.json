  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JOB 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seensa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya Uuzi jedhamu keessa nama Iyyoob jedhamu tokkotu ture. Namichi kunis nama hirʼina hin qabnee fi qajeelaa, nama Waaqa sodaatuu fi hammina irraa fagaate ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.1",
            "verseOrgIds": [
              "JOB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis ilmaan torbaa fi intallan sadii qaba ture;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.2",
            "verseOrgIds": [
              "JOB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas hoolota kuma torba, gaala kuma sadii, qotiyyoo cimdii dhibba shanii fi harroota dhibba shan, tajaajiltoota hedduus qaba ture; innis namoota biyya Baʼa Biiftuu jiraatan hunda keessaa nama guddaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.3",
            "verseOrgIds": [
              "JOB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan isaas mana isaaniitti dabaree dabareedhaan cidha qopheessanii akka isaan wajjin nyaatanii dhuganiif obboleettota isaanii sadan affeeru ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.4",
            "verseOrgIds": [
              "JOB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga yeroon cidha sanaa raawwatamee booddee Iyyoob itti ergee ijoollee isaa waamsisuudhaan, \"Tarii ijoolleen koo cubbuu hojjetanii garaa isaaniittis Waaqa abaaraniiru taʼa\" jedhee ganama barii waaʼee tokkoo tokkoo isaaniitiif aarsaa gubamu dhiʼeessuudhaan isaan qulqulleessa ture. Iyyoob yeroo hunda waan kana godha ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.5",
            "verseOrgIds": [
              "JOB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qorumsa Iyyoob Kan Jalqabaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko yeroo ergamoonni Waaqayyoo fuula",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOB.1.6",
                "verseOrgIds": [
                  "JOB.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti dhiʼaachuuf dhufanitti Seexannis isaan wajjin dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOB.1.7",
                "verseOrgIds": [
                  "JOB.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "seexanaan, \"Ati Eessaa dhufte?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOB 1:7"
      },
      "items": [
        {
          "text": "Seexannis, \"Ani lafa hunda irra jooraa, asii fi achis deddeebiʼaa tureen dhufe\" jedhee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JOB.1.7",
                "verseOrgIds": [
                  "JOB.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "deebise.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOB.1.8",
                "verseOrgIds": [
                  "JOB.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Seexanaan, \"Ati tajaajilaa koo Iyyoobin qalbeeffatteertaa? Namni isa fakkaatu tokko illee lafa irra hin jiru; inni nama hirʼina hin qabnee fi qajeelaa, nama Waaqa sodaatuu fi hammina irraa fagaatee dha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seexanni immoo deebisee akkana jedhe, \"Iyyoob akkasumaan Waaqa sodaataa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati naannoo isaatti, warra mana isaa jiraatanii fi waan kan isaa taʼe hundatti dallaa ijaarteerta mitii? Ati akka bushaayee fi loon isaa biyyicha guutaniif hojii harka isaa eebbifteertaaf.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.10",
            "verseOrgIds": [
              "JOB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu ati mee harka kee diriirsiitii waan inni qabu hunda dhaʼi; inni dhugumaan ifaan ifatti si abaara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.11",
            "verseOrgIds": [
              "JOB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOB.1.12",
                "verseOrgIds": [
                  "JOB.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Seexanaan, \"Kunoo, wanti inni qabu hundi si harka jira; isa garuu qubaanuu hin tuqin\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOB 1:12"
      },
      "items": [
        {
          "text": "Sana booddee Seexanni fuula",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOB.1.12",
                "verseOrgIds": [
                  "JOB.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "duraa baʼee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko utuu ilmaanii fi intallan Iyyoob mana obboleessa isaanii isa hangafaatti nyaachaa, daadhii wayinii dhugaa jiranuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
            "verseOrgIds": [
              "JOB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ergamaan tokko gara Iyyoob dhufee akkana jedhe; \"Utuu qotiyyoon qotaa, harroonni immoo naannuma sana dheedaa jiranuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni Shebaa balaa buusanii isaan fudhatanii deeman. Tajaajiltootas goraadeedhaan fixan; ana qofatu miliqee sitti himuuf dhufe!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma inni dubbachaa jiruu ergamaan biraa dhufee, \"Ibiddi Waaqaa samiidhaa buʼee hoolotaa fi tajaajiltoota gubee fixe; ana qofatu miliqee sitti himuuf dhufe!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu inni dubbachaa jiruu ammas ergamaan biraa dhufee, \"Kaldoonni garee sadiitti qoodamanii gaalawwan kee irra yaaʼanii isaan oofatanii deeman; tajaajiltootas goraadeedhaan fixan; ana qofatu miliqee sitti himuuf dhufe!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma inni dubbachaa jiruu ergamaan biraa dhufee akkana jedheen; \"Ilmaanii fi intallan kee mana obboleessa isaanii isa hangafaatti nyaachaa, daadhii wayinii dhugaa turan;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.18",
            "verseOrgIds": [
              "JOB.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo kanattis bubbee hamaan akka tasaa gammoojjiidhaa kaʼee golee mana sanaa afran dhaʼe; manni sunis isaan irratti jigee dhuman; ana qofatu miliqee sitti himuuf dhufe!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
            "verseOrgIds": [
              "JOB.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Iyyoob uffata isaa tarsaasee mataa isaa haaddate. Lafatti gombifamee sagadee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.20",
            "verseOrgIds": [
              "JOB.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 1:21"
      },
      "items": [
        {
          "text": "\"Ani qullaa koon gadameessa haadha kootiitii baʼe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 1:21"
      },
      "items": [
        {
          "text": "qullaa koos nan deema.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 1:21"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotu",
              "type": "text",
              "attrs": {
                "verseId": "JOB.1.21",
                "verseOrgIds": [
                  "JOB.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "kenne;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
