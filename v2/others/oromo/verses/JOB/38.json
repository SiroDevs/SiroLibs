    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni dubbata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.1",
            "verseOrgIds": [
              "JOB.38.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOB.38.1",
                "verseOrgIds": [
                  "JOB.38.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bubbee jabaa keessaa Iyyoobitti dubbate. Akkana jedhes:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.1",
            "verseOrgIds": [
              "JOB.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namni dubbii beekumsa malee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:2"
      },
      "items": [
        {
          "text": "dubbatamuun karoora koo dukkanneessu kun eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee akka gootaa mudhii kee hidhadhu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "ani sin gaafadha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "ati immoo deebii naa kenni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yeroo ani hundee lafaa kaaʼetti ati eessa turte?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:4"
      },
      "items": [
        {
          "text": "Yoo hubatte mee natti himi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eenyutu balʼina ishee murteesse? Dhugumaan ni beektaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:5"
      },
      "items": [
        {
          "text": "Eenyutu ulee safaraa ishee irra harkise?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundeen ishee maal irra dhaabame?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:6"
      },
      "items": [
        {
          "text": "Yookaan eenyutu dhagaa golee ishee dhaabe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis yeroo bakkalchoonni barii walii wajjin faarfatanitti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:7"
      },
      "items": [
        {
          "text": "yeroo ilmaan Waaqayyoos ililchanitti ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yeroo galaanni cabsee garaa lafaa keessaa baʼetti",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:8"
      },
      "items": [
        {
          "text": "eenyutu balbala itti cufee ittise?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ani duumessoota uffata isaa godhee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:9"
      },
      "items": [
        {
          "text": "dukkana guddaan maretti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo ani daangaa isaa dhaabee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:10"
      },
      "items": [
        {
          "text": "balbalaa fi danqaraa hojjedheefitti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "anis, 'Ati hamma asiitti dhufta; garuu darbuu hin dandeessu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:11"
      },
      "items": [
        {
          "text": "dambaliin of jajuu keetii illee asumatti dhaabata!' jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati bara jireenya keetii barraaqa ajajjee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:12"
      },
      "items": [
        {
          "text": "yookaan barii obborootti iddoo isaa argisiiftee beektaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni handaara lafaa qabatee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:13"
      },
      "items": [
        {
          "text": "namoota hamoo achi keessaa hurgufu gooteertaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti akka suphee chaappaa jala jiruutti bifa geeddaratti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:14"
      },
      "items": [
        {
          "text": "bifti ishees akka bifa uffataatti mulʼata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamoonni ifa isaanii dhowwatamaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:15"
      },
      "items": [
        {
          "text": "irreen isaanii inni ol kaʼes cabeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati gara burqaa galaanaa gad buutee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:16"
      },
      "items": [
        {
          "text": "yookaan tuujuba bishaanii seentee hundee isaa irra deemtee beektaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karri duʼaa sitti mulʼifameeraa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:17"
      },
      "items": [
        {
          "text": "Karra gaaddidduu duʼaas argiteertaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 38:18"
          },
