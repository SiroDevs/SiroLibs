      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 39:19"
      },
      "items": [
        {
          "text": "Yookaan morma isaatti gama uffisuu dandeessaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.19",
            "verseOrgIds": [
              "JOB.39.19"
            ]
          }
        }
