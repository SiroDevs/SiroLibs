          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati fardaaf jabina ni kennitaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.19",
            "verseOrgIds": [
              "JOB.39.19"
            ]
