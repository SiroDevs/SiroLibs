          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni humna isaatti gammadee akka malee guulee lafa dhidhiita;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.21",
            "verseOrgIds": [
              "JOB.39.21"
