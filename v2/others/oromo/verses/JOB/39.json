          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni akkuma hawwaannisaatti utaalu ni gootaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.20",
            "verseOrgIds": [
              "JOB.39.20"
