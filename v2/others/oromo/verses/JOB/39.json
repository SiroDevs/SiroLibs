      "attrs": {
        "style": "q2",
        "vid": "JOB 39:20"
      },
      "items": [
        {
          "text": "Ulfinni korrisa isaas sodaachisaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.20",
            "verseOrgIds": [
              "JOB.39.20"
            ]
          }
        }
      ]
