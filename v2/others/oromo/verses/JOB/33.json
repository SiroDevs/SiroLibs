  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "JOB 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Iyyoob amma garuu ati dubbii koo dhaggeeffadhu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:1"
      },
      "items": [
        {
          "text": "waan ani jedhu hundas dhagaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo ani afaan koo nan banadha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:2"
      },
      "items": [
        {
          "text": "dubbiin koos fiixee arraba kootii irra jira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin koo garaa qajeelaa keessaa baʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:3"
      },
      "items": [
        {
          "text": "hidhiin koos waan ani beeku ifatti baasee dubbata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuura Waaqaatu na uume;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:4"
      },
      "items": [
        {
          "text": "hafuurri Waaqni Waan Hunda Dandaʼu baafatus jireenya naa kenna.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa yoo dandeesse deebii naa kenni;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:5"
      },
      "items": [
        {
          "text": "qophaaʼiitii fuula koo dura dhaabadhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani fuula Waaqaa duratti namuma akka keetii ti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:6"
      },
      "items": [
        {
          "text": "anis biyyoo irraan hojjetame.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati na sodaattee hin raafamin;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:7"
      },
      "items": [
        {
          "text": "harki koos sitti hin ulfaatin.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhugumaan ati utuma ani dhagaʼuu dubbatteerta;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:8"
      },
      "items": [
        {
          "text": "anis dubbii kee dhagaʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akkana jetta: 'Ani qulqulluu dha; cubbuu illee hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:9"
      },
      "items": [
        {
          "text": "ani balleessaa hin qabu; yakka illee hin hojjenne.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni garuu balleessaa narratti argeera;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:10"
      },
      "items": [
        {
          "text": "akka diina isaattis na ilaaleera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miilla koo gudeelcha gidduu galchee hidha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:11"
      },
      "items": [
        {
          "text": "karaa koo hundas ni eega.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Garuu ani sitti nan hima; kana irratti ati qajeelaa miti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:12"
      },
      "items": [
        {
          "text": "Waaqni nama caalaa guddaadhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati maaliif akka waan inni",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:13"
      },
      "items": [
        {
          "text": "dubbii namaatiif deebii hin kennineetti isatti guungumta?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hubachuu baattu iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:14"
      },
      "items": [
        {
          "text": "Waaqni karaa tokkoonis, karaa biraatiinis ni dubbata.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni utuma isaan siree isaanii irra ciisanuu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:15"
      },
      "items": [
        {
          "text": "yeroo hirribni cimaan isaan qabutti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:15"
      },
      "items": [
        {
          "text": "abjuudhaan, mulʼata halkaniitiinis,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "gurra isaaniitti ni dubbata;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:16"
      },
      "items": [
        {
          "text": "of eeggachiisaanis isaan rifachiisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "jalʼina irraa nama deebisuuf,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:17"
      },
      "items": [
        {
          "text": "of jajuu irraas isa dhowwuuf,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "lubbuu isaa boolla irraa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 33:18"
      },
      "items": [
        {
          "text": "jireenya isaas goraadeedhaan baduu irraa oolchuudhaaf.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
