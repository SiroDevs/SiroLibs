      "attrs": {
        "style": "q2",
        "vid": "JOB 33:23"
      },
      "items": [
        {
          "text": "akka itti qajeelaa taʼan isaanitti himuuf,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
