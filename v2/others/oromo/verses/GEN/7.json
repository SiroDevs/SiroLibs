  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "GEN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "GEN.7.1",
                "verseOrgIds": [
                  "GEN.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Nohiin akkana jedhe; \"Ani akka ati dhaloota kana keessaa na duratti qajeelaa taate argeeraatii maatii kee hundumaa wajjin doonicha seeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensa qulqulluu gosa hunda keessaa kormaa fi dhalaa cimdii torba, bineensa qulqulluu hin taʼin gosa hunda keessaa cimdii tokko,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "gosa simbirrootaa hunda keessaa illee akka sanyiin lafa hunda irratti hafee jiraatuuf kormaa fi dhalaa cimdii torba fudhadhuu seeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani guyyaa torba booddee halkan afurtamaa fi guyyaa afurtama bokkaa nan roobsa; uumama jiraataa ani mataan koo uume hunda lafa irraa nan haxaaʼa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.4",
            "verseOrgIds": [
              "GEN.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nohis waan",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.7.5",
                "verseOrgIds": [
                  "GEN.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajaje hunda ni hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo bishaan badiisaa dhufetti Nohi nama waggaa dhibba jaʼa ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nohii fi ilmaan isaa, niitii isaatii fi niitonni ilmaan isaa bishaan badiisaa jalaa baʼuuf doonii seenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.7",
            "verseOrgIds": [
              "GEN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensonni qulqulluu fi kan qulqulluu hin taʼin, simbirroonnii fi uumamawwan lafa irra munyuuqan hundi, cimdii cimdiidhaan,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.8",
            "verseOrgIds": [
              "GEN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kormaa fi dhalaan gara Nohi dhufanii akkuma Waaqni Nohiin ajajetti doonicha seenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.9",
            "verseOrgIds": [
              "GEN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa torba booddee bishaan badiisaa lolaʼee lafa guute.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara jireenya Nohi waggaa dhibba jaʼaffaa keessa, jiʼa lammaffaatti, jiʼa sana keessaas guyyaa kudha torbaffaatti burqaawwan tuujuba gurguddaa hundi ni dhoʼan; foddaawwan bishaan samiis ni banaman.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
              "GEN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokkaanis guyyaa afurtamaa fi halkan afurtama lafatti roobe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.12",
            "verseOrgIds": [
              "GEN.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyuma sana Nohii fi ilmaan isaa, Seem, Haamii fi Yaafet, niitii isaatii fi niitota ilmaan isaa sadanii wajjin doonicha seenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.13",
            "verseOrgIds": [
              "GEN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis bineensota hunda, akkuma gosa isaaniitti, horii hunda akkuma gosa isaaniitti, uumamawwan lafa irra munyuuqan hundaa fi simbirroota hunda akkuma gosa isaaniitti, waan qoochoo qabu hundas of faana fudhatanii seenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.14",
            "verseOrgIds": [
              "GEN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumamawwan hafuura jireenyaa of keessaa qaban hundinuus cimdii cimdiidhaan gara Nohi dhufanii doonicha seenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.15",
            "verseOrgIds": [
              "GEN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensonni akkuma Waaqni Nohin ajajetti dooniitti galan kormaa fi dhalaa uumamawwan lubbu qabeeyyii hundaa turan; ergasii immoo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.7.16",
                "verseOrgIds": [
                  "GEN.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "alaan itti cufe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaan badiisaas ittuma fufee guyyaa afurtamaaf lafa irra ture; bishaan sunis dabalaa deemee doonii sana lafa irraa ol kaase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.17",
            "verseOrgIds": [
              "GEN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaanichis ol kaʼee lafa irratti akka malee baayʼate; dooniin sunis bishaanicha irra deeme.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.18",
            "verseOrgIds": [
              "GEN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaanichis akka malee ol kaʼaa deemee tulluuwwan samii jala jiran hunda haguuge.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.19",
            "verseOrgIds": [
              "GEN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaanichi dhundhuma kudha shan caalaa ol kaʼuudhaan tulluuwwan dhokse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.20",
            "verseOrgIds": [
              "GEN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumamawwan lubbu qabeeyyiin lafa irra jiraatan hundi jechuunis, simbirroonni, horiin, bineensonni, uumamawwan lafa irra munyuuqan hundii fi namoonni hundi ni barbadaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.21",
            "verseOrgIds": [
              "GEN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni lafa gogaa irra jiraatu kan funyaan isaatiin hafuura jireenyaa baafatu hundinuu ni duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.22",
            "verseOrgIds": [
              "GEN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumamawwan lubbu qabeeyyiin lafa irra jiraatan hundinuu ni haxaaʼaman; namnii fi horiin, uumamawwan lafa irra munyuuqanii fi simbirroonni samii, lafa irraa ni haxaaʼaman. Nohii fi warra isa wajjin doonii keessa turan qofattu hafe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.23",
            "verseOrgIds": [
              "GEN.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishaan sunis bultii dhibba tokkoo fi shantama lafa irra lolaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.24",
            "verseOrgIds": [
              "GEN.7.24"
            ]
          }
        }
      ]
    }
  ],
