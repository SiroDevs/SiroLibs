            "number": "1",
            "style": "v",
            "sid": "GEN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seenaan ilmaan Nohi jechuunis kan Seem, kan Haamii fi kan Yaafet kana; isaanis bishaan badiisaa booddee ilmaan dhalchan.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Sanyii Yaafeti",
          "type": "text"
        }
      ]
    },
