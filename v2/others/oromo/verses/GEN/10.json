              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Yaafet:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.2",
            "verseOrgIds": [
              "GEN.10.2"
            ]
          }
        }
      ]
