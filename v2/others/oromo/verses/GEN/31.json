  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "GEN 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yaaqoob Laabaa Jalaa Baqate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis akka ilmaan Laabaa, \"Yaaqoob waan abbaan keenya qabu hunda fudhateera; qabeenya kana hundas waanuma kan abbaa keenyaa ture irraa argate\" jedhan dhagaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.1",
            "verseOrgIds": [
              "GEN.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis fuula Laabaa ilaale; kunoo fuulli isaa akka duraatti isatti hin tolle.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.2",
            "verseOrgIds": [
              "GEN.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "GEN.31.3",
                "verseOrgIds": [
                  "GEN.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Yaaqoobiin, \"Biyya abbaa keetii fi fira keetti deebiʼi; anis si wajjin nan taʼa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.3",
            "verseOrgIds": [
              "GEN.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Yaaqoob akka isaan bakkeetti lafa bushaayeen isaa jiranitti gad baʼaniif gara Raahelii fi Liyaatti ergaa erge.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.4",
            "verseOrgIds": [
              "GEN.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana isaaniin jedhe; \"Ani akka abbaan keessan akka kanaan duraa sana fuula natti hin tolle hubadheera; garuu Waaqni abbaa kootii na wajjin jira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.5",
            "verseOrgIds": [
              "GEN.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani humna koo guutuudhaan abbaa keessaniif hojjedhe isinuu beektu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.6",
            "verseOrgIds": [
              "GEN.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "taʼus abbaan keessan mindaa koo yeroo kudhan geeddaruudhaan na gowwoomse. Waaqni garuu akka inni na miidhu hin eeyyamneef.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.7",
            "verseOrgIds": [
              "GEN.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo inni, 'Bushaayeen cocorreen mindaa kee taʼu' jedhetti, bushaayeen hundi ilmaan cocorree dhalan; yeroo inni, 'warri halluu qaxxaamuroo qaban mindaa kee taʼu' jedhetti immoo bushaayeen hundi ilmaan qaxxaamuroo qaban dhalan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.8",
            "verseOrgIds": [
              "GEN.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni karaa kanaan horii abbaa keessanii fuudhee naa kenne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.9",
            "verseOrgIds": [
              "GEN.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anis gaaf tokko waqtii gaana bushaayeetti abjuu keessa ol ilaalee kunoo korbeeyyiin reʼootatti hobobsan akka halluu qaxxaamuroo qaban, cocorree fi buburree taʼan nan arge.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.10",
            "verseOrgIds": [
              "GEN.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan Waaqayyoos abjuu keessa, 'Yaaqoob' naan jedhe. Ani, 'Kunoo asan jira' jedheen deebise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.11",
            "verseOrgIds": [
              "GEN.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni immoo akkana naan jedhe; 'Akka korbeeyyiin reʼootaa kanneen bushaayeetti hobobsan hundinuu halluu qaxxaamuroo qaban, cocorree fi buburree taʼan ol jedhii ilaali. Ani waan Laabaan sitti hojjete hunda argeeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.12",
            "verseOrgIds": [
              "GEN.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani Waaqa Beetʼeel lafa ati itti utubaa dibdee wareega naaf wareegde sanaa ti. Amma kaʼiitii biyya kana keessaa baʼiitii gara biyya fira keetiitti deebiʼi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.13",
            "verseOrgIds": [
              "GEN.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Raahelii fi Liyaan akkana jedhanii deebisan; \"Qoodni yookaan dhaalli mana abbaa keenyaatti nuu hafe jiraa?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.14",
            "verseOrgIds": [
              "GEN.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma ormaatti nu ilaala mitii? Inni nu gurgurateeraatii maallaqa sababii keenyaaf kenname nyaatee fixeera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.15",
            "verseOrgIds": [
              "GEN.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabeenyi Waaqni abbaa keenya irraa fuudhe hundi kan keenyaa fi kan ijoollee keenyaa ti. Egaa waan Waaqni sitti hime hunda godhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis ijoollee isaatii fi niitota isaa gaalawwan irra kaaʼate;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.17",
            "verseOrgIds": [
              "GEN.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "horii fi qabeenya kaaba dhiʼa Phaadaan Arraamiitti horatte hunda of dura oofee gara biyya Kanaʼaan abbaa isaa Yisihaaq bira dhaquuf kaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.18",
            "verseOrgIds": [
              "GEN.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaan hoolota isaa irraa rifeensa murmuruu dhaqe; Raahel immoo waaqota abbaa ishee hatte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.19",
            "verseOrgIds": [
              "GEN.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis akka isa dhiisee baqachuu yaade isa dhoksuudhaan Laabaan namicha Arraam sana gowwoomse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.20",
            "verseOrgIds": [
              "GEN.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis waan qabu hunda fudhatee baqate; laga Efraaxiis ceʼee biyya gaara Giliʼaaditti qajeele.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Laabaan Yaaqoob Duukaa Buʼe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka Yaaqoob baqate guyyaa sadaffaatti Laabaatti himame.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.22",
            "verseOrgIds": [
              "GEN.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaanis firoota isaa fudhatee guyyaa torba Yaaqoob duukaa buʼee biyya gaara Giliʼaaditti isa qaqqabe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.23",
            "verseOrgIds": [
              "GEN.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis halkan abjuudhaan gara Laabaan namicha biyya Arraam sanaa dhufee, \"Ati waan gaariis taʼu hamaa tokko iyyuu Yaaqoobitti akka hin dubbanne of eeggadhu\" isaan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.24",
            "verseOrgIds": [
              "GEN.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoob yeroo Laabaan isa qaqqabetti, biyya gaaraa Giliʼaad keessa dunkaana isaa dhaabbatee ture; Laabaa fi firoonni isaas achi qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.25",
            "verseOrgIds": [
              "GEN.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaanis Yaaqoobiin akkana jedhe; \"Ati na gowwoomsitee intallan koo akka boojiʼamtoota waraanaatti fudhattee deemuun kee maal gochuu kee ti?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.26",
            "verseOrgIds": [
              "GEN.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati maaliif dhoksaan baqatte? Maaliifis na gowwoomsite? Akka ani gammachuu fi faarfannaadhaan, dibbee fi baganaadhaan si geggeessuuf maaliif natti himuu didde?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.27",
            "verseOrgIds": [
              "GEN.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka ani ijoollee ijoollee kootiitii fi intallan koo dhungadhee nagaatti jedhu naaf hin eeyyamne. Ati hojii gowwummaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.28",
            "verseOrgIds": [
              "GEN.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani isin miidhuuf humna qaba; garuu eda Waaqni abbaa keessanii, 'Ati waan gaariis taʼu hamaa tokko illee Yaaqoobitti akka hin dubbanne of eeggadhu' naan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.29",
            "verseOrgIds": [
              "GEN.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati sababii mana abbaa keetiitti deebiʼuu akka malee hawwiteef deemteerta; garuu maaliif waaqota koo hatte?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.30",
            "verseOrgIds": [
              "GEN.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis akkana jedhee Laabaaf deebii kenne; \"Ati intallan kee humnaan narraa fudhatta jedhee waanan sodaadheef nan deeme.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.31",
            "verseOrgIds": [
              "GEN.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni ati waaqota kee isa biratti argattu jiraachuu hin qabu. Akka wanni kan kee taʼe na bira jiruu fi akka hin jirre atuu fuula firoota keenyaa duratti sakattaʼi; yoo jiraate immoo fudhadhu.\" Yaaqoob Raahel waaqota sana hattuu ishee Yaaqoob hin beeku ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaanis dunkaana Yaaqoob, dunkaana Liyaatii fi dunkaana xomboreewwan lamaanii seenee homaa dhabe. Erga dunkaana Liyaatii baʼee booddees dunkaana Raahel seene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.33",
            "verseOrgIds": [
              "GEN.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raahel immoo waaqota mana keessaa hatte sana kooraa gaalawwan ishee jala keessee irra taaʼaa turte. Laabaanis waan dunkaanicha keessa jiru hunda keessa barbaade; garuu homaa hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.34",
            "verseOrgIds": [
              "GEN.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raahelis abbaa isheetiin, \"Yaa gooftaa ko, sababii ani kaʼee fuula kee dura dhaabachuu dadhabeef hin aarin; ani xuriin of irraa qabaa\" jette. Innis ni sakattaʼe malee waaqota sana hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis Laabaatti aaree isatti dheekkame. Innis akkana jedhee gaafate; \"Yakki koo maali? Wanni ati akkana na adamsituuf ani cubbuu maalii hojjedheeti?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.36",
            "verseOrgIds": [
              "GEN.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati miʼa koo hunda sakattaateerta; egaa miʼa mana keetii keessaa maal argatte? Yoo jiraate firoota keetii fi firoota koo duratti dhiʼeessiitii isaan nu lamaan gidduutti murtii haa kennan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.37",
            "verseOrgIds": [
              "GEN.31.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani waggoota digdaman kana si wajjin jiraadheera. Hoolonnii fi reʼoonni kee tokko iyyuu hin gatanne; ani bushaayee kee keessaas korbeeyyii hin nyaanne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.38",
            "verseOrgIds": [
              "GEN.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani horii bineensi cabse gara keetti hin fidne; horii bades anatu kaffalaa ture. Waan guyyaas taʼu halkan hatame hundaaf ati na kaffalchiifatta turte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.39",
            "verseOrgIds": [
              "GEN.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haalli ani keessa jiraadhe kana ture; guyyaa hoʼa, halkan immoo dhaamochatu na waxala ture; hirribnis ija koo irraa bade.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.40",
            "verseOrgIds": [
              "GEN.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin ani waggoota digdamman kana mana kee ture. Ani waggaa kudha afur intallan kee lamaaniif jedhee, waggaa jaʼa immoo bushaayee keetiif jedhee siif hojjedheera; ati immoo yeroo kudhan mindaa koo geeddarte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.41",
            "verseOrgIds": [
              "GEN.31.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni abbaa ko, Waaqni Abrahaam, Sodaan Yisihaaq utuu na wajjin jiraachuu baate ati silaa harka duwwaa na baasta turte. Waaqni garuu rakkina koo fi dadhabbii koo argee eda sitti dheekkame.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaan akkana jedhee Yaaqoobiif deebise; \"Dubartoonni kunneen intallan koo ti; ijoolleen kunneenis ijoolluma koo ti; bushaayeen kunneenis bushaayee koo ti. Wanni ati argitu hundi kanuma koo ti. Yoos ani waaʼee intallan koo kanneeniitii fi waaʼee ijoollee isaan daʼanii harʼa maal gochuun dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.43",
            "verseOrgIds": [
              "GEN.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottu mee anii fi ati amma walii kakannaa; kakuun kunis anaa fi si gidduutti ragaa haa taʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.44",
            "verseOrgIds": [
              "GEN.31.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis dhagaa tokko fuudhee akka utubaatti dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.45",
            "verseOrgIds": [
              "GEN.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 31:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis firoota isaatiin, \"Dhagaa walitti qabaa\" jedhe. Isaanis dhagaa walitti qabanii tuulan; jarris tuullaa sana biratti nyaata nyaatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.46",
            "verseOrgIds": [
              "GEN.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaan tuullaa sanaan \"Yigaarsahaadutaa\" jedhee moggaase; Yaaqoob immoo \"Giliʼaad\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.47",
            "verseOrgIds": [
              "GEN.31.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 31:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaanis, \"Tuullaan kun anaa fi si gidduutti ragaa dha\" jedhe. Gaalaʼaad jedhamuun isaa kanumaaf.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.48",
            "verseOrgIds": [
              "GEN.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas Miisphaa jedhame; Laabaan akkana jedhee tureetii; \"Yeroo nu gargar baanutti",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.49",
            "verseOrgIds": [
              "GEN.31.49"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.31.49",
                "verseOrgIds": [
                  "GEN.31.49"
                ]
              }
            }
          ]
        },
        {
          "text": "sii fi ana gidduutti eegduu haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.49",
            "verseOrgIds": [
              "GEN.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati intallan koo rakkifte yookaan yoo ati intallan koo irratti niitota biraa fuute, yoo namni tokko iyyuu nu bira hin jirre kunoo Waaqni anaa fi siʼi gidduutti ragaa dha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.50",
            "verseOrgIds": [
              "GEN.31.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaan ammas Yaaqoobiin akkana jedhe; \"Tuullaa kanaa fi utubaa ani sii fi ana gidduu dhaabe kana ilaali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.51",
            "verseOrgIds": [
              "GEN.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani si miidhuuf jedhee tuullaa kana darbee gara keetti hin ceene, akka atis na miidhuuf jettee tuullaa kanaa fi utubaa kana dabartee gara kootti hin ceene tuullaan kun ragaa dha; utubaan kunis ragaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.52",
            "verseOrgIds": [
              "GEN.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni Abrahaam, Waaqni Naahoor, Waaqni abbootii isaanii nu gidduutti murtii haa kennu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 31:53"
      },
      "items": [
        {
          "text": "Yaaqoobis akkasitti maqaa Sodaa abbaa isaa Yisihaaqiin kakate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis biyya gaaraa sanatti aarsaa dhiʼeessee firoota isaa nyaatatti waame. Isaanis erga nyaatanii booddee achuma bulan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.54",
            "verseOrgIds": [
              "GEN.31.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 31:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laabaanis guyyaa itti aanu ganama bariidhaan kaʼee ijoollee ijoollee isaatii fi intallan isaa dhungatee isaan eebbise. Ergasiis achii kaʼee gara iddoo isaatti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.55",
            "verseOrgIds": [
              "GEN.32.1"
            ]
          }
        }
      ]
    }
  ],
