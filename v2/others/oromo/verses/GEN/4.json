  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "GEN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qaayinii fi Abeel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Addaam niitii isaa Hewaan bira gaʼe; isheenis ulfooftee Qaayinin deesse. Isheenis, \"Ani gargaarsa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.1",
            "verseOrgIds": [
              "GEN.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.1",
                "verseOrgIds": [
                  "GEN.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ilma tokko argadheera\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.1",
            "verseOrgIds": [
              "GEN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti aansitees obboleessa isaa Abeelin deesse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.2",
            "verseOrgIds": [
              "GEN.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 4:2"
      },
      "items": [
        {
          "text": "Abeel tiksee hoolotaa ture; Qaayin immoo lafa qota ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.2",
            "verseOrgIds": [
              "GEN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo muraasa keessatti Qaayin waan lafti baafteef keessaa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.3",
            "verseOrgIds": [
              "GEN.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.3",
                "verseOrgIds": [
                  "GEN.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "aarsaa dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.3",
            "verseOrgIds": [
              "GEN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeel immoo hangafoota hoolota isaa keessaa cooma cooma isaa dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.4",
            "verseOrgIds": [
              "GEN.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.4",
                "verseOrgIds": [
                  "GEN.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "faara tolaadhaan gara Abeelii fi gara aarsaa inni dhiʼeesse sanaa ilaale.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.4",
            "verseOrgIds": [
              "GEN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara Qaayinii fi gara aarsaa isaa garuu hin ilaalle. Kanaafuu Qaayin akka malee aaree fuulli isaa gurraachaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.5",
            "verseOrgIds": [
              "GEN.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.6",
                "verseOrgIds": [
                  "GEN.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Qaayiniin akkana jedhe; \"Ati maaliif aarte? Fuulli kees maaliif gurraachaʼe?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.6",
            "verseOrgIds": [
              "GEN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu waan qajeelaa hojjettee silaa ati fudhatama argatta mitii? Garuu yoo waan qajeelaa hojjechuu baatte cubbuun balbala kee duratti riphee si eeggata; si qabachuu barbaadas; ati garuu isa moʼachuu qabda.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.7",
            "verseOrgIds": [
              "GEN.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaayinis ergasii obboleessa isaa Abeeliin, \"Kottu mee dirreetti baanaa\" jedhe. Utuma dirree irra jiranuus Qaayin obboleessa isaa Abeelitti kaʼee isa ajjeese.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.8",
            "verseOrgIds": [
              "GEN.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.9",
                "verseOrgIds": [
                  "GEN.4.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Obboleessi kee Abeel eessa jira?\" jedhee Qaayin gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 4:9"
      },
      "items": [
        {
          "text": "Qaayin immoo, \"Ani hin beeku; ani eegduu obboleessa kootiitii?\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.9",
            "verseOrgIds": [
              "GEN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.10",
                "verseOrgIds": [
                  "GEN.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe; \"Ati maal goote? Dhiigni obboleessa keetii lafaa natti iyyaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.10",
            "verseOrgIds": [
              "GEN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati amma abaaramaa dha; lafa dhiiga obboleessa keetii si harkaa fudhachuuf afaan banatte irraas ni ariʼamta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.11",
            "verseOrgIds": [
              "GEN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ati lafa qotattutti lafti deebitee midhaan siif hin kennitu. Ati lafa irratti joortuu boqonnaa hin qabne taata.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.12",
            "verseOrgIds": [
              "GEN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaayin immoo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.13",
            "verseOrgIds": [
              "GEN.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.13",
                "verseOrgIds": [
                  "GEN.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe; \"Adabamuun koo waan ani baachuu dandaʼuun ol.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.13",
            "verseOrgIds": [
              "GEN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo ati harʼa biyyaa na ariʼaa jirta; anis fuula kee duraa nan dhokadha; lafa irratti joortuu boqonnaa hin qabne nan taʼa; namni na argatu kam iyyuus na ajjeesa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.14",
            "verseOrgIds": [
              "GEN.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.15",
                "verseOrgIds": [
                  "GEN.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu, \"Akkana miti; namni Qaayinin ajjeesu kam iyyuu dachaa torba haaloo baafama\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.15",
                "verseOrgIds": [
                  "GEN.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "akka namni isa argatu tokko iyyuu isa hin ajjeefneef Qaayinitti mallattoo godhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.15",
            "verseOrgIds": [
              "GEN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Qaayin fuula",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.4.16",
                "verseOrgIds": [
                  "GEN.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": "duraa baʼee Eeden irraa karaa baʼa biiftuutiin biyya Noodi keessa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.16",
            "verseOrgIds": [
              "GEN.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaayin niitii isaa beeke; isheenis ulfooftee Henookin deesse. Qaayinis magaalaa tokko hundeesse; magaalaa sanas Henook jedhee maqaa ilma isaatiin waame.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.17",
            "verseOrgIds": [
              "GEN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henook Iiraadin dhalche; Iiraadi Meʼeelin dhalche; Mehuuyaaʼeel Matusaaʼelin dhalche; Matusaaʼel immoo Laamehin dhalche.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.18",
            "verseOrgIds": [
              "GEN.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laameh dubartoota maqaan isaanii Aadaa fi Xiilaa jedhamu lamaan fuudhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.19",
            "verseOrgIds": [
              "GEN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aadaan Yaabaalin deesse; Yaabaalis abbaa warra dunkaana keessa jiraatanii horii horsiisanii ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.20",
            "verseOrgIds": [
              "GEN.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaan obboleessa isaa Yuubaal ture; inni immoo abbaa warra kiraara rukutaniitii fi ulullee afuufanii ti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.21",
            "verseOrgIds": [
              "GEN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xiilaan immoo ilma Tuubaal Qaayin jedhamu kan naasii fi sibiila tumee meeshaawwan garaa garaa hojjetu deesse; obboleettiin Tuubaal Qaayinis Naʼamaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.22",
            "verseOrgIds": [
              "GEN.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 4:23"
          },
          "items": [
            {
              "text": "23",
