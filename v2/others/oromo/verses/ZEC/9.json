  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ZEC 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Murtii Diinota Israaʼelitti Murame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajiin dubbii",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "biyya Hadraakitti ni dhufa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "Damaasqoo irras ni buʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "iji namoota hundaa fi gosoota Israaʼel hundaa gara",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ilaalaatii;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas gara Hamaati ishee daangaa irraa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:2"
      },
      "items": [
        {
          "text": "isaan ogeeyyii taʼan iyyuu gara Xiiroosii fi Siidoonaas ni ilaala.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xiiroos daʼannoo jabaa ijaarratteerti;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "meetii akka awwaaraatti,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "warqees akkuma kosii daandii irraatti tuullateerti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaan garuu qabeenya ishee irraa fuudhee humna ishee",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "galaana irratti barbadeessa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "isheenis ibiddaan dhumti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashqaloon waan kana argitee ni sodaatti;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Gaazaan immoo dhukkubsattee aaddi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Eqroonis akkasuma taati; abdiin ishee coollageeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Gaazaan mootii ishee ni dhabdi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Eqroonis ontee hafti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni ormaa Ashdoodin ni qabatu;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:6"
      },
      "items": [
        {
          "text": "anis of tuulummaa Filisxeemotaa nan balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani dhiiga afaan isaanii keessa jiru,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "nyaata dhowwames ilkaan isaanii gidduudhaa nan baasa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "Warri hafanis kan Waaqa keenyaa taʼanii",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "Yihuudaa keessattis bulchitoota taʼu;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "Eqroon immoo akka warra Yebuusotaa ni taati.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu loltuu cabsitee seentu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "mana koo irraa nan dhowwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "Lammata hacuuccuun saba koo irra hin burraaqxu;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "ani amma dammaqee nan eegaatii.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhufaatii Mooticha Xiyoon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Intala Xiyoon ati guddisii gammadi!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "Yaa Intala Yerusaalem iyyi!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "Kunoo mootiin kee qajeelaan,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "fayyina qabatee,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "gad of qabee harree yaabbatee,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "ilmoo harree jechuunis harree xinnoo yaabbatee gara kee dhufaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani gaariiwwan lolaa Efreem keessaa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "fardeen lolaas Yerusaalem keessaa nan balleessa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "iddaan waraanaas ni caccaba.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "Inni sabootatti nagaa ni labsa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "bulchiinsi isaa galaana tokkoo irraa hamma galaana biraatti,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
