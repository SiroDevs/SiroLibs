  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "PSA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Warri Nama Arrabsan Adabamuu Isaanii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura buʼaa faarfattootaatiif. Faarfannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, yommuu ani iyyadhu sagalee koo dhagaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:1"
      },
      "items": [
        {
          "text": "lubbuu koos doorsisuu diinaa duraa baasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marii jalʼootaa duraa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:2"
      },
      "items": [
        {
          "text": "mala namoota hamoo duraas na dhoksi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan arraba isaanii akka goraadee qaratan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:3"
      },
      "items": [
        {
          "text": "dubbii hadhaaʼaas akkuma xiyyaatti qopheeffatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan riphanii nama yakka hin qabnetti futtaasu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:4"
      },
      "items": [
        {
          "text": "akkuma tasaas sodaa malee itti gad dhiisu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaayyoo jalʼinaa irratti wal jajjabeessu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "waaʼee dhoksanii kiyyoo kaaʼuus ni mariʼatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "\"Eenyutu isa arguu dandaʼa?\" jedhaniis ni yaadu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis jalʼina yaaduudhaan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "\"Nu mala hirʼina hin qabne malanneerra!\" jedhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "yaadnii fi keessi garaa namaa gad fagoodhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni garuu xiyya isaa isaanitti futtaasa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:7"
      },
      "items": [
        {
          "text": "isaanis akkuma tasaa madaaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis arrabuma isaaniin isaan balleessa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:8"
      },
      "items": [
        {
          "text": "warri isaan argan hundinuu tuffiidhaan mataa raasu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni hundinuu ni sodaatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "isaan hojii Waaqaa ni labsu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "waan inni hojjete illee ni qalbeeffatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni qajeelaan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "PSA.64.10",
                "verseOrgIds": [
                  "PSA.64.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gammada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "isattis kooluu gala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "gara toleeyyiin hundinuu isaan ulfina argatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    }
  ],
