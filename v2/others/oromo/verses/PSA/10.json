      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Murtii Qajeelaa Argachuuf Waaqa Kadhachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.1",
                "verseOrgIds": [
                  "PSA.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ati maaliif achi fagaattee dhaabatta?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:1"
      },
      "items": [
        {
          "text": "Yeroo rakkinaattis maaliif of dhoksita?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hamaan of tuulummaa isaatiin hiyyeessa adamsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:2"
      },
      "items": [
        {
          "text": "inni maluma malatuun haa qabamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hamaan hawwii isaatiin of jaja; ofittoo ni eebbisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.3",
                "verseOrgIds": [
                  "PSA.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "immoo ni arrabsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hamaan sababii of tuuluuf Waaqa hin barbaadu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:4"
      },
      "items": [
        {
          "text": "yaada isaa hundumaa keessas Waaqni hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaan isaa yeroo hunda ni milkaaʼaaf; inni of tuula;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:5"
      },
      "items": [
        {
          "text": "seerri kees isa irraa fagoo dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:5"
      },
      "items": [
        {
          "text": "diinota isaa hundattis tuffiidhaan qummaada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Wanni na sochoosu hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:6"
      },
      "items": [
        {
          "text": "rakkinnis gonkumaa na hin argatu\" ofiin jedha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afaan isaa abaarsaan, sobaa fi doorsisaan guutameera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:7"
      },
      "items": [
        {
          "text": "dabaa fi hamminni arraba isaa jala jiru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gandoota keessatti riphee eeggata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:8"
      },
      "items": [
        {
          "text": "iddoo dhokataattis warra yakka hin qabne ajjeesa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 10:8"
      },
      "items": [
        {
          "text": "Ija isaatiinis hiyyeeyyii gaada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka leenca daggala isaa keessaatti riphee eeggata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "Hiyyeessa qabachuudhaaf dhokatee eeggata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "hiyyeessas qabatee kiyyoo isaatiin harkifata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyyeessi sunis ni caccaba; gad of qabas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:10"
      },
      "items": [
        {
          "text": "humna nama hamaa jalattis ni kufa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Waaqa irraanfateera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:11"
      },
      "items": [
        {
          "text": "fuula isaas dhokfateera; gonkumaa hin argu\" ofiin jedha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.12",
                "verseOrgIds": [
                  "PSA.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "kaʼi! Yaa Waaqi harka kee ol kaafadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:12"
      },
      "items": [
        {
          "text": "Rakkataas hin dagatin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hamaan maaliif Waaqa arrabsa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:13"
      },
      "items": [
        {
          "text": "Maaliifis garaa isaatti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:13"
      },
      "items": [
        {
          "text": "\"Inni waan kanatti na hin gaafatu\" jedha?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, ati garuu rakkinaa fi gadda warra miidhamanii ni argita;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "harka keetiinis gatii baasifta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "Deegaan dabarsee sitti of kenna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "ati ijoollee abbaa hin qabneef gargaaraa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
