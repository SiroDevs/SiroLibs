      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:4"
      },
      "items": [
        {
          "text": "akkasitti eebbifama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
