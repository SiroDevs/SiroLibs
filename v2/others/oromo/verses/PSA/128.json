                "verseId": "PSA.128.4",
                "verseOrgIds": [
                  "PSA.128.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaatu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        }
      ]
    },
