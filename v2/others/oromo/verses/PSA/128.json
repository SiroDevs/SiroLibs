          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ijoollee ijoollee keetii ni argi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
          }
        }
