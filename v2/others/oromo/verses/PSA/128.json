            "sid": "PSA 128:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati buʼaa dadhabbii keetii ni nyaatta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:2"
      },
      "items": [
        {
          "text": "ni eebbifamta; jireenyis sitti tola.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 128:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiin kee mana kee keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "akka muka wayinii kan ija naqatee ni taati;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "ijoolleen kees naannoo maaddii keetiitti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "akka lataa muka ejersaa ni taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
