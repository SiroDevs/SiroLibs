              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.128.5",
                "verseOrgIds": [
                  "PSA.128.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Xiyoon irraa si haa eebbisu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:5"
      },
      "items": [
        {
          "text": "atis badhaadhummaa Yerusaalem argi.",
          "type": "text",
          "attrs": {
