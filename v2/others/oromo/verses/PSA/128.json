      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:6"
      },
      "items": [
        {
          "text": "nagaan Israaʼeliif haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
