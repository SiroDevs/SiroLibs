      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "innis akkana anaan jedhe; \"Ati ilma koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "ani harʼa si dhalcheera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kadhadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "ani saboota dhaala kee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "handaara lafaas qabeenya kee godhee siifan kenna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati ulee sibiilaatiin isaan cabsita;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:9"
      },
      "items": [
        {
          "text": "akka qodaa supheettis isaan hurreessita.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
