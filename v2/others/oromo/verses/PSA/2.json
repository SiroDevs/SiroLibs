        "style": "ms1"
      },
      "items": [
        {
          "text": "Mooticha Waaqni Dibee Moosise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
