          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni maaliif akkanumaan malatu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:1"
      },
      "items": [
        {
          "text": "Saboonnis maaliif waan akkanumaan mariʼatu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootonni lafaa kaʼanii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "bulchitoonnis",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.2.2",
                "verseOrgIds": [
                  "PSA.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "fi Masiihii isaatiin mormuuf",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "walitti qabaman;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
