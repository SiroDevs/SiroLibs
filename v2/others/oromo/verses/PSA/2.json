            "sid": "PSA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni hin aarreef,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "isinis akka karaa irratti hin badneef ilma isaa dhungadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "dheekkamsi isaa dafee bobaʼaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "Warri isatti kooluu galan hundi eebbifamoo dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
