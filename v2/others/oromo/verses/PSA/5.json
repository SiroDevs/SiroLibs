        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kadhannaa Ganamaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Faarfannaa Daawitii kan ululleedhaan faarfatamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.1",
                "verseOrgIds": [
                  "PSA.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", gurra kee dubbii kootti qabi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:1"
      },
      "items": [
        {
          "text": "aaduu koo illee naa hubadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa mootii koo fi Waaqa ko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:2"
      },
      "items": [
        {
          "text": "iyya ani gargaarsaaf iyyadhu dhaggeeffadhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:2"
      },
      "items": [
        {
          "text": "ani sin kadhadhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.3",
                "verseOrgIds": [
                  "PSA.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ganamaan sagalee koo ni dhageessa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:3"
      },
      "items": [
        {
          "text": "anis ganamaan kadhata koo fuula kee duratti nan dhiʼeessa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:3"
      },
      "items": [
        {
          "text": "abdiidhaanis nan eeggadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati Waaqa hamminatti gammadu miti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:4"
      },
      "items": [
        {
          "text": "hamaanis si wajjin hin jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Of tuultonni fuula kee dura dhaabachuu hin dandaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:5"
      },
      "items": [
        {
          "text": "Atis warra jalʼina hojjetan hunda ni jibbita;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati warra soba dubbatan ni balleessita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.6",
                "verseOrgIds": [
                  "PSA.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "warra dhiiga dheebotanii fi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:6"
      },
      "items": [
        {
          "text": "warra nama gowwoomsan ni xireeffata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu araara kee baayʼee sanaan mana keetti ol nan gala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "si sodaachuudhaanis gad jedhee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:7"
      },
      "items": [
        {
          "text": "gara mana qulqullummaa kee qulqulluu sanaatti garagalee nan sagada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.8",
                "verseOrgIds": [
                  "PSA.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", sababii diinota kootiif jedhiitii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:8"
      },
      "items": [
        {
          "text": "qajeelummaa keetiin na dura buʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:8"
      },
      "items": [
        {
          "text": "karaa kees fuula koo duratti naa qajeelchi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin afaan isaaniitii baʼu tokko iyyuu hin amanamu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "garaan isaanii badiisaan guutameera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "Laagaan isaanii awwaala banamaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:9"
      },
      "items": [
        {
          "text": "arraba isaaniitiin ni sobu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqayyo, yakkitoota taʼuu isaanii isaanitti beeksisi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "Daba isaaniitiinis haa kufan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "Baayʼina cubbuu isaaniitiin isaan balleessi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:10"
      },
      "items": [
        {
          "text": "isaan sitti fincilaniiruutii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri kooluu sitti galan hundinuu garuu haa gammadan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "bara baraanis gammachuudhaan haa faarfatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "Akka warri maqaa kee jaallatan sitti gammadaniif",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 5:11"
      },
      "items": [
        {
          "text": "ati eegumsa kee isaan irra diriirsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
