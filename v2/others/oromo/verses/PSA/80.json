          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 80:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati muka wayinii biyya Gibxii buqqiftee fidde;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:8"
      },
      "items": [
        {
          "text": "ormootas ariitee muka sana dhaabde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 80:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukichaafis lafa qopheessite;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:9"
      },
      "items": [
        {
          "text": "mukni sunis hidda gad fageeffatee biyyattii guute.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 80:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulluuwwan gaaddisa isaatiin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:10"
      },
      "items": [
        {
          "text": "birbirsawwan gurguddaanis",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "dameewwan isaatiin haguugaman.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 80:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis dameewwan isaa gara Galaanaatti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:11"
      },
      "items": [
        {
          "text": "lata isaas hamma Lagaatti diriirfate.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 80:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoos ati maaliif akka namni achiin darbu hundinuu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:12"
      },
      "items": [
        {
          "text": "ija isaa ciratu gochuuf jettee dallaa isaa diigde ree?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 80:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kormi booyyee bosona keessaa baʼee isa ni balleessa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:13"
      },
      "items": [
        {
          "text": "bineensi dirrees isa ni nyaata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 80:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa Waan Hunda Dandeessu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "si kadhannaa gara keenyatti deebiʼi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "Samii irraa gad ilaalii argi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "Muka wayinii kana eegi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 80:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukni kun muka wayinii kan harki kee mirgaa dhaabee dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.15",
            "verseOrgIds": [
              "PSA.80.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:15"
      },
      "items": [
        {
          "text": "biqiltuu ati ofii keetiif guddifattee dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.15",
            "verseOrgIds": [
              "PSA.80.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
