                "verseId": "PSA.56.10",
                "verseOrgIds": [
                  "PSA.56.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ani dubbii isaa jajadhu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
