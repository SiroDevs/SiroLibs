                "verseOrgIds": [
                  "PSA.127.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mana ijaaruu baannaan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
