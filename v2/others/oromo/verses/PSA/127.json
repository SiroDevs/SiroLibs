      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "warri ijaaran akkasumaan dadhabu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
