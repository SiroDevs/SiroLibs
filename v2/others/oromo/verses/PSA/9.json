          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni haaloo dhiigaa baasu sunis isaan yaadataatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
    {
