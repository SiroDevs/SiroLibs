                "verseId": "PSA.9.7",
                "verseOrgIds": [
                  "PSA.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu bara baraan ni moʼa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:7"
      },
      "items": [
        {
          "text": "teessoo isaas murtiidhaaf dhaabbateera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.7",
            "verseOrgIds": [
              "PSA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni qajeelummaadhaan addunyaadhaaf murtii ni kenna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:8"
      },
      "items": [
        {
          "text": "sabootas murtii qajeelaadhaan bulcha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.8",
            "verseOrgIds": [
              "PSA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.9",
                "verseOrgIds": [
                  "PSA.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "warra cunqurfamaniif irkoo dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:9"
      },
      "items": [
        {
          "text": "yeroo rakkinaattis daʼoo dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.9",
            "verseOrgIds": [
              "PSA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri maqaa kee beekan si amanatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:10"
      },
      "items": [
        {
          "text": "yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.10",
                "verseOrgIds": [
                  "PSA.9.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", ati warra si barbaadan gattee hin beektuutii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.10",
            "verseOrgIds": [
              "PSA.9.11"
            ]
          }
        }
      ]
    },
