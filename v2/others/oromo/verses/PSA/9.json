          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.9.11",
                "verseOrgIds": [
                  "PSA.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": "isa Xiyoon irra jiraatu faarfannaadhaan jajadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:11"
      },
      "items": [
        {
          "text": "hojii isaa illee saboota keessatti labsaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.11",
            "verseOrgIds": [
              "PSA.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
