      "attrs": {
        "style": "q2",
        "vid": "PSA 9:14"
      },
      "items": [
        {
          "text": "akka galata kee labsuu fi fayyisuu keettis",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.14",
            "verseOrgIds": [
              "PSA.9.15"
            ]
          }
        }
