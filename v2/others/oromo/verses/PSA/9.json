      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 9:12"
      },
      "items": [
        {
          "text": "iyya warra dhiphataniis hin irraanfatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.9.12",
            "verseOrgIds": [
              "PSA.9.13"
            ]
          }
        }
      ]
    },
