    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kadhannaa Haaloo Baasuuf Dhiʼaate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura Buʼaa Faarfattootaatiif. Faarfannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 109:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa ani galateeffadhu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:1"
      },
      "items": [
        {
          "text": "ati hin calʼisin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 109:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni hamoonnii fi gowwoomsitoonni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:2"
      },
      "items": [
        {
          "text": "afaan isaanii natti banatanii jiruutii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:2"
      },
      "items": [
        {
          "text": "isaan arraba sobaatiin maqaa na balleessaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 109:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan dubbii jibbaatiin na marsan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:3"
      },
      "items": [
        {
          "text": "sababii tokko malees na lolan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 109:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma ani isaan jaalladhuu na himatan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:4"
      },
      "items": [
        {
          "text": "ani garuu nan kadhadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 109:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda waan gaarii hammina,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:5"
      },
      "items": [
        {
          "text": "qooda jaalala koo immoo jibba naa deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 109:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni isa mormuuf nama itti ramadi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:6"
      },
      "items": [
        {
          "text": "seexannis karaa mirga isaa haa dhaabatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 109:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu qoratamutti isatti haa muramu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:7"
      },
      "items": [
        {
          "text": "kadhannaan isaas cubbuu isatti haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 109:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuriin isaa haa gabaabbatu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:8"
      },
      "items": [
        {
          "text": "aangoo isaa namni biraa haa fudhatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 109:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen isaa abbaa malee haa hafan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:9"
      },
      "items": [
        {
          "text": "niitiin isaas haadha hiyyeessaa haa taatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 109:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen isaa kadhattoota asii fi achi jooran haa taʼan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:10"
      },
      "items": [
        {
          "text": "mana isaanii diigamaa keessaa illee haa ariʼaman.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 109:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan inni qabu hunda namni isa irraa liqii qabu haa fudhatu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:11"
      },
      "items": [
        {
          "text": "buʼaa dadhabbii isaa illee karaa adeemtonni haa saaman.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 109:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko iyyuu isaaf hin naʼin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:12"
      },
      "items": [
        {
          "text": "yookaan ijoollee isaa kanneen abbaa hin qabneef garaa hin laafin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 109:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyiin isaa haa dhumu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:13"
      },
      "items": [
        {
          "text": "maqaan isaanii dhaloota itti aanu keessaa haa balleeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 109:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balleessaan abbootii isaa fuula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.14",
                "verseOrgIds": [
                  "PSA.109.14"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti haa yaadatamu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:14"
      },
      "items": [
        {
          "text": "cubbuun haadha isaas hin haqamin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 109:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni seenaa isaanii lafa irraa balleessuuf,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:15"
      },
      "items": [
        {
          "text": "cubbuun isaanii yeroo hunda fuula",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.15",
                "verseOrgIds": [
                  "PSA.109.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dura haa jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 109:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hiyyeeyyii fi rakkattoota,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:16"
      },
      "items": [
        {
          "text": "warra garaan isaanii madaaʼes hamma duʼaatti gugse malee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:16"
      },
      "items": [
        {
          "text": "garaa isaaniif laafuu hin yaadneetii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
