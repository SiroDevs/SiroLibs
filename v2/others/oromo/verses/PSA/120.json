          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni xiyya loltootaa kan qarameen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.4",
            "verseOrgIds": [
              "PSA.120.4"
            ]
          }
