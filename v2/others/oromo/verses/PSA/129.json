          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼel akkana haa jedhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.1",
            "verseOrgIds": [
              "PSA.129.1"
            ]
