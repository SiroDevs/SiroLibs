      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:5"
      },
      "items": [
        {
          "text": "qaaniidhaan duubatti haa deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.5",
            "verseOrgIds": [
              "PSA.129.5"
            ]
          }
        }
