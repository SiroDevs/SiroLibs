            "number": "2",
            "style": "v",
            "sid": "PSA 129:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan dargaggummaa kootii jalqabanii akka malee na cunqursaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.2",
            "verseOrgIds": [
              "PSA.129.2"
            ]
          }
        }
