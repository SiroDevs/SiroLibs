    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:2"
      },
      "items": [
        {
          "text": "garuu na hin moʼanne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.2",
            "verseOrgIds": [
              "PSA.129.2"
            ]
          }
        }
      ]
