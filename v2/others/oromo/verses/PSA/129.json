        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:7"
      },
      "items": [
        {
          "text": "yookaan namichi walitti qabu bissii isaa guuttachuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.7",
            "verseOrgIds": [
