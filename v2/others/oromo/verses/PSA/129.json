                "verseOrgIds": [
                  "PSA.129.8"
                ]
              }
            }
          ]
        },
        {
          "text": "isiniif haa taʼu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.8",
            "verseOrgIds": [
              "PSA.129.8"
            ]
