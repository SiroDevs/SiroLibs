      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "jireenyas ajajeeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
