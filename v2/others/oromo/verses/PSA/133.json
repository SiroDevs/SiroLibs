          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni tokkummaadhaan walii wajjin jiraachuun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.1",
            "verseOrgIds": [
              "PSA.133.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:1"
      },
      "items": [
        {
          "text": "akkam gaarii dha! Akkam namatti tolas!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.1",
            "verseOrgIds": [
              "PSA.133.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 133:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun akka zayitii gatii guddaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "kan mataa irratti dhangalaafamee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "akka isa areeda irra gad yaaʼuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "areeda Aroon irra, morma uffata isaa irras gad yaaʼa ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 133:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma fixeensa Hermoon,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "kan Tulluu Xiyoon irra gad yaaʼuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "Achi irratti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.133.3",
                "verseOrgIds": [
                  "PSA.133.3"
                ]
              }
            }
          ]
        },
        {
          "text": "hamma bara baraatti eebba isaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
