  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "75",
        "style": "c",
        "sid": "PSA 75"
      },
      "items": [
        {
          "text": "75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Abbaa Murtii Addunyaa Hundaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura Buʼaa Faarfattootaatiif. Faarfannaa Yeedaloo, \"Hin balleessin\" jedhuun faarfatame. Faarfannaa Asaaf.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 75:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, nu si galateeffanna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "sababii Maqaan kee dhiʼoo taʼeef galata siif galchina;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "namoonni waaʼee dinqii hojii keetii odeessu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 75:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akkana jetta; \"Ani yeroo murteeffame nan filadha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:2"
      },
      "items": [
        {
          "text": "kan qajeelummaadhaan muru ana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 75:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu laftii fi sabni ishee hundi raafamanitti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:3"
      },
      "items": [
        {
          "text": "kan utubaa ishee jabeessee qabu ana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 75:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani of tuultotaan akkana nan jedha; 'Of hin jajinaa.'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:4"
      },
      "items": [
        {
          "text": "Hamootaanis, 'Gaanfa keessan ol hin qabatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 75:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaanfa keessan samiitti hin kaasinaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:5"
      },
      "items": [
        {
          "text": "morma keessan dheereffattanii hin dubbatinaa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 75:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulfinni baʼa biiftuutii yookaan lixa biiftuutii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:6"
      },
      "items": [
        {
          "text": "yookaan lafa onaatii hin dhufuutii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 75:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu kan murtii kennu Waaqa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:7"
      },
      "items": [
        {
          "text": "inni nama tokko gad buusa; kaan immoo ol baasa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 75:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.75.8",
                "verseOrgIds": [
                  "PSA.75.9"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "xoofoo wayinii urgooftuudhaan walitti makame",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "kan hoomachaan guutame tokkotu jira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "inni wayinii sana gad naqa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "hamoonni lafaa hundinuu utuu siicoo isaa illee hin hambisin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "xuruurfatanii dhugu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 75:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu bara baraan waan kana nan labsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:9"
      },
      "items": [
        {
          "text": "Waaqa Yaaqoobis nan faarfadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 75:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaanfa hamoota hundaa nan caccabsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:10"
      },
      "items": [
        {
          "text": "gaanfi qajeeltotaa garuu ol ol jedha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    }
  ],
