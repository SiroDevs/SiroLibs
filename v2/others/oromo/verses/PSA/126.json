                "verseId": "PSA.126.1",
                "verseOrgIds": [
                  "PSA.126.1"
                ]
              }
            }
          ]
        },
        {
          "text": "warra boojiʼamanii turan gara Xiyoonitti deebisetti,",
          "type": "text",
          "attrs": {
