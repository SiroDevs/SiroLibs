        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haamaan Fannifame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichii fi Haamaan gara cidha Asteer Mootittiin qopheessite sanaa dhaqan;",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.1",
            "verseOrgIds": [
              "EST.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "utuma guyyaa lammaffaa sanatti daadhii wayinii dhugaa jiranuu, mootichi akkana jedhee gaafate; \"Yaa Asteer Mootittii wanni ati kadhattu maal? Wanni sun siif kennama. Gaaffiin kee maal? Walakkaa mootummaa koo illee taanaan wanni ati gaafattu siif kennama.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.2",
            "verseOrgIds": [
              "EST.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asteer Mootittiin akkana jettee deebifte; \"Yaa mooticha, yoo ani fuula kee duratti fudhatama argadhee jiraadhe, yoo wanni kunis mooticha gammachiise, lubbuu koo naaf oolchi; kadhaan koo kanuma. Saba koo illee naaf baraar; gaaffiin koos kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.3",
            "verseOrgIds": [
              "EST.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anii fi sabni koo ajjeefamuutti, barbadeeffamuu fi lafa irraa balleeffamuutti gurguramneerraatii. Nu utuu dhiiraa fi dubartiin garbummaa qofatti gurguramne taʼee, ani silaa nan calʼisan ture; rakkinni akkasii mooticha jeequuf sababii gaʼaa mitiitii.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.4",
            "verseOrgIds": [
              "EST.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahashweroos Mootichis, \"Inni eenyuu? Namni waan akkasii gochuuf ija jabaate sun eessa jira?\" jedhee Asteer Mootittii gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.5",
            "verseOrgIds": [
              "EST.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asteer immoo, \"Amajaajii fi diinni sun Haamaan namichuma jalʼaa kanaa dha\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.6",
            "verseOrgIds": [
              "EST.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:6"
      },
      "items": [
        {
          "text": "Kana irratti Hamaan fuula mootichaatii fi mootittii duratti akka malee rifate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.6",
            "verseOrgIds": [
              "EST.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis aaree kaʼee daadhii wayinii isaa dhiisee gad baʼee iddoo biqiltuu masaraa mootummaa seene. Haamaan garuu akka mootichi isa balleessuudhaaf kutate beekkatee lubbuu ofii oolfachuudhaaf Asteer Mootittii kadhachuudhaaf duubatti hafe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.7",
            "verseOrgIds": [
              "EST.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo mootichi iddoo biqiltuu masaraa mootummaatii gara galma cidhaatti deebiʼetti Haamaan siree Asteer itti irkattee turte irratti gombifamee ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:8"
      },
      "items": [
        {
          "text": "Mootichis, \"Inni inumaa iyyuu manuma koo keessatti utuma isheen na wajjin jirtuu ishee qabataa?\" jedhee dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:8"
      },
      "items": [
        {
          "text": "Akkuma dubbiin kun afaan mootichaatii baʼeen isaan fuula Haamaan haguugan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis xuʼaashiiwwan mooticha tajaajilan keessaa Harboonaan akkana jedhe; \"Mukni dhundhuma shantama ol dheeratu tokko mana Haamaa bira dhaabameera. Muka kanas Haamaanitu Mordekaayi isa mooticha gargaaruudhaaf dubbate sana itti fannisuudhaaf dhaabe.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:9"
      },
      "items": [
        {
          "text": "Mootichis, \"Achi irratti isa fannisaa!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isaan muka inni Mordekaayiif qopheesse sana irratti Haamaanin fannisan. Ergasiis aariin mootichaa ni qabbanaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.10",
            "verseOrgIds": [
              "EST.7.10"
            ]
          }
        }
      ]
    }
  ],
