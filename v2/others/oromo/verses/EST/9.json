        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyoonni kunneen dhaloota hunda keessatti, maatii hundaan, kutaalee biyyaa hundaa fi magaalaa hunda keessatti yaadatamuu fi kabajamuu qabu; guyyoonni Furiim kunneen Yihuudootaan kabajamuunis hafuu hin qabu; yaadannoon guyyoota kanneeniis sanyii isaanii keessaa baduu hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EST 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Asteer Mootittiin intalli Abiihaayil sun Mordekaayi Yihuudicha wajjin taʼanii xalayaa lammaffaa waaʼee Furiim dubbatu kana mirkaneessuudhaaf aangoo guutuudhaan barreessan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EST 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaayis Yihuudoota kutaalee biyyaa 127 kanneen mootummaa Ahashweroos keessa jiraatan hundatti dubbii hawwii nagaatii fi qabbanaa barreessee erge.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EST 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akka guyyoonni Furiim kunneen akkuma Mordekaayi Yihuudichii fi Asteer Mootittiin isaaniif labsanitti, akkuma isaanis ofii isaaniitii fi sanyiiwwan isaaniitiif waaʼee soomaatii fi yeroo booʼicha isaanii ilaalchisee dhaabbatanitti yeroo murtaaʼetti ayyaaneffamuuf.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EST 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labsiin Asteeris seera waaʼee Furiim kana mirkaneesse; wanni kunis galmee keessatti barreeffame.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.32",
            "verseOrgIds": [
              "EST.9.32"
            ]
          }
