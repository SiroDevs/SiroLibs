  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EST 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moʼannoo Yihuudootaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii kudha sadaffaa jiʼa kudha lammaffaatti, jiʼa Adaar keessa labsiin mootichi ajaje sun hojii irra ooluu qaba ture. Guyyaa kanatti diinonni Yihuudootaa isaan moʼachuu abdatanii turan; amma garuu dubbiin garagalee Yihuudoonni warra isaan jibban sana irratti ol aantummaa argatan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.1",
            "verseOrgIds": [
              "EST.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonnis warra badiisa isaanii hawwaa turan sana balleessuudhaaf magaalaawwan ofii isaanii kanneen kutaa biyyaa Ahashweroos Mootichaa hunda keessatti argamanitti walitti qabaman. Sababii namoonni saba kaanii hundinuu Yihuudoota sodaataniif namni tokko iyyuu fuula isaanii dura dhaabachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni bebeekamoon kutaalee biyyaa hundi, ergamoonni, bulchitoonnii fi qondaaltonni mootichaa sababii Mordekaayiin sodaataniif Yihuudoota gargaaran.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaayi masaraa mootummaa keessatti beekamaa ture; waaʼeen isaa kutaalee biyyaa guutuu gaʼe; innis akka malee jabaachaa deeme.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni diinota isaanii hunda goraadeedhaan cicciranii ajjeesuudhaan barbadeessanii warra isaan jibbanis akkuma barbaadan godhan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamoo Suusaa keessattis Yihuudoonni nama dhibba shan qalanii fixan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.6",
            "verseOrgIds": [
              "EST.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma illee Paarshandaataa, Dalfoon, Asfaataa,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7",
            "verseOrgIds": [
              "EST.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phooraataa, Adaliyaa, Ariidaataa,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.8",
            "verseOrgIds": [
              "EST.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paarmaashitaa, Ariisayi, Ariidayii fi Wayizaataa ajjeesan;",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.9",
            "verseOrgIds": [
              "EST.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan kunneen ilmaan Haamaan ilma Hamedaataa namicha diina Yihuudootaa ture sanaa kurnanii dha. Yihuudoonni garuu boojuu tokko illee hin tuqne.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayʼinni namoota gamoo Suusaa keessatti ajjeefamaniis guyyuma sana mootichatti himame.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.11",
            "verseOrgIds": [
              "EST.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Asteer Mootittiidhaan akkana jedhe; \"Yihuudoonni namoota dhibba shanii fi ilmaan Haamaan kurnan gamoo Suusaa keessatti ajjeesanii balleessaniiru. Kutaalee biyyaa mootichaa kanneen hafan keessatti maal godhan laata? Amma wanni ati kadhattu maali? Wanni sun siif kennama. Gaaffiin kee maali? Wanni sunis siif guutama.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asteeris akkana jettee deebifte; \"Yoo wanni kun mooticha gammachiise akka Yihuudoonni Suusaa keessa jiran labsii harʼaa kana bori illee hojii irra oolchaniif eeyyama kennaniif; ilmaan Haamaan kurnanis muka irratti haa fannifaman.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.13",
            "verseOrgIds": [
              "EST.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi akka wanni kun raawwatamu ajaje. Labsiin tokko Suusaa keessatti labsame; isaanis ilmaan Haamaan kurnan fannisan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni Suusaa keessa jiraatan bultii kudha afuraffaa jiʼa Adaaritti walitti qabamanii nama dhibba sadii Suusaa keessatti fixan; garuu boojuu tokko illee hin tuqne.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Yihuudoonni kutaalee biyya mootichaa keessatti hafan kaanis mataa isaanii eeguu fi diinota isaanii irraa boqochuuf jedhanii walitti qabaman. Isaanis jara keessaa nama kuma torbaatamii shan fixan; garuu boojuu tokko illee hin tuqne.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kunis bultii kudha sadaffaa jiʼa Adaar keessa taʼe; guyyaa kudha afuraffaatti immoo boqotanii guyyaa sana guyyaa cidhaa fi gammachuu godhatan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayyaanni Furiim Ayyaaneffame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus Yihuudoonni Suusaa keessa jiraatan guyyaa kudha sadaffaa fi kudha afuraffaatti walitti qabaman; ergasii immoo guyyaa kudha shanaffaatti boqotanii guyyaa sana guyyaa cidhaa fi gammachuu godhatan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin Yihuudoonni baadiyyaa kanneen gandoota keessa jiraatan guyyaa kudha afuraffaa jiʼa Adaar akka guyyaa cidhaa fi gammachuutti, akka guyyaa itti kennaa waliif kennaniittis ayyaaneffataniif kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaayis wantoota kanneen galmeessee Yihuudoota kutaalee biyya Ahashweroos Mootichaa keessa dhiʼoo fi fagoo jiraatan hundatti xalayoota erge;",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka isaan waggaa waggaadhaan guyyaa kudha afuraffaa fi kudha shanaffaa jiʼa Adaar",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
              "EST.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkuma yeroo itti Yihuudoonni diinota isaanii irraa boqonnaa argataniittii fi akka jiʼa itti gaddi isaanii gara gammachuutti, booʼichi isaanii immoo gara kolfaatti geeddarameetti ayyaaneffataniif. Innis akka isaan guyyoota sana akka guyyoota cidhaa fi gammachuutti, akka guyyoota itti nyaata waliif kennanii hiyyeeyyiifis kennaa kennaniitti ayyaaneffatanitti isaaniif barreesse.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin Yihuudoonni akkuma Mordekaayi isaaniif barreessetti ayyaana ayyaaneffachuu jalqaban sana itti fufuuf walii galan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EST 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haamaan ilmi Hamedaataa namichi biyya Agaag diinni Yihuudoota hundaa sun Yihuudoota balleessuudhaaf isaanitti yaadee akka isaan badanii fi barbadeeffamaniif ixaa",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Fuur",
              "type": "text",
              "attrs": {
                "verseId": "EST.9.24",
                "verseOrgIds": [
                  "EST.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhamu buusee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EST 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo yaadni sun gurra mootichaa buʼetti mootichi akka yaadni jalʼaan kan Hamaan Yihuudootatti yaade sun matuma isaatti deebiʼee innii fi ilmaan isaa muka irratti fannifamaniif barreeffamaan ajaja dabarse.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.25",
            "verseOrgIds": [
              "EST.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EST 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu guyyoonni sun jecha",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Fuur",
              "type": "text",
              "attrs": {
                "verseId": "EST.9.26",
                "verseOrgIds": [
                  "EST.9.26"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhamu irraa Furiim jedhamanii moggaafaman. Sababii waan xalayaa kana keessatti barreeffame hundaatii fi sababii waan arganiitii fi waan isaan irra gaʼee tureetiif,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EST 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni akka guyyoonni lamaan kunneen akkuma barreeffamettii fi yeroo murteeffametti utuu addaan hin citin waggaa waggaadhaan ayyaaneffamaniif bartee ofii isaanii, kan sanyiiwwan isaaniitii fi warra isaanitti dabalaman hundaa godhanii dhaabbatan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
