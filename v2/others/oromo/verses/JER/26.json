    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ermiyaas Duʼaan Doorsifame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jalqaba bara mootummaa Yehooyaaqiim ilma Yosiyaas mooticha Yihuudaa sanaatti dubbiin kun",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.1",
                "verseOrgIds": [
                  "JER.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.2",
                "verseOrgIds": [
                  "JER.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Oobdii mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.2",
                "verseOrgIds": [
                  "JER.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa dhaabadhuutii namoota magaalaawwan Yihuudaa keessaa baʼanii mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.2",
                "verseOrgIds": [
                  "JER.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti waaqeffachuu dhufan hundatti dubbadhu. Waan ani si ajaju hunda itti himi; jecha tokko illee hin hambisin.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarii isaan dhagaʼanii tokkoon tokkoon namaa karaa isaa hamaa sana irraa ni deebiʼa taʼa. Anis gaabbee badiisa sababii hammina isaaniitiif isaanitti fiduuf yaadaa ture sana nan hambisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atis akkana jedhiin;",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.4",
                "verseOrgIds": [
                  "JER.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha; 'Yoo isin na dhagaʼuu diddanii, seera koo kan ani fuula keessan dura kaaʼe sana duukaa buʼuu baattan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "amma illee yoo isin dubbii tajaajiltoota koo raajota ani utuma isin dhagaʼuu diddanuu ammumaa amma isinitti erge sanaa illee dhaggeeffachuu baattan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.5",
            "verseOrgIds": [
              "JER.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani mana kana akkuma Shiiloo, magaalaa kana immoo saboota lafaa hunda keessatti waan abaarsaa nan godha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonni, raajonnii fi sabni hundi Ermiyaasii dubbii kana mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.7",
                "verseOrgIds": [
                  "JER.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti dubbatu dhagaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akkuma Ermiyaas waan",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.8",
                "verseOrgIds": [
                  "JER.26.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akka inni dubbatuuf isa ajaje hunda namoota hundatti, himee raawwateen luboonni, raajonnii fi namoonni hundi isa qabanii akkana jedhaniin; \"Ati duʼuu qabda!",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati maaliif akka manni kun akkuma Shiiloo taʼuu fi akka magaalaan kunis onee duwwaa hafu maqaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.9",
                "verseOrgIds": [
                  "JER.26.9"
                ]
              }
            }
          ]
        },
        {
          "text": "raajii dubbatta?\" Namoonni hundis mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.9",
                "verseOrgIds": [
                  "JER.26.9"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti Ermiyaasin marsan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni Yihuudaa yommuu waan kana dhagaʼanitti mana Mootii keessaa gara mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.10",
                "verseOrgIds": [
                  "JER.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ol baʼanii balbala karra Haaraa kan mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.10",
                "verseOrgIds": [
                  "JER.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": "dura tataaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti luboonnii fi raajonni sun qondaaltotaa fi namoota hundaan, \"Waan namichi kun magaalaa kana irratti raajii dubbateef duuti isatti muramuu qaba. Isin waan kana gurruma keessaniin dhageessaniirtu!\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaas qondaaltota hundaa fi namoota hundaan akkana jedhe; \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.12",
                "verseOrgIds": [
                  "JER.26.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akka ani waan isin dhageessan kana hunda mana kanaa fi magaalaa kana irratti raajii dubbadhuuf na erge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isin amma karaa keessanii fi hojii keessan qajeelfadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.13",
                "verseOrgIds": [
                  "JER.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessaniif illee ajajamaa. Yoos",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.13",
                "verseOrgIds": [
                  "JER.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "gaabbee balaa isinitti fiduuf yaade sana ni dhiisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu harkuma keessan keessa nan jira; isin tarkaanfii gaarii fi qajeelaa isinitti fakkaate narratti fudhadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.14",
            "verseOrgIds": [
              "JER.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu isin yoo na ajjeeftan akka dhiiga nama balleessaa hin qabnee dhangalaasuu keessaniin ofitti, magaalaa kanattii fi warra ishee keessa jiraatanitti balaa fiddan beekkadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.15",
                "verseOrgIds": [
                  "JER.26.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dhugumaan akka ani dubbii isin dhageessan kana hunda dubbadhuuf isinitti na ergeeraatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti qondaaltonnii fi namoonni hundi, lubootaa fi raajotaan, \"Namicha kanatti duuti muramuu hin qabu! Inni maqaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.16",
                "verseOrgIds": [
                  "JER.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaatiin nutti dubbatee jiraa\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maanguddoota biyyaa keessaas tokko tokko kaʼanii waldaa sabaa guutuudhaan akkana jedhan;",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bara Hisqiyaas mootii Yihuudaa ture keessa Miikiyaas namni biyya Mooresheet akkana jedhee saba Yihuudaa hundatti raajii dubbate; '",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.18",
                "verseOrgIds": [
                  "JER.26.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 26:18"
      },
      "items": [
        {
          "text": "\" 'Xiyoon akkuma lafa qotiisaatti qotamti;",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 26:18"
      },
      "items": [
        {
          "text": "Yerusaalemis tuullaa waan diigamee taati;",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 26:18"
      },
      "items": [
        {
          "text": "gaarri mana qulqullummaas tabba daggalaan liqimfame taʼa.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hisqiyaas mootichi Yihuudaa yookaan saba Yihuudaa keessaa namni tokko iyyuu isa ajjeeseeraa? Hisqiyaas",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.19",
                "verseOrgIds": [
                  "JER.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaatee araara isaa hin kadhannee?",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.19",
                "verseOrgIds": [
                  "JER.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "gaabbee badiisa isaanitti fiduu yaade sana hin dhiifnee? Nus badiisa hamaa ofitti fiduu geenyeerra!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.19",
            "verseOrgIds": [
              "JER.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni maqaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "JER.26.20",
                "verseOrgIds": [
                  "JER.26.20"
                ]
              }
            }
          ]
        },
        {
          "text": "raajii dubbate kan biraa immoo Uuriyaa ilma Shemaaʼiyaa nama biyya Kiriyaati Yeʼaariim ture; innis akkuma Ermiyaas magaalaa kanaa fi biyya kana irratti raajii dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.20",
            "verseOrgIds": [
              "JER.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Yehooyaaqiim mootichi, ajajjoonnii fi qondaaltonni isaa hundi dubbii Uuriyaa dhagaʼanitti mootichi isa ajjeesisuu barbaade; Uuriyaan garuu waan kana dhageenyaan sodaatee gara Gibxitti baqate.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.21",
            "verseOrgIds": [
              "JER.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaaqiim mootichi garuu Elnaataan ilma Akboor namoota biraa wajjin gara Gibxitti erge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.22",
            "verseOrgIds": [
              "JER.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Uuriyaa Gibxii fidanii Yehooyaaqiim mootichatti kennan; mootichis goraadeedhaan isa ajjeese; reeffa isaa immoo iddoo namoonni ulfina hin qabne itti awwaalamanitti gate.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiiqaam ilmi Shaafaan garuu Ermiyaasin deeggare; kanaafuu Ermiyaas ajjeefamuuf dabarfamee namootatti hin kennamne.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.24",
            "verseOrgIds": [
              "JER.26.24"
            ]
          }
        }
      ]
    }
