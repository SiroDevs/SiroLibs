  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "JER 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Barreeffama Kitaaba Maramaa Irraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yehooyaaqiim ilmi Yosiyaas mootii Yihuudaa ture keessa waggaa afuraffaatti dubbiin akkana jedhu",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.1",
            "verseOrgIds": [
              "JER.36.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.1",
                "verseOrgIds": [
                  "JER.36.1"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa gara Ermiyaas dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.1",
            "verseOrgIds": [
              "JER.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kitaaba maramaa fudhadhuutii dubbii ani bara mootummaa Yosiyaasii jalqabee hamma ammaatti waaʼee Israaʼelii fi waaʼee Yihuudaa, waaʼee saboota kaan hundaas sitti dubbadhe sana hunda irratti barreessi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.2",
            "verseOrgIds": [
              "JER.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarii sabni Yihuudaa yeroo waaʼee badiisa ani isaanitti fiduuf yaade hundaa dhagaʼanitti tokkoon tokkoon isaanii karaa isaanii hamaa sana irraa ni deebiʼu taʼa; yoos ani hammina isaaniitii fi cubbuu isaanii nan dhiisaaf.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaasis Baaruk ilma Neeriyaa waame; Baaruk immoo dubbii",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.4",
                "verseOrgIds": [
                  "JER.36.4"
                ]
              }
            }
          ]
        },
        {
          "text": "dubbate sana Ermiyaas irraa dhagaʼee kitaaba maramaa irratti barreesse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaas akkana jedhee Baarukin ajaje; \"Ani mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.5",
                "verseOrgIds": [
                  "JER.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "seenuu dhowwameera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ati guyyaa soomaa tokko mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.6",
                "verseOrgIds": [
                  "JER.36.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dhaqiitii dubbii",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.6",
                "verseOrgIds": [
                  "JER.36.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kan narraa dhageessee barreessite sana kitaaba maramaa irraa sabaaf dubbisi. Namoota Yihuudaa warra magaalaawwan isaanii irraa dhufan hundaaf dubbii sana dubbisi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarii isaan kadhannaa isaanii fuula",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.7",
                "verseOrgIds": [
                  "JER.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti dhiʼeeffatanii tokkoon tokkoon isaanii karaa isaanii hamaa sana irraa ni deebiʼu taʼa; aarii fi dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.7",
                "verseOrgIds": [
                  "JER.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": "saba kana irratti labse guddadhaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaruk ilmi Neeriyaas waan Ermiyaas raajichi isatti hime hunda ni hojjete; mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.8",
                "verseOrgIds": [
                  "JER.36.8"
                ]
              }
            }
          ]
        },
        {
          "text": "keessattis kitaaba maramaa sana irraa dubbii",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.8",
                "verseOrgIds": [
                  "JER.36.8"
                ]
              }
            }
          ]
        },
        {
          "text": "dubbise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yehooyaaqiim ilmi Yosiyaasi mootii Yihuudaa ture keessa jiʼa saglaffaa waggaa shanaffaatti guyyaan fuula",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.9",
                "verseOrgIds": [
                  "JER.36.9"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti sooman tokko saba Yerusaalem keessa jiraatuu fi warra magaalaawwan Yihuudaatii dhufan hundaaf ni labsame.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baarukis kutaa Gemaariyaa ilma Shaafaan barreessaa sanaa kan oobdii ol aanaa keessa balbala mana qulqullummaa, kan Karra Haaraa jedhamu biraa sana keessa dhaabatee saba mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.10",
                "verseOrgIds": [
                  "JER.36.10"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa ture hundaaf dubbii Ermiyaas sana kitaaba maramaa irraa dubbise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miikiyaas ilmi Gemaariyaa ilma Shaafaan yeroo dubbii",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.11",
                "verseOrgIds": [
                  "JER.36.11"
                ]
              }
            }
          ]
        },
        {
          "text": "hunda kitaaba maramaa irraa dhagaʼetti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "gara kutaa barreessaa kan masaraa mootummaa keessaa, iddoo qondaaltonni hundi tataaʼaa turanitti gad buʼe; isaanis Eliishaamaa barreessaa, Delaayaa ilma Shemaaʼiyaa, Elnaataan ilma Akboor, Gemaariyaa ilma Shaafaan, Zedeqiyaas ilma Hanaaniyaatii fi qondaaltota biraa hundaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.12",
            "verseOrgIds": [
              "JER.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miikiyaas waan yeroo Baaruk kitaaba maramaa irraa uummataaf dubbisetti dhagaʼe sana hunda isaaniitti hime.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.13",
            "verseOrgIds": [
              "JER.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni hundis akka inni Baarukiin, \"Kitaaba maramaa uummataaf dubbifte sana fidii kottu\" jedhuuf Yehuudii ilma Naataaniyaa, ilma Shelemiyaa, ilma Kuushii ergan. Kanaafuu Baaruk ilmi Neeriyaa kitaaba maramaa sana harkatti qabatee gara isaanii dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.14",
            "verseOrgIds": [
              "JER.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarris, \"Maaloo, taaʼiitii kitaabicha nuu dubbisi\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.15",
            "verseOrgIds": [
              "JER.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 36:15"
      },
      "items": [
        {
          "text": "Kanaafuu Baaruk kitaaba sana isaaniif dubbise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.15",
            "verseOrgIds": [
              "JER.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis yommuu dubbii kana hunda dhagaʼanitti sodaadhaan wal ilaalanii Baarukiin, \"Nu waan kana hunda mootichatti himuu qabna\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.16",
            "verseOrgIds": [
              "JER.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii isaan Baarukiin, \"Mee nutti himi; ati akkamitti waan kana hunda barreessite? Ermiyaasitu sitti himee?\" jedhanii gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baarukis, \"Eeyyee, Ermiyaasitu dubbii kana hunda natti hime; ani immoo qalamiidhaan kitaaba maramaa irratti barreesse\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti qondaaltonni sun Baarukiin, \"Atii fi Ermiyaas dhaqaa dhokadhaa. Namni tokko iyyuu iddoo isin jirtan hin beekin\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis kitaaba maramaa sana kutaa Eliishaamaa barreessaa sanaa keessa kaaʼanii mooticha bira gara oobdii dhaqanii waan hunda isatti himan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.20",
            "verseOrgIds": [
              "JER.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis akka inni kitaabicha fiduuf Yihuudii erge; Yehuudiinis kutaa Eliishaamaa barreessaa sanaa keessaa kitaabicha fidee mootichaa fi qondaaltota isa bira dhaabachaa turan hundaaf dubbise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.21",
            "verseOrgIds": [
              "JER.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroon sun jiʼa saglaffaa ture; mootichis mana itti yeroo gannaa dabarsu keessa taaʼaa ture; ibiddi girgiraa guddaa irratti bobaʼus fuula isaa dura ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.22",
            "verseOrgIds": [
              "JER.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Yehuudiin kitaaba maramaa sana keessaa boʼoo sadii yookaan afur dubbisutti, mootichi hamma kitaabni sun guutumaan guutuutti gubatee dhumutti haaduu barreessaatiin kukkutee girgiraa ibiddaatti darbachaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.23",
            "verseOrgIds": [
              "JER.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼu illee mootichii fi tajaajiltoonni isaa kanneen dubbii kana hunda dhagaʼan hundi homaa hin sodaanne yookaan uffata isaanii hin tarsaafne.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.24",
            "verseOrgIds": [
              "JER.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi yoo Elnaataan, Delaayaa fi Gemaariyaan akka inni kitaabicha hin gubneef isa kadhatan iyyuu isaan hin dhageenye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.25",
            "verseOrgIds": [
              "JER.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda kanaa mootichi akka isaan Baaruk barreessaa sanaa fi Ermiyaas raajicha hidhaniif Yeramiʼeel ilma mootii, Seraayaa ilma Azriiʼeeliitii fi Shelemiyaa ilma Abdiʼeel ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.26",
                "verseOrgIds": [
                  "JER.36.26"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu isaan dhoksee ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga mootichi kitaaba maramaa kan Baaruk dubbii Ermiyaas irraa dhagaʼe itti barreesse sana gubee booddee dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.27",
                "verseOrgIds": [
                  "JER.36.27"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara Ermiyaas dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kitaaba maramaa biraa fuudhiitii dubbii kitaabicha duraa kan Yehooyaaqiim mootichi Yihuudaa gube irra ture sana hunda itti barreessi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.28",
            "verseOrgIds": [
              "JER.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaaqiim mooticha Yihuudaatiinis akkana jedhi; '",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.29",
                "verseOrgIds": [
                  "JER.36.29"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Ati kitaaba maramaa sana gubdee, \"Ati maaliif akka mootiin Baabilon dhugumaan dhufee biyya kana balleessee namaa fi horii keessaa hobbaasu kitaabicha irratti barreessite?\" jettee gaafatte.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.36.30",
                "verseOrgIds": [
                  "JER.36.30"
                ]
              }
            }
          ]
        },
        {
          "text": "waaʼee Yehooyaaqiim mooticha Yihuudaa akkana jedha: Inni nama teessoo Daawit irra taaʼu hin qabaatu; reeffi isaas gad darbatamee hoʼa guyyaatii fi qorra halkaniitti ni saaxilama.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani sababii hammina isaaniitiif isa, ijoollee isaatii fi tajaajiltoota isaa nan adaba; sababii isaan na dhaggeeffachuu didaniif ani balaa isaanittin fida jedhee labse sana hunda isaanitti, namoota Yerusaalem keessa jiraatanii fi namoota Yihuudaatti nan fida.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Ermiyaas kitaaba maramaa kan biraa fuudhee Baaruk ilma Neeriyaa barreessaa sanatti kenne; Baarukis akkuma Ermiyaas itti himetti dubbii kitaaba maramaa Yehooyaaqiim mootichi Yihuudaa ibiddaan gube sana irra ture hunda itti barreesse. Dubbiin dubbii kana fakkaattu hedduunis itti dabalameera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
    }
  ],
