    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ermiyaas Hidhamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezar mootichi Baabilon Zedeqiyaa ilma Yosiyaas mootii Yihuudaa taasise; innis iddoo Yehooyaakiin ilma Yehooyaaqiim buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu inni yookaan tajaajiltoonni isaa yookaan sabni biyya sanaa dubbii",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.2",
                "verseOrgIds": [
                  "JER.37.2"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Ermiyaas raajichaatiin dubbate sana hin qalbeeffanne.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus Zedeqiyaa mootichi, \"Maaloo",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.3",
                "verseOrgIds": [
                  "JER.37.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenya nuu kadhadhu\" jedhee Yehuukal ilma Shelemiyaatii fi Sefaaniyaa lubicha ilma Maʼaseyaa gara Ermiyaas raajichaatti erge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaas waan yeroo sanatti mana hidhaatti hin galfaminiif sodaa malee saba gidduu ni deddeebiʼa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonni Faraʼoon Gibxii baʼanii turan; Baabilononni Yerusaalemin marsanii turanis yommuu waan kana dhagaʼanitti Yerusaalemin dhiisanii baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.6",
                "verseOrgIds": [
                  "JER.37.6"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara Ermiyaas raajichaa dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.7",
                "verseOrgIds": [
                  "JER.37.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Waaqni Israaʼel akkana jedha: Mooticha Yihuudaa isa akka isin waa na gaafattaniif isin erge sanaan akkana jedhaa; 'Loltoonni Faraʼoon kanneen isin gargaaruuf dhufan sun gara biyya isaanii, gara Gibxitti ni deebiʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Baabilononni deebiʼanii magaalaa kana ni dhaʼu; ni qabatu; ni gubus.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.9",
                "verseOrgIds": [
                  "JER.37.9"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: 'Baabilononni dhugumaan nu dhiisanii deemu' jettanii yaaduudhaan of hin gowwoomsinaa; isaan hin deemaniitii!",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu isin loltoota Baabilonotaa kanneen isin lolaa jiran kana hunda moʼattanii warri madaaʼan qofti dunkaana isaanii keessatti hafanii iyyuu isaan gad baʼanii magaalaa kana ni gubu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga loltoonni Baabilonotaa sababii waraana Faraʼooniif jedhanii Yerusaalemin dhiisanii baʼanii as,",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaas saba achi jiraatu keessaa qooda qabeenyaa kan isa gaʼu argachuuf jedhee Yerusaalemii kaʼee biyya Beniyaam dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo inni karra Beniyaam bira gaʼetti Yiriyaan ilmi Shelemiyaa, ilmi Hanaaniyaa itti gaafatamaan eegumsaa sun, \"Ati gara Baabilonotaatti sokkaa jirta!\" jedhee Ermiyaas raajicha qabee hidhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaas immoo, \"Kun dhugaa miti! Ani gara Baabilonotaatti sokkuutti hin jiru\" jedhe. Yiriyaan garuu isa dhagaʼuu dide; qooda kanaa Ermiyaasin qabee qondaaltotatti dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Ermiyaasitti aaranii isa tuman; mana Yoonaataan barreessaa sanaa kan mana hidhaa godhatan sana keessatti isa hidhan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaasis kutaa mana boollaa keessa buufame; achis yeroo dheeraa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Zedeqiyaa Mootichi nama itti ergee gara masaraa ofii isaatti isa fichisiise. Achittis kophaatti baasee, \"Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.17",
                "verseOrgIds": [
                  "JER.37.17"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa dhufe tokko iyyuu jiraa?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 37:17"
      },
      "items": [
        {
          "text": "Ermiyaasis, \"Eeyyee; ati dabarfamtee mootii Baabiloniitti ni kennamta\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Ermiyaas, Zedeqiyaas mootichaan akkana jedhe; \"Ani sitti yookaan qondaaltota keetti yookaan saba kanatti balleessaa maalii hojjennaan isin mana hidhaa keessa na buuftan?",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.18",
            "verseOrgIds": [
              "JER.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajonni kee warri, 'Mootiin Baabilon siʼi yookaan biyya kana hin lollu' jedhanii raajii siif dubbatan sun eessa jiru?",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.19",
            "verseOrgIds": [
              "JER.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu gooftaa koo yaa mootichaa, maaloo na dhagaʼi. Ani iyyata koo fuula kee duratti nan dhiʼeeffadhaatii, mana Yoonaataan barreessaa sanaatti deebiftee na hin ergin; yoo ati na ergite ani achumatti duʼaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.20",
            "verseOrgIds": [
              "JER.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Zedeqiyaa Mootichi akka Ermiyaas oobdii eegumsaa keessa kaaʼamuu fi akka isaan hamma buddeenni magaalaa sanaa dhumutti guyyaa guyyaatti buddeena tokko tokko warra buddeena tolchan irraa fuudhanii isaaf kennan ajaje. Akkasiin Ermiyaas oobdii eegumsaa keessa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.21",
            "verseOrgIds": [
              "JER.37.21"
            ]
          }
        }
      ]
    }
  ],
