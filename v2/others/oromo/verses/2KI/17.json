    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Aahaaz mooticha Yihuudaa keessa waggaa kudha lammaffaatti Hoosheeʼaa ilmi Eelaa Samaariyaa keessatti mootii Israaʼel taʼee waggaa sagal bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.2",
                "verseOrgIds": [
                  "2KI.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete; garuu akka mootota Israaʼel kanneen isaan dura turan sanaa miti.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalmaneseer mootichi Asoor Hoosheeʼaa loluuf ol baʼe; Hooseʼaas garboomeefii gibira baaseef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Asoor garuu akka Hoosheeʼaa gantuu taʼe hubate; Hooseʼaa Siigoor mooticha Gibxitti jaarsa araaraa ergatee ergasii akka duraan wagguma waggaan baasaa ture sana mootii Asooriif gibira baasuu dhiise. Kanaafuu Silminaasoor isa qabee mana hidhaa keessa buuse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis mootichi Asoor guutummaa biyyattii weerare; Samaariyaattis duulee waggaa sadii marsee ishee qabate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara mootummaa Hoosheeʼaa keessa waggaa saglaffaatti mootiin Asoor Samaariyaa qabatee Israaʼeloota boojiʼee Asooritti geesse. Innis Halaa keessa, Goozaan keessa, cina Laga Haaboorii fi magaalaawwan Midiyaan keessa isaan qubachiise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sabni Israaʼel Sababii Cubbuutiif Boojiʼame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kun hundinuu sababii Israaʼeloonni",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.7",
                "verseOrgIds": [
                  "2KI.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaanii isa Gibxii humna Faraʼoon mooticha Gibxi jalaa isaan baase sanatti cubbuu hojjetaniif taʼe; isaan waaqota biraa waaqeffatanii",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan saboonni",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.8",
                "verseOrgIds": [
                  "2KI.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "isaan duraa ariʼee baase sun hojjetan duukaa buʼanii barteewwan hamaa mootonni Israaʼel fidanii isaan barsiisan illee fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni dhoksaadhaan waan qajeelaa hin taʼin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.9",
                "verseOrgIds": [
                  "2KI.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaaniitti hojjetan. Isaan magaalaawwan isaanii hunda keessatti gamoo eegumsaatii jalqabanii hamma magaalaawwan dallaa jabaa qabaniitti iddoowwan sagadaa kanneen gaarran irraa ijaarratan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaarran ol dhedheeroo hunda gubbaattii fi muka lalisaa hunda jalatti fakkiiwwanii fi siidaa Aasheeraa dhaabbatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akkuma saboonni",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.11",
                "verseOrgIds": [
                  "2KI.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula isaanii duraa ariʼee baase godhan sana iddoowwan sagadaa kanneen gaarran irraa hunda irratti ixaana aarsan. Waan hamaa aariidhaaf",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.11",
                "verseOrgIds": [
                  "2KI.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kakaasu illee ni hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.12",
                "verseOrgIds": [
                  "2KI.17.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Isin waan kana hin hojjetinaa\" jedhu illee isaan waaqota tolfamoo waaqeffatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.13",
                "verseOrgIds": [
                  "2KI.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee karaa raajotaatii fi ilaaltota isaa hundaatiin Israaʼelii fi Yihuudaa akeekkachiise; \"Karaa keessan hamaa kana irraa deebiʼaa. Akkuma ajajawwan ani abbootii keessan ajaje hundaattii fi akkuma seera ani karaa garboota koo raajotaatiin isiniif erge sanaatti ajajaa fi seera koo eegaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan immoo dhaggeeffachuu didanii akkuma abbootii isaanii kanneen",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.14",
                "verseOrgIds": [
                  "2KI.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaanii amanuu didan sanaa mataa jabaatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan seeraa fi kakuu inni abbootii isaanii wajjin gale akkasumas akeekkachiisa inni isaaniif kenne illee fudhachuu didan. Isaan waaqota tolfamoo faayidaa hin qabne duukaa buʼanii isaanis faayidaa dhaban. Isaan utuma",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.15",
                "verseOrgIds": [
                  "2KI.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Waan jarri hojjetan hin hojjetinaa\" jedhee isaan ajajuu saboota ollaa isaanii duukaa buʼanii waan",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.15",
                "verseOrgIds": [
                  "2KI.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "hojjechuu isaan dhowwe ni hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan ajaja",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.16",
                "verseOrgIds": [
                  "2KI.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaanii hunda dhiisanii waaqota tolfamoo baqfamanii bifa jabbiitiin hojjetaman lamaa fi siidaa Aasheeraa tolfatan. Raayyaawwan samii hundaaf sagadanii Baʼaalin illee waaqeffatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan isaaniitii fi intallan isaanii aarsaa godhanii ibiddaan guban. Warra waa himu gorsa gaafatan; falfalas hojjetanii fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.17",
                "verseOrgIds": [
                  "2KI.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjechuutti dabarsanii of kennanii dheekkamsaaf isa kakaasan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
