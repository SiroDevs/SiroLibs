            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.18",
                "verseOrgIds": [
                  "2KI.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "akka malee Israaʼelitti dheekkamee fuula isaa duraa isaan buqqise. Gosa Yihuudaa qofatu hafe;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudaan iyyuu ajaja",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.19",
                "verseOrgIds": [
                  "2KI.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaanii hin eegne. Isaanis bartee Israaʼeloonni itti fidan duukaa buʼan;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.20",
                "verseOrgIds": [
                  "2KI.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "saba Israaʼel hunda ni gate; inni isaan miidhee hamma fuula isaa duraa isaan dhabamsiisutti dabarsee harka saamtotaatti isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa inni mana Daawit irraa Israaʼel baqaqsetti isaan Yerobiʼaam ilma Nebaat sana mootii godhatan. Yerobiʼaamis akka Israaʼeloonni",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.21",
                "verseOrgIds": [
                  "2KI.17.21"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa garagalanii cubbuu guddaa hojjetan godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni cubbuu Yerobiʼaam hunda keessa jiraatan malee",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamma",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.23",
                "verseOrgIds": [
                  "2KI.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": "akkuma karaa garboota isaa raajotaatiin akeekkachiise sanatti fuula isaa duraa isaan buqqisutti irraa hin deebine. Kanaafuu sabni Israaʼel biyya isaatii boojuudhaan fudhatamee Asooritti geeffame; hamma harʼaattis achuma jiraata.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asooronni Samaariyaa Keessa Qubatan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Asoor biyya Baabilonii, Kuutaadhaa, Awaadhaa, biyya Hamaatii fi Seefarwaayimii namoota fidee iddoo Israaʼelootaa buusuuf jedhee magaalaawwan Samaariyaa keessa qubachiise. Isaanis Samaariyaa fudhatanii magaalaawwan ishee keessa ni jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yeroo achi jiraachuu jalqabanitti",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.25",
                "verseOrgIds": [
                  "2KI.17.25"
                ]
              }
            }
          ]
        },
        {
          "text": "hin waaqeffanne; kanaafuu inni gidduu isaaniitti leencota erge; leenconnis isaan keessaa namoota muraasa galaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mooticha Asoorittis akkana jedhanii himan; \"Namoonni ati boojitee magaalaawwan Samaariyaa keessa qubachiifte sun waan Waaqni biyya sanaa fedhu hin beekan. Inni gidduu isaaniitti leencota erge; leenconnis sababii namoonni waan Waaqni sun fedhu hin beekiniif isaan fixan.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootiin Asoor, \"Luboota boojitanii Samaariyaadhaa fiddan keessaa tokko akka inni deebiʼee achi jiraatee waan Waaqni biyya sanaa fedhu namoota barsiisuuf achi deebisaa\" jedhee ajaja kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu luboota Samaariyaadhaa boojiʼaman keessaa tokko Beetʼeel keessa jiraatee akka isaan itti",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.28",
                "verseOrgIds": [
                  "2KI.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": "waaqeffatan barsiisuu dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus tokkoon tokkoon gosaa magaalaa keessa jiraatutti waaqota ofii isaa tolfatee iddoowwan sagadaa kanneen warri Samaariyaa gaarran irratti hojjetanii turan sana irra dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Baabilonii dhufan Waaqa tolfamaa Sukooti Banooti, warri Kuutaadhaa dhufan Waaqa tolfamaa Nergaal, warri Hamaatii dhufan immoo Waaqa tolfamaa Ashiimaa jedhamu ni tolfatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awwiimonni waaqota tolfamoo Nibhaazii fi Tartaaq jedhaman tolfatan; Seefarwaayimoonni immoo waaqota tolfamoo Seefarwaayim kanneen Adramelekii fi Anaamelek jedhamaniif ijoollee isaanii aarsaa godhanii ibiddaan guban.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.32",
                "verseOrgIds": [
                  "2KI.17.32"
                ]
              }
            }
          ]
        },
        {
          "text": "waaqeffatan; garuu akka isaan iddoowwan sagadaa kanneen gaarran irraatti luboota taʼanii tajaajilaniif ofuma gidduudhaa namoota ni filatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.33",
                "verseOrgIds": [
                  "2KI.17.33"
                ]
              }
            }
          ]
        },
        {
          "text": "waaqeffatan; garuu akkuma bartee saboota keessaa fidaman sanaatti waaqota ofii isaanii tajaajilan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan hamma harʼaatti illee ittuma cichanii bartee isaanii kan qaraa sana keessa jiraatu. Isaan",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.34",
                "verseOrgIds": [
                  "2KI.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "hin waaqeffatan yookaan labsii fi qajeelfama, seeraa fi ajaja",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.34",
                "verseOrgIds": [
                  "2KI.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "sanyiiwwan Yaaqoob kan Israaʼel jedhee moggaase sanaaf kennes duukaa hin buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.35",
                "verseOrgIds": [
                  "2KI.17.35"
                ]
              }
            }
          ]
        },
        {
          "text": "gaafa Israaʼeloota wajjin kakuu galetti akkana jedhee isaan ajaje: \"Isin Waaqa biraa tokko illee hin waaqeffatinaa yookaan hin sagadinaafii; isaan hin tajaajilinaa yookaan aarsaa isaaniif hin dhiʼeessinaa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.17.36",
                "verseOrgIds": [
                  "2KI.17.36"
                ]
              }
            }
          ]
        },
        {
          "text": "isin waaqeffachuu qabdan, isa humna jabaa fi irree diriirfameen Gibxii baasee isin fide sanaa dha. Isin isaaf sagaddanii aarsaa dhiʼeessuufii qabdu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin yeroo hunda labsii fi qajeelfama, seeraa fi ajaja inni isinii barreesse sana of eeggannaadhaan eeguu qabdu. Waaqota biraa hin waaqeffatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
