          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Murtii",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaaziyaatti Mure",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga Ahaab duʼee booddee Moʼaab Israaʼelitti fincile.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.1",
            "verseOrgIds": [
              "2KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaaziyaanis qaawwa darbii mana isaa kan Samaariyaa keessaan kufee miidhamee ture. Kanaafuu inni, \"Akka ani miidhaa kana irraa fayyuu fi fayyuu baachuu koo beekuuf dhaqaatii Baʼaal Zebuul waaqicha Eqroon sana naaf gaafadhaa\" jedhee ergamoota erge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.2",
            "verseOrgIds": [
              "2KI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.3",
                "verseOrgIds": [
                  "2KI.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu Eeliyaas namicha gosa Tishbii sanaan akkana jedhe; \"Kaʼiitii gara ergamoota mooticha Samaariyaa sanaatti ol baʼiitii akkana jedhii isaan gaafadhu; 'Wanni isin Baʼaal Zebuul waaqicha Eqroon sana gorsa gaafachuu dhaqxaniif Israaʼel keessaa Waaqni dhabameetii?'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.3",
            "verseOrgIds": [
              "2KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.4",
                "verseOrgIds": [
                  "2KI.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'Ati siree amma irra ciiftu kana irraa hin kaatu. Ati dhugumaan ni duuta!' jedha.\" Kana irratti Eeliyaas kaʼee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.4",
            "verseOrgIds": [
              "2KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis yommuu ergamoonni gara isaatti deebiʼanitti, \"Isin maaliif deebitan?\" jedhee isaan gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkana jedhanii deebisan; \"Namicha tokkotu karaatti nutti dhufee, 'Gara mooticha isin erge sanaatti deebiʼaatii akkana jedhaanii' nuun jedhe; '",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.6",
                "verseOrgIds": [
                  "2KI.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Wanni ati Baʼaal Zebuul waaqicha Eqroon sana gorsa gaafachuuf namoota ergituuf Israaʼel keessaa Waaqni dhabameetii? Kanaafuu ati siree irra ciiftu kana irraa hin kaatu. Ati dhugumaan ni duuta!' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi, \"Namichi karaatti isinitti dhufee waan kana isinitti hime sun nama akkamii ti?\" jedhee isaan gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Inni nama uffata rifeensa irraa hojjetame uffatee sabbata gogaa mudhii isaatti hidhatu tokkoo dha\" jedhanii deebisaniif.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 1:8"
      },
      "items": [
        {
          "text": "Mootichis, \"Inni Eeliyaas namicha Tishbii sanaa dha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootichi ajajaa waraanaa tokko namoota shantama wajjin Eeliyaasitti erge. Ajajaan sunis fiixee gaara inni irra taaʼaa ture tokkootti Eeliyaasitti ol baʼee, \"Yaa nama Waaqaa, mootichi 'Gad kottu!' siin jedha\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeliyaas immoo ajajaa sanaan, \"Yoo ani nama Waaqaa taʼe, ibiddi samii irraa gad buʼee siʼii fi namoota kee shantamman haa fixu!\" jedhe. Ergasii ibiddi samii irraa gad buʼee ajajaa sanaa fi namoota isaa hunda fixe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootichi amma illee ajajaa biraa namoota shantama wajjin Eeliyaasitti erge. Ajajaan sunis, \"Yaa nama Waaqaa, mootichi, 'Dafii gad buʼiitii kottu!' siin jedha\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeliyaas garuu, \"Yoo ani nama Waaqaa taʼe, ibiddi samii irraa gad buʼee siʼii fi namoota kee shantammanuu haa fixu!\" jedhee deebiseef. Ibiddi Waaqaas samii irraa gad buʼee isaa fi namoota isaa shantammanuu ni fixe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi ammas ajajaa sadaffaa namoota shantama wajjin ni erge. Ajajaan sadaffaan kun ol baʼee jilba ofii isaatiin Eeliyaas duratti jilbeenfatee akkana jedhee isa ni kadhate; \"Yaa nama Waaqaa, maaloo lubbuun koo fi lubbuun garboota kee shantamman kanneenii gatii hin dhabin!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.13",
            "verseOrgIds": [
              "2KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, ibiddi samii irraa gad buʼee ajajjuuwwan duraa lamaanii fi namoota isaanii hunda fixeera. Amma garuu lubbuun koo fuula kee duratti gatii haa qabaattu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.14",
            "verseOrgIds": [
              "2KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.15",
                "verseOrgIds": [
                  "2KI.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Eeliyaasiin, \"Isa wajjin gad buʼi; isa hin sodaatin\" jedhe. Kanaafuu Eeliyaas kaʼee isa wajjin gara mootichaatti gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.15",
            "verseOrgIds": [
              "2KI.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee mootichatti hime; \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.16",
                "verseOrgIds": [
                  "2KI.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Wanni ati Baʼaal Zebuul waaqicha Eqroon gorsa gaafachuudhaaf ergamoota ergiteef Israaʼel keessaa Waaqni gorsa gaafatamu dhabameetii? Ati sababii waan kana hojjetteef siree irra ciiftu kana irraa hin kaatu. Ati dhugumaan ni duuta!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu inni akkuma dubbii",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.1.17",
                "verseOrgIds": [
                  "2KI.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "kan Eeliyaas dubbate sanaatti duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 1:17"
      },
      "items": [
        {
          "text": "Sababii Ahaaziyaan ilma hin qabneef obboleessi isaa Yehooraam iddoo isaa buʼee mootii taʼe; kunis bara Yehooraam ilmi Yehooshaafaax mootii Yihuudaa ture keessa waggaa lammaffaatti taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Ahaaziyaa keessa hojjetaman kan biraa hundii fi wanti inni hojjete kitaaba seenaa mootota Israaʼel keessatti barreeffamaniiru mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.18",
            "verseOrgIds": [
              "2KI.1.18"
            ]
          }
        }
      ]
    }
  ],
