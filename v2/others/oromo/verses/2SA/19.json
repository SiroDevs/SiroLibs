  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "2SA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaabittis, \"Daawit mootichi Abesaaloomiif booʼuu fi gadduutti jira\" jedhamee himame.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.1",
            "verseOrgIds": [
              "2SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii guutummaan loltootaa oduu, \"Mootichi ilma isaatiif gaddaa jira\" jedhu dhagaʼeef moʼichi gaafa sanaa gaddatti geeddarame.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.2",
            "verseOrgIds": [
              "2SA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa sana sabni hundis akkuma loltoota moʼatamanii qaanaʼuudhaan baqatanii magaalaa seenaniitti qaanaʼee magaalaa seene.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.3",
            "verseOrgIds": [
              "2SA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis fuula isaa haguuggatee, \"Yaa ilma koo Abesaaloom! Yaa Abesaaloom ilma ko, yaa ilma koo!\" jedhee sagalee ol fudhatee booʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.4",
            "verseOrgIds": [
              "2SA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaab gara mootichaa mana ol seenee akkana jedhe; \"Ati harʼa fuula namoota kee kanneen lubbuu kee, lubbuu ilmaan keetiitii fi intallan keetii, lubbuu niitota keetiitii fi saajjatoowwan keetii oolchan sana hundaa qaaniidhaan haguugdeerta.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.5",
            "verseOrgIds": [
              "2SA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati warra si jibban jaallattee warra si jaallatan immoo jibbiteerta. Ati akka ajajjoota loltoota keetiitii fi namoota isaanii wayittuu hin hedne harʼa mirkaneessiteerta. Harʼa utuu hundi keenya duunee Abesaaloom jiraatee ati akka gammaddu ani nan arga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.6",
            "verseOrgIds": [
              "2SA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma gad baʼiitii namoota kee jajjabeessi. Yoo ati gad baʼuu baatte akka edana namni tokko iyyuu si biratti hin hafne ani maqaa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.7",
            "verseOrgIds": [
              "2SA.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "2SA.19.7",
                "verseOrgIds": [
                  "2SA.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nan kakadha. Kun immoo rakkina ati ijoollummaa keetii jalqabdee hamma ammaatti keessa dabarte hunda caalaa hammaata.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.7",
            "verseOrgIds": [
              "2SA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi kaʼee karra dura taaʼe. Namoonni hundinuus yommuu, \"Mootichi karra dura taaʼee jira\" jedhamee itti himametti isa bira dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.8",
            "verseOrgIds": [
              "2SA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:8"
      },
      "items": [
        {
          "text": "Yeroo sanatti Israaʼeloonni hundi gara mana isaaniitti baqatanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.8",
            "verseOrgIds": [
              "2SA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daawit Yerusaalemitti Deebiʼe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guutummaa gosoota Israaʼel keessatti namoonni hundinuu akkana jedhanii wal falmaa turan; \"Mootichi harka diinota keenyaa jalaa nu baaseera; namni harka Filisxeemotaa jalaa nu baases isuma. Amma garuu inni sababii Abesaaloomiitiif biyyaa baqateera;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.9",
            "verseOrgIds": [
              "2SA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom inni nu akka inni bulchaa keenya taʼuuf jennee dibne sun immoo lola irratti duʼeera. Kanaafuu waaʼee mooticha as deebisuu irratti isin maaliif waan tokko hin mariʼanne?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.10",
            "verseOrgIds": [
              "2SA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit mootichis akkana jedhee ergaa kana Zaadoqii fi Abiyaataar lubootatti erge; \"Akkana jedhaatii maanguddoota Yihuudaa gaafadhaa; 'Wanni guutummaa Israaʼel keessatti odeeffamaa jiru gurra mootichaa qaqqabeeraatii isin maaliif mooticha mana mootummaa isaatti deebisuu irratti duubatti haftani?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.11",
            "verseOrgIds": [
              "2SA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin obboloota koo, foon kootii fi dhiiga koo ti; yoos mooticha fiduu irratti maaliif duubatti harkifattan ree?'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.12",
            "verseOrgIds": [
              "2SA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaasaanis, 'Ati foonii fi dhiiga koo mitii? Yoo ani ammaa jalqabee iddoo Yooʼaab ajajaa loltoota koo si gochuu baadhe, Waaqni waan hamaa natti haa fidu; waan caalu illee natti haa fidu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.13",
            "verseOrgIds": [
              "2SA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis akkuma garaa nama tokkootti garaa namoota Yihuudaa hundaa boojiʼe. Isaanis, \"Namoota kee hunda wajjin deebiʼi\" jedhanii mootichatti ergan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.14",
            "verseOrgIds": [
              "2SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis biyyatti deebiʼee hamma Yordaanositti dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.15",
            "verseOrgIds": [
              "2SA.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:15"
      },
      "items": [
        {
          "text": "Namoonni Yihuudaas mooticha simatanii Yordaanosin ceesisanii fiduuf hamma Gilgaalitti dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.15",
            "verseOrgIds": [
              "2SA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimeʼiin namichi Bahuuriim ilmi Geeraa kan gosa Beniyaam sunis mooticha simachuuf namoota Yihuudaa wajjin dafee gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.16",
            "verseOrgIds": [
              "2SA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isa wajjinis Beniyaamota kuma tokko akkasumas Ziibaa tajaajilaa maatii Saaʼol, ilmaan isaa kudha shananii fi hojjettoota isaa digdamatu ture. Isaanis mooticha dursanii Yordaanosin ceʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.17",
            "verseOrgIds": [
              "2SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis maatii mootichaa simachuu fi waan inni barbaadu isaaf gochuuf malkaa ceʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.18",
            "verseOrgIds": [
              "2SA.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:18"
      },
      "items": [
        {
          "text": "Shimeʼiin ilmi Geeraa yommuu Yordaanosin ceʼetti mooticha duratti kufee",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.18",
            "verseOrgIds": [
              "2SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkana isaan jedhe; \"Gooftaan koo balleessaa natti hin herregin. Balleessaa garbichi kee yeroo ati gooftaan koo mootichi Yerusaalemii baatetti hojjete garaatti hin qabatin. Mootichi waan sana yaada isaa keessaa haa baasu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.19",
            "verseOrgIds": [
              "2SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garbichi kee cubbuu hojjechuu koo beekaatii; harʼa garuu ani mana Yoosef hunda keessaa gooftaa koo mooticha simachuuf nama jalqabaa taʼee dhufeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.20",
            "verseOrgIds": [
              "2SA.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiishaayi ilmi Zeruuyaas, \"Shimeʼiin sababii nama",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.21",
            "verseOrgIds": [
              "2SA.19.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.19.21",
                "verseOrgIds": [
                  "2SA.19.22"
                ]
              }
            }
          ]
        },
        {
          "text": "dibe abaareef amma duʼuun isaaf hin maluu?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.21",
            "verseOrgIds": [
              "2SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit immoo deebisee, \"Yaa ilmaan Zeruuyaa anii fi isin maal wal irraa qabna? Isin yeroo ammaa diinota natti taataniirtu! Harʼa namni tokko iyyuu Israaʼel keessatti ajjeefamuu qabaa? Ani guyyaa harʼaa Israaʼel irratti mootii taʼuu koo hin beekuu?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.22",
            "verseOrgIds": [
              "2SA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi Shimeʼiidhaan, \"Ati duʼuu hin qabdu\" jedhe. Kanas kakaadhaan mirkaneesseef.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.23",
            "verseOrgIds": [
              "2SA.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiibooshet akaakayyuun Saaʼolis mooticha simachuuf gad buʼe. Inni gaafa mootichi Yerusaalemii baʼee jalqabee hamma mootichi deebiʼutti miilla isaatiif eegumsa barbaachisaa hin goone yookaan areeda hin haaddanne yookaan uffata isaa hin miiccanne ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.24",
            "verseOrgIds": [
              "2SA.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo inni mooticha simachuuf Yerusaalemii dhufettis mootichi, \"Mefiibooshet, ati maaliif na wajjin hin deemne?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.25",
            "verseOrgIds": [
              "2SA.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee deebise; \"Yaa gooftaa koo mooticha, ani garbichi kee waanan naafa taʼeef, 'Akka ani yaabbadhee mooticha faana deemuu dandaʼuuf harreen koo naaf haa feʼamu' jedheen ture. Ziibaan tajaajilaan koo garuu na gowwoomse.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.26",
            "verseOrgIds": [
              "2SA.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gooftaa koo mooticha durattis garbicha kee maqaa balleesseera; gooftaan koo mootichi akkuma ergamaa Waaqayyoo ti; kanaafuu waan barbaadde hunda godhi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.27",
            "verseOrgIds": [
              "2SA.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Silaa wanni maatiin abbaa kootii hundinuu mooticha irraa argachuu malan duʼa qofa ture. Ati garuu ana garbicha kee warra maaddii kee irraa nyaatan wajjin teessifte. Kana caalaa wanni ani akka naa godhamuuf mooticha gaafachuuf mirga qabu maalii?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.28",
            "verseOrgIds": [
              "2SA.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Maaliif dubbii dheeressita? Ani akka atii fi Ziibaan lafa hunda gargar qooddattan ajajeera\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.29",
            "verseOrgIds": [
              "2SA.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiibooshet immoo mootichaan, \"Amma erga gooftaan koo mootichi nagaan deebiʼee inni waan hunda haa fudhatu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.30",
            "verseOrgIds": [
              "2SA.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi gosa Giliʼaad kan Barzilaay jedhamu tokkos Rogeliimii gad buʼe; innis mooticha geggeessuuf isa wajjin Yordaanos ceʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.31",
            "verseOrgIds": [
              "2SA.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barzilaayiin jaarsa dulloomaa waggaa saddeettama ture. Innis waan nama sooressa tureef yeroo mootichi Mahanayiim jiraatetti waan inni nyaatu dhiʼeessaafii ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.32",
            "verseOrgIds": [
              "2SA.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Barzilaayiin, \"Gamatti na wajjin ceʼiitii na wajjin Yerusaalem jiraadhu; anis sin sooraa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.33",
            "verseOrgIds": [
              "2SA.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barzilaayiin garuu mootichaan akkana jedhe; \"Ani siʼachi waggaa hammam jiraachuufan mooticha wajjin Yerusaalem dhaqa?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.34",
            "verseOrgIds": [
              "2SA.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yeroo ammaa waggaa saddeettama guuteera. Ani waan gaarii fi waan hamaa addaan baasuu nan dandaʼaa? Garbichi kee miʼaa nyaataa fi dhugaatii beekaa? Ammas sagalee dhiirotaatii fi dubartoota sirbanii dhagaʼuu dandaʼaa? Yoos garbichi kee maaliif gooftaa koo mootichatti baʼaa dabalamaa taʼa ree?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.35",
            "verseOrgIds": [
              "2SA.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garbichi kee mooticha wajjin Yordaanos ceʼee xinnoo ishee ni deema; mootichi garuu maaliif haala kanaan galata naaf deebisa?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.36",
            "verseOrgIds": [
              "2SA.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani yoon duʼe magaaluma kootti awwaala abbaa fi haadha koo biratti awwaalamuuf garbicha kee dhiisi haa deebiʼu. Garbichi kee Kimhaam garuu kunoo ti. Inni gooftaa koo mooticha wajjin haa ceʼu. Atis waan jaallattu kam iyyuu isaaf godhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.37",
            "verseOrgIds": [
              "2SA.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Kimhaam na wajjin ni ceʼa; anis waan ati jaallattu kam iyyuu isaaf nan godha; waan ati narraa barbaaddu kam iyyuus siif nan godha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.38",
            "verseOrgIds": [
              "2SA.19.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin namoonni hundinuu Yordaanosin ceʼan; mootichis ni ceʼe. Mootichis Barzilaayii dhungatee eebbise; Barzilaayiinis gara mana isaatti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.39",
            "verseOrgIds": [
              "2SA.19.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2SA 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu mootichi gara Gilgaalitti darbetti Kimhaam isa wajjin deeme. Loltoonni Yihuudaa hundinuu fi walakkaan loltoota Israaʼel mooticha ceesisan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.40",
            "verseOrgIds": [
              "2SA.19.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2SA 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu suma namoonni Israaʼel hundinuu gara mootichaa dhufanii, \"Obboloonni keenya warri Yihuudaa maaliif nu dhoksanii mootichaa fi maatii isaa, duukaa buutota isa wajjin Yordaanosin ceesisanii fidani?\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.41",
            "verseOrgIds": [
              "2SA.19.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2SA 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yihuudaa hundis deebisanii namoota Israaʼeliin, \"Nu waan mootichi fira dhiigaa nuuf taʼeef waan kana goone. Isin waaʼee waan kanaa maaliif aartu? Nu waan mootichaa keessaa tokko illee nyaanneerraa? Waan tokko illees ofii keenyaaf fudhanneerraa?\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.42",
            "verseOrgIds": [
              "2SA.19.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2SA 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti namoonni Israaʼel namoota Yihuudaatiin, \"Nu mooticha irraa qooda harka kudhan qabna; kana malees nu isin caalaa Daawit irraa mirga qabna. Yoos isin maaliif akkas nu tuffattu ree? Akka mootiin keenya nuuf deebiʼuuf kan duraan dursinee gaafanne nu mitii?\" jedhanii deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:43"
      },
      "items": [
        {
          "text": "Garuu deebiin namoonni Yihuudaa deebisan kan Israaʼelootaa irra jabaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.44"
            ]
          }
        }
      ]
    }
  ],
