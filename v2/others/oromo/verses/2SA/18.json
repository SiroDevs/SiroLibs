  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abesaaloom Duʼuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit namoota isa wajjin turan lakkaaʼee ajajjuuwwan kumaatii fi ajajjuuwwan dhibbaa muudeef.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.1",
            "verseOrgIds": [
              "2SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis harka sadii keessaa harka tokko ajaja Yooʼaab jalatti, harka tokko ajaja Abiishaayi obboleessa Yooʼaab ilma Zeruuyaa jalatti, harka tokko immoo ajaja Itaayii namicha Gitii jalatti hiriirsee bobbaase. Mootichis loltootaan, \"Ani mataan koo dhugumaan isin wajjin nan baʼa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.2",
            "verseOrgIds": [
              "2SA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni garuu akkana jedhaniin; \"Ati deemuu hin qabdu; yoo nu baqachuuf dirqamne isaan waaʼee keenya dhimma hin qaban; yoo walakkaan keenyas dhumne isaaniif homaa miti; ati garuu nama akka keenyaa kuma kudhan caalta. Kanaafuu ati yoo magaalaa keessa turtee nu gargaarte wayya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.3",
            "verseOrgIds": [
              "2SA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Ani waan gaarii isinitti fakkaate kam iyyuu nan godha\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:4"
      },
      "items": [
        {
          "text": "Kanaafuu mootichi yeroo loltoonni hundi garee dhibbaatii fi garee kumaatiin qajeelanitti karra bira dhaabachaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Yooʼaab, Abiishaayii fi Itaayiin, \"Anaaf jedhaatii Abesaaloom dargaggeessichaaf garaa laafaa\" jedhee ajaje. Loltoonni hundinuus ajaja Daawit waaʼee Abesaaloom ajajjootaaf kenne dhagaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonnis Israaʼelin waraanuuf dirree waraanaatti baʼan; lollis bosona Efreem keessatti kaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.6",
            "verseOrgIds": [
              "2SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achittis loltoonni Israaʼel loltoota Daawitiin dhaʼaman; hubaatiin gaafasiis akka malee guddaa ture; namoota kuma digdamatu dhume.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.7",
            "verseOrgIds": [
              "2SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolli sunis guutummaa baadiyyaatti babalʼate; namoota goraadeen fixe caalaa kan bosonni liqimsee hambisetu baayʼata.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom yeroo kanatti akka tasaa namoota Daawititti dhufe. Innis gaangoo isaa yaabbatee deemaa ture; utuma gaangoon isaa dameelee gobbuu qilxuu guddaa tokkoo jala darbaa jirtuu mataan Abesaaloom muka keessatti qabame. Innis qilleensa irratti rarraʼee hafe; gaangoon inni yaabbatee ture sun garuu deemsa ishee ittuma fufte.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.9",
            "verseOrgIds": [
              "2SA.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi tokko yommuu waan kana argetti, \"Ani akka Abesaaloom muka qilxuutti rarraʼee jiru ammuma argeera\" jedhee Yooʼaabitti hime.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.10",
            "verseOrgIds": [
              "2SA.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaabis namicha waan kana isatti himeen, \"Maal jetta! Ati isa argiteertaa? Maaliif achumatti rukuttee lafaan isa dhaʼuu dhiifte? Silaa ani meetii saqilii kudhanii fi sabbata jagnummaa sin badhaasa turee\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.11",
            "verseOrgIds": [
              "2SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi sun garuu, akkana jedhee deebise; \"Utuu saqiliin kuma tokko harka kootti naaf safaramee iyyuu ani ilma mootiitti harka koo ol hin fudhadhu. Mootichi utuu nu dhageenyuu siʼi, Abiishaayii fi Itaayiin, 'Anaaf jedhaatii Abesaaloom dargaggeessicha eegaa' jedhee ajajeera.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.12",
            "verseOrgIds": [
              "2SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa biraa immoo utuu ani kutadhee lubbuu isaa balleessee, sababii wanti mooticha duraa dhokatu tokko iyyuu hin jirreef ati mataan kee iyyuu natti hin dhiʼaattu ture.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.13",
            "verseOrgIds": [
              "2SA.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaabis, \"Kana booddee ani haala kanaan si wajjin yeroo balleessuu hin qabu\" jedhe. Kanaafuu ankaasee sadii harkatti qabatee utuma Abesaaloom muka qilxuutti rarraʼee lubbuun jiruu garaa isaatti dire.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.14",
            "verseOrgIds": [
              "2SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Yooʼaabiif miʼa lolaa baatan kurnanis itti naannaʼanii Abesaaloomin dhaʼanii ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Yooʼaab malakata afuufe; loltoonnis sababii inni isaan dhowweef Israaʼelin ariʼuu ni dhiisan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
            "verseOrgIds": [
              "2SA.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis reeffa Abesaaloom fuudhanii bosona keessatti boolla guddaa tokkotti darbatanii dhagaa gurguddaa isa irra tuulan. Yeroo kanatti Israaʼeloonni hundi gara mana isaaniitti baqatan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom yeroo lubbuun turetti, \"Ani ilma maqaa koo waamsisu hin qabu\" jedhee iddoo Sulula Mootii jedhamutti yaadannoo ofiitiif soodduu dhaabbate. Soodduu sanas maqaa ofii isaatiin moggaase. Hamma harʼaatti illee soodduun sun Soodduu Abesaaloom jedhamee waamama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gadda Daawit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiimaʼaz ilmi Zaadoq, \"Ani dhaqee akka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.19",
                "verseOrgIds": [
                  "2SA.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "harka diinota isaa jalaa isa baase mootichatti nan hima\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaab immoo, \"Namni harʼa dhaqee himu siʼii miti; sababii ilmi mootichaa duʼeef ati yeroo biraa dhaqxee itti himta; garuu harʼa waan kana gochuu hin qabdu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.20",
            "verseOrgIds": [
              "2SA.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Yooʼaab Kuushiidhaan, \"Dhaqiitii waan argite mootichatti himi\" jedhe. Kuushiinis fuula Yooʼaab duratti gad jedhee harka fuudhee fiigaa qajeele.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.21",
            "verseOrgIds": [
              "2SA.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiimaʼaz ilmi Zaadoq ammas Yooʼaabiin, \"Wanni fedhe haa dhufu; maaloo anis Kuushii faana nan fiiga\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:22"
      },
      "items": [
        {
          "text": "Yooʼaab garuu, \"Yaa ilma ko, ati maaliif dhaquu barbaadda? Ati oduu badhaasa siif kennisiisu tokko iyyuu hin qabdu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni immoo, \"Wanni fedhe haa dhufu; ani fiiguu nan barbaada\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:23"
      },
      "items": [
        {
          "text": "Kanaafuu Yooʼaab, \"Fiigi!\" jedheen. Ergasii Ahiimaʼaz karaa dirreetiin fiigee Kuushii bira darbe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoo Daawit karra alaatii fi kan keessaa gidduu taaʼee jiruu eegduun karaa dhaaba gubbaa manaatiin karaatti ol baʼe. Innis achi ilaalee nama kophaa isaa fiigu tokko arge.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.24",
            "verseOrgIds": [
              "2SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegduun sunis mooticha waamee waan kana itti hime.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:25"
      },
      "items": [
        {
          "text": "Mootichis, \"Inni yoo kophaa isaa taʼe, oduu gaarii fiduu qaba\" jedhe. Namichi sunis dhiʼaachaa dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis eegduun sun utuu namni biraa fiiguu argee eegduu karraa waamee, \"Kunoo namni biraa tokko kophaa isaa fiigaa jira!\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:26"
      },
      "items": [
        {
          "text": "Mootichis, \"Innis oduu gaarii fiduu qaba\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegduun sunis, \"Inni jalqabaa waan akka Ahiimaʼaz ilma Zaadoqitti fiigu natti fakkaata\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:27"
      },
      "items": [
        {
          "text": "Mootichi immoo, \"Inni nama gaarii dha; oduu gaarii fidee dhufa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiimaʼaz mooticha waamee, \"Wanni hundinuu gaarii dha\" jedhe; fuula mootichaa durattis addaan lafatti gombifamee, \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.28",
                "verseOrgIds": [
                  "2SA.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee galata haa argatu; inni warra gooftaa koo mootichatti harka isaanii ol fudhatan dabarsee kenneeraatii\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi immoo, \"Abesaaloom dargaggeessichi jalaa baʼeeraa?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:29"
      },
      "items": [
        {
          "text": "Ahiimaʼazis, \"Yeroo Yooʼaab garbicha mootichaatii fi ana garbicha kee erguuf kaʼetti raafama guddaatu ture. Garuu wanni sun maal akka taʼe ani hin beeku\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"As hiiqii dhaabadhu\" jedhe. Kanaafuu inni achi hiiqee dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Kuushiin dhufee, \"Gooftaa koo yaa mootii, oduu gammachiisaa dhagaʼi!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.31",
                "verseOrgIds": [
                  "2SA.18.31"
                ]
              }
            }
          ]
        },
        {
          "text": "harʼa warra sitti kaʼan hunda jalaa si baaseera\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Kuushiidhaan, \"Abesaaloom dargaggeessichi jalaa baʼeeraa?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:32"
      },
      "items": [
        {
          "text": "Kuushiinis, \"Diinonni gooftaa koo mootichaatii fi warri si miidhuuf sitti kaʼan hundi akkuma dargaggeessa sanaa haa taʼan\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi ni hollate. Kutaa manaa kan karra duraa gubbaattis ol baʼee booʼe. Yommuu ol baʼuttis, \"Yaa ilma koo Abesaaloom! Ilma ko, ilma koo Abesaaloom! Utuu qooda kee ani duʼee jiraadhee; yaa Abesaaloom ilma ko, yaa ilma ko!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.19.1"
            ]
          }
        }
      ]
    }
  ],
