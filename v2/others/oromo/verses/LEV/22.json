                "verseId": "LEV.22.32",
                "verseOrgIds": [
                  "LEV.22.32"
                ]
              }
            }
          ]
        },
        {
          "text": "kan isin qulqulleessu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
