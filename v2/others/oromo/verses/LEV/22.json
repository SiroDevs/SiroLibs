          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaa koo qulqullicha hin xureessinaa. Akka ani qulqulluu taʼe Israaʼeloonni haa beeksisan. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
