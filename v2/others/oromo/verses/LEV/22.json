                "verseId": "LEV.22.26",
                "verseOrgIds": [
                  "LEV.22.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dibichi yookaan hoolaan yookaan reʼeen yommuu dhalatutti hamma bultii torbaatti haadha isaa wajjin haa turu. Guyyaa saddeettaffaadhaa jalqabee immoo aarsaa ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.27",
                "verseOrgIds": [
                  "LEV.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffamu taʼee fudhatama ni argata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyuma tokkotti, saʼa yookaan hoolaa ilmoo isaa wajjin hin qalinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        }
      ]
