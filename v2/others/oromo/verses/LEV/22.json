                "verseId": "LEV.22.29",
                "verseOrgIds": [
                  "LEV.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessitanitti akka isiniif fudhatamuuf haala kanaan dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarsaan kunis gaafuma sana nyaatamuu qaba; waan tokko illee hin bulchinaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.22.30",
                "verseOrgIds": [
                  "LEV.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
