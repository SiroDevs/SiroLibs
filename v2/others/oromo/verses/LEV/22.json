          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaafa aarsaa galataa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
