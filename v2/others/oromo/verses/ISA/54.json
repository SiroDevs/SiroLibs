      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "yeroo muraasaaf fuula koo si dhokfadheen ture;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "garuu jaalala bara baraatiin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
