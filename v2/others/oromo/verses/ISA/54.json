      "attrs": {
        "style": "q2",
        "vid": "ISA 54:7"
      },
      "items": [
        {
          "text": "garuu gara laafina guddaadhaan deebisee sin fida.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
