      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "yeroo ani itti bishaan Nohi deebiʼee lafa irra hin garagalu jedhee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "kakadhe sanaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
