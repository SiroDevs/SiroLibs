          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani dheekkamsa guddaadhaan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
