      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "sanyiiwwan kee saboota ni dhaalu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "magaalaawwan isaanii kanneen duwwaa hafan keessas ni qubatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
