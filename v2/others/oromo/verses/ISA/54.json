      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "ijoolleen dubartii gatamtee ni baayʼatu\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
