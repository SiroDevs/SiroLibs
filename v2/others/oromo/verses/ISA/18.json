                "verseOrgIds": [
                  "ISA.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuuf kennaan ni fidama;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "kennaan sunis gara Tulluu Xiyoon, iddoo Maqaan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.18.7",
                "verseOrgIds": [
                  "ISA.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan hunda dandaʼu jiraatutti ni fidama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
