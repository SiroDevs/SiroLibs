      "attrs": {
        "style": "q1",
        "vid": "ISA 18:7"
      },
      "items": [
        {
          "text": "saba fagoo fi dhiʼoottis sodaatamu irraa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
    },
