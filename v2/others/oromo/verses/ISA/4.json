              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa dubartoonni torba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
