      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 4:1"
      },
      "items": [
        {
          "text": "Salphina keenya nurraa fageessi!\" jedhuun.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Damee",
