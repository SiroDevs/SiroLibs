              "attrs": {
                "verseId": "ISA.22.25",
                "verseOrgIds": [
                  "ISA.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu akkana jedha; \"Gaafas qofoon iddoo jabaa dhaabame sun ni buqqaʼa; muramee lafa buʼa; baʼaan isatti fannifame sun harcaʼee caccaba.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.25",
                "verseOrgIds": [
                  "ISA.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "waan kana dubbateeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        }
      ]
