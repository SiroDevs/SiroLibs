    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wuɔ̱c Wac-ti min la ciek kua̱r",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu mɛmɛ tuɔɔk ni̱ni ruëc Ä-ɣɛ̈c-we-roc. Kä jɛn Ä-ɣɛ̈c-we-roc cuɛ wi̱i̱ ti kuɔ̱r kɛl wi̱cdɛ jiɛn da̱ŋ rɛw wi̱cdɛ bärɔw ruac, a känɛ ni ro̱o̱l In-di-ya a räth ni ro̱o̱l Kuɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ni̱ni tɔ̱tɔ̱ mëë ci Kuäär ni Ä-ɣɛ̈c-we-roc ku nyuur wi̱c kɔam kuäärädɛ kä Cu-cɛ̈n däär wec in di̱i̱t, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "cuɛ mi̱th ti ŋuan lät kä ruëëckɛ kɛnɛ ji̱ kɔaarɛ kɛ diɔ̱ɔ̱k runi rui̱cädɛ. Kä te rɛm Pa-rath kɛnɛ Ma-day kɛ bööth kɛnɛ ruëëc wi̱i̱ni thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ria̱ŋ kuäärädɛ kɛnɛ wuɔ̱tdɛ nyoth kɛ ŋa̱a̱ri liakä kɛ ni̱n ti ŋuan ti cuɔpkɛ ni̱n ti kuɔ̱r kɛl wi̱cdɛ jiɛn bädäk (180).",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci ni̱n tɔ̱tɔ̱ thuɔ̱k, cu kuäär nɛy diaal, nɛy tin di̱t amäni nɛy tin tiɛtni tin te däär wec Cu-cɛ̈n in di̱i̱t moc kɛ mi̱eth mi cu thuɔ̱k kɛ ni̱n da̱ŋ bärɔw, rɛy kal kakä dhɔaar kua̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kal ca jɛ ja̱m ɛgɔaa, kɛ bieyni wernyinä ti bo̱o̱r kɛnɛ ti yiël, cakɛ yiɛn kɛ tia̱m biey mi di̱t kökdɛ. Kä ca kɛ gɔn kɛ tiil la̱ŋ ti ca yian wääthni ti ca go̱l kɛ pääm. Kä tëë kɛ kɔamni nyuurä ti ca la̱t kɛ da̱a̱p kɛnɛ ciɛk in bo̱r, kä ca kɔamni la̱th rɛy kal in ca pinydɛ rɔth kɛ pääm ti bo̱o̱r kɛnɛ ti nyäŋ, kɛ ti yiël kɛnɛ ti luaal, amäni guiy ti yiël ti di̱t kökdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu naath maath kɛ lieeri ti ca la̱t kɛ da̱a̱p. Kä ca kɛn lieri tɔ̱tɔ̱ la̱t kɛ lätni ti gööl. Kä cu kuäär naath ro̱ŋ kɛ kɔaŋdɛ, kɛ ɣöö kuäär riäŋɛ ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ thil ram mi cua pen math kɔŋä, kɛ ɣöö ci kuäär ruac thöp la̱a̱tkɛ diaal kɛ ɣöö ba ja̱l ɔ moc kɛ kɔaŋ ce̱tnikɛ min go̱o̱rɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ pek in dɔ̱ŋ, cu Ciëk Kua̱r ni Wac-ti mi̱th la̱t bä, kɛ kui̱ mään tin te dhɔr Kua̱r ni Ä-ɣɛ̈c-we-roc.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ bärɔw ni̱ni, mëë ci kuäär lɔcdɛ ku tɛɛth kɛ kɔaŋ ëë cɛ math, cuɛ Mɛ-ɣu-man kɛnɛ Bidh-ta kɛ Ɣar-bo-na kɛnɛ Big-thɔ kɛ Ä-bag-thɔ kɛ Dhe-thar kɛnɛ Kar-kɛ̈th, jiöwni da̱ŋ bärɔw tin la la̱tkɛ jɛ ikä la̱r ruac, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö bikɛ ciek kua̱r ni Wac-ti nööŋ nhiam kua̱r. Kä a jɛ läth kum kuäärä wi̱i̱dɛ, kɛ ɣöö bɛ ja̱a̱l kɛnɛ ruëëc ben nyuɔ̱th gɔɔydɛ, kɛ kui̱ kä ɣöö tëë kɛ maan pua̱a̱ny mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö, cu Ciëk Kua̱r ni Wac-ti ruac kua̱r in ca wä la̱r jɛ ɛ jiöwni lo̱k. Kɛ jɛn mɛmɛ cu kuäär gaak, cuɛ lɔcdɛ waŋ ɛlɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔrɛ cu kuäär nɛy tin la luëkɛ jɛ thiec kɛ min derɛ la̱t, kɛ ɣöö ŋa̱c kɛ ŋuɔ̱t. Kä ɛ jɛn duɔ̱ɔ̱p in la kuäär ɛ a lät ni lätkɛ, kɛ kui̱ nɛɛni diaal tin ŋa̱c kɛ ŋuɔ̱t kɛnɛ ciɛŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛy tëë thieek kɛ jɛ ɛ Kar-cɛ-nɔ kɛnɛ Ce-thar kɛ Ad-ma-thɔ kɛnɛ Tar-cic kɛ Mɛ-rɛth kɛnɛ Mar-thɛ-na kɛ Mɛ-mu-kan. Kɛn da̱ŋ bärɔw kɛ ruëëc Pa-rath kɛnɛ Ma-day. Kä Kuäär ni Ä-ɣɛ̈c-we-roc cɛ kɛ ka̱m gua̱th tin di̱t nikɛn kuäärädɛ. Kä cuɛ kɛ thiëc wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ ciaaŋ ŋuɔ̱tni, ɛŋu mi dëë lät kä Ciëk Kua̱r ni Wac-ti, kɛ ɣöö /ken ɛ ruacdä mëë la̱t kɛ jɛ ɛ jiöwni la̱t?” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ, cu Mɛ-mu-kan riet nhiam kua̱r kɛnɛ ruëëc wëë i̱, “/Ken Ciëk Kua̱r ni Wac-ti mi jiääk lät kä kuäär kä rɔa, cɛ jɛ lät kä ruëëc kɛnɛ ji̱ wi̱i̱ni Kuäär ni Ä-ɣɛ̈c-we-roc diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mɛmɛ ci Ciëk Kua̱r ni Wac-ti ɛ la̱t ɛ ba jɛ ŋa̱c ɛ män diaal, kä bɛ män jakä guɛckɛ cɔwkiɛn ni cäänyä kä bikɛ riet i̱, ‘Cu Kuäär ni Ä-ɣɛ̈c-we-roc Ciëk Kua̱r ni Wac-ti cɔl kɛ ɣöö dëë jɛ nöŋ nhiamdɛ, kä /ken ɛ ben nhɔk.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ɛn wa̱lɛ mi, bi män ruëëcni röli Pa-rath kɛnɛ Ma-day tin ca ciɛŋ ciëk kua̱r liŋ ruac ruëëcni kua̱r lo̱k, kä bi jiääk ciɛŋä gaak cu duth thi̱n inɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi dee kuäär ɛ nhɔk, a jɛ lat ruac, mi ba gɔ̱a̱r piny rɛy ŋuɔ̱tni Pa-rath kɛnɛ Ma-day, kä a jɛ /ca bi luäŋ kɛ wa̱ny, ɛn ɣöö ɛ Wac-ti /ci nhiam Kuäär ni Ä-ɣɛ̈c-we-roc lɛ nyɔk kɛ nën. Kä ɛ kuäär käm gua̱a̱thdɛ ciek mi dɔ̱ŋ mi leny jɛ kɛ gɔɔy. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, mi wä kuäär ruac lat kuäärädɛ ni kɛɛliw gua̱thni ti gööl, bi män diaal cɔwkiɛn luɔ̱th, a cäŋɛ wut mi riäŋ kiɛ wut mi can.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu luek ɛmɛ gɔaa lɔc kua̱r kɛnɛ ruëëc. Kä cu kuäär ɛ la̱t ce̱tnikɛ min ci Mɛ-mu-kan ɛ lar. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.21",
            "verseOrgIds": [
              "EST.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ warɛgakni jäkä wi̱i̱nikɛ diaal, wec ɔ kɛ gɔ̱a̱r in gɔ̱r kɛ jɛ, kɛ do̱rɔ nikɛ thok in la ruac kɛ kɛ. Kä cuɛ jɛ lat ɛn ɣöö bi dhil di̱t ni wut dhɔrɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.22",
            "verseOrgIds": [
