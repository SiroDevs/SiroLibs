              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.32",
            "verseOrgIds": [
              "JDG.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Gi-don li̱w, cu ji̱ I-thɛ-rɛl rɔ ri̱t, palkɛ ni kuoth Baal, cukɛ kuoth Baal-bɛ-rith pal ala kuothdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.33",
            "verseOrgIds": [
              "JDG.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ken ji̱ I-thɛ-rɛl Kuoth Nhial Kuothdiɛn tim, mëë kään kɛ tetni ji̱ tɛ̈riɛn kui̱ni diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.34",
            "verseOrgIds": [
              "JDG.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ka̱n mi gɔaa nyuɔ̱th ji̱ dhɔaar Gi-don kɛ mëë gɔaa ëë cɛ lät kä ji̱ I-thɛ-rɛl.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.35",
            "verseOrgIds": [
              "JDG.8.35"
            ]
          }
        }
      ]
