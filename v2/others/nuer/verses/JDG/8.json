          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.27",
            "verseOrgIds": [
              "JDG.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cua ji̱ Mid-yan cu puɔ̱t ɛ ji̱ I-thɛ-rɛl, ka̱n wuɔ̱thkiɛn lɛ nyɔk kɛ kap nhial. Cu piny tekɛ mal kɛ run ti jiɛn ŋuaan tetdä Gi-don.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lia̱a̱ Gi-don",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Gi-don gat Yo-ac wä ciɛŋ ni dhɔrɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.29",
            "verseOrgIds": [
              "JDG.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ te Gi-don kɛ gaat ti jiɛn bärɔw, gaatkɛ pa̱ny, kɛ ɣöö tëë kɛ män ti ŋuan. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.30",
            "verseOrgIds": [
              "JDG.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu luɔmdɛ min cieŋ kä Cɛ-kɛm jɛ da̱p gat mi dho̱o̱l, kä cuɛ ciötdɛ cɔli Ä-bi-mɛ-lɛk. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.31",
            "verseOrgIds": [
              "JDG.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Gi-don gat Yo-ac li̱w kɛ run ti ci lɔcdɛ ro̱ŋ, kä cua jɛ kony kɔ̱k gua̱n ni Yo-ac, kä Ɔp-ra muun ji̱ Ä-bi-ɛ-dhɛr.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.32",
            "verseOrgIds": [
              "JDG.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
