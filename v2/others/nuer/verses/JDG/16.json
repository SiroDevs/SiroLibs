            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu kua̱r ji̱ Pi-li-thɛt duɔl kɛ ɣöö bikɛ ŋar kä ba muc thöp Da-gon kuothdiɛn. Kɛnɛ ɣöö cikɛ jɛ lar i̱, “Ci kuothda kɔ ka̱m gua̱n tɛ̈ra ni Cim-con.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci naath Cim-con nɛn, cukɛ kuothdiɛn liak. Kä lar kɛnɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cikɛ ku yɔ̱ŋ, cukɛ wee, “Cɔalɛ Cim-con, bɛ nɛy ben ŋa̱r ŋar.” Ɛ jɛn cua Cim-con ciöl raar rɛy duëël yieenä, kä cuɛ ŋar nhiamdiɛn. Kä cukɛ jɛ jak kä cuŋɛ kam thieeri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Cim-con dho̱o̱l in käp tetdɛ jiök i̱, “Jak ni ɣä kä göörä thieer tin rɔamkɛ ti̱c nhial, kɛ ɣöö dëë rɔ cak kɛ kɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.26",
            "verseOrgIds": [
              "JDG.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duel cɛ thia̱a̱ŋ kɛ wutni kɛnɛ män. Kä te kua̱r ji̱ Pi-li-thɛt da̱ŋ dhieec diaal thi̱n. Kä nhial wi̱i̱ duëël te wutni kɛnɛ män ti bathdɔɔri diɔ̱k thi̱n, ti guic min ŋar Cim-con.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Cim-con Kuoth Nhial pal wee i̱, “Aɣ Kuäär ni Kuoth, la̱ŋä ni ji̱ ti̱mä ɣä, kä bumä, kua̱ läŋ ni ji̱ kɛ kɛl ɛ mi lö Kuoth. Kɛ ɣöö dëë rɔ col kä kɛɛl kä ji̱ Pi-li-thɛt kɛ kui̱ nyiinkɛ da̱ŋ rɛw.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.28",
            "verseOrgIds": [
              "JDG.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Cim-con thieer da̱a̱r da̱ŋ rɛw tin cuŋ duel kɛ kɛ jek, kä cuɛ tet cuëëcdɛ la̱th kä kɛl, kä cuɛ tet caamdɛ la̱th kä min dɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.29",
            "verseOrgIds": [
              "JDG.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wee, “A kua̱ li̱w kɛɛl kɛ ji̱ Pi-li-thɛt.” Ɛ jɛn kɛ buɔ̱mdɛ kɛɛliw cuɛ thieer wuk. Kä cu duel pɛn wi̱i̱ kua̱ri kɛn nɛy diaal tëë te rɛydɛ. Kä nɛy tin ci li̱w kɛ lia̱a̱dɛ, cu ŋuan ni kɛn kä tëë cɛ näk mëë tëkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gaat man Cim-con kɛnɛ ji̱ dhɔaariɛn diaal ri̱ŋdɛ ben naŋ, kä cua jɛ wä kony kam Dhɔra kɛnɛ Ɛc-tool kɔ̱kä kunyä gua̱n ni Ma-no-aa, cuɛ I-thɛ-rɛl ruac kɛ run ti jiɛn rɛw.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
    }
