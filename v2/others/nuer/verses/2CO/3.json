        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "La̱a̱t matdä ruac in pay tuɔɔk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A banɛ jɛ tok kɛ mi liaknɛ rɔ̱? Kiɛ dëëkɔ warɛgakni ti nyuɔ̱thkɔ rɔ̱ yɛ kiɛ kä yɛ, ce̱tkɛ tha̱a̱ŋ nɛɛni tin kɔ̱kiɛn? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.1",
            "verseOrgIds": [
              "2CO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yɛn lapɛ warɛgaknikɔ tin ca gɔ̱r rɛy lo̱cnikɔn, min ba ŋa̱c kä dëë kuɛn ɛ nɛy diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.2",
            "verseOrgIds": [
              "2CO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nyooth yɛn ɛ ɛn ɣöö lapɛ warɛgak mi ca gɔ̱r ɛ Kritho min ca̱kɔ ja̱k, mi /ka̱n gɔ̱r kɛ wäl gɔ̱rä, duundɛ ɣöö gɔ̱a̱rkɛ jɛ kɛ Yiëë Kuɔth in tëk. Kä /ka̱n jɛ gɔ̱a̱r päämni ti pat paat, duundɛ ɣöö ca jɛ gɔ̱a̱r rɛy lo̱cni nath.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɛmɛ ɛ jɛn min cakɔ jek kɛ ŋa̱th kɛ lɔcda rɛy Kritho kɛ kui̱ Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.4",
            "verseOrgIds": [
              "2CO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ciɛ ɣöö röŋkɔ kɔn kärɔ̱, ɛn ɣöö tëëkɛ lua̱ŋ mi dëë kɔ lät ni duɔ̱ɔ̱r, lua̱ŋda bëë kä Kuoth, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "min ci kɔ jakä ro̱ŋ kɛ ɣöö bakɔ a la̱a̱t matdä ruac in pay tuɔɔk, mi /ci mɔ a ŋuɔ̱t mi ca gɔ̱r duundɛ ɣöö ɛ yiëë. Kɛ ɣöö ŋuɔ̱t tin ca gɔ̱r näkɛ, kä Yiëë ŋunɛ tëk.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ca ŋut in no̱o̱ŋ lia̱a̱ gɔ̱r, kɛ rieet wi̱i̱ pa̱a̱m. Cukɛ ben kɛ buay Kuɔth, a /ci ji̱ I-thɛ-rɛl nhiam Muthɛ dee di̱el guec, kɛ ɣöö riaw buaydɛ wäŋkiɛn. Kä cu buay ɛmɔ te thi̱n kärɔa kɛ gua̱a̱th mi tɔt. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k la̱t Yieekä bi te ni jɛn kɛ buay mi di̱i̱t kä jɛn buay ɛmɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.8",
            "verseOrgIds": [
              "2CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi te la̱t in no̱o̱ŋ da̱k kɛ buay, kä bi la̱t in no̱o̱ŋ ka̱n buaydɛ di̱tdɛ kulɛ ni̱n ɛ di! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.9",
            "verseOrgIds": [
              "2CO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k mëë ci kɔŋ tekɛ buay mëëdan, cuɛ cu thil buay, kɛ kui̱ kä ɣöö ci buay mi di̱t ni jɛn ben. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.10",
            "verseOrgIds": [
              "2CO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ci mi wäkɛ thuɔ̱k te kɛ buay, bi min te thi̱n a thil pek jɛ leny kɛ buay.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö te kɔn kɛ ŋa̱th inɔ kɛ min bi ben, ta̱nɛ kɛ buɔ̱m lɔaac mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.12",
            "verseOrgIds": [
              "2CO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Canɛ ce̱tkɛ Muthɛ mi ci nhiamdɛ kum kɛ bi̱i̱, kɛ ɣöö /ci ji̱ I-thɛ-rɛl buay nhiamdɛ min wäkɛ thuɔ̱k bi nɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.13",
            "verseOrgIds": [
              "2CO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ca̱riɛn kɛ thuɔ̱k bumɛ, kɛ ɣöö amäni wa̱lɛ, mi liŋ kɛn ma̱t ruac ëë wal a kuɛnkɛ, ŋot bi̱i̱ ɛmɔ thi̱n, kɛ ɣöö /ca jɛ woc ɛ ni mi ci raan rɔ riet Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.14",
            "verseOrgIds": [
              "2CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣɔ̱ɔ̱n, amäni wa̱lɛ mi kuɛ̈nkɛ ruaacni Muthɛ kuɔ̱mkɛ ca̱riɛn ɛ bi̱i̱. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.15",
            "verseOrgIds": [
              "2CO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ci raan rɔɔdɛ riet Kuäär ni Yecu, la bi̱i̱ ɛmɔ a wuɔckɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.16",
            "verseOrgIds": [
              "2CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ, Kuäär ni Yecu ɛ jɛn Yiëë, kä gua̱a̱thɔ jëkɛ Yiëë Kua̱r ni Yecu thi̱n ɔ ɛ jɛn gua̱a̱th in te lɔar thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.17",
            "verseOrgIds": [
              "2CO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɔn diaal, nyuɔthnɛ buay Kua̱r ni Yecu kɛ nhiamdan mi thil bi̱i̱. Kä jɛn buay ɛmɔ, bëë kä Kuäär min la Yiëë, cɛ kɔn loc ce̱tkɛ jɛ cɛ buay mi di̱i̱t mi thil pek nööŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.18",
            "verseOrgIds": [
              "2CO.3.18"
            ]
          }
        }
      ]
    }
  ],
