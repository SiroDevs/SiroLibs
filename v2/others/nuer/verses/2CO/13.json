        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lui̱k tin jɔak kɛnɛ neri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɛmɛ ɛ jɛn diɔ̱ɔ̱k benädä kä yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:1",
              "type": "text"
            },
            {
              "text": "Ŋuɔ̱t 19:15.",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi tëëkɛ go̱o̱ny bɛ dhil tekɛ nëën da̱ŋ rɛw kiɛ diɔ̱k.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cä nɛy diaal tëë ci duer mëëdan luek, kɛnɛ nɛy diaal tin kɔ̱kiɛn, kä luëëkä kɛ täämɛ min ta̱a̱ jɔ̱ɔ̱r, ce̱tkɛ mëë cä lat kɛ guelä mëë rɛwdɛ, ɛn ɣöö mi wa̱a̱ rɔ nyɔk kɛ ben, /cä kɛ bi päl. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.2",
            "verseOrgIds": [
              "2CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö go̱o̱r yɛn nyuuth, kɛ ɣöö ruac Kritho kɛ ɣä. Jɛn /cɛ kɔ̱c mi lätdɛ kɛ yɛ, kä duundɛ ɣöö bumɛ rɛydun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.3",
            "verseOrgIds": [
              "2CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ca jɛ pua̱t jiaath rɛy kɔ̱cä, kä duundɛ ɣöö cɛ tëk kɛ buɔ̱m Kuɔth. Kä ɛ thuɔ̱k kɔ̱ckɔn rɛydɛ, kä min la̱tkɔ kɛ yɛ, banɛ tëk kɛ jɛ kɛɛl kɛ buɔ̱m Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thɛ̈mɛ rɔ̱, kɛ ɣöö bia jɛ nɛn mi tëk yɛn rɛy ŋäthä. Ɣɔ̱a̱nɛ rɔ̱. A /ken yɛn ɛ ŋa̱c ɛn ɣöö te Yecu Kritho rɛydun? Kä ɛni mi cia thöl guäth ɣɔ̱nä! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.5",
            "verseOrgIds": [
              "2CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋa̱a̱thä jɛ ɛn ɣöö bia jɛ jek ɛn ɣöö /ka̱nkɔ thöl. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.6",
            "verseOrgIds": [
              "2CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɔn palkɔ Kuoth ɛn ɣöö thilɛ duer mi bia la̱t. Kä /ci bi jɔɔc bä ɛn ɣöö cakɔ ɣɔ̱ɔ̱n luäŋ, kä ɛ ɣöö dërɛ la̱t ni cuɔ̱ɔ̱ŋ, a cäŋ bɛ ce̱tkɛ mi cakɛ thöl. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.7",
            "verseOrgIds": [
              "2CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ mi dëëkɔ la̱t mi gua̱c kɛ thuɔ̱k, bakɔ la̱t ni thuɔ̱k kärɔa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.8",
            "verseOrgIds": [
              "2CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö tɛth lo̱ckɔ min kɔ̱a̱ckɔ kä buɔ̱mɛ. Nɔmɔ ɛ jɛn min pal kɛ kɔ ɛn ɣöö bia thil diw. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.9",
            "verseOrgIds": [
              "2CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ gɔ̱a̱rä yɛ ti̱ti̱ min ŋuɔtdä na̱nä kɛ yɛ, kɛ ɣöö mi wa̱a̱ wä ben, /cä bi lɛ lät a bɛc kɛ läätdä kɛ buɔ̱m in ci Kuäär ɛ ka̱m ɣä kɛ kui̱ kapädun nhial, a /ciɛ kɛ kui̱ da̱kdun.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.10",
            "verseOrgIds": [
              "2CO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.10",
            "verseOrgIds": [
              "2CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ jɔakdɛ, gaatmaari, kua duɔth kɛ mal. Jakɛ ciɛŋkun kä gɔw, kä liɛŋɛ ruacdä, a ruacdun la kɛl, ciëŋɛ kɛ mal, kä bi Kuoth nho̱kä kɛnɛ mal te kɛɛl kɛ yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nërɛ rɔ̱ kɛ ci̱em nho̱kä mi rɛl rɔ. Nɛy diaal tin ci Kuoth kɛ lɛy nërkɛ yɛ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A puɔ̱th Kua̱r ni Yecu Kritho, kɛnɛ nhök Kuɔth, kɛ mat Yieekä in Gɔaa in Rɛl Rɔ tekɛ yɛn diaal.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        }
      ]
    }
  ],
