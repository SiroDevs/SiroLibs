          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Thɔɔl ɛ ŋa̱c ɛn ɣöö Kuoth Nhial te kɛɛl kɛ Dee-bid, kä nhɔakɛ jɛ ɛ nyadɛ ni Mi-kal, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
