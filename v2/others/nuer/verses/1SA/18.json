          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Thɔɔl ŋot kɛ dual kɛ Dee-bid. Kä cua gua̱n tɛ̈rɛ ni ciaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
