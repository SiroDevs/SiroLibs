          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min wäkɛ raar piny wec, cu Tha-muɛl ruac kɛ Thɔɔl i̱, “Jiök ni läätdu a jɛ wä nhiamdan, mi cɛ wä nhiam ku cuɔ̱ŋ puɔ̱nydu kä mi tɔt, kɛ ɣöö bä ji̱ la̱t ruac Kuɔth.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.27",
            "verseOrgIds": [
              "1SA.9.27"
            ]
          }
        }
      ]
