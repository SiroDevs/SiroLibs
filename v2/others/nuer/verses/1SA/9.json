          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu Thɔɔl mi̱th kɛɛl kɛ Tha-muɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min cikɛ ben piny guäth palä wäkɛ wi̱c. Cukɛ wä ruac wi̱i̱ duëël nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakä ɣɔaa cu Tha-muɛl Thɔɔl cɔl wi̱i̱ duëël nhial i̱, “Riali rɔ ikä kɛ ɣöö bä ji̱ ben jak kä wä dupdu.” Kä cu Thɔɔl rɔ jiɛc, kä cu kɛn da̱ŋ rɛw wä raar dup.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yier Tha-muɛl kɛ Thɔɔl ala kuäär",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
