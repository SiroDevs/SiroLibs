    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋi̱eec ka̱a̱cni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu göök ka̱a̱cni rɔ jiɛc bä rɛy nath, ce̱tkɛ min bɛ tekɛ ŋi̱eec ka̱a̱cni rɛydun. Kɛn bikɛ ŋi̱i̱c mi kac mi bi naath bath ŋi̱eec. Kä bikɛ Ŋi̱i̱c in di̱i̱t, in ci kɛ luɛl jay, inɔ kɛn bikɛ rɔ̱ nöŋ da̱k kɛ pɛ̈th. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.1",
            "verseOrgIds": [
              "2PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cäŋɛ jɛn inɔ bi nɛy ti ŋuan dup nyuɔɔnikiɛn guɔ̱ɔ̱r, kä kɛ kui̱diɛn ba duɔ̱ɔ̱p thukä lat jɔ̱ɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.2",
            "verseOrgIds": [
              "2PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛn ŋi̱eec ka̱a̱cni ti̱ti̱ kɛ di̱t lɔaacdiɛn ba nyinkun pɛl kɛ ruaacni ka̱a̱cni. Kä luk ëë ca lar kɛ kui̱diɛn ni wal /ka̱n jɛ päl, kä /ken dääkdiɛn niɛɛn.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ken Kuoth ja̱a̱k nhial tëë ci duer pälikä. Cuɛ kɛ yuɔr guäth maac mi thil pek, kä cuɛ kɛ jakä wä kɔ̱a̱kni ti cuɔl cuɔɔl, kɛ ɣöö ba kɛ gaŋ thi̱n amäni caŋ luɔ̱k ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.4",
            "verseOrgIds": [
              "2PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ken Kuoth ɣɔw ëë wal päl, kä cuɛ Nowa mëë lat ruac kɛ kui̱ ciɛŋä cuŋni kän kɛnɛ nɛy da̱ŋ bärɔw kɔ̱kiɛn, mëë cɛ nyɔc nööŋ rɛy nɛɛni ti thil Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.5",
            "verseOrgIds": [
              "2PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Kuoth rɛk Thɔ-dɔm kɛnɛ Go-mo-ra waŋ a bikɛ a ŋɛ̈th. Kä cuɛ kɛ jakä nyuuth kɛ kui̱ kä min bi tuɔɔk kä ji̱ jiäkni ti thil Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.6",
            "verseOrgIds": [
              "2PE.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ Lɔt in la gua̱n cuŋni kän, mëë ca lɔcdɛ jakä jiɛth kɛ ciaŋ leerä nɛɛni ti jiäk, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.7",
            "verseOrgIds": [
              "2PE.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu wut ɛ gua̱n cuŋni nɔmɔ cieŋ rɛydiɛn, kɛ cäŋ kɛ cäŋ cu lɔcdɛ jiath kɛ kui̱ lätni tin jiäk tin cɛ nɛn kä cɛ liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.8",
            "verseOrgIds": [
              "2PE.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ ŋäc Kuoth ɛ ɛn ɣöö bɛ ji̱ cuŋni kän rɛy ɣɔ̱ɔ̱nikiɛn, kä bɛ nɛy tin thil Kuoth duäc amäni cäŋ luɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.9",
            "verseOrgIds": [
              "2PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ di̱t kä nɛy tin guɔ̱ɔ̱rkɛ ni tin go̱o̱r pua̱nykiɛn kɛ kɛnɛ nɛy tin lo̱k luth Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ŋi̱eec kacä ti̱ti̱ kɛn bumkɛ kä ruackɛ ni nyiäthä. /Cikɛ dual kɛ ɣöö bikɛ ja̱a̱k nhial ti gɔw lat jɔ̱ɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cäŋ ni min di̱t ni buɔ̱m ja̱a̱kni kɛnɛ lua̱ŋdiɛn kä kɛn ŋi̱eec kacä ti̱ti̱, /ken ja̱a̱k nhial kɛ gɔany kɛ kui̱ kuethni tɔ̱tɔ̱ nhiam Kua̱r ni Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.11",
            "verseOrgIds": [
              "2PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö kɛn nɛy ti̱ti̱ la kɛn mi kui̱c kɛn ɛ a kueth. Kɛn ce̱t kɛn kɛ ley tin thil ca̱r rɛy lätnikiɛn, dapkɛ kɛ kɛ ɣöö bakɛ käp kä bakɛ näk. Mi wa ley ɛ tɔ̱ wä däk bakɛ däk bä. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.12",
            "verseOrgIds": [
              "2PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn bakɛ cuɔ̱l cuɔ̱c mi ce̱tkɛ cuɔ̱c ëë ci kɛn ɛ lät kä naath. Kä ca̱riɛn kɛ kui̱ tɛthä lɔaac ɛ ɣöö bikɛ yɔ̱ŋ kɛ cäŋ däär kɛɛliw. Kɛn kɛ pia̱ri kɛnɛ mɛ̈ɛ̈nyni, kɛn ŋarkɛ kɛ tɛ̈th lɔaac guäth in mi̱thkɛ kɛɛl kɛ yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.13",
            "verseOrgIds": [
              "2PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ wäŋ ti ci thia̱a̱ŋ kɛ dhöm, /ka̱n lätni dueeri ka̱p cuɔ̱ŋ. La buathkɛ nɛy tin kɔ̱c dui̱rä. Tekɛ kɛ lo̱c ti ca ŋi̱eec kɛ da̱r. Kɛ gaat ti ca bit! ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.14",
            "verseOrgIds": [
              "2PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ca duɔ̱ɔ̱p in cuŋ ba̱ny piny, cu bath ni kɛn, cukɛ guɔ̱ɔ̱r ni ciaŋ Bil-am gat Bɛ-or, min nhɔk ni kök kɛ kui̱ lätni ti jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.15",
            "verseOrgIds": [
              "2PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua jɛ luek kɛ duerɛ. Cu muul mi /cia ruac, ruac kɛ jɛ kɛ jɔw ran, kä cuɛ yɔ̱ŋ go̱kä nɔmɔ ka̱p cuɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱t nɛy ti̱ti̱ kɛ jieer ti thil pi̱ kɛnɛ pua̱a̱r ti lɔk thulkɛ. Ca gua̱a̱th mi col rialikä kɛ kui̱diɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.17",
            "verseOrgIds": [
              "2PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn liakɛ rɔ̱ kɛ rieet ti thil luɔt, kɛ gör kä tin go̱o̱r puɔ̱nykɛ. Kɛn pɛlkɛ nɛy tin pay rɔ̱ bar kä nɛy tin guɔ̱ɔ̱rkɛ dup ti jek. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.18",
            "verseOrgIds": [
              "2PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä lät kɛn kɛ ɣöö bakɛ jakä lɔr, kä duundɛ ɣöö kɛn pua̱nykiɛn kɛ kuaany nyuɔɔni. Kä naath kɛ kuaany kä mɔ cikɛ tiam ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.19",
            "verseOrgIds": [
              "2PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi cikɛ rɔ̱ bar kä jiäk ɣɔaa ɛmɛ kɛ ŋäcdiɛn kɛ Kuääran kä Käändan ni Yecu Kritho, kä mi cakɛ nyɔk kɛ käp ɛ kɛn, kä cakɛ nyɔk kɛ tiëm, kɛn bi ciaaŋdiɛn ɛ jɔak ɛmɛ jiääk ni jɛn kä ciaaŋdiɛn ëë nhiam. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.20",
            "verseOrgIds": [
              "2PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä dee gɔaa ni jɛn kɛ kɛ ɛn ɣöö /ka̱n duɔ̱ɔ̱p ciɛŋä cuŋni kɔŋ ŋa̱c. Kä kɛ kɔr kä mi jɛ ŋa̱c, bɛ jiääk ɛlɔ̱ŋ ɛn ɣöö bikɛ rɔ̱ riet jɔk kä ŋut in rɛl rɔ min ca ka̱mkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.21",
            "verseOrgIds": [
              "2PE.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cɛ tuɔɔk kä kɛ ce̱tkɛ min ca lat ɛ ruac pɛli i̱,",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.22",
            "verseOrgIds": [
              "2PE.2.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:22",
              "type": "text"
            },
            {
              "text": "Pɛl 26:11.",
              "type": "text"
            }
          ]
        }
      ]
    }
