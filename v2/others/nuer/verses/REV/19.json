    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tɛ̈th lɔaac nhial",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä mɛmɛ cua mi ce̱tkɛ jɔw bunä nɛɛni ti ŋuan liŋ nhial, wäkɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gua̱a̱th mi̱thni kuën Ruath Dɛ̈ɛ̈l",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.4",
            "verseOrgIds": [
              "REV.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu jɔw ben wi̱i̱ kɔam kuäärä Kuɔth, wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu jääk nhial ɣä jiök i̱, “Gɔ̱r mɛmɛ. A puɔ̱th tekɛ nɛy tin ca cɔal guäth mi̱thni kuën Ruath Dɛ̈ɛ̈l.” Kä cuɛ ɣä jiök i̱, “Ti̱ti̱ kɛ rieet Kuɔth ti thuɔ̱ɔ̱k.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.9",
            "verseOrgIds": [
              "REV.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua rɔ yuɔr piny ciöknikɛ kɛ ɣöö, bä jɛ pal, kä duundɛ ɣöö cuɛ ɣä jiök i̱, “/Cu mɔmɔ lät! Ɛ ɣän läät kɛ ji̱ kɛɛl yɛnɛ dämuɔɔri tin ka̱pkɛ ruac nenä Yecu. Pal ni Kuoth. Kɛ ɣöö ruac nenä min ci Yecu ɛ lat ɛ jɛn yiëë göökni.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.10",
            "verseOrgIds": [
              "REV.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ram in kɔt jio̱k tuɔ̱ruɔ̱k in bo̱r",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.10",
            "verseOrgIds": [
              "REV.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ cua nhial nɛn cɛ rɔ lɛp, kä nɛnɛ, tëëkɛ jio̱k tuɔ̱ruɔ̱k mi bo̱r! Kä ram min ko̱t jɔkdɛ, cɔalɛ Ram mi Gɔaa, kä Thuɔ̱k jɛn la lukɛ kä tɛɛrɛ ko̱r kɛ cuɔ̱ɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱t nyinkɛ kɛ bo̱l maac, kä te wi̱cdɛ kɛ kuɔ̱mni kuäärä ti ŋuan. Kä tëëkɛ ciöt mi ca gɔ̱a̱r jɛ mi thil ram mi ŋäc jɛ, ɛ ni jɛn kärɔa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.12",
            "verseOrgIds": [
              "REV.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ca jɛ rony kɛ bi̱i̱ mi ca cua̱th rɛy riɛm, kä cɔalkɛ ciötdɛ i̱, “Ruac Kuɔth.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.13",
            "verseOrgIds": [
              "REV.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu rɛm nhial ti ca rony kɛ bieyni ti puath puaath ti bo̱o̱r ti gɔw jɛ guɔ̱ɔ̱r kɛ jio̱o̱k tuɔ̱ruɔ̱k ti bo̱o̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.14",
            "verseOrgIds": [
              "REV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä thɛp mi moth moth raar thokdɛ mi bɛ näk ni döör, kä bɛ kɛ ruac kɛ kɛɛt yieethä. Kä bɛ kɔaŋ nhiac raar gua̱a̱th nhiecä dɛɛni wal kɛ ŋɛ̈ny waŋä lɔaac Kuɔth in Leny Buɔ̱mdɛ ti Diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tëëkɛ ciöt mi ca gɔ̱a̱r puɔ̱ny bieydɛ, kɛnɛ ɣämdɛ i̱, “Kuäär kua̱ri kä Rueec ruëëcni.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua jääk Kuɔth nhial nɛn cuŋä rɛy ca̱ŋ, kä cɔɔlɛ diit nhial tin pär kɛ jɔw mi di̱i̱t i̱, “Bia, duɔlɛ rɔ kɛ kui̱ mi̱eth Kuɔth in di̱i̱t, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö bia ri̱ŋ kua̱ri ben cam, kɛnɛ ri̱ŋ kua̱ri rɛ̈m, kɛ ri̱ŋ wäthni köör, kɛ ri̱ŋ jiöŋkööri kɛnɛ ji̱kiɛn, kɛ ri̱ŋ nɛɛni diaal, nɛy tin lɔr kɛnɛ kuaany, nɛy tin tɔatni kɛnɛ tin di̱t.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua ley kɛnɛ kua̱r wec muɔ̱ɔ̱n kɛ rɛmkiɛn nɛn ca rɔ̱ dol, kɛ ɣöö bikɛ ko̱r tɛr kɛ ram min ko̱t jɔk jiöök tuɔ̱ruɔ̱k, kɛnɛ rɛmdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.19",
            "verseOrgIds": [
              "REV.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua ley käp kɛɛl kɛ gök mi gua̱n kacä min ci nyuuthni la̱t nhiamdɛ, tin mɛ̈tkɛ nɛy tin ca biɛl lɛ̱̈ɛ̱̈ jek kɛnɛ nɛy tin palkɛ cätdɛ. Kɛn rɛw ti̱ti̱ cua kɛ yuɔr yier maac mi waŋ kɛ wäl mi kɛc ŋuänydɛ a tëkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.20",
            "verseOrgIds": [
              "REV.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ca tha̱a̱ŋkiɛn tin ci duɔth ŋuɔ̱t kɛ thɛp raam in ko̱t jɔk jiöök tuɔ̱ruɔ̱k, ɛ jɛn thɛp in bä raar thokdɛ. Kä cuɛ diit diaal ria̱ŋ kɛ mi̱eth ri̱i̱ŋkiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.21",
            "verseOrgIds": [
              "REV.19.21"
            ]
          }
        }
      ]
    }
  ],
