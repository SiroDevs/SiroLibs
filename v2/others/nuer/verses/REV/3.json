              "type": "text"
            },
            {
              "text": "Ica 22:22.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ɣän ŋa̱cä lätkun. Nɛnɛ, cä thok duëël lɛp kɛ kui̱dun, min thil ram mi tekɛ lua̱ŋ kɛ ga̱kdɛ. Ɣän ŋa̱cä ɣöö kuiy lua̱ŋdun, kä cia ruacdä käp a bum, kä /ka̱nɛ ciötdä gak. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.8",
            "verseOrgIds": [
              "REV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛnɛ, ɣän bä ji̱ gua̱th dolä Cɛy-tan tin larkɛ jɛ i̱, lapkɔ ji̱ Juudh, kä /ciɛ kɛn, kackɛ jɛ ɣän bäkɛ jakä bëë, kä guɔŋkɛ rɔ ciöknikun, kä ba cu ŋa̱c ɛ kɛn ɛn ɣöö nhɔakä yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.9",
            "verseOrgIds": [
              "REV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö cia ruacdä käp kɛ ruɔ̱t bitdä, bä yɛ gaŋ kä riɛk in bëë rɛy ɣɔaa kɛɛliw, kɛ ɣöö bɛ nɛy tin cieŋ wi̱i̱ muɔ̱ɔ̱n ben ɣɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.10",
            "verseOrgIds": [
              "REV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cä thia̱k kɛ ben, ka̱pɛ min tekɛ yɛ, kɛ ɣöö bɛ thil ram mi bi kum kuäärädu mɛŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.11",
            "verseOrgIds": [
              "REV.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wä yɛn wä tiëm ɣän bä yɛ jakä thi̱r rɛy luaak Kuɔthdä. Kä /cia bi met wä raar rɛydɛ. Bä ciöt Kuɔthdä gɔ̱a̱r puɔ̱nydɛ, kɛnɛ ciöt wec Kuɔthdä min la Jɛ-ru-tha-lɛm in pay ben piny nhial kä Kuothdä, kɛnɛ ciötdä in pay cak. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.12",
            "verseOrgIds": [
              "REV.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ ram mi tekɛ ji̱th a jɛ liŋ min lär Yiëë Kuɔth ɛ duël Kuɔth.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.13",
            "verseOrgIds": [
              "REV.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wä thuɔk kä La-o-di-thia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.13",
            "verseOrgIds": [
              "REV.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä gɔ̱ri nɛmɛ jääk nhial in te dueel Kuɔth kä La-o-di-thia i̱, ‘Ti̱ti̱ kɛ rieet raam in cɔali Inɔnɔ, in la neen in thuɔ̱k kä ŋa̱thkɛ, min la tuk cäkä ŋɔaani tin ci Kuɔth kɛ cak.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ɣän ŋa̱cä lätkun ɛn ɣöö /cia la nɛy ti kɔ̱c kiɛ leth. Dëë nhɔk ni ɣöö mi cia kɔ̱a̱c kiɛ lëth! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.15",
            "verseOrgIds": [
              "REV.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ɣöö lapɛ da̱y da̱a̱y, kä /ci lɛ kɔ̱a̱c kiɛ lëth, bä yɛ ŋuɔ̱l raar thokdä.’ ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.16",
            "verseOrgIds": [
              "REV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö laar yɛn ɛ i̱, ‘Ria̱ŋä, kä ci nyinkä rɔ̱ kuay, kä thilɛ mi göörä.’ Kä kuecɛ jɛ ɛn ɣöö lapɛ ji̱ rikä, kä jiɛth lo̱c nath kɛ yɛ, kä lapɛ can, kä ciöör, kä ta̱yɛ juutdä. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.17",
            "verseOrgIds": [
              "REV.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ ɣän cuɔmä ji̱ ɛn ɣöö bi da̱a̱p mi ca jakä lɛy lɛy kɛ mac kɔk kä ɣä, kɛ ɣöö deri ria̱ŋ. Kɛnɛ bieyni ti bo̱o̱r, kɛ ɣöö bi rɔ rony kɛ kɛ, kɛ ɣöö bi rɔ kum kä ta̱a̱ juutädu in no̱ŋ ji̱ pöc. Kä bi wäl mi yi̱ri nyinku kɔk kɛ ɣöö deri nën. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.18",
            "verseOrgIds": [
              "REV.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:19",
              "type": "text"
            },
            {
              "text": "Pɛl 3:12.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän luëkä kä dua̱a̱cä nɛy tin nhɔakä. Kä ɛnɔ latdɛ thuɔ̱k kä rietdɛ rɔ dueeri. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.19",
            "verseOrgIds": [
              "REV.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liŋɛ! Ɣän cuɔ̱ŋä thok duëël kä dɔaŋä thi̱i̱k. Mi tëë kɛ ram mi liŋ jɔwdä kä lɛpɛ thi̱i̱k, bä ben rɛc kä jɛ, bä mi̱th kɛ jɛ kɛɛl, kä bɛ mi̱th kɛ ɣä kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bä ram in ci tiëm jakä nyuur kɛ ɣä kɛɛl wi̱i̱ kɔam kuäärädä ce̱tkɛ ɣöö ci ɣän piny puɔ̱t, kä cä nyuur kɛɛl kɛ Gua̱a̱r wi̱i̱ kɔam kuäärädɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ram mi tekɛ ji̱th a jɛ liŋ min lär Yiëë Kuɔth ɛ duël Kuɔth.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.22",
            "verseOrgIds": [
              "REV.3.22"
            ]
          }
        }
      ]
    }
  ],
