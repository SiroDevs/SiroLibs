              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ, mi mi̱th yɛn kiɛ mäth yɛn, kiɛ ɛn duɔ̱ɔ̱r ɔ bia la̱t ɔ, la̱tdɛ kɛn diaal kɛ kui̱ puɔnyä Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.31",
            "verseOrgIds": [
              "1CO.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cuarɛ ji̱ Juudh kiɛ ji̱ Gɛ-rith, kiɛ duel Kuɔth moc kɛ riɛk, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.32",
            "verseOrgIds": [
              "1CO.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ce̱tkɛ min cä jɛ ɣɔ̱n ɛn ɣöö bä lo̱c nɛɛni diaal jakä tɛth kä ti diaal tin la̱tdä, kä /cä go̱r ni mi gɔaa kɛ kui̱dä, ɛ mi gɔaa kɛ kui̱ nɛɛni ti ŋuan ɛn ɣöö dee kɛ kään.",
          "type": "text",
