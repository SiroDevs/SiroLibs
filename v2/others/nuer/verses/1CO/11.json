  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuɛ̈ɛ̈ ɣä nyiath, ce̱tkɛ min nyiathä Kritho.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kum wuɔ̱thni mi pal naath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän liakä yɛ kɛ ɣöö cia ɣä tim rɛy ŋɔaani diaal, kä cia guɔ̱ɔ̱r ni ŋi̱i̱cni ce̱tkɛ tëë cä ka̱m yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.2",
            "verseOrgIds": [
              "1CO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö göörä ɣöö bia jɛ ŋa̱c ɛn ɣöö wi̱c wutni diaal ɛ Kritho, kä wi̱c ciëk ɛ cɔwdɛ, kä wi̱c Kritho ɛ jɛn Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.3",
            "verseOrgIds": [
              "1CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä wut ɔ bi pal kiɛ bi ruac go̱o̱kä lat ɔ a te wi̱cdɛ kɛ kum, jakɛ ni wi̱cdɛ kä po̱c, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.4",
            "verseOrgIds": [
              "1CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä duundɛ ɣöö ciek ɔ bi pal kiɛ bi ruac go̱o̱kä lat ɔ kɛ wi̱c mi /ka̱n kum, jakɛ ni wi̱cdɛ kä po̱c, päärɛ kɛ ciek mi ca wi̱cdɛ mut. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.5",
            "verseOrgIds": [
              "1CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mi /ci ciek wi̱cdɛ bi kum, ŋua̱n ni ɣöö bɛ mi̱emkɛ tëm. Kä mi ɛ pöc kä ciek ɛn ɣöö ba mi̱emkɛ tëm kiɛ ba wi̱cdɛ mut, a jɛ kum wi̱cdɛ kɛ bi̱i̱. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä gɔaa ni ɣöö /ci wut wi̱cdɛ bi kum, kɛ ɣöö ɛ cät kä ɛ gɔɔy puɔnyä Kuɔth. Kä duundɛ ɣöö ciek ɛ wuɔ̱t wutdä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.7",
            "verseOrgIds": [
              "1CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k /ka̱n wut cak kä ciek, ɛ ciek ɛn ni̱n cakɛ kä wut. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.8",
            "verseOrgIds": [
              "1CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ka̱n wut cak kɛ kui̱ ciëk, kä ɛ ciek kɛ kui̱ wutdä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.9",
            "verseOrgIds": [
              "1CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ gɔaaɛ ɛn ɣöö dee ciek wi̱cdɛ kum mi la nyuuth bumä kɛ kui̱ jaakni nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.10",
            "verseOrgIds": [
              "1CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä rɛy teekädan, rɛy Kua̱r ni Yecu /ci ciek te kärɔa a thil wut kä /ci wut te kärɔa a thil ciek. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.11",
            "verseOrgIds": [
              "1CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ce̱tkɛ min ca ciek cak kä wut, ɛnɔ wut diëthkɛ jɛ ɛ ciek. Kä duundɛ ɣöö ti diaal bäkɛ kä Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.12",
            "verseOrgIds": [
              "1CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Carɛ jɛ ɛ yɛn, gɔaaɛ kɛ ciek ɛn ɣöö bɛ Kuoth pal a /kenɛ wi̱cdɛ kum rɛy nath? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.13",
            "verseOrgIds": [
              "1CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ci ciaŋ ɛ nyuth yɛ ɛn ɣöö ciaŋ wutdä kɛ mi̱em ti ba̱a̱r ba̱a̱r nöŋkɛ jɛ pöc, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.14",
            "verseOrgIds": [
              "1CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä duundɛ ɣöö ciaaŋ ciëk kɛ mi̱em ti ba̱a̱r ba̱a̱r /ciɛ liak kä jɛ? Kɛ ɣöö ka̱mkɛ jɛ mi̱emkɛ kɛ kui̱ kä ɣöö ba jɛ kum. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.15",
            "verseOrgIds": [
              "1CO.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi tëëkɛ ram mi ŋak mɛmɛ, min dëë lar ɛ ɣöö thilɛ kɔn ciaaŋ mi ce̱tkɛ nɔ, kä thilɛ ji̱ dolä Kuɔth ciaaŋ mi ce̱tkɛ nɔ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mi̱eth Kua̱r ni Yecu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ kɛ nyuuthni ti bëë ti, ɣän /cä yɛ liak, kɛ ɣöö mi cia ben guäth kɛl, /ciɛ kɛ kui̱ kä mi gɔaa, duundɛ ɣöö kui̱ kä mi jiääk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.17",
            "verseOrgIds": [
              "1CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö, mi cia ben kɛɛl ala ji̱ dolä Kuɔth, ɣän liɛŋä jɛ ɛn ɣöö tëëkɛ dääk kamnikun, kä cua jɛ ŋäth kɛ tha̱a̱ŋdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.18",
            "verseOrgIds": [
              "1CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k bɛ dhil tekɛ dääk rɛydun, kɛ kui̱ kä ɣöö ba jɛ ŋa̱c kɛ ŋaani la nɛɛ Kuɔth ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.19",
            "verseOrgIds": [
              "1CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɔ cia mat guäth kɛl ɔ, /ciɛ mi̱eth Kua̱r ni Yecu ɛnɔ camɛ mɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.20",
            "verseOrgIds": [
              "1CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mɔ ci gua̱a̱th mi̱eth cop ɔ la ramɔ mi̱ethdɛ cua cam, kä näk buɔth tha̱a̱ŋ nath, kä yɔ̱ŋ tha̱a̱ŋ nath tin kɔ̱ŋ kɛ kɔaaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.21",
            "verseOrgIds": [
              "1CO.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋu! Thilɛ yɛ ciëëŋ ti mi̱ethɛ kä ma̱thɛ thi̱n? Kiɛ ɛ ɣöö bia luaak Kuɔth lat jɔ̱ɔ̱r, kä bia nɛy tin thil ŋu jakä po̱c? Ɛŋu mi bä la̱r yɛ? Ɣän dëë yɛ liak kɛ ɛnɛ? Ëëy, /cä yɛ bi liak!",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ŋi̱i̱c ëë cä jek kä Kuäär ɛ jɛn ɛ ni̱n cä ka̱m yɛ, kɛ ɣöö, jɛn Kuäär ni Yecu kɛ wäär ëë kɔakɛ ni jɛ, cuɛ juray ka̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä mëë cɛ tɛ̈th lɔaac lar, cuɛ jɛ puɔ̱ny kä cuɛ wee i̱, “Mɛmɛ ɛ puɔ̱nydä, min cä thöp yɛ. La̱tdɛ mɛmɛ ala ti̱emdun kɛ ɣä.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ jɛn duɔ̱ɔ̱p ɛmɔ bä kɛ kɔr mi̱eth, cuɛ liɛɛr ka̱n, kä cuɛ wee i̱, “Liɛɛr ɛmɛ ɛ mat ruac in pay tuɔɔk kɛ riɛmdä. Kä ɛn guäthɔ bi yɛn jɛ a maath thi̱n ɔ, la̱tdɛ jɛ ala ti̱emdun kɛ ɣä.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö gua̱thni diaal tɔ̱ bi yɛn juray ɛmɛ cam kä ma̱thɛ kɛ liɛɛr ɛmɛ, bi yɛn lia̱a̱ Kua̱r ni Yecu lat amäni mi cɛ ben.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
              "1CO.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
