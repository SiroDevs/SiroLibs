        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac kɛ kui̱ puɔ̱tdä Kritho jiaath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cä ben kä yɛ, dämaari, ɣän /ka̱n ben ɛ la̱tdä yɛ ruac kɛ kui̱ Kuɔth kɛ rieet ti di̱t kiɛ pɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
              "1CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö cä jɛ lar ɛn ɣöö thilɛ mi bä ŋa̱c rɛydun ɛ ni Yecu Kritho, kɛnɛ lia̱a̱dɛ wi̱c jiaath in ri̱ew. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.2",
            "verseOrgIds": [
              "1CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän mëë ba̱a̱ kä yɛ kɔ̱a̱cä kä lathɛ ɣä kɛ dual mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ruacdä kɛnɛ ŋi̱i̱cdä /cäkɛ lat kɛ rieet pɛlä nath, duundɛ ɣöö latdä kɛ kɛ ŋäc bumä Yieekä Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.4",
            "verseOrgIds": [
              "1CO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö /ci ŋa̱thdun lɔ̱ŋ rɛy pɛlä nath, duundɛ ɣöö lɔ̱ŋɛ rɛy bumä Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pɛl Kuɔth in thuɔ̱k",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋotdɛ bä ruacä kɛ pɛl kɛ nɛy tin ci dël. Kä /ciɛ pɛl runi ti̱ti̱ kiɛ pɛl ruëëcni runi ti̱ti̱ tin bathkɛ buɔ̱mdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.6",
            "verseOrgIds": [
              "1CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän latdä ni pɛl Kuɔth tin la tɛ̱̈ɛ̱̈ni, ci Kuoth kɛ car kɛ kui̱ bumädan ni mëë /ka̱n ɣɔw ni cak. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.7",
            "verseOrgIds": [
              "1CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ ram kɛl kä ruëëc runi ti̱ti̱ mi ŋäc mɛmɛ. Kɛ ɣöö mi ca jɛ ŋa̱c ɛ kɛn, /cikɛ Kuäär buɔyä dee pua̱t jiaath. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.8",
            "verseOrgIds": [
              "1CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱tkɛ mëë ca gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:9",
              "type": "text"
            },
            {
              "text": "Ica 64:4.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.13",
            "verseOrgIds": [
              "1CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛy tin /ci a ji̱ yieekä /ca mucni Yieekä Kuɔth jek, kɛ ɣöö kɛ dɔ̱ɔ̱r kä kɛ. Kä /cikɛ cup lɔɔcdiɛn, kɛ ɣöö jëkɛ luɔtdiɛn kɛ ciaaŋ yieekä kärɔa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.14",
            "verseOrgIds": [
              "1CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛy tin tekɛ yiëë luɔ̱kɛ luɔ̱ɔ̱tni ŋɔaani diaal, kä thilɛ ram mi bikɛ luk.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.15",
            "verseOrgIds": [
              "1CO.2.15"
            ]
          }
        }
      ]
    }
  ],
