          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Kueth akɛ ram in /ci gua̱n kɛnɛ man luth.’ Kä bi nɛy diaal ɛ loc i̱, ‘Inɔnɔ.’",
          "type": "text",
          "attrs": {
