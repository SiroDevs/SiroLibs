              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tit min ci lar kɛ lɛpdu kɛ nhiam, thöp ni muc yäcädu Kuoth Nhial Kuothdu min ci lar kɛ thokdu.",
          "type": "text",
          "attrs": {
