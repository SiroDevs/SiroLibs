        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Com Muthɛ I-thɛ-rɛl luthä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛn täämɛ, lö ji̱ I-thɛ-rɛl, liɛŋɛ ŋuɔ̱t kɛnɛ luëëk tin cä ŋi̱i̱c ni yɛ, la̱tdɛ kɛ, kä dɔ̱ɔ̱ bia tëk, ɛ bia mun ëë ci Kuoth Nhial Kuoth guurikun ɛ ka̱m yɛ wä ciɛŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.1",
            "verseOrgIds": [
              "DEU.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cuarɛ riet ëë cä luëëkni yɛ rep, kä /cuarɛ duɔ̱ɔ̱r woc thi̱n. Tiɛtdɛ luëëk Kuɔth Nhial Kuothdun tëë cä luëëk yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.2",
            "verseOrgIds": [
              "DEU.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cia nɛn kɛ wäŋkun ɛn nëë ci Kuoth Nhial ɛ la̱t kä Baal-pɛ-or rɛydun cu Kuoth Nhial Kuothdun nɛy diaal tëë guɔ̱ɔ̱rkɛ Baal-pɛ-or däk. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.3",
            "verseOrgIds": [
              "DEU.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tëë diaal tëë ca Kuoth Nhial Kuothdun ŋäth kä yɛ, ka teekä ɛn wa̱lɛ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.4",
            "verseOrgIds": [
              "DEU.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.4",
            "verseOrgIds": [
              "DEU.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä nɛnɛ jɛ. Cä yɛ ŋi̱i̱c kɛ ŋuɔ̱t kɛnɛ luëëk. Ce̱tnikɛ mëë ci Kuoth Nhial Kuothda jɛ la̱tdä, kä la̱tdɛ kɛ muun in bia wä cieŋ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.5",
            "verseOrgIds": [
              "DEU.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiɛtdɛ kɛ kä la̱tdɛ kɛ, kɛ ɣöö bikɛn a ŋäcdun kɛnɛ tiitdun rɛy nath, kä kɛn tɔ̱ bikɛ liŋ kɛn ŋuɔ̱t ɛ ti diaal bikɛ wee, ‘Ɛ puc kɛn nɛy ti̱ti̱ kɛ nɛy ti ŋa̱ckɛ ŋɔak i̱di!’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.6",
            "verseOrgIds": [
              "DEU.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.6",
            "verseOrgIds": [
              "DEU.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ nɛy ti gɔw tekɛ kuoth mi thia̱k kɛ kɛ, ce̱tkɛ mɔ te Kuoth Nhial Kuothdan kɛ kɔn ɔ, mi canɛ luäk thiec kä jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.7",
            "verseOrgIds": [
              "DEU.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ nɛy tia̱ ni gɔw tɔ̱, kä tekɛ ŋuɔ̱t kɛnɛ luëëk ti cuŋ ce̱tkɛ ŋuɔ̱t ɛ ti diaal ti cä la̱th nhiamdun ɛn wa̱lɛ ti?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.8",
            "verseOrgIds": [
              "DEU.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.8",
            "verseOrgIds": [
              "DEU.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛ ni ɣöö tit rɔɔdu agɔaa, cu tëë ci nɛ̈n kɛ waŋdu bi pa̱l rueec, kä bikɛ jak kä bathkɛ rɛy lɔacdu, kɛ ni̱n teekädu diaal. Ŋi̱i̱cnikɛ gaatku kɛnɛ gaat ganku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.9",
            "verseOrgIds": [
              "DEU.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Carɛ cäŋ ëë jiacɛ ni rɔ nhiam Kuoth Nhial Kuothdun kä Thi-nay. Cu Kuoth Nhial ɣä jiök i̱, ‘Cio̱li ɣä duɔl nath, kɛ ɣöö ba ruacdä ben liŋ, kä bikɛ ɣä luɔ̱th kɛ ni̱n diaal tin tëk kɛ kɛ wi̱i̱ muɔ̱ɔ̱n. Kä bikɛn kɛ ŋi̱i̱c gaatkiɛn.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.10",
            "verseOrgIds": [
              "DEU.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.10",
            "verseOrgIds": [
              "DEU.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä /cuarɛ ben cuɔ̱ŋ thiäkä thaar pa̱a̱m, guäth ëë pɛt päm kɛ mac ëë räth ni pua̱a̱r kɛ wuɔ̱n mi lɔw, kɛnɛ muth mi col. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.11",
            "verseOrgIds": [
              "DEU.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ruac kɛ yɛ däär maac. /Cuarɛ ruac liŋ, kä thilɛ puɔ̱ny mi cia nɛn. Ɛni jɔw kä rɔa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.12",
            "verseOrgIds": [
              "DEU.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ yɛ la̱t gukdɛ, mëë cɛ la̱r yɛ i̱ bia guɔ̱r, ala luëëk da̱ŋ wäl. Tëë cɛ gɔ̱a̱r päämni da̱ŋ rɛw ti pat paat. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.13",
            "verseOrgIds": [
              "DEU.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ɣä jiök ɛn gua̱a̱th mɔ i̱ bä yɛ ŋi̱eec kɛ ŋuɔ̱t kɛnɛ luëëk, kɛ ɣöö bia kɛ wä la̱t ɛn muun ɛ bia wä thi̱n ɔ.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.14",
            "verseOrgIds": [
              "DEU.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luek kɛ kui̱ kuthni guäyni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.14",
            "verseOrgIds": [
              "DEU.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ kui̱ ɛmɔ tiɛtdɛ rɔ̱ɔ̱dun. Kɛ mëë thilɛ puɔ̱ny mi cia nɛn, ni̱ni tëë ruac Kuoth Nhial kɛ yɛ kä Thi-nay däär maac ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.15",
            "verseOrgIds": [
              "DEU.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiɛtdɛ jɛ /cuarɛ bi lät ɛ jiäk kɛ täthdun kɛ rɔ kuoth jiɛn, ti cäät kɛ tut kɛnɛ ŋut, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.16",
            "verseOrgIds": [
              "DEU.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiɛ cäät kɛ ley wec muɔ̱ɔ̱n, kiɛ ti cäät kɛ diit nhial, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.17",
            "verseOrgIds": [
              "DEU.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiɛ ti cäät kɛ muɔɔl piɛny, kiɛ kɛ rɛc yieer piny muɔ̱ɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.18",
            "verseOrgIds": [
              "DEU.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tiɛtdɛ jɛ mi wä yɛn pua̱a̱r wä liɛc, kä bia cäŋ nɛn kɛnɛ pay kɛ kuɛl, kɛn tin diaal tin cieŋ puɔ̱rä /cuarɛ rɔ rit kɛ, kä /cuarɛ kɛ pal, kä /cuarɛ kɛ lätikä. Kɛn tin ci Kuoth Nhial Kuothdun kɛ ka̱m nɛy diaal tin te piny puɔ̱rä. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.19",
            "verseOrgIds": [
              "DEU.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ca yɛ mɛk ɛ Kuoth Nhial, kä cɛ yɛ nööŋ raar rɛy la̱t mi bɛc rööl I-jëp, i̱ bi yɛn ben a nɛɛkɛ, ce̱tkɛ ni̱n ɛ ti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.20",
            "verseOrgIds": [
              "DEU.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min dɔ̱ŋ ɛ ɣöö gak Kuoth Nhial kɛ ɣä kɛ kui̱dun, cɛ rɔ yac i̱ cä Jɔr-dɛn bi jiath kui̱c. Inɔ cä bi wä muun in gɔaa in ci Kuoth Nhial Kuothdun ɛ ka̱m yɛ kɛ ciaaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.21",
            "verseOrgIds": [
              "DEU.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän bä li̱w, /cä bi wä kä Jɔr-dɛn. Bia wä thi̱n, bia mun ɛmɔ wä ciɛŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.22",
            "verseOrgIds": [
              "DEU.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiɛtdɛ rɔ, kɛ ɣöö /cia guk Kuɔth Nhial Kuothdun bi pa̱l rueec, mëë cɛ lat kɛ yɛ, a bia rɔ la̱t kuoth jiɛn ti cäät kɛ tëë ca yɛ gak thi̱n ɛ Kuoth Nhial Kuothdun. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.23",
            "verseOrgIds": [
              "DEU.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö Kuoth Nhial Kuothdun ɛ Kuoth mi ce̱tkɛ mac, kä gua̱n tiilä.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.24",
            "verseOrgIds": [
              "DEU.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.24",
            "verseOrgIds": [
              "DEU.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ji̱n mi wi̱i̱ jääny ɛn muun ɛ mi kɛ pëk mi bäär, a bi tekɛ gaat kɛnɛ gaat ganku, cu duer lät kɛ lätnidu kɛ kuoth jiɛn mi cäät kɛ duɔ̱ɔ̱r, kiɛ mi jiääk waaŋ Kuɔth Nhial Kuothdun, kä bi lɔcdɛ jak kä jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.25",
            "verseOrgIds": [
              "DEU.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cɔalä nhial kɛnɛ piny kɛ ɣöö bi ka nëënkun ɛ ni̱ni ti̱ti̱, niɛ täämɛ kɛ pɛ̈th bia nuɔr ɛn muun ɛ wiaa cieŋ thi̱n ɛ kui̱ Jɔr-dɛn. Cia bi cieŋ thi̱n ɛlɔ̱ŋ, bɛ rɔ pär kɛ da̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.26",
            "verseOrgIds": [
              "DEU.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Kuoth Nhial yɛ riaw kä rɛy dör, bi pëkdun kuɛ̈ɛ̈ rɛy döri tin bi Kuoth Nhial yɛ naŋ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.27",
            "verseOrgIds": [
              "DEU.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱a̱ni bi lätni kuth jiɛɛn kɛnɛ pääm lätikä, tin la̱tkɛ kɛ tet ɛ naath, ti ci liŋ kä ci guic, kä ci mith, kä ci ŋuäc. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.28",
            "verseOrgIds": [
              "DEU.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔrɛ bia Kuoth Nhial Kuothdun go̱r, kä bia jek mi go̱o̱r yɛnɛ kɛ locdun kɛɛliw, nikɛ yiëëdun kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.29",
            "verseOrgIds": [
              "DEU.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wä ti̱ti̱ ben kä ji̱ cäŋ kɛl, a bi riɛk, bi rɔ cu riet Kuoth Nhial Kuothdu, kä bi jɛ cu luɔ̱th, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.30",
            "verseOrgIds": [
              "DEU.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö Kuoth Nhial Kuothdu ɛ Kuoth mi kɔc lɔc. /Cɛ ji̱ bi däk kä /cɛ gukdɛ bi pa̱l rueec mëë cɛ yaac ni rɔ kɛnɛ guurikun.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.31",
            "verseOrgIds": [
              "DEU.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.31",
            "verseOrgIds": [
              "DEU.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Thiecɛ ɛn täämɛ kɛ kui̱ ni̱ni tëë ci wä ni wal, ni ni̱ni tëë cak Kuoth ɛ ni raan wi̱i̱ muɔ̱ɔ̱n. Kä thiec pua̱a̱r a wä peek in dɔ̱ŋ, mi tëë kɛ mi ci kɔn tuɔɔk ce̱tkɛ nɛmɛ, kiɛ ca kɔn mët liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.32",
            "verseOrgIds": [
              "DEU.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëë kɛ nɛy ti ca jɔw kuɔth mët liŋ ruacɛ däär maac, ce̱tkɛ mëë cia liŋ, kä ŋotkɛ kɛ tëk? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.33",
            "verseOrgIds": [
              "DEU.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kua tëë kɛ kuoth mi ci jɛ ɣɔ̱n i̱ mocɛ rɔ kɛ dör nath rɛy döör i̱ dɔ̱ŋ. Kɛ ɣɔ̱ɔ̱ni kiɛ ti ga̱ykɛ naath kiɛ ko̱r, kiɛ kɛ tet mi bum kiɛ kɛ dual mi diit, ce̱tkɛ tëë diaal tëë ci Kuoth Nhial Kuothdun kɛ la̱t kä yɛ nhiamdun kä I-jëp? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.34",
            "verseOrgIds": [
              "DEU.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ca nyuɔth i̱ bia ŋa̱c ɛn ɣöö Kuoth Nhial ɛ jɛn Kuoth, thilɛ Kuoth mi dɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.35",
            "verseOrgIds": [
              "DEU.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni puɔ̱rä cɛ ji̱ jak kä liŋi jɔwdɛ kɛ ɣöö bɛ ji̱ luek. Piny cɛ ji̱ jak kä nɛɛni macdɛ in di̱i̱t, kä cuɛ ji̱ jak kä liŋi rietdɛ däär maac. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.36",
            "verseOrgIds": [
              "DEU.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö nhɔk Kuoth guurikun, kä cɛ kuaykiɛn mɛk kɔɔriɛn kä cɛ yɛ ka̱m raar kä I-jëp kɛ puɔ̱nydɛ kɛnɛ buɔ̱mdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.37",
            "verseOrgIds": [
              "DEU.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ dör ti ŋuan kä bum ni kɛn kä yɛ juɔc raar nhiamdun, kä cuɛ yɛ naŋ muundiɛn kɛ ɣöö bia jɛ ciɛŋ, amäni walɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.38",
            "verseOrgIds": [
              "DEU.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niɛ walɛ a kua jɛ la̱th lo̱cdun, ɛn ɣöö Kuoth Nhial ɛ jɛn Kuoth puɔ̱rä nhial kɛnɛ wi̱c muɔ̱ɔ̱n piny. Thilɛ Kuoth mi dɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.39",
            "verseOrgIds": [
              "DEU.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ tiɛtdɛ ŋuɔ̱tkɛ kɛnɛ luëëkɛ, tëë cä la̱t yɛ ni̱ni ti̱ti̱, dɔ̱ŋ bikɛ wä kɛ yɛ agɔaa, kɛnɛ gaatkun kɔɔrun. Dɔ̱ŋ bi ni̱nkun ŋuan muun in ci Kuoth Nhial Kuothdun ɛ ka̱m yɛ ala do̱raar.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.40",
            "verseOrgIds": [
              "DEU.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wi̱i̱ luäkä kui̱ käny ca̱ŋ Jɔr-dɛn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.40",
            "verseOrgIds": [
              "DEU.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Muthɛ wi̱i̱ da̱ŋ diɔ̱k la̱t kui̱ käny ca̱ŋ Yieer Jɔr-dɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.41",
            "verseOrgIds": [
              "DEU.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö bi ram mi ci raan näk rɔ bar thi̱n, ram mi näk gua̱n thieekädɛ kɛ guäc, mi thilɛ kɛ tɛr ni wen, mi wëë rɔ wä bar wi̱c kɛl kä wi̱i̱ ɛ tɔ̱tɔ̱ bɛ tëk thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.42",
            "verseOrgIds": [
              "DEU.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Bɛ-dhɛr kuer in te rɛy dɔɔr a wec ji̱ Rɛ-u-ben, kä cu Ra-moth kä Gil-yad a wec ji̱ Gad, kä cu Go-lan kä Ba-can a wec ji̱ Ma-na-thɛ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "La̱t thöpä ŋuɔ̱tni Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛ mi ɛ ŋuɔ̱t ëë käm Muthɛ ɛ gaat I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.44",
            "verseOrgIds": [
              "DEU.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ ŋuɔ̱t kɛnɛ luëëk tëë lät Muthɛ kɛ gaat I-thɛ-rɛl mi bäkɛ raar kä I-jëp, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.45",
            "verseOrgIds": [
              "DEU.4.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 4:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "kui̱ Jɔr-dɛn lo̱o̱lä min car rɔ kɛ Beth-pɛ-yor muun Thi-yon kuäär ji̱ Ɛ-mor tëë cieŋ kä Ɛc-bon, tëë joc Muthɛ kɛ kɛnɛ gaat I-thɛ-rɛl, mëë bäkɛ raar kä I-jëp. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.46",
            "verseOrgIds": [
              "DEU.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ mundɛ ka̱n kɛnɛ mun Ög kuäär Ba-can, kɛn kua̱r ji̱ Ɛ-mor da̱ŋ rɛw tëë cieŋ kui̱ käny ca̱ŋ kui̱ Jɔr-dɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.47",
            "verseOrgIds": [
              "DEU.4.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DEU 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "känɛ ni kä Ä-ro-er min te peek lo̱o̱lä Ar-non, a räth ni pääm Thir-yon (min mɔ Ar-non). ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.48",
            "verseOrgIds": [
              "DEU.4.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matdɛ Ä-ra-ba kɛɛliw kui̱ käny ca̱ŋ Jɔr-dɛn a wä mäni Bar Milɛ thaar Pa̱a̱m Pi̱dh-ga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.49",
            "verseOrgIds": [
              "DEU.4.49"
            ]
          }
        }
      ]
    }
  ],
