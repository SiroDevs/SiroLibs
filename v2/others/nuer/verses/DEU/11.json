          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nɛ̈nɛ jɛ, ɣän la̱th lam nhiamdun ɛn walɛ kɛnɛ puɔ̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puɔ̱th ɛ ɣöö mi wä yɛn luëëk Kuɔth Nhial Kuothdun wä luɔ̱th ti cä la̱t yɛ ti ɛn walɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä lam ɛ ɣöö mi /ci yɛn luëëk Kuɔth Nhial Kuothdun bi luɔ̱th, ɛ bia guɔ̱ɔ̱r ni Kuth ti guäy ti kui̱c yɛn kɛ, a päl yɛn ni dupkɛ ti cä la̱t yɛ ti ɛn walɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wä Kuoth Nhial Kuothdun yɛ wä naŋ muun in bia wä ciɛŋ, la̱thɛ puɔ̱th pääm Gɛ-ri-dhim, kä bia lam la̱th pääm Ee-bal. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn pääm ɛ ti tekɛ kui̱ Jɔr-dɛn, kui̱ konyä ca̱ŋ, mun ji̱ Kɛ-naan tin cieŋ kä Ä-ra-ba, min thieek kɛ jiath Morɛ kut Gil-gal. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bia wä kui̱ Jɔr-dɛn muun in bi Kuoth Nhial Kuothdun ɛ wä ka̱m yɛ i̱ bia ciɛŋ. Mi wä yɛn ɛ wä ciɛŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiɛtdɛ ŋuɔ̱t diaal ti cä la̱t yɛ ti walɛ agɔaa.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.32",
            "verseOrgIds": [
              "DEU.11.32"
            ]
          }
        }
      ]
    }
