        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puɔ̱th nɛɛni ti tekɛ luth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wi̱i̱ jɔw Kuoth Nhial Kuothdu luɔ̱th, kɛ ti̱etdu kɛ ŋuɔ̱tkɛ diaal ti cä la̱t ji̱ walɛ ti, bɛ ji̱ la̱th wi̱i̱ döri diaal wi̱i̱ muɔ̱ɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.1",
            "verseOrgIds": [
              "DEU.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wi̱i̱ jɔw Kuɔth Nhial Kuothdu wä luɔ̱th, bi puɔ̱th kɛɛliw ben kä ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.2",
            "verseOrgIds": [
              "DEU.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puɔ̱th akɛ ji̱ wi̱i̱niku diaal kɛnɛ ka̱a̱ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.3",
            "verseOrgIds": [
              "DEU.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puɔ̱th akɛ gaatku, kɛnɛ mundu, kɛ ɣɔ̱ɔ̱ku kɛnɛ detku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.4",
            "verseOrgIds": [
              "DEU.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puɔ̱th akɛ mi̱ethdu kɛnɛ tin go̱o̱ri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.5",
            "verseOrgIds": [
              "DEU.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puɔ̱th akɛ wädu raar kɛnɛ bendu rɛc.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.6",
            "verseOrgIds": [
              "DEU.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.6",
            "verseOrgIds": [
              "DEU.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä bi Kuoth Nhial ji̱ tɛ̈ru tin ca rɔ jiëci jak kä juɔckɛ nhiamdu. Bikɛ ben kä yɛ kɛ duɔ̱ɔ̱p kɛl, kä bia kɛ joc kɛ dup bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.7",
            "verseOrgIds": [
              "DEU.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Kuoth Nhial puɔ̱th ka̱m gua̱th tɔ̱ɔ̱wniku diaal kɛnɛ tin diaal tin ci la̱t. Kä bɛ ji̱ poth muun in ci Kuoth Nhial Kuothdun ɛ ka̱m yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.8",
            "verseOrgIds": [
              "DEU.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Kuoth Nhial yɛ cu jak kä nɛɛkɛ ti gɔw, ce̱tkɛ mëë cɛ la̱t yɛ, mi cia ŋuɔ̱tkɛ tit kä cia guɔ̱r ni dupkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.9",
            "verseOrgIds": [
              "DEU.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi bi ji̱ wec muɔ̱ɔ̱n diaal ɛ nɛn i̱ kɛ yɛn nɛɛ Kuɔth Nhial. Bikɛ dual kɛ yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.10",
            "verseOrgIds": [
              "DEU.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial gɔykun rep, bɛ gaatku rep, kɛnɛ mundu, kɛ ɣɔ̱ɔ̱ku, muun in ci Kuoth Nhial ɛ guɔ̱k gua̱nikun i̱ bɛ ka̱m yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.11",
            "verseOrgIds": [
              "DEU.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial yɛ lëp gɔɔy cieŋdɛ Nhial, bɛ yɛ jäk kä nhiaal ce̱tkɛ gua̱a̱thdɛ kä bɛ yɛ puɔ̱th tin diaal tin cia la̱t. Bia dör ti ŋuan ŋuälikä, kä duundɛ ɣöö cia ŋua̱l bi ka̱n kä kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.12",
            "verseOrgIds": [
              "DEU.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial yɛ jak kä bööth nath a /ci mɔ a jɔk nath, kä bia tekɛ ti ŋuan ti /ci bi met kuɛ̈ɛ̈. Mi cia luëëk Kuɔth Nhial Kuothdun luɔ̱th ti cä la̱t yɛ ti walɛ, kä cia la̱tdiɛn tit. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.13",
            "verseOrgIds": [
              "DEU.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thilɛ riet kɛl mi cia päl kä rieet ti cä la̱t yɛ ti walɛ, kɛ ɣöö /cia guɔ̱ɔ̱r ni kuth kɔ̱kiɛn.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.14",
            "verseOrgIds": [
              "DEU.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kueth nɛɛni ti thil luth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.14",
            "verseOrgIds": [
              "DEU.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä duundɛ ɣöö mi /keni jɔw Kuɔth Nhial Kuothdu liŋ, kiɛ /keni ŋuɔ̱tkɛ diaal ti cä la̱t ji̱ ti la̱tdiɛn tit agɔaa. Bi kuëth ti diaal ti̱ti̱ ben kä ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.15",
            "verseOrgIds": [
              "DEU.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi kuëth te wi̱i̱du min ciɛŋi, kɛnɛ ka̱a̱ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.16",
            "verseOrgIds": [
              "DEU.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kueth akɛ mi̱ethdu kɛnɛ tin go̱o̱ri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.17",
            "verseOrgIds": [
              "DEU.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kueth akɛ gaatku kɛnɛ mundu kɛ ɣɔ̱ɔ̱ku kɛnɛ detku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.18",
            "verseOrgIds": [
              "DEU.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kueth akɛ wädu raar kɛnɛ bendu rɛc.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.19",
            "verseOrgIds": [
              "DEU.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.19",
            "verseOrgIds": [
              "DEU.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bi Kuoth Nhial yɛ jäk kä kueth, kɛnɛ nyuɔɔn wec, kɛ ŋɔa̱a̱ŋ kä ti diaal tin bia la̱t, amäni mi cia pɛ̈th kɛ lia̱a̱, kɛ kui̱ lätnikun ti jiäk, kɛ ɣöö /cia ɣä go̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.20",
            "verseOrgIds": [
              "DEU.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Kuoth Nhial yɛ nöŋ juey, amäni mi cɛ yɛ thuk muun in wiaa cieŋ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.21",
            "verseOrgIds": [
              "DEU.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Kuoth Nhial yɛ moc kɛ kiɛl kɛnɛ lëth puaany, kɛ bɛ̈c jiɛc, kɛ bɛc lɔaac kɛ rɔal pua̱ny kɛ thɔat pua̱ny. Ba ji̱ guɔ̱ɔ̱r amäni mi ci thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.22",
            "verseOrgIds": [
              "DEU.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi pua̱a̱r nhial a wi̱c wi̱c, kä bi piny buɔ̱m ala yiëëth. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.23",
            "verseOrgIds": [
              "DEU.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Kuoth Nhial nhiaal jak kä tup kɛnɛ tur muundu. Bikɛ ben kä ji̱ mäni mi ci duɔ̱p.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.24",
            "verseOrgIds": [
              "DEU.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.24",
            "verseOrgIds": [
              "DEU.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä bi Kuoth Nhial ji̱ jak kä juɔckɛ ɛ ji̱ tɛ̈ru. Bia kɛ mak kɛ duɔ̱ɔ̱p kɛl, kä bia rɔ bar nhiamdiɛn kɛ dup bärɔw, kä bia cua̱ ti jiäk kuäärä wec muɔ̱ɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.25",
            "verseOrgIds": [
              "DEU.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi riŋdun cua̱ mi̱eth kä ti diaal, diit nhial kɛnɛ lëy piɛny. Kä bɛ thil mi jockɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.26",
            "verseOrgIds": [
              "DEU.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial yɛ ka̱m burjum mi ce̱tkɛ duŋ I-jëp, kɛnɛ guɔnyɛ kɛ bɛ̈c jiɛc kɛnɛ kuuk mi /ci bi gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.27",
            "verseOrgIds": [
              "DEU.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Kuoth Nhial yɛ jak kä ciöör kɛnɛ nyuɔɔn wec kɛ yɔ̱ɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.28",
            "verseOrgIds": [
              "DEU.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia thiap kɛ cäŋdäär ce̱tkɛ min la cɔr ɛ thi̱ep rɛy muɔ̱th, kä ci dupku bi gɔw. Kä jio̱o̱k kɛnɛ mac rɔa bia jek ni ciaaŋ mi, kä thilɛ mi bi ji̱ luäk. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.29",
            "verseOrgIds": [
              "DEU.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi kuɛɛn kɛ ciek, bi tɔ̱ɔ̱c ni radɔ̱diɛn kɛ jɛ. Bi ti̱ec la̱t, kä /ci bi cieŋ thi̱n. Bi pi̱eth kɛ kak, kä /ci bɛlkɛ bi cam. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.30",
            "verseOrgIds": [
              "DEU.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba thääkdu näk nhiamdu, kä /ci riŋdɛ bi cam. Kä ba muulu naŋ ni nhiamdu kɛ buɔ̱m, kä /cɛ bi lony kä ji̱. Kä ba detku ka̱m gua̱n tɛ̈ru, kä thilɛ ram mi bi ji̱ luäk. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.31",
            "verseOrgIds": [
              "DEU.28.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba gaatku ka̱n ni waaŋdu ɛ nɛy kɔ̱kiɛn, kä biɛ go̱ri bikɛ luäk kɛ cäŋ kɛɛliw. Duundɛ ɣöö /ci bi tekɛ buɔ̱m mi bi gaŋ nikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.32",
            "verseOrgIds": [
              "DEU.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi dör kɔ̱kiɛn ti kui̱c yɛn kɛ bɛl muɔ̱ɔ̱ndun tin cia la̱t cam. Ni ciaŋ ba ciɛŋ ni yɛ a jiäk kä ba näk ni yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.33",
            "verseOrgIds": [
              "DEU.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi guec in gui̱ckɛ yɛ jak kä yɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.34",
            "verseOrgIds": [
              "DEU.28.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial yɛ jak kä buɔ̱ɔ̱t mua̱likun kɛnɛ tɛlkun mi /ci bi met gɔaa, känɛ jɛ ni pät cio̱kdu mäni wi̱cdu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.35",
            "verseOrgIds": [
              "DEU.28.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.35",
            "verseOrgIds": [
              "DEU.28.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 28:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bi Kuoth Nhial yɛ naŋ rɛy döri ti kui̱c i̱ kä kui̱c guurikɛ, yɛnɛ kua̱r tin cia kuëny rɔ, ɛn wi̱ni bia wä pal ni kuth kɔ̱kiɛn, kuth päämni kɛnɛ jiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.36",
            "verseOrgIds": [
              "DEU.28.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi cua̱ mi jiääk mi ca̱a̱tkɛ ni ŋɔak, kä yakɛ ɛ nɛy diaal tin bi Kuoth Nhial ji̱ cuac rɛydiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.37",
            "verseOrgIds": [
              "DEU.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi kak pith kɛ bɛl ti ŋuan, kä bi jek ni ti tɔt thi̱n. Kɛ ɣöö ba jɛ cam ɛ kɔryɔm. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.38",
            "verseOrgIds": [
              "DEU.28.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi pi̱eth kɛ ka̱a̱k wal kɛ kui̱ kɔaŋ, /ci kɔaŋdiɛn bi math kä ci dɛykiɛn bi pon. Kɛ ɣöö bi kɔ̱m kɛ cam. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.39",
            "verseOrgIds": [
              "DEU.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi tekɛ jiɛɛn Ɔ-lip ti ŋuan wi̱i̱niku diaal, duundɛ ɣöö /cia rɔ bi yi̱r kɛ liɛɛthdɛ. Kɛ ɣöö bi dɛykɛ pɛn dɔɔr. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.40",
            "verseOrgIds": [
              "DEU.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi dap kɛ dhɔɔl kɛnɛ nyier, duundɛ ɣöö /cikɛ bia̱ gaatku, bi ka pɛ̈ɛ̈c. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.41",
            "verseOrgIds": [
              "DEU.28.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiɛnku kɛnɛ bɛl muɔ̱ɔ̱ndu ba kɛ cam ɛ kɔryɔm. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.42",
            "verseOrgIds": [
              "DEU.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi juɔ̱r in te rɛydun ben nhial wi̱i̱dun. Kä bia loc ni piny. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.43",
            "verseOrgIds": [
              "DEU.28.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 28:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ yɛ moc kɛ ŋua̱l, kä /cia bi ŋuälikä. Ba böök kä bi yɛn ɛ jɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.44",
            "verseOrgIds": [
              "DEU.28.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 28:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn kueth ti diaal ɛ ti ba ji̱ guɔ̱ɔ̱r amäni mi cia duɔ̱p. Kɛ ɣöö /ka̱nɛ jɔw Kuɔth Nhial Kuothdun luɔ̱th, /ka̱nɛ ŋuɔ̱tkɛ tëë cɛ la̱r yɛ tit. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.45",
            "verseOrgIds": [
              "DEU.28.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 28:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikɛ te wi̱i̱dun ala nyuuth kä ga̱ykɛ naath, bikɛ te kä kuaykun bä mäni cäŋ kɛl.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.46",
            "verseOrgIds": [
              "DEU.28.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 28:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.46",
            "verseOrgIds": [
              "DEU.28.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 28:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ ɣöö /ken yɛn Kuoth Nhial Kuothdun pal kɛ lɔc mi gɔaa mi tɛth, kɛ kui̱ kä ti diaal, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.47",
            "verseOrgIds": [
              "DEU.28.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DEU 28:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ kui̱ ɛmɔ, bia lät ni ji̱ tɛ̈runikä tin bi Kuoth Nhial kɛ nöŋ yɛ. Rɛy buath kɛnɛ rɛw kɛ görkä ti diaal. Kä bɛ moc riɛk mi di̱i̱t, amäni cia li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.48",
            "verseOrgIds": [
              "DEU.28.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 28:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial yɛ nöŋ dör ni guäth mi na̱n, ni peek ɣɔaa, ce̱tkɛ cuɔr mi wur, dör mi /cia thokdiɛn ŋäc. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.49",
            "verseOrgIds": [
              "DEU.28.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 28:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dör mi jiääk, mi ci die̱e̱th luth kä /ci gat pälikä. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.50",
            "verseOrgIds": [
              "DEU.28.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 28:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba dɛy ɣɔ̱ɔ̱kun cam kɛnɛ bɛlkun, amäni mi cia duɔ̱p. Thilɛ beel kiɛ kɔaŋ kiɛ liɛɛth mi ba ba̱ny yɛ, cäŋɛ dɔw yaaŋ kiɛ dɛl, amäni mi cia tɛ̈ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.51",
            "verseOrgIds": [
              "DEU.28.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 28:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba wi̱i̱kun diaal göl, mäni mi ci pa̱nynikun, tin buɔ̱m buɔ̱ɔ̱m tin ŋa̱thɛ tɛɛth, wi̱i̱nikun diaal muun in ci Kuoth Nhial ɛ ka̱m yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.52",
            "verseOrgIds": [
              "DEU.28.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "DEU 28:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bia cam ni riŋ gankun, tin ci Kuoth Nhial Kuothdun kɛ ka̱m yɛ, rɛy rikä gölä wecdun in ca rik ni yɛ ɛ gua̱n tɛ̈run. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.53",
            "verseOrgIds": [
              "DEU.28.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "DEU 28:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cäŋɛ wut pa̱nydun bɛ mi̱eth pen däman kɛnɛ ciek in nhɔkɛ, amäni gaatkɛ tin ci duɔth kɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.54",
            "verseOrgIds": [
              "DEU.28.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "DEU 28:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ ram kɛl mi bɛ moc kä kɛ kɛ ri̱ŋ gankɛ min camɛ, kɛ ɣöö thilɛ mi bɛ päl, kɛ riɛk kɛnɛ göl in ba göl ni wi̱i̱kun diaal ɛ ji̱ tɛ̈run. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.55",
            "verseOrgIds": [
              "DEU.28.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "DEU 28:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ciek in gɔaa in kɔc lɔc rɛydun, min cäŋɛ ni milɛ mi̱eth /kenɛ jɛ met tɔ̱w kɛ gɔɔydɛ, bɛ cɔwdɛ min nhɔkɛ kɛnɛ gatdɛ kɛ nyaadɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.56",
            "verseOrgIds": [
              "DEU.28.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "DEU 28:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "bi nyuɔth lapdɛ min bä raar kam ciöknikɛ kɛ gaatkɛ, kɛ ɣöö bɛ kɛ cam kɛ tɛ̱̈ɛ̱̈, kɛ ɣöö ba ti diaal go̱r rɛy rikä gölä wec in ba göl wi̱i̱kun ɛ ji̱ tɛ̈run.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.57",
            "verseOrgIds": [
              "DEU.28.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "DEU 28:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.57",
            "verseOrgIds": [
              "DEU.28.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "DEU 28:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wee wä tey a /ci rieet ŋuɔ̱tdä ti̱ti̱ lät agɔaa, ti cä gɔ̱a̱r rɛy buɔk ɛ mi ti, kɛ ɣöö bi dual kɛ ciöt agɔaa ɛmɛ ciöt ni Kuoth Nhial Kuothdu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.58",
            "verseOrgIds": [
              "DEU.28.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "DEU 28:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "bi Kuoth Nhial ji̱ yɛn karku moc kɛ rik ti te wa̱nɔ kɛnɛ jua̱th ti ci bi thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.59",
            "verseOrgIds": [
              "DEU.28.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "DEU 28:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ yɛ nöŋ jua̱th I-jëp diaal, tëë dualɛ kɛ kɛ. Bikɛ dɔp puɔ̱nydun. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.60",
            "verseOrgIds": [
              "DEU.28.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "DEU 28:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jua̱th diaal kɛnɛ rik tin /ka̱n gɔ̱r ɛn rɛy buɔk ŋuɔ̱tni ɛmɛ, bi Kuoth Nhial kɛ nöŋ yɛ, mäni mi cia duɔ̱p. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.61",
            "verseOrgIds": [
              "DEU.28.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "DEU 28:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikɛ mëë ce̱t yɛn kɛ kuɛl nhial kɛ ŋuan, bi duɔth ni ti tɔt kä yɛ. Kɛ ɣöö /ka̱nɛ jɔw Kuoth Nhial Kuothdun luɔ̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.62",
            "verseOrgIds": [
              "DEU.28.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "DEU 28:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱tkɛ mëë tɛth lɔc Kuɔth Nhial kɛ yɛ, lätdɛ yɛ kä gɔy kä cɛ yɛ jak kä ŋuan, bi lɔcdɛ lɛni tɛɛth kɛ nöŋdun riɛk mi bi yɛ dup. Bia thil kuay muun in wä yɛn cieŋ thi̱nɔ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.63",
            "verseOrgIds": [
              "DEU.28.63"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "DEU 28:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.63",
            "verseOrgIds": [
              "DEU.28.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "DEU 28:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bi Kuoth Nhial yɛ däkä rɛy nath pëkni ɣɔaa. Bia wä pal ni kuth ti kɔ̱kiɛn, kuth jiɛɛn kɛnɛ pääm tin kui̱c yɛn kɛ kiɛ guurikun. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.64",
            "verseOrgIds": [
              "DEU.28.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "DEU 28:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ci lɔcdun bi gɔaa ɛn rɛy döri tɔ̱tɔ̱, kä ci ciökun bi lɔ̱ɔ̱ŋ duundɛ ɣöö bi Kuoth Nhial yɛ moc kɛ dual lɔaac kɛnɛ nyuɔn wec kɛ guec waŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.65",
            "verseOrgIds": [
              "DEU.28.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "DEU 28:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi tëkdu bɛ̈c. Bi dual kɛ wäär kɛnɛ cäŋ däär, kä ci tëkdu bi ŋa̱c agɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.66",
            "verseOrgIds": [
              "DEU.28.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "DEU 28:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ runwaŋ bi wee, ‘Ɛn duɔ̱ɔ̱r ɛ thiaŋ inu!’ kä kɛ thiaŋ bi wee, ‘Ɛn duɔ̱ɔ̱r ɛ runwaŋ inu!’ kɛ dual in bi dual kɛ ji̱, kɛnɛ nën in bi nën kɛ ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.67",
            "verseOrgIds": [
              "DEU.28.67"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "DEU 28:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ babuuri bi Kuoth Nhial ji̱ luɔc kä I-jëp, kɛ duɔ̱p ëë cä la̱r yɛ i̱ /cia rɔ bi nyɔk kɛ ja̱l kɛ jɛ. Kä bia rɔ kök ji̱ tɛ̈run ala kuaany wutni kɛnɛ män duundɛ ɣöö thilɛ ram mi bi yɛ kɔk.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.28.68",
            "verseOrgIds": [
              "DEU.28.68"
            ]
          }
        }
      ]
    }
  ],
