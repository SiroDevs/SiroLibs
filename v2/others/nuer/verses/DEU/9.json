            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.21",
            "verseOrgIds": [
              "DEU.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cu yɛn Kuoth Nhial lɔcdɛ lɛni jak kä jiäk bä kä Tab-e-raa kɛnɛ Mathaa kɛ Kib-rot-ɣata-waa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Kuoth Nhial yɛ ja̱k kä Ka-dɛc-bar-ni-ya i̱, ‘Wiaa cieŋɛ muun in cä ka̱m yɛ,’ /ka̱nɛ ruac Kuoth Nhial Kuɔthdun lo̱k, /cuarɛ rɔ ri̱t ŋuɔ̱tnikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "La yɛn Kuoth Nhial a lo̱k nikɛ cäŋ ëë ŋa̱cä ni yɛ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɣän cua pal kɛ ni̱n ti jiɛɛn da̱ŋ ŋuaan nhiam Kuɔth Nhial, kɛ ɣöö cɛ lar i̱ bɛ yɛ däk. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua̱ Kuoth Nhial pal i̱, ‘Aɣ Kuoth Nhial cu nɛɛku däk, nɛɛku tëë kääni kɛ buɔ̱mdu, tëë kämi raar kä I-jëp kɛ bumdu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tim kuanydu ni A-bɛ-ram kɛnɛ Ay-dhɛk kɛ Je-kɔb. Cu buɔ̱m wi̱c nɛɛni ti̱ti̱ kɛnɛ kɔ̱a̱cdiɛn kɛ dueerkiɛn car, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.27",
            "verseOrgIds": [
              "DEU.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö ci nɛy tëë nööŋi kɔ rɛydiɛn ɛ bi lar i̱, “/Ci Kuoth Nhial kɛ luäŋ kɛ mi bɛ kɛ naŋ muun ëë cɛ guɔ̱k kɛ, kɛnɛ ɣöö lökɛ kɛ, ɛ jɛn cɛ kɛ naŋ raar ɔ kɛ ɣöö bɛ kɛ wä näk däär dɔaar.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ nɛɛku ti la nyinku, tëë nööŋi raar kɛ buɔ̱mdu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.29",
            "verseOrgIds": [
              "DEU.9.29"
            ]
          }
        }
      ]
    }
