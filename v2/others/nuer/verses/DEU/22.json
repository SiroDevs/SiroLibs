          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "bi wut ɛmɔ gua̱n nyaal moc kɛ yio̱w ti jiɛɛn dhieec, bɛ cua̱ ciekdɛ, kɛ ɣöö cɛ jɛ mac /cɛ jɛ bi däk, bikɛ te kɛɛl kɛ pek teekädɛ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
