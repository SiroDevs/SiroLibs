              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi ci wut röm kɛnɛ nya mi /ka̱n kuɛn, kä cɛ tɔ̱ɔ̱c kɛ jɛ, kä ca kɛ jëk thi̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
