        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäŋ bälä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tit cäŋ bälä Kuɔth Nhial Kuothdu kɛ pay in cɔal i̱ duɔ̱ɔ̱ŋ. Kɛn pay ɛmɔ cu Kuoth Nhial Kuothdun yɛ nööŋ raar thi̱n muun I-jëp kɛ wäär. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bia Kuoth Nhial Kuothdun thöp muc bälä rɛy ɣɔ̱ɔ̱kun kɛnɛ rɛy deetkun guäth in cɛ mɛk i̱ ba pal thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä biɛ cam kɛ juray mi thil thuɔp kɛ ni̱n bärɔw, Juray rikä kɛ ɣöö bä ji̱n raar muun I-jëp kɛ duɔ̱p mi pɛ̈th. Kɛ ɣöö bi cäŋ ëë bäkɛ ji̱ raar muun I-jëp tim kɛ ni̱n teekädu diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ thuɔp mi ba nɛn rɛy wi̱i̱nikun diaal kɛ ni̱n bärɔw. Kä thilɛ riŋ mi bi baak piny kä ri̱ŋ mucni tin thöpɛ kɛ thiaŋ kɛ cäŋ in jio̱liɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thilɛ muc bälä mi bia thöp rɛy wi̱i̱nikun tin ci Kuoth Nhial Kuothdun kɛ ka̱m yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi jɛ thöp ɛn muc bälä guäth in bi Kuoth Nhial Kuothdu jɛ mɛk i̱ ba pal thi̱n, bi jɛ thöp kɛ thiaŋ konyä ca̱ŋ, kɛ gua̱a̱th ëë bäkɛ yɛ raar rööl I-jëp. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bia thal kä bia cam guäth in bi Kuoth Nhial Kuothdun ɛ mɛk ɔ. Kä bakädɛ bia cu loc ciëëŋnikun. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia mi̱eth mi thil thuɔp cam kɛ ni̱n bäkɛl. Kɛ bärɔwdiɛn ba duɔl Kuoth Nhial Kuothdun, /cia bi lät ɛn cäŋ ɔ.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäŋ ŋarä ŋër",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuɛnɛ juɔkni bärɔw nikɛ tuk ŋër bɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kua ŋar kɛ cäŋ ti̱mä jokä Kuɔth Nhial Kuothdun kɛ tho̱pdun kɛ jɛ muc tɛthä lɔacdun in lua̱ŋɛ, ce̱tkɛ min ci Kuoth Nhial Kuothdun ɛ puɔ̱th yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi lɔcdun cu tɛɛth nhiam Kuɔth Nhial Kuothdun. Yɛn kɛ gaatkun, nikɛ kuaany wutnikun, kɛnɛ kuaany määnkun, kɛ raan ji̱ Lii-bay ɛ te wi̱i̱dun ɔ, kɛ jur kɛnɛ gaat tin thil gua̱ni, kɛ män jɔɔkni tin te rɛydun, guäth in ci Kuoth Nhial ɛ mɛk i̱ ba pal thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tiɛm ɛ jɛ ɛn ɣöö ci yɛn kɔn ɛ kuaany muun I-jëp. Bia ŋuɔ̱t ɛ ti dhil ŋa̱c agɔaa.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäŋ ŋarä luaak Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŋarɛ kɛ cäŋ ti̱mä luaak Kuɔth kɛ ni̱n bärɔw, gua̱a̱th in cia thuɔ̱k kɛ kɔ̱a̱m bɛɛlkun kɛnɛ dhi̱em kɔaaŋnikun. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi lɔcdu tɛɛth ŋarädu, yɛnɛ gaatku, kɛ kuany wutdädu kɛnɛ kuany ciekdu, kɛ raan ji̱ Lii-bay kɛnɛ juɔ̱r, kɛ gaat tin thil gua̱ni kɛ män jɔɔkni tin te wi̱i̱dun. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia ŋar kɛ ni̱n bärɔw tiɛmɛ Kuoth Nhial Kuothdun guäth in bɛ mɛk. Kä bɛ ji̱ poth kɛ nyinku diaal, kɛnɛ tin diaal tin ci la̱t kɛ tetdu. Kä bi lɔcdun cu tɛɛth kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä diɔ̱ɔ̱k kɛ ruɔ̱n, bi tutkun diaal Kuɔth Nhial Kuothdun ben pal guäth in cɛ mɛk. Kɛ ŋar mi̱eth in thil thuɔp, kɛnɛ ŋar jokä, kɛ ŋar luaak Kuɔth kä /cikɛ bi ben nhiam Kuɔth Nhial kɛ tetkiɛn baaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi ram ɔ min luäŋɛ thöp, ce̱tkɛ puɔ̱th in ca ka̱m jɛ ɛ Kuoth Nhial Kuothdun.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciaaŋ lätni cuŋni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuanyɛ kua̱r wi̱i̱nikun diaal tin ci Kuoth Nhial Kuothdun kɛ ka̱m yɛ, nikɛ thuk duëlikun. Kɛ ɣöö bikɛ naath luk kɛ luk mi cuŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.18",
            "verseOrgIds": [
              "DEU.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu luk gɔ̱ŋ. Kä cu guic ni wäŋ nath. Kä cu kök nhɔk, kɛ ɣöö kök la yärɛ naath la thuɔ̱k ɛ bathɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.19",
            "verseOrgIds": [
              "DEU.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thuɔ̱k, ala thuɔ̱k, kɛ ɣöö dɔ̱ŋ bi tëk a bi mun in ci Kuoth Nhial Kuothdu jɛ ka̱m ji̱ wä ka̱n.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.20",
            "verseOrgIds": [
              "DEU.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä /cu jiath pith mi bia̱ riäk Kuɔth gekä yi̱kä Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.21",
            "verseOrgIds": [
              "DEU.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu yi̱k mi lo̱k Kuoth Nhial Kuothdu jɛ cuŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.22",
            "verseOrgIds": [
              "DEU.16.22"
            ]
          }
        }
      ]
    }
  ],
