              "DEU.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ rieet diɛɛt ɛ mi la̱t duɔl ji̱ I-thɛ-rɛl diaal, mäni mëë cɛ kɛ thuk.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
            "verseOrgIds": [
              "DEU.31.30"
            ]
          }
        }
      ]
