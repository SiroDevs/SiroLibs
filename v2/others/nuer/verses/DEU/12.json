          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä tin diaal tin cä la̱t yɛ tiɛtdɛ la̱tdiɛn, /cuarɛ kɛ rep kɛ duɔ̱ɔ̱r kä /cuarɛ duɔ̱ɔ̱r käm raar thi̱n.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.32",
            "verseOrgIds": [
              "DEU.12.32"
            ]
          }
        }
