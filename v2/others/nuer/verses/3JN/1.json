  "reference": "3 Jɔ̱Ɔ̱N 1",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
