        {
          "text": "Nɛmɛ ɛ nyuuth I-ca-yaa gat A-modh mëë cɛ nɛn kɛ kui̱ Juda kɛnɛ Jɛ-ru-tha-lɛm kɛ gua̱th tëë ruec ni Ö-dhi-ya kɛnɛ Yo-tham kɛ A-ɣadh kɛnɛ Ɣidh-ki-yaa kua̱r Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.1",
            "verseOrgIds": [
              "ISA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dueer Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Go̱r Kuɔth Nhial kɛ luäk nɛɛnikɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Duäc kɛnɛ ka̱n",
