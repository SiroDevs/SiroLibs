            "number": "13",
            "style": "v",
            "sid": "ISA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guic mun ji̱ Kɛ̈l-da-ya! Kɛn nɛy tɔ̱tɔ̱ /cikɛ thil. Ci ji̱ A-thi-ri-ya ɛ jak kä gua̱a̱th leeyni dɔaar. Cikɛ jɛ lät kä biɛɛni ti gölkɛ ni jɛ, kä cikɛ buɔ̱mdɛ da̱k piny, ca jɛ jak kä mi ci da̱k.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.14",
            "verseOrgIds": [
              "ISA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɔ ba Dhor pa̱l ruëëc kɛ run ti jiɛn bärɔw, ce̱tnikɛ run teekä kua̱r. Kä kɛ thuɔ̱k runi ti jiɛn bärɔw, ɛn Dhor bɛ ce̱tnikɛ riär mi kɛ̈tkɛ kɛ dit i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k runi ti jiɛn bärɔw, bi Kuoth Nhial Dhor gui̱l, kä bɛ loc ko̱kädɛ ce̱tnikɛ riär, kä bɛ kök la̱t kɛ kuääri wec muɔ̱ɔ̱n diaal rɛy ɣɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ba tin cɛ jek ko̱kä kɛnɛ nyinkɛ lëy Kuoth Nhial, /cakɛ bi tɔ̱w kiɛ dol, duundɛ ɣöö bi nɛy tin palkɛ Kuoth Nhial tin cɛ jek kɔk ni mi̱eth mi di̱i̱t kɛnɛ bieyni tin gɔw.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        }
      ]
    }
