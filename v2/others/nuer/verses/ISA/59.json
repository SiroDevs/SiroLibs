      "items": [
        {
          "text": "Lo̱k go̱kä kɛ dueer nath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lat nath kɛ dueerkiɛn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rial Kuoth Nhial rɔ ikä kɛ luäk nɛɛnikɛ",
          "type": "text"
        }
      ]
    },
