          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ bi Kuoth Nhial Lɔw Yiëër in di̱i̱t in dual naath kɛ jɛ näk kɛ thɛpdɛ min bumbum in di̱i̱t, ɛn Lɔw in thac ni rɔ, kä bɛ Nyaŋ Yiëër in di̱i̱t näk bä.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.11",
            "verseOrgIds": [
              "ISA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ bi Kuoth Nhial ji̱ I-thɛ-rɛl ma̱a̱t kɛ̈l kɛ̈ɛ̈li ni Kiir Yu-pɛ-ree-tidh amäni rɛy Tuɔɔc I-jëp ce̱tnikɛ min la bɛl a kɔ̱a̱mkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.12",
            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn cäŋ ɛmɔ ba kaaŋ mi di̱i̱t koth, kɛ ɣöö bi nɛy tin ci bath muun A-thi-ri-ya kɛnɛ tin ca naŋ muun I-jëp ben, ba Kuoth Nhial ben pal pääm in rɛl gɔɔydɛ rɔ kä Jɛ-ru-tha-lɛm.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.13",
            "verseOrgIds": [
              "ISA.27.13"
            ]
          }
        }
      ]
    }
