    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luny nath jɔk pecä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Kuoth Nhial tekɛ kɔ̱a̱c lɔaac kɛ Je-kɔb kä bɛ I-thɛ-rɛl nyɔk kɛ mëk kä bɛ kɛ jäkä muundiɛn. Kä bi jur rɔ̱ ma̱tkɛ, bikɛ cieŋ kɛɛl kɛ dhɔr Je-kɔb. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.1",
            "verseOrgIds": [
              "ISA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi döör kɛ luɔc muundiɛn, kä bi ji̱ I-thɛ-rɛl kɛ jak kä kuaany, wutni kɛnɛ män muun Kuɔth Nhial. Bikɛ nɛy tëë pɛɛckɛ jak kä pɛ̈ɛ̈c, kä bikɛ nɛy tëë ciaŋkɛ kɛ a jiäk ruac.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pɛ̈ɛ̈n kua̱r Bɛ̈-bi-lɔn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ in bi Kuoth Nhial yɛ moc kɛ lɔ̱a̱ŋ rɛy riknikun kɛnɛ cuɔ̱cdun kɛ la̱t ëë jiääk ëë ca yɛ jak kä kuaany, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bi yɛn dit ɛmɛ kɛt ni kuäär Bɛ̈-bi-lɔn wä yɛn i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.21",
            "verseOrgIds": [
              "ISA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial in la Ruey Ɣɔaa wee i̱, “Ɣän bä kɛ̈k Bɛ̈-bi-lɔn woc kɛnɛ nɛy tin ŋot kɛ tëk kɛ gaatkɛ kɛnɛ kuaykɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä jɛ jak kä gua̱a̱th muɔ̱lguɔ̱ɔ̱c kä pul pi̱i̱ni, kä bä jɛ yiɛc kɛ yi̱ec däkä, ruac ni ɣän Kuoth Nhial in la Ruey Ɣɔaa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac go̱o̱kä mi jiääk kɛ kui̱ A-thi-ri-ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac go̱o̱kä mi jiääk kɛ kui̱ Pi-li-thɛt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.27",
            "verseOrgIds": [
              "ISA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ruɔ̱n ëë li̱w kɛ kuäär ni A-ɣadh, cu ruac go̱o̱kä nɛmɛ ben wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.28",
            "verseOrgIds": [
              "ISA.14.28"
            ]
          }
        }
      ]
    }
