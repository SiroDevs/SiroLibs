          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ ci Kuoth Nhial nɛmɛ lar kɛ kui̱ kua̱r A-thi-ri-ya i̱, “/Cɛ bi ben ɛn wi̱c ɛmɛ, kiɛ /cɛ bäär bi yuɔr ɛn wa̱nɛ, kä /cɛ bi rët kɛ nhiamdɛ kɛ ko̱t, kä /cɛ bi go̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.33",
            "verseOrgIds": [
              "ISA.37.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ duɔ̱ɔ̱p ëë bäkɛ jɛ, ɛ jɛn bi loc kɛ jɛ jɔk ɔ, kä /cɛ bi ben ɛn wi̱c ɛmɛ, ruac ni Kuoth Nhial inɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.34",
            "verseOrgIds": [
              "ISA.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ISA 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ɣöö ɣän bä wec ɛmɛ gaŋ, kä bä jɛ kän kɛ kui̱dä kɛnɛ kui̱ jäŋädä ni Dee-bid.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.35",
            "verseOrgIds": [
              "ISA.37.35"
            ]
          }
        }
      ]
