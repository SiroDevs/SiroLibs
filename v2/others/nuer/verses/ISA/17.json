              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ ruac go̱o̱kä, kɛ kui̱ Da-math-kɛth i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
