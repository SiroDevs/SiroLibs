          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ bi naath guic ni Cääkdiɛn, bikɛ guic ni Kuoth I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ca bi guic ni yi̱kni, tin lät kɛn kɛ kɛ tetkiɛn, kä /ca mi ca la̱t kɛ tetkiɛn ce̱tkɛ Ä-ce-rim kiɛ yi̱kni tin waŋkɛ wal tin kuɔ̱r kuɔ̱ɔ̱r thi̱n bi guic.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
