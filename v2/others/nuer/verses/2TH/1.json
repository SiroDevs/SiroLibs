              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ ɣän Puɔl kɔnɛ Thil-ba-näth kɛ Ti-mo-thi gɔ̱a̱rkɔ mɛmɛ yɛ yɛn ji̱ duëël Kuɔth tin te kä Thɛ-tha-lo-ni-ka rɛy Kuɔth in la Gua̱a̱ra kɛnɛ Kuäär ni Yecu Kritho.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        }
      ]
    },
