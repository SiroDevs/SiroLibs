        "style": "s1"
      },
      "items": [
        {
          "text": "Këët din luaak Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid kɛnɛ bööth lätni tha̱a̱ŋ gan A-thap kɛnɛ Ɣe-man kɛ Yɛ-du-thun kuany kɛ ɣöö bikɛ la̱t palä böth kɛ thuɔmni. Kä nɛy tëë cu la̱t ɛmɔ la̱t ciöötkiɛn tin,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn nɛy ti̱ti̱ diaal cua kɛ böth ɛ gua̱ndiɛn puɔ̱t thuɔm rɛy luaak Kuɔth Nhial, lätdä palä luaak Kuɔth. Kä cu A-thap kɛnɛ Yɛ-du-thun kɛ ɣe-man la̱t ni ruac kua̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu pekdiɛn amäni ji̱ maarädiɛn tin ca ŋi̱eec kɛ lät din puɔnyä Kuɔth Nhial, tin tekɛ ŋäc a nɛy ti kur rɛw wi̱cdɛ jiɛɛn bädäk wi̱cdɛ bädäk matdiɛn diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋuɛ̈tni kɛ di̱t kɛ kua̱r ŋi̱i̱cä kɛ dho̱li gɔ̱rä kɛn diaal kɛɛl, cua kɛ yuɔr gaakni kɛ kui̱ lätnikiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
      ]
    }
