          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thok duëël Lii-bay kɛnɛ lätkɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Dee-bid a wut mi ci dɔŋ, cuɛ gatdɛ ni Thɔ-lo-mon jak kä kuäär I-thɛ-rɛl.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.1",
            "verseOrgIds": [
              "1CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Dee-bid bööth I-thɛ-rɛl diaal kɛnɛ bööth palä kɛ ji̱ Lii-bay mat. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.2",
            "verseOrgIds": [
              "1CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ji̱ Lii-bay tin tekɛ run ti jiɛn diɔ̱k a wä nhial kuɛn, kä cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛn diɔ̱k wi̱cdɛ bädäk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.3",
            "verseOrgIds": [
              "1CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wee “Bi nɛy ti bathdɔɔri, ti jiɛn da̱ŋ rɛw wi̱cdɛ ŋuaan la̱t luaak Kuɔth la̱t, kä bi nɛy ti bathdɔɔri bäkɛl a kua̱r kɛnɛ ruëëc. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.4",
            "verseOrgIds": [
              "1CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi nɛy ti bathdɔɔri ŋuaan a ga̱a̱ŋ thuɔk luaak, kä bi bathdɔɔri tin kɔ̱ŋ Kuoth Nhial puany kɛ thuɔmni tëë ca la̱t kɛ kui̱ puɔnyä.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.5",
            "verseOrgIds": [
              "1CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid ji̱ Lii-bay dääk kɛ bun diɔ̱k, ce̱tnikɛ dho̱rkiɛn, Ger-com, kɛ Kɛ-ɣath kɛ Mɛ-ra-ri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.6",
            "verseOrgIds": [
              "1CH.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ji̱ Ger-com",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ji̱ Kɛ-ɣath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaat Mɛ-ra-ri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kɛn ti̱ti̱ a gaat Lii-bay kɛ thuk duëli gua̱ni, tëë la bööth dööri ce̱tnikɛ ciöötkiɛn te ca gɔ̱r gööli, a känɛ ni kä run ti jiɛn da̱ŋ rɛw a wä nhial ti lua̱ŋkɛ la̱t rɛy luaak Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid wee “Kuoth Nhial min la Kuoth I-thɛ-rɛl cɛ nɛɛkɛ ka̱m mal. Kä bɛ cieŋ kä Jɛ-ru-tha-lɛm amäni cäŋ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.25",
            "verseOrgIds": [
              "1CH.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ci ji̱ Lii-bay kɛmɛkä ro̱mä kɛ Kuoth Nhial bilɛ kap kiɛ tin la pal kɛ jɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kɛ ɣöö riet Dee-bid in jɔak ɛ pek ji̱ Lii-bay a känɛ nikä run ti jiɛn da̱ŋ rɛw a wä nhial.) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
              "1CH.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö bi la̱tdiɛn a luäk gan Ä-ron kɛ la̱t rɛy luaak Kuɔth Nhial. Bikɛ tit ni rɛy kal luaak kɛnɛ duel rɛy luaak kɛ la̱k kä tin diaal tin rɛ̈l kɛ rɔ. Kɛ lät tin kɔ̱ŋ rɛy luaak Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bikɛ luäk bäkɛ la̱t jurayä wec tharbëtkä kɛ nup kɛ kui̱ mucä kɔaŋ, kɛ juray mi thil thuɔp, kɛ mi ca lia̱a̱p kɛ liɛɛth, kɛ theemni diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bikɛ Kuoth Nhial a palkɛ kä puanykɛ jɛ ni ciaŋ kɛ runwaŋ kɛnɛ thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛnɛ mi thöpkɛ muc tin wa̱ŋkɛ Kuoth Nhial kɛ cäŋ lɔ̱ŋä kɛnɛ cäŋ ŋarä tëth path kɛ ni̱n ŋarä tin ca mɛk. Bikɛ lät nhiam Kuɔth Nhial a thil lɔ̱a̱ŋ nikɛ pek in görkɛ kä kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu ji̱ Lii-bay lät rɛy kɛmɛkä ro̱mä kɛ Kuoth Nhial kɛ gua̱th in rɛl gɔɔydɛ rɔ lua̱kɛ gaatmanikiɛn ni gaat Ä-ron kɛ lät luaak Kuɔth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
    }
  ],
