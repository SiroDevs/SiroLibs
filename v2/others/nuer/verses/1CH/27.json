          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ya-dhidh raan wec Ɣɛ̈g-ri a ti̱i̱t deet.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ti̱ti̱ diaal cu ka bööth ti̱eet kuakni kua̱r ni Dee-bid.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luëëk Dee-bid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.31",
            "verseOrgIds": [
              "1CH.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Jo-na-than gua̱nlen kua̱r ni Dee-bid a lueek mi tëë ŋäc ŋɔaani mi di̱t. Kä cu Yɛ-ɣe-li gat Ɣak-mo-ni gaat kua̱r tit. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ä-ɣi-tho-pɛl a lueek kua̱r. Kä cu Ɣu-cay raan wec A-rɛk a määth kua̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua Ä-ɣi-tho-pɛl gua̱a̱thdɛ guäl ɛ Yɛ-ɣo-ya-da gat Bɛ-na-yaa kɛnɛ Ɛb-ya-thar. Kä cu Yo-ab a bo̱o̱th rɛ̈m kua̱r.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
    }
