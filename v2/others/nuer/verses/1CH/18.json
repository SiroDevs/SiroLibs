        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rëp kuäärä Dee-bid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä nɛmɛ cu Dee-bid ji̱ Pi-li-thɛt joc, kä cuɛ kɛ jak kä kuaany, kä cuɛ Gɛ̈th luɔ̱c jɔk kä kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ji̱ Mo-ab joc bä, kä cu ji̱ Mo-ab a kuaany Dee-bid ti luɔ̱nykɛ jɛ tho̱lbo̱k.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.2",
            "verseOrgIds": [
              "1CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid Ɣä-dɛ̈d-ɛdhɛr kuäär Dho-baa lɛni juɔc, kui̱ rööl Ä-math, mëë ɛ jɛn i̱ ruaacɛ kir Yu-pɛ-ree-tidh. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.3",
            "verseOrgIds": [
              "1CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid thurbiɛɛli ti bathdɔɔr kɛl kɛnɛ ji̱ jiöŋkööri ti bathdɔɔri bärɔw kɛ nɛy ti bathdɔɔri ti jiɛn da̱ŋ rɛw käp kä jɛ. Kä cuɛ jiöŋkööri diaal dɔ̱a̱ŋkiɛn ŋuɔ̱k, cuɛ päl ni jiöŋkööri ti ro̱ŋ kɛ thurbiɛɛli ti kuɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.4",
            "verseOrgIds": [
              "1CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci ji̱ Thi-ri-ya tëë cieŋ kä Da-math-kɛth ben, ba Ɣä-dɛ̈d-ɛdhɛr kuäär Dho-baa ben luäk, cu Dee-bid kɛ näk nɛy ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.5",
            "verseOrgIds": [
              "1CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid wec Da-math-kɛth moc kɛ rɛm",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:6",
              "type": "text"
            },
            {
              "text": "Rɛm",
              "type": "text"
            },
            {
              "text": "kä thok Ɣi-bɛ-ru thilɛ jɛ thi̱n, mat kɛ ni jɛ thi̱n kɛ tët.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Kä cu ji̱ Thi-ri-ya a kuaanykɛ ti luɔ̱ny kɛ jɛ tho̱lbo̱k. Kä cu Kuoth Nhial jɛ ka̱m buɔ̱m mi joocɛ naath gua̱thni diaal tin cɛ wä thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.6",
            "verseOrgIds": [
              "1CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ köötni dääpä tin jäl kɛ nɛɛ Ɣä-dɛ̈d-ɛdhɛr käp, kä cuɛ kɛ nööŋ kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.7",
            "verseOrgIds": [
              "1CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ yiëëth in yian mi di̱i̱t ka̱n rɛɛk kä Tib-ɣat kɛnɛ Kun, wi̱i̱ Ɣä-dɛ̈d-ɛdhɛr. Mëë cu Thɔ-lo-mon jɛ lät dhaar pi̱i̱ni kɛnɛ wääthni kɛ kuak rɛy luaak Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.8",
            "verseOrgIds": [
              "1CH.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Tu kuäär Ä-math ɛ liŋ ɛn ɣöö ci Dee-bid rɛm Ɣä-dɛ̈d-ɛdhɛr joc kɛɛliw, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.9",
            "verseOrgIds": [
              "1CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "cuɛ gatdɛ ni Ä-do-ram jäk kä kuäär ni Dee-bid, kɛ ɣöö bɛ jɛ wä lät kä malɛ, kɛ ɣöö cɛ nyiëëny kɛ Ɣä-dɛ̈d-ɛdhɛr kä cɛ jɛ joc. Kɛ ɣöö cikɛ kɔŋ nyiëëny kɛ Ɣä-dɛ̈d-ɛdhɛr. Kä cuɛ Dee-bid jäk kä da̱a̱p kɛ ciɛk in bo̱r kɛnɛ ciɛk in yian. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.10",
            "verseOrgIds": [
              "1CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn tɔ̱tɔ̱ cu kuäär ni Dee-bid kɛ lëy Kuoth Nhial, kɛɛl kɛ ciɛk in bo̱r kɛ da̱a̱p tëë no̱o̱ŋɛ kä nɛy diaal tëë cɛ joc. Ce̱tkɛ ji̱ Ɛ-dɔm kɛ ji̱ Mo-ab kɛnɛ ji̱ A-mon kɛ ji̱ Pi-li-thɛt kɛnɛ ji̱ Ä-ma-lek.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.11",
            "verseOrgIds": [
              "1CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ä-bi-cay gat Dhɛ-ru-yaa nɛy ti bathdɔɔri wäl bädäk näk kä ji̱ Ɛ-dɔm rɛy Lo̱o̱lä Milɛkä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ rɛm la̱th kä Ɛ-dɔm. Kä cu ji̱ Ɛ-dɔm diaal a kuaany Dee-bid. Kä cu Kuoth Nhial ɛ ka̱m juc nath gua̱thni diaal tin cɛ wä thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ji̱ kɔaar Dee-bid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu Dee-bid I-thɛ-rɛl ruac kɛɛliw. Kä cuɛ nɛɛkɛ diaal ruac agɔaa, kä cuɛ kɛ ciɛŋ a päär. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ab gat Dhɛ-ru-yaa te wi̱i̱ rɛ̈m. Kä cu Yo-ca-pat gat Ä-ɣi-lud a bulkamiin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dha-dok gat Ä-ɣi-tub kɛnɛ Ä-ɣi-mɛ-lɛk gat Ɛb-ya-thar a bööth palä. Kä cu Thɛ-ra-yaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:16",
              "type": "text"
            },
            {
              "text": "Thɛ-ra-yaa",
              "type": "text"
            },
            {
              "text": "kä bok 2 Tham kä 8:17 kɛ thok Ɣi-bɛ-ru cɔal kɛ jɛ i̱ Cab-ca.",
              "type": "text"
            }
          ]
        },
        {
          "text": " a bolith. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bɛ-na-yaa gat Yɛ-ɣo-ya-da te wi̱i̱ ji̱ Kɛ-reth kɛnɛ ji̱ Pɛ-lɛth. Kä cu gaat Dee-bid a bööth lätni kɔar kua̱r.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
    }
  ],
