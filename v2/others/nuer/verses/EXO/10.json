    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Muthɛ cu jiök i̱, “Wër ni kä Pɛro, kɛ ɣöö cä lɔcdɛ kɛnɛ lɔc ji̱ kɔaarɛ jak kä bum, kɛ kui̱ kä ɣöö dëë lät nyuuthnikä ti ga̱ykɛ naath ti la̱t rɛydiɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.1",
            "verseOrgIds": [
              "EXO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ ɣöö biɛ la̱r gaatku kɛnɛ gaat ganku ɛn min cä lät kä ji̱ I-jëp kɛnɛ lät ti ga̱ykɛ naath tëë cä la̱t rɛydiɛn, kɛ ɣöö bia jɛ cu ŋa̱c i̱ ɛ ɣän Kuoth Nhial.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ kɛnɛ Ä-ron cu wä nhiam Pɛro, cukɛ jɛ wä jiök i̱, “Ci Kuoth Nhial, Kuoth ji̱ Ɣi-bɛ-ru wee i̱, ‘Ji̱n bi ŋot lo̱ki ɣöö muɔ̱li kɛ ɣä amäni nɛy? A nɛɛkä wä kɛ ɣöö bikɛ ɣä wä pal ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.3",
            "verseOrgIds": [
              "EXO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö mi wi̱i̱ jɛ lo̱k i̱ wä nɛɛkä, bä ro̱lu ba̱p kɔryɔm iruun ɔ bak ɔ, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.4",
            "verseOrgIds": [
              "EXO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bɛ wi̱c muɔ̱ɔ̱n kum, kɛ kui̱c ɛmɔ, bɛ thil ram mi nɛɛn mun. Bikɛ tëë ci nhiaal guiiyni kɛ ba̱ny ji̱ cam. Bikɛ jiɛnku diaal tin ci do̱ny rɛy kakädu cam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.5",
            "verseOrgIds": [
              "EXO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikɛ duel kuäärädu thiäŋ, amäni duël ji̱ kɔaaru diaal kɛnɛ duël ji̱ I-jëp diaal. Ba mi ka̱n me̱t nɛn ɛ guurdɔɔŋni kɛnɛ guiiri ni mëë kua kɛ di̱eth amäni cäŋ ɛ wa̱l ɛ mi.’ ” Cuɛ rɔ ri̱t, cuɛ jiɛn nhiam Pɛro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.6",
            "verseOrgIds": [
              "EXO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu la̱a̱t Pɛro, Pɛro thi̱ec i̱, “Bi wut ɛmɛ kɔn moc riɛk amäni nɛy? Jakni naath kä wä, bikɛ Kuoth Nhial Kuothdiɛn wä pal. /Keni jɛ ni ŋa̱c ɛn ɣöö ci I-jëp jiääk?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.7",
            "verseOrgIds": [
              "EXO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua Muthɛ kɛnɛ Ä-ron luɔ̱ɔ̱c nhiam Pɛro. Cuɛ kɛ jiök i̱, “Wiaa, palɛ Kuoth Nhial Kuothdun, Kä kukɛ la ŋaani wä tɔ̱?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.8",
            "verseOrgIds": [
              "EXO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ ɛ jiök i̱, “Bakɔ wä kɛɛl kɛ ŋuɛ̈tnikɔ, kɛ dɔŋkɔ, bakɔ wä kɛɛl kɛ gaatkɔ kɛnɛ nyieekɔ, kɛ de̱tkɔ, kɛ ɣɔ̱ɔ̱kɔ, bakɔ Kuäär ni Kuoth Nhial dhil wä kir pa̱ny kɛ mi̱th luthä.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Pɛro wee i̱, “Ɣän yaacä rɔ nikɛ ciöt Kuɔth Nhial ɛn ɣöö /cä yɛ bi jak kä wä kɛɛl kɛ mänkun kɛnɛ gaatkun! Kä nɛ̈nɛ jɛ, ta̱yɛ kɛ ca̱r mi jiääk wi̱i̱dun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.10",
            "verseOrgIds": [
              "EXO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wä ni wutnikun, bikɛ Kuoth Nhial wä pal, kɛ ɣöö ɛ jɛn nɔmɔ di̱t lɔcdun kɛ jɛ mɔ.” Cua kɛ tuɔ̱k raar nhiam Pɛro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu Kuoth Nhial Muthɛ jiök i̱, “Rinyni tetdu wi̱i̱ muɔ̱ɔ̱n I-jëp kɛɛliw kɛ ɣöö bi ɣɔw tekɛ kɔryɔm mi bi ben muun I-jëp, bɛ juaac diaal ben cam wi̱i̱ muɔ̱ɔ̱n I-jëp tëë diaal tëë ci kään kä nhiaal guiiyni.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ kɛɛtdɛ cu riɛny wi̱i̱ muɔ̱ɔ̱n I-jëp kɛ kui̱ kɔaryɔaam, cu Kuoth Nhial jiɔam mi le̱th le̱th kui̱ käny ca̱ŋ jak kä put muun ɛmɔ kɛ cäŋ ɛmɔ kɛɛliw amäni wäärɛ. Mëë ruɔ̱n kɛ runwaŋ cu jiɔam mi le̱th le̱th kui̱ käny ca̱ŋ kɔryɔm lo̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kɔryɔm ben muun I-jëp kɛɛliw, cuɛ nyuur ro̱o̱l I-jëp kɛɛliw, ɛ kɔryɔm mi bääp mi cɛ tha̱a̱c mi /ka̱n me̱t nɛn jɔli wal, kä /ca mi ce̱tkɛ jɛ bi me̱t nyɔk kɛ nën. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.14",
            "verseOrgIds": [
              "EXO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö cɛ piny kɛɛliw kum ɛ dur a bi piny cuɔl ɛcuc. Cukɛ juaac wec diaal cam, a amäni dɛy jiɛn diaal tëë ci nhiaal guiiyni kɛ ba̱ny piny. Thilɛ mi tɔ̱c mi cu ŋot kɛ tëk, cäŋɛ ni jiath kɛl kiɛ juac kɛl /kenɛ duɔth muun I-jëp kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.15",
            "verseOrgIds": [
              "EXO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Pɛro Muthɛ kɛnɛ Ä-ron cɔl kɛ pɛ̈th, cuɛ kɛ jiök i̱, “Ɣän cä Kuothdun ni Kuoth Nhial due̱r due̱r, a amäni yɛn bä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.16",
            "verseOrgIds": [
              "EXO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän la̱ŋä ni ji̱, ku lɔcdu pa̱l piny kɛ kui̱ dui̱rädä kɛ jɛn kɛl ɛmɛ, kä thi̱ec Kuoth Nhial Kuothdu kɛ ɣöö bɛ ku dhil woc ɛn lia̱a̱ ɛmɛ kärɔa.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.17",
            "verseOrgIds": [
              "EXO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ cu jiɛn nhiam Pɛro, wëë Kuoth Nhial läŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.18",
            "verseOrgIds": [
              "EXO.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial jiɔam konyä ca̱ŋ mi bum ɛlɔ̱ŋ jak kä put, cuɛ kɔryɔm wä yuɔr ni baar mi cɔal i̱ Bar Gutdä.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:19",
              "type": "text"
            },
            {
              "text": "Jekɛ kä Jɔ-cua 2:10, 4:23, 24:6.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Cuɛ thil lɛ kɔryɔm kɛl mi cu duɔth rɛy muɔ̱ɔ̱n I-jëp kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial lɔc Pɛro jak kä bum, /kenɛ ji̱ I-thɛ-rɛl nhök wä.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɛ mɔ, cu Kuoth Nhial Muthɛ jiök i̱, “Rinyni tetdu nhial, bi mun I-jëp a muth kɛɛliw, muth mi thil kam.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
            "verseOrgIds": [
              "EXO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ tetdɛ kap nhial, cuɛ cu tekɛ muth mi col ɛcuc muun I-jëp kɛɛliw kɛ ni̱n da̱ŋ diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
            "verseOrgIds": [
              "EXO.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ci ram ɔ ram in dɔ̱ŋ nɛn kä kɛ, kä thilɛ ram mi wany rɔ guäthdɛ kɛ kɛn ni̱n da̱ŋ diɔ̱k tɔ̱tɔ̱. Kä ji̱ I-thɛ-rɛl diaal te buay duëlikiɛn tin tekɛ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.23",
            "verseOrgIds": [
              "EXO.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Pɛro Muthɛ cɔl, cuɛ jɛ ben jiök i̱, “Wiaa, palɛ Kuoth Nhial, a gaatkun tin nyintiɛtni wä kɛ yɛ kɛɛl bä. Duundɛ ɣöö bia de̱tkun kɛnɛ ɣɔ̱ɔ̱kun ba̱ny piny.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ wee i̱, “Ji̱n, bi kɔ dhil jak kä naŋkɔ ti bakɔ wä kiir ni Kuoth Nhial kɛnɛ tin bakɔ wä wëŋ jɛ, kɛ ɣöö bakɔ Kuothda ni Kuoth Nhial wä na̱k luuri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣɔ̱ɔ̱kɔ bikɛ dhil wä bä kɛ kɔ kɛɛl, a thil barkak mi doth, kɛ ɣöö bakɔ rɔ̱ yi̱k wä moc thi̱n kɛ tin bakɔ wä lät ni Kuoth Nhial Kuothda. Kä /ka̱n kɔ min bakɔ wä lät ni Kuoth Nhial ni ŋa̱c thi̱n rɛydiɛn kɛn ti̱ti̱, bakɔ jɛ ku lɛ wä ŋa̱c mi cakɔ cop win ɛmi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial lɔc Pɛro jak kä bum a /kenɛ kɛ jak kä jiɛy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Pɛro ɛ jiök i̱, “Woc rɔɔdu gekädä. Nik ni rɔɔdu, /cu nhiamdä nyɔk kɛ cuɔ̱p. Kä cäŋ in bi nɛɛn ni nhiamdä, ba cäŋ li̱ethdu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ wee i̱, “Ɛ ruacdu. Ɣän /cä luny nhiamdu bi lɛ nyɔk.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
