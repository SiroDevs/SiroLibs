    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Köc bieyni bööthni palä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua bi̱i̱ tak a thiɛnkɛ jɛ kɛ lath mi yie̱l kɛnɛ mi mɛr kɛ mi do̱l kɛ kui̱ la̱t kua̱ri palä guäth in gɔaa in rɛl rɔ. Cukɛ bieyni kuoothä ti gɔw ti ɣɛ̈lkɛ rɔ̱ kɔc ce̱tkɛ mëë ci Kuoth Nhial jɛ la̱r Muthɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ bi̱i̱ gɔ̱rä ran la̱t kɛ lath mi ca mɛn agɔaa, kɛ lath mi yie̱l kɛnɛ mi mɛr kɛ mi do̱l, kɛnɛ lath dääpä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.2",
            "verseOrgIds": [
              "EXO.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ da̱a̱p täth a pa̱nkɛ jɛ, cua ku lɛ liɛr a ciw ce̱tkɛ lath kɛ ɣöö ba ku lɛ kɔac lath in yie̱l kɛnɛ min mɛr kɛ min do̱l biey in ca lathdɛ mɛn agɔaa kɛ la̱t kuurä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.3",
            "verseOrgIds": [
              "EXO.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ de̱p tin dööpkɛ ni nhiam kɛnɛ jɔk biey gɔ̱rä ran la̱t, dööpkɛ jɛ ŋɛpnikɛ wuɔ̱thni wuɔ̱ɔ̱knikɛ da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.4",
            "verseOrgIds": [
              "EXO.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä la̱a̱k mi ca tak ni kuurä pinydɛ mi duɔtkɛ ni jɛ piny la̱tkɛ jɛ kɛ jɛn ca̱p ko̱cä dääpä nɔmɔ kɛ jɛn la̱t ɔ kɛl ɔ, kɛ lath mi yie̱l kɛnɛ mi mɛr kɛ mi do̱l kɛ lath mi ca mɛn agɔaa, ce̱tkɛ mëë ci Kuoth Nhial jɛ la̱r Muthɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.5",
            "verseOrgIds": [
              "EXO.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua guiy ti ca̱a̱r wuk, pi̱emkɛ kɛ ɣo̱tni dääpä tin rɔamkɛ ni kɛ. Kä wuɔ̱ɔ̱kɛ kɛ kä gɔ̱a̱rkɛ kɛ ni kɛ kët in la bël mi kuur ɛ la kɛt ni tiil yiɛtni, cukɛ pe̱k ciöötni gan I-thɛ-rɛl kɛ̈t thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.6",
            "verseOrgIds": [
              "EXO.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ la̱th do̱o̱pni wuɔ̱ɔ̱kni biey gɔ̱rä ran kɛ ɣöö bikɛ a guiy tiitdä gan I-thɛ-rɛl, nikɛ mëë ci Kuoth Nhial ɛ la̱r jɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.7",
            "verseOrgIds": [
              "EXO.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Köc biey kath ran",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.7",
            "verseOrgIds": [
              "EXO.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ bi̱i̱ kath kɔc ni kuurä ce̱tnikɛ köc biey gɔ̱rä kɛ da̱a̱p, kɛ lath mi yie̱l kɛnɛ mi mɛr kɛ mi do̱l, kɛ lath mi ca mɛn agɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.8",
            "verseOrgIds": [
              "EXO.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ca bi̱i̱ kath ran ɛmɔ bärɛ pa̱a̱r kui̱cni diaal, kä ca jicdɛ mat kä rɛɛw bärɛ juäth tetdä kɛl, kä riewdɛ juäth tetdä kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.9",
            "verseOrgIds": [
              "EXO.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ bëër da̱ŋ ŋuaan kä guiy ti gɔw ni kɛn kɔac thi̱n. Ber in nhiamdiɛn cukɛ guɛɛy mi määl mi duŋ gɔaa la̱th thi̱n, kɛnɛ guɛɛy mi tok, kɛ guɛɛy mi gui̱i̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.10",
            "verseOrgIds": [
              "EXO.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ber in rɛwdɛ ɛ be̱r guiiyä tɔ̱c kɛnɛ guɛɛy mi yie̱l kɛ guɛɛy mi riaw riaw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.11",
            "verseOrgIds": [
              "EXO.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ber in diɔ̱ɔ̱kdiɛn ɛ be̱r guiiyä mi thiäŋ kɛnɛ guɛɛy mi dɛ̈ɛ̈r kɛ guɛɛy mi yian. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.12",
            "verseOrgIds": [
              "EXO.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu be̱r in ŋuaandiɛn a be̱r guiiyä mi duäy kɛnɛ guɛɛy mi ca̱r kɛ guɛɛy mi tɔ̱c cäärä. Ca kɛ pi̱m ɣo̱tni da̱a̱pnikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.13",
            "verseOrgIds": [
              "EXO.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te guiy da̱ŋ wäl rɛw thi̱n kɛ ciöötkiɛn ti luɔtkɛ ni ciööt gan I-thɛ-rɛl. Cikɛ ciöötkiɛn kɛ̈t jɔkdiɛn, ca mɔ ciötdɛ kɛ̈t jɔk kä mɔ kɛ kui̱ dööri da̱ŋ wäl rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.14",
            "verseOrgIds": [
              "EXO.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ kuatni ti ca ŋɔn kɛ da̱a̱p mi ti̱l ti̱l la̱t jɔk biey kath. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.15",
            "verseOrgIds": [
              "EXO.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ ɣo̱t dääpä da̱ŋ rɛw wuɔ̱th kɛnɛ tiil da̱ŋ rɛw ti ca täth kɛ da̱a̱p, kä cukɛ tiil da̱ŋ rɛw tɔ̱tɔ̱ gɔan thukni biey kath da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.16",
            "verseOrgIds": [
              "EXO.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ kuat dääpä da̱ŋ rɛw tin kɔn gɔan tiili da̱ŋ rɛw tin te thukni biey kath. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.17",
            "verseOrgIds": [
              "EXO.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ thuk kuatni da̱ŋ rɛw tin kɔ̱ŋ ruɔ̱k kä kääpni guiiyni da̱ŋ rɛw, cukɛ jɛ cu yian nhiam kä kääpni biey in te wuɔ̱ɔ̱kni biey gɔ̱rä ran. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.18",
            "verseOrgIds": [
              "EXO.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ tiil dääpä da̱ŋ rɛw ku täth, kä cukɛ kɛ cu gɔan thukni biey kath da̱ŋ rɛw ala thuk rɛ̈c i̱ tin te piny tin thie̱e̱k kɛ bi̱i̱ gɔ̱rä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.19",
            "verseOrgIds": [
              "EXO.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ tiil dääpä da̱ŋ rɛw täth, kä cukɛ kɛ yian nhiam piny thukni kääpni wuɔ̱ɔ̱kni biey gɔ̱rä da̱ŋ rɛw, ro̱mädɛ nhial guäth in ca dɛr ni kuurä kä bi̱i̱ gɔ̱rä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.20",
            "verseOrgIds": [
              "EXO.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ bi̱i̱ kath yian tiili biey gɔ̱rä kɛ bi̱i̱ mi yie̱l mi rɛp-rɛp, kɛ ɣöö bɛ pɛn wi̱i̱ lääkä biey gɔ̱rä min ca dɛr ni gɔaa, kɛ ɣöö /ci bi̱i̱ kath rɔɔdɛ bi put biey gɔ̱rä, ce̱tkɛ mëë ci Kuoth Nhial ɛ la̱r Muthɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bieyni bööthni palä ti kɔ̱kiɛn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.21",
            "verseOrgIds": [
              "EXO.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua bi̱i̱ piɛny biey kath kɔc kɛɛliw kɛ lath mi yie̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.22",
            "verseOrgIds": [
              "EXO.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua thɛɛr wec biey ko̱r kɛ lath mi ca dɛ̈r thi̱n, kɛ ɣöö /cɛ bi lɛ rɛ̈t. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.23",
            "verseOrgIds": [
              "EXO.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ thɛɛr piɛny biey moc dhuɔɔr kɛ lath mi yie̱l kɛnɛ mi mɛr kɛ mi do̱l, kɛ bi̱i̱ mi ca mɛn agɔaa kä puɔth ta̱kdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.24",
            "verseOrgIds": [
              "EXO.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ kuɔluɔkni täth kɛ da̱a̱p mi ti̱l ti̱l kä cukɛ kɛ yiɛn kä kamni dhuɔɔri piny thɛɛrä biey. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.25",
            "verseOrgIds": [
              "EXO.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn kuɔluɔkni kɛnɛ dhuɔɔr lath ca kɛ ko̱o̱r ni thɛɛr piɛny biey in ba kuëŋ kɛ kui̱ la̱t Kuɔth, ce̱tkɛ mëë ci Kuoth Nhial ɛ la̱r Muthɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.26",
            "verseOrgIds": [
              "EXO.39.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.26",
            "verseOrgIds": [
              "EXO.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ Ä-ron kɛnɛ gaatkɛ köc bieyni ti ca lathdiɛn mɛn agɔaa kɛ la̱t kuurä raam in la tak bieyni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
            "verseOrgIds": [
              "EXO.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛnɛ bieyni wec, kɛnɛ bi̱i̱ in la riɛthkɛ wi̱c, kɛ thuruaalikiɛn tin ca kɔc kɛn diaal kɛ lath mi ca mɛn agɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
              "EXO.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ la̱a̱k lɛtdä min ca kɔc kɛ lath mi ca mɛn agɔaa, ɛ la̱t kuurä raam in la tak bieyni ce̱tkɛ mëë ci Kuoth Nhial ɛ la̱r Muthɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 39:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ kum kuoothä täth kɛ da̱a̱p mi ti̱l ti̱l, kä cukɛ rieet ti larkɛ jɛ i̱, “Mi rɛl gɔɔydɛ rɔ kä Kuoth Nhial.” Kɛ̈t thi̱n ce̱tkɛ kët tilä gɔ̱rä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua jɛ cu yian biey wec kɛ bi̱i̱ mi yie̱l, ni kɛ ruac ëë ci Kuoth Nhial ɛ la̱r Muthɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thuɔ̱k la̱t kɛmɛkä ro̱mä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 39:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu la̱t due̱l ro̱mä ku thuɔ̱k. Cu ji̱ I-thɛ-rɛl lot ni laat diaal tëë ci Kuoth Nhial kɛ la̱t Muthɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ Muthɛ nöŋ due̱l ro̱mä, kɛnɛ kuak rɛ̈cdɛ diaal, go̱o̱ni thieerikɛ, kɛ ka̱a̱pkɛ, kɛ to̱ŋkɛ kɛ thieerkɛ amäni ɣo̱t ciökni ka̱a̱pnikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 39:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ tuac rɔmä mi thiäŋ kɛ tuac böwni ti yiël, kɛ ge̱e̱l, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 39:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ thanduk matdä ruac Kuɔth, min rɔaamkɛ ni pääm lueekni Kuɔth, kɛnɛ to̱ŋkɛ, kɛ kum. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 39:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tharbët kɛnɛ kuakɛ diaal kɛɛl, kɛ micieth in ka̱mkɛ nhiam Kuɔth, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
            "verseOrgIds": [
              "EXO.39.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 39:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ cuuŋ lɛmbärä min ca täth kɛ da̱a̱p mi ti̱l ti̱l, kɛnɛ be̱r lɛmbärnikɛ amäni nyin kɔaarɛ diaal, kɛ liɛɛth maac. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.37",
            "verseOrgIds": [
              "EXO.39.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 39:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ yi̱k dääpä, kɛnɛ liɛɛth yi̱rä, kɛ wäl in kur kur in la waŋkɛ, kɛ bieyni thuɔk duëël Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.38",
            "verseOrgIds": [
              "EXO.39.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 39:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ yi̱k cikä min yian kɛnɛ näydɛ min ca tak ce̱tkɛ cambak, kɛ kuakɛ diaal, kɛnɛ thak la̱k te̱tni kɛnɛ ciök kɛɛl kɛ tharɛ, kɛ ge̱e̱l thuɔk rɛ̈ɛ̈k, kɛ loorikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 39:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bieyni pua̱a̱ny duëël, kɛ thieerkɛ, kɛnɛ ɣo̱t thäri ciöknikiɛn, kɛnɛ ge̱e̱l thi̱ek duëël, loorikɛ kɛnɛ löckɛ, kɛnɛ kuak läätdä due̱l ro̱mä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 39:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ bieyni tin ca tak kɛ lath mi ca mɛn agɔaa kɛ kui̱ la̱t lätni guäth in rɛl rɔ, bieyni kuoothä tin gɔw tin ɣɛ̈lkɛ rɔ̱ kɛ kui̱ Ä-ron in la bo̱o̱th ŋuɔ̱tni, kɛnɛ bieyni gankɛ kɛ ɣöö bikɛ lät Kuɔth la̱t ala kua̱r ŋuɔ̱tni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.41",
            "verseOrgIds": [
              "EXO.39.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 39:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ji̱ I-thɛ-rɛl la̱t ɛmɔ kɛɛliw la̱t ce̱tnikɛ min ci Kuoth Nhial ɛ la̱r Muthɛ kɛɛliwdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.42",
            "verseOrgIds": [
              "EXO.39.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 39:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ la̱t kɛɛliw nɛn, kä cuɛ jɛ je̱k ca la̱t ɛ kɛn ce̱t ni min ci Kuoth Nhial ɛ lar, cu kɛ ti diaal la̱t ni kɛ jɛ. Kä cu Muthɛ kɛ poth.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.43",
            "verseOrgIds": [
              "EXO.39.43"
            ]
          }
        }
      ]
    }
