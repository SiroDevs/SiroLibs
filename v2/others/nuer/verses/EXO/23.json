  "bookId": "EXO",
  "reference": "Ɣöth 23",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "EXO 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A luɔ̱ɔ̱k a cuɔ̱ŋ cuɔ̱ɔ̱ŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“/Cu ruac kacä kɛ kui̱ raam mi dɔ̱ŋ nhɔk. /Cu tetdu bi gɔn kɛɛl kɛ ram mi jiääk kɛ ɣöö bi jɛ wä ɣɔr. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cu thok mat kɛɛl kɛ buɔ̱n mi lät ni mi jiääk. /Cu cuɔ̱ɔ̱ŋ wony kɛ thok nɛɛni ti ca rɔ̱ rith, kä latkɛ ni duer, a ya̱rkɛ ni thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cu can ɣɔr rɛy luɔ̱k kɛ ɣöö i̱ ɛ can.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi bi röm kɛ thäk gua̱n tɛ̈ru kiɛ muulɛ mi te bathä, biɛ luɔ̱c ɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wi̱i̱ muul raam mi nyiir ji̱ nɛn ci ɣa̱c ɛ boŋ, /cu jɛ bäny piny a /ciɛ luäk, luäk ɛ kɛ jiecädɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä /cu cuɔ̱ɔ̱ŋ randu mi can pe̱n jɛ rɛy luɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔ̱ɔ̱ni rɔ kɛ nɛy ti gɔanykɛ naath kɛ kac. /Cu ram mi gɔaa kɛnɛ ram mi tëë cuɔ̱ɔ̱ŋ kuɛth li̱th kɛ ɣöö /cä ram ɔ lät mɔ jiääk ɛmɔ bi päl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cu mi kɔakɛ ni kuäär nhɔk. Kɛ ɣöö kök la cɔɔrɛ kuäär mi ŋäc luk, kä nhiɛtdɛ cuɔ̱ɔ̱ŋ gua̱n thukä piny. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cu ram mi jääl kui̱ny, kɛ ɣöö ŋa̱cɛ lɔc raam mi jääl, kɛ ɣöö cia kɔn a ja̱a̱l muun I-jëp.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bärɔw ni̱ni kɛnɛ bärɔw runi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bia ka̱a̱kun pith kɛ run bäkɛl, kä bia tin ci ciɛk thi̱n ciɛc. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bia mun ɛmɔ päl kɛ bärɔw runi, bɛ lɔ̱ɔ̱ŋ, bɛ te baaŋ inɔ. Tɔ̱ bi do̱ny thi̱n ɛn runä nɔ mɔ tɔ, bi nɛɛkun tin can kɛ cam. Kä tɔ̱ ba päl ɛ kɛn tɔ̱, bi le̱y dɔaar kɛ cam. Bia kak jiɛn kɛnɛ kak ɔ-lip la̱t ni nɔ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bia la̱tdun la̱t kɛ ni̱n bäkɛl, kä bärɔw ni̱ni bia lɔ̱ɔ̱ŋ, kɛ ɣöö dëë thääkdun kɛ muulun lɔ̱ɔ̱ŋ, kä bi gat läätädun amäni röl lɔ̱ɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiɛtdɛ ti diaal ti cä la̱r yɛ, kä /cuɔrɛ kuth kɔ̱kiɛn lam ciöötnikiɛn kä /cuɔrɛ kɛ nyäl kɛ thukun.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋa̱a̱ri tin di̱t da̱ŋ diɔ̱k",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä diɔ̱ɔ̱k kɛ ruɔ̱n bia ɣä la ŋa̱rɛ ŋar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.14",
            "verseOrgIds": [
              "EXO.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia mi̱eth ŋarä mi thil thuɔp la tiit. Bia la̱t ni kɛ duɔ̱ɔ̱p mi cä la̱r yɛ, bia juray mi thil thuɔp a cam kɛ ni̱n bärɔw kɛ gua̱a̱thdɛ in ca ŋuɔk thi̱n paay in cɔal i̱ Duɔ̱ɔ̱ŋ (Abib) kɛ ɣöö ɛ jɛn gua̱a̱th ëë be̱e̱ kɛ yɛ raar kä I-jëp. Thilɛ ram mi bä nɛn bëë nhiamdä a thil tetdɛ duɔ̱ɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia ŋar ŋër bɛɛl a tiɛtdɛ, kä bia key, kä tin cia pith ka̱a̱nikun la nöŋɛ ɣä. Bia mi̱eth määtni ŋɔaani diaal la tiɛtdɛ kɛ thuɔ̱k runä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi wutni diaal a bëë ɣän nhiamdä Kuäär ni Kuoth Nhial kä diɔ̱ɔ̱k kɛ ruɔ̱n.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“/Cia riɛm luurikä bi mat kɛɛl kɛ juray mi thil thuɔp, kä /cia thiɔl mi̱thni ti̱mädä bi jak kä bak piny. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Key diaal tin nhiam kä kuay muɔ̱ɔ̱ndun bia kɛ no̱o̱ŋ due̱e̱lä, duëël Kuoth Nhial Kuothdun. /Cia dɔ dɛ̈ɛ̈l bi thal kɛ cak man.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Riali jääk kuɔth kɛ duɔ̱ɔ̱p ikä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nɛ̈nɛ jɛ, ɣän bä jääk nhial jäk kä nhiamdun bɛ yɛ yop dupdun, kä bɛ yɛ no̱o̱ŋ guäth mi cä rial ikä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.20",
            "verseOrgIds": [
              "EXO.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niɛkɛ rɔ̱, kä liɛŋɛ ruacdɛ, /cuɔrɛ gua̱c kɛ jɛ, kɛ ɣöö /cɛ duerun bi päl, kɛ ɣöö ta̱a̱ kɛɛl kɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
            "verseOrgIds": [
              "EXO.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wi̱i̱ ruacdɛ wä liŋ a bum a bi mi cä la̱r ji̱ la̱t kɛɛliw, bä la gua̱n tɛ̈r kä ram mi tɛr kɛ ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.22",
            "verseOrgIds": [
              "EXO.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wä jääkdä wä nhiamdu a bɛ ji̱ no̱o̱ŋ muun ji̱ Ɛ-mor, kɛnɛ mun ji̱ Ɣɛ̈th, kɛ mun ji̱ Pɛ-rii-dhi, kɛ mun ji̱ Kɛ-naan, kɛ mun ji̱ Iwi, kɛ mun ji̱ Yɛ-buth, ɣän bä kɛ puɔc raar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.23",
            "verseOrgIds": [
              "EXO.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tit ɛ, i̱ /ci rɔ̱ bi goŋ kɛ kuthkiɛn, kä /ci kɛ bi pal a bi kɛ lät kä lät, kä /ci lätkiɛn bi guɔ̱ɔ̱r. Kä bia kɛ däk a bia yi̱knikiɛn thia̱y piny. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.24",
            "verseOrgIds": [
              "EXO.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia Kuothdun ni Kuoth Nhial a lät kä lät, kä bä mi̱ethdu mäni pi̱i̱ku poth, kä bä jueydu woc rɛydu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
            "verseOrgIds": [
              "EXO.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ ciek mi bi gat ka̱m raar, kä thilɛ ciek mi bi a rol muundu, bä jɛ jak kä cuɔ̱pɛ run te̱e̱kädu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
            "verseOrgIds": [
              "EXO.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bä dual jäk kä nhiamdu kä bɛ jur diaal jak kä dual. Bɛ nɛy diaal ti bëë kɛ ko̱riɛn wi̱cdiɛn ben nyon, kä bä ji̱ tɛ̈ru diaal jak kä barkɛ rɔ kɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.27",
            "verseOrgIds": [
              "EXO.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä ruɔ̱m jäk kä nhiamdu kä bɛ ji̱ Iwi kɛnɛ ji̱ Kɛ-naan kɛ ji̱ Ɣɛ̈th töl dɔɔr nhiamdu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.28",
            "verseOrgIds": [
              "EXO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän /cä kɛ bi joc nhiamdu kɛ ruɔ̱n kɛl kärɔa, kɛ ɣöö de̱rɛ ŋɔa̱a̱ŋ dëë mun thil raan a dëë le̱y dɔaar rɔ̱ di̱eth thi̱n kɛ pe̱k mi di̱i̱t a dëë ji̱ tiam ɛ kɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.29",
            "verseOrgIds": [
              "EXO.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bä kɛ cuac dɔɔr nhiamdu ɛ lɛm lɛm amäni cäŋ in wiaa ŋuan, a bia ro̱ŋ kɛ käni muɔ̱ɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.30",
            "verseOrgIds": [
              "EXO.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä keydun la̱t ni Bar Gutdä bɛ ben yiath ni Bar ji̱ Pi-li-thɛt, kä bɛ jɛ ka̱n ni rɛy dɔaar wëë pi̱em ni yie̱e̱r Yu-pɛ-ree-tidh kɛ ɣöö bä ji̱ muɔ̱ɔ̱n ɛmɔ la̱th te̱tnikun, kä bia kɛ joc nhiamdun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.31",
            "verseOrgIds": [
              "EXO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cia thok bi mat kɛ kɛ, kiɛ kuthkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.32",
            "verseOrgIds": [
              "EXO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cikɛ bi cieŋ muundu amäni mi de̱e̱kɛ yɛ jak kä duerɛ ɣä duer, kɛ ɣöö mi bia kuthkiɛn lät kä lät bi nɔmɔ ji̱ döp riɛk mi jiääk.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.33",
            "verseOrgIds": [
              "EXO.23.33"
            ]
          }
        }
      ]
    }
  ],
