              "EXO.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu Muthɛ ji̱ I-thɛ-rɛl jiök i̱, “Nɛ̈nɛ jɛ, ci Kuoth Nhial Be-dha-lel gat Uri min la gat Ɣur raan döör Juda cɔl ni cio̱tdä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jɛ thiäŋ kɛ Yiëë Kuɔth, cɛ jɛ ka̱m pɛl, kɛ ŋäc kɛnɛ tiit kä ŋɔaani, kɛnɛ ca̱a̱p kuurä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bɛ ca̱a̱p kuurä la̱t kɛ la̱t dääpä kɛnɛ ciɛk in bo̱r, kɛ ciɛk in yian, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ wuɔ̱ɔ̱k guiiyni kɛ wuɔ̱r dɔ̱a̱kni, kɛ ŋa̱t jiɛn amäni ca̱a̱p kuurä la̱t ɛmɔ kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä Cɛ jɛ moc lua̱ŋ kɛɛl kɛnɛ Ɔ-li-yab gat A-ɣi-tha-mak raan döör Dan, kɛ ɣöö bikɛ naath ŋi̱eec kɛ ca̱a̱p be̱e̱lä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cɛ kɛ thiäŋ kɛ lua̱ŋ la̱t kuurä lätni diaal tin la̱tkɛ ɛ kuɔ̱ɔ̱r ce̱tkɛ tin la la̱tkɛ ɛ kuɔ̱ɔ̱r tin ŋa̱a̱tkɛ jiɛn, kɛ ca̱a̱p ta̱th, kiɛ ta̱a̱k bieyni tin ja̱mkɛ bieyni kɛ ta̱k te̱tni, kɛ biɛl mi yie̱l kɛnɛ mi mɛr kɛ mi do̱l, kɛ ta̱k in ca lath bieydɛ mɛn agɔaa, kiɛ ta̱k in la kuur ɛ a tak ni bieyni kɛ makanɛ, kɛ la̱t in la la̱tkɛ lät nath diaal kiɛ ca̱a̱p kuurä inɔ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
              "EXO.35.35"
            ]
          }
        }
      ]
    }
