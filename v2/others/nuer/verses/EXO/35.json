          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu bööth guiy ti ca̱a̱r no̱o̱ŋ kɛnɛ guiy kɔ̱kiɛn kɛ kui̱ jämni biey gɔ̱rä ran kɛnɛ bi̱i̱ kath, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.27",
            "verseOrgIds": [
              "EXO.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ wal tin kuɔ̱r kuɔ̱ɔ̱r, kɛnɛ liɛɛth lɛmbärä amäni liɛɛth yi̱rä kɛ kui̱ wal tin la ŋuäny kur tin la waŋkɛ wi̱i̱ yi̱kä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.28",
            "verseOrgIds": [
              "EXO.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wutni diaal kɛnɛ män diaal kä ji̱ I-thɛ-rɛl tin ci lɔcdiɛn wä thi̱n i̱ bikɛ ŋɔak no̱o̱ŋ kɛ kui̱ la̱t ëë ci Kuoth Nhial ɛ lar kɛ thok Muthɛ i̱ ba la̱t, cukɛ kɛ nöŋ Kuoth Nhial ala muc ti ŋuɔ̱nkɛ kɛ lɔcdiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ta̱a̱th duëël ro̱mä",
          "type": "text"
