    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kɛmɛ ro̱mä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Täämɛ, dɔ̱diɛn ɛn, yɛn bia ɣä lät kä kɛmɛ kɛ bieyni ti dël dëël ti nyin gɔw da̱ŋ wäl ti yiël kɛnɛ ti mɛ̈ri kɛ ti dööli ti ca lathdiɛn mɛn agɔaa, kä ca tak agɔaa, kä bi kɛ la̱t ni kuurä, ba kɛ biɛl rɛci kɛ pua̱ny ti ce̱tkɛ pua̱ny ja̱a̱kni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bär biey kɛl a jua̱th te̱tni ti jiɛn rɛw wi̱cdɛ bädäk. Bi riewdɛ a jua̱th te̱tni da̱ŋ ŋuaan. Bieyni diaal ba themdiɛn pa̱a̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bieyni da̱ŋ dhieec kɔc kɛɛl, kɛ dhieec kɔ̱kiɛn kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.3",
            "verseOrgIds": [
              "EXO.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi thuk biey ɔ a muooci go̱o̱ni kɛ lath mi yie̱l kä kɛn bieyni dhieec tin ca kɔc kɛɛl, kä biɛ la̱t ni nɔ, amäni bieyni da̱ŋ dhieec tin kɔ̱kiɛn, kä bi go̱o̱ni la̱th thuknikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.4",
            "verseOrgIds": [
              "EXO.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi go̱o̱ni ti jiɛn dhieec la̱th thukni bieyni da̱ŋ dhieec tin ca kɔc kɛɛl, kɛnɛ go̱o̱ni ti jiɛn dhieec thukni bieyni da̱ŋ dhieec tin kɔ̱ŋ tin ca kɔc kɛɛl. Bi go̱o̱ni tɔ̱tɔ̱ rɔ̱ cu lot kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.5",
            "verseOrgIds": [
              "EXO.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi go̱o̱ni ti jiɛn dhieec tin ba bieyni dööp kɛ kɛ täth kɛ da̱a̱p kɛ ɣöö bi due̱l cua kɛl.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bi bieyni tak kɛ mi̱em böwni kɛ kui̱ wec duëël. Kä bi kɛ tak ala wäl kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.7",
            "verseOrgIds": [
              "EXO.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bi̱i̱ kɛl bärɛ a jua̱th te̱tni ti jiɛn diɔ̱k, kä bi riewdɛ a jua̱th te̱tni da̱ŋ ŋuaan. Kɛn bieyni da̱ŋ wäl kɛl, bikɛ pa̱a̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi dhieec kɔc kɛɛl, kä bi bäkɛl tin kɔ̱ŋ kɔc kɛɛl. Kä bi bäkɛliɛn mat ala jia̱a̱c rɛw thok thi̱ek in te nhiam kɛmɛkä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.9",
            "verseOrgIds": [
              "EXO.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi go̱o̱ni ti jiɛn dhieec la̱th thukni bieyni da̱ŋ dhieec tin nhiam tin ca kɔc kɛɛl raar, kä bi go̱o̱ni ti jiɛn dhieec la̱th thukni biey kä tin kɔ̱kiɛn tin ca kɔc kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.10",
            "verseOrgIds": [
              "EXO.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi go̱o̱ni ti jiɛn dhieec täth kɛ ciɛk in yian, bi go̱o̱ni yio̱o̱ni tin kɔn cu cuɔt kɛ rɛy go̱o̱ni bieyni kɛ ɣöö bi kɛmɛ ro̱mä a kɛl kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.11",
            "verseOrgIds": [
              "EXO.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nuth biey in ci duɔth bieyni tin ci ba̱a̱n wi̱i̱ kɛmɛ ro̱mä in te nhial bikɛ rɔ̱ le̱p puɔ̱ɔ̱ny kɛmɛkä jɔɔdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.12",
            "verseOrgIds": [
              "EXO.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi juäth tetdä mi te kui̱c kɛl kɛnɛ min te kui̱c in dɔ̱ŋ, kä bieyni wec kɛmɛkä ro̱mä nhial, wi̱c kɛmɛkä kuɔ̱m piny kui̱c ɔ kɛnɛ kui̱c ɔ, bikɛ cu te le̱p le̱p kui̱cnikɛ da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi wi̱c kɛmɛkä moc kɛ kuum kɛ tuac rɔɔmni ti ca biɛl kɛ biɛl mi thiäŋ, kä bi wi̱cdiɛn yi̱k piny kɛ tuac böwni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bi cuɔ̱ɔ̱ŋ kɛmɛkä la̱t kɛ jiath thëëp. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.15",
            "verseOrgIds": [
              "EXO.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi cuɔ̱ŋ kɛl kä jiɛn tɔ̱ cuɔ̱ɔ̱ŋɛ kɛmɛ tɔ̱ bärɛ a jua̱th te̱tni da̱ŋ wäl, kä bi jiath ɔ kä jiɛn tin te ri̱i̱wädɛ bärɛ a juäth tetdä kɛl kɛ nuth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi jiath kɛl a tekɛ tuŋ mi ce̱tkɛ tuŋ ko̱r, bi kɛl te kui̱c in te piny, kä bi tuŋ kɛl te kui̱c in te nhial, kɛ ɣöö bikɛ rɔ̱ gɔn kɛɛl, ba kɛn diaal pa̱a̱r ɛyit kɛ ɣöö bikɛ röm ɛpot kɛnɛ jiath in dɔ̱ŋ. Bi cuɔ̱ɔ̱ŋ kɛmɛkä ro̱mä la̱t inɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.17",
            "verseOrgIds": [
              "EXO.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi jiɛn la̱t kɛ kui̱ duëël, bi cuɔ̱ɔ̱ŋ jiɛn ti jiɛn da̱ŋ rɛw la̱t kui̱c targɛ̈w. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.18",
            "verseOrgIds": [
              "EXO.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi kääpni ciökni ti jiɛn da̱ŋ ŋuaan täth piny kɛ ciɛk in bo̱r, kä bi kɛ ta̱th thäri cuɔ̱ɔ̱ŋni jiɛn ti jiɛn rɛw. Bi kääpni da̱ŋ rɛw te thaar jiaath kɛl kɛ kui̱ ciöknikɛ da̱ŋ rɛw. Bi cio̱o̱k ɔ cuɔ̱ŋ wi̱i̱ kä kɛl, bi cio̱o̱k in dɔ̱ŋ cuɔ̱ŋ wi̱i̱ kä min dɔ̱diɛn, ba lɔathdiɛn diaal inɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.19",
            "verseOrgIds": [
              "EXO.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kui̱c duëël in dɔ̱ŋ in lot ni kui̱c kayŋuääk, bɛ tekɛ cuɔ̱ɔ̱ŋ jiɛn ti jiɛn da̱ŋ rɛw, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.20",
            "verseOrgIds": [
              "EXO.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ kääpnikiɛn ti jiɛn ŋuaan ti ca ta̱th piny kɛ ciɛk mi bo̱r, kääpni rɛw kɔ̱kiɛn piny jiaath in dɔ̱diɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.21",
            "verseOrgIds": [
              "EXO.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi cuɔ̱ɔ̱ŋ jiɛn da̱ŋ bäkɛl la̱th jɔk duëël kui̱c kony ca̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.22",
            "verseOrgIds": [
              "EXO.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi cuɔ̱ɔ̱ŋ jiɛn da̱ŋ rɛw la̱t kɛ kui̱ guɔ̱ɔ̱kni duëël jɔk ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.23",
            "verseOrgIds": [
              "EXO.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiɛn da̱ŋ rɛw tɔ̱tɔ̱ bikɛ ce̱tkɛ jiath kɛl dääriɛn kä ba kɛ mat ni kä ciɛk in nhiam, ba kɛn diaal la̱t ni nɔ, bikɛ guɔ̱ɔ̱k da̱ŋ rɛw cu la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.24",
            "verseOrgIds": [
              "EXO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ cu tekɛ cuɔ̱ɔ̱ŋ jiɛn da̱ŋ bädäk kɛ kääpni da̱ŋ wäl bäkɛl ti ca ta̱th piny kɛ ciɛk mi bo̱r, ti bi kääpni da̱ŋ rɛw a te piny jiaath kɛl. Ɛ jɛn lɔathdiɛn diaal inɔ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.25",
            "verseOrgIds": [
              "EXO.26.25"
            ]
          }
        }
      ]
    },
