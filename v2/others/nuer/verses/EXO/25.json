        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luuri gua̱th palä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Muthɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.1",
            "verseOrgIds": [
              "EXO.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ruacni kɛ ji̱ I-thɛ-rɛl, akɛ ma̱a̱tkɛ ɣä kä luuri, bia mɔ luäŋ raan ɛ kɛ ŋun ɔ no̱o̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.2",
            "verseOrgIds": [
              "EXO.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛn luuri tɔ̱ bia ma̱a̱t tɔ̱, bikɛ la luuri dääpä, kɛnɛ ciɛk in bo̱r kɛ ciɛk in yian, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.3",
            "verseOrgIds": [
              "EXO.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ bieyni tin yiël, kɛnɛ bieyni tin mɛ̈ri kɛ bieyni tin dööli kɛ bieyni ti bo̱o̱r ti ca lathdiɛn mɛn agɔaa, kɛ mi̱em böwni, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.4",
            "verseOrgIds": [
              "EXO.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ tuac rɔɔmni ti ca bil kɛ biɛl mi lual, kɛ guɔ̱p mi puɔth puɔth, kɛ jiath thëëp, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.5",
            "verseOrgIds": [
              "EXO.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ liɛɛth lɛmbärni, kɛ juaac ti kuɔ̱r kuɔ̱ɔ̱r kɛ kui̱ liɛth yi̱rä, kɛnɛ kui̱ jiɛn tin la tuɔ̱ɔ̱lkɛ due̱l kɛ kui̱ ŋuänyä mi gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.6",
            "verseOrgIds": [
              "EXO.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ dɔ̱a̱k ti puath puaath kɛ kui̱ bööth palä min di̱t ni jɛn, kɛ gaakni kɛ kui̱ biey gɔ̱rädɛ in te kathdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.7",
            "verseOrgIds": [
              "EXO.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akɛ la̱tkɛ ɣä kä gua̱a̱th mi bä ben cieŋ thi̱n rɛydiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.8",
            "verseOrgIds": [
              "EXO.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia due̱lä la̱t ni kɛ pe̱k kä ti diaal tin bä nyuɔ̱th yɛ kɛ la̱tdɛ amäni pääpnikɛ diaal.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thanduk matdä ruac Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.9",
            "verseOrgIds": [
              "EXO.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Täämɛ bikɛ thanduk täth kɛ thep. Bi bärɛ piny a jua̱th te̱tni da̱ŋ rɛw kɛ nuth. Kä bi bap baapdɛ kɛn ɣäp ɣääpdɛ a juäth tetdä kɛ nuth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.10",
            "verseOrgIds": [
              "EXO.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia jɛ cu rɔth kɛ da̱a̱p mi lɛy lɛy rɛc ɔ kɛnɛ jɔk ɔ. Kä bia wi̱cdɛ ta̱th thɛɛr mi ca rɔth kɛ da̱a̱p kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.11",
            "verseOrgIds": [
              "EXO.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täthni jɛ ciik dääpä da̱ŋ ŋuaan, kä bi kɛ la̱th ciöknikɛ da̱ŋ ŋuaan, ciik rɛw kui̱ydɛ kui̱c kɛl, kɛ ciik rɛw kui̱ydɛ kui̱c in dɔ̱diɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.12",
            "verseOrgIds": [
              "EXO.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gäk nikɛ da̱ŋ rɛw bikɛ la to̱ŋ thëëp, kä bi kɛ rɔth kɛ da̱a̱p. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.13",
            "verseOrgIds": [
              "EXO.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi kɛ cuɔt kɛ rɛy ciikni tin te ŋɛpni thandukä, kɛ ɣöö ba jɛ la kapkɛ kɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.14",
            "verseOrgIds": [
              "EXO.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi to̱ŋ ɛ tɔ̱ a te rɛy ciikni, /ca kɛ bi ka̱m raar puɔ̱ɔ̱nydɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.15",
            "verseOrgIds": [
              "EXO.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi lueek matdä ruac ti bä ka̱m ji̱ kuëŋ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.16",
            "verseOrgIds": [
              "EXO.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi kum la̱t kɛ ciɛk mi da̱a̱p. Bi bärɛ piny a jua̱th te̱tni da̱ŋ rɛw kɛ nuth. Bi riewdɛ a juäth tetdä kɛl kɛ nuth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.17",
            "verseOrgIds": [
              "EXO.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täth pua̱ny da̱ŋ rɛw ti ce̱tkɛ pua̱ny ja̱a̱kni kɛ da̱a̱p mi bia dɛŋ kɛ de̱y, kä ba kɛ la̱th tuɔ̱ŋni kuumä da̱ŋ rɛw, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.18",
            "verseOrgIds": [
              "EXO.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "täth kɛl pe̱e̱k kɛl, kä täth min dɔ̱diɛn pe̱e̱k in dɔ̱ŋ. Bia kɛn da̱ŋ rɛw ta̱th pëkni kuumä da̱ŋ rɛw kɛ jɛn cäŋ ɔ kɛl ɔ cia tääth ni kum ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.19",
            "verseOrgIds": [
              "EXO.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi pua̱ny tɔ̱tɔ̱ gɔ̱kiɛn ɣa̱r wi̱i̱dɛ, bi kɛ kum ɛmɔ ku yi̱k piny kɛ gɔ̱kiɛn kä cikɛ nhiamdiɛn röm, kukɛ kum lɛ guɛc piny. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.20",
            "verseOrgIds": [
              "EXO.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia pääm lueekni tɔ̱ bä ka̱m yɛ tɔ̱ cu la̱th rɛydɛ. Bia kum cu kuëŋ wi̱i̱dɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.21",
            "verseOrgIds": [
              "EXO.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔmɔ ɛ jɛn gua̱a̱th in bä jek kɛ yɛ thi̱n bi jɔwdä päl raar kɛ wi̱c kumä kɛ kam pua̱nyni da̱ŋ rɛw tin te wi̱i̱ thandukä lueekni. Ɣän bä ruac kɛ ji̱ kɛ kui̱ ŋuɔ̱tni diaal tin bä ŋun kɛ kui̱ ji̱ I-thɛ-rɛl.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tharbët mi̱eth mi lɛy rɔ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bia tharbët täth kɛ jiath thëëp. Bi bärɛ piny a jua̱th te̱tni da̱ŋ rɛw, kä bi riewdɛ a juäth tetdä kɛl. Kä bi bärɛ nhial a juäth tetdä kɛ nuth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.23",
            "verseOrgIds": [
              "EXO.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia jɔkdɛ rɔth kɛ da̱a̱p mi lɛy lɛy. Bia wi̱cdɛ moc thɛɛr mi ca rɔth kɛ da̱a̱p kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.24",
            "verseOrgIds": [
              "EXO.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia rɛ̈l la̱t thɛɛrädɛ kä bi pät päätdɛ pa̱a̱r kɛ pät tetdä, kɛ thɛɛr mi ca rɔth kɛ da̱a̱p ŋɛpnikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.25",
            "verseOrgIds": [
              "EXO.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia jɛ ta̱th ciik da̱ŋ ŋuaan kɛ da̱a̱p. Bia kɛ la̱th peknikɛ da̱ŋ ŋuaan tin ca ciökɛ pua̱t thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.26",
            "verseOrgIds": [
              "EXO.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi ciik thiek kɛ rɛ̈l thɛɛrä min la to̱ŋ ti kapkɛ tharbët a cuɔtkɛ thi̱n ɛ ka̱a̱p. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.27",
            "verseOrgIds": [
              "EXO.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia to̱ŋ tɔ̱tɔ̱ jɔp jiaath mi ŋue̱r, kä bia kɛ rɔth kɛ da̱a̱p. Kä ba tharbët a kapkɛ kɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.28",
            "verseOrgIds": [
              "EXO.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta̱thɛ jɛ thän ti tataal, kɛ liir kɛ buɔ̱li kɛ took ti ba la tiɛthkɛ ni luuri pi̱i̱ni dɛɛni wal piny, kɛ ti ba la waŋkɛ ni wal kɛ kui̱ tulä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.29",
            "verseOrgIds": [
              "EXO.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia mi̱eth mi lɛy rɔ la̱th wi̱i̱ tharbëtdä gua̱thni diaal.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cuuŋ lɛmbärä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bia mi la cuɔ̱ŋkɛ lɛmbär thi̱n täth kɛ da̱a̱p mi lɛy lɛy. Bia thääkɛ täth kɛnɛ leerikɛ kɛ taŋdɛ, kä bi kɛn diaal te yieethä mɔ kɛl ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.31",
            "verseOrgIds": [
              "EXO.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ tekɛ kar bäkɛl ti ba rɔ̱ rɛ̈k kui̱cnikɛ diaal. Bi diɔ̱k kä ti la cuɔ̱ŋkɛ lɛmbär thi̱n te kui̱c kɛl, kä bi kar diɔ̱k kɔ̱kiɛn te kui̱c in dɔ̱diɛn a ca rɔ̱ go̱k ce̱t tuɔ̱ŋ yaaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.32",
            "verseOrgIds": [
              "EXO.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ tekɛ thääk da̱ŋ diɔ̱k ti ca la̱t ce̱tkɛ tual kɛl kä te tharɛ kɛnɛ gaaknikɛ wi̱i̱ tuɔ̱ɔ̱ŋ kɛl, kɛ thääk da̱ŋ diɔ̱k kɔ̱kiɛn kɛ thärkiɛn wi̱i̱ tuɔ̱ɔ̱ŋ in dɔ̱diɛn. Kɛn kar da̱ŋ bäkɛl bikɛ cuɔ̱ŋ inɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.33",
            "verseOrgIds": [
              "EXO.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn taŋ lɛmbärä puɔ̱nydɛ bɛ tekɛ thääk da̱ŋ ŋuaan ti ca täth kɛ ta̱a̱ tuaali kɛ thärkiɛn kɛɛl kɛnɛ gaaknikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.34",
            "verseOrgIds": [
              "EXO.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi rɛw thakdiɛn a kɛl kä kɛn kar da̱ŋ bäkɛl tin ca rɔ̱ rɛk puɔ̱ɔ̱ny taŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.35",
            "verseOrgIds": [
              "EXO.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba thääkiɛn kɛnɛ karkiɛn dɛŋ kɛ jɛn yieeth ɛ kɛl ɔ. Ɛn nɔmɔ kɛɛliw ba dɛŋ dääpä mi lɛy lɛy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.36",
            "verseOrgIds": [
              "EXO.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia lɛmbärni da̱ŋ bärɔw täth kɛ kui̱dɛ, kä ba kɛ dɔp kɛ ɣöö bikɛ nhiamdɛ mɛr. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba tin la tɛ̈ŋkɛ ŋɛ̈thdɛ thi̱n täth kɛ da̱a̱p mi lɛy lɛy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia min la cuɔ̱ŋkɛ lɛmbär thi̱n amäni nyinkɛ diaal tin jäl kɛ jɛ kɛɛl täth kɛ theemni dääpä ti jiɛn diɔ̱k wi̱cdɛ dhieec ki̱i̱lugram.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:39",
              "type": "text"
            },
            {
              "text": "Ki̱i̱lugram",
              "type": "text"
            },
            {
              "text": "Lotdɛ ni ɣöö ce̱t thiakdɛ kɛ tha̱a̱ŋ thiekä ran.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tit ɛ, mi ca la̱t kɛ jɛn la̱t ëë ca nyuɔ̱th ji̱ wi̱i̱ pa̱a̱m.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
            "verseOrgIds": [
              "EXO.25.40"
            ]
          }
        }
      ]
    }
