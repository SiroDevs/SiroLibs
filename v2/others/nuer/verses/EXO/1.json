  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EXO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya̱k gan I-thɛ-rɛl kä I-jëp",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ti̱ti̱ kɛ ciööt gan Je-kɔb tëë ci ben ro̱o̱l I-jëp kɛɛl kɛ gua̱ndiɛn, cukɛ ben ram ɔ kɛ ji̱ gɔaalɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1",
            "verseOrgIds": [
              "EXO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn, ɛ Rɛ-u-ben kɛ Cim-on, Lii-bay kɛ Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.2",
            "verseOrgIds": [
              "EXO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi-tha-kar kɛ Dhɛ-bu-lun, kɛ Ben-ya-min, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.3",
            "verseOrgIds": [
              "EXO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daan kɛnɛ Nap-ta-li, kɛ Gad kɛnɛ A-cɛr. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.4",
            "verseOrgIds": [
              "EXO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɛ mɔ, pek kari Je-kɔb diaal kɛ jiɛn bärɔw. Kä ci Jo-thɛp ku thuŋ wä kä I-jëp.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:5",
              "type": "text"
            },
            {
              "text": "Tuk 46:27, Lät 7:14.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔrɛ cu Jo-thɛp li̱w kɛnɛ dämani diaal, kɛ ri̱c ɛmɔ kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.6",
            "verseOrgIds": [
              "EXO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ I-thɛ-rɛl rɔ̱ di̱eth, cukɛ rɔ̱ re̱p kɛ rëp mi di̱i̱t, kä cukɛ buɔ̱m jek kä cu mun I-jëp thia̱a̱ŋ kɛ kɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
            "verseOrgIds": [
              "EXO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.7",
            "verseOrgIds": [
              "EXO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu I-jëp lɛ tekɛ kuäär mi thil mi ŋäcɛ kɛ kui̱ Jo-thɛp, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.8",
            "verseOrgIds": [
              "EXO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "jɛn kuäär ɛmɔ, cuɛ nɛɛkɛ ku jiök i̱, “Nɛ̈nɛ jɛ, kɛn ji̱ I-thɛ-rɛl ti̱ti̱ cikɛ kɔn le̱ny kɛ ŋuan kɛnɛ buɔ̱m ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.9",
            "verseOrgIds": [
              "EXO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuanɛ kɛ ciɛŋ ni pɛlä amäni mi de̱e̱kɛ yi̱k ŋuan, kä mi wä kɔn tëë ko̱r kɛ nɛy kɔ̱kiɛn bikɛ rɔ̱ ma̱t ji̱ tɛ̈ran, bikɛ nyiëëny kɛ kɔn kä bikɛ cu jiɛn muundan.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.10",
            "verseOrgIds": [
              "EXO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, cu ji̱ I-jëp kɛ kue̱ny kua̱r lätni ti jiäk kɛ ɣöö bikɛ kɛ ciɛŋ kɛ ciaŋ mi bɛc bɛc kɛ muɔ̱cdiɛn la̱t mi thiɛk ɛlɔ̱ŋ, kä cu ji̱ I-thɛ-rɛl Pɛro ta̱th rɛ̈k tɔ̱wä ŋɔaani, rɛk mi cɔal i̱ Pi-thom kɛnɛ rɛk mi cɔal i̱ Ra-mɛ-theth. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.11",
            "verseOrgIds": [
              "EXO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guäth in kua lɛ wee mi muɔckɛ kɛ riɛk mi di̱i̱t, bikɛ gul tuɔ̱ɔ̱l kɛ mi wäkɛ kɛ ŋuan, kä tuɔ̱l ni kɛn kɛ mi thia̱ŋkɛ piny, kä cu ji̱ I-jëp dual kɛ ji̱ I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.12",
            "verseOrgIds": [
              "EXO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, cukɛ ji̱ I-thɛ-rɛl jak kä lät thil lɔ̱a̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.13",
            "verseOrgIds": [
              "EXO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ ciaaŋdiɛn jak kä bɛc kɛ la̱t mi bumbum, nyiöp muɔ̱ɔ̱n kɛnɛ la̱t tuɔpni kɛ lät diaal tin lät kɛn kɛ rɛy ka̱a̱kni, la jakɛ kɛ kä lätkɛ a thil lɔ̱a̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.14",
            "verseOrgIds": [
              "EXO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɔ, cu kuäär I-jëp män tin ga̱a̱m mään Ɣi-bɛ-ru ciɛk mi cuɔl i̱ Cip-raa kɛnɛ ciɛk mi cuɔl i̱ Pua jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.15",
            "verseOrgIds": [
              "EXO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wiaa män ji̱ Ɣi-bɛ-ru la gamɛ, kä bia kɛ nɛn dapkɛ ni dhɔɔl, mi wa dhɔl na̱kɛ jɛ kä mi wa nyal pa̱lɛ jɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.16",
            "verseOrgIds": [
              "EXO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ga̱a̱m mään tɔ̱tɔ̱ cukɛ Kuoth luɔ̱th, /kenkɛ lät ce̱tkɛ min ci kuäär I-jëp ɛ gi̱k kɛ, cukɛ dho̱li dhɔɔli jak kä tëk. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.17",
            "verseOrgIds": [
              "EXO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ kä nɔmɔ, cu kuäär I-jëp ga̱a̱m mään tɔ̱tɔ̱ jak kä cɔalkɛ, mëë ca kɛ cɔl, cuɛ kɛ jiök i̱, “Ɛŋu la̱tdɛ inɔ mɔ a bia dho̱li dhɔɔli jak kä tëk?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.18",
            "verseOrgIds": [
              "EXO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ga̱a̱m mään tɔ̱tɔ̱ thok pɛro loc, cukɛ wee i̱, “Män ji̱ Ɣi-bɛ-ru /cikɛ ce̱tkɛ män ji̱ I-jëp, kɛ ɣöö puɔl pua̱nykiɛn, kä lakɛ cua dap a /ken gääm ni cop kä kɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.19",
            "verseOrgIds": [
              "EXO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ Kuoth cuɛ lät gɔaa kɛ ga̱a̱m mään tɔ̱tɔ̱, kä cu naath rɔ̱ di̱eth a cukɛ ŋuan kä cukɛ buɔ̱m jek. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.20",
            "verseOrgIds": [
              "EXO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ni kɛ ɣöö ci ga̱a̱m mään tɔ̱tɔ̱ Kuoth luɔ̱th, cu kuoth kɛ ka̱m gaatkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.21",
            "verseOrgIds": [
              "EXO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu pɛro nɛɛkɛ diaal cu gok, kä cuɛ kɛ jiök i̱, “Yɛn bia dho̱li dhɔɔli diaal tin ba di̱eth ɛ ji̱ Ɣi-bɛ-ru yuɔr kiir kä bia dho̱li nyieet diaal päl a tëk.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.22",
            "verseOrgIds": [
              "EXO.1.22"
            ]
          }
        }
      ]
    }
  ],
