            "verseOrgIds": [
              "DAN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bel-ca-dhar ruac ja̱k kä cua Da-ni-yel rony kɛ bi̱i̱ mi di̱t kökdɛ kä cua ŋuäkdɛ moc kɛ kuat dääpä, kä cua ruac lat kɛ kui̱dɛ, kä cua jɛ jakä diɔ̱ɔ̱k nath rɛy kuäärä.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.29",
            "verseOrgIds": [
              "DAN.5.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.29",
            "verseOrgIds": [
              "DAN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ jɛn wäär ɛ mɔ pa̱ny cua Bel-ca-dhar kuäär ji̱ Bɛ̈-bi-lɔn näk. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
              "DAN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dɔr-ya-wɛc raan Ma-day kuäär ka̱n, kä tëë kɛ run ti jiɛn bäkɛl wi̱cdɛ rɛw.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.31",
            "verseOrgIds": [
              "DAN.5.31"
            ]
          }
        }
      ]
