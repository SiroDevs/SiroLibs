          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "dhɔr Ɛdhra cua Mɛ-cu-lam, dhɔr Ä-mɛ̈r-yaa cua Yɛ-ɣo-ɣa-nan,",
          "type": "text",
          "attrs": {
