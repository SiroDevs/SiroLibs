    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciööt bööthni palä kɛnɛ ji̱ Lii-bay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ bööth palä kɛnɛ ji̱ Lii-bay tëë luny jɔk kɛɛl kɛ Dhɛ-ru-ba-bɛl gat Cɛ-ɛ̈l-ti-el kɛnɛ Yɛ-cuwä. Thɛ-ra-yaa kɛnɛ Yir-mɛ-yaa kɛ Ɛdhra, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ä-mɛ̈r-yaa kɛnɛ Mɛ̈l-uk kɛ Ɣɛ̈-tuc, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.2",
            "verseOrgIds": [
              "NEH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Cɛ-bɛ̈n-yaa kɛnɛ Rɛ-ɣum kɛ Mɛ-re-moth, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.3",
            "verseOrgIds": [
              "NEH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ido kɛnɛ Gi-ne-thoy kɛ Ä-bi-yaa, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.4",
            "verseOrgIds": [
              "NEH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Mi-ya-min kɛnɛ Mad-yaa kɛ Bil-gaa, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.5",
            "verseOrgIds": [
              "NEH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Cɛ-mɛ̈-yaa kɛnɛ Yo-ya-rib kɛ Yɛ-dɛ̈-yaa, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.6",
            "verseOrgIds": [
              "NEH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Thɛ̈lu kɛnɛ A-mok kɛ Ɣil-ki-yaa kɛ Yɛ-dɛ̈-yaa. Cu tɔ̱tɔ̱ a kɛn bööth bööthni palä kɛ gaatmani kɛ ni̱n Yɛ-cuwä.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.7",
            "verseOrgIds": [
              "NEH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.7",
            "verseOrgIds": [
              "NEH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ti̱ti̱ a ji̱ Lii-bay. Yɛ-cuwä kɛnɛ Bi-nuwi kɛ Kɛ̈d-mi-el kɛnɛ Ce-reb-yaa kɛ Juda kɛnɛ Mɛ̈-tɛ̈n-yaa kɛnɛ gaatman cu ka këët din kɛ kui̱ tɛthkä lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.8",
            "verseOrgIds": [
              "NEH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bak-bu-ki-yaa kɛnɛ Uno kɛ gaatmani lotädiɛn ga̱a̱mkɛ rɔ̱.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaat bo̱o̱thä palä ni Yɛ-cuwä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yɛ-cuwä a gua̱n Yo-ya-kim kä cu Yo-ya-kim a gua̱n Ɛl-ya-cib kä cu Ɛl-ya-cib a gua̱n Yo-ya-da, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Yo-ya-da a gua̱n Jo-na-than, kä cu Jo-na-than a gua̱n Ya-duwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bööth dho̱ri bööthni palä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
