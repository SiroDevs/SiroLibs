            },
            {
              "text": "Ica 66:24.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn ‘Gua̱a̱th in /ci lɔa̱a̱t li̱w thi̱n, kä /ci mac bi met yieny.’",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.48",
