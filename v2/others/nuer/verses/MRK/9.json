              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.41",
            "verseOrgIds": [
              "MRK.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ram mɔ bi gat kɛl kä tiɛtni tin ŋa̱thkɛ ɣä jak kä dui̱r, bi gɔaa ni ɣöö ba päm gua̱r bɛɛl mi di̱i̱t yian ŋuäkdɛ ɛn ram ɛmɔ, kä ba jɛ yuɔr däär baar. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.42",
            "verseOrgIds": [
              "MRK.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ci tetdu ji̱ jak kä dui̱r, ŋok ɛ, kɛ ɣöö gɔaa ni jɛn kɛ ji̱ ɛn ɣöö bi wä teekä a ti̱i̱ kɛ tet kɛl, kä wädu maac mi /ca dee yieny kɛ tet da̱ŋ rɛw. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.43",
            "verseOrgIds": [
              "MRK.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn gua̱a̱th in /ci lɔa̱a̱t li̱w thi̱n, kä /ca mac bi met yieny.]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.44",
            "verseOrgIds": [
              "MRK.9.44"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:44",
              "type": "text"
            },
            {
              "text": "Kɛn ka̱a̱th da̱ŋ rɛw ti̱ti̱ 44 kɛnɛ 46 ba ben mat nikɛ thi̱n. Kä tha̱a̱ŋ buɔkni tëë wal thilɛ kɛ thi̱n.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.44",
            "verseOrgIds": [
              "MRK.9.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ci cio̱o̱kdu ji̱ jak kä dui̱r, ŋok ɛ, kɛ ɣöö gɔaa ni jɛn kɛ ji̱ ɛn ɣöö bi wä teekä ŋo̱o̱tdä, kä yoru guäth maac mi thil pek kɛ ciök da̱ŋ rɛw. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.45",
            "verseOrgIds": [
              "MRK.9.45"
            ]
          }
        },
        {
          "name": "verse",
