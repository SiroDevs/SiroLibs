  "verseCount": 50,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "MRK 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yecu kɛ jiök i̱, “Ɛpuc, ɣän la̱rä jɛ yɛ, tëëkɛ tha̱a̱ŋ nath ti te cuŋä ɛn wanɛ mɛ, ti /ca lia̱a̱ bi nɛn amäni mi ci kuäär Kuɔth ben kɛ buɔ̱m.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.1",
            "verseOrgIds": [
              "MRK.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luɔ̱c Pua̱ny Yecu kɛ rɔ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.1",
            "verseOrgIds": [
              "MRK.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr ni̱ni da̱ŋ bäkɛl cu Yecu Pi-tɔr kɛnɛ Je-mɛth kɛ Jɔ̱ɔ̱n naŋ kɛ jɛ kɛɛl. Cuɛ kɛ böth wi̱i̱ pa̱a̱m mi bäär, gua̱a̱thdiɛn kärɔ, kä cua puɔ̱nydɛ loc nhiamdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.2",
            "verseOrgIds": [
              "MRK.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu bieynikɛ buay ɛ pak a cukɛ riaw ɛlɔ̱ŋ, mi thilɛ ram mi dee kɛ lak inɔ wi̱i̱ muɔ̱ɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.3",
            "verseOrgIds": [
              "MRK.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu E-li-yaa kɛnɛ Muthɛ päl nhiamdiɛn, ruackɛ kɛ Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.4",
            "verseOrgIds": [
              "MRK.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Pi-tɔr Yecu jiök i̱, “Ŋi̱i̱c, gɔaaɛ ɛn ɣöö ta̱kɔ wanɛ mɛ, a kɔ la̱tkɔ bi̱lɛni da̱ŋ diɔ̱k, bi kɛl a duŋdu, kɛl ɛ duŋ Muthɛ, kä kɛl ɛ duŋ E-li-yaa.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.5",
            "verseOrgIds": [
              "MRK.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö kui̱cɛ min derɛ lar, kɛ ɣöö cikɛ dual ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.6",
            "verseOrgIds": [
              "MRK.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu pua̱r kɛ kuɔ̱m piny, kä cu jɔw ben rɛy puɔ̱rä ruacɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.7",
            "verseOrgIds": [
              "MRK.9.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:7",
              "type": "text"
            },
            {
              "text": "Diit 2:7, Tuk 22:2, Ŋuɔ̱t 18:15.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nɛmɛ ɛ jɛn Gatdä min nhɔakä, liɛŋɛ ruacdɛ!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.7",
            "verseOrgIds": [
              "MRK.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ni ɛn guäth ɛmɔ min cikɛ gui̱c kui̱cni diaal, cuɛ thil ram mi cu kɛn ɛ nɛn kɛɛl kɛ kɛ ɛ ni Yecu kärɔa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.8",
            "verseOrgIds": [
              "MRK.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.8",
            "verseOrgIds": [
              "MRK.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min bäkɛ piny wi̱i̱ pa̱a̱m, cuɛ kɛ gok i̱ thilɛ radɔ̱diɛn mi bi kɛn ɛ la̱r min ci kɛn ɛ nɛn, amäni kɔr kä mi ca Gat Ran jiɛn li̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.9",
            "verseOrgIds": [
              "MRK.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ biɛt kɛ jɛ, duundɛ ɣöö cukɛ thiec kɛ mɔ dee jiec ran, kɛ rɔ li̱th lat ni ŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.10",
            "verseOrgIds": [
              "MRK.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jɛ thiec i̱, “Ɛŋu laar ji̱ gɔ̱rkä jɛ mɔ i̱, ‘Bi E-li-yaa ben kɛ nhiam?’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.11",
            "verseOrgIds": [
              "MRK.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ loc i̱, “Ɛpuc, bi E-li-yaa dhil ben kɛ nhiam, kɛ ɣöö bɛ ŋɔak diaal ben rialikä. Kä kua jɛ lɛ gɔ̱r i̱di kɛ kui̱ Gatdä Ran, ɛn ɣöö bɛ ti bɛ̈c bɛ̈ɛ̈c ti ŋuan rut, kä ba jɛ yak ɛ naath? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.12",
            "verseOrgIds": [
              "MRK.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän la̱rä jɛ yɛ ɛn ɣöö ci E-li-yaa ku thuŋ ben, kä ci naath ɛ lät kä min nhɔk kɛn ɛ, ce̱tkɛ min ca gɔ̱r kɛ kui̱dɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.13",
            "verseOrgIds": [
              "MRK.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jak Yecu kɛ dho̱o̱l mi tekɛ yiëë mi jiääk kä gɔaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.13",
            "verseOrgIds": [
              "MRK.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cikɛ ben kä ji̱ kɔaarɛ, cukɛ buɔ̱n nath mi di̱i̱t nɛn gekädiɛn, kä ŋak ji̱ gɔ̱rkä ŋaknɔm kɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.14",
            "verseOrgIds": [
              "MRK.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu naath diaal ga̱a̱c ɛlɔ̱ŋ, mëë cikɛ Yecu nɛn, kä cukɛ riŋ, cukɛ jɛ wä ner. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.15",
            "verseOrgIds": [
              "MRK.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ thiec i̱, “Ŋakɛ ni ŋu kɛ kɛ?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.16",
            "verseOrgIds": [
              "MRK.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ram kɛl kä buɔ̱n ɛ loc i̱, “Ŋi̱i̱c, cä gatdä nöŋ ji̱, kɛ ɣöö tëëkɛ yiëë mi jiääk mi jak jɛ kä /ci ruac. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.17",
            "verseOrgIds": [
              "MRK.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɔ cɛ jɛ käpɔ, la duäcɛ jɛ piny, kä bi thokdɛ te guɔ̱p, kä bɛ lɛckɛ moth, kä bɛ puɔ̱nydɛ ri̱l. Kä cä ruac kɛ ji̱ kɔaaru, kɛ ɣöö bikɛ jɛ woc, kä /ken kɛn ɛ luäŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.18",
            "verseOrgIds": [
              "MRK.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yecu kɛ loc, “Yɛn, ri̱c mi thil ŋa̱th, bä te kɛɛl kɛ yɛ kɛ gua̱a̱th mi ni̱n di? Kä ɛ gua̱a̱th mi ni̱n di mi bä rut ni yɛ? Nöŋɛ jɛ ɣä.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.19",
            "verseOrgIds": [
              "MRK.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ dho̱o̱l nöŋ jɛ, kä mëë ci yiëë in jiääk Yecu nɛn, ni ɛn guäth ɛmɔ cuɛ dho̱o̱l käp, kä cuɛ tɛɛth, cuɛ rɔ daŋ piny a te thokdɛ kɛ guɔ̱p. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.20",
            "verseOrgIds": [
              "MRK.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yecu gua̱n dhöl thiec i̱, “Cɛ jääny kɛ juey ɛmɛ kɛ pek mi ni̱n di?” Kä cuɛ jɛ loc i̱, “Kääpɛ jɛ ni gaatädɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.21",
            "verseOrgIds": [
              "MRK.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ tɛth maac kɛnɛ rɛy pi̱i̱ni kä ti ŋuan, kɛ ɣöö bɛ jɛ näk. Mi tëëkɛ mi deri luäŋ, a lɔcdu kɔ̱c kɛ kɔ, kä luäk kɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.22",
            "verseOrgIds": [
              "MRK.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yecu jɛ jiök i̱, “Mi ti̱i̱kɛ lua̱ŋ! Ŋɔak diaal dëë kɛ lät kä ram mi tekɛ ŋa̱th.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.23",
            "verseOrgIds": [
              "MRK.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ɛn guäth ɛmɔ cu gua̱n gatdä yɔal, wëë i̱, “Ɣän ŋa̱thä, kä luäk ɣä kɛ thil ŋäthädä.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.24",
            "verseOrgIds": [
              "MRK.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Yecu jɛ nɛn ɛn ɣöö bä buɔ̱n kɛɛl kɛ wuɔ̱ɔ̱r, cuɛ yiëë in jiääk luek, jio̱kɛ jɛ i̱, “Ji̱n, yiëë in ci dho̱o̱l ɛmɛ pën ruac kɛnɛ li̱eŋ, ɣän la̱tdä ji̱ ruac, bër raar puɔ̱nydɛ, kä /cu rɔɔdu nyɔk kɛ loc kä jɛ!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.25",
            "verseOrgIds": [
              "MRK.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu yiëë in jiääk wak, cuɛ dho̱o̱l ɛmɔ dhur ɛlɔ̱ŋ, kä cuɛ ben raar puɔ̱nydɛ, kä cu dho̱o̱l ɛmɔ muɔn, cuɛ ce̱tkɛ mi cɛ li̱w. Kä cu ri̱w nath wee i̱, “Cɛ li̱w.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.26",
            "verseOrgIds": [
              "MRK.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yecu tetdɛ käp, kä cuɛ jɛ jiac nhial, kä cuɛ rɔ jiɛc. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.27",
            "verseOrgIds": [
              "MRK.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Yecu ben dueel, cu ji̱ kɔaarɛ jɛ thiec a tekɛ kärɔ̱ i̱, “Ɛŋu /ka̱n kɔ jɛ luäŋ kɛ käm raar ɔ?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.28",
            "verseOrgIds": [
              "MRK.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ kɛ jiök i̱, “Mi ce̱tkɛ nɛmɛ ka̱mkɛ jɛ raar kɛ pal kärɔa.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.29",
            "verseOrgIds": [
              "MRK.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyɔak ruac Yecu kɛ kui̱ li̱ethdɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.29",
            "verseOrgIds": [
              "MRK.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yecu gua̱a̱th ɛmɔ ba̱ny piny cukɛ räth nhiam, cukɛ wä rët kɛ Gɛ̈-lɛ-li, kä lo̱kɛ jɛ ɛn ɣöö dee raan ɛ ŋa̱c, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.30",
            "verseOrgIds": [
              "MRK.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö ŋi̱i̱cɛ ji̱ kɔaarɛ, jio̱kɛ kɛ i̱, “Ba Gat Ran kɔak tetni nath, kä bikɛ jɛ näk, kä mi ca jɛ näk bɛ rɔ nyɔk kɛ jiɛɛn li̱th kɛ kɔr ni̱ni da̱ŋ diɔ̱k.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.31",
            "verseOrgIds": [
              "MRK.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö /ken ruac ëë cɛ la̱rkɛ cop lo̱cnikiɛn, kä dualkɛ kɛ ɣöö ba jɛ thiec.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.32",
            "verseOrgIds": [
              "MRK.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Di̱t ni ŋa ɛlɔ̱ŋ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.32",
            "verseOrgIds": [
              "MRK.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ ben kä Ka-pɛr-ni-äm. Mëë cikɛ wä dueel, cuɛ kɛ thiec i̱, “Ŋakɛ ni ŋu dup ɛ ni?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.33",
            "verseOrgIds": [
              "MRK.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö cukɛ biɛt ɛtil, kɛ ɣöö ruackɛ kärɔ̱ dup, ɛn ɣöö di̱t ni ŋa kä kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.34",
            "verseOrgIds": [
              "MRK.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ nyuur, kä cuɛ jaakɛ da̱ŋ wäl rɛw cɔl, kä cuɛ kɛ jiök i̱, “Mi tëë ram mi go̱o̱r ɣöö bi a bo̱o̱th, bɛ la ram in jɔakdiɛn kä ba kuany nɛɛni diaal.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.35",
            "verseOrgIds": [
              "MRK.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ gat mi tɔt ka̱n, cuɛ jɛ cuŋ nhiamdiɛn. Mëë cɛ jɛ kul kɛ tetdɛ, cuɛ kɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.36",
            "verseOrgIds": [
              "MRK.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ram mi nyuur gat kɛl mi ce̱tkɛ nɛmɛ kɛ ciötdä nyuurɛ ni ɣä. Kä ram mi nyuur ɣä, nyuurɛ ni ram ëë jäk ɣä.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.37",
            "verseOrgIds": [
              "MRK.9.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ram mi /ci gua̱c kɛ kɔn ɛ raandan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.37",
            "verseOrgIds": [
              "MRK.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Jɔ̱ɔ̱n jiök i̱, “Ŋi̱i̱c, cakɔ ram kɛl mi tuk yiey ti jiäk raar kɛ ciötdu nɛn, kä cua kɔ jɛ pën, kɛ ɣöö /cɛ guur ni kɔn.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.38",
            "verseOrgIds": [
              "MRK.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yecu kɛ jiök i̱, “/Cuarɛ jɛ pen, kɛ ɣöö thilɛ ram mi lät ti buɔ̱m buɔ̱ɔ̱m kɛ ciötdä, mi dee mi jiäk lat kɛ kui̱dä kɛ kɔr gua̱th mi tɔt. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.39",
            "verseOrgIds": [
              "MRK.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ram mi /ci tɛr kɛ kɔn, ɛ raandan pa̱ny. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.40",
            "verseOrgIds": [
              "MRK.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛpuc, ɣän la̱rä jɛ yɛ, ram ɔ bi yɛ moc pi̱ ti mathɛ mɔ, kɛ ɣöö lapɛ nɛɛ Kritho, bɛ muc mi gɔaa jek.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.41",
            "verseOrgIds": [
              "MRK.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tin ɣɔamkɛ naath dui̱rä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
