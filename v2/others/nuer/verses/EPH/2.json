{
  "id": "EPH.2",
  "number": "2",
  "bookId": "EPH",
  "reference": "Ɛpɛ 2",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
