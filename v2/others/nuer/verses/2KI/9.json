  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "2KI 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kueny Yeɣu ala kuäär I-thɛ-rɛl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gök ni Ɛ-li-cä ram kɛl cɔl kä gaat göökni kä cuɛ jiök i̱, “Yiɛni bi̱i̱du lɛdu, käni ɣök liɛth kɛ ji̱ kɛɛl, kä wër kä Ra-moth-gil-yad. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.1",
            "verseOrgIds": [
              "2KI.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wi̱i̱ wä cop, go̱r Yeɣu gat Yo-ca-pat gat Nim-ci. Cɔlɛ rɛy nɛɛnikɛ kä wiaa duëël in te nhial rɛci. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.2",
            "verseOrgIds": [
              "2KI.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä wocni liɛɛth wi̱i̱dɛ, kä wër i̱, ‘Ci Kuoth Nhial ɛ lar i̱ bi̱i̱ yi̱r ala kuäär ka I-thɛ-rɛl.’ Kä lɛp thi̱i̱k kä riŋni kɛ pɛ̈th /cu gal.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.3",
            "verseOrgIds": [
              "2KI.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.3",
            "verseOrgIds": [
              "2KI.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gök ŋuɛ̈tdä wä kä Ra-moth-gil-yad. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.4",
            "verseOrgIds": [
              "2KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min cɛ cop, cuɛ bööth rɛm jek duɔlkɛ. Kä cuɛ wee “Ta̱a̱kɛ ruac mi la̱tdä ji̱, lö bo̱o̱th.” Kä cu Yeɣu ɛ loc i̱, “Ɛŋa kä kɔ?” Kä cuɛ loc i̱, “Ɛ ji̱n lö bööth.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.5",
            "verseOrgIds": [
              "2KI.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ rɔ jiɛc kä cuɛ wä duëël. Kä cu ŋuɛ̈t liɛɛth wuɔc wi̱i̱dɛ kä jio̱kɛ jɛ i̱, “Laar Kuoth Nhial Kuoth I-thɛ-rɛl ɛ i̱ bä ji̱ yi̱r ala kuäär nɛɛni Kuɔth Nhial kä I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.6",
            "verseOrgIds": [
              "2KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi dhɔr Ɛ̈-ɣab kuääru däk, kɛ ɣöö bä riɛm göökni kä, kɛnɛ nɛɛkä diaal tëë ca näk ɛ I-dhɛ-bɛl col. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.7",
            "verseOrgIds": [
              "2KI.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bi dhɔr Ɛ̈-ɣab thuɔ̱m kɛɛliw. Kä bä tut diaal tin ca dap dhɔr Ɛ̈-ɣab woc kä I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.8",
            "verseOrgIds": [
              "2KI.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä dhɔrɛ jak kä ce̱tkɛ dhɔr Ya-rɔ-baam gat Nɛ-bat, kɛnɛ dhɔr Bɛ̈ca gat Ä-ɣi-yaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.9",
            "verseOrgIds": [
              "2KI.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi jio̱o̱k ri̱ŋ I-dhɛ-bɛl cam rɛy cieŋ Yidh-rɛɛl, kä thilɛ ram mi bi jɛ kony.” Kä cuɛ thi̱i̱k lɛp kä cuɛ rɔ bar.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.10",
            "verseOrgIds": [
              "2KI.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.10",
            "verseOrgIds": [
              "2KI.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Yeɣu ben kä ji̱ kɔar kua̱rɛ, cua jɛ jiök i̱, “Ɛ mal? Ɛŋu ci ram ɛmɔ ben kä ji̱ mɔ?” Kä cuɛ kɛ loc i̱, “Ŋäc yɛn ɛn ram ɛmɔ kɛnɛ ruacdɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.11",
            "verseOrgIds": [
              "2KI.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ wee, “Nɔmɔ /ciɛ thuɔ̱k. Lär i̱ jɛ nɛy ɛn täämɛ.” Kä cuɛ wee, “Cɛ nɛmɛ kɛnɛ nɛmɛ la̱t ɣä, wee i̱, ‘Ci Kuoth Nhial ɛ lar i̱ ɣän yi̱eerä ji̱ ala kuäär kä I-thɛ-rɛl.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.12",
            "verseOrgIds": [
              "2KI.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ pɛ̈th cu ramɔ bi̱i̱dɛ ka̱n kä cukɛ kɛ pap dup. Kä cukɛ kaaŋ Koth, kä cukɛ köök i̱, “Kuäär ni Yeɣu.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.13",
            "verseOrgIds": [
              "2KI.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Näk kua̱r I-thɛ-rɛl ni Yo-ram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.13",
            "verseOrgIds": [
              "2KI.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yeɣu gat Yo-ca-pat gat Nim-ci Yo-ram ca̱p mi jiäk. (Kä täämɛ Yo-ram kɛnɛ ji̱ I-thɛ-rɛl diaal gaŋkɛ Ra-moth-gil-yad kɛ Ɣä-dha-el kuäär Thi-ri-ya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.14",
            "verseOrgIds": [
              "2KI.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kuäär ni Yo-ram cɛ loc kä Yidh-rɛɛl kɛ ɣöö bi buɔ̱tdɛ mëë ca ka̱m jɛ ɛ ji̱ Thi-ri-ya mëë nyiëënyɛ kɛ Ɣä-dha-el kuäär Thi-ri-ya wä gɔaa thi̱n.) Kä cu Yeɣu wee, “Kä mi ɛ jɛn ca̱run ɛn nɔmɔ, a thil ram kac raar wi̱c, a bɛ thok wä lat kä Yidh-rɛɛl.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.15",
            "verseOrgIds": [
              "2KI.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yeɣu thurbilɛ kɔt kä cuɛ wä kä Yidh-rɛɛl, kɛ ɣöö te Yo-ram ɛn wi̱ni kä ci kuäär Juda ni Ä-ɣɛ̈dh-yaa Yo-ram ben gui̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.16",
            "verseOrgIds": [
              "2KI.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.16",
            "verseOrgIds": [
              "2KI.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min te ram in guic duɔ̱ɔ̱p cuŋä wi̱i̱ jiöŋ kä Yidh-rɛɛl, cuɛ rɛm Yeɣu nɛn bäkɛ, cuɛ wee, “Rɛm a bëë ni.” Kä cu Yo-ram wee, “Jäkni jio̱ŋko̱o̱r a jɛ wä röm kɛ kɛ kä a jɛ wee i̱, ‘Ɛ mal?’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.17",
            "verseOrgIds": [
              "2KI.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gua̱n jiöök wä röm kɛ jɛ, kä cuɛ wee, “Ɛ kuäär i̱, ‘Ɛ mal?’ ” Kä cu Yeɣu ɛ loc i̱, “Ɛ mal mi bi lät ni ŋu? Mat ni rɔ jɔkdä.” Kä cu gui̱i̱c wee, “Ci ram in ca ja̱k cop kä kɛ, kä /cɛ ni luny jɔk.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.18",
            "verseOrgIds": [
              "2KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ gua̱n jiöök mi dɔ̱ŋ jäk kä kɛ, kä cuɛ wee, “Ɛ kuäär i̱, ‘Ɛ mal?’ ” Kä cu Yeɣu ɛ loc i̱, “Ɛ mal mi bi lät ni ŋu? Bër matni rɔ jɔkdä.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.19",
            "verseOrgIds": [
              "2KI.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gui̱i̱c ɛ nyɔk kɛ lat i̱, “Cɛ kɛ cop, duundɛ ɣöö /cɛ ni luny jɔk. Kä ce̱t ja̱lɛ kɛ ja̱l Yeɣu gat Nim-ci. Kɛ ɣöö jälɛ ce̱tkɛ ram mi ci yɔ̱ŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ram wee, “Rialɛ thurbilä i̱ kä.” Kä cukɛ jɛ rialikä. Kä cu Yo-ram kuäär I-thɛ-rɛl kɛnɛ Ä-ɣɛ̈dh-yaa kuäär Juda tɛth raar, te ramɔ thurbiɛɛlɛ kä cukɛ wä kä Yeɣu, cukɛ röm kɛ jɛ muun Na-both raan Yidh-rɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.21",
            "verseOrgIds": [
              "2KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Yo-ram Yeɣu nɛn cuɛ wee, “Ɛ mal Yeɣu?” Kä cuɛ loc i̱, “Dera mal ŋukä, min ŋot pɛɛth muɔr ni I-dhɛ-bɛl kɛnɛ pal guäynikɛ kɛ ŋuan?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ram rɔ ri̱t barɛ rɔ, kä jiökɛ Ä-ɣɛ̈dh-yaa i̱, “Ɛ ca̱p Ä-ɣɛ̈dh-yaa!” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.23",
            "verseOrgIds": [
              "2KI.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yeɣu bäärɛ ka̱n, kä cuɛ Yo-ram bär ni kam käkjiɛrkɛ, kä cuɛ wä päl nikɛ lɔcdɛ, kä cuɛ tɛɛth rɛy thurbiɛɛlɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.24",
            "verseOrgIds": [
              "2KI.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yeɣu Bid-kar geer thurbiɛɛlɛ jiök i̱, “Käni riŋdɛ wër yor ni jɛ rɛy kakä Na-both raan Yidh-rɛɛl. Kä tim ŋuɔ̱t ëë ci Kuoth Nhial ɛ lar kɛ kui̱dɛ, mëë te kɔn kɔr gua̱n ni Ɛ̈-ɣab kɛ thurbiɛɛli kɔn. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.25",
            "verseOrgIds": [
              "2KI.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k ɣän cä näk ëë näkɛ Na-both kɛnɛ gatdɛ nɛn cäŋ ëë. Ci Kuoth Nhial ɛ lar i̱, ‘Ɣän bä ji̱ jak kä coli jɛ ɛn muun ɛmɛ.’ Kɛ kui̱c ɛmɔ täämɛ naŋ riŋdɛ wër yori jɛ muun ɛmɔ, ce̱tnikɛ ruac Kuɔth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Näk kua̱r Juda ni Ä-ɣɛ̈dh-yaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Ä-ɣɛ̈dh-yaa kuäär Juda nɔmɔ nɛn, cuɛ rɔ bar dup Beth-ɣɛ̈-gan. Kä cu Yeɣu jɛ guɔ̱ɔ̱r, kä cuɛ wee, “Na̱kɛ jɛ bä.” Kä cukɛ jɛ moc buɔ̱t rɛy thurbiɛɛlɛ dup Gur min thieek kɛ Yib-lɛ-am. Kä cuɛ rɔ bar kä Mɛ-gi-do kä cuɛ wä li̱w thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.27",
            "verseOrgIds": [
              "2KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu raan kɔarɛ jɛ naŋ kä Jɛ-ru-tha-lɛm kɛ thurbil, kä cuɛ jɛ wä kony kɔ̱kdɛ kɛɛl kɛnɛ gua̱ni däärwec Dee-bid.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ä-ɣɛ̈dh-yaa a kuäär kä Juda kɛ wäl kɛl runi ruec Yo-ram gat Ɛ̈-ɣab.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Näk kua̱r ciek ni I-dhɛ-bɛl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Yeɣu ben kä Yidh-rɛɛl, cu I-dhɛ-bɛl ɛ liŋ. Cuɛ waŋdɛ bil kä cuɛ miemkɛ la̱t, kä cuɛ guic kɛ wernyin. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.30",
            "verseOrgIds": [
              "2KI.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min wä Yeɣu rɛc cuɛ cɔl i̱, “Bi̱i̱kɛ mal inu lö raan Dhim-ri mi nääk kua̱rɛ?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.31",
            "verseOrgIds": [
              "2KI.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ liɛɛc guicɛ wernyin, kä cuɛ wee, “Ɛŋa mi te kui̱dä? Ɛŋa?” Nɛy da̱ŋ rɛw kiɛ nɛy da̱ŋ diɔ̱k, kä cu ga̱a̱ŋ duëël kua̱r jɛ guɛc piny. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.32",
            "verseOrgIds": [
              "2KI.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wee, “Yuɔrɛ jɛ piny.” Kä cua jɛ yuɔr piny. Kä cu tha̱a̱ŋ riɛmdɛ päny kith kɛnɛ jio̱o̱k, kä cukɛ jɛ dɔany. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.33",
            "verseOrgIds": [
              "2KI.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yeɣu wä mi̱th kä cuɛ maath. Kä cuɛ wee, “Guɛcɛ jɛn ciek ɛ ca lam ɔ, wiaa kuɔnyɛ jɛ. Kɛ ɣöö ɛ nya kua̱r.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.34",
            "verseOrgIds": [
              "2KI.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min cikɛ wä wa jɛ kony, cua wä jek ni pöörɛ kɛnɛ pa̱a̱t ciöknikɛ kɛ pa̱a̱t tetnikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.35",
            "verseOrgIds": [
              "2KI.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min cikɛ luny jɔk, cua ben la̱r Yeɣu, kä cuɛ wee, “Nɔmɔ ɛ ruac Kuɔth Nhial, mëë cɛ lat kɛ ja̱ŋdɛ ni Ɛ-li-cä raan Tic-bat i̱ ‘Rɛy ciëŋ Yidh-rɛɛl bi jio̱o̱k ri̱ŋ I-dhɛ-bɛl cam. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.36",
            "verseOrgIds": [
              "2KI.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ri̱ŋ I-dhɛ-bɛl ce̱tkɛ di̱r rɛy ciëŋ Yidh-rɛɛl. Kä bɛ thil ram mi biɛ lar i̱ nɛmɛ ɛ I-dhɛ-bɛl.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.37",
            "verseOrgIds": [
              "2KI.9.37"
            ]
          }
        }
      ]
    }
