    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ɣɔm Yecu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua Yecu buath rɛy dɔaar ɛ Yiëë kɛ ɣöö ba jɛ wä ɣɔam ɛ gua̱n jiäkni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /kenɛ mi̱th kɛ ni̱n ti jiɛn ŋuan wäär kɛnɛ cäŋ. Kä kɛ kɔrɛ cu buɔth ɛ näk ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gua̱n ɣɔmä ben kä Jɛ, cuɛ jɛ jiök i̱, “Mi ɛ ji̱n Gat Kuɔth, ruacni kɛ pääm ti̱ti̱ kɛ ɣöö bikɛ rɔ̱ loc ni juray.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yecu jɛ loc i̱, “Ca jɛ gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:4",
              "type": "text"
            },
            {
              "text": "Ŋuɔ̱t 8:3.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gua̱n jiäkni jɛ naŋ kä Jɛ-ru-tha-lɛm wec in rɛl rɔ kä cuɛ jɛ wä la̱th wi̱i̱ luaak Kuɔth mi bäär. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.5",
            "verseOrgIds": [
              "MAT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jɛ jiök i̱, “Mi ɛ ji̱n Gat Kuɔth, yori rɔɔdu piny, kɛ ɣöö ca jɛ gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:6",
              "type": "text"
            },
            {
              "text": "Diit 91:11-12.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gua̱n jiäkni jɛ lɛni naŋ wi̱i̱ pa̱a̱m mi bäär, cuɛ jɛ nyuɔ̱th kuääri ɣɔaa diaal kɛnɛ wuɔ̱tdiɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cuɛ Yecu jiök i̱, “Mi kämi rɔ mua̱a̱l nhiamdä a pali ɣä, bä ji̱ ka̱m ŋɔak ti̱ti̱ diaal.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yecu jɛ jiök i̱, “Woc rɔ, Cɛy-tan, kɛ ɣöö ca jɛ gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
              "MAT.4.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:10",
              "type": "text"
            },
            {
              "text": "Ŋuɔ̱t 6:13.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tuk Yecu kɛ lätkɛ kä Gɛ̈-lɛ-li",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.11",
            "verseOrgIds": [
              "MAT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Yecu jɛ liŋ ɛn ɣöö ca Jɔ̱ɔ̱n yian, cuɛ wä kä Gɛ̈-lɛ-li. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jiɛɛn kä Na-dha-rɛth, cuɛ wä cieŋ kä Ka-pɛr-ni-äm mi te gekä baar, rɛy rööl Dhɛ-bu-lun kɛnɛ Nap-ta-li. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua nɔmɔ la̱t kɛ ɣöö bi mëë ca lar ɛ gök ni I-ca-yaa a thuɔ̱k i̱,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciöt Yecu kɛ jaak tin nhiam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë jäl Yecu gekä baar Gɛ̈-lɛ-li, cuɛ gaat wutdä da̱ŋ rɛw nɛn, Thay-mɔn min cɔal i̱ Pi-tɔr, kɛnɛ däman ni An-dɛ-röw, yuɔrkɛ cambak rɛy baar, kɛ ɣöö kɛ dëëp rɛc. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.18",
            "verseOrgIds": [
              "MAT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ jiök i̱, “Bia, guɔ̱ɔ̱rɛ ɣä, kä bä yɛ jakä dëëp nath.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikä kɛɛl cukɛ cambaknikiɛn ba̱ny piny, kä cukɛ jɛ guɔ̱ɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.20",
            "verseOrgIds": [
              "MAT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min wä Yecu kɛ thɔ̱a̱ŋ ɛ mɔ, cuɛ gaat wutdä da̱ŋ rɛw kɔ̱kiɛn nɛn, Je-mɛth, kɛnɛ däman ni Jɔ̱ɔ̱n gaat Dhɛ-ba-dii. Kä tekɛ rɛy ria̱a̱y kɛɛl kɛ gua̱ndiɛn ni Dhɛ-ba-dii, kɔackɛ cambaknikiɛn, kä cuɛ kɛ cɔl. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.21",
            "verseOrgIds": [
              "MAT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikä kɛɛl cukɛ riey kɛnɛ gua̱ndiɛn ba̱ny piny, cukɛ jɛ guɔ̱ɔ̱r.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋi̱i̱c Yecu kɛnɛ jakdɛ kɛ naath kä gɔw",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yecu ja̱l rɛy Gɛ̈-lɛ-li kɛɛliw, ŋi̱i̱cɛ naath gua̱thni palädiɛn, kä latdɛ thuk kuäärä Kuɔth ti gɔw, kä jakɛ jua̱th diaal kä gɔw, kä woocɛ liaw pua̱nyni nath. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kɛ̈kdɛ räth rɛy Thi-ri-ya kɛɛliw, kä cukɛ jɛ nöŋ ji̱ jua̱thni diaal tin tekɛ liaw ti gööl kɛnɛ bɛc pua̱ny, kɛ kuth ti jiäk, kɛ nok, amäni nɛy ti cɛ nuäŋ, kä cuɛ kɛ jakä gɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu buɔ̱n nath mi di̱t jɛ guɔ̱ɔ̱r kä Gɛ̈-lɛ-li kɛ Dɛ-ka-po-lith",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:25",
              "type": "text"
            },
            {
              "text": "Jɛn lotdɛ ni ɣöö wi̱i̱ da̱ŋ wäl.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kɛnɛ Jɛ-ru-tha-lɛm kɛ Ju-dia, amäni ji̱ kuec kiɛɛr Jɔr-dɛn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        }
      ]
    }
  ],
