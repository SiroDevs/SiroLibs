{
  "id": "MAT.25",
  "number": "25",
  "bookId": "MAT",
  "reference": "Mɛ̈T 25",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "MAT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäät nyieet da̱ŋ wäl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ba ciaŋ kuäärä nhial pa̱a̱r kɛ nyier da̱ŋ wäl ti ca lɛmbärnikiɛn ka̱n, wäkɛ cɔw nyaal lor. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyier da̱ŋ dhieec rɛydiɛn kɛ dɔa̱a̱r, kä nyier da̱ŋ dhieec pɛlkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci nyier tin dɔa̱a̱r lɛmbärnikiɛn naŋ, thilɛ liɛɛth mi ci kɛn ɛ naŋ kɛɛl kɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nyier tin pɛl buɔ̱li liɛth naŋ kɛɛl kɛ lɛmbärnikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci cɔ nyaal jääny jɔ̱ɔ̱r, cu kɛn diaal dɔ̱ɔ̱l kä cukɛ niɛɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.5",
            "verseOrgIds": [
              "MAT.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ wäärdär cuɛ tekɛ rɔal i̱, ‘Nɛnɛ, cɔ nyaal ɛn! Bia raar kä luɔrɛ jɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.6",
            "verseOrgIds": [
              "MAT.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nyier tɔ̱tɔ̱ diaal rɔ̱ jiɛc, cukɛ lɛmbärnikiɛn rialikä. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nyier tin dɔa̱a̱r nyier tin pɛl jiök i̱, ‘Ti̱ethɛ kɔ tha̱a̱ŋ liɛthdun kɛ ɣöö lɛmbärnikɔ li̱wkɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.8",
            "verseOrgIds": [
              "MAT.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nyier tin pɛl kɛ loc i̱, ‘Ëëy /cɛ bi ro̱ŋ kɛ kɔ kɛnɛ yɛ. Gɔaa ni ɣöö bia wä kä ji̱ ko̱kä, bia rɔ̱ wä ko̱kikä.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.9",
            "verseOrgIds": [
              "MAT.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min wäkɛ guäth ko̱kä, cu cɔ nyaal lɔ̱ ben, kä cu nɛy tin ca rɔ̱ rialikä wä guäth mi̱thni kuën kɛ cɔ nyaal kɛɛl. Kä cua thok duëël gäk. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.10",
            "verseOrgIds": [
              "MAT.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔrɛ cu nyier tin kɔ̱ŋ ben bä, wäkɛ i̱, ‘Kuäär, kuäär, lepni kɔ duel.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.11",
            "verseOrgIds": [
              "MAT.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ loc i̱, ‘Ɛpuc, ɣän la̱rä jɛ yɛ, ɣän kuecä yɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.12",
            "verseOrgIds": [
              "MAT.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ jiɛnɛ, kɛ ɣöö /cia cäŋ ŋäc kiɛ thaak.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäät la̱a̱tni da̱ŋ diɔ̱k",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ce̱t kuäär nhial kɛ wut mi wä ja̱l guäth mi dɔ̱ŋ. Cuɛ la̱a̱tkɛ cɔl, kä cuɛ nyinkɛ ba̱ny kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ram kɛl ka̱m yio̱w dääpä da̱ŋ dhieec, kä cuɛ ram in dɔ̱ŋ ka̱m yio̱w dääpä da̱ŋ rɛw, kä cuɛ min dɔ̱diɛn ka̱m rial dääpä kɛl, cuɛ ramɔ ka̱m mi ro̱ŋ kɛ lua̱ŋdɛ. Kä cuɛ jiɛɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram mëë ca ka̱m yio̱w dääpä da̱ŋ dhieec, cuɛ wä nikä kɛɛl, cuɛ kɛ wä la̱a̱t, kä cuɛ yio̱w dääpä da̱ŋ dhieec kɔ̱kiɛn jek. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ bä, cu ram in ci yio̱w rɛw kän, cuɛ yio̱w rɛw kɔ̱kiɛn jek. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram in ci rial kɛl ka̱n, cuɛ wä raar, cuɛ piny wä tɛt, kä cuɛ rial kua̱rɛ wä muɔl piny. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr gua̱th mi bäär cu kuäär la̱a̱tni tɔ̱tɔ̱ ben, kä cuɛ pek yio̱o̱ni kuɛn kɛ kɛ kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ram mëë ci yio̱w da̱ŋ dhieec ka̱n ben nhiam, no̱o̱ŋɛ yio̱w da̱ŋ dhieec kɔ̱kiɛn, cuɛ wee i̱, ‘Kuäär, ci ɣä ka̱m yio̱w da̱ŋ dhieec mëëdan. Kä täämɛ, cä yio̱w da̱ŋ dhieec kɔ̱kiɛn jek.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.20",
            "verseOrgIds": [
              "MAT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kuäärɛ jɛ jiök i̱, ‘Gɔaaɛ ɛlɔ̱ŋ, ɛ ji̱n yuup mi gɔaa mi ŋa̱a̱thä. Ci ti tɔt yop agɔaa, kä bä ji̱ jakä yuup kä ti ŋuan. Bër nyuaknɛ tɛ̈th lɔaacdä kɛɛl.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ram in tekɛ yio̱w da̱ŋ rɛw ben nhiam bä, cuɛ wee i̱, ‘Ci ɣä ka̱m yio̱w da̱ŋ rɛw, kä täämɛ cä yio̱w da̱ŋ rɛw kɔ̱kiɛn jek.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.22",
            "verseOrgIds": [
              "MAT.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kuäärɛ jɛ jiök i̱, ‘Gɔaaɛ ɛlɔ̱ŋ, ɛ ji̱n yuup mi gɔaa mi ŋa̱a̱thä, ji̱n ci ti tɔt yop agɔaa, kä bä ji̱ jakä yuup kä ti ŋuan. Bër nyuaknɛ tɛ̈th lɔaacdä kɛɛl.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ram ëë ca ka̱m rial kɛl ben nhiamdɛ bä, cuɛ wee i̱, ‘Kuäär, cä jɛ ŋa̱c ɛn ɣöö ɛ ji̱n ram mi bɛc bɛc, mi ŋer guäth mi /keni pith, kä doli ti /keni kuaykɛ pith. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ cä dual kɛ ji̱, cä wä kä cä rialu wä muɔl piny. Ja̱ŋ, käni duŋdu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.25",
            "verseOrgIds": [
              "MAT.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäärɛ jɛ loc i̱, ‘Ɛ ji̱n läät mi jiääk mi duaal! Ci jɛ ŋäc ɛn ɣöö ŋɛ̈ɛ̈rä gua̱a̱th mi /ka̱n pith, kä duɔlä ti /ka̱n kuaykɛ pith? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä dee gɔaa ni mi ci rialä ka̱m yuɔ̱ɔ̱p yio̱wni, kä kɛ bendä dëë duŋdä ka̱n kɛnɛ rëpdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.27",
            "verseOrgIds": [
              "MAT.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ cu kuäär wee ka̱nɛ yiëëth in tekɛ jɛ, kä ka̱mɛ jɛ ram in tekɛ yio̱w dääpä da̱ŋ wäl, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö ba nyin raam mi tekɛ ŋɔak rep, kä bɛ ria̱ŋ, kä ram mi thil ŋu, ba mi tɔt mi tekɛ jɛ ka̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä yuɔrɛ läät ɛ thil ca̱pɛ raar rɛy muɔ̱th. Ɛn wi̱ni bɛ wiee kä bɛ lɛckɛ moth.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luk in di̱i̱t in jɔak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wä Gat Ran ben rɛy wutädɛ kɛɛl kɛ ja̱a̱k nhial diaal, bɛ nyuur wi̱i̱ kɔam kuäärädɛ min gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ba döör diaal duɔl nhiamdɛ, kä bɛ mɔ koc kä min dɔ̱ŋ, ce̱tkɛ min koc yieen deet rɔɔm kiɛ böwni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn bɛ rɔɔm moc gua̱a̱th cueecdɛ, kä bi böwni te caamdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.33",
            "verseOrgIds": [
              "MAT.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuäär nɛy tin te cueecdɛ jiök i̱, ‘Bia, lö nɛy tin ca poth ɛ Gua̱a̱r, ka̱nɛ nyin kuäärä tëë ca rialikä kɛ kui̱dun ni tukä ɣɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö cua ɣä näk ɛ buɔth, kä cuarɛ ɣä moc mi̱eth, cua ɣä näk ɛ rɛw, kä cuarɛ ɣä moc pi̱ ti maathä. Ɣän a juɔ̱r, kä cuarɛ ɣä nyuɔ̱ɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cua̱ te juutdä, kä cuarɛ ɣä moc bi̱i̱, cua tekɛ juey, kä cuarɛ ɣä tit. Cua te yieenä, kä cuarɛ ɣä ben gui̱l.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
            "verseOrgIds": [
              "MAT.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ji̱ cuŋni jɛ loc i̱, ‘Kuäär ni Kuoth, cakɔ ji̱ nɛn nɛy a ci buɔth i̱ näk, kä muɔckɔ ji̱ mi̱eth, kiɛ rɛw kä muɔckɔ ji̱ pi̱ ti maathi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cakɔ ji̱ nɛn nɛy ala juɔ̱r, kä nyuɔ̱rkɔ ji̱, kiɛ jäli juutdä, kä muɔckɔ ji̱ bi̱i̱? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cakɔ ji̱ nɛn nɛy ɛ ti̱i̱ kɛ juey kiɛ yieen, kä guelkɔ ji̱?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.39",
            "verseOrgIds": [
              "MAT.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuäär kɛ loc i̱, ‘Ɛpuc, ɣän la̱rä jɛ yɛ, mi cia lät kä ram mi tɔt kä dämaari ti̱ti̱, cia jɛ lät kä ɣä.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn bɛ nɛy tin te caamdɛ jiök i̱, ‘Wuɔcɛ rɔ̱ kutdä, yɛn nɛy ti ca bit. Wiaa rɛy maac in thil pek in ca rialikä kɛ kui̱ gua̱n jiäkni kɛnɛ ja̱a̱kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua ɣä näk ɛ buɔth, kä thilɛ mi̱eth mi cia käm ɣä. Kä cua ɣä näk ɛ rɛw, kä /ka̱nɛ ɣä moc pi̱ ti maathä, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "cua a juɔ̱r, kä /ka̱nɛ ɣä nyuɔ̱ɔ̱r, cua ja̱l juutdä, kä /ka̱nɛ ɣä moc bi̱i̱, kä cua tekɛ juey kɛnɛ yieen, kä /ka̱nɛ ɣä ben gui̱l.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi kɛn ɛ loc bä i̱, ‘Kuäär ni Kuoth, cakɔ ji̱ nɛn nɛy a näk buɔthi kiɛ rɛw, kiɛ ɣöö lapi juɔ̱r kiɛ jäli juutdä, kiɛ ti̱i̱ kɛ juey kiɛ yieen, kä /ka̱nkɔ ji̱ luäk kɛ kɛ?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.44",
            "verseOrgIds": [
              "MAT.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn bɛ kɛ loc i̱, ‘Ɛpuc, ɣän la̱rä jɛ yɛ, ce̱tkɛ min /ka̱nɛ jɛ lät kä ram kɛl mi kuiy kä nɛy ti̱ti̱, /ka̱nɛ jɛ lät kä ɣä.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.45",
            "verseOrgIds": [
              "MAT.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛn bikɛ wä guäth tɔ̱ŋä mi thil pek, kä bi ji̱ cuŋni wä rɛy teekä mi thil pek.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.46",
            "verseOrgIds": [
              "MAT.25.46"
            ]
          }
        }
      ]
    }
