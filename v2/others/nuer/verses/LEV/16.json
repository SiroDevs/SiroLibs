    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäŋ Luël",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial ruac kɛ Muthɛ kɛ kɔr kä mi ci gaat Ä-ron da̱ŋ rɛw li̱w, mi cikɛ wä nhiam Kuɔth kɛ muc ti jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Muthɛ jiök i̱, “Jio̱kni dämuɔɔr ni Ä-ron i̱, /cu wä gua̱thni diaal guäth in rɛl gɔɔydɛ rɔ jɔk gëëlä nhiam gëëlä kuumä thandukä matdä ruac kɛ ɣöö ci bi li̱w, ɛ jɛn gua̱a̱th in bä jɔɔc thi̱n rɛy nyäŋä. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.2",
            "verseOrgIds": [
              "LEV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi ben guäth in rɛl gɔɔydɛ rɔ a jäli kɛ thäk ala luur dui̱rä kɛnɛ ruath dɛ̈ɛ̈l rɔɔmä ala luur mi waŋkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.3",
            "verseOrgIds": [
              "LEV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä a ŋot Ä-ron a /kenɛ ni wä rɛy, guäth in rɛl gɔɔydɛ rɔ, a jɛ puaak kä bɛ bieyni bööthä palä bat, bi̱i̱ in bäär kɛnɛ thuruaalikɛ, kä bɛ kɛ yian kɛ yieynikiɛn, kä bɛ kum biey cu la̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.4",
            "verseOrgIds": [
              "LEV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä rɛy bunä ji̱ I-thɛ-rɛl bɛ rɔ moc thääk deet böwni da̱ŋ rɛw ala luuri dui̱rä, kɛ thäk dɛ̈ɛ̈l rɔɔmä ala luur mi waŋkɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.5",
            "verseOrgIds": [
              "LEV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.5",
            "verseOrgIds": [
              "LEV.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛn Ä-ron bɛ thäk thöp ala luur dui̱rädɛ, bɛ luɛlni rɔ kɛnɛ ji̱ dhɔaarɛ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.6",
            "verseOrgIds": [
              "LEV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "inɔ bɛ thääk deet böwni da̱ŋ rɛw ka̱n, bɛ kɛ nööŋ nhiam Kuɔth Nhial thok kɛmɛkä ro̱mä kɛ Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ gaakni yuɔr kɛ kui̱ thääk deet böwni da̱ŋ rɛw, kɛl kɛ kui̱ Kuɔth Nhial, min dɔ̱ŋ kɛ kui̱ A-dha-dhel",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:8",
              "type": "text"
            },
            {
              "text": "A-dha-dhel",
              "type": "text"
            },
            {
              "text": "Kɛ thok Ɣi-bɛ-ru lotdɛ ni ɣöö yiey ti jiäk ti cieŋ rɛy dɔaar.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ thäk dɛ̈ɛ̈l in ci pɛn kä Kuoth. Nööŋ nhiam Kuɔth, kä bɛ jɛ thöp ala luur kɛ kui̱ dui̱rä. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thäk dɛ̈ɛ̈l in ci pɛn kä A-dha-dhel nööŋ nhiam Kuɔth Nhial a tëk ala lue̱e̱l, kä bɛ cu jak kä wä rɛydɔaar kä A-dha-dhel.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wä Ä-ron thäk wä thöp ala luur dui̱rkädɛ, mi luɛlɛ ni rɔ kɛnɛ ji̱ dhɔaarɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.11",
            "verseOrgIds": [
              "LEV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "A jɛ kän thak maac mi cɛ thiäŋ kɛ rual maac wi̱i̱ yi̱kä, kä bɛ rɔ jiöm kɛ tët da̱ŋ rɛw kä wal tin kuɔ̱r kuɔ̱ɔ̱r, kä akɛ nööŋɛ jɔk ge̱e̱lä guäth in rɛl gɔɔydɛ rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wi̱ni bɛ wäl ɛmɔ la̱th maac nhiam Kuɔth Nhial, kä bi tolɛ kuum thandukä matdä ruac ŋuɔ̱tni kum, kɛ ɣöö /cɛ bi lɛ li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ tha̱a̱ŋ riɛm tha̱a̱k ka̱n, kä kɛ yiatdɛ bɛ jɛ kiɛth nhiam kuumä thandukä matdä ruac, kä bɛ tha̱a̱ŋdɛ ben kiɛth kɛ yiatdɛ nhiam thandukä matdä ruac ni kä bärɔw.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“A jɛ näk thäk dɛ̈ɛ̈l böwä min mɔ luur dui̱rä nath, kä bɛ riɛmdɛ naŋ jɔk ge̱e̱lä, kä bɛ jɛ la̱t ce̱tnikɛ mëë cɛ lätni riɛm tha̱a̱k, bɛ jɛ kiɛth wi̱i̱ kuumä thandukä matdä ruac, kɛnɛ nhiamdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn duɔ̱p ɛ mɔ bɛ gua̱a̱th in rɛl gɔɔydɛ rɔ cu lak kɛ jiäk ji̱ I-thɛ-rɛl, kɛnɛ dueerkiɛn diaal, bɛ jɛ la̱t ɛn mɛmɛ kä kɛmɛkä ro̱mä kɛ Kuoth Nhial kɛ ɣöö tëë däär wecdiɛn mi ca göl ɛ jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.16",
            "verseOrgIds": [
              "LEV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thilɛ ram mi bi wä rɛy kɛmɛkä ro̱mä kɛ Kuoth Nhial guäth in cɛ wä rɛc min luɛlɛ gua̱a̱th in rɛl gɔɔydɛ rɔ, amäni mi cɛ ben raar kä cɛ rɔ luɛl kɛnɛ ji̱ dhɔaarɛ, kɛ ji̱ I-thɛ-rɛl diaal, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.17",
            "verseOrgIds": [
              "LEV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bɛ ben raar yi̱kä min te nhiam Kuɔth Nhial bɛ jɛ ben lak, bɛ tha̱a̱ŋ riɛm tha̱a̱k kɛnɛ thäk dɛ̈ɛ̈l böwä ka̱n, bɛ jɛ ben bat tuɔ̱ŋni yi̱kä da̱ŋ ŋuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ tha̱a̱ŋ riɛm cu kiɛth thi̱n kɛ yiatdɛ ni kä bärɔw, inɔ bɛ jɛ cu lak kä jiäk ji̱ I-thɛ-rɛl, bɛ cua̱ mi rɛl gɔɔydɛ rɔ.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dɛl mi naŋ dueer nath dɔɔr",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi wä Ä-ron thuɔ̱k kɛ luël gua̱th in rɛl gɔɔydɛ rɔ kɛnɛ kɛmɛkä ro̱mä kɛ Kuoth Nhial kɛ yi̱k, a jɛ nööŋ dɛ̈ɛ̈l böwä mi tëk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Ä-ron tetkɛ da̱ŋ rɛw la̱th wi̱i̱ tha̱k dɛ̈ɛ̈l böwä mɔmɔ buk ɛ jɛ, kä latdɛ dueer ji̱ I-thɛ-rɛl diaal kɛnɛ jiäkiɛn, bɛ kɛn diaal la̱th wi̱i̱ tha̱k dɛ̈ɛ̈l, kä bɛ jɛ cu jak kä wä däärdɔaar kɛ ram ɔ cɛ kuany ɔ i̱ bi jɛ la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi thak dɛ̈ɛ̈l dueerkiɛn cu naŋ kɛ jɛ kɛ rɛydɔaar mi ca cieŋ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
