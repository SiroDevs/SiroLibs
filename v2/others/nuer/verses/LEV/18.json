{
  "id": "LEV.18",
  "number": "18",
  "bookId": "LEV",
  "reference": "Liib 18",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
