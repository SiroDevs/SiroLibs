          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wä biɛl rɔ wä nyɔk kɛ mi jɔckɛ ala ti ŋuan, bi gua̱ndɛ jɛ waŋ ɛn bi̱i̱ ɛ mɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
