          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wee jɛ wä lak kä bi cuäänydɛ bath, a jɛ nyɔkɛ kɛ la̱k kä bɛ cu gɔaa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
