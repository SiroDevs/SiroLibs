          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi wec tekɛ biɛl mi dɛ̈ɛ̈r kiɛ mi tɔ̱c, ɛ dhɔp ba jɛ ben nyuɔ̱th bööth palä. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bööth palä jɛ guic kä bɛ jɛ la̱th kä rɔa kɛ ni̱n bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
