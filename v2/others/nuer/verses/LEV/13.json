          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi wee tekɛ wut kiɛ ciek mi tekɛ buɔ̱t wi̱i̱dɛ kiɛ ti̱kdɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bi bööth palä jɛ guic ɛn buɔ̱t ɛ mɔ. Mi cɛ coth rɛy ri̱ŋ kä ci mi̱emdɛ a yian kä ciwɛ, bɛ jɛ lat i̱ cɛ tekɛ juey ɛn ram ɛmɔ, cɛ tekɛ wuɔ̱ɔ̱k wec kiɛ ti̱äk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wee jɛ wä guic a thilɛ jɛ mi̱em mi ca̱r kä /kenɛ coth rɛy ri̱ŋ bɛ ram ɛmɔ la̱th gua̱a̱thdɛ kä rɔa kɛ ni̱n bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ in bärɔwdiɛn bɛ jɛ nyɔk kɛ gui̱c, mi thilɛ jɛ mi̱em mi yian kä /kenɛ coth rɛy ri̱ŋ kä /kenɛ jɛ däk, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "lotdɛ ni ɣöö bamud ɛn wi̱cdɛ kiɛ ti̱kdɛ, ba päl ni gua̱a̱th butdä, kä bɛ jɛ nyɔk kɛ läth gua̱a̱thdɛ kä rɔa kɛ ni̱n bärɔw kɔ̱kiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k ni̱ni da̱ŋ bärɔw bɛ jɛ nyɔk kɛ gui̱c ɛn buɔ̱t, mi /kenɛ jɛ däk kä tëë jɔk gupä, bɛ jɛ lat i̱ thil ɛ jɛ juey, ɛn raam ɔ bɛ bieynikɛ lak kä bɛ cu gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wee jɔɔc i̱ ci buɔ̱t rɔ rëp a ca lat i̱ cɛ thil juey, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba jɛ nyɔk kɛ gui̱c ɛ bööth palä, mi wee jɛ nɛn i̱ cɛ da̱k puɔ̱nydɛ kä te mi̱em mi yian ɛn raam ɔ cɛ tekɛ juey. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ca̱r bööthä palä mi guicɛ jɛ i̱ /kenɛ buɔ̱t däk a do̱ny mi̱em ti ca̱a̱r thi̱n kä wä ni jɛn kɛ gɔɔy, bɛ jɛ lat i̱ thil ɛ jɛ juey ɛn raam ɔ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
