              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.28",
            "verseOrgIds": [
              "LEV.13.28"
            ]
          }
        },
        {
          "name": "verse",
