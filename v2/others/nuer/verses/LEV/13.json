          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wee tekɛ biɛl dhɔpä rɛy biey ɛ thup kiɛ terli̱i̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
