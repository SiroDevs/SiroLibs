          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö mi cɛ lɛn ŋot kɛ läŋ lääŋ, a wä ni jɛn kɛ cuɔl. Kä /cɛ jɛ lɛ däk wäni jɛn kɛ gɔɔy, bi bööth palä jɛ lat i̱ thilɛ jɛ juey gupä, ɛ pia̱a̱r ni jɛn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.28",
            "verseOrgIds": [
              "LEV.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
