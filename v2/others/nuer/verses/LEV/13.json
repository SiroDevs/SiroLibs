        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ci mi̱emkɛ rɔ̱ guth nhiamdɛ a cɛ tekɛ wuɔɔk, jɛn gɔaaɛ thilɛ jɛ juey. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wee wä tekɛ mi dɛ̈ɛ̈r wokädɛ, luɔtdɛ ɣöö tëë kɛ juey gupä. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn baben guic ɛ bööth palä, mi wee jɛ wä nɛn i̱ wuɔ̱ɔ̱kdɛ yɔmɛ jɛ kä ti̱thɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "bɛ jɛ cu lat i̱ tëë kɛ juey gupä wi̱i̱dɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        }
      ]
