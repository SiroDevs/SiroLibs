          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiɛ rɛt biey mi la̱tkɛ kɛ thup kiɛ terli̱i̱n kiɛ la̱t kɛ jɛ kɛ köl, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
