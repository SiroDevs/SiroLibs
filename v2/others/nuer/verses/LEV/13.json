          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr ni̱ni da̱ŋ bärɔw bɛ jɛ nyɔk kɛ gui̱c, mi rëp biɛɛlkɛ ni rɔ, cɛ jiäk ɛn bi̱i̱ ɛ mɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
