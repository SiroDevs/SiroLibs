              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä kɛ min guic ɛ jɛ, mi ci biɛl biey jɔɔc ɛ mi̱r mi̱r, bɛ jɛ rɛ̈t jɔ̱ɔ̱r ɛn gua̱a̱th ɛmɔ puɔ̱ny biey kiɛ köl. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
          "name": "verse",
