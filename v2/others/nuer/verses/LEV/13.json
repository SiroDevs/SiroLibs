          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ jɛ waŋ kɛ ɣöö cɛ tekɛ dhɔp röŋɛ kɛ wa̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
