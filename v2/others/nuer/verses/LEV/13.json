              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wee tekɛ wut Kiɛ ciek mi te pia̱a̱r butdä mi cɛ guɔ̱pdɛ yɔm, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
