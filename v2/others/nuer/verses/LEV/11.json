          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Täämɛ ti̱ti̱ kɛ kɛn ŋuɔ̱t kɛ kui̱ le̱yni, kɛn diit, kɛ tin diaal tin tëk a jäl rɛy pi̱i̱ni kɛnɛ tin jäl wi̱i̱ muɔ̱ɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia jɛ dhil ti̱t agɔaa kam kä mi gɔaa kɛnɛ mi jiääk, kam le̱yni tin dëë cam kɛn le̱y tin /ca cam.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
            "verseOrgIds": [
              "LEV.11.47"
            ]
          }
        }
      ]
    }
