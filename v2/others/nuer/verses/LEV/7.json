      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ jɛn luɔt kɛ kui̱ mucni tin waŋkɛ, muc bɛɛl, muc dui̱rä, muc cutdä, muc kue̱ny bööthni la̱t Kuɔth muc nyuaakä. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɛn tëë ci Kuoth Nhial kɛ ka̱m Muthɛ wi̱i̱ pa̱a̱m kä Thi-nay, cäŋ ëë jiökɛ ji̱ I-thɛ-rɛl i̱, akɛ nööŋkɛ muckiɛn Kuoth Nhial, däär dɔaar Thi-nay.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
    }
