        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cua duɔth lätni Rɛ-ɣɛ̈-bɔm gɔ̱a̱r rɛy buɔk kuɛ̈ɛ̈ni kua̱ri Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä la Rɛ-ɣɛ̈-bɔm kɛnɛ Ya-rɔ-baam a nyiëëny. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Rɛ-ɣɛ̈-bɔm li̱w kä cua jɛ kony guäth ëë ca gua̱ni kony thi̱n därwec Dee-bid. Kä cɔalkɛ man i̱ Naamaa kä ji̱ Am-on. Kä cu gatdɛ ni Ä-bi-yam ruëc kɛ gua̱a̱thdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
            "verseOrgIds": [
              "1KI.14.31"
            ]
          }
        }
      ]
    }
