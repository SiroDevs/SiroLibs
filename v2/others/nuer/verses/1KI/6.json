          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ puɔ̱ny luaak kɛɛliw kɛt kɛ pua̱ny ti ce̱tkɛ pua̱ny jaakni kɛnɛ nöör kɛ gaakni juaacni, rɛy duëël rɛci kɛnɛ duel in di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
