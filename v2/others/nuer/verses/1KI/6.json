              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ thi̱i̱k duëël rɛci mi jic rɛw la̱t kɛ jiath Ɔ-lip mi tekɛ kui̱ dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
