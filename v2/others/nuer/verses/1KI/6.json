          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ro̱o̱th luaak rɔth kɛ da̱a̱p ni duëël rɛci amäni duel palä.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
