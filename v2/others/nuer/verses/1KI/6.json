          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ kɛt kɛ pua̱ny ti ce̱tkɛ pua̱ny jaakni, kɛnɛ nöör, kɛ gaakni juaacni. Kä cuɛ kɛ rɔth kɛ da̱a̱p amäni ketkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
