              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ŋuaan runi cu päny luaak Kuɔth Nhial cuɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
