          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ thi̱i̱k duëël in di̱i̱t la̱t bä kɛ jiath Ɔ-lip ala mi päär, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ thiekni jiaath ŋuëri da̱ŋ rɛw, lɛp nɛmɛ rɔ kui̱c ɛmɛ kä lɛp min dɔ̱ŋ rɔ kui̱c in dɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
