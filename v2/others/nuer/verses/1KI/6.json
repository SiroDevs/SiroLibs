    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ta̱th Thɔ-lo-mon kɛ luaak Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ run ti kur ŋuaan wi̱cdɛ jiɛn bädäk kɛ kɔr kä mëë ci kɛ jiɛn kä I-jëp, kɛ ŋuaan runi ruecä Thɔ-lo-mon kɛ I-thɛ-rɛl, kɛ rɛw päthni, cu Thɔ-lo-mon luak Kuɔth Nhial tok kɛ ta̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn luak in ci kuäär ni Thɔ-lo-mon jɛ ta̱th Kuoth Nhial bärɛ piny tëë kɛ jua̱th tetni ti jiɛn bäkɛl, kä ɣäp ɣääpdɛ a jua̱th tetni ti jiɛn da̱ŋ rɛw, kä bärɛ nhial ɛ jua̱th tetni ti jiɛn da̱ŋ diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bäŋ in wee nath rɛy luak ɛ jua̱th tetni ti jiɛn da̱ŋ rɛw bärɛ piny, kä ɣäp ɣääpdɛ tekɛ jua̱th tetni da̱ŋ wäl päärɛ kɛ ɣäp ɣääp rɛy luak puɔ̱nydɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ luak lät kä wernyini ti ciɛw ciɛɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jɔthni täth wilɛ kɛ puɔ̱ny luaak gëëkni, kɛnɛ rɛy luaak rɛc i̱. Kä cuɛ jɛ go̱l kɛ duël. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu duel piɛny di̱tdɛ a jua̱th tetni da̱ŋ dhieec, kä cu duel da̱a̱r di̱tdɛ a jua̱th tetni da̱ŋ bäkɛl, kä cu duel nhial di̱tdɛ a jua̱th tetni da̱ŋ bärɔw. Kä cuɛ rar duëël lät kä ri̱i̱wni kɛ ɣöö /ca cuŋni tin la rɔamkɛ duel bi lɛ la̱t puɔ̱ny luaak.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä pääm tëë la̱tkɛ ni luak Kuɔth, kɛ ti ca kuac ni rɛy dɔaar. Kɛ kui̱c ɛmɔ cuɛ thil jɔw dëthni kiɛ yiëëth mi cua liŋ täth luaak.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu thok duëël in te däär lot ni kui̱c cuëëc luaak. Kä cua moc kɛ ko̱o̱tni ti wä duëël in te däär kɛnɛ min te nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu kuäär ni Thɔ-lo-mon thuɔ̱k kɛ ta̱th luaak. Kä cuɛ wi̱c luaak la̱t kɛ kɔy kɛnɛ tak ŋuër. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ duël la̱t go̱lɛ kɛ ni luak, bäriɛn ɛ jua̱th tetni da̱ŋ dhieec, raar jɔk luaak, cakɛ ku lɛ dɔap puɔ̱ny luaak kɛ thieer ŋuër.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu ruac Kuɔth Nhial ben kä Thɔ-lo-mon i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ kui̱ luaak ɛ lätdi mi, mi tiitdi ŋuɔ̱tkä kɛnɛ luëëkä kä bikɛ luɔ̱th, ɣän bä mëë cä la̱r guur ni Dee-bid lät kä ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä cieŋ rɛy gan I-thɛ-rɛl, kä cä nɛɛkä ni ji̱ I-thɛ-rɛl bi pa̱l ruëëc.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu Thɔ-lo-mon luak thuk kɛ ta̱th.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Riali rɛy luaak ikä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ puɔ̱ny luaak rɛc ɔ car kɛ baak ŋuër. A känɛ jɛ ni kä ro̱o̱th luaak cu mäni wi̱cdɛ rɛci, cuɛ kumkɛ jiɛn. Kä cua ro̱o̱th pap kɛ jiɛn lurä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ duel rɛci gua̱th in leny gɔɔydɛ ti diaal täth thar luaak kɛ jiath ŋuer a känɛ jɛ ni ro̱o̱thä cu mäni wi̱cdɛ, tekɛ jua̱th tetni ti jiɛn da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu rɛy luaak in ku la gua̱th palä nhiam luaak rɛci tekɛ jua̱th tetni ti jiɛn ŋuaan bärɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn jiath rɛy luaak ca kët bëër kɛnɛ gaakni juaacni. Cua rɛy luaak kɛɛliw kum kɛ jiath kɛ ɣöö ci pääm pua̱ny luaak bi jɔɔc. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.18",
            "verseOrgIds": [
              "1KI.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thar luaak rɛci cuɛ duel la̱t rɛy duëël in te rɛci, kɛ ɣöö bi Thanduk matdä ruac Kuɔth Nhial te thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu bär duëël rɛci a jua̱th tetni ti jiɛn da̱ŋ rɛw, kä cu di̱tdɛ a jua̱th tetni ti jiɛn da̱ŋ rɛw bä cu mäni bärɛ nhial a jua̱th tetni ti jiɛn da̱ŋ rɛw. Kä cuɛ jɛ rɔth kɛɛliw kɛ da̱a̱p mi lɛy lɛy, kä cuɛ yi̱k jiaath mi di̱i̱t la̱t bä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔ-lo-mon rɛy luaak rɔth kɛ da̱a̱p mi lɛy lɛy, kä cuɛ thok duëël rɛci kal kɛ kuatni dääpä, kä cuɛ jɛ rɔth kɛ da̱a̱p. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ luak kɛɛliw rɔth kɛ da̱a̱p amäni mëë cɛ thuɔ̱k. Kä cuɛ yi̱k duëël rɛci rɔth kɛ da̱a̱p bä.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn rɛy duëël rɛci cuɛ pua̱ny da̱ŋ rɛw ti ce̱tkɛ pua̱ny jaakni la̱t kɛ jiath Ɔ-lip bäriɛn nhial ɛ jua̱th tetni da̱ŋ wäl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä te gɔ̱a̱k kɛl kä pua̱ny jaakni kɛ jua̱th tetni da̱ŋ dhieec bärɛ, kä te gɔ̱a̱k kuec in dɔ̱ŋ kɛ jua̱th tetni da̱ŋ dhieec. A känɛ jɛ ni peek gɔ̱kä kɛl amäni pek in dɔ̱ŋ tëë kɛ jua̱th tetni da̱ŋ wäl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä puɔ̱ny in dɔ̱ŋ bä tëë kɛ jua̱th tetni da̱ŋ wäl. Kɛn pua̱ny da̱ŋ rɛw päär ta̱a̱diɛn, kä cäät kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te bär kä kɛl kɛ jua̱th tetni da̱ŋ wäl, kä ɛ jɛn ta̱a̱ kä min dɔ̱ŋ bä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ pua̱ny tin ce̱tkɛ pua̱ny jaakni la̱th rɛy duëël rɛc ɛ mi. Kä cukɛ gɔ̱kiɛn ɣär wä gɔ̱a̱k kä kɛl yiëth ni puɔ̱ny luaak kui̱c ɛmɛ, kä gɔ̱a̱k kä min dɔ̱ŋ wëë yiëth ni puɔ̱ny luaak kui̱c in dɔ̱ŋ. Kä lɛn gɔ̱kiɛn tin kɔ̱ŋ ben röm däär luaak. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ rɔth kɛ da̱a̱p.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
