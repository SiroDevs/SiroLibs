              "1KI.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci gök ëë loc jɛ jɔk dup ɛ liŋ. Cuɛ wëë, “Ɛ raan Kuɔth in /ken ruac Kuɔth Nhial luɔ̱th. Kɛ kui̱c ɛmɔ cɛ jɛ ka̱m lony ɛ ci jɛ camɔ, ce̱tnikɛ ruac ëë ci Kuoth Nhial ɛ la̱t jɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ gaatkɛ jiök i̱, “Rialɛ muulikä kɛ kui̱dä.” Kä cukɛ jɛ rialikä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.27",
            "verseOrgIds": [
              "1KI.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ wä kä cuɛ puɔ̱nydɛ jek a ca yuɔr dup, kä muul kɛnɛ lony tekɛ cuŋä gekä ri̱eŋdɛ. Kä lony /kenɛ jɛ cam, kä /kenɛ muul cam. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.28",
            "verseOrgIds": [
              "1KI.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gök ri̱ŋ ran Kuɔth la̱th jɔɔk muɔ̱l, kä cuɛ jɛ nööŋ wi̱c, cuɛ jɛ kony kä cuɛ pa̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.29",
            "verseOrgIds": [
              "1KI.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ri̱ŋdɛ la̱th rɛy kɔ̱kädɛ. Kä cukɛ jɛ par wëë i̱ “Dämaar!” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.30",
            "verseOrgIds": [
              "1KI.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä min cɛ kony, cuɛ gaatkɛ jiök i̱, “Mi wa̱a̱ li̱w, kuɔnyɛ ɣä kɔ̱k in ca raan Kuɔth kony thi̱n. La̱thɛ cɔ̱wkä gekä cɔ̱ɔ̱nikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.31",
            "verseOrgIds": [
              "1KI.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ruac Kuɔth Nhial ëë cɛ lat kɛ kui̱ yi̱kä kä Beth-ɛl, kɛnɛ tin diaal tëë cɛ lat kɛ kui̱ duëli palä tin te rɛy wi̱i̱ni Tha-mɛ-ria, bi ka thuɔ̱ɔ̱k.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä ti̱ti̱ /ken Ya-rɔ-baam jiäkɛ päl, kä cuɛ nyɔk ni bööth gua̱thni palä kɛ kuëny kä nɛy diaal. Kä cuɛ kuany ni nɛy tin görkɛ böth palä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nɔmɔ a duer dhɔr Ya-rɔ-baam min cu jɛ döp da̱k kɛnɛ riawdɛ wi̱i̱ muɔ̱ɔ̱n.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
          }
        }
      ]
    }
