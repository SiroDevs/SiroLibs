          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ tekɛ ko̱r kam Atha kuäär Juda kɛnɛ Bɛ̈ca kuäär I-thɛ-rɛl kɛ ni̱n kuäärädiɛn diaal.",
          "type": "text",
          "attrs": {
