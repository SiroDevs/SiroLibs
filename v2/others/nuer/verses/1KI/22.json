  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1KI 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac go̱kä ni Mi-ka-yaa kɛ kui̱ Ɛ̈-ɣab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ run diɔ̱k tëë te Thi-ri-ya kɛnɛ I-thɛ-rɛl ko̱o̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.1",
            "verseOrgIds": [
              "1KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ diɔ̱ɔ̱k runi cu Yɛ-ɣo-ca-pat kuäär Juda ben kä kuäär I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.2",
            "verseOrgIds": [
              "1KI.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär I-thɛ-rɛl ji̱ kɔaarɛ jiök i̱, “Ŋäc yɛnɛ ɛn ɣöö Ra-moth-gil-yad ɛ wecdan. Kä ɛŋu bit kɔn ɔ mɔ canɛ jɛ kän kä kuäär Thi-ri-ya mɔ?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.3",
            "verseOrgIds": [
              "1KI.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ Yɛ-ɣo-ca-pat jiök i̱, “Bi wä ko̱o̱r kɛɛl kɛ ɣä kä Ra-moth-gil-yad?” Kä cu Yɛ-ɣo-ca-pat kuäär thuk duëli kuec caam loc i̱, “Ɣän ca̱tdä kɛ ji̱, kä nɛɛkä ce̱tkɛ kɛ nɛɛku, jiöŋköörikä ce̱tkɛ kɛ jiöŋkööriku.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yɛ-ɣo-ca-pat kuäär thuk duëli kuec caam jiök i̱, “Thiec ruac Kuɔth Nhial kɛ nhiam.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.5",
            "verseOrgIds": [
              "1KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär thuk duëli kuec caam go̱o̱k mat guäth kɛl, nɛy ti kur ŋuaan kä cuɛ kɛ jiök i̱, “Ɣän bä wä nyiëëny kɛ Ra-moth-gil-yad, kiɛ /cä bi wä?” Kä cukɛ wëë, “Wër, mak nikɛ bi Kuoth Nhial kɛ ka̱m ji̱.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.6",
            "verseOrgIds": [
              "1KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yɛ-ɣo-ca-pat wëë, “Thilɛ gök Kuɔth Nhial mi tëë wanɛ mi dënɛ thiec?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.7",
            "verseOrgIds": [
              "1KI.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär thuk duëli kuec caam ɛ loc i̱, “Te ram kɛl mi dënɛ Kuoth Nhial thiec kä jɛ thi̱n gat Yim-laa ni Mi-ka-yaa a thi̱n. Duundɛ ɣöö lökä jɛ, kɛ ɣöö /kenɛ mi gɔaa met lat kɛ kui̱dä, la latdɛ ni ti jiäk.” Kä cu Yɛ-ɣo-ca-pat wee, “Kuäär /cu jɛ lar inɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.8",
            "verseOrgIds": [
              "1KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär thuk duëli kuec caam raan kɔaarɛ cɔl, kä cuɛ jiök i̱, “Wër no̱o̱ŋni Mi-ka-yaa gat Yim-laa, kɛ pɛ̈th.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.9",
            "verseOrgIds": [
              "1KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ kuäär thuk duëli kuec caam kɛnɛ Yɛ-ɣo-ca-pat kuäär Juda tekɛ nyuurä kɔamni kuäärädiɛn kä ca bieyni kuäärä la̱th, do̱o̱r kɔ̱a̱m bɛɛl thok rɛ̈ɛ̈k kä Tha-mɛ-ria. Kä lat go̱o̱k diaal ruaacni go̱o̱kä nhiamdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.10",
            "verseOrgIds": [
              "1KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dhid-ki-yaa gat Kɛ-nɛ̈ɛ̈-naa rɔ moc tuɔ̱ŋ yieethä kä cuɛ wee, “Nɛmɛ ɛ min ci Kuoth Nhialɛ lar i̱, ‘Kɛ ti̱ti̱ bi ji̱ Thi-ri-ya joc amäni mi ci kɛ däk.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.11",
            "verseOrgIds": [
              "1KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu go̱o̱k diaal lat ni ɛn nɔ wäkɛ i̱, “Wër makni Ra-moth-gil-yad. Bi Kuoth Nhial kɛ ka̱m ji̱ kuäär.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.12",
            "verseOrgIds": [
              "1KI.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.12",
            "verseOrgIds": [
              "1KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ram in ci Mi-ka-yaa wä cɔl wee i̱, “Nɛnɛ Mi-ka-yaa, ruac göökni ɛ kɛl mi gɔaa kɛ kuäär. Ku ruacdu jak kä ce̱tkɛ ruacdiɛn, ala nac mi gɔaa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.13",
            "verseOrgIds": [
              "1KI.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö cu Mi-ka-yaa wëë, “Ce̱tnikɛ ciöt Kuɔth Nhial, mɔ bi Kuoth Nhialɛ la̱rä mɔ, ɛ jɛn bä lat ni jɛ mɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.14",
            "verseOrgIds": [
              "1KI.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min cɛ cop kä kuäär, cu kuäär ɛ jiök i̱, “Mi-ka-yaa banɛ wä nyiëëny kɛ ji̱ Ra-moth-gil-yad, kiɛ /canɛ bi wä?” Kä cuɛ jɛ loc i̱, “Wër makni kɛ. Bi Kuoth Nhial kɛ ka̱m ji̱ kuäär.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.15",
            "verseOrgIds": [
              "1KI.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö cu kuäär ɛ jiök i̱, “Kä ɣän cä kulɛ ruac kɛ ji̱ ni kä di, kä thilɛ mi la latdi kɛ ɣä, latdi ni thuɔ̱k kɛ ɣä kɛ ciöt Kuɔth Nhial?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.16",
            "verseOrgIds": [
              "1KI.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mi-ka-yaa wëë, “Ɣän cä ji̱ thuk duëli kuec caam diaal nɛn cikɛ däk wuɔ̱thni päämni ce̱tkɛ det ti thil yien. Kä cu Kuoth Nhial wee i̱, ‘Kɛn nɛy ti̱ti̱ thilɛ kɛ bo̱o̱th. Ɛ ramɔ loc dhɔrɛ kɛ mal.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.17",
            "verseOrgIds": [
              "1KI.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär thuk duëli kuec caam Yɛ-ɣo-ca-pat jiök i̱, “/Ka̱n jɛ la̱r ji̱ ɛn ɣöö /cɛ mi gɔaa dëë lat kɛ kui̱dä, bɛ lat ni mi jiäk?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.18",
            "verseOrgIds": [
              "1KI.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mi-ka-yaa wëë, “Kɛ kui̱c ɛmɔ liŋ ruac Kuɔth Nhial. Ɣän cä Kuoth Nhial nɛn te nyuurä kɔam kuäärädɛ, kä ja̱a̱k nhial diaal tekɛ cuŋä gëëknikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.19",
            "verseOrgIds": [
              "1KI.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial wëë i̱, ‘Ɛŋa mi bi Ɛ̈-ɣab wä pɛlɔ a bɛ wä ko̱o̱r kä bɛ wä li̱w kä Ra-moth-gil-yad?’ Kä cu ram ɔ mɛmɛ la̱t kä cu ram min dɔ̱ŋ lat ni ti gööl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.20",
            "verseOrgIds": [
              "1KI.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu yiëë ben cuɔ̱ŋ nhiam Kuɔth Nhial wëë i̱, ‘Bä jɛ wä pɛl.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.21",
            "verseOrgIds": [
              "1KI.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ɛ thiec i̱, ‘Kɛ duɔ̱ɔ̱p ith?’ Kä cuɛ wëë, ‘Bä wa̱a̱ yiëë kacä mi cieŋ thok gööknikɛ diaal.’ Kä cu Kuoth Nhial wëë, ‘Biɛ wä pɛl, kä biɛ luäŋ. Wër lätni jɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ täämɛ ci Kuoth Nhial yiëë kacä la̱th thukni göökniku diaal. Ci Kuoth Nhial mi jiääk lat kɛ kui̱du.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.23",
            "verseOrgIds": [
              "1KI.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.23",
            "verseOrgIds": [
              "1KI.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dhid-ki-yaa gat Kɛ-nɛ̈ɛ̈-naa ben thieekä Mi-ka-yaa, cuɛ pat ni jio̱mdɛ kä cuɛ wëë i̱, “Dëë yiëë Kuɔth Nhial jiɛn kä ɣä i̱di a bɛ wä ruac kɛ ji̱?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.24",
            "verseOrgIds": [
              "1KI.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mi-ka-yaa wëë, “Biɛ nɛn cäŋ in wi̱i̱ rɔ wä tɛ̱̈ɛ̱̈ rɛy duëël rɛc i̱.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.25",
            "verseOrgIds": [
              "1KI.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär thuk duëli kuec caam wëë i̱, “Yianɛ Mi-ka-yaa, kä luɔcɛ jɛ jɔk nöŋɛ jɛ Am-on rueec wec kɛnɛ gat kua̱r ni Yo-ac. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.26",
            "verseOrgIds": [
              "1KI.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jiök ɛn ɣöö kuäär wee, ‘La̱thɛ ram ɛ mi duëël yieenä, kä muɔcɛ jɛ kɛ mi̱eth mi dak, kɛnɛ pi̱ ti tɔt, amäni mi cä luny jɔk kɛ mal.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.27",
            "verseOrgIds": [
              "1KI.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mi-ka-yaa wee, “Mi wi̱i̱ luny jɔk kɛ mal /ken Kuoth Nhial ruac kɛ ɣä.” Kä cuɛ wee, “Liɛŋɛ mi cä lat ɛ yɛn nɛy diaal ti̱ti̱!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.28",
            "verseOrgIds": [
              "1KI.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lia̱a̱ Ɛ̈-ɣab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.28",
            "verseOrgIds": [
              "1KI.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu kuäär thuk duëli kuec caam kɛnɛ Yɛ-ɣo-ca-pat kuäär Juda Ra-moth-gil-yad wä mak. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.29",
            "verseOrgIds": [
              "1KI.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär thuk duëli kuec caam Yɛ-ɣo-ca-pat jiök i̱, “Ɣän bä rɔ jay kä bä wä ko̱o̱r, duundɛ ɣöö ji̱n ciɛŋ bi̱i̱du.” Kä cuɛ rɔ jay kä cuɛ wä ko̱o̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.30",
            "verseOrgIds": [
              "1KI.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ cu kuäär Thi-ri-ya bööth rɛ̈m thurbiɛɛlikɛ ti jiɛn diɔ̱k wi̱cdɛ rɛw jiök i̱, “/Cuarɛ nyiëëny kɛ nɛy tin kɔ̱ŋ ɛ ni kuäär thuk duëli kuec caam kärɔa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.31",
            "verseOrgIds": [
              "1KI.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci bööth thurbiɛɛli Yɛ-ɣo-ca-pat nɛn, cukɛ wee, “Ɛ thuɔ̱k ɛ jɛn kuäär thuk duëli kuec caam ɛnɛ.” Cukɛ rɔ ri̱t wäkɛ nyiëëny kɛ jɛ. Kä cu Yɛ-ɣo-ca-pat wiee. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.32",
            "verseOrgIds": [
              "1KI.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci bööth thurbiɛɛli jɛ nɛn ɛn ɣöö /ciɛ jɛn kuäär thuk duëli kuec caam, cukɛ rɔ ri̱t jucdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.33",
            "verseOrgIds": [
              "1KI.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ lɛ tekɛ ram mi cu bäärɛ lɛ yuɔr bɛ, cuɛ kuäär thuk duëli kuec caam bär ni röm lääkä kuen kueeni kɛnɛ ko̱t kath. Kä cuɛ geer thurbiɛɛlɛ jiök i̱, “Ri̱t ni rɔ gekä naŋ ni ɣä raar rɛy köör, kɛ ɣöö ca ɣä moc kɛ buɔ̱t.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.34",
            "verseOrgIds": [
              "1KI.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ko̱r leeth ɛn cäŋ ɛmɔ, kä cu kuäär cuɔ̱ŋ rɛy thurbiɛɛlɛ lotdɛ ni ji̱ Thi-ri-ya, kä kɛ thiaŋ cuɛ li̱w. Kä cu riɛm butdä lo̱ny rɛy thurbiɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.35",
            "verseOrgIds": [
              "1KI.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ gua̱th in kony kɛ cäŋ, cu wiee ben kä rɛm i̱, “Ɛ ramɔ wä wi̱i̱dɛ, kä ɛ ramɔ wä ro̱o̱lɛ!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.36",
            "verseOrgIds": [
              "1KI.22.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.36",
            "verseOrgIds": [
              "1KI.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu kuäär ni Ɛ̈-ɣab li̱w, kä cua nööŋ kä Tha-mɛ-ria. Kä cua jɛ kony thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.37",
            "verseOrgIds": [
              "1KI.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua thurbil lak puul Tha-mɛ-ria, kä cu jio̱k riɛmdɛ lap, kä cu ria̱r rɔ lak thi̱n, ce̱tnikɛ ruac Kuɔth Nhial ëë cɛ lar. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.38",
            "verseOrgIds": [
              "1KI.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ cua duɔth lätni Ɛ̈-ɣab nikɛ duel tuɔ̱ŋ guɔ̱ri mëë cɛ la̱t gɔ̱r rɛy buɔk kuɛ̈ɛ̈ni kua̱ri I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.39",
            "verseOrgIds": [
              "1KI.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu Ɛ̈-ɣab li̱w. Kä cu gatdɛ ni Ä-ɣɛ̈dh-yaa ruec kɛ gua̱a̱thdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.40",
            "verseOrgIds": [
              "1KI.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yɛ-ɣo-ca-pat kuäär Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.40",
            "verseOrgIds": [
              "1KI.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yɛ-ɣo-ca-pat gat Atha a kuäär kä Juda kɛ ŋuaan runi ruëc Ɛ̈-ɣab kuäär I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.41",
            "verseOrgIds": [
              "1KI.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë tok ruec a tekɛ run ti jiɛn diɔ̱k wi̱cdɛ dhieec, kä cuɛ ruëc kä Jɛ-ru-tha-lɛm kɛ run ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec. Kä cɔalkɛ man i̱ Ä-dhu-baa nyaa Cil-ɣi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.42",
            "verseOrgIds": [
              "1KI.22.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ guɔ̱ɔ̱r ni duɔ̱p gua̱n ni Atha diaal. /Kenɛ kɛ päl, cuɛ la̱t ni cuɔ̱ŋ nhiam Kuɔth Nhial. Kä cuɛ ŋot /ka̱n gua̱th pali kuthni guäyni woc, kä cu naath ŋot thöpkɛ muc kä waŋkɛ wal tin kuɔ̱r kuɔ̱ɔ̱r gua̱thni pali kuthni guäyni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.43",
            "verseOrgIds": [
              "1KI.22.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yɛ-ɣo-ca-pat mal la̱t kɛnɛ kuäär I-thɛ-rɛl.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.44",
            "verseOrgIds": [
              "1KI.22.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.44",
            "verseOrgIds": [
              "1KI.22.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 22:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua duɔth lätni Yɛ-ɣo-ca-pat diaal gɔ̱a̱r rɛy buɔk kuɛ̈ɛ̈ni kua̱ri Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.45",
            "verseOrgIds": [
              "1KI.22.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ tut kɛnɛ ŋut tin ria̱r tin palkɛ kuth guäyni tëë ci duɔth kä gua̱n ni Atha näk.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.46",
            "verseOrgIds": [
              "1KI.22.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.46",
            "verseOrgIds": [
              "1KI.22.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 22:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɛ-dɔm thil kuäär. Ruacɛ raan kɔaar kua̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.47",
            "verseOrgIds": [
              "1KI.22.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 22:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yɛ-ɣo-ca-pat babuur la̱t kä Tar-cic kɛ ɣöö bɛ da̱a̱p wä nööŋ kä Ɔ-për. Duundɛ ɣöö /kenkɛ wä, kɛ ɣöö ci babuuri tiath kä Ɛ-dhon-ga-bɛr. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.48",
            "verseOrgIds": [
              "1KI.22.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 22:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä Ä-ɣɛ̈dh-yaa gat Ɛ̈-ɣab Yɛ-ɣo-ca-pat jiök i̱, “Ɛ nɛɛkä wä rɛy babuuri kɛɛl kɛ nɛɛku,” duundɛ ɣöö /ken Yɛ-ɣo-ca-pat ɛ nhɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.49",
            "verseOrgIds": [
              "1KI.22.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 22:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yɛ-ɣo-ca-pat li̱w, kä cua kony kɛɛl kɛ gua̱ni därwec gua̱n ni Dee-bid. Kä cu gatdɛ ni Yɛ-yo-ram ruëc kɛ gua̱a̱thdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.50",
            "verseOrgIds": [
              "1KI.22.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ä-ɣɛ̈dh-yaa kuäär I-thɛ-rɛl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 22:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.50",
            "verseOrgIds": [
              "1KI.22.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
