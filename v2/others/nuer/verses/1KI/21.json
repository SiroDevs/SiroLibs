              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kä cuɛ thil ram mi cu rɔ kɔak a bɛ mi jiääk la̱t waaŋ Kuɔth Nhial ce̱tkɛ Ɛ̈-ɣab, mëë ci ciekdɛ ni I-dhɛ-bɛl jɛ com. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ lät a jiäk kɛ ɣöö guurɛ ni kuth guäyni, ce̱tkɛ mëë ci ji̱ Ɛ-mor ɛ la̱t, tëë ci Kuoth Nhial kɛ juɔc raar nhiam ji̱ I-thɛ-rɛl.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
    },
    {
