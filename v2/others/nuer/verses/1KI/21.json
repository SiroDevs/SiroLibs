          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Ɛ̈-ɣab rieet ti̱ti̱ liŋ, cuɛ bieynikɛ rɛ̈t, kä cuɛ bieyni cuali la̱th puɔ̱ɔ̱nydɛ kä cuɛ thɛɛk, kä cuɛ tɔ̱ɔ̱c kɛ bieyni cuali, kä cuɛ ja̱l ɛ luaŋ luaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ruac Kuɔth Nhial ben kä E-li-yaa kä Tic-be wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ciɛ nɛn täämɛ ɛn ɣöö ci Ɛ̈-ɣab mua̱l nhiamdä i̱di? Kɛ ɣöö cɛ mua̱l nhiamdä, /cä jɛ bi nöŋ mi jiäk kɛ ni̱nkɛ. Duundɛ ɣöö kɛ ni̱n gankɛ bä da̱k nööŋ dhɔrɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
      ]
