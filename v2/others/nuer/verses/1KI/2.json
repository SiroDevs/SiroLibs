  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1KI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac Dee-bid in jɔak kɛ Thɔ-lo-mon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci ni̱n li̱eth Dee-bid thia̱k, cuɛ gatdɛ ni Thɔ-lo-mon cɔl kä cuɛ jɛ la̱t ruac wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.1",
            "verseOrgIds": [
              "1KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ci gua̱a̱th li̱thdä cop. Bum rɔ kä cieŋni ce̱tkɛ wut, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.2",
            "verseOrgIds": [
              "1KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tit tin ci Kuoth Nhial Kuothdu kɛ la̱t ji̱, tit dupkɛ kɛnɛ ŋuɔ̱tkɛ, kɛ luëëkɛ, ce̱tkɛ min ca gɔ̱r kä ŋuɔ̱t Muthɛ, kɛ ɣöö bi gɔaa kä ti diaal tin bi la̱t kɛnɛ gua̱a̱th ɛ bi wä thi̱n ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.3",
            "verseOrgIds": [
              "1KI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial ruacdɛ mëë cɛ lat kɛ kui̱dä jak kä cuŋ, mëë wëë i̱, ‘Mi wä gaatku dupkiɛn wä tit, kä bikɛ cieŋ kɛɛl kɛ ɣä kɛ luthdiɛn kɛ ŋuɔ̱tkä kɛ lɔcdiɛn kɛɛliw, kɛnɛ ca̱riɛn kɛɛliw, bikɛ I-thɛ-rɛl ruac.’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ŋäcni min ci Yo-ab gat Dhɛ-ru-yaa ɛ lät kä ɣä, kɛ näkdɛ kɛ bööth rɛ̈m I-thɛ-rɛl da̱ŋ rɛw, Ä-bi-ner gat Ner, kɛnɛ Ä-ma-tha gat Yɛ-thɛr. Näkɛ kɛ rɛy malä kɛ cut riɛm mi ca wuɔ̱th piny kɛ ni̱n ko̱o̱r. Cɛ nɛy ti thil ŋu näk, kä täämɛ ci riɛkdɛ pɛn wi̱i̱dä, a ca duŋdä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.5",
            "verseOrgIds": [
              "1KI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ ŋäcni min bi la̱t. /Cu jɛ jak kä li̱w baaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.6",
            "verseOrgIds": [
              "1KI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ciɛŋ gaat Bar-dhë-lay raan Gil-yad agɔaa, akɛ te rɛy nɛɛni tin mi̱th kɛ ji̱ kɛɛl, kɛ ɣöö cikɛ ɣä lor agɔaa mëë cä rɔ bar kɛ dämuɔɔr ni Ɛ̈b-ca-lom. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.7",
            "verseOrgIds": [
              "1KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amäni Cimi gat Gerɔ, raan Ben-ya-min kä Bɛ̈-ɣu-rim. Cɛ ɣä kuëth ɛ bɛc ɛlɔ̱ŋ mëë wa̱a̱ kä Ma-na-yim, duundɛ ɣöö mëë cɛ ɣä ben lor kä Jɔr-dɛn, cua̱ ya̱c jɛ kɛ ciöt Kuɔth Nhial i̱, ‘/Cä ji̱ bi näk.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.8",
            "verseOrgIds": [
              "1KI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ täämɛ /cu jɛ cari thilɛ jɛ duer, kɛ ɣöö pɛli, ŋäcni min bi lät kä jɛ, biɛ ŋa̱c ɛn ɣöö cɛ li̱w.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.9",
            "verseOrgIds": [
              "1KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lia̱a̱ Dee-bid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.9",
            "verseOrgIds": [
              "1KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid li̱w, kä cua jɛ kony därwec Dee-bid. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.10",
            "verseOrgIds": [
              "1KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu pek ruec Dee-bid kɛ I-thɛ-rɛl a run ti jiɛn ŋuaan. Cɛ ruëc kä Ɣɛb-ron kɛ run bärɔw, kä cɛ ruëc kä Jɛ-ru-tha-lɛm kɛ run ti jiɛn diɔ̱k wi̱cdɛ diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.11",
            "verseOrgIds": [
              "1KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔ-lo-mon nyuur wi̱i̱ kɔam gua̱n ni Dee-bid. Kä cu kuäärɛ pua̱t.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.12",
            "verseOrgIds": [
              "1KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lia̱a̱ Ä-do-ni-yaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.12",
            "verseOrgIds": [
              "1KI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Ä-do-ni-yaa gat Ɣɛ̈-gith ben kä Bɛ̈th-cɛba man Thɔ-lo-mon. Kä Cuɛ Ä-do-ni-yaa jiök i̱, “Ɛ mal bëë ji̱ mɔ?” Kä cuɛ loc i̱, “Ɛ mal.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.13",
            "verseOrgIds": [
              "1KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wëë, “Ta̱a̱ kɛ mi bä la̱r ji̱.” Kä cu Bɛ̈th-cɛba ɛ loc i̱, “Lat ɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.14",
            "verseOrgIds": [
              "1KI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ä-do-ni-yaa wëë, “Ŋäci jɛ ɛn ɣöö kuäär ɛ duŋdä, kä ŋäc ji̱ I-thɛ-rɛl diaal ni ɣöö bi ruëc ni ɣän. Kä cɛ rɔ lɛ riet dämaar, kɛ ɣöö ci Kuoth Nhial ɛ ka̱m jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.15",
            "verseOrgIds": [
              "1KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ta̱a̱ kɛ kɛl mi bä thiec kä ji̱. /Cu jɛ pen ɣä.” Kä cuɛ jɛ loc i̱, “Lat ɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.16",
            "verseOrgIds": [
              "1KI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wëë, “Thiec kuäär ni Thɔ-lo-mon (/Cɛ bi pen ji̱) derɛ ɣä ka̱m Ä-bi-cɛ̈g nya Cu-nem ala ciekdä.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.17",
            "verseOrgIds": [
              "1KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bɛ̈th-cɛba wëë, “Gɔaa ɛlɔ̱ŋ. Bä wä ruac kɛ kuäär kɛ kui̱du.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.18",
            "verseOrgIds": [
              "1KI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bɛ̈th-cɛba wä kä kuäär ni Thɔ-lo-mon, wëë ruac kɛ jɛ kɛ kui̱ Ä-do-ni-yaa. Kä cu kuäär rɔ jiɛc wëë jɛ lor, kä cuɛ rɔ goŋ kɛ man. Kä cuɛ nyuur wi̱i̱ kɔam kuäärädɛ, kä cua man nöŋ kɔm kä cuɛ nyuur kui̱c cuëëc kua̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.19",
            "verseOrgIds": [
              "1KI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wëë, “Ɣän ta̱a̱ kɛ kɛl mi tɔt mi dëë thiec kä cu jɛ pen ɣä.” Kä cu kuäär ɛ loc i̱, “Lat thiecdu ma̱a̱th. /Cä bi pën ji̱.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.20",
            "verseOrgIds": [
              "1KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu man wëë, “Ɛ dämuɔɔr ni Ä-do-ni-yaa kän Ä-bi-cɛ̈g nya Cu-nem ala ciekdɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.21",
            "verseOrgIds": [
              "1KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ni Thɔ-lo-mon man loc i̱, “Ɛŋu mɔ thieci ni Ä-bi-cɛ̈g nya Cu-nem kɛ kui̱ Ä-do-ni-yaa ɔ? Thiec ni jɛ kuäär bä. Kɛ ɣöö ɛ dämaar in di̱i̱t, kɛ ɣöö te bo̱o̱th palä ni Ɛb-ya-thar kui̱dɛ, kɛnɛ Yo-ab gat Dhɛ-ru-yaa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.22",
            "verseOrgIds": [
              "1KI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ni Thɔ-lo-mon rɔ yac nikɛ ciöt Kuɔth Nhial, wëë i̱, “Dëë Kuoth ɣä näk, mi /ci ruac ɛ mi Ä-do-ni-yaa bi näk! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.23",
            "verseOrgIds": [
              "1KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ täämɛ ce̱tkɛ ciöt Kuɔth in tëk, min ci ɣä rialikä, kä ci ɣä la̱th wi̱i̱ kɔam gua̱a̱r ni Dee-bid, kä cɛ ruacdɛ tit kä cɛ ɣä ka̱m kuäär kɔnɛ kuaykä, ɛn walɛ Ä-do-ni-yaa bɛ li̱w.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.24",
            "verseOrgIds": [
              "1KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ni Thɔ-lo-mon Bɛ-na-yaa gat Yɛ-ɣo-ya-da ja̱k. Kä cuɛ Ä-do-ni-yaa wä näk.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.25",
            "verseOrgIds": [
              "1KI.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tuk Ɛb-ya-thar kɛnɛ lia̱a̱ Yo-ab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.25",
            "verseOrgIds": [
              "1KI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär bo̱o̱th palä ni Ɛb-ya-thar jiök i̱, “Wër kä Ä-na-thoth, wecdu. Kɛ ɣöö ro̱ŋi kɛ lia̱a̱. Duundɛ ɣöö /ci bi näk ɛn täämɛ, kɛ ɣöö ɛ ji̱n ɛ nëë guic thanduk matdä ruaacni Kuɔth, nhiam gua̱a̱r ni Dee-bid, kɛnɛ ɣöö cia rik gua̱a̱r diaal nyuak.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu Thɔ-lo-mon Ɛb-ya-thar tuk bo̱thä palä Kuɔth Nhial, Inɔ cuɛ cua̱ thuɔ̱k ruac Kuɔth Nhial ëë cɛ lat kɛ kui̱ kuayni bo̱o̱th palä ni Eli kä Cilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci thok ben kä Yo-ab (Kɛ ɣöö Yo-ab cɛ Ä-do-ni-yaa guɔ̱ɔ̱r) cuɛ rɔ bar rɛy kɛmɛkä Kuɔth Nhial, cuɛ rɔ wä käp kɛ tuɔ̱ŋ yi̱kä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.28",
            "verseOrgIds": [
              "1KI.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ca la̱r kuäär ni Thɔ-lo-mon i̱, “Ci Yo-ab rɔ bar rɛy kɛmɛkä Kuɔth nhial, kä jɛn te gekä yi̱kä,” cu Thɔ-lo-mon Bɛ-na-yaa gat Yɛ-ɣo-ya-da ja̱k i̱, “Wër näk ɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.29",
            "verseOrgIds": [
              "1KI.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bɛ-na-yaa ben rɛy kɛmɛkä Kuɔth Nhial, kä cuɛ jiök i̱, “Ci kuäär wëë, ‘Bërkɛ.’ ” Duundɛ ɣöö cuɛ loc i̱, “Eey, ɣän bä li̱w ɛn wa̱nɛ.” Kä cu Bɛ-na-yaa ruac nyɔk kɛ luc kuäär i̱, “Nɛmɛ ɛ min ci Yo-ab ɛ lar.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ɛ luɔ̱c jɛ i̱, “Lät ni jɛ ce̱tkɛ min cɛ lar, näkɛ kä konyɛ. Inɔ bɛ riɛk riɛm ëë ci Yo-ab ɛ wuɔ̱th piny baaŋ cu woc kä ɣä kɔnɛ dhɔr gua̱a̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.31",
            "verseOrgIds": [
              "1KI.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial ɛ cu luɔ̱c riɛm in cɛ wuɔ̱th piny, a kui̱c gua̱a̱r ni Dee-bid ɛ, cɛ nɛy da̱ŋ rɛw ti gɔw ni kɛn kä jɛ näk, Ä-bi-ner gat Ner, bo̱o̱th rɛ̈m kä I-thɛ-rɛl, kɛnɛ Ä-ma-tha gat Yɛ-thɛr bo̱o̱th rɛ̈m kä Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.32",
            "verseOrgIds": [
              "1KI.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ bi riɛmdiɛn ben kä Yo-ab, kɛnɛ kuaykɛ amäni cäŋ kɛl. Duundɛ ɣöö Dee-bid, kɛnɛ kuaykɛ kɛ dhɔrɛ kɛ kuäärɛ bikɛ tekɛ mal ni ciaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.33",
            "verseOrgIds": [
              "1KI.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bɛ-na-yaa gat Yɛ-ɣo-ya-da wä, kä cuɛ jɛ wä näk. Kä cua jɛ kony dhɔrɛ rɛy dɔaar. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.34",
            "verseOrgIds": [
              "1KI.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär Bɛ-na-yaa gat Yɛ-ɣo-ya-da la̱th wi̱i̱ rɛ̈m kɛ gua̱a̱th Yo-ab, kä cuɛ Dha-dok bo̱o̱th palä la̱th guäth Ɛb-ya-thar.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lia̱a̱ Cimi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär Cimi jäk kä ram wä jɛ cɔl, kä cuɛ jɛ jiök i̱ “Lät ni rɔ kä duel kä Jɛ-ru-tha-lɛm, kä cieŋni thi̱n, /cu jiɛn thi̱n a cäŋ te ŋu i̱di bä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.36",
            "verseOrgIds": [
              "1KI.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö cäŋ in bi wä raar, a bi yier Kid-ron jiɛth, biɛ cu ŋa̱c ɛn ɣöö bi li̱w. Kä bi riɛmdu te wi̱i̱du.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Cimi kuäär loc i̱, “Mɔ ci lar ɔ gɔaaɛ. Ɣän bä la̱t ni min ci lar.” Kä cu Cimi cieŋ kä Jɛ-ru-tha-lɛm kɛ ni̱n ti ŋuan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö cuɛ tuɔɔk kɛ cäŋ kɛl kɛ kɔr thuɔ̱k runi da̱ŋ diɔ̱k, cu gaat Cimi da̱ŋ rɛw ri̱ŋ kä A-kic gat Maakaa, kuäär Gɛ̈th. Kä min ca la̱r Cimi i̱, “Nɛnɛ, gaatku kɛnɛ kä Gɛ̈th.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.39",
            "verseOrgIds": [
              "1KI.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Cimi muul rial ikä, kä cuɛ wä kä A-kic kä Gɛ̈th, wëë gaatkɛ go̱r. Cuɛ kɛ wä nööŋ kä Gɛ̈th. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.40",
            "verseOrgIds": [
              "1KI.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ca la̱r Thɔ-lo-mon ɛn ɣöö ci Cimi wä kä Gɛ̈th kä cɛ rɔ ri̱t, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.41",
            "verseOrgIds": [
              "1KI.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu kuäärɛ jäk kä ram wä jɛ cɔl, kä cuɛ jɛ jiök i̱, “/Ka̱n ji̱ jak kä yaaci rɔ kɛ ciöt Kuɔth Nhial, kä cä ji̱ luek i̱, ‘Ŋäcni jɛ kɛ cäŋ in bi wä guäth mi dɔ̱ŋ a cäŋ te ŋu i̱di, bi li̱w?’ Kä curi ɣä loc i̱, ‘Mɔ ci lar ɔ gɔaaɛ, bä luɔ̱th.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.42",
            "verseOrgIds": [
              "1KI.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuɛ la ŋu mɔ /keni ya̱cdu kɛ Kuoth Nhial tit ɔ, kɛnɛ ruac in cä la̱t ji̱ mɔ?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.43",
            "verseOrgIds": [
              "1KI.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär Cimi lɛni jiök bä i̱, “Ji̱n ŋäci jɛ, jiäk diaal tëë ci la̱t kɛ kui̱ gua̱a̱r ni Dee-bid kɛ lɔcdu. Inɔ bi Kuoth Nhial jiäku diaal la̱th ni wi̱i̱du. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö bɛ ɣä poth, kä bɛ kuäär Dee-bid jak kä tëë thi̱n amäni cäŋ kɛl.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.45",
            "verseOrgIds": [
              "1KI.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär Bɛ-na-yaa gat Yɛ-ɣo-ya-da la̱r lär. Kä cuɛ jɛ wä näk.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu kuäär cu pua̱t tetdä Thɔ-lo-mon.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    }
  ],
