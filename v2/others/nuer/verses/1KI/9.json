              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ni Thɔ-lo-mon babuuri täth kä Ɛ-dhon-ga-bɛr, min thieek kɛ E-loth thok Bar in tith, muun Ɛ-dɔm. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
