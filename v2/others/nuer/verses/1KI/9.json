          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɣi-ram ji̱ kɔaarɛ tin ŋa̱ckɛ rɛy yiëër ja̱k kɛɛl kɛ babuur, kɛɛl kɛ ji̱ kɔaar Thɔ-lo-mon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
              "1KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
