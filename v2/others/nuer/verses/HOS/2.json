            "number": "1",
            "style": "v",
            "sid": "HOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Läri jɛ gaat muɔɔr, “Nɛɛkä,” kɛnɛ nyiemuɔɔr, “Nyanhök.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thil ŋäthä I-thɛ-rɛl ce̱tkɛ Go-mɛr",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhök Kuɔth kɛ nɛɛkɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.15",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial wee i̱, “Ɛn cäŋ ɛmɔ, bi ɣä cɔl i̱, ‘Cɔwdä.’ Kä /ci ɣä bi nyɔk kɛ ciöt i̱, ‘Baal.’ ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bä ciöt ni Baal woc thokdɛ, a /cɛ jɛ bi nyɔk kɛ lär. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.17",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ bä kamdu moc guk yɛnɛ ley dɔaar kɛ diit, amäni muɔɔl piɛny bä. Kä bä mut cu woc wi̱i̱ muɔ̱ɔ̱n. Kä bia cu niɛn kɛ mal. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi cua̱ ciekdä mi /cä nyuak kɛ raan amäni cäŋ kɛl. Bä ji̱ mëk rɔ kɛ cuɔ̱ɔ̱ŋ kɛnɛ päl ikä kɛ nhök mi thil pëk, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.19",
            "verseOrgIds": [
              "HOS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "amäni ŋa̱th kä bi Kuoth Nhial cu ŋa̱c.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.20",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    }
  ],
