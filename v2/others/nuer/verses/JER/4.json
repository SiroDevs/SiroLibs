            }
          ]
        },
        {
          "text": "Kä nɛmɛ ɛ min ci Kuoth Nhial jɛ la̱r ji̱ Juda kɛnɛ ji̱ Jɛ-ru-tha-lɛm, wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.3",
            "verseOrgIds": [
              "JER.4.3"
            ]
          }
        }
