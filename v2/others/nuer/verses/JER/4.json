              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lätni ruac ɛmɛ ji̱ Juda, kä läri jɛ ji̱ Jɛ-ru-tha-lɛm i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.5",
            "verseOrgIds": [
              "JER.4.5"
            ]
