        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gök kacä ni Ɣä-nɛ̈n-yaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ jɛn ruɔ̱n ɛ kɛl ɛmɔ ruɔ̱n ëë took Dhid-ki-yaa kuäär Juda jɛ ni ruec, kɛ dhieec päthni kä ŋuaan runi, cu gök ni Ɣä-nɛ̈n-yaa gat Ɛ̈-dhur raan Gib-yon ruac kɛ ɣä rɛy luaak Kuɔth Nhial, a te bööth palä kɛ nɛy diaal thi̱n, cuɛ wee i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nɛmɛ ɛ min ci Kuoth Nhial in la Ruey Ɣɔaa ni Kuoth I-thɛ-rɛl ɛ lar i̱, “Ɣän bä gäk kua̱r Bɛ̈-bi-lɔn to̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rɛy runi da̱ŋ rɛw, ɣän bä kuak luaak Kuɔth Nhial diaal tëë ca naŋ kä Bɛ̈-bi-lɔn ɛ Nɛ-bu-kad-nɛ-dhar kuäär Bɛ̈-bi-lɔn luɔ̱c ɛn guäth ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä Yɛ-kɔn-ya gat Yɛ-ɣo-ya-kim kuäär Juda, kɛnɛ ji̱ Juda diaal tëë ca pɛ̈c kä Bɛ̈-bi-lɔn luɔ̱c ɛn guäth ɛmɛ bä, kɛ ɣöö bä gäk kua̱r Bɛ̈-bi-lɔn to̱l.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gök ni Yir-mɛ-yaa ruac kɛ gök ni Ɣä-nɛ̈n-yaa nhiam bööthni palä kɛnɛ nɛy diaal tëë te cuŋä rɛy luaak Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu gök ni Yir-mɛ-yaa wee i̱, “Inɔnɔ! A Kuoth Nhial lät jɛ inɔ, ɛ Kuoth Nhial jak ruac go̱o̱kä min ci lat kä thuɔ̱k, ɛ kuak luaak Kuɔth Nhial kɛnɛ nɛy diaal tëë ca naŋ kä Bɛ̈-bi-lɔn ala pɛ̈ɛ̈c luucɛ jɔk ɛn guäth ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä liŋ ruac ɛ latdä mi täämɛ, liŋɛ kä a liɛŋkɛ ɛ nɛy diaal ti̱ti̱. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.7",
            "verseOrgIds": [
              "JER.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä go̱o̱k tëë wal a /ken gua̱a̱thdu kɛnɛ gua̱a̱thdä ni cop, ca ruac go̱o̱kä lat kɛ kui̱ köör, kɛnɛ buɔth, kɛ juey mi bi ben kä döör ti ŋuan kɛnɛ kua̱r ti buɔ̱m buɔ̱ɔ̱m. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.8",
            "verseOrgIds": [
              "JER.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö gök mi wä ruac go̱o̱kä wä lat kɛ kui̱ malä, mi wä ruac ɛmɔ a thuɔ̱k, ba jɛ ŋa̱c ɛn gök ɛmɔ ɛn ɣöö jäkɛ Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gök ni Ɣä-nɛ̈n-yaa gäk yieethä woc ŋuääk go̱kä ni Yir-mɛ-yaa, kä cuɛ kɛ töl. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.10",
            "verseOrgIds": [
              "JER.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɣä-nɛ̈n-yaa ruac nhiam nɛɛni diaal wëë i̱, “Nɛmɛ ɛ min ci Kuoth Nhial jɛ lar i̱, ‘Kɛ jɛn duɔ̱ɔ̱p ɛ mɔ ɣän bä gäk Nɛ-bu-kad-nɛ-dhar kuäär Bɛ̈-bi-lɔn to̱l ŋuääk nɛɛni diaal rɛy runi da̱ŋ rɛw.’ ” Duundɛ ɣöö cu gök ni Yir-mɛ-yaa wä dupdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr gua̱th mi tɔt min ci gök ni Ɣä-nɛ̈n-yaa gäk to̱l ŋuääk go̱kä ni Yir-mɛ-yaa, cu ruac Kuɔth Nhial ben kä Yir-mɛ-yaa wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wër läri Ɣä-nɛ̈n-yaa ɣöö ci Kuoth Nhial wee i̱, ‘Ci to̱l ni gäk jiaath, kä ci moc ni gua̱a̱thdɛ kɛ gäk yieethä. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Kuoth Nhial in la Ruey Ɣɔaa ni Kuoth I-thɛ-rɛl ruac ɛn ɣöö ɣän bä gäk yieethä la̱th ŋuääk dööri ti̱ti̱ diaal kɛ ɣöö ba Nɛ-bu-kad-nɛ-dhar kuäär Bɛ̈-bi-lɔn lätikä, amäni ley dɔaar ba jɛ lätikä.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gök ni Yir-mɛ-yaa ruac kɛ gök ni Ɣä-nɛ̈n-yaa wëë i̱, “Liŋɛ Ɣä-nɛ̈n-yaa, ji̱n /ken Kuoth Nhial ji̱ ja̱k, kä ci nɛy ti̱ti̱ jak kä ŋa̱th kɛ ni kac. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
              "JER.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ ci Kuoth Nhial wee i̱, ‘Nɛnɛ, ɣän bä ji̱ woc wi̱i̱ muɔ̱ɔ̱n. Ji̱n bi li̱w ɛn waalɛ, kɛ ɣöö ci ruac mi jiääk lat kɛ kui̱ Kuɔth Nhial.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ bärɔw päthni kɛ jɛn ruɔ̱n ɛmɔ, cu gök ni Ɣä-nɛ̈n-yaa li̱w.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.17",
            "verseOrgIds": [
              "JER.28.17"
            ]
          }
        }
      ]
