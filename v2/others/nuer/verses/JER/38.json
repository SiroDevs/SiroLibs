            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wä ruëëc jɛ liŋ i̱ cä ruac kɛ ji̱ kä bikɛ ben, thiëckɛ ji̱ i̱, ‘Lärnikɔ min ci la̱r kuäär kɛnɛ min ci kuäärɛ la̱r ji̱, cu jɛ tey kä kɔ kɛ ɣöö cakɔ ji̱ bi lɛ näk.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.25",
            "verseOrgIds": [
              "JER.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikɛ jiök i̱, ‘Cä wä lip ni kuäär kɛ ɣöö /cɛ ɣä bi lɛ luɔc dhɔr Jo-na-than min dëë wä li̱w thi̱n.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔrɛ cu ruëëc diaal ben kä Yir-mɛ-yaa kä cukɛ jɛ thiec. Kä cuɛ kɛ loc ce̱tnikɛ min ca la̱r jɛ ɛ kuäär. Kä cu kɛ ruac cu päl kɛ jɛ, kɛ ɣöö /ken kɛ min ca muɔŋ liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yir-mɛ-yaa ŋot tëë ni rɛy rɛ̈ɛ̈k ga̱a̱ŋni amäni cäŋ ëë ka̱pkɛ Jɛ-ru-tha-lɛm.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        }
