            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yir-mɛ-yaa warɛgak dɔ̱diɛn ka̱n kä cuɛ jɛ ka̱m Ba-ruk, gat Ne-ri-yaa min la gɔ̱ɔ̱r. Kä cuɛ rieet diaal tëë la̱t kɛ jɛ ɛ Yir-mɛ-yaa gɔ̱a̱r rɛy warɛgakä, kɛn tëë diaal tëë ca kɔŋ gɔ̱a̱r rɛy warɛgakä mëë waŋkɛ ɛ kuäär ni Yɛ-ɣo-ya-kim. Kä cua rieet ti ce̱tnikɛ kɛ nyɔk kɛ mat thi̱n bä.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
