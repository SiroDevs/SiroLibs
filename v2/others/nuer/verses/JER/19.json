    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuuth dhar mi ci tiath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ min ci Kuoth Nhial jɛ lar i̱, “Wër kɔk dhaar kä tääth dha̱a̱ri, kä naŋ tha̱a̱ŋ bööthni nath kɛnɛ tha̱a̱ŋ bööthni palä tin di̱t, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä wiaa rɛy lo̱o̱lä gatdä I-nɔm thiekä Thuɔk Tha̱lier, ɛn wi̱ni, lat ruac in cä la̱r ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Larɛ i̱, ‘Liɛŋɛ ruac Kuɔth Nhial, lö kua̱r Juda kɛ yɛn ji̱ Jɛ-ru-tha-lɛm. Ci Kuoth Nhial in la Ruey Ɣɔaa ni Kuoth I-thɛ-rɛl nɛmɛ lar ɛn ɣöö, ɣän nööŋä rik ɛ ti ɛn wanɛ mi, kä bi ram mi wä jɛ liŋ ji̱thkɛ wuɔ̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ci naath ɣä pa̱l ruëëc, kä cikɛ gua̱a̱th ɛmɛ ya̱r kɛ wäŋdiɛn wal tin kuɔ̱r kuɔ̱ɔ̱r kuth kɔ̱kiɛn ti kui̱c kɛn kɛ kä kui̱c gua̱ni kɛ kɛ kua̱r Juda, kä cikɛ gua̱a̱th ɛ mi thiäŋ kɛ rim nɛɛni ti kuec kɛ ŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cikɛ kuoth Baal ta̱th gua̱a̱th mi wa̱ŋ kɛ jɛ gaatkiɛn thi̱n ala muc ti waŋkɛ, mi /ka̱n la̱r kɛ kä /ka̱n jɛ met car. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ ci ni̱n thia̱k, tin /ca gua̱a̱th ɛmɔ bi cɔl thi̱n i̱ To-pɛth, kiɛ lo̱o̱l gatdä I-nɔm, duundɛ ɣöö ba jɛ cɔli lo̱o̱l Na̱k Nath. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.6",
            "verseOrgIds": [
              "JER.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɛ bä cär ji̱ Juda kɛnɛ ji̱ Jɛ-ru-tha-lɛm däk. Kä bä kɛ jak kä na̱kɛ ɛ ji̱ tɛ̈riɛn, kɛnɛ nɛy tin görkɛ näkdiɛn. Kä bä ri̱ŋkiɛn jak kä mi̱eth din kɛnɛ ley dɔaar. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.7",
            "verseOrgIds": [
              "JER.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä wec ɛmɛ jak kä mi jiäk, mi wä raan wä rët kɛ jɛ bɛ ga̱a̱c kä bɛ wi̱cdɛ yi̱c kɛ da̱k in ci da̱k kɛ jɛ kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.8",
            "verseOrgIds": [
              "JER.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä kɛ jak kä cam kɛ ri̱ŋ gankiɛn. Kä bi ram ɔ ri̱ŋ gua̱n thieekädɛ cam, kɛ riɛk in ca go̱l nikɛ ɛ ji̱ tɛ̈riɛn, kɛnɛ nɛy tin görkɛ näkdiɛn.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä bi dhaar ku tiath a guɛckɛ jɛ ɛ nɛy tin wä kɛɛl kɛ ji̱, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bi kɛ jiök i̱, ‘Nɛmɛ ɛ min laar Kuoth Nhial in la Ruey Ɣɔaa jɛ ɛn ɣöö, ɣän bä kɛn nɛy ti̱ti̱ kɛ wec ɛmɛ däk ce̱tnikɛ ram mi tiath dhaar muɔ̱ɔ̱n, mi /ca dee nyɔk kɛ do̱o̱pni. Bi kɛ naath kony kä To-pɛth amäni mi cɛ thil gua̱a̱th mi dëë raan lɛ kuɔny thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn min bä lät kä gua̱a̱th ɛmɛ, kɛnɛ nɛy tin cieŋ ɛn wanɛ, kä bä wec ɛmɛ jak kä ce̱tnikɛ To-pɛth, ruac ni ɣän Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi dho̱r Jɛ-ru-tha-lɛm kɛnɛ dho̱r kua̱ri Juda nikɛ dho̱r diaal tin wa̱ŋkɛ nyin nhial diaal wal tin kuɔ̱r kuɔ̱ɔ̱r thi̱n, kä muɔckɛ kɔaŋ piny thi̱n ala muc kuthni ti kɔ̱kiɛn, bi kɛ jiääk ce̱tnikɛ To-pɛth ɛmɛ.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Yir-mɛ-yaa luny jɔk kä To-pɛth guäth ëë ci Kuoth Nhial jɛ jäk kä thi̱n kɛ ɣöö bɛ ruac go̱o̱kä wä lat, kä cuɛ ben cuɔ̱ŋ rɛy kal luaak Kuɔth Nhial, kä cuɛ nɛy diaal jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nɛmɛ ɛ min laar Kuoth Nhial in la Ruey Ɣɔaa ni Kuoth I-thɛ-rɛl ɛ, ɛn ɣöö ɣän nöŋä wec ɛmɛ kɛnɛ ciëëŋkɛ diaal riɛk ëë cä lar kɛ kui̱dɛ, kɛ ɣöö ci buɔ̱m ni wuɔ̱thkiɛn, lo̱k kɛn ɣöö ba ruaacnikä liŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        }
      ]
    }
