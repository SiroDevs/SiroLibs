          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɛmɛ ɛ riet Kuɔth Nhial ëë bä kä gök ni Yir-mɛ-yaa kɛ kui̱ dööri diaal.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
              "JER.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
              "JER.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ I-jëp. Mɛmɛ ɛ ruac kɛ kui̱ rɛ̈m kua̱r I-jëp ni Pɛro Nɛko min te kiir Yu-pɛ-ree-tidh kä Kar-kɛ-mic mëë cu kuäär Bɛ̈-bi-lɔn ni Nɛ-bu-kad-nɛ-dhar ɛ joc kɛ ŋuaan runi Yɛ-ɣo-ya-kim gat Yo-ci-yaa kuäär Juda wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Käni ji̱ Bɛ̈-bi-lɔn kɛ I-jëp",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɛmɛ ɛ riet Kuɔth Nhial ëë bä kä gök ni Yir-mɛ-yaa kɛ kui̱ benä Nɛ-bu-kad-nɛ-dhar kuäär Bɛ̈-bi-lɔn kɛ ɣöö bɛ mun I-jëp ben mak wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.24",
            "verseOrgIds": [
              "JER.46.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 46:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial in la Ruey Ɣɔaa ni Kuoth I-thɛ-rɛl ruac i̱, “Nɛnɛ ɣän bä Am-on The-bɛth kɛnɛ Pɛro kɛ I-jëp kɛnɛ kuthkɛ, kɛ kua̱rkɛ amäni Pɛro kɛnɛ nɛy tin ŋa̱thkɛ jɛ tɔ̱ɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä kɛ la̱th tetni nɛɛni tin görkɛ tëkdiɛn. Bä kɛ la̱th tetni Nɛ-bu-kad-nɛ-dhar kuäär Bɛ̈-bi-lɔn kɛnɛ ruëëckɛ. Kɛ jɔak ba I-jëp nyɔk kɛ ciëŋ ce̱tnikɛ ta̱a̱dɛ mëë wal. Ruac ni ɣän Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ka̱n Kuɔth kɛ ji̱ I-thɛ-rɛl",
          "type": "text"
        }
      ]
    }
  ],
