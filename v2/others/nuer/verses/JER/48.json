    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luk kɛ kui̱ Mo-ab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial in la Ruey Ɣɔaa ni Kuoth I-thɛ-rɛl mɛmɛ lar wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.9",
            "verseOrgIds": [
              "JER.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Riɛk akɛ ram mi /ci ruac Kuoth Nhial bi la̱t kɛ lɔcdɛ kɛɛliw. Kä riɛk akɛ ram mi bi näk nath päl.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.10",
            "verseOrgIds": [
              "JER.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.11",
            "verseOrgIds": [
              "JER.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ kui̱c ɛmɔ, nɛ̈nɛ jɛ gua̱a̱th a bëëni min bä jäk kä naath ti ba jɛ yäk kä ba jɛ tiath ce̱tnikɛ dhaar pi̱i̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.12",
            "verseOrgIds": [
              "JER.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Mo-ab cu pöc kɛ Kɛ-moc, ce̱tkɛ mëë cu ji̱ I-thɛ-rɛl pöc kɛ Beth-ɛl mëë ŋääth kɛn ɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.13",
            "verseOrgIds": [
              "JER.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.20",
            "verseOrgIds": [
              "JER.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ci luk ben wi̱i̱ni tin car caar, cɛ ben kä O-lon, kɛnɛ Yaadhaa kɛ Me-paath, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.21",
            "verseOrgIds": [
              "JER.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Di-bon kɛnɛ Nɛbo, kɛ Beth-dib-la-ta-yim, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.22",
            "verseOrgIds": [
              "JER.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ Kir-ya-tha-yim amäni Beth-ga-mul kɛnɛ Beth-mɛ-on, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.23",
            "verseOrgIds": [
              "JER.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "a wä ni kä Kɛ-ri-yoth kɛnɛ Bɔ-dhɛ-ra, amäni wi̱i̱ Mo-ab diaal tin na̱n kɛnɛ tin thia̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.24",
            "verseOrgIds": [
              "JER.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua tuɔ̱ŋ Mo-ab cu töl, kä cua tetkɛ töl bä, ruac ni ɣän Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.25",
            "verseOrgIds": [
              "JER.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jakɛ jɛ kä yɔ̱ŋ, kɛ ɣöö cɛ rɔ liak kɛ Kuoth Nhial. Kɛ nɔ bi Mo-ab rɔ daŋ ni rɛy ŋo̱kädɛ, kä bi naath ɛ cu dɔl. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.26",
            "verseOrgIds": [
              "JER.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ciɛ ji̱n ɛ nëë la I-thɛ-rɛl a yaak? Ɛ ca ku jek rɛy kuëëli, mɔ la ki̱i̱thi wi̱cdu mi ruaci kɛ kui̱dɛ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.27",
            "verseOrgIds": [
              "JER.48.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.33",
            "verseOrgIds": [
              "JER.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä bi Ɛc-bon kɛnɛ Ɛl-a-le wiee kɛ jɔw mi di̱i̱t, mi bi räth ni kä Yaadh, ba jɔwdiɛn wä liŋ mäni Dhor kɛnɛ Ɣo-ro-na-yim kɛ Ɛg-lat-cɛ-li-ci-yaa. Ɛ cäŋ ɛ ni pi̱w Nim-rim ca kɛ päl ni baaŋ bä. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.34",
            "verseOrgIds": [
              "JER.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän bä nɛy tin thöp kɛ muc wuɔ̱thni yi̱kni kä wëŋkɛ kuthkiɛn wal tin kuɔ̱r kuɔ̱ɔ̱r jakä thuk kɛ lia̱a̱. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.35",
            "verseOrgIds": [
              "JER.48.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 48:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ ɣän dɛt lɔcdä kɛ Mo-ab ce̱tnikɛ jɔw thuɔm, kä dɛt lɔcdä kɛ ji̱ Kir-a̱-rɛth ce̱tnikɛ jɔw thuɔm, ɛ jɛn ci ria̱ŋ ëë ci kɛn ɛ jek cu jiɛɛn kä kɛ mɔ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.36",
            "verseOrgIds": [
              "JER.48.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 48:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.36",
            "verseOrgIds": [
              "JER.48.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 48:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ kui̱c ɛmɔ, cua mi̱em wuɔ̱thni diaal kɛnɛ mi̱em ti̱kni diaal mut. Ci naath tetkiɛn tëm kä ca rɔ̱ yian kɛ bieyni cuali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.37",
            "verseOrgIds": [
              "JER.48.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 48:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rɛy ciëëŋni diaal kɛnɛ gua̱th duɔ̱ɔ̱li Mo-ab diaal te ni wiee thi̱n kä rɔa. Kɛ ɣöö ɣän cä Mo-ab tiath ce̱tnikɛ dhaar pi̱i̱ni mi thil ram mi go̱o̱r jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.38",
            "verseOrgIds": [
              "JER.48.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 48:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guic ɛ ca jɛ däk i̱di? Guicɛ pär ɛ i̱di! Guic Mo-ab cɛ ku riet ni jɔkdɛ kɛ pöc i̱di! Kä cɛ kua̱ gua̱a̱th töök kɛ kui̱ jiäkni diaal tëë ci tuɔɔk kä jɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.39",
            "verseOrgIds": [
              "JER.48.39"
            ]
          }
        }
      ]
    }
  ],
