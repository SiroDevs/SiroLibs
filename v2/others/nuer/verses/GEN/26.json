    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciaŋ Ay-dhɛk kä Gɛ-raar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɔ cu ɣɔw rɔ nyɔk kɛ mi tekɛ buɔth mi göl kä buɔth ëë ci kɔŋ tuɔɔk ni̱ni tëë te A-bɛ-ram te̱e̱kä, kä kɛ kui̱ ɛmɔ cu Ay-dhɛk cu wä cieŋ kɛɛl kɛnɛ kuäär ji̱ Pi-li-thɛt in di̱i̱t ni Ä-bi-mɛ-lɛk rɛy rɛ̈ɛ̈k in cɔal i̱ Gɛ-raar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.1",
            "verseOrgIds": [
              "GEN.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial ben kä Ay-dhɛk kɛ la̱k kä cuɛ jɛ jiök i̱, “/Cu bi wä ro̱o̱l I-jëp. Teni muun in bä nyuɔ̱th ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.2",
            "verseOrgIds": [
              "GEN.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi li̱ep thi̱n kam ɔ lɛɛr ɔ, kä bä te kɛɛl kɛ ji̱, kä bi̱i̱ poth, kɛ ɣöö ɣän bä wi̱i̱ ti̱ti̱ diaal ka̱m ji̱ yɛnɛ kuayku, kä bä guk ëë cä la̱t guur ni A-bɛ-ram cu jak kä thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛn ɛ, ɣän bä kuayku re̱p ce̱tnikɛ ciɛr nhial, kä bä wi̱i̱ ti̱ti̱ diaal ka̱m kɛ ala nyinkiɛn. Kä bi döör diaal wi̱i̱ muɔ̱ɔ̱n puɔ̱th jek kɛ kuayku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.4",
            "verseOrgIds": [
              "GEN.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tɔ̱ diaal tɔ̱tɔ̱ ɛ kui̱ kä ɣöö ci A-bɛ-ram ruaacnikä liŋ kä cuɛ gukdä kɛnɛ luëëkä kɛ ŋuɔ̱tkä kɛnɛ ŋi̱i̱cnikä tit.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ, cu Ay-dhɛk cu cieŋ kä Gɛ-raar.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.6",
            "verseOrgIds": [
              "GEN.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.6",
            "verseOrgIds": [
              "GEN.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ni̱ni tëë tekɛ jɛ kä Gɛ-raar cu wutni wec jɛ thi̱ec kɛ kui̱ ciëkdɛ, cuɛ kɛ jiök i̱, “Jɛn ɛ nyimaar.” Cuɛ kɛ loc inɔ kɛ dualɛ kɛ ɣöö dɔ̱ŋ de̱e̱kɛ jɛ näk kɛ ɣöö bikɛ Rɛ-bɛ-ka mac, kɛ ɣöö te Rɛ-bɛ-ka kɛ maan ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Ay-dhɛk cu jääny ɛn dhɔɔr ɛmɔ, kɛ cäŋ kɛl cu kuäär ji̱ Pi-li-thɛt in di̱i̱t ni Ä-bi-mɛ-lɛk guel kɛ wernyin kä cuɛ Ay-dhɛk nɛn lätdɛ ciekdɛ ni Rɛ-bɛ-ka kä nyin nho̱kä. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.8",
            "verseOrgIds": [
              "GEN.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cuɛ Ay-dhɛk cu jäk kä raan, kä mëë ca jɛ cɔl cuɛ jɛ ben thi̱ec i̱, “Jɛn ɛpuc ɛ ciekdu, kuɛɛ la ŋu mëë laari jɛ i̱ ɛ nyimuɔɔr?” Cu Ay-dhɛk ɛ loc i̱, “Ɣän cä ŋa̱c ni ɣöö dëë ɣä näk ɛ raan kɛ ɣöö bɛ jɛ mac.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ä-bi-mɛ-lɛk ɛ ku jiök i̱, “Ɛŋu mi ci lät kä kɔ mi. Mi ci ram kɛl kä nɛɛkä ciekdu kulɛ ka̱n, inɔ /ci kɔ dëë cu nöŋ duer?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.10",
            "verseOrgIds": [
              "GEN.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu Ä-bi-mɛ-lɛk nɛɛkɛ diaal cu gok wëë i̱, “Ni ram mi wä wut ɛmɛ guëër kiɛ ciekdɛ ba näk.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu Ay-dhɛk cu puur ɛn dhɔɔr ɛmɔ kä cu kuay nyinäkɛ tëë cɛ pith rɔ̱ re̱p ni kä kuɔ̱r kä kuay diaal tëë cɛ pith kɛ jɛn ruɔ̱n ɛmɔ. Cu Kuoth Nhial ɛ cu poth inɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.12",
            "verseOrgIds": [
              "GEN.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ria̱ŋ, kä cu ria̱ŋdɛ wee kɛ mi re̱e̱pɛ rɔ amäni mëë cua wut mi riäŋ riäŋ ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.13",
            "verseOrgIds": [
              "GEN.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ tekɛ bun de̱e̱t kɛnɛ ɣɔ̱k ti nyin ŋuan, kɛ la̱a̱t ti ŋuan. Kɛ kui̱ ɛmɔ, cu ji̱ Pi-li-thɛt ɛ til. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.14",
            "verseOrgIds": [
              "GEN.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ Pi-li-thɛt jieer diaal mol, tɔ̱tɔ̱ kɛ kɛn jieer tëë tɛt la̱a̱t gua̱n ni A-bɛ-ram kɛ ni̱ni tëë te A-bɛ-ram teekä. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ca jɛ ku til, cu Ä-bi-mɛ-lɛk Ay-dhɛk ku jiök i̱, “Jiɛcni rɛyda, kɛ ɣöö ci di̱t ni buɔ̱mdu kä kɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.16",
            "verseOrgIds": [
              "GEN.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min ci Ay-dhɛk ruac ɛmɔ liŋ, cuɛ jiɛɛn kä cuɛ kɛmɛnikɛ wä pua̱t paan täpä Gɛ-raar. Cuɛ cu nyuur ɛn wi̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.17",
            "verseOrgIds": [
              "GEN.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guäth ëë tëë thi̱n, kɛn jieer gua̱n diaal tëë kɔŋ, ɛ kɛn tëë ci ji̱ Pi-li-thɛt kɛ ben di̱r kɛ kɔr li̱eth gua̱n, kɛn jieer tɔ̱tɔ̱ cuɛ kɛ nyɔk kɛ tët. Kä ɛ niɛ kɛn ciööt tëë ci gua̱n kɛ cak, kɛn tëë cuɛ cɔɔlnikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.18",
            "verseOrgIds": [
              "GEN.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛ̈nɛ jɛ, guäth ëë te la̱a̱t Ay-dhɛk te̱t jiɛw däär paan kä Gɛ-raar cukɛ pi̱ ti lo̱ny jek thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.19",
            "verseOrgIds": [
              "GEN.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wanɛ mɔ cu yiëën ɣɔ̱ɔ̱k kä Gɛ-raar jiw tɛr kɛ yiëën ɣɔ̱ɔ̱k Ay-dhɛk, lar kɛn ɛ i̱ kɛn pi̱ tɔ̱tɔ̱ kɛ nyinkiɛn. Kɛ kui̱ ɛmɔ cu Ay-dhɛk jiw ɛmɔ cɔl i̱ E-thɛk (min lot ni ɣöö ŋaknɔm) kɛ ɣöö cikɛ gak kɛ kui̱dɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu la̱a̱tkɛ jiw dɔ̱diɛn nyɔk kɛ tët, cu rɛydɛ lɛni tekɛ gak bä, cuɛ jɛ cu cɔl i̱ Thi-tɛ-na (min lot ni ɣöö tiɛɛl). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ rɔ lɛ kap guäth dɔ̱diɛn kä cuɛ jiw mi dɔ̱ŋ wä nyɔk kɛ tët thi̱n, ɛn kɛ̈ɛ̈l ɛ cuɛ cu thil mi cua lɛ gak thi̱n. Ɛ jɛn, cuɛ ciötdɛ cu cɔl i̱ Rɛ-böth (min lot ni ɣöö gua̱a̱th mi ro̱ŋ), ɛ jɛn i̱, “Ɛn kɛ̈ɛ̈lɛ, ci Kuoth Nhial kɔn moc kɛ gua̱a̱th mi banɛ rɔ̱ di̱eth thi̱n ɛn ro̱o̱lɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔrɛ cuɛ jiɛn ɛn wa̱nɔ kä cuɛ wä Ber-cɛ-ba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.23",
            "verseOrgIds": [
              "GEN.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kɛ jɛn wäär ɛmɔ, cu Kuoth Nhial rɔ nyuɔ̱th jɛ kɛ la̱k wëë i̱, “Ɛ ɣän Kuoth guur ni A-bɛ-ram. /Cu dual, kɛ ɣöö ɣän ta̱a̱ kɛɛl kɛ ji̱. Ɣän bä ji̱ poth kä bä ji̱ moc kɛ gaat ti ŋuan kɛ kui̱ jäŋädä ni A-bɛ-ram.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.24",
            "verseOrgIds": [
              "GEN.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cɛ nɔmɔ liŋ, cuɛ rɔ cu ta̱th yi̱k ɛn wi̱ni kä cuɛ Kuoth Nhial cu pal thi̱n. Cuɛ kɛmɛnikɛ pua̱t kä cu la̱a̱tkɛ jiw tɛt ɛn thɔ̱ŋi i̱.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Guk kamä Ä-bi-mɛ-lɛk Kɛnɛ Ay-dhɛk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɔ cu Ä-bi-mɛ-lɛk cu ben kä Gɛ-raar kɛɛl kɛnɛ määthdɛ ni Ä-ɣu-dhath kɛ kuäär lathkëërikɛ ni Pi-kɔl kɛ ɣöö bikɛ Ay-dhɛk ben gui̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cikɛ cop, cu Ay-dhɛk kɛ thi̱ec i̱, “Ɛŋu mɔ cia lɛ ben kä ɣä mɔ, kä yɛn cia ɣä kɔŋ nyir kä cia ɣä tuk rɛydun?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min cikɛ nɔmɔ liŋ, cukɛ jɛ loc i̱, “Cakɔ jɛ nɛn ɛpuc ɛn ɣöö Kuoth Nhial tëë kɛɛl kɛ ji̱. Kä cakɔ jɛ cu car ɛn ɣöö dëë gɔaa ni mi ta̱nɛ kɛ mat ruac kamädan kä bakɔ guk cu la̱th piny kɛɛl kɛ ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi rɔ yac ɛn ɣöö /ci kɔ bi luɔ̱c tɛr, ce̱tnikɛ mëë thilɛ mi jiääk mi cakɔ lät kä ji̱, ɛ ni ɣöö cakɔ lät ni ji̱ kä gɔɔy kä cuakɔ ji̱ cu jak kä wä kɛ mal. Kä nɛn ɛ, ji̱n ɛn täämɛ ci Kuoth Nhial ji̱ poth.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min cikɛ ruacdiɛn kuɛr piny, cu Ay-dhɛk kɛ cu nöŋ mi̱eth, kä cukɛ mi̱th kä cukɛ maath. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.30",
            "verseOrgIds": [
              "GEN.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛ̈nɛ jɛ, mëë cikɛ ke̱e̱r ni bakä mëë ruɔ̱n, cukɛ rɔ̱ yac kamnikiɛn. Kɛ kɔrɛ cu Ay-dhɛk kɛ cu jak kä wä, cukɛ cu jiɛn kɛ mal. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
              "GEN.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ɛ cäŋ ɛmɔ pa̱ny, cu la̱a̱t Ay-dhɛk ben kä cukɛ jɛ ben la̱r thok kɛ kui̱ jiɛw mi ci kɛnɛ tɛt, cukɛ jɛ jiök i̱ cikɛ pi̱ jek thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ɛ wa̱nɔ cuɛ jiw ɛmɔ cɔl i̱ Ciba. Kɛ kui̱ ɛmɔ cɛ cu duth raar amäni walɛ ɛn ɣöö cɔalkɛ rɛk in te jiw ɛmɔ thi̱n i̱ Ber-cɛ-ba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Män E-thɔ tin jur",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guäth ëë ci E-thɔ tekɛ run ti jiɛn ŋuaan, cuɛ kuɛɛn kɛ män da̱ŋ rɛw, kɛl ɛ Yu-dith min la nya raam kɛl kä nɛɛ Ɣɛ̈th mi cɔal i̱ Beeri, kä min dɔ̱diɛn ɛ Ba-thɛ-math nya raam kɛl kä nɛɛ Ɣɛ̈th bä, mi cɔal i̱ Ee-lon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ Ay-dhɛk kɛnɛ Rɛ-bɛ-ka tëkdiɛn jak kä jiäk ɛlɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
            ]
          }
        }
      ]
    }
