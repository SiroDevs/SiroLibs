    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jo-thɛp kɛnɛ gaatman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Je-kɔb ŋot kɛ ciaaŋ ro̱o̱l Kɛ-naan ëë la cieŋ gua̱n thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.1",
            "verseOrgIds": [
              "GEN.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɛmɛ ɛ cäät kɛ kui̱ Je-kɔb kɛnɛ ji̱ gɔaalɛ. Kä jɛn tëë kɛ gatdɛ kɛl mi ŋuɛ̈t mi runkɛ wäl bärɔw mi cɔal i̱ Jo-thɛp. Ɛn guäth ɛmɔ Jo-thɛp la yieenɛ det kɛɛl kɛ gaat gua̱n tin la gaat Bila kɛnɛ Dhil-pa. Kä jɛn la lätdɛ gua̱n ciɛŋ dämani tin jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä gua̱n nhɔkɛ Jo-thɛp kɛ nhök mi di̱i̱t rɛy gankɛ tin kɔ̱kiɛn kɛ ɣöö ɛ gat mi die̱e̱thɛ dɔŋädɛ. Cuɛ jɛ ku köc bi̱i̱ mi bäär mi tekɛ tet ti bär. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.3",
            "verseOrgIds": [
              "GEN.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci gaat gua̱n ɛ ku ŋa̱c ɛn ɣöö gua̱ndiɛn nhɔkɛ Jo-thɛp kɛ nhök mi göl rɛydiɛn cukɛ Jo-thɛp nyir kɛ nyi̱er mi di̱i̱t mi pe̱nkɛ ni ɣöö deekɛ muɔɔŋ kɛ jɛ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.4",
            "verseOrgIds": [
              "GEN.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.4",
            "verseOrgIds": [
              "GEN.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ kɛl cu Jo-thɛp la̱k läkikä kä cuɛ jɛ la̱t dämani ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.5",
            "verseOrgIds": [
              "GEN.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wee i̱, “Liɛŋɛ la̱k mi cä läkikä. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.6",
            "verseOrgIds": [
              "GEN.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cärɛ kɛ mi kɔn diaal ta̱nɛ rɛy kakä kä duɔlnɛ bɛl bua̱a̱ni, kä nɛ̈nɛ jɛ, cu buɔ̱ndä rɔ cuŋ ɛ pi̱c, kä cu bua̱a̱nkun rɔ̱ dol gekädɛ kä cukɛ jɛ goŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.7",
            "verseOrgIds": [
              "GEN.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cikɛ jɛ liŋ, cukɛ jɛ thi̱ec i̱, “Ɛ puc ɛ ji̱n i̱ bi kɔ ruac?” Ɛ jɛn cukɛ jɛ ku nyir ɛlɔ̱ŋ kɛ kui̱ kä ɣöö cɛ kɛ la̱t la̱k ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.8",
            "verseOrgIds": [
              "GEN.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cɛ la̱k dɔ̱diɛn lɛni läkikä, cuɛ jɛ ben la̱t dämani bä, wëë i̱, “Liɛŋɛ jɛ, ɣän cä la̱k mi dɔ̱diɛn lɛni läkikä. Kä nɛ̈nɛ jɛ, kuɛɛ lɛ ce̱tkɛ mi ci cäŋ kɛnɛ pay kɛ ciɛr da̱ŋ wäl kɛl rɔ̱ goŋ nhiamdä.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.9",
            "verseOrgIds": [
              "GEN.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cɛ jɛ lɛni la̱t gua̱n, cu gua̱n ɛ ke̱c ikä kä cuɛ wee i̱, “Ɛ ku la̱k mi ŋu ɛnɔ? Ɛ ku lot ni ɣöö ɣän kɔnɛ muɔɔr amäni gaat muɔɔri bakɔ ben nhiamdu ɛpuc a bakɔ ji̱ goŋ?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.10",
            "verseOrgIds": [
              "GEN.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu gaatmani jɛ ku til ɛlɔ̱ŋ, kä gua̱n cuɛ ruac ɛmɔ käp kɛ lɔcdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.11",
            "verseOrgIds": [
              "GEN.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kɔk Jo-thɛp kä I-jëp",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.11",
            "verseOrgIds": [
              "GEN.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ kɛl mëë ci dämani Jo-thɛp det naŋ laak kä Cɛ-kɛm, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.12",
            "verseOrgIds": [
              "GEN.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "I-thɛ-rɛl cuɛ Jo-thɛp jiök i̱, “A ji̱ ja̱kä kä Cɛ-kɛm guäth in ci gaat muɔɔri det wä yien thi̱n.” Cu Jo-thɛp jɛ loc i̱, “Gɔaaɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu gua̱n ɛ ku jiök i̱, “Wër gui̱l ta̱a̱ dämuɔɔri kɛnɛ det kä lunyni jɔk biɛ ben la̱r ɣä.” Ɛ jɛ nɔ cuɛ cu jiɛɛn ni cieŋdiɛn kä Ɣɛb-ron mëë cɛ cop kä Cɛ-kɛm, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "tëë kɛ wut kɛl mi cu jɛ nɛn ga̱a̱rɛ jɔk wec kui̱cɛ gua̱a̱th in dëë wä kɛ jɛ. Cu wut ɛmɔ jɛ cu thi̱ec i̱, “Ɛŋu go̱o̱ri mɔ?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.15",
            "verseOrgIds": [
              "GEN.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jɛ loc i̱, “Ɣän göörä ni dämaari.” Cuɛ jɛ cu thi̱ec i̱, “Ŋäci gua̱a̱thdiɛn in yiënkɛ det thi̱n?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.16",
            "verseOrgIds": [
              "GEN.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu wut ɛ loc i̱, “Cä ruacdiɛn liŋ, ɛ kɛn i̱, Wäkɛ Do-than. Cikɛ jiɛn.” Ɛ jɛn cu Jo-thɛp dämani guɔ̱ɔ̱r kä cuɛ kɛ wä jek kä Do-than. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci dämani jɛ nɛn a bëë ni nänä, kä ŋotdɛ a /ke̱nɛ ni cop thiäkä, cukɛ ca̱p cäp i̱ bikɛ jɛ näk, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.18",
            "verseOrgIds": [
              "GEN.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ɛ kɛn i̱, “Jɛn bëë mɔ ɛn puɔ̱ny la̱a̱k indaan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.19",
            "verseOrgIds": [
              "GEN.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia, kuanɛ jɛ ben näk kä banɛ ri̱i̱ŋdɛ cu yuɔr rɛy jiɛw kɛl kä jieer ti dɔŋ ti̱ti̱. Banɛ gua̱n cu wä jiök i̱, ‘Ca cam ɛ le̱y,’ kä bi min luɔtkɛ ɛ la̱a̱kɛ cu jɔɔc.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.20",
            "verseOrgIds": [
              "GEN.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci däman kɛl mi cɔal i̱ Rɛ-u-ben mɔmɔ liŋ, cuɛ luäkdɛ go̱r, kä cuɛ wee i̱, “/Cuanɛ jɛ näk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.21",
            "verseOrgIds": [
              "GEN.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuɔrnɛ ni jɛ rɛy jiɛw ɛ te däär paan ɛ a thil mi banɛ guëër puɔ̱ɔ̱nydɛ.” Rɛ-u-ben läthɛ ca̱p ɛmɔ kɛ ɣöö go̱o̱rɛ ni ɣöö bɛ Jo-thɛp kän tetni dämani a bɛ jɛ cu luɔ̱c gua̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.22",
            "verseOrgIds": [
              "GEN.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛ jɛn mëë ci Jo-thɛp cop kä kɛ, cukɛ jɛ käp kä cukɛ bi̱i̱dɛ in bär bär puɔt piny puɔ̱ɔ̱nydɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.23",
            "verseOrgIds": [
              "GEN.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cukɛ jɛ naŋ guäth jiɛw mi lue̱ŋ lue̱ŋ mi ci kööt, kä cukɛ jɛ yuɔr thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.24",
            "verseOrgIds": [
              "GEN.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.24",
            "verseOrgIds": [
              "GEN.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ, mëë cikɛ ku nyuur a mi̱thkɛ, cukɛ bua̱n nɛɛni ji̱ I-ca-mel nɛn bäkɛ ni ro̱o̱l Gil-yad, jälkɛ kɛ thɔ̱a̱rɔa̱a̱likiɛn ti ca jio̱kiɛn thia̱ŋ kɛ luaac kɛnɛ ji̱th ŋuänydiɛn, wäkɛ ro̱o̱l I-jëp. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.25",
            "verseOrgIds": [
              "GEN.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Juda kɛnɛ dämani kɛ nɛn, cu Juda dämani ku jiök i̱, “Ɛŋu mi dënɛ näk ni dämandan kä banɛ lia̱a̱dɛ kur? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.26",
            "verseOrgIds": [
              "GEN.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia, kuanɛ jɛ ben kök ji̱ I-ca-mel ti̱ti̱ a thil mi jiääk mi banɛ lät kä jɛ, kɛ ɣöö jɛn ɛ dämandan ɛ ke̱e̱ waŋ.” Cu dämani rietdɛ nhɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.27",
            "verseOrgIds": [
              "GEN.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɔ mëë ci bua̱n ji̱ ko̱kä kä ji̱ rööl Mid-yan rët kɛ gëkdiɛn, cua Jo-thɛp ka̱m raar rɛy jiɛw kä cua jɛ kök ji̱ I-ca-mel kɛ yio̱w ti jɛn rɛw, kä cua jɛ naŋ ro̱o̱l I-jëp ɛ kɛn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.28",
            "verseOrgIds": [
              "GEN.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.28",
            "verseOrgIds": [
              "GEN.37.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mëë ci Rɛ-u-ben rɔ nyɔk kɛ ben wi̱i̱ jiɛw kä /ke̱nɛ Jo-thɛp jek, cuɛ bieynikɛ rɛ̈t kɛ jiath lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.29",
            "verseOrgIds": [
              "GEN.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cɛ luny kä dämani cuɛ kɛ jiök i̱, “Ɛn dho̱o̱l indaan mi thilɛ jɛ mi. Kä ɣän puɔ̱nydä bä ŋu la̱t täämɛ?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.30",
            "verseOrgIds": [
              "GEN.37.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ cukɛ dɛl näk kä cukɛ bi̱i̱ Jo-thɛp cu ka̱n, kä cukɛ jɛ cua̱th rɛy riɛm dɛ̈ɛ̈l, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.31",
            "verseOrgIds": [
              "GEN.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cukɛ jɛ nöŋ gua̱ndiɛn. Mëë cikɛ jɛ nöŋ jɛ, cukɛ jɛ wä jiök i̱, “Mer nɛmɛ guic mi ɛ jɛn bi̱i̱ gatdu in bäär.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.32",
            "verseOrgIds": [
              "GEN.37.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci gua̱ndiɛn ɛ nɛn cuɛ jɛ ŋic kä cuɛ wee i̱, “Mɛmɛ ɛ jɛn bi̱i̱ gatdä. Jɛn ci le̱y ɛ cam. Jo-thɛp cɛ li̱w ɛpuc.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ cu Je-kɔb bieynikɛ ku rɛ̈t, kä cuɛ rɔ moc kɛ bieyni cuɔɔli, kä cuɛ gatdɛ par kɛ ni̱n ti ŋuan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.34",
            "verseOrgIds": [
              "GEN.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ca jɛ ɣɔ̱n kɛ mi luëkɛ jɛ ɛ gaatkɛ kɛnɛ nyieekɛ diaal, cuɛ luek lo̱k. Ɛ jɛn i̱, “Bä ŋot kɛ mi paarä gatdä amäni cäŋ in wä mat kɛ kɔ ni jɔɔkni.” Ɛ jɛn cuɛ gatdɛ par ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku duundɛ la ɣöö ɛn Jo-thɛp cu ji̱ Mid-yan ɛ ben kök Pɔ-ti-par ro̱o̱l I-jëp, ram kɛl min mɔ kuäär lathkëëri kua̱r kɔaam in di̱i̱t ro̱o̱l I-jëp mi cɔalkɛ i̱ Pɛro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        }
      ]
    }
