        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ, cu Rɛ-bɛ-ka Ay-dhɛk ku jiök i̱, “Ɣän ci tëkdä bɛ̈c ɛlɔ̱ŋ kɛ kui̱ nyieet Ɣɛ̈th ti̱ti̱. Mi wä Je-kɔb lɛni kuɛɛn rɛydiɛn kɛn nyi̱er ti nɛ̈ɛ̈nä ɛn wanɛ ti, thilɛ mi bi rɔ lot rɛy te̱e̱kädä.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
      ]
