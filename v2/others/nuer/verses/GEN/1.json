        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth wee i̱, “A wi̱c muɔ̱ɔ̱n tekɛ le̱y diaal mɔ kɛ cätdɛ, ɣɔ̱k kɛ muɔɔl piɛny kɛ le̱y dɔaar mɔ kɛ cätdɛ.” Kä cuɛ cua̱ jɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.24",
            "verseOrgIds": [
              "GEN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth le̱y dɔaar diaal cak mɔ kɛ cätdɛ mi göl, kɛ ɣɔ̱k mɔ kɛ cätdɛ mi göl, kɛnɛ muɔɔl piɛny mɔ kɛ cätdɛ mi göl. Kä cu Kuoth ɛ nɛn gɔaaɛ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.25",
            "verseOrgIds": [
              "GEN.1.25"
            ]
          }
        }
      ]
    },
