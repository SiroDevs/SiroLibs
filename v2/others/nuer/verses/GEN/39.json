    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jo-thɛp kɛnɛ ciek Pɔ-ti-par",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɔ mëë ca Jo-thɛp cu naŋ ro̱o̱l I-jëp, cua jɛ kɔk te̱tni ji̱ I-ca-mel ɛ wut min cɔal i̱ Pɔ-ti-par. Ɛn wut ɛmɔ ɛ kuäär lathkëëri tin yiënkɛ ciëŋ kua̱r rööl I-jëp ni Pɛro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.1",
            "verseOrgIds": [
              "GEN.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä te Kuoth Nhial kɛɛl kɛ Jo-thɛp, kä luäkɛ jɛ rɛy lätnikɛ diaal. Jo-thɛp ciɛŋɛ ni ciëŋ wutdä rööl I-jëp min mɔ kuäärɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci wut ɛmɔ jɛ nɛn ɛn ɣöö Kuoth Nhial tëë kɛɛl kɛ Jo-thɛp kä luäkɛ jɛ rɛy lätnikɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu lɔcdɛ tɛɛth kɛ Jo-thɛp kä cuɛ jɛ jak kä ram min lät jɛ kä nyinkɛ, kä cuɛ jɛ jak kä ram in guic cieeŋdɛ kɛɛliw. Ɛ jɛ nɔ, jɛn cuɛ Jo-thɛp jak kä kuäär kuaknikɛ diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.4",
            "verseOrgIds": [
              "GEN.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn guäth ɔ cu Kuoth Nhial ciek wutdä rööl I-jëp poth kɛ kui̱ Jo-thɛp. Puɔ̱th Kuɔth Nhial cuɛ te rɛy kuakni diaal tin tɔ̱ nyin Pɔ-ti-par, tin diaal tin te cieŋ amäni tin te rɛy ka̱a̱kni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ cu Pɔ-ti-par ti diaal cu la̱th tetdä Jo-thɛp kä cuɛ thil mi diɛɛr kɛ jɛ, ɛni mi̱ethdɛ min caam ɛ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ Jo-thɛp ci Kuoth ɛ täth agɔaa kä tëë kɛ nhiam mi duŋ gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci ciek kua̱r Jo-thɛp nɛn ɛn ɣöö Jo-thɛp ɛ wut mi cɛ cak agɔaa, cuɛ jɛ bɛc kä cuɛ jɛ jiök i̱, “Bër tɔa̱a̱cni kɛ ɣä.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.7",
            "verseOrgIds": [
              "GEN.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä Jo-thɛp cuɛ jɛ lo̱k, kä cuɛ jɛ jiök i̱, “Guicɛ, kuäärä thilɛ mi diɛɛr kɛ jɛ kä tin diaal tin te rɛy ciëŋ ɛmɛ, cɛ ti diaal la̱th te̱tädä. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.8",
            "verseOrgIds": [
              "GEN.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ ram mi di̱tni jɛn kä ɣä ɛn cieŋ ɛmɛ, kä thilɛ mi cɛ pa̱l jɔ̱ɔ̱r ɛ ni ji̱n puɔ̱nydu kärɔa kɛ ɣöö ɛ ji̱n ciekdɛ. Kä kuɛ la ŋu mi dëë mi jiääk ɛmɛ la̱t ɔ, kä ɛ duer nhiam Kuɔth?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.9",
            "verseOrgIds": [
              "GEN.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cäŋɛ mëë la ruac ciek ɛmɔ kɛ jɛ ni ciaŋ, /ke̱nɛ jɛ met nhɔk ɛn ɣöö bɛ tɔ̱ɔ̱c kɛ jɛ kiɛ bɛ thia̱k kɛ jɛ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.10",
            "verseOrgIds": [
              "GEN.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.10",
            "verseOrgIds": [
              "GEN.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ cäŋ kɛl mëë cɛ ben kɛ ɣöö bɛ lätkɛ ben la̱t, kä thilɛ läät dɔ̱diɛn mi te thi̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.11",
            "verseOrgIds": [
              "GEN.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu ciek ɛ käp ni biey kä jio̱kɛ jɛ i̱, “Bër tɔa̱a̱cnɛ kɛɛl.” Kä jɛn Jo-thɛp cuɛ rɔ bar raar rɛy duëël a cuɛ bi̱i̱dɛ ba̱ny ciek. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.12",
            "verseOrgIds": [
              "GEN.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci ciekdɛ ɛ nɛn ɛn ɣöö cɛ rɔ bar cɛ bi̱i̱dɛ ba̱ny jɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.13",
            "verseOrgIds": [
              "GEN.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "cuɛ la̱a̱t ciëŋ cɔl kä cuɛ kɛ jiök i̱, “Nɛ̈nɛ raan Ɣi-bɛ-ru ëë nööŋkɛ cieŋ ɛ gua̱n cieeŋdä, täämɛ jɛn cɛ kɔn nöŋ buar, jɛn cɛ cunh due̱e̱l a cɛ ɣä ben mak kölikä, kä mëë cä ku lɛ wak kɛ jɔw mi di̱i̱t, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.14",
            "verseOrgIds": [
              "GEN.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "jɛn cuɛ bi̱i̱dɛ ba̱ny piny kä cuɛ rɔ bar rɛy duëël.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.15",
            "verseOrgIds": [
              "GEN.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ bi̱i̱ Jo-thɛp tɛ̱̈ɛ̱̈ amäni mëë ci kuäärɛ ben cieŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.16",
            "verseOrgIds": [
              "GEN.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cɛ ben cuɛ jɛ jiök i̱, “Jɛn kuany Ɣi-bɛ-rukädu mi ci nöŋ naath ɛ, jɛn cɛ ben duëël kä ɣä kɛ ɣöö bɛ ɣä kuëth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.17",
            "verseOrgIds": [
              "GEN.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cä kulɛ wak kɛ jɔw mi di̱i̱t, jɛn cuɛ bi̱i̱dɛ ba̱ny ɣä kä cuɛ rɔ bar rɛy duëël.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
              "GEN.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
              "GEN.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci kuäär ruac ciëkdɛ liŋ wëë i̱, “Mɛmɛ ɛ min ci ja̱ŋdu ɛ lät kä ɣä,” cuɛ lɔcdɛ waŋ ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.19",
            "verseOrgIds": [
              "GEN.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jɛ jak kä ba jɛ wä la̱th luaak yi̱eenä, guäth in la kuäär wec nɛɛkɛ a yiɛɛn thi̱n. Ɛ jɛn cuɛ cu te luaak yi̱eenä ɛn thɔ̱ŋi i̱. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.20",
            "verseOrgIds": [
              "GEN.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä te Kuoth Nhial kɛɛl kɛ Jo-thɛp, cuɛ jɛ poth kä cuɛ kuäär ji̱ yi̱eenä lɔcdɛ jak kä kɔ̱c kɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.21",
            "verseOrgIds": [
              "GEN.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu kuäär yi̱eenä yiëën diaal kɛ lätkiɛn la̱th tetdä Jo-thɛp. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.22",
            "verseOrgIds": [
              "GEN.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn /ke̱nɛ lɛ diɛɛr kɛ tin diaal tin ci Jo-thɛp kɛ la̱t kɛ ɣöö te Kuoth Nhial kɛɛl kɛ Jo-thɛp kä luäkɛ jɛ rɛy lätnikɛ diaal.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.23",
            "verseOrgIds": [
              "GEN.39.23"
            ]
          }
        }
      ]
    }
  ],
