          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guäth ëë ci Ar-pak-cad tekɛ run ti jiɛn diɔ̱k wi̱cdɛ dhieec cuɛ Cɛla di̱eth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr däpä Cɛla cu Ar-pak-cad te te̱e̱kä kɛ run ti kur ŋuaan wi̱cdɛ diɔ̱k, kä cuɛ dhɔɔl kɛnɛ nyi̱er kɔ̱kiɛn lɛni di̱eth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
              "GEN.11.13"
            ]
          }
        }
      ]
