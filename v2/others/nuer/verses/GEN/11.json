          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Na-ɣor runkɛ a run ti jiɛn da̱ŋ rɛw wi̱cdɛ bäŋuan cuɛ Tɛra di̱eth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.24",
            "verseOrgIds": [
              "GEN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr däpä Tɛra cu Na-ɣor lɛni te te̱e̱kä kɛ run ti kuɔ̱r kɛl wi̱cdɛ jiath kɛl wi̱cdɛ bäŋuan, kä cuɛ dhɔɔl kɛnɛ nyi̱er kɔ̱kiɛn lɛni di̱eth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.25",
            "verseOrgIds": [
              "GEN.11.25"
            ]
          }
        }
      ]
    },
