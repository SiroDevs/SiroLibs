              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ti̱ti̱ kɛ kɛn gaat Tɛra. Tɛra cuɛ Ab-ram di̱eth kɛnɛ Na-ɣor kɛ Ä-ran. Kä cu Ä-ran Lɔt di̱eth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kɔŋ li̱w ni Ä-ran kä gua̱n ni Tɛra dhɔɔr ëë diëthkɛ jɛ thi̱n ni Ur rööl Kɛ̈l-da-ya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ab-ram kɛnɛ Na-ɣor kuɛɛn. Cu ciek Ab-ram a Tha-ray, kä cu ciek Na-ɣor a Mil-ka nyiman Ith-ka tin la nyiee Ä-ran. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
            "verseOrgIds": [
              "GEN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö, cu Tha-ray a rol.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        }
      ]
