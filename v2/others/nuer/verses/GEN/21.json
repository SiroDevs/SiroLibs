          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Da̱p Ay-dhɛk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu Kuoth Nhial Thara ciɛŋ ni gɔaa, kä cuɛ ruac ëë lätdɛ jɛ la̱t ce̱tnikɛ mëë cɛ guɔ̱k jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.1",
            "verseOrgIds": [
              "GEN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kɛ jɛn gua̱a̱th ëë ci Kuoth ɛ rialikä cu Thara ruët kä cuɛ A-bɛ-ram da̱p gat mi dho̱o̱l guäth ëë ci A-bɛ-ram a wut mi dɔaaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.2",
            "verseOrgIds": [
              "GEN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu A-bɛ-ram gat ɛmɔ cɔl i̱ Ay-dhɛk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.3",
            "verseOrgIds": [
              "GEN.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu A-bɛ-ram gatdɛ ni Ay-dhɛk cuɛl mëë cɛ tekɛ ni̱n da̱ŋ bädäk diëëth, ce̱tnikɛ mëë ci Kuoth ɛ guɔ̱k jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.4",
            "verseOrgIds": [
              "GEN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ gua̱a̱th ëë daapkɛ ni Ay-dhɛk, A-bɛ-ram ɛn wa̱nɔ run diëëthdɛ kɛ run ti kuɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.5",
            "verseOrgIds": [
              "GEN.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛ̈nɛ jɛ cu Thara wee i̱, “Ci Kuoth to̱kdä la̱th guäthdɛ. Nɛy diaal tin ba jɛ liŋ bikɛ kiit kɛ ɣä kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.6",
            "verseOrgIds": [
              "GEN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ ram mi dëë jɛ me̱t ŋa̱c ɛn ɣöö bi Thara A-bɛ-ram lɛni da̱p gat kɛ cäŋ kɛl, kä ɣän ɛn täämɛ cä jɛ ben da̱p gat ni dɔŋädɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tuk A-gar kɛnɛ I-ca-mel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu gat piith kä cua jɛ do̱th. Kɛ cäŋ ëë döthkɛ ni Ay-dhɛk cu A-bɛ-ram mi̱eth mi di̱i̱t la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ kɛl mëë ci Thara gatdɛ ni Ay-dhɛk cu nɛn ŋarkɛ kɛnɛ gat A-bɛ-ram ëë da̱pkɛ jɛ ɛ A-gar in la nya rööl I-jëp, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.9",
            "verseOrgIds": [
              "GEN.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "cuɛ A-bɛ-ram cu jiök i̱, “Tuk nyam ɛ kuany ɛmɔ kɛnɛ gatdɛ, kɛ ɣöö /ci gat nyaam ɛ kuany ɛmɔ nyinku bi nyuak kɛɛl kɛnɛ gatdä ni Ay-dhɛk.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.10",
            "verseOrgIds": [
              "GEN.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu nɛmɛ a riɛk mi di̱i̱t kä A-bɛ-ram kɛ kui̱ I-ca-mel. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.11",
            "verseOrgIds": [
              "GEN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö cu Kuoth ɛ jiök i̱, “/Cu rɔ moc riɛk kɛ ɣöö bi diɛɛr kɛ kui̱ dhöl ɛmɔ kɛnɛ jɛn kuany nyaal ɛmɔ. Liŋ min lar Thara jɛ, kɛ ɣöö ɛ jɛn Ay-dhɛk ɛ ni̱n ba ciötdu kɛk kɛ kuaykɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.12",
            "verseOrgIds": [
              "GEN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä gat nyaamɔ kuany ɛmɔ lɛni jak kä do̱r mi di̱i̱t bä, kɛ ɣöö jɛn ɛ kuɛ̈ɛ̈du bä.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn bakädɛ mëë ruɔ̱n cu A-bɛ-ram A-gar moc kɛ mi̱th kɛnɛ pi̱ ti ca la̱th rɛy ɣo̱kä pi̱i̱ni, cuɛ dhɔl la̱th wukädɛ kä cuɛ jɛ jak kä wä. Cu A-gar ɣɔw ja̱l ca̱a̱r rɛy paan kä Ber-cɛ-ba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci pi̱ thuɔ̱k rɛy ɣo̱kä, cuɛ gat tɔa̱a̱c thaar buɔ̱t buɔ̱ɔ̱t, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.15",
            "verseOrgIds": [
              "GEN.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cuɛ wä nyuur ni guäth mi na̱n kä mi tɔt, ɛ jɛn i̱, “/Cä jɛ dëë luäŋ kɛ ruɔ̱t a bä gat ɛmɔ gui̱c li̱wɛ nhiamdä.” Ɛ jɛn cuɛ cu te na̱nä, kä cu gat ɛ ka̱n kɛ mi ro̱tdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Kuoth lul gatdä liŋ, cu jääk Kuɔth A-gar cɔl ni nhial i̱, “Ɛŋu, ɛŋu, A-gar? /Cu dual. Kuoth cɛ lul gatdä liŋ ɛn guäthdɛ mi tɔ̱ɔ̱cɛ thi̱n i̱. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.17",
            "verseOrgIds": [
              "GEN.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu gat wä ka̱n kä wër läŋ ɛ kɛ ɣöö bä jɛ jak kä do̱r mi di̱i̱t.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.18",
            "verseOrgIds": [
              "GEN.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Kuoth ɛ cu nyuɔ̱th jiw mi tekɛ pi̱. Cuɛ cu wä thi̱n kä cuɛ ɣök pi̱i̱nidiɛn wä thiäŋ thi̱n, kä cuɛ dhɔl cu moc ti maath ɛ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.19",
            "verseOrgIds": [
              "GEN.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.19",
            "verseOrgIds": [
              "GEN.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ cu Kuoth tekɛ dho̱o̱l ɛmɔ kɛɛl amäni mëë cuɛ di̱t. Cuɛ ciɛŋ ni därdɔaar kä cuɛ la ram mi ŋäc ba̱r kuen kui̱een ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.20",
            "verseOrgIds": [
              "GEN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nëë cieŋɛ pan Pa-ran cu man ɛ jëk nyal kä nyi̱er rööl I-jëp, cuɛ cu kuɛɛn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A-bɛ-ram kɛnɛ Ä-bi-mɛ-lɛk kä Ber-cɛ-ba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.21",
            "verseOrgIds": [
              "GEN.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ kɛn ni̱ni tɔ̱tɔ̱ cu Ä-bi-mɛ-lɛk ben kä A-bɛ-ram jälɛ kɛɛl kɛnɛ kuäär lathkëërikɛ ni Pi-kɔl, kä cu Ä-bi-mɛ-lɛk A-bɛ-ram ben jiök i̱, “Te Kuoth kɛ ji̱ kɛɛl rɛy lätniku diaal tin lätdi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.22",
            "verseOrgIds": [
              "GEN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yac rɔ ɛn wanɛ kɛ kui̱dä nhiam Kuɔth, ɛn täämɛ, kɛ ɣöö /ci maaru bi päl kɛ ɣä kiɛ ji̱ dhɔaarä kiɛ kuaykä. Ce̱tnikɛ min cä maar käp ni thukä kɛ ji̱, käp maaru kɛ ɣä kɛ duɔ̱ɔ̱p mi thuɔ̱k kä amäni jɛn wec ɛ ciɛɛŋi mi, bi gik cieŋ thi̱n kɛ thuɔ̱k lɔaac.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.23",
            "verseOrgIds": [
              "GEN.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu A-bɛ-ram ɛ loc i̱, “Gɔaaɛ, cä rɔ yac.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.24",
            "verseOrgIds": [
              "GEN.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, mëë ci A-bɛ-ram ku göny kä Ä-bi-mɛ-lɛk kɛ kui̱ jiɛw mi ci kuaanykɛ jɛ mac, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.25",
            "verseOrgIds": [
              "GEN.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "cuɛ jɛ loc i̱, “Ɣän kuecä jɛ. Ɛ jɛn lieŋdä kɛ jɛ ɛnɛ kä ji̱, thilɛ ram mi ci jɛ me̱t la̱r ɣä ɛ niɛ walɛ ɛmɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.26",
            "verseOrgIds": [
              "GEN.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu A-bɛ-ram Ä-bi-mɛ-lɛk cu moc kɛ muc de̱e̱t kɛnɛ ɣɔ̱k, kä cu kɛn da̱ŋ rɛw guk gok kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.27",
            "verseOrgIds": [
              "GEN.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu A-bɛ-ram näc de̱e̱t da̱ŋ bärɔw liɛny go̱lä rɛy de̱e̱tkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.28",
            "verseOrgIds": [
              "GEN.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ cu Ä-bi-mɛ-lɛk jɛ thi̱ec i̱, “Ɛŋu mɔ ci näc de̱e̱t da̱ŋ bärɔw ti̱ti̱ la̱th go̱lä mɔ?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.29",
            "verseOrgIds": [
              "GEN.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu A-bɛ-ram ɛ loc i̱, “Ji̱n bi kɛn de̱t ti̱ti̱ dhil ka̱n kä ɣä ala mi nyooth jɛ ɛn ɣöö jiw ɛmɛ tɛt ɛ ɣän.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.30",
            "verseOrgIds": [
              "GEN.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn mëë cɔalkɛ gua̱a̱th ɛmɔ i̱ Ber-cɛ-ba, kɛ ɣöö ɛ jɛn gua̱a̱th ëë ci gatdi da̱ŋ rɛw rɔ̱ gok thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
            "verseOrgIds": [
              "GEN.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cikɛ guk cu thuk kɛ läth piny kamnikiɛn kä Ber-cɛ-ba, cu Ä-bi-mɛ-lɛk kɛnɛ kuäär lathkëërikɛ ni Pi-kɔl loc ro̱o̱l ji̱ Pi-li-thɛt. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.32",
            "verseOrgIds": [
              "GEN.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu A-bɛ-ram rɔ pi̱eth jiath",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
            "verseOrgIds": [
              "GEN.21.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:33",
              "type": "text"
            },
            {
              "text": "Jiath ɛmɔ cɔalkɛ jɛ kɛ thok liŋli̱thni i̱ kɔat.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mi cɔal i̱ kɔat kä Ber-cɛ-ba, ɛn wa̱a̱ni cuɛ Kuoth Nhial ni Kuoth min thil pek pal. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
            "verseOrgIds": [
              "GEN.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu A-bɛ-ram cieŋ ro̱o̱l Pi-li-thɛt kɛ gua̱a̱th mi bäär ɛlɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.34",
            "verseOrgIds": [
              "GEN.21.34"
            ]
          }
        }
      ]
    }
