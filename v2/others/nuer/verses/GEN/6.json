    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thil luäŋä ran",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci naath ɛ tok kɛ mi rëpkɛ rɔ̱ wi̱i̱ muɔ̱ɔ̱n kä ca rɔ diëth nyi̱er, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu gaat Kuɔth ɛ nɛn ɛn ɣöö te nyiee nath kɛ maan, kä cukɛ rɔ̱ li̱eny män kä kɛ kɛ pe̱k lo̱cnikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu Kuoth Nhial ɛ cu lar i̱, “/Ci tieeydä bi lɛ te rɛy ran ala mi do̱raar kɛ ɣöö raan ɛ ri̱ŋ, kä täämɛ bi pe̱k runi te̱e̱kädɛ a run ti kuɔ̱r wi̱cdɛ jiɛn da̱ŋ rɛw ɛ juc.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ gua̱a̱th ëë ci gaat Kuɔth ben kä nyiee nath kä cukɛ kɛ di̱eth gaat, kä cukɛ a kɛn nɛy tëë cu kɛ̈kdiɛn räth. Kɛ jɛn gua̱a̱th ɛmɔ cu mäni pek ëë wä nhiam, cu nɛy ti di̱t ti buɔ̱ɔ̱m buɔ̱ɔ̱m ti dit kɛ̈kdiɛn jɔɔc wi̱i̱ muɔ̱ɔ̱n.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu Kuoth Nhial ɛ guic ɛn ɣöö ci nyuɔɔn nath rɔ juak wi̱i̱ muɔ̱ɔ̱n, amäni ca̱a̱p diaal tin cu naath kɛ ŋäth kɛ ca̱r lo̱cnikiɛn kärɔa kɛ nyin jiäkni ti wee kɛ wä thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial lɔcdɛ jiääk kɛ ɣöö cɛ naath cak wi̱i̱ muɔ̱ɔ̱n. Cuɛ jɛ moc ŋɛ̈ɛ̈ny lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu Kuoth Nhial ɛ cu lar i̱, “Ɣän bä ŋɔak tëë cä cak niɛ ɣän poc wi̱i̱ muɔ̱ɔ̱n, a tookɛ ni kä naath, kɛ le̱y kɛ muɔɔl piɛny amäni tin diaal tin ca cak kɛ juät, kɛ ɣöö ci lɔcdä jiääk kɛ ca̱kdiɛn.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛ̈nɛ jɛ, cu wut in cɔal i̱ Nowa nhök jek kä Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "La̱t Nowa kɛ riey",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kɛn gaat Nowa. Nowa ɛ wut mi gua̱n cuŋni, thilɛ jɛ bɛ̈l rɛy ri̱cnikɛ, kä cuɛ ja̱l kɛɛl kɛ Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.9",
            "verseOrgIds": [
              "GEN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ gaat da̱ŋ diɔ̱k di̱eth, ɛ Cɛm kɛ Ɣɛ̈m kɛ Ya-pɛth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.10",
            "verseOrgIds": [
              "GEN.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.10",
            "verseOrgIds": [
              "GEN.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ, cu wi̱c muɔ̱ɔ̱n jiääk nhiam Kuɔth kä thiäŋɛ kɛ nyuɔɔn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.11",
            "verseOrgIds": [
              "GEN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Kuoth ɛ guic kä cɛ jɛ nɛn ɛ cɛ jiääk kɛ ɣöö ci nɛy diaal ciaaŋdiɛn ya̱r wi̱i̱ muɔ̱ɔ̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.12",
            "verseOrgIds": [
              "GEN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "cuɛ Nowa jiök i̱, “Ɣän cä jɛ lar ɛn ɣöö bä nɛy diaal moc pe̱k kɛ ɣöö ci piny thia̱a̱ŋ kɛ nyuɔɔn kɛ kui̱diɛn. Guic ɛ, ɣän bä kɛ däk kɛɛl kɛ mun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.13",
            "verseOrgIds": [
              "GEN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, lätni rɔ kä riey kɛ jiath mi cɔal i̱ go-pɛr. Lätni rɛy ria̱a̱y kä duël, kä dilni kuilkɛ rɛci kɛnɛ jɔkdɛ kɛ mun mi dɔk dɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.14",
            "verseOrgIds": [
              "GEN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi jɛ täth inɛ, bär riaaŋ piny ba jua̱th tetni ti kur diɔ̱k, kä bi ɣäp ɣääpdɛ a jua̱th tetni ti jiɛn dhieec, kä bi bärɛ nhial a jua̱th tetni ti jiɛn diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.15",
            "verseOrgIds": [
              "GEN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täthni riey wi̱c, kä pith ni jɛ tueeth nhial mi bärɛ juäth tetdä, kä latni thok riay buɔ̱lädɛ. Kä jakni riey kä tekɛ duël piɛny kɛnɛ duël da̱a̱r kɛ duël tin te nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.16",
            "verseOrgIds": [
              "GEN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö nɛn ɛ, ɣän bä wi̱c muɔ̱ɔ̱n moc nyɔc kɛ ɣöö bɛ tin diaal tin tëk thi̱n ben däk, tin diaal tin te wi̱i̱ muɔ̱ɔ̱n bikɛ li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä guic ɛ, ɣän bä gukdä la̱th piny kɛ kui̱du, kä ji̱n bi coth rɛy ria̱a̱y kɛɛl kɛ ciekdu kɛnɛ gaatku kɛ mänkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.18",
            "verseOrgIds": [
              "GEN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji̱n bi tuut kɛnɛ ŋuɔ̱ɔ̱tdɛ naŋ rɛy ria̱a̱y ŋɔak diaal tin tëk kɛ ɣöö bi kɛ yop a tëk kɛ ji̱ kɛɛl, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.19",
            "verseOrgIds": [
              "GEN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "naŋ rɛw kä diit diaal nikɛ cätdiɛn kɛ ley diaal nikɛ cätdiɛn kɛ muɔɔl piɛny diaal nikɛ cätdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.20",
            "verseOrgIds": [
              "GEN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä no̱ŋni rɔ kuay mi̱thni diaal tin camkɛ, kä tɔ̱wni kɛ gööli, kä bikɛ la mi̱th kɛ kui̱dun kɛnɛ kui̱diɛn.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.21",
            "verseOrgIds": [
              "GEN.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Nowa mɛmɛ la̱t, cuɛ tin diaal tin ci Kuoth kɛ la̱r jɛ la̱t.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.22",
            "verseOrgIds": [
              "GEN.6.22"
            ]
          }
        }
      ]
    }
  ],
