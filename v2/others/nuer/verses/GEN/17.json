        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cuël ɛ nyuuth gukä Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Ab-ram tekɛ run ti jiɛn bäŋuan wi̱cdiɛn bäŋuan, cu Kuoth Nhial rɔ nyuɔ̱th jɛ kä cuɛ jɛ jiök i̱, “Ɛ ɣän Kuoth in le̱ny buɔ̱mdɛ ti diaal. Liŋ ruaacnikä kä lätni ni min la thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö dëë guk kamädan ëëdan cuɔ̱p guäthdɛ, kä dëë kuayku pe̱kdiɛn re̱p ɛlɔ̱ŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Ab-ram mɛmɛ liŋ, cuɛ wi̱cdɛ guɔ̱l piny guäth in wä Kuoth kɛ ruac kɛ jɛ, kä cu Kuoth ɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mɛmɛ ɛ jɛn gukdä kɛ ji̱. Bi ji̱n a gua̱n dööri ti nyin ŋuan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ca ji̱ bi nyɔk kɛ ciöt i̱ Ab-ram, ciötdu ba ni A-bɛ-ram, kɛ ɣöö cä ji̱ jak kä gua̱ndɔɔŋ dööri ti ŋuan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bä kuayku re̱p ɛlɔ̱ŋ a /ca kɛ bi luäŋ kɛ kuën kä bikɛ a döör wec muɔ̱ɔ̱n kä bi tha̱a̱ŋkiɛn a kua̱r tin di̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bä gukdä yiath piny kɔnɛ ji̱ amäni kuayku kɛ ri̱c diaal tɔ̱ bi ben tɔ̱ ala guk ruac mi do̱raar ɛn ɣöö bä la Kuothdu yɛnɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wec Kɛ-naan ɛ lapi jääl thi̱n ɛ, ni kɛɛliwdɛ bä jɛ ka̱m ji̱ yɛnɛ kuayku, kɛ ri̱c diaal tɔ̱ bi ben tɔ̱, ala duŋdiɛn amäni cäŋ kɛl. Kä bä cua̱ Kuothdiɛn.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ A-bɛ-ram lɛni jiök i̱, “Ji̱n puɔ̱nydu pa̱ny, min bi la̱t ɛ ɣöö bia gukdä rɔm yɛn diaal kɛɛl amäni kuayku kɛ ri̱c diaal tɔ̱ bi ben tɔ̱, ba gua̱a̱l ɛ kɛn ni ciaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
              "GEN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ji̱n röm in bi rɔm ni gukdä yɛnɛ kuayku jɛ nɛn, tut diaal kä yɛ ba kɛ dhil cuɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba yɛ dhil cuɛl yɛn diaal kä bi nɔmɔ a nyuuth gukädan amäni cäŋ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yɛn bia dhɔl in tekɛ ni̱n bädäk däpä cuɛl, matdiɛn amäni gaat kuaanyni tin ca dap rɛy dho̱rikun kɛnɛ ja̱a̱ŋkun tin kɔk yɛn kɛ kɛ yio̱o̱kun. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Di̱elɛ kɛ cuël kɛn diaal amäni kuaany. Kɛ ɣöö bi gukdä kɛ yɛ la nyuth mi do̱raar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuut mi /ka̱n cuɛl ba jɛ koc rɛy nɛɛnikɛ kɛ ɣöö cɛ gukdä ya̱r.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jɛ lɛni jiök i̱, “Täämɛ, kɛ kui̱ ciëkdu ni Tha-ray /ca jɛ bi nyɔk kɛ ciöt i̱ Tha-ray, kä bɛ la ni Thara (min lot ni ɣöö nya kua̱r in di̱i̱t). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bä jɛ poth kä (bä ji̱ moc gat kɛ jɛ) (bɛ ji̱ da̱p gat). Kä puɔ̱thdä min bä poth ni jɛ bɛ döör kɛnɛ kua̱r tin ŋuan dap.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë liŋ A-bɛ-ram nɔmɔ cuɛ wi̱cdɛ lɛni guɔ̱l piny, kä jɛn cuɛ to̱k dɔl kɛ lɔcdɛ caarɛ jɛ i̱, “Derɛ a thuɔ̱k a dëë ram mi tekɛ run ti kuɔ̱r kɛl gat dhil di̱eth? Thara ŋot dapä kä tëë kɛ run kä dëël ti jiɛn bäŋuan?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.17",
            "verseOrgIds": [
              "GEN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ cuɛ Kuoth ku jiök i̱, “Duŋ mi nhɔki jɛ, a I-ca-mel tëk.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth ɛ loc i̱, “Aal, niɛ ciekdu ni Thara bɛ ji̱ da̱p gat, kä bi ciötdɛ cɔli Ay-dhɛk (min lot ni ɣöö dɔlɛ jɛ). Bä gukdä yiath piny kɔnɛ jɛ amäni kuaykɛ bä, ala guk ruac mi do̱raar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä puɔ̱nydɛ ɛn I-ca-mel, cä min ci thi̱ec kɛ kui̱dɛ liŋ, kä bä jɛ poth a bɛ tekɛ gaat ti nyin ŋuan. Jɛn bɛ kua̱r da̱ŋ wäl wi̱cdɛ rɛw di̱eth, kä bä jɛ jak kä do̱r mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
              "GEN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min te ni jɛn thi̱n, gukdä bä jɛ yiath piny kɔnɛ Ay-dhɛk in bi Thara jɛ da̱p ji̱ ithaar cɔ̱tdä nɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
            "verseOrgIds": [
              "GEN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Kuoth min lätdɛ jɛ thuk kɛ lät jɛ, cu Kuoth bath waaŋdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ, niɛ cäŋ ɛmɔ pa̱ny, cu A-bɛ-ram gatdɛ ni I-ca-mel cu cuɛl ce̱tnikɛ min ci Kuoth ɛ lar, jɛn amäni tut diaal tin te gɔɔlɛ, tin dapkɛ dhɔrɛ, kɛ tin cɛ kɔk kɛ yio̱o̱kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.23",
            "verseOrgIds": [
              "GEN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä A-bɛ-ram runä mëë cuɛ̈ɛ̈lkɛ ni jɛ runkɛ kɛ run ti jiɛn bäŋuan wi̱cdɛ bäŋuan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
              "GEN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä te gatdɛ ni I-ca-mel kɛ run da̱ŋ wäl diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
              "GEN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kɛ jɛn cäŋ ɛmɔ cua A-bɛ-ram cuɛl kɛnɛ gatdɛ ni kɛɛl, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.26",
            "verseOrgIds": [
              "GEN.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛn diaal amäni wutni dhɔaarɛ diaal.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.27",
            "verseOrgIds": [
              "GEN.17.27"
            ]
          }
        }
      ]
    }
  ],
