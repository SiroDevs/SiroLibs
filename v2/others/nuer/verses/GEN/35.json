              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Je-kɔb cop dhɔr gua̱n ni Ay-dhɛk in te kä Ma-mɛ-ri min la Kir-yath-ar-bä (kiɛ Ɣɛb-ron), gua̱a̱th ëë ci A-bɛ-ram kɛnɛ Ay-dhɛk kɔŋ tekɛ ni̱n thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
          }
        },
        {
          "name": "verse",
