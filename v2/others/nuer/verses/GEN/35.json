          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr te̱e̱kä mi bäär kɛ run ti kuɔ̱r kɛl wi̱cdɛ jiɛn bädäk, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
          }
        },
        {
