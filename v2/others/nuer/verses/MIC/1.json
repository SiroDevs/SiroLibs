        },
        {
          "text": "Nɛmɛ ɛ ruac Kuɔth Nhial mëë ci ben kä gök ni Mikaa raan rööl mi cɔali Mo-rɛ-cɛth, mëë ruec ni Yo-tham kɛnɛ A-ɣadh kɛ Ɣidh-ki-yaa, kua̱r Juda tin di̱t, mëë cɛ nyuɔ̱th jɛ kɛ kui̱ Tha-mɛ-ria kɛnɛ Jɛ-ru-tha-lɛm.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pa̱r kɛ kui̱ Tha-mɛ-ria kɛnɛ Jɛ-ru-tha-lɛm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cuɔ̱p gua̱n tɛ̈r kä Jɛ-ru-tha-lɛm",
          "type": "text"
        }
      ]
    }
