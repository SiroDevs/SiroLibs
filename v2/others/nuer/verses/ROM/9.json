              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋu mi banɛ kulɛ lar? Kä ca nɛy tin /ci tɔ̱ a ji̱ Juudh kä /ken rɔ̱ moc cuɔ̱ɔ̱ŋ kɛɛl kɛ Kuoth cakɛ moc cuɔ̱ɔ̱ŋ kɛ ŋa̱thdiɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.30",
            "verseOrgIds": [
              "ROM.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä ji̱ I-thɛ-rɛl tin ca rɔ̱ moc cuɔ̱ɔ̱ŋ kɛɛl kɛ Kuoth kɛ guuridiɛn kɛ ŋut, /ken kɛn ŋut luäŋ kɛ guur. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
            "verseOrgIds": [
              "ROM.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋu? Ɛ ɣöö /ken kɛn ɛ do̱t rɛy ŋäthä, kä cikɛ ŋäth ni lätkiɛn. Cukɛ kɔa̱a̱th kɔ̱thikä wi̱i̱ pa̱a̱m kɔa̱a̱thni, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.32",
            "verseOrgIds": [
              "ROM.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ce̱tkɛ min ca gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.33",
            "verseOrgIds": [
              "ROM.9.33"
