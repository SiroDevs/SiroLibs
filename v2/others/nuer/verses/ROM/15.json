{
  "id": "ROM.15",
  "number": "15",
  "bookId": "ROM",
  "reference": "Röm 15",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ROM 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakni lɔc nɛɛni tin kɔ̱ŋ kä tɛth a /ci mɔ a ji̱n",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɔn nɛy tin bum ŋäthä banɛ a lua̱k nɛɛni tin kɔc ŋa̱thdiɛn, kä /cuarnɛ moc ni rɔ̱ kɛ tɛ̈th lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
              "ROM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ramɔ kä kɔn jak lɔc gua̱n thieekädɛ kä tɛth kɛ kui̱ gɔɔyädiɛn, kɛ ɣöö bɛ kɛ luäk kɛ pi̱eth rɛy ŋäthä. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.2",
            "verseOrgIds": [
              "ROM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö /ken Kritho moc ni rɔɔdɛ kɛ tɛ̈th lɔaac, kä ce̱tkɛ min ca gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:3",
              "type": "text"
            },
            {
              "text": "Diit 69:9.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ci kuethni tin kuëthkɛ ni yɛ pɛn wi̱i̱dä.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö tëë diaal tëë ca gɔ̱r ni wal, gɔ̱a̱rkɛ kɛ kui̱ ŋi̱i̱cädan, kɛ ɣöö banɛ tekɛ ŋa̱th kɛnɛ dhieel kɛ buɔ̱m lɔaac min ci ruac Kuɔth ɛ ka̱m kɔn. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.4",
            "verseOrgIds": [
              "ROM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Kuoth in bä dhieel kɛnɛ buɔ̱m lɔaac kä jɛ käm yɛ ciaaŋ malä kamnikun, ce̱tkɛ ta̱a̱ Yecu Kritho, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.5",
            "verseOrgIds": [
              "ROM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ kui̱ kä ɣöö dee yɛn Kuoth kä Gua̱n Kua̱ran ni Yecu Kritho puany kɛ jɔw kɛl.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thuk ti gɔw kɛ kui̱ Yecu kɛ nyin ji̱ Juudh kɛnɛ Jur",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuɔ̱ɔ̱rɛ rɔ̱ agɔaa, ce̱tkɛ min ci Kritho yɛ nyuɔ̱ɔ̱r agɔaa kɛ kui̱ puɔnyä Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.7",
            "verseOrgIds": [
              "ROM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä jɛ la̱r yɛ ɛn ɣöö Kritho ɛ läät kɛ kui̱ ji̱ Juudh kɛ ɣöö bɛ thuɔ̱k Kuɔth nyoth, mëë ci Kuoth ɛ la̱r gua̱ndɔɔŋni ji̱ Juudh jakä thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.8",
            "verseOrgIds": [
              "ROM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä dee Jur Kuoth puany kɛ kui̱ kɔ̱cä lɔaacdɛ. Ce̱tkɛ min ca gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:9",
              "type": "text"
            },
            {
              "text": "Diit 18:49, 2 Tham 22:50.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lat Puɔl kɛ min gɔ̱ɔ̱rɛ a jɔc",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.13",
            "verseOrgIds": [
              "ROM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän puɔ̱nydä gaatmaari lɔcdä ro̱ŋ kɛ kui̱dun, ɛn ɣöö thiäŋ yɛn kɛ gɔɔy, kä thia̱ŋ yɛn kɛ ŋäc ŋɔaani, kä ta̱yɛ kɛ lua̱ŋ kɛ ŋi̱i̱cdun kɛ rɔ̱. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.14",
            "verseOrgIds": [
              "ROM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ tha̱a̱ŋ ŋɔaani cä yɛ gɔ̱a̱r warɛgak kɛ ɣöö bia kɛ tim kɛ kui̱ kɔ̱cä lɔaac in ca ka̱m ɣä ɛ Kuoth, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.15",
            "verseOrgIds": [
              "ROM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö bi ɣän a läät Kritho Yecu kɛ kui̱ Juri. La̱tdä ala bo̱o̱th palä mi ŋi̱i̱c thuk tin gɔw kɛ kui̱ Kuɔth, kɛ ɣöö dee Juri a muc ti nhɔk Kuoth kɛ ti ca lɛy ɛ Yiëë in Gɔaa in Rɛl Rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.16",
            "verseOrgIds": [
              "ROM.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ, ɣän liakä rɔ rɛy Kritho Yecu kɛ tin cä la̱t kɛ kui̱ Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.17",
            "verseOrgIds": [
              "ROM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän thilɛ mi bä lat ɛ ni min ci Kritho ɛ la̱t kɛ ɣä kɛ ɣöö bä Jur jak kä ɣöö ba Kuoth luɔ̱th. Kɛn cikɛ Kuoth luɔ̱th kɛ min cä lat kä cä la̱t, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.18",
            "verseOrgIds": [
              "ROM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ buɔ̱m nyuuthni kɛnɛ ti ga̱ykɛ naath kɛ lua̱ŋ Yieekä Kuɔth. Ɣän cä ruac Kuɔth lat nikä Jɛ-ru-tha-lɛm a räth nikä I-li-ri-kum cä thuk ti gɔw lat kɛ kui̱ Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.19",
            "verseOrgIds": [
              "ROM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Di̱t lɔcdä, kɛ ɣöö bä thuk ti gɔw kɛ kui̱ Yecu lat gua̱thni tin /ka̱n ciöt Kritho kɔŋ liŋ thi̱n, kɛ ɣöö /cä jɛ go̱r ɛn ɣöö bä la̱tdä la̱t wi̱i̱ la̱t mi ci radɔ̱diɛn ɛ tok. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
              "ROM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ce̱tkɛ min ca gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:21",
              "type": "text"
            },
            {
              "text": "Ica 52:15.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ca̱r Puɔl kɛ gui̱lɛ kɛ Röm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ jɛn luɔt kä min gaŋ ɣä jɔ̱ɔ̱r kɛ bendä kä yɛ gua̱thni ti ŋuan. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn täämɛ cä thuɔ̱k kɛ la̱t ɛn gua̱thni ti̱ti̱, kä mëë göörä ben kä yɛ kɛ run ti ŋuan, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.23",
            "verseOrgIds": [
              "ROM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ɛn täämɛ göörä ben kä yɛ. Ɣän bä yɛ bak kɛ wädä kä Thɛ-peen, kä bia ɣä wä luäk kɛ wädä ɛn wi̱ni, guäth in ci lɔcdä tɛ̈th lɔaac kɛ gui̱lun. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.24",
            "verseOrgIds": [
              "ROM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn täämɛ wa̱a̱ kä Jɛ-ru-tha-lɛm wa̱a̱ nɛɛ gan Kuɔth tin cɛ lɛy luäk. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.25",
            "verseOrgIds": [
              "ROM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ci ji̱ Ma-tha-do-nia kɛnɛ ji̱ A-ke-ya ɛ nhɔk ɛn ɣöö bikɛ muc thöp kɛ kui̱ caani tin te rɛy nɛɛni Kuoth tin te kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.26",
            "verseOrgIds": [
              "ROM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kɛn ɛ nhɔk i̱ ba la̱t, kä ɛpuc ɛ cuɔ̱ɔ̱ŋ kä kɛ. Kä kɛ ɣöö ci Jur ben nyuaakä puthä yieekä ji̱ Juudh, gɔaa ɛ bä ɛn ɣöö bi kɛn nyinkiɛn nyuak kɛ ji̱ Juudh. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wa̱a̱ nɛmɛ wä thuk inɔ, kä cä kɛ ka̱m tin ca dol, ɣän bä yɛ bak kɛ wädä kä Thɛ-peen. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋa̱cä jɛ ɛn ɣöö mi wa̱a̱ ben kä yɛ bä ben kɛ puɔ̱th Kritho mi ro̱ŋ.",
          "type": "text",
