  "reference": "Röm 4",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ROM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuɔ̱th A-bɛ-ram kɛ ŋa̱th",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋu mi banɛ lar i̱ ci A-bɛ-ram, gua̱n gua̱ndɔɔŋnikɔn ɛ ŋa̱c? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.1",
            "verseOrgIds": [
              "ROM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ca A-bɛ-ram moc cuɔ̱ɔ̱ŋ kɛ lät, jɛn tëëkɛ luɔt mi derɛ liak ni rɔ, a /ci mɔ a nhiam Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.2",
            "verseOrgIds": [
              "ROM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛŋu ci ruac Kuɔth in rɛl rɔ ɛ lar ɔ? “Ci A-bɛ-ram Kuoth ŋäth, kä ca jɛ nhɔk ala ciaŋ cuŋni kä jɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:3",
              "type": "text"
            },
            {
              "text": "Tuk 15:6.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ pek ko̱kä raam mi ci lät /ca jɛ dee car i̱ ɛ muc, ɛ jɛn min ba yi̱k ka̱m jɛ a la duŋdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.4",
            "verseOrgIds": [
              "ROM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ɛ ram mi /ci lät, kä ŋääthɛ Kuoth in moc nɛy tin tekɛ dueer kɛ cuɔ̱ɔ̱ŋ, ɛn ŋa̱th ɛmɔ ca jɛ car i̱ ɛ ciaŋ cuŋni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.5",
            "verseOrgIds": [
              "ROM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ bä, cu Dee-bid ruac kɛ kui̱ raam mi ci Kuoth ɛ poth kä cɛ car i̱ tekɛ ciaŋ cuŋni a thil lätkɛ mëë wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.6",
            "verseOrgIds": [
              "ROM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.8",
            "verseOrgIds": [
              "ROM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Latkɛ puɔ̱th ɛmɛ kɛ kui̱ nɛɛni tin ca cuɛl kärɔ̱, kiɛ amäni nɛy tin /ka̱n cuɛl bä? Kä la kɔn a wee i̱, “Ca ŋa̱th lar i̱ ɛ ciaŋ cuŋni kä A-bɛ-ram.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.9",
            "verseOrgIds": [
              "ROM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ tuɔɔk i̱di? Ɛ kɔr kä mëë ca cuɛl kiɛ mëë /ka̱nɛ ni cuɛl? /Ciɛ kɔrɛ, ɛ mëë ŋotdɛ /ka̱nɛ ni cuɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.10",
            "verseOrgIds": [
              "ROM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn cuɛ cuël jek ala nyuuth ciɛɛŋä cuŋni mëë cɛ jek kɛ ŋa̱th, a ŋotdɛ /ka̱nɛ ni cuɛl. Luɔtdɛ ɛ ɣöö bɛ jɛ jakä gua̱n nɛɛni diaal tin ŋa̱th a /ka̱n cuɛl, kä ca lar i̱ tekɛ kɛ ciaŋ cuŋni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.11",
            "verseOrgIds": [
              "ROM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn bä ɛ gua̱n nɛɛni tin ca cuɛl, kä /ciɛ nɛy tin ca cuɛl kärɔ̱, kɛ nɛy tin guɔ̱ɔ̱rkɛ ni ŋa̱th gua̱ndan ni A-bɛ-ram ëë nhiam ɛ /ka̱nɛ ni cuɛl.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac Kuɔth jëkɛ jɛ kɛ ŋa̱th",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min ca lar i̱ ba ka̱m A-bɛ-ram amäni karkɛ ɛn ɣöö dee ɣɔw a duŋdɛ, /cɛ bä kä ŋut, bëë kä ciaŋ cuŋni ŋäthä. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi dee naath min ca lar ɛ Kuoth jek kɛ guuri ŋutdä, ŋa̱th cɛ la baŋ, kä min ci Kuoth ɛ lar cɛ thil luɔt. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ŋut no̱o̱ŋɛ waŋ lɔaac, kä gua̱a̱th mi thil ŋut thilɛ jɛ kac dui̱rä.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ ruac in ci Kuoth ɛ lar thi̱ŋɛ rɔ ŋäthä kɛ ɣöö min ca lar ba jɛ ŋun kɛ puɔ̱th baaŋ Kuɔth ka̱mkɛ jɛ kar A-bɛ-ram diaal ala muc baaŋ. Kä /ciɛ duŋ nɛɛni tin ka̱pkɛ ŋut kärɔ̱, amäni nɛy tin nyuakɛ ŋa̱th A-bɛ-ram, (kɛ ɣöö ɛ gua̱ndan kɔn diaal), ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
              "ROM.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ce̱tkɛ min ca gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.17",
            "verseOrgIds": [
              "ROM.4.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:17",
              "type": "text"
            },
            {
              "text": "Tuk 17:5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Cä ji̱ jakä gua̱n dööri ti ŋuan.” Ruac ɛmɔ ɛ thuɔ̱k nhiam Kuɔth A-bɛ-ram, min ŋääthɛ, min jak nɛy tin ci li̱w kä tëk, min jak mi /ken kɔn te wanɔ kä te wanɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.17",
            "verseOrgIds": [
              "ROM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu A-bɛ-ram ŋa̱th a cäŋ ni mëë thilɛ mi dee ŋa̱th kɛ jɛ, kä cuɛ ben a gua̱n dööri ti ŋuan, ce̱tkɛ mëë ca lar i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:18",
              "type": "text"
            },
            {
              "text": "Tuk 15:5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Bi karku ŋuan, ce̱tkɛ kuɛl.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Kenɛ kɔ̱a̱c rɛy ŋäthä mëë cɛ guicɛ rɔɔdɛ i̱, ce̱tdɛ kɛ ram mi ci li̱w, (kɛ ɣöö ci runkɛ a kuɔ̱r kɛl diëëthdɛ, kɛnɛ mëë cɛ Thara car i̱ ɛ rol.) ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
            "verseOrgIds": [
              "ROM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ diw ŋäthä mi jak jɛ kä te leek leek kɛ kui̱ kä mëë ci Kuoth ɛ lar, kä cuɛ piith bumɛ rɛy ŋäthädɛ a liakɛ Kuoth, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.20",
            "verseOrgIds": [
              "ROM.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä ro̱ŋɛ lɔɔcdɛ ɛn ɣöö te Kuoth kɛ lua̱ŋ kɛ la̱t kɛ mi cɛ lar. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.21",
            "verseOrgIds": [
              "ROM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ cua ŋa̱thdɛ cu lar, i̱ ɛ ciaŋ cuŋni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.22",
            "verseOrgIds": [
              "ROM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä rieet ti̱ti̱ ni ɣöö, “Ca jɛ lar i̱ ɛ gua̱n cuŋni,” /ka̱n kɛ gɔ̱r kɛ kui̱dɛ kärɔa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.23",
            "verseOrgIds": [
              "ROM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakɛ gɔ̱r kɛ kui̱dan bä, kɔn nɛy tin ba jɛ lar i̱ ji̱ cuŋni kɔn nɛy tin ŋa̱thkɛ Kuoth ëë jiɛc Yecu Kritho li̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.24",
            "verseOrgIds": [
              "ROM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ca Yecu jakä li̱w kɛ kui̱ dueerikɔn, kä ca jɛ jiɛc kɛ ɣöö ba kɔn moc kɛ cuɔ̱ɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.25",
            "verseOrgIds": [
              "ROM.4.25"
            ]
          }
        }
      ]
    }
  ],
