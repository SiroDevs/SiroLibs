          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nɛy ti dɔa̱a̱r, ti /ca ŋäth, ti thil lo̱c, nɛy ti rɛ̈ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋäc kɛn ŋut Kuɔth ɛn ɣöö bi nɛy ti la̱tkɛ ti jiäk ti ce̱tkɛ ti̱ti̱ li̱w. Kä /cikɛ lät ni ti̱ti̱ kä rɔ, kä nhɔakɛ nɛy tin la̱tkɛ ti̱ti̱ bä.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
            "verseOrgIds": [
              "ROM.1.32"
            ]
          }
        }
