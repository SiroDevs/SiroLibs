          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ kä mɛmɛ ci Kuoth kɛ cu pa̱l ciaaŋ po̱cädiɛn ɛ jiääk ɛmɔ. Ci mänkiɛn ciaŋ tɔ̱ɔ̱cä cɔɔnikiɛn luɛl kɛ tɔ̱ɔ̱c mään ti kɔ̱kiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ jɛn duɔ̱ɔ̱p ɛmɔ bä ci wutni ciaaŋdiɛn kɛ män päl, cukɛ wä go̱r ni pua̱nykiɛn kɛ rɔ̱. Lät wutni ni lät po̱cä kɛ wutni ti kɔ̱kiɛn, kɛ kui̱c ɛmɔ cikɛ rɔ̱ nöŋ duäc kɛ kui̱ dueerikiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
