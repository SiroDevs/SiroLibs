    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cuɔ̱p Ɛdhra kä Jɛ-ru-tha-lɛm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä ti̱ti̱ mëë ruec ni Är-tɛ̈k-cɛ̈th-tɛ kuäär Pa-rath, cu Ɛdhra gat Thɛ-ra-yaa, gat Ä-dhar-yaa, gat Ɣil-ki-yaa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "gat Cɛ̈-lum, gat Dha-dok gat Ä-ɣi-tub, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "gat Ä-mɛ̈r-yaa, gat Ä-dhar-yaa, gat Mɛ-ra-yoth, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "gat Dhɛ-rɛ̈-yaa, gat Udhi, gat Buki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "gat Ä-bi-cuwä, gat Pi-nɛ-ɣath, gat Ɛl-a-dhar, gat Ä-ron bo̱o̱th palä min di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɛdhra ɛmɛ jiɛɛn kä Bɛ̈-bi-lɔn. Kä jɛn ɛ ŋi̱i̱c ŋuɔ̱tni muthɛ tëë ci Kuoth Nhial Kuoth I-thɛ-rɛl kɛ ŋun. Kä cu kuäär ɛ ka̱m tëë diaal tëë cɛ thiec, kɛ ɣöö te Kuoth Nhial ni Kuoth kɛɛl kɛ jɛ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ bärɔw runi ruëc kua̱r ni Är-tɛ̈k-cɛ̈th-tɛ cu tha̱a̱ŋ ji̱ I-thɛ-rɛl kɛnɛ tha̱a̱ŋ bööthni palä kɛ ji̱ Lii-bay, kɛ këët din, kɛ ga̱a̱ŋ thuɔk luaak Kuɔth kɛnɛ la̱a̱tkɛ wä kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ben kä Jɛ-ru-tha-lɛm kɛ dhieec päthni kɛ bärɔw runi ruec kua̱r, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö te Kuothdɛ kɛɛl kɛ jɛ, cuɛ jiɛn kä Bɛ̈-bi-lɔn kɛ cäŋ in nhiam kä pay in jio̱l, kä cuɛ cop kä Jɛ-ru-tha-lɛm kɛ cäŋ in nhiam kɛ dhieec päthni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛdhra cɛ lɔcdɛ la̱th kuenä ŋuɔ̱tni Kuɔth Nhial, kɛnɛ ɣöö bɛ kɛ la̱t, kä bɛ ciaŋ Kuɔth kɛnɛ luëëkɛ ŋi̱eec kä I-thɛ-rɛl.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Warɛgak mi ci Är-tɛ̈k-cɛ̈th-tɛ ɛ ka̱m Ɛdhra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ pek warɛgak in ci kuäär ni Är-tɛ̈k-cɛ̈th-tɛ ɛ ka̱m Ɛdhra bo̱o̱th palä, kä ŋi̱i̱c, min ŋäc luëëk Kuɔth Nhial kɛnɛ ŋuɔ̱tkɛ kɛ kui̱ ji̱ I-thɛ-rɛl i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Warɛgak kä Är-tɛ̈k-cɛ̈th-tɛ kuäär kua̱ri, wëë kä Ɛdhra bo̱o̱th palä, kä ŋi̱i̱c ŋuɔ̱tni Kuɔth puɔ̱rä. Kä täämɛ ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ɣän cä lar ɛn ɣöö pekdɛ raan kä ji̱ I-thɛ-rɛl, kiɛ bööth palä, kiɛ raan ji̱ Lii-bay mi te kuäärädä, mi go̱o̱r wä kä Jɛ-ru-tha-lɛm, a jɛ wä kɛɛl kɛ ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ɣän ja̱k ɣä ji̱ kɔnɛ luëëkä da̱ŋ bärɔw kɛ ɣöö bi Juda kɛnɛ Jɛ-ru-tha-lɛm wä gui̱l kɛ kui̱ ŋuɔ̱tni Kuɔthdu tin tekɛ ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛnɛ ɣöö bi da̱a̱p kɛnɛ ciɛk in bo̱r min cä thöp Kuoth I-thɛ-rɛl baaŋ kɔnɛ luëëkä, tin cieŋ kä Jɛ-ru-tha-lɛm wä gui̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛɛl kɛnɛ ciɛk in bo̱r kɛ da̱a̱p in bi wä jek wi̱i̱ni Bɛ̈-bi-lɔn diaal, kɛ muc tɛthkä lɔaac nath, kɛnɛ bööth palä kɛ kui̱ luaak Kuɔthdiɛn kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɛn yio̱w ti̱ti̱ kɔk thääk, kɛnɛ dɛy deet, kɛ rueeth deet, kɛɛl kɛ muc bɛɛlkiɛn, kɛ kɔaaŋkiɛn, kä tho̱p nikɛ wi̱i̱ yi̱kä luaak Kuɔthdu min te kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɔ guici gɔaa ɔ yɛnɛ gaatmuɔɔr ɛn ɣöö derɛ la̱t kɛ duɔth cikä min bo̱r kɛnɛ da̱a̱p, lätni jɛ ce̱tkɛ min go̱o̱r Kuothdu jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kuak tin ca ka̱m ji̱ kɛ kui̱ la̱t rɛy luaak Kuɔthdu, bikɛ wä la̱th nhiam Kuɔthdu kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɔ go̱o̱r luak Kuɔthdu jɛ mɔ, kä tin go̱o̱ri dee te thi̱n, deri jɛ ka̱n rɛy yio̱o̱ni kua̱r.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ɣän kuäär ni Är-tɛ̈k-cɛ̈th-tɛ cä lar ɛn ɣöö gua̱th yio̱o̱ni diaal wi̱i̱ni Kuec Kiɛɛr Yu-pɛ-ree-tidh, mɔ bi Ɛdhra bo̱o̱th palä, kä ŋi̱i̱c ŋuɔ̱tni Kuɔth puɔ̱rä jɛ thiec kä yɛ mɔ, la̱tdɛ jɛ ni tiitdä, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.21",
            "verseOrgIds": [
              "EZR.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "amäni pek cikä min bo̱r mi tekɛ ki̱luni ti bathdɔɔri diɔ̱k wi̱cdɛ kur ŋuaan, kɛ nup mi tekɛ ki̱luni ti bathdɔɔri wäl, kɛ kɔaŋ mi tekɛ li̱teeri ti bathdɔɔri rɛw, kɛ liɛɛth mi tekɛ buɔ̱li ti bathdɔɔri rɛw, kɛ milɛ mi di̱i̱t mi ro̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɔ ca larɛ Kuoth puɔ̱rä mɔ, a jɛ la̱tkɛ kɛɛliw kɛ kui̱ luaak Kuɔth puɔ̱rä, kiɛ bi ŋɛ̈ɛ̈ny Kuɔth ben kä kuäär kɛnɛ gaatkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.23",
            "verseOrgIds": [
              "EZR.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋa̱cɛ jɛ bä ɛn ɣöö /cia tho̱lbo̱k kɛ karaam bi go̱r kä bööth palä kɛ ji̱ Lii-bay, kɛ këët din kɛ ga̱a̱ŋ thuɔk luaak Kuɔth kɛnɛ la̱a̱t rɛydɛ, kiɛ la̱a̱t luaak Kuɔth tin kɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        }
      ]
    },
