              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ramɔ /ci ŋuɔ̱t Kuɔth kɛnɛ ruac kua̱r bi luɔ̱th ɔ, a jɛ kuɔ̱mkɛ agɔaa, kɛ lia̱a̱, kiɛ kɛ tukdɛ, kiɛ kɛ käni kuak nikɛ, kiɛ kɛ yiendɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
