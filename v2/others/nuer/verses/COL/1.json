      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ ɣän Puɔl in la jak Kritho Yecu kɛ ruac Kuɔth kɔnɛ Ti-mo-thi dämandan.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A puɔ̱th kɛnɛ mal in bä kä Kuoth in la Gua̱a̱ra tekɛ ji̱ Kuɔth ti ca lɛy kɛnɛ dämanikɔn rɛy ŋäthä kɛ Kritho kä Ko-lɔ-thi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pal lärä tɛthä lɔaac",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɔ palkɔ mɔ kɛ kui̱dun la nɛy Kuoth in la Gua̱n Kua̱ran ni Kritho Yecu a lär tɛ̈th lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cakɔ ŋa̱thdun kɛ Kritho Yecu liŋ, kɛnɛ nhök in nhɔk yɛn ɛ ji̱ Kuɔth diaal tin ca lɛy. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn ŋa̱th ɛmɔ min bä kä ŋa̱th min ŋäc yɛnɛ ca tɔ̱w kɛ kui̱dun nhial. Kä cia jɛn ŋa̱th ɛmɔ liŋ kɛ nhiam rɛy ri̱tdä min thuɔ̱k, min la thuk ti gɔw ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "min ci ben kä yɛ. Kä ce̱tkɛ min kuiirɛ dɛy kä pithɛ rɛy ɣɔaa kɛɛliw, kɛ jɛn duɔ̱ɔ̱p ɛmɔ kuiirɛ dɛy rɛydun nikɛ cäŋ ëë cia liŋ ni jɛ, kɛ thuɔ̱k cia thuɔ̱k Kuɔth ŋa̱c. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci yɛn ɛ jek kä Ɛ-pa-rath, läät in nhɔk kɔn ɛ. Jɛn ɛ la̱t Kritho mi ŋa̱thkɛ kɛ kui̱dan. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cɛ nhökdun rɛy Yieekä nyuɔ̱th kɔ.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ kɛ cäŋ ëë liɛŋkɔ nɔmɔ, /ka̱nkɔ pal ka̱p cuɔ̱ŋ kɛ kui̱dun. Thiëckɔ kɛ ɣöö dee yɛn thia̱a̱ŋ kɛ ŋäc kɛ min go̱o̱r Kuoth ɛ rɛy pɛlä yieekä kɛnɛ ŋäc ŋɔaani. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.9",
            "verseOrgIds": [
              "COL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bi yɛn tëk kɛ tëk mi ro̱ŋ kɛ Kuäär ni Yecu kɛ dup diaal. Kä bia dɛy kuir rɛy lätni diaal ti gɔw, kä bia piith rɛy ŋäcä Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
              "COL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A yɛ ba jakä bum kɛ buɔ̱m kɛɛliw, min bëë kä buɔ̱mdɛ min diit kɛ ruɔ̱t kä ti diaal kɛ biɛt kɛ tɛ̈th lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "La̱rɛ Gua̱a̱ra min ci kɔn cɔl, kɛ ɣöö bi kɔn tekɛ kui̱c kä ti diaal tin cɛ rialikä kɛ kui̱ nɛɛnikɛ tɛth lɔaac rɛy buɔyä. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.12",
            "verseOrgIds": [
              "COL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn cɛ kɔn kän kä buɔ̱m muɔ̱th, kä cɛ kɔn naŋ rɛy kuäärä Gatädɛ min nhɔkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.13",
            "verseOrgIds": [
              "COL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn min ca kɔn luɛl kɛ jɛ kä ca päl dueerkɔn.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puɔ̱ny Kritho kɛnɛ lätkɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cät Kuɔth mi /ca nɛn, ɛ jɛn gat in kɛ̱̈ɛ̱̈ kä ŋɔaani diaal tin ca cak, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö rɛydɛ ca ŋɔaani diaal cak kɛ jɛ, tin te nhial kɛnɛ wi̱c muɔ̱ɔ̱n, tin nɛ̈nkɛ kɛnɛ tin /ca nɛn, kuääri kiɛ bööth kiɛ kua̱r, kiɛ ruëëc, ca ŋɔaani diaal cak kɛ jɛ kɛnɛ kui̱dɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.16",
            "verseOrgIds": [
              "COL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn tëë thi̱n kä ti diaal kɛ nhiam, kä jɛn käpɛ ŋɔaani diaal kɛɛl kɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.17",
            "verseOrgIds": [
              "COL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn la wi̱c pua̱a̱ny in la duel Kuɔth, ɛ jɛn tuk kä ɛ jɛn min nhiam in kɔn ben raar li̱th, kä ɛ jɛn tekɛ gua̱a̱th in di̱t ni jɛn kä ŋɔak diaal ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth ɛ nhɔk ɛn ɣöö bɛ cieŋ rɛy Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.19",
            "verseOrgIds": [
              "COL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ Yecu cu Kuoth ti diaal luɔc maar kɛ rɔ, wi̱i̱ muɔ̱ɔ̱n kiɛ nhial. Kä cu Kuoth mal la̱t kɛ riɛm Yecu wi̱c jiaath in ri̱ew.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëëdan na̱ŋ yɛn kɛ Kuoth kä kɛ yɛn ji̱ tɛ̈rɛ rɛy cärädun, kä la̱tdɛ lät ti jiäk, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.21",
            "verseOrgIds": [
              "COL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä täämɛ cɛ yɛ luɔ̱c maarä kɛ puɔ̱nydɛ pa̱ny kɛ lia̱a̱dɛ, kɛ ɣöö bɛ yɛ naŋ nhiam Kuɔth a cia rɔ̱ rɛl, a thil bɛ̈l, kä /ca yɛ dee cäkikä. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.22",
            "verseOrgIds": [
              "COL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi nɔmɔ tuɔɔk mi wä yɛn kɛ wä nhiam, kä buɔ̱mɛ kä ta̱yɛ rɛy ŋäthä. /Cuarɛ rɔ woc ŋäthä min ca lar ɛ thuk ti gɔw tin cia liŋ, kä ca la̱t ji̱ piɛny diaal, kä ɣän, Puɔl, cua kɛ lat kɛn thuk ti̱ti̱.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "La̱t Puɔl ala läät duëël Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ɣän tɛth lɔcdä kɛ ɣöö ruɔ̱ɔ̱tdä ti bɛ̈c bɛ̈ɛ̈c kɛ kui̱dun, kä ruɔ̱ɔ̱tdä kɛ rɛy ri̱eŋdä, kɛn tin ci duɔth kä rik Kritho, tin te thi̱n kɛ kui̱ pua̱nydɛ min la duel Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.24",
            "verseOrgIds": [
              "COL.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ɣän cua läät duëël Kuɔth ce̱tnikɛ min ci Kuoth ɛ ka̱m ɣä kɛ kui̱dun, kɛ ɣöö bä ruac Kuɔth jakä ŋa̱ckɛ kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "COL 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ ruac mi cuäŋ naath mi ca tɛ̱̈ɛ̱̈ kɛ run tëë kɔn kɛnɛ ri̱c ti ŋuan, kä täämɛ ca jɛ nyuɔ̱th nɛy tin ci Kuɔth kɛ lɛy. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.26",
            "verseOrgIds": [
              "COL.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "COL 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ca̱r Kuɔth ɛ ɣöö bɛ tɛ̱̈ɛ̱̈dɛ nyuɔ̱th nɛɛkɛ, jɛn ruac ti̱lä mɛ cuääŋ naath ɛ min cɛ rialikä kɛ kui̱ nɛɛni diaal. Kä ruac ɛ cuääŋ naath ɔ ɛ ɣöö te Kritho rɛydun, min lot ni ɣöö bia tekɛ nyuaak rɛy buɔyä Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.27",
            "verseOrgIds": [
              "COL.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "COL 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn min lat kɔnɛ, kä lueek kɔn nɛy diaal, kä ŋi̱i̱c kɔn nɛy diaal rɛy pɛlä ruac Kuɔth kɛɛliw, kɛ ɣöö dënɛ nɛy diaal nöŋ Kritho a cikɛ di̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.28",
            "verseOrgIds": [
              "COL.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "COL 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bä nɛmɛ la̱t, cä lät kä cä kueer kɛ buɔ̱m in di̱i̱t in cɛ ka̱m ɣä min lät rɛydä.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.29",
            "verseOrgIds": [
              "COL.1.29"
            ]
          }
        }
      ]
    }
