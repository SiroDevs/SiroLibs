    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luk Kuɔth kɛ döör tin kɔ̱ŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ ni̱ni tɔ̱tɔ̱, ɛn guäth ɔ, mi wa Juda kɛnɛ Jɛ-ru-tha-lɛm wä luɔ̱c buɔ̱mdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä döör diaal duɔl wi̱i̱ lo̱o̱lä mi cɔali Yɛ-ɣo-ca-pat",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:2",
              "type": "text"
            },
            {
              "text": "Yɛ-ɣo-ca-pat",
              "type": "text"
            },
            {
              "text": "Kɛ thok ji̱ Ɣi-bɛ-ru luɔtdɛ ɣöö Kuoth lukɛ naath.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kɛ ɣöö bäkɛ wä luk thi̱n. Kɛ kui̱ kä tin diaal tin ca lät kä nɛɛkä ni ji̱ I-thɛ-rɛl. Inɔ cikɛ kɛ riaw rɛy nɛɛni kɔ̱kiɛn, kä cikɛ mundä da̱a̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yor kɛn gaakni kɛ kui̱ nɛɛnikä, kɔakɛ dhɔɔl kɛnɛ nyier ala ja̱a̱ŋ, kɛ ɣöö ba yio̱w ben kɔk ni leer kɛnɛ kɔaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“A ku yɛn a ŋu kä ɣä, yɛn ji̱ Dhor kɛ yɛn ji̱ Dhi-don kɛ yɛn ji̱ Pi-li-thɛt diaal? Go̱o̱r yɛnɛ i̱ bia ɣä cuɔ̱l mi cä la̱t? Kä mi ɛ jɛn inɔ, mi wä yɛn ɣä cuɔ̱l duɔ̱ɔ̱r, niɛ täämɛ kɛ pɛ̈th bä lät jiäknikun tin cia la̱t cuɔ̱l yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.4",
            "verseOrgIds": [
              "JOL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö cia til ciɛkdä min bo̱r kɛnɛ dääpdä ka̱n, kä cia gɔɔy ti̱lädä naŋ rɛy lueeknikun. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ci yɛn ji̱ Juda kɛn ji̱ Jɛ-ru-tha-lɛm kök ji̱ Gɛ-rith cia kɛ nɔ̱a̱n kɛ dho̱rkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.6",
            "verseOrgIds": [
              "JOL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛ̈nɛ jɛ ɛn täämɛ ɣän bäkɛ wä jiɛc gua̱thni tin cia kɛ wä kɔak thi̱n, kä bä lätkun luɔc ni wi̱i̱dun. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.7",
            "verseOrgIds": [
              "JOL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bä gaatkun kɛnɛ nyieekun kök gaat Juda, kä bikɛn kɛ lɛ wä kök ji̱ Cɛba, nɛy ti nɔ̱a̱n ɛlɔ̱ŋ, ɛ jɛn ruacdä ɣän Kuɔth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.8",
            "verseOrgIds": [
              "JOL.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puɔ̱th Kuɔth kɛ nɛɛkɛ",
          "type": "text"
        }
      ]
    }
  ],
