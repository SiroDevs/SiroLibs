  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2CH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Thɔ-lo-mon lät diaal tëë lätdɛ rɛy luaak Kuɔth thuk, cuɛ tëë diaal te ci gua̱n ni Dee-bid kɛ lɛy nööŋ rɛy luaak. Cuɛ ciɛk in bo̱r kɛ da̱a̱p kɛ kuak diaal ben tɔ̱w duëël tɔ̱ɔ̱wä rɛy luaak Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "No̱o̱ŋ thandukä matdä Ruac rɛy luaak Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔ-lo-mon bööth thuk duëli diaal kɛ ruëëc I-thɛ-rɛl ciööl kä Jɛ-ru-tha-lɛm kɛ ɣöö ba thanduk matdä ruac Kuɔth wä nööŋ kä Dha-yɔn wec Dee-bid. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ I-thɛ-rɛl diaal rɔ̱ dol nhiam Kua̱r kɛ gua̱a̱th ti̱mä kɛ bärɔw päthni (pay yietni). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci bööth I-thɛ-rɛl diaal cop, cu ji̱ Lii-bay thanduk matdä ruac Kuɔth ka̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ thanduk matdä ruac Kuɔth nööŋ kɛnɛ kɛmɛ Kuɔth Nhial kɛ kuak diaal tin rɛl gɔɔydiɛn rɔ tëë te rɛy kɛmɛkä. Cu bööth palä kɛnɛ ji̱ Lii-bay kɛ nööŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ni Thɔ-lo-mon kɛnɛ duɔl ji̱ I-thɛ-rɛl diaal tin ci mat nhiamdɛ, wä nhiam thandukä matdä ruac Kuɔth, thöpkɛ muc deet kɛnɛ thääk ti ŋuan ti /ca dëë luäŋ kɛ kuën. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu bööth palä thanduk matdä ruac Kuɔth nööŋ guäthdɛ, rɛy duëël rɛci guäth in rɛl gɔɔydɛ rɔ piny gɔ̱ɔ̱k pua̱nyni tin ce̱tkɛ pua̱ny ja̱a̱kni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ci kɛn pua̱ny tin ce̱tkɛ pua̱ny jaakni gɔ̱kiɛn ɣär nhial guäth thandukä matdä ruac Kuɔth, ci gɔ̱kiɛn thanduk kum kɛnɛ jiɛn tin kapkɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn jiɛn tɔ̱tɔ̱ bärkɛ ala kɛ a nɛnkɛ a /keni ni wä rɛy duëël in rɛl gɔɔydɛ rɔ, duundɛ ɣöö /cakɛ dëë nɛn raar. Kɛn a thi̱n amäni walɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thilɛ mi te rɛy thandukä matdä ruac Kuɔth, ɛ ni pääm da̱ŋ rɛw tin pat paat tëë läth Muthɛ kɛ thi̱n pääm Thi-nay, guäth ëë lät Kuoth Nhial mat ruac thi̱n kɛnɛ ji̱ I-thɛ-rɛl, mëë bäkɛ raar muun I-jëp.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gɔɔy Kuɔth Nhial",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci bööth palä ben raar guäth in rɛl gɔɔydɛ rɔ (kɛ ɣöö kɛn bööth diaal tin ci wä rɛc ca rɔ lɛy, a thil ɣöö tekɛ bua̱a̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ji̱ Lii-bay diaal tin këët din, A-thap kɛnɛ Ɣe-man kɛ Yɛ-du-thun kɛ gaatkiɛn kɛ ji̱ maarädiɛn, ca rɔ̱ car bëëri kui̱ cuëëc ca̱ŋ yi̱kä kɛ thuɔmni kɛɛl kɛ bööth palä ti kuɔ̱r wi̱cdɛ jiɛn da̱ŋ rɛw ti kuɔthkɛ kaaŋni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kuɔ̱ɔ̱th kaaŋni kɛ këët din rɔ̱ mat, puanykɛ Kuɔth Nhial kɛ diit tɛthkä lɔaac) min cikɛ mat, cukɛ Kuoth Nhial puany wäkɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu buay Kuɔth Nhial luak thiaŋ ce̱tkɛ pua̱r, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "a cäŋɛ bööth palä /ca la̱tdiɛn dëë la̱t, kɛ kui̱, kä ɣöö ci buay Kuɔth Nhial luak thiäŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
      ]
    }
  ],
