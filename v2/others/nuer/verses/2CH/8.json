    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lät Thɔ-lo-mon tin kɔ̱ŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k runi ti jiɛn da̱ŋ rɛw, tëë tääth Thɔ-lo-mon luak Kuɔth kɛnɛ duelɛ thi̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu Thɔ-lo-mon wi̱i̱ tëë ca ka̱m jɛ ɛ Ɣu-ram nyɔk kɛ ta̱th, kä cuɛ ji̱ I-thɛ-rɛl jak kä cieŋ thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wec Ä-math-dho-baa käp. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.3",
            "verseOrgIds": [
              "2CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wec Tad-mor täth rɛy dɔaar, kä cuɛ wi̱i̱ tɔ̱ɔ̱wä täth kä Ɣä-math. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ piny wec Beth-o-ron täth, ala wi̱i̱ ti buɔ̱m buɔ̱ɔ̱m ti te thiekni kɛ do̱o̱pni, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.5",
            "verseOrgIds": [
              "2CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Bää-lath kɛnɛ wi̱i̱ tɔ̱ɔ̱wä, kɛ wi̱i̱ thurbiɛɛlikɛ kɛ wi̱i̱ ji̱ jiöŋköörikɛ nikɛ tin diaal tëë go̱o̱rɛ ta̱thdiɛn kä Jɛ-ru-tha-lɛm, kɛnɛ Lɛ-ba-nɔn kɛ gua̱th diaal tëë ruaacɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nɛy diaal tëë ci duɔth kä ji̱ ɣɛ̈th kɛnɛ ji̱ Ɛ-mor kɛ ji̱ Pɛ-rii-dhi kɛnɛ ji̱ Iwi kɛ ji̱ Yɛ-buth, tëë /ci tɔ̱a̱ ji̱ I-thɛ-rɛl, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "tëë ci karkiɛn duɔth muun tëë /ken ji̱ I-thɛ-rɛl kɛ näk, cu Thɔ-lo-mon kɛ jak kä kuaany kɛ buɔ̱m, amäni walɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö /kenɛ ji̱ I-thɛ-rɛl jak kä kuaanykɛ. Cuɛ jak nikɛ kä rɛmdɛ, kɛnɛ ji̱ kɔaarɛ, kä bööth rɛ̈m kɛ thurbiɛɛlikɛ kɛnɛ jiöŋköörikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.9",
            "verseOrgIds": [
              "2CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu bööth ji̱ kɔaar kua̱r ni Thɔ-lo-mon a nɛy ti kur rɛw wi̱cdɛ jiɛn dhieec tin ruackɛ naath.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔ-lo-mon ciekdɛ nya kua̱r I-jëp ɣo̱th wi̱c Dee-bid, kä cuɛ jɛ naŋ duëël in cɛ lät kä jɛ, kɛ ɣöö cɛ wee, “/Ci ciekdä bi cieŋ duëël kua̱r I-thɛ-rɛl ni Dee-bid, kɛ ɣöö gua̱a̱th mi ci thanduk matdä ruac Kuɔth Nhial te thi̱n rɛl gɔɔydɛ rɔ.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔ-lo-mon muc tin waŋkɛ thöp Kuoth Nhial wi̱i̱ yi̱kä min cɛ täth thok luaak Kuɔth, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ce̱tnikɛ pëk mucni mëë ca lar ɛ Muthɛ kɛ cäŋ lɔ̱ŋä kɛnɛ tëth path kɛ nin ti̱mä da̱ŋ diɔ̱k tin la la̱tkɛ, mi̱eth in thil thuɔp kɛ cäŋ ti̱mä juɔkni kɛ cäŋ ti̱mä luaak Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ guɔ̱ɔ̱r ni ŋuɔ̱t gua̱n ni Dee-bid, cuɛ bööth palä rialikä kɛ kui̱ lätnikiɛn, kɛ ji̱ Lii-bay kɛ ɣöö bikɛ ki̱et kä ba bööth palä luäk ce̱tkɛ lät tin görkɛ ni ciaŋ. Kä cuɛ ga̱a̱ŋ thuɔk luaak rialikä ce̱tnikɛ pëk thukni luaak, ce̱tnikɛ mëë ci Dee-bid raan Kuɔth ɛ lar. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ thil ram mi wä gekä kä bööth palä kɛnɛ ji̱ Lii-bay kä tin diaal tin ci kuäär kɛ lar amäni gua̱th tɔ̱ɔ̱wni yio̱o̱ni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu lät Thɔ-lo-mon diaal thuɔ̱k agɔaa, nikɛ cäŋ ëë tuɔkɛ yiɛth luaak Kuɔth Nhial piny cu mäni cäŋ ëë thuk kɛ jɛ. Inɔ cu luaak Kuɔth Nhial thuɔ̱k.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔ-lo-mon wä wi̱c Ɛ-dhon-ga-bɛr kɛnɛ wec E-loth kɛ baŋ yiëër muun Ɛ-dɔm. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɣu-ram ɛ jäk kä babuur naŋkɛ jɛ ɛ ji̱ kɔaarɛ nɛy ti ŋa̱ckɛ rɛy yiëër. Kä cukɛ wä kä O-për kɛɛl kɛ ji̱ kɔaar Thɔ-lo-mon, kä cukɛ da̱a̱p mi tëë ki̱luni ti lɛ̱̈nykɛ ki̱luni ti bathdɔɔri da̱ŋ wäl dhieec. Kä cukɛ jɛ nöŋ Kuäär ni Thɔ-lo-mon.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
  ],
