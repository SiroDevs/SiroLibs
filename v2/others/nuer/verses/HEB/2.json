    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ka̱n mi di̱i̱t",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ banɛ tekɛ tiit mi di̱i̱t kɛ min canɛ liŋ, kɛ ɣöö canɛ bi lɛ bath thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
              "HEB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ruac in ca lat ɛ ja̱a̱k a thuɔ̱k, kä ram mi /ci jɛ guur kä /cɛ jɛ luth bɛ duäc mi ro̱ŋ kɛ jɛ jek. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä banɛ kulɛ kään thi̱n i̱di, mi /ci kɔn ka̱n ɛ di̱i̱t ɛmɛ tit? Kɛ nhiam ca jɛ la̱r kɔn ɛ Kuäär puɔnydɛ, kä ca jɛ la̱t kɔn a gɔaa ɛ nɛy tëë ca jɛ liŋ ɛn ɣöö ɛ thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
            "verseOrgIds": [
              "HEB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ci Kuoth nëndɛ mat thi̱n bä kɛ nyuuthni kɛnɛ ti ga̱ykɛ naath, amäni muc Yieekä in Gɔaa Rɛl Rɔ, tin cɛ da̱a̱k ce̱tkɛ min go̱o̱rɛ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ram in nyuth kɔn ɣöö dënɛ kään i̱di",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö /ken Kuoth ja̱a̱k ka̱m kuäär ɣɔaa in bi ben, jɛn ɣɔw in ruac kɔn kɛ kui̱dɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.5",
            "verseOrgIds": [
              "HEB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëë kɛ gua̱a̱th mi ca gɔ̱r thi̱n kä ruac Kuɔth i̱,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:6-8",
              "type": "text"
            },
            {
              "text": "Diit 8:4-6.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.9",
            "verseOrgIds": [
              "HEB.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ro̱ŋɛ kä Kuoth in cak ti diaal kä tëk ti diaal kɛ jɛ, bɛ Yecu lɛy kɛ ruɔ̱tdɛ kɛ ti bɛ̈c bɛ̈ɛ̈c kɛ ɣöö bɛ gaat ti ŋuan nööŋ rɛy nyuaakä buɔyädɛ. Kɛ ɣöö ɛ Yecu bo̱thkɛ känä mɔ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.10",
            "verseOrgIds": [
              "HEB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.10",
            "verseOrgIds": [
              "HEB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ɛn ram min jak naath kä lɛ̈y lɛ̈ɛ̈y kɛnɛ nɛy tin cɛ lɛy, Gua̱ndiɛn ɛ kɛl. Kɛ kui̱c ɛmɔ Yecu /cɛ po̱c kɛ ɣöö bɛ kɛ cɔl i̱ gaatmani. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.11",
            "verseOrgIds": [
              "HEB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ Kuoth jiök i̱,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:12",
              "type": "text"
            },
            {
              "text": "Diit 22:22.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ɣöö te gaat kɛ ri̱ŋ kɛnɛ riɛm, jɛn Yecu bä tëëkɛ puɔ̱ny mi ce̱tkɛ puɔ̱nydiɛn, kɛ ɣöö kɛ lia̱a̱dɛ derɛ ram in tekɛ buɔ̱m li̱eth min la gua̱n jiäkni däk. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.14",
            "verseOrgIds": [
              "HEB.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ nɛy diaal tin la kuaany kɛ pek teekädiɛn kɛɛliw kɛ dual li̱eth lony. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.15",
            "verseOrgIds": [
              "HEB.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cɛ jɔɔc ɛn ɣöö /cɛ bä kɛ ɣöö bɛ ben luäk ni ja̱a̱k, bëë kɛ ɣöö bɛ kuay A-bɛ-ram ben luäk. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.16",
            "verseOrgIds": [
              "HEB.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ ca jɛ pa̱a̱r kɛ gaatmani kä ti diaal, kɛ ɣöö bɛ la raandiɛn mi ŋa̱thkɛ kä kɔ̱c lɔc mi bo̱o̱th palädiɛn in di̱i̱t mi lät Kuoth ikä, kɛ ɣöö bɛ bɛ nath luɛl dueeri. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.17",
            "verseOrgIds": [
              "HEB.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ɣöö jɛn puɔ̱nydɛ ca jɛ ɣɔ̱n kɛ ti bɛ̈c bɛ̈ɛ̈c, tëëkɛ lua̱ŋ kɛ luäk nɛɛni tin ca ɣɔ̱n.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.18",
            "verseOrgIds": [
              "HEB.2.18"
            ]
          }
        }
      ]
    }
