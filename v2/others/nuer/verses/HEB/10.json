              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ /cuarɛ ŋa̱thdun päl, kɛ ɣöö tëëkɛ muc mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
