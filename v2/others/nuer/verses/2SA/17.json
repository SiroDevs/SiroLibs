        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.26",
            "verseOrgIds": [
              "2SA.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min ci Dee-bid ben kä Ma-na-yim, cu Cobi gat Na-ɣac kä Rɛ̈-baa wec ji̱ Am-on, kɛnɛ Ma-kir gat A-mi-el kä Lo-da-bar, kɛnɛ Bar-dhë-lay wi̱i̱ Gil-yad kä Ro-gɛ-lim. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.27",
            "verseOrgIds": [
              "2SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ dha̱a̱ŋni, kɛ cuɔ̱ɔ̱k, kɛ tok, kɛ kuan, kɛ muany bɛɛl, kɛ ŋɔa̱a̱r ti ca bul, kɛ nup, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.28",
            "verseOrgIds": [
              "2SA.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ tuaar, kɛ cak, kɛ det nööŋ kɛ kui̱ Dee-bid kɛnɛ nɛɛkɛ. Kɛ ɣöö laar kɛnɛ i̱, “Ci naath buɔth kɛ näk kɛnɛ rɛw rɛy dɔaar.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.29",
            "verseOrgIds": [
              "2SA.17.29"
            ]
          }
        }
      ]
