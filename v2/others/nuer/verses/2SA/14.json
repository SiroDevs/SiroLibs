          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Go̱r Yo-ab kɛ luny Ɛ̈b-ca-lom jɔk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu Yo-ab gat Dhɛ-ru-yaa ɛ ŋa̱c ɛn ɣöö go̱r lɔc kua̱r Ɛ̈b-ca-lom. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.1",
            "verseOrgIds": [
              "2SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ab raan jäk kä Tɛ-kowa, cua ciek mi pɛl pɛl wä nööŋ thi̱n, kä cuɛ ben jiök i̱, “Lɛl rɔ ala ram mi pär, moc rɔ bieyni pärä. Cu puɔ̱nydu yi̱r, teni kɛ ta̱a̱ ciek mi tekɛ ni̱n pärä raan mi ci li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.2",
            "verseOrgIds": [
              "2SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä wër kä kuäär, bi ti̱ti̱ wä la̱t jɛ.” Kä cu Yo-ab ɛ la̱t ruaac.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci ciek Tɛ-kowa ben kä kuäär, cuɛ rɔ goŋ luthä, kä cuɛ wee i̱, “Aɣ kuäär luäkä.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.4",
            "verseOrgIds": [
              "2SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ɛ jiök i̱, “Riɛkdu ɛŋu?” Kä cuɛ loc i̱, “Ɛ ɣän ciek jɔkä mi can, ci cɔwdä li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.5",
            "verseOrgIds": [
              "2SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän ta̱a̱ kɛ gaat da̱ŋ rɛw, kä cikɛ gaak kä rɔ̱ rɛy ka̱a̱ni. Kä thilɛ ram mi reeckɛ, cɛ ŋɔ̱a̱ŋ ci kɛl min dɔ̱ŋ näk. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.6",
            "verseOrgIds": [
              "2SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ ci cieŋ kɛɛliw rɔ̱ luɔ̱c ɣä, wä kɛ i̱, ‘Käm ni nɛy ram in ci däman näk, kɛ ɣöö ba̱kɔ ben näk kɛ kui̱ däman in cɛ näk.’ Inɔ ba jɛ näk bä. Bikɛ ɣä cu päl a thil gat, bɛ cu thil mi kɛk ciöt cɔadä wi̱i̱ muɔn.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.7",
            "verseOrgIds": [
              "2SA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.7",
            "verseOrgIds": [
              "2SA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ciek jiök i̱, “Wër dhɔru, bä ruac lɔ̱ lat kɛ kui̱du.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.8",
            "verseOrgIds": [
              "2SA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ciek Tɛ-kowa wee i̱, “Kuäärä ɛ bɛ̈ɛ̈l tekɛ ɣä kɛnɛ dhɔr gua̱a̱r. Kä ɛ kuäär kɛnɛ kɔmdɛ thil bɛ̈ɛ̈l.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.9",
            "verseOrgIds": [
              "2SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär wee i̱, “Mi wëë tekɛ ram mi ruac kɛ ji̱ nöŋ ni jɛ ɣä, kä /cɛ ji̱ bi nyɔk kɛ gueer.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.10",
            "verseOrgIds": [
              "2SA.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wee i̱, “Ɛ kuäär pal Kuoth Nhial Kuothdɛ, ɛ ram mi ca näk /ca lɛ col, kä ɛ gatdä /ca lɛ näk.” Kä cu kuäär wee i̱, “Ce̱tnikɛ ciöt Kuɔth Nhial in tëk, thilɛ miem kɛl kä gatdu mi bi pɛn piny.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ciek wee i̱, “A ji̱ la̱rä riet kɛl ɛmɛ kuäärä.” Kä cuɛ wee i̱, “Ruacni”. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.12",
            "verseOrgIds": [
              "2SA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ciek wee i̱, “Ɛŋu lätdi nɛɛ Kuɔth kä mi jiäkɔ? Ɛŋu ci gatdu nho̱k ɣöö lunyɛ cieŋ ro̱o̱l juri mɔ, kä ci ku lɛ lam ni rɔɔdu mɔ kɛ ruac in payi lat. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.13",
            "verseOrgIds": [
              "2SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banɛ li̱w kɔn diaal, ce̱t kɔn kɛ pi̱ ti ca wuɔc piny, tin /ca dëë nyɔk kɛ ruɔ̱l. Kä duundɛ ɣöö /ci Kuoth tëk a woc. La carɛ ni duɔ̱p kɛ ɣöö bɛ ram in na̱n nööŋ kutdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.14",
            "verseOrgIds": [
              "2SA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ba̱a̱ ruac ɛ mi ben la̱t kuäärä kɛ ɣöö ci naath ɣä jak kä dual. Kä ca car i̱, ‘Bä ben ruac kɛ kuäär. Kɛ ɣöö dɔ̱ŋ bi min cä thiec la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.15",
            "verseOrgIds": [
              "2SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛnɛ ɣöö bi kuäär ɛ liŋ, a bɛ ɣä kän tetni nɛɛni ti̱n görkɛ näkdä kɔnɛ gatdä wi̱i̱ muɔ̱ɔ̱n in ci Kuoth ɛ ka̱m nɛɛkɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.16",
            "verseOrgIds": [
              "2SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ jɛ car i̱, ‘Bi riet kua̱rä ɣä jak kä ka̱nä.’ Kɛ ɣöö kuäärä ce̱tdɛ kɛ jääk Kuɔth dääkɛ mi gɔaa kɛnɛ mi jiääk. Ɛ Kuoth Nhial Kuothdu tekɛ ji̱ kɛɛl!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ciek loc i̱, “Cu ɣä tëë kä duɔ̱ɔ̱r mi wa̱a̱ thiec kä ji̱.” Kä cu ciek wee i̱, “Ruacni kuäärä.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär wee i̱, “Kɛn ti diaal ti̱ti̱ te Yo-ab thi̱n?” Kä cu ciek ɛ loc i̱, “Ɛ thuɔ̱k ce̱tkɛ mɔ tëki mɔ kuäärä, thilɛ ram mi dëë ŋɔ̱a̱ŋ kä tin diaal tin ci lat kuäär. Ɛ Yo-ab raan kɔaru lät ɣä min bä lat ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bä ruac lat ɛ Yo-ab lärɛ ɣä mɔ. Kä duundɛ ɣöö kuäärä tëë kɛ ŋäc mi ce̱tkɛ ŋäc jääkä Kuɔth kä ŋäcɛ tin diaal tin tuɔ̱k wi̱i̱ muɔ̱n.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär Yo-ab jiök i̱, “Nɛnɛ, täämɛ cä nhɔk. Wër nööni Ɛ̈b-ca-lom jɔk.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.21",
            "verseOrgIds": [
              "2SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ab rɔ goŋ luthä, kä cuɛ kuäär poth. Kä cu Yo-ab wee i̱, “Ɛn walɛ cä ŋa̱c ɛn ɣöö cä nho̱k jek waaŋdu, lö kuäärä, kɛ ɣöö ci thiecdä nhɔk.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.22",
            "verseOrgIds": [
              "2SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ab rɔ jiɛc cuɛ wä kä Gɛ-cur cuɛ Ɛ̈b-ca-lom wä nööŋ kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.23",
            "verseOrgIds": [
              "2SA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär wee i̱, “A jɛ cieŋ dhɔrɛ gekä. A jɛ /ci bä guäth ɛ ta̱a̱ thi̱n ɛ.” Inɔ cu Ɛ̈b-ca-lom cieŋ dhɔrɛ gekä, kä /kenɛ ben guäth in te kuäär thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Loc Ɛ̈b-ca-lom kɛnɛ Dee-bid maarä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ kä I-thɛ-rɛl kɛɛliw thilɛ ram mi dëë liak kɛ gɔɔydɛ ce̱tkɛ Ɛ̈b-ca-lom. Thilɛ jɛ diw a känɛ ni pät cio̱kdɛ amäni wi̱cdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.25",
            "verseOrgIds": [
              "2SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä la miem wecdɛ a ŋukɛ kä kɛɛl kɛ ruɔ̱n, kɛ ɣöö tekɛ miem ti ŋuan. La miem wecdɛ a tekɛ theem ni da̱ŋ rɛw kɛ theem kua̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.26",
            "verseOrgIds": [
              "2SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ tekɛ dhɔɔl diɔ̱k, kɛ nyam kɛl mi cɔali Ta-mar. Ɛ nyam mi gɔaa ɛlɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ɛ̈b-ca-lom cieŋ kɛ run da̱ŋ rɛw kä Jɛ-ru-tha-lɛm, a /cɛ bä kut kua̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.28",
            "verseOrgIds": [
              "2SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɛ̈b-ca-lom Yo-ab jäk kä raan, kɛ ɣöö bɛ jɛ ben jäk kä kuäär. Duundɛ ɣöö /ken Yo-ab ben kä jɛ. Kä cuɛ nyɔk kɛ jäk kä raan, duundɛ ɣöö /ken Yo-ab ben. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.29",
            "verseOrgIds": [
              "2SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɛ̈b-ca-lom kuaanykɛ jiök i̱, “Nɛ̈n ɛ jɛ. Kak Yo-ab thiekɛ kɛ kaakdä, kä cɛ do̱ny kɛ bɛl. Wiaa, waŋɛ jɛ.” Ɛ jɛn cukɛ wä, cua wä cua̱th kɛ mac. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.30",
            "verseOrgIds": [
              "2SA.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ab ben kä Ɛ̈b-ca-lom dhɔrɛ, kä cuɛ jɛ jiök i̱, “Ɛŋu ci ja̱a̱ŋku kaakdä cua̱thɔ kɛ mac?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.31",
            "verseOrgIds": [
              "2SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɛ̈b-ca-lom Yo-ab loc i̱, “Nɛn ɛ, ɣän cä ji̱ jäk kä raan i̱, ‘Ber dëë ji̱ ben jäk kä kuäär, dëë thiec i̱, “Ɛŋu mi bëë kɛ ɣä kä Gɛ-cur? Dëë gɔaa ni ɣöö dëë ŋot kɛ ciaŋ ɛn wi̱ni.” Kɛ kui̱c ɛmɔ täämɛ jak ni ɣä kä wä kut kua̱r. Kɛ ɣöö mi ta̱a̱ duer, a jɛ näk ɣä.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.32",
            "verseOrgIds": [
              "2SA.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ab wä kä kuäär, cuɛ wä la̱rɛ. Kä cuɛ Ɛ̈b-ca-lom cɔl. Kä cuɛ ben kä kuäär cuɛ rɔ goŋ nhiam kua̱r kɛ luth. Kä cu kuäär ɛ cim.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.33",
            "verseOrgIds": [
              "2SA.14.33"
            ]
          }
        }
      ]
    }
