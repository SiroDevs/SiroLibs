  "bookId": "2SA",
  "reference": "2 Tham 14",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
