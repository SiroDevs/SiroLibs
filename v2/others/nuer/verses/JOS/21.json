              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ inɔ. Cu Kuoth Nhial ro̱l ku ka̱m ji̱ I-thɛ-rɛl ni kɛɛliw nikɛ ruac ëë cɛ guɔ̱k gua̱ni i̱ bɛ jɛ ka̱m kɛ. Kä cu ji̱ I-thɛ-rɛl ɛ ka̱n kä cukɛ ciɛŋ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial kɛ jak kä nyuur malä nikɛ pëk ëë cɛ mua̱th gua̱ndɔɔŋnikiɛn. Kä cuɛ thil ram kɛl kä ji̱ tɛ̈riɛn diaal mi cu kɛ tiam kɛ ɣöö ci Kuoth Nhial ji̱ I-thɛ-rɛl ka̱m puɔ̱t ji̱ tɛ̈riɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ ruac kɛl kä ruaacni tëë ci Kuoth Nhial kɛ mat kɛ thok duëël I-thɛ-rɛl mi cu ŋuy piny baaŋ, kɛn diaal cukɛ wä ni gua̱thnikiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
    }
