            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mat rɛ̈kni ji̱ Lii-bay diaal tëë te rɛy nyinä ji̱ I-thɛ-rɛl kɛ rɛ̈k ti jiɛn ŋuaan wi̱cdiɛn rɛ̈k bädäk kɛɛl kɛ tɔ̱a̱rikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn rɛ̈k ti̱ti̱ diaal te rɛk ɔ kɛ gua̱a̱th la̱k ɣɔ̱ɔ̱kɛ mi guul ni jɔkdɛ kɛɛliw. Inɔ ɛ jɛn min te kɛn rɛ̈k diaal ɛn ro̱o̱l.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
