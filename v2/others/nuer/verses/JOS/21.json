    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rɛ̈k ciɛŋä ji̱ Lii-bay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ mëë ci kua̱r gua̱ni thukni duëli ji̱ Lii-bay ben kä Ɛl-a-dhar in la bo̱o̱th palä kɛnɛ Jɔ-cua gat Nun kɛ kua̱r gua̱ni dööri gan I-thɛ-rɛl, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.1",
            "verseOrgIds": [
              "JOS.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cukɛ ben ruac kɛ kɛ dhɔɔr in cɔal i̱ Cilo kä Kɛ-naan larkɛ jɛ i̱, “Ci Kuoth Nhial ɛ lar kɛ thok Muthɛ ɛn ɣöö ba kɔ moc rɛ̈k ti bakɔ cieŋ thi̱n, kɛnɛ gua̱th walkiɛn kɛ kui̱ ɣɔ̱ɔ̱kɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ cu gaat I-thɛ-rɛl ji̱ Lii-bay moc kä cukɛ rɛ̈k tɔ̱tɔ̱ ka̱m kɛ ni rɛ̈kni tin ca ŋuk kä kɛ pa̱ny kɛɛl nikɛ jio̱k rɛ̈kni tɔ̱tɔ̱.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.3",
            "verseOrgIds": [
              "JOS.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ inɔ, cu gaak ku pɛ̈ɛ̈n kɛ kui̱ thukni duëli ji̱ Kɛ-ɣath kä cu ji̱ Lii-bay diaal tëë tɔ̱ kuay Ä-ron in la bo̱o̱th palä rɛ̈kiɛn da̱ŋ wäl diɔ̱k ka̱n kɛ gaak kä do̱r Juda kɛnɛ do̱r Cim-on kɛ do̱r Ben-ya-min.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.4",
            "verseOrgIds": [
              "JOS.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.4",
            "verseOrgIds": [
              "JOS.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu tha̱a̱ŋ ji̱ Kɛ-ɣath tin ci duɔth kui̱cdiɛn lɛni je̱k bäkɛ gaak kä thuk duëli döör Ɛ-pa-rim kɛnɛ do̱r Daan kɛ tha̱a̱ŋ döör Ma-na-thɛ, cukɛ rɛ̈k wäl ka̱n kä kɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.5",
            "verseOrgIds": [
              "JOS.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ji̱ Ger-con kui̱cdiɛn je̱k bäkɛ gaak kä thuk duëli dööri Yi-tha-kar kɛ A-cɛr kɛ Nap-ta-li kɛnɛ tha̱a̱ŋ döör Ma-na-thɛ tin te kä Ba-can, cukɛ rɛ̈k wäl diɔ̱k je̱k kä kɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.6",
            "verseOrgIds": [
              "JOS.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.6",
            "verseOrgIds": [
              "JOS.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ji̱ Mɛ-ra-ri nikɛ pëk gɔalikiɛn rɛ̈k da̱ŋ wäl rɛw je̱k kä döör Rɛ-u-ben kɛ Gad kɛnɛ Dhɛ-bu-lun.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.7",
            "verseOrgIds": [
              "JOS.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.7",
            "verseOrgIds": [
              "JOS.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu gaat I-thɛ-rɛl rɛ̈k ti̱ti̱ nikɛ tɔ̱a̱rikiɛn kɛɛl thöp ji̱ Lii-bay kɛ gaak nikɛ ruac ëë ci Kuoth Nhial ɛ lat kɛ thok Muthɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.8",
            "verseOrgIds": [
              "JOS.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ rɛ̈k ti̱ti̱ ni ciöötnikiɛn thöp kɛ rɛy döör Juda kɛnɛ do̱r Cim-on, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.9",
            "verseOrgIds": [
              "JOS.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛn rɛ̈k tëë ci pɛn kä kuay Ä-ron, kä cieeŋ Kɛ-ɣath tëë tɔ̱ ji̱ Lii-bay. Kɛ kɛn nɛy tëë kɔaŋ moc kɛ nhiam. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.10",
            "verseOrgIds": [
              "JOS.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ kɛ moc Kir-yath-ar-bä min mɔ Ɣɛb-ron täämɛ kä tëë rɛy rööl päämni Juda, kɛɛl amäni pan wal diaal tin thie̱e̱k kɛ jɛ. Kä Ar-bä ɛmɔ ɛ jɛn gua̱n Ä-nak. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.11",
            "verseOrgIds": [
              "JOS.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min te ni jɛn thi̱n ca ciëëŋkɛ rɛ̈ɛ̈k ɛmɔ amäni ciëëŋkɛ diaal ka̱m Ka-leb gat Yɛ-pö-nɛ ala bo̱thdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.12",
            "verseOrgIds": [
              "JOS.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.12",
            "verseOrgIds": [
              "JOS.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cukɛ kuay Ä-ron in la bo̱o̱th palä ku ka̱m Ɣɛb-ron min la rɛk in bar gua̱n tho̱ŋä rɔ thi̱n, cuɛ kɛ mat amäni tɔ̱a̱rikɛ diaal, cua Lib-na ka̱m kɛ bä ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.13",
            "verseOrgIds": [
              "JOS.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ya-tir kɛnɛ Ɛc-tɛ-mo-ä ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.14",
            "verseOrgIds": [
              "JOS.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ O-lon kɛnɛ Dɛ-bir ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.15",
            "verseOrgIds": [
              "JOS.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ A-yin kɛnɛ Yuta kɛ Beth-cɛ-mɛc kɛnɛ tɔ̱a̱rikiɛn diaal, kɛn rɛ̈k da̱ŋ bäŋuan ti̱ti̱ rɛy dööri da̱ŋ rɛw tɔ̱tɔ̱. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.16",
            "verseOrgIds": [
              "JOS.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn rɛy döör Ben-ya-min cua kɛ ka̱m Gib-yon kɛ Gabä ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.17",
            "verseOrgIds": [
              "JOS.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ä-na-thoth kɛ Al-mon, rɛ̈k da̱ŋ ŋuaan kɛɛl amäni tɔ̱a̱rikiɛn diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.18",
            "verseOrgIds": [
              "JOS.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mat rɛ̈kni tëë ca ka̱m kuay Ä-ron in la bo̱o̱th palä kɛ rɛ̈k da̱ŋ wäl diɔ̱k kɛɛl amäni tɔ̱a̱rikiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.19",
            "verseOrgIds": [
              "JOS.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.19",
            "verseOrgIds": [
              "JOS.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cua duɔth thukni duëli gɔaal Kɛ-ɣath kä ji̱ Lii-bay tin kɔ̱ŋ yuɔ̱p rɛ̈k kä ro̱l ji̱ Ɛ-pa-rim. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.20",
            "verseOrgIds": [
              "JOS.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëë cua thöp kɛ kɛ rɛ̈k ŋuaan, Cɛ-kɛm in la rɛk kɛl kä rɛ̈k tin bar ji̱ tho̱ŋni rɔ̱ thi̱n kɛɛl amäni tɔ̱a̱rikɛ rɛy rööl päämni Ɛ-pa-rim, kɛ Gɛ-dhɛr ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.21",
            "verseOrgIds": [
              "JOS.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Kib-dha-yim kɛ Beth-o-ron, nikɛ tɔ̱a̱rikiɛn kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.22",
            "verseOrgIds": [
              "JOS.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä rɛy döör Dan, cua Ɛl-tɛ-ke kɛnɛ tɔ̱a̱rikɛ, kɛ Gi-bɛ-thon kɛnɛ tɔ̱a̱rikɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.23",
            "verseOrgIds": [
              "JOS.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ A-ya-lon kɛnɛ tɔ̱a̱rikɛ, kɛ Gɛ̈th-ri-mon kɛnɛ tɔ̱a̱rikɛ. Tɔ̱tɔ̱ kɛ rɛ̈k da̱ŋ ŋuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.24",
            "verseOrgIds": [
              "JOS.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä rɛy yupä döör Ma-na-thɛ cukɛ Ta-nak thöp kɛnɛ tɔ̱a̱rikɛ, kɛ Gɛ̈th-ri-mon kɛnɛ tɔ̱a̱rikɛ, rɛ̈k da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.25",
            "verseOrgIds": [
              "JOS.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn rɛ̈k diaal tëë ci wä kä duɔth thukni duëli gan Kɛ-ɣath kɛ rɛ̈k wäl, kɛɛl amäni gua̱th la̱k ɣɔ̱ɔ̱kiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
            "verseOrgIds": [
              "JOS.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
            "verseOrgIds": [
              "JOS.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kui̱ ji̱ Ger-con min la thok duëël kɛl kä ji̱ Lii-bay, cukɛ kɛ thöp rɛ̈k rɛw kä tha̱a̱ŋ döör Ma-na-thɛ, ɛ Go-lan in la rɛk barä gua̱n tho̱ŋä kä Ba-can kɛɛl nikɛ tɔ̱a̱rikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.27",
            "verseOrgIds": [
              "JOS.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä do̱o̱r Yi-tha-kar cukɛ kɛ thöp Kic-yon kɛnɛ Da-bɛ-rath nikɛ tɔ̱a̱rikiɛn kɛɛl, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Yar-muth kɛnɛ tɔ̱a̱rikɛ, kɛ Een-ga-nim kɛnɛ tɔ̱a̱rikɛ. Matdiɛn kɛ rɛ̈k da̱ŋ ŋuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.29",
            "verseOrgIds": [
              "JOS.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ rɛy döör A-cɛr cukɛ kɛ thöp Mi-cal nikɛ tɔ̱a̱rikɛ kɛ Ab-don kɛnɛ tɔ̱a̱rikɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
              "JOS.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ɛl-kath kɛnɛ tɔ̱a̱rikɛ, kɛ Rɛ-ɣob kɛnɛ tɔ̱a̱rikɛ. Matdiɛn kɛ rɛ̈k ŋuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.31",
            "verseOrgIds": [
              "JOS.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä do̱o̱r Nap-ta-li cukɛ rɛk gua̱n tho̱ŋä ni Kɛ-dɛc kä Gɛ̈-lɛ-li thöp nikɛ tɔ̱a̱rikɛ, kɛ A-moth-dɔr nikɛ tɔ̱a̱rikɛ, kɛ Kar-tan kɛnɛ tɔ̱a̱rikɛ, rɛ̈k diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.32",
            "verseOrgIds": [
              "JOS.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn rɛ̈k ji̱ Ger-con diaal nikɛ pëk gɔalikiɛn kɛ rɛ̈k da̱ŋ wäl diɔ̱k amäni tɔ̱a̱rikiɛn kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.33",
            "verseOrgIds": [
              "JOS.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
