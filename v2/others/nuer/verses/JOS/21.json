        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.33",
            "verseOrgIds": [
              "JOS.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cua thuk duëli ji̱ Mɛ-ra-ri kä duɔth ji̱ Lii-bay moc rɛ̈k rɛy döör Dhɛ-bu-lun kä cua Yɔk-naam ka̱m kɛ amäni tɔ̱a̱rikɛ, kɛ Kar-ta kɛnɛ tɔ̱a̱rikɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.34",
            "verseOrgIds": [
              "JOS.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Dim-na kɛnɛ tɔ̱a̱rikɛ, rɛ̈k ŋuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.35",
            "verseOrgIds": [
              "JOS.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä do̱o̱r Rɛ-u-ben, cukɛ Bɛ-dhɛr ka̱m kɛ, kɛ Yaadhaa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
              "JOS.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Kɛ-dhe-moth, kɛ Me-paath, rɛ̈k da̱ŋ ŋuaan nikɛ tɔ̱a̱rikiɛn kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä rɛy döör Gad cukɛ Ra-moth in la rɛk barä gua̱n tho̱ŋä kä Gil-yad nikɛ tɔ̱a̱rikɛ thöp kɛ, kɛ Ma-na-yim nikɛ tɔ̱a̱rikɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ɛc-bon nikɛ tɔ̱a̱rikɛ, kɛ Ya-dhɛr kɛnɛ tɔ̱a̱rikɛ. Mat rɛ̈kni da̱ŋ ŋuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
            "verseOrgIds": [
              "JOS.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ pëk rɛ̈kni tëë yiathkɛ rɔ̱ kɛ gaat Mɛ-ra-ri ni pëk gɔalikiɛn tëë ci duɔth kä thuk duëli ji̱ Lii-bay, kɛ rɛ̈k da̱ŋ wäl rɛw nikɛ pëk ëë ci thok duëël ɔ ɛ jëk rɔ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        }
      ]
    },
