          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ gaat Rɛ-u-ben kɛnɛ gaat Gad kɛ tha̱a̱ŋ thuɔk duëël Ma-na-thɛ gat Jo-thɛp ka̱m wec Thi-yon kuäär ji̱ Ɛ-mor, kɛ wec Ög kuäär Ba-can, mun kɛ wi̱i̱kɛ diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gaat Gad Di-bon, kɛnɛ Ä-ta-roth kɛ Ä-ro-er, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
              "NUM.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ At-rot-co-pan, kɛnɛ Ya-dhɛr, kɛ Yɔg-baa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Beth-nim-ra, kɛnɛ Bet-ɣa-ran täth, wi̱i̱ ti buɔ̱m buɔ̱ɔ̱m kɛ lueek deet. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gaat Rɛ-u-ben Ɛc-bon, kɛnɛ Ɛl-a-le, kɛ Kir-ya-tha-yim, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Nɛbo, kɛnɛ Baal-me-on (tin ba ciöötkiɛn tit) kɛ Thi-bɛ-ma täth kä cu kɛ kɛ moc ciööt. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gaat Ma-kir gat Ma-na-thɛ Gil-yad wä ka̱n kä ji̱ Ɛ-mor tëë cieŋ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ jɛ ka̱m jɛ kä cuɛ cieŋ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ya-ir gat Ma-na-thɛ wi̱i̱kɛ wä ka̱n, kä cuɛ kɛ cɔl i̱ Ɣa-woth-ya-ir",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32:41",
              "type": "text"
            },
            {
              "text": "Ɣa-woth-ya-ir",
              "type": "text"
            },
            {
              "text": "Kɛ thok Ɣi-bɛ-ru lotdɛ ni ɣöö wi̱i̱ Ya-ir.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu No-bɛ̈k Kɛ-nat kɛnɛ wi̱i̱kɛ ka̱n, kä cuɛ kɛ cɔl kɛ ciötdɛ i̱, No-bɛ̈k.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
