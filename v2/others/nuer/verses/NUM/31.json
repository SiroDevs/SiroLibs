              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣɔ̱k ti bathdɔɔri ti jiɛɛn diɔ̱k wi̱cdɛ bäkɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.44",
