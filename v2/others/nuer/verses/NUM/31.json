          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu muɔ̱li a bathdɔɔri ti jiɛɛn diɔ̱k, kä cu tho̱lbo̱k Kuɔth Nhial a jiɛɛn bäkɛl wi̱cdɛ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
            ]
          }
        },
        {
