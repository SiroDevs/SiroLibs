              "NUM.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣɔ̱k ti bathdɔɔri ti jiɛɛn bärɔw wi̱cdɛ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.33",
            "verseOrgIds": [
              "NUM.31.33"
            ]
          }
        },
        {
