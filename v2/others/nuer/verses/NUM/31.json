          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ muɔ̱li ti bathdɔɔri ti jiɛɛn diɔ̱k wi̱cdɛ kur dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.45",
