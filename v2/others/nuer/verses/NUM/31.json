          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ muɔ̱li ti bathdɔɔri ti jiɛɛn bäkɛl wi̱cdɛ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.34",
            "verseOrgIds": [
              "NUM.31.34"
            ]
          }
