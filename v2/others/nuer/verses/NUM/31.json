          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ män ti bathdɔɔri ti jiɛɛn diɔ̱k wi̱cdɛ rɛw ti /ken met tɔ̱ɔ̱c kɛ wutni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
              "NUM.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kui̱c nɛɛni tëë ci wä ko̱o̱r a det ti bathdɔɔri ti kur diɔ̱k wi̱cdɛ jiɛɛn diɔ̱k wi̱cdɛ bärɔw wi̱cdɛ kur dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
            "verseOrgIds": [
              "NUM.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
