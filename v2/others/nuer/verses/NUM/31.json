              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä käm nikɛ Ɛl-a-dhar bo̱o̱th palä ala muc Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.29",
            "verseOrgIds": [
              "NUM.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
