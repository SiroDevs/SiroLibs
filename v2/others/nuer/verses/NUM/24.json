          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bil-am rɔ jiɛc, cuɛ wä wi̱i̱dɛ, kä cu Ba-lak wä dupdɛ bä.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.25",
