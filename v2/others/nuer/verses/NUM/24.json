          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ji̱ Kɛɛn guic, kä cuɛ ruacdɛ lat wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
              "NUM.24.21"
            ]
