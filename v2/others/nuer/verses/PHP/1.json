        "style": "c",
        "sid": "PHP 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän Puɔl kɔnɛ Ti-mo-thi, la̱a̱t Kritho Yecu, gɔ̱a̱rkɔ warɛgak ɛmɛ yɛ, yɛn tin ci Kuoth kɛ lɛy, tin te kä Pi-li-pi kɛɛl kɛ bööth palä tin cɔali “bicipni” kɛnɛ “dikɛni”.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A puɔ̱th kɛnɛ mal mi bä kä Kuoth in la Gua̱a̱ra kɛnɛ Kuäär ni Yecu Kritho tekɛ yɛ.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pal Puɔl kɛ kui̱ ji̱ Pi-li-pi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän la Kuothdä a la̱rä tɛ̈th lɔaac gua̱thni diaal mi cä yɛ tim, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.3",
            "verseOrgIds": [
              "PHP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä gua̱thni diaal la palä kɛ kui̱dun diaal kɛ tɛ̈th lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.4",
            "verseOrgIds": [
              "PHP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tɛth lɔcdä kɛ luäk ëë ci yɛn ɛ luäk ni ɣä mëë latdä thuk ti gɔw nikɛ cäŋ ëë nhiam mëë liŋ yɛnɛ ti̱ti̱ amäni walɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.5",
            "verseOrgIds": [
              "PHP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän ŋa̱a̱thä jɛ ɛn ɣöö Kuoth in ci mi gɔaa ɛmɛ tok kɛ lätni rɛydun, bɛ jɛ cuɔ̱p amäni cäŋ in bi ben kɛ Yecu Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn ɛ cuɔ̱ɔ̱ŋ kä ɣä ɛn ɣöö bä ca̱r inɔ kɛ kui̱dun diaal, kɛ ɣöö caarä yɛn diaal kɛ lɔcdä. Ci yɛn diaal puɔ̱th Kuɔth nyuak kɛ ɣä kɛɛl, rɛy yieenädä, kɛnɛ ga̱ŋ thukni ti gɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö Kuoth ɛ neendä ɛn ɣöö göörä ɣöö bä yɛ nɛn kɛ ɣöö nhɔakä yɛn diaal kɛ nhök Kritho Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä palä ɛ ɣöö dee nhökdun rɔ rep a wee wä kɛ ŋäc ŋɔaani amäni ŋukdiɛn diaal, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bɛ yɛ luäk kɛ ɣöö bia ka̱n ni min gɔaa, kɛnɛ ɣöö dee yɛn a wiɛc wiɛɛc, ti thil bɛ̈l kɛ cäŋ Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.10",
            "verseOrgIds": [
              "PHP.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö dërɛ thia̱ŋ kɛ ti gɔw ti bä kä ciaŋ cuŋni rɛy Yecu Kritho kɛ puɔny kɛnɛ liak Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "La̱t ruac Kritho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän göörä ɣöö bi yɛn ɛ ŋa̱c, dämaari, ɛn ɣöö min ci tuɔɔk kä ɣä cɛ luäk kɛ naŋ thukni ti gɔw raar, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
            "verseOrgIds": [
              "PHP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö ca jɛ ŋa̱c ɛ ga̱a̱ŋ dhɔaar kua̱r kɛnɛ nɛy tin kɔ̱kiɛn ɛn ɣöö yiankɛ ɣä kɛ kui̱ Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ɣöö ca ɣä yiɛn, cɛ ri̱w nɛɛni tin ŋa̱th moc kɛ ŋa̱th kɛ Kuäär ni Yecu, kɛ ɣöö bikɛ piith kɛ liak kɛ latdiɛn kɛ ruac Kuɔth a thil dual.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu tha̱a̱ŋ nath ruac Kritho Yecu lat kɛ ɣöö tekɛ kɛ tiɛɛl kɛnɛ tɛ̈r, kä duundɛ ɣöö cu kɔ̱kiɛn ɛ lat kɛ thuɔ̱k kɛnɛ kɔ̱a̱c lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛy ti̱ti̱ latkɛ Kritho kɛ nhök, a ŋäc kɛn ɛ, ɛn ɣöö ca ɣä la̱th ɛn wanɛ mɛ kɛ ga̱ŋ thukni ti gɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.16",
            "verseOrgIds": [
              "PHP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tha̱a̱ŋ nath la̱tkɛ ruac Kritho kɛ tiɛɛl go̱rä ŋɔaani, a /ciɛ thuɔ̱k, kä caar kɛn ɛ ɛn ɣöö ba riɛkdä rep min ta̱a̱ yieenä. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋu la riɛk ɔ? Min di̱t ni jɛn thi̱n ɛ ɣöö kɛ dup diaal latkɛ ni ruac kɛ kui̱ Kritho, a cäŋ kua lat kɛ kac kiɛ kɛ thuɔ̱k, ɣän tɛth lɔcdä. Kä bi lɔcdä wäkɛ tɛ̈th, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö ŋa̱cä jɛ kɛ palun kɛnɛ luäk Yieekä Yecu Kritho, ɛn nɔmɔ bɛ ben ala ka̱ndä. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.19",
            "verseOrgIds": [
              "PHP.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min göörä kɛnɛ min ŋa̱a̱thä, ɛ ɣöö /ca ɣä bi jakä po̱c kɛ duɔ̱ɔ̱r, kä duundɛ ɣöö bä ruac kɛ liak ɛn täämɛ ce̱tkɛ min wen, kɛ ɣöö bä Kritho nöŋ liak rɛy teekädä a tëkä kiɛ a cä li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.20",
            "verseOrgIds": [
              "PHP.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mi tëkä, ɣän tëkä kɛ Kritho Yecu, kä mi cä li̱w, gɔaa ni jɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.21",
            "verseOrgIds": [
              "PHP.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi tëkä rɛy ri̱eŋ, nɔmɔ lotdɛ ni ɣöö dëë ti gɔw la̱t, kä ɣän kuecä min dëë mɛk. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
            "verseOrgIds": [
              "PHP.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän ga̱lä ɛlɔ̱ŋ kamdiɛn da̱ŋ rɛw. Min göörä ɛ ɣöö bä jiɛn, bä wä te kɛɛl kɛ Kritho, kɛ ɣöö nɔmɔ gɔaa ni jɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
              "PHP.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣöö bä tëk rɛy ri̱eŋ gɔaa ni jɛn kɛ kui̱dun. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min kua̱ nɛmɛ lɛ ŋa̱c, ŋa̱cä jɛ ɛn ɣöö bä duɔth, kä bä ŋot kɛ yɛ kɛɛl, kɛ ɣöö bä yɛ luäk kɛ pi̱eth kä bia tekɛ tɛ̈th lɔaac rɛy ŋäthä, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö dëë liak ben nyuak kɛ yɛ kɛɛl rɛy Kritho Yecu mi wa̱a̱ rɔ nyɔk kɛ ben kä yɛ.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
