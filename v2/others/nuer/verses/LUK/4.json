            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci ɣɔw baak, cu Yecu jiɛɛn, cuɛ wä guäthdɛ kärɔa. Kä cu naath ɛ go̱r, kä mëë cikɛ jɛ jek, cukɛ jɛ lo̱k ɛn ɣöö bɛ kɛ ba̱ny piny. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.42",
            "verseOrgIds": [
              "LUK.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ jiök i̱, “Ɣän bä thuk ti gɔw kɛ kui̱ kuäärä Kuɔth lat wi̱i̱ni ti kɔ̱kiɛn bä, kɛ ɣöö ja̱kɛ ɣä kɛ jɛn kui̱ kä mɛmɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.43",
            "verseOrgIds": [
              "LUK.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ŋot latdɛ ruac Kuɔth gua̱thni dolä ji̱ Juudh kä Ju-dia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.44",
            "verseOrgIds": [
              "LUK.4.44"
            ]
          }
        }
      ]
