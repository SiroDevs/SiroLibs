            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thiaŋ konyä ca̱ŋ, cu nɛy diaal tin tekɛ nɛɛkiɛn ti tekɛ jua̱th ti gööl nöŋ Yecu. Kä cuɛ tetkɛ la̱th wuɔ̱thnikiɛn, kä cuɛ kɛ jak kä gɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.40",
            "verseOrgIds": [
              "LUK.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu yiey ti jiäk ben raar pua̱nyni nɛɛni ti ŋuan, kä cukɛ rɔal i̱, “Ɛ ji̱n Gat Kuɔth!” Kä cuɛ kɛ gok, kɛ ɣöö /cikɛ bi ruac, kɛ ɣöö ŋa̱ckɛ jɛ i̱ ɛ jɛn Mɛ-thia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lat Yecu kɛ ruac duëli duɔ̱ɔ̱li ji̱ Juudh",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
