        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:9",
              "type": "text"
            },
            {
              "text": "Ɣöth 19:5-6, Ica 43:20-21.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yɛn lapɛ thok duëël mi ca mɛk, ti bööth palä, mi la do̱r mi rɛl rɔ, nɛɛ Kuɔth ti rɛlɛ, kɛ ɣöö dee yɛn lätkɛ tin buɔ̱m buɔ̱ɔ̱m lat jɛn ram min cɔl yɛ raar rɛy muɔ̱th, cɔlɛ yɛ rɛy buɔyädɛ min gɔaa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tëkni ce̱tkɛ läät Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhöökä, ɣän la̱ŋä yɛn tin ce̱tkɛ rööl kɛnɛ ja̱a̱l ti ci jiɛɛn ro̱o̱liɛn ɛn ɣöö /ci lo̱ckun bi di̱t kɛ nyin jiäkni pua̱a̱ny tin tɛ̈rkɛ ko̱r kɛ tieydun. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciëŋɛ agɔaa rɛy Juri, kɛ ɣöö mi dee kɛ yɛ lat jɔ̱ɔ̱r i̱ lapɛ ji̱ nyuɔɔni, bikɛ lätkun tin gɔw nɛn kä bikɛ Kuoth liak kɛ cäŋ in bɛ ɣɔw ben gui̱l.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ Kua̱r ni Yecu nhɔakɛ ruaacni nɛɛni diaal tin ruackɛ yɛ nhɔakɛ ruec kua̱r in di̱t ni jɛn kä ti diaal, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.13",
            "verseOrgIds": [
              "1PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiɛ ruëëc tin cɛ ja̱k kɛ ɣöö ba ji̱ dueeri ben duäc, kä ba nɛy ti la̱tkɛ cuŋ ben liak. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.14",
            "verseOrgIds": [
              "1PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö go̱o̱r Kuoth jɛ ɛn ɣöö ba ruac dɔa̱a̱ri ti kueckɛ ŋɔak jak kä bit kɛ lätni cuŋni. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.15",
            "verseOrgIds": [
              "1PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciëŋɛ ala nɛy ti lɔr kä /cuarɛ lɔarun jak kä lät ti jiäk, kä duundɛ ɣöö ciëŋɛ ce̱tkɛ kuaany Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.16",
            "verseOrgIds": [
              "1PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luɔ̱thɛ nɛy diaal. Nhɔakɛ dämuɔɔri tin la ji̱ ŋäthä. Dualɛ kɛ Kuoth. Luɔ̱thɛ kuäär in di̱i̱t.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuuth cucä Kritho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuaany, lua̱rɛ rɔ kua̱rkun kɛ luth mi di̱i̱t ɛlɔ̱ŋ, a /ci mɔ a kua̱r tin gɔw tin kɔ̱c lo̱ckiɛn kärɔ̱, amäni kua̱r tin ruac a jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.18",
            "verseOrgIds": [
              "1PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn nɔmɔ ba cuɔ̱ɔ̱ŋ kä ji̱ mi rut raan ti bɛ̈c bɛ̈ɛ̈c kɛ ɣöö tiimɛ Kuoth, a cäŋ cucɛ kɛ mi thil luɔt. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.19",
            "verseOrgIds": [
              "1PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mi ruutdi duäc kɛ ɣöö ci duer la̱t, ɛ luɔt ŋukä ci jek ɔ? Kä duundɛ ɣöö mi lät yɛn ni cuŋ, kä cia cuuc kɛ kui̱dɛ, ɛ min gɔaa ɛlɔ̱ŋ nhiam Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.20",
            "verseOrgIds": [
              "1PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ca yɛ cɔl kɛ kui̱ kä mɛmɛ, kɛ ɣöö ci Kritho cuuc kɛ kui̱dun, kä cɛ yɛ ba̱ny nyuuth kɛ ɣöö bia guɔ̱ɔ̱r ni ciökɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.21",
            "verseOrgIds": [
              "1PE.2.21"
            ]
          }
        }
      ]
    }
