  "reference": "Lät 20",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "ACT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wä Puɔl kä Ma-tha-do-nia kɛnɛ Gɛ-rith",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr kä mëë ci rɔal cuɔ̱ŋ, cu Puɔl ji̱ kɔaar Yecu cɔal guäth kɛl, kä mëë cɛ kɛ com, cuɛ kɛ la̱t mal, kä cuɛ wä kä Ma-tha-do-nia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.1",
            "verseOrgIds": [
              "ACT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cɛ ja̱l kɛ gua̱th tɔ̱tɔ̱, cuɛ kɛ com ɛlɔ̱ŋ, kä cuɛ ben kä Gɛ-rith, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.2",
            "verseOrgIds": [
              "ACT.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "guäth in cuɛ te thi̱n kɛ päth da̱ŋ diɔ̱k. Kä mëë go̱o̱r wä kä Thi-ri-ya kɛ riey mëë cuɛ jɛ ŋa̱c ɛn ɣöö ca jɛ ca̱p ca̱p ɛ ji̱ Juudh, cuɛ jɛ lar ɛn ɣöö bɛ loc jɔk kɛ Ma-tha-do-nia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.3",
            "verseOrgIds": [
              "ACT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Tho-pa-tɛr, gat Pay-räth, raan Bɛ-ria wä kɛ jɛ kɛɛl, kɛ A-rith-tar-keth kɛnɛ Thɛ-kun-däth tin la ji̱ Thɛ-tha-lo-ni-ka, kɛ Gay-äth raan Dɛr-bi kɛ Ti-mo-thi, kɛ Ti-ki-käth kɛnɛ Ti-ro-ath tin la ji̱ E-cia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.4",
            "verseOrgIds": [
              "ACT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn cukɛ wä nhiam kä liɛpkɛ kɔ kä Ti-ro-ath. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.5",
            "verseOrgIds": [
              "ACT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua kɔ jiɛɛn kä Pi-li-pi kɛ riey kɛ kɔr ti̱mä mi̱eth mi thil thuɔp, kä kɛ ni̱n da̱ŋ dhieec cua kɔ ben kä kɛ kä Ti-ro-ath, guäth ëë cua kɔ te thi̱n kɛ ni̱n bärɔw.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.6",
            "verseOrgIds": [
              "ACT.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gui̱l Puɔl in jɔak kɛ Ti-ro-ath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.6",
            "verseOrgIds": [
              "ACT.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ jokä min jio̱l mëë cakɔ rɔ dol kɛɛl kɛ punyni jurayä, cu Puɔl ruac kɛ kɛ, kɛ ɣöö go̱rɛ ɣöö bɛ jiɛɛn iruun, kä cuɛ jääny kɛ ruac amäni wäärdär. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.7",
            "verseOrgIds": [
              "ACT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä te lɛmbäri ti ŋuan rɛy duëël in te nhial guäth ëë duɔlkɔ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.8",
            "verseOrgIds": [
              "ACT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ŋuɛ̈t mi cɔal i̱ Yu-ti-käth nyuur waaŋ wernyinä. Cuɛ dɔ̱ɔ̱l a cuɛ niɛn ɛlɔ̱ŋ, mëë ci Puɔl jääny kɛ ruac. Kä mëë ci ni̱en di̱t puɔ̱ɔ̱nydɛ, cuɛ pɛn piny kä duel in diɔ̱ɔ̱kdiɛn in te nhial, kä cua jɛ kap a cɛ li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.9",
            "verseOrgIds": [
              "ACT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Puɔl wä piny, kä cuɛ rɔ goŋ wi̱i̱dɛ, kä cuɛ jɛ käp tetnikɛ, wëë i̱, “A wi̱cdun /cɛ yi̱c, kɛ ɣöö ŋot yiëëdɛ puɔ̱ɔ̱nydɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.10",
            "verseOrgIds": [
              "ACT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Puɔl loc nhial, cuɛ juray puɔ̱ny kä cuɛ jɛ cam, cuɛ ruac kɛ kɛ amäni bak ɣɔaa, kä cuɛ cu jiɛɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.11",
            "verseOrgIds": [
              "ACT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ ŋuɛ̈t naŋ a tëk, kä cu lo̱ckiɛn buɔ̱m ɛlɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jiɛɛn Puɔl kä Ti-ro-ath wädɛ kä May-li-täth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua kɔ wä nhiam wakɔ rɛy ria̱a̱y, cuakɔ wä kä A-thoth, guäth in bakɔ Puɔl wä la̱th ria̱a̱y thi̱n. Kä cɛ mɛmɛ rialikä, kɛ ɣöö cɛ jɛ car i̱ bɛ ja̱l kɛ rar. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.13",
            "verseOrgIds": [
              "ACT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cɛ röm kɛ kɔ kä A-thoth, cuakɔ jɛ nöŋ rɛy ria̱a̱y, kä cuakɔ ben kä Mi-ta-le-ni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.14",
            "verseOrgIds": [
              "ACT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuakɔ jiɛɛn kɛ riey ɛn wi̱ni, cuakɔ ben lotdä Ki-ɔth mëë ruɔ̱ndɛ. Kä kɛ bakdɛ min dɔ̱ŋ cuakɔ cop kä Tha-moth, kɛ bakdɛ mi dɔ̱ŋ cuakɔ ben kä May-li-täth. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.15",
            "verseOrgIds": [
              "ACT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ci Puɔl ɛ car ɛn ɣöö bɛ Ɛ-pɛ-thäth rɛ̈t piny kɛ riey, kɛ ɣöö /cɛ bi jääny kä E-cia. Jɛn pɛ̈thɛ kɛ wä kä Jɛ-ru-tha-lɛm mi lotdɛ rɔ, kɛ cäŋ in la Cäŋ kä Jiɛn Dhieec.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac Puɔl kɛ bäny di̱t Ɛ-pɛ-thäth mal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä May-li-täth cuɛ ruac jäk kä Ɛ-pɛ-thäth ɛn ɣöö bɛ röm kɛ di̱t duëël Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.17",
            "verseOrgIds": [
              "ACT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cikɛ ben kä jɛ, cuɛ kɛ jiök i̱, “Yɛn pua̱nykun ŋa̱cɛ ciaaŋ ëë cieŋ kɛ rɛydun nikɛ cäŋ ëë nhiam ëë cup kɛ ɣä kä E-cia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.18",
            "verseOrgIds": [
              "ACT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua Kuäär lätikä kɛ ciaŋ mi muɔ̱l muɔ̱l kɛnɛ mer, kɛ ruɔ̱ɔ̱tdä kɛ ciaaŋ mi bɛc bɛc mëë ci tuɔɔk kä ɣä kɛ ca̱a̱p ji̱ Juudh. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.19",
            "verseOrgIds": [
              "ACT.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thilɛ mi cä ka̱p jɔk mi dee yɛ luäk kɛl mi kɛ lätdä kɛ yɛ ruac Kuɔth, kɛnɛ ŋi̱i̱cdun nhiam nath, duelɔ kɛ duelɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.20",
            "verseOrgIds": [
              "ACT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cä ji̱ Juudh kɛnɛ ji̱ Gɛ-rith la̱t nëndä kɛ ri̱t nath kɛ rɔ̱ kä Kuoth, kɛnɛ ŋa̱th Kua̱ran ni Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.21",
            "verseOrgIds": [
              "ACT.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ kɛ luth Yieekä in Gɔaa in Rɛl Rɔ wa̱a̱ kä Jɛ-ru-tha-lɛm, kä kuecä mɔ bi wä tuɔɔk kä ɣä ɛn wi̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.22",
            "verseOrgIds": [
              "ACT.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän ŋa̱cä ni ɣöö rɛy wi̱i̱ni diaal nyuth Yiëë in Gɔaa in Rɛl Rɔ ɣä ɣöö liip yieen kɛnɛ rik ɣä. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.23",
            "verseOrgIds": [
              "ACT.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö /cä tëkdä kuɛn i̱ ɛ mi di̱i̱t kiɛ mi gɔaa kɛ ɣä, ɛ ni ɣöö bä pek la̱tdä cuɔ̱p kɛnɛ la̱t in ca ka̱m ɣä ɛ Kuäär ni Yecu, ɛn ɣöö bä thuk ti gɔw kɛ kui̱ puthä Kuɔth la̱t naath.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.24",
            "verseOrgIds": [
              "ACT.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.24",
            "verseOrgIds": [
              "ACT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä täämɛ, ŋa̱cä jɛ ɛn ɣöö thilɛ raan rɛydun kä yɛn nɛy tëë ca ruac kɛ kui̱ kuäärä Kuɔth lat thi̱n mi bi ɣä nyɔk kɛ nën. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.25",
            "verseOrgIds": [
              "ACT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ bä jɛ la̱t yɛ ɛn wa̱lɛ, ɛn ɣöö thilɛ ɣä ŋu kɛ riɛm raam ɔ bi dueerɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.26",
            "verseOrgIds": [
              "ACT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö thilɛ mi cä ba̱ny jɔk mi /ka̱n la̱t yɛ kä min lot Kuoth kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.27",
            "verseOrgIds": [
              "ACT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ tiɛtdɛ rɔ̱ kä tiɛtdɛ det diaal, tin ci Yiëë in Gɔaa in Rɛl Rɔ yɛ jakä ga̱a̱ŋkiɛn. Kä jakɛ rɔ̱ kä yiëën duëël Kuɔth, min cɛ jek kɛ riɛm Gatdɛ pa̱ny. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.28",
            "verseOrgIds": [
              "ACT.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋa̱cä jɛ ɛn ɣöö mi wa̱a̱ wä jiɛɛn bi jio̱o̱k nyapëc ti ci wa̱th ben rɛydun, kä /cikɛ det bi päl. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.29",
            "verseOrgIds": [
              "ACT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi tha̱a̱ŋ nath rɔ̱ jiɛc rɛydun kä ba ka̱a̱cni lat, kɛ ɣöö bi ji̱ kɔaar Yecu kɛ guɔ̱ɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.30",
            "verseOrgIds": [
              "ACT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, jiɛnɛ, kä tiɛmɛ jɛ ɛn ɣöö kɛ run da̱ŋ diɔ̱k /ka̱n cuɔ̱mdun diaal kɛ mer päl kɛ wäär kɛnɛ cäŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.31",
            "verseOrgIds": [
              "ACT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ kuëŋä yɛ tetdä Kuɔth kɛnɛ ruac puthädɛ, min tekɛ lua̱ŋ kɛ no̱o̱ŋdun nhial, kɛnɛ muɔ̱cdun kɛ puɔ̱th rɛy nɛɛni diaal tin ca lɛy. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.32",
            "verseOrgIds": [
              "ACT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän thilɛ ciɛk in bo̱r kiɛ da̱a̱p kiɛ bi̱i̱ ran mi cä go̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.33",
            "verseOrgIds": [
              "ACT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋäc yɛnɛ pua̱nykun ɛn ɣöö cä lät kɛ tetkä kɛ ɣöö bä rɔ lätikä, kɛnɛ nɛy tin tekɛ ɣä kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.34",
            "verseOrgIds": [
              "ACT.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ti diaal ti̱ti̱ cä yɛ nyuɔ̱th ɣöö kɛ la̱t mi ce̱tkɛ ɛnɔ bi raan nɛy tin thil lua̱ŋ dhil luäk, a tiɛmɛ ruaacni Kua̱r ni Yecu, mi cɛ wee i̱, ‘Ɛ puɔ̱th mi tho̱pi ni duɔ̱ɔ̱r kä känidɛ.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
              "ACT.20.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
              "ACT.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cɛ thuɔ̱k kɛ ruac, cuɛ rɔ ka̱m mua̱a̱l kɛɛl kɛ kɛn diaal, kä cuɛ pal. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kɛn diaal wiee, kä cukɛ Puɔl kuak, kä ciɛmkɛ jɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
              "ACT.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä jiɛth lo̱ckiɛn kɛ kui̱ ruac in cɛ lat, ɛn ɣöö /ci kɛn ɛ bi nyɔk kɛ nën. Kä cukɛ jɛ naŋ rɛy ria̱a̱y.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
            "verseOrgIds": [
              "ACT.20.38"
            ]
          }
        }
      ]
