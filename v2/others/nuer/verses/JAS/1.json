              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram mi guic ŋut in thuɔ̱k pa̱ny ŋut in jak naath kä lɔr. /Ci wi̱cdɛ bi ruëëc, latdɛ ni lätkɛ diaal, kä jɛn ba jɛ poth rɛy lätnikɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.25",
            "verseOrgIds": [
              "JAS.1.25"
            ]
          }
        }
