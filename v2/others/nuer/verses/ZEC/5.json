  "reference": "Dhɛk 5",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ZEC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuuth ŋarä warɛgakä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ waŋdä nyɔk kɛ kap nhial, cua̱ warɛgak ŋarä nɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.1",
            "verseOrgIds": [
              "ZEC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu jääk ɣä thiec i̱, “Ɛŋu nɛɛni mɔ?” Kä cua̱ jɛ loc i̱, “Nɛ̈ɛ̈nä warɛgak ŋarä. Bärɛ tëë kɛ jua̱th tetni ti jiɛn da̱ŋ rɛw, kä ɣäp ɣääpdɛ ɛ jua̱th tetni da̱ŋ wäl.” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ɣä jiök i̱, “Ɛ kuëth in wä raar wi̱i̱ muɔ̱ɔ̱n kɛɛliw. Kä cu kui̱c kɛl lat ni ɣöö ba cueer diaal woc wi̱i̱ muɔ̱ɔ̱n. Kä cu kui̱c in dɔ̱ŋ lat ni ɣöö nɛy diaal tin yackɛ rɔ̱ kɛ kac bakɛ woc bä. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.3",
            "verseOrgIds": [
              "ZEC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial in la Ruey Ɣɔaa ɛ lar ɛn ɣöö ɣän bä jäk kä nhiam a bɛ wä coth ni duëël cuëër, kɛnɛ duel nɛɛni tin yackɛ rɔ̱ kɛ kac kɛ ciötdä. Kä bɛ te duëlikiɛn amäni mi cɛ duëlkiɛn däk.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuuth ciëk mi te rɛy diëny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu jääk in ruac kɛ ɣä ben, kä cuɛ ɣä jiök i̱, “Liɛc nhial, guic mɔ bëë mɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.5",
            "verseOrgIds": [
              "ZEC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua thiec i̱, “Kä ɛŋu?” Kä cuɛ wee i̱, “Ɛ dieny thëm.” Kä cuɛ riet bä i̱, “Tɔ̱tɔ̱ kɛ dueer nɛɛni diaal wi̱i̱ muɔ̱ɔ̱n.” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuum diëny rɔ lɛp, kä te ciek nyuurä rɛy diëny! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.7",
            "verseOrgIds": [
              "ZEC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu jääk wee i̱, “Ɛn ciek ɛmɛ lotdɛ ni ji̱ dueeri.” Kä cuɛ ciek nyɔk kɛ ɣɔk rɛy diëny, kä cuɛ kuumdɛ nyɔk kɛ ɣɔk thokdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.8",
            "verseOrgIds": [
              "ZEC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua wi̱cdä kap nhial guecä, kä cua̱ män da̱ŋ rɛw nɛn bäkɛ kä ɣä! Kä tekɛ kɛ gɔ̱k ti ce̱tkɛ gɔ̱k ki̱lä. Kä cukɛ dieny ka̱n kä cukɛ rɔ̱ bar nhial kɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.9",
            "verseOrgIds": [
              "ZEC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ jääk in ruac kɛ ɣä thiec i̱, “Kä naŋ kɛn dieny nikä?” ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.10",
            "verseOrgIds": [
              "ZEC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ɣä loc i̱, “Naŋkɛ jɛ ro̱o̱l Bɛ̈-bi-lɔn, gua̱a̱th in ba wä ta̱th duel thi̱n. Kä mi wä duel wä thuɔ̱k kɛ ta̱th, ba dieny la̱th guäthdɛ ɛn wi̱ni.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.11",
            "verseOrgIds": [
              "ZEC.5.11"
            ]
          }
        }
      ]
    }
  ],
