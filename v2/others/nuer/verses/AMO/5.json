              "type": "text"
            }
          ]
        },
        {
          "text": "Liɛŋɛ yɔal ɛmɛ, lö thok duëël I-thɛ-rɛl, ɛn lul ɛ paarä mi kɛ kui̱dun.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
