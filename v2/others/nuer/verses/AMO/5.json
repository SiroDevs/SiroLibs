          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tëë kɛ ɣɔ̱k ti cia na̱k ɣä, kiɛ loori ti cia thöp ɣä, kɛn runi tëë jiɛn ŋuaan tëë bööthä yɛ thi̱n däär dɔaar, lö thok duëël I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.25",
            "verseOrgIds": [
              "AMO.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "AMO 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bia kap ni riak kuthnikun ti̱n guäy ti̱n cia ta̱th rɔ, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
              "AMO.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "AMO 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bä yɛ cuac ni kui̱c Da-math-kɛth ala pɛ̈ɛ̈c.” Nɔmɔ ɛ mi ci Kuoth Nhial min cɔal ciötdɛ i̱ Ruey Ɣɔaa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.27",
