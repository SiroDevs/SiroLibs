        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuuth kɔaryɔaam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Kuäär ni Kuoth Nhial ɣä nyuɔ̱th nɛmɛ, mëë ca wal ku thuŋ cëc kuäär kä do̱ny wal ti̱n kɔŋ, cuɛ buɔ̱n kɔaryɔaamni rialikä. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rɛy nyuuthä nɔmɔ, cua kɔryɔm nɛn camɛ wal diaal rɛy rööl, ɛ jɛn cua ku wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuuth maac",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Kuäär ni Kuoth Nhial ɣä nyɔk kɛ nyuth nɛmɛ. Rɛydɛ cua jɛ nɛn cɛ rɔ rialikä kɛ ɣöö bɛ nɛɛkɛ ben luk kɛ mac. Cu mac Bar in di̱i̱t in te piny muɔ̱ɔ̱n dhɔ̱ŋ kɛ pɛt, kä kɛ kɔrɛ cuɛ ben wi̱i̱ muɔ̱ɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cua ku wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuuth thëm cuŋä pa̱a̱ny duëël",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ɣä nyɔk kɛ nyuth nɛmɛ, kä cua jɛ nɛn cuŋä ge̱kä pa̱a̱ny mi cuŋ ɛ thiw, kä te tetdɛ kɛ theem cuŋä. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ɣä thiec i̱, “A-mɔth, ɛ lɛ ŋu mi nɛɛni?” Kä cua jɛ loc i̱, “Ɛ theem cuŋä.” Ɛ jɛn cuɛ ku wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A-mɔth kɛnɛ Ä-mä-dhi-ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niɛ wan ɔ, cu Ä-mä-dhi-ya in la bo̱o̱th palä kä Beth-ɛl, thok jäk kä Ya-rɔ-baam kuäär ji̱ I-thɛ-rɛl, jiökɛ jɛ i̱, “A-mɔth a ca̱p mi cäpɛ ji̱ ni thok duëël I-thɛ-rɛl, /ci ji̱ wec muɔ̱ɔ̱n laatkɛ bi rut, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö laarɛ jɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ä-mä-dhi-ya A-mɔth ku jiök i̱, “Ji̱n gök bari rɔ kä Juda, bi ruaacni go̱o̱kädu wä lat thi̱n, kä bi miɛ̱thdu jek thi̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu /kɛ lɛ lat ɛn wan ɛ kä Beth-ɛl, kɛ ɣöö ɛ jɛn gua̱a̱th palä kua̱r in di̱i̱t, kä ɛ jɛn luak kuɔth in la thac wecdan.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu A-mɔth ɛ ku loc i̱, “/Ciɛ ɣän gök, kä /ciɛ ɣän gat go̱kä, kä ɣän lapä gua̱n ɣɔ̱ɔ̱k, kɛnɛ pi̱eth ŋɔ̱a̱pni. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ci Kuoth Nhial ɣä ka̱n ni yi̱en ɣɔ̱ɔ̱k, kä cuɛ ɣä jiök i̱, ‘Wër la̱tni ruaacni go̱o̱kä nɛɛkä ni ji̱ I-thɛ-rɛl.’",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.15",
            "verseOrgIds": [
              "AMO.7.15"
            ]
          }
        }
      ]
    }
