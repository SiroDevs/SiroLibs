{
  "id": "EZK.24",
  "number": "24",
  "bookId": "EZK",
  "reference": "Yɛdh 24",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
