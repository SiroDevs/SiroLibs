        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dääk muɔ̱ɔ̱n kamni thukni duëli ji̱ I-thɛ-rɛl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kɛn ciööt thukni duëli ji̱ I-thɛ-rɛl. A tookɛ jɛ ni këth kuec caam, dup in wä kä Ɣɛth-lon, nikä Lɛbo-ɣä-mat a räth nikä Ɣä-dhar-e-non (min te këth Da-math-kɛth kɛnɛ Ä-math kui̱c caam), kä bɛ lɛ ka̱n nikä käny ca̱ŋ a wä kä kony ca̱ŋ, bi Daan tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kuɛ ka̱n ni këth Daan kui̱c känyä ca̱ŋ a wä kui̱ konyä ca̱ŋ, bi A-cɛr tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lɛnɛ ka̱n ni këth A-cɛr kui̱c känyä ca̱ŋ a wä kui̱ konyä ca̱ŋ, bi Nap-ta-li tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kuɛ ka̱n ni këth Nap-ta-li kui̱c känyä ca̱ŋ, a wä kui̱ konyä ca̱ŋ, bi Ma-na-thɛ tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lɛnɛ ka̱n ni këth Ma-na-thɛ kui̱c känyä ca̱ŋ, a wä kui̱ konyä ca̱ŋ, bi Ɛ-pa-rim tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kuɛ ka̱n ni këth Ɛ-pa-rim kui̱c känyä ca̱ŋ, a wä kui̱ konyä ca̱ŋ, bi Rɛ-u-ben tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lɛnɛ ka̱n ni këth Rɛ-u-ben kui̱c känyä ca̱ŋ, a wä kui̱ konyä ca̱ŋ, bi Juda tekɛ kui̱ kɛl.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pek in rɛl rɔ Däär wec",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kuɛ ka̱n ni këth Juda kui̱c känyä ca̱ŋ, a wä kui̱ konyä ca̱ŋ, bɛ a kui̱c mi bi kuany go̱lä, bɛ tekɛ jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec ɣäp ɣääpdɛ, kä bi bärɛ piny pa̱a̱r kɛ kui̱c muɔ̱ɔ̱n raam kɛl kä ji̱ thukni duëli I-thɛ-rɛl, ni kui̱c känyä ca̱ŋ a wä kui̱ konyä ca̱ŋ, a te luaak Kuɔth ni däär. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mun in bia kuany go̱lä kɛ kui̱ Kuɔth Nhial, bɛ a jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec bärɛ piny, kä bi ɣäp ɣääpdɛ a jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw ɛ juc. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ti̱ti̱ bikɛ a gua̱th tin rɛl gɔɔydiɛn rɔ. Kä bi bööth palä tekɛ gua̱th ti tekɛ theemni ti jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec bärɛ piny pek kuec caam, kɛ jua̱th tetni ti bathdɔɔri wäl ɣäp ɣääpdɛ pek kuec konyä ca̱ŋ, kɛ jua̱th tetni ti bathdɔɔri da̱ŋ wäl ɣäp ɣääpdɛ pek kuec känyä ca̱ŋ, kɛ jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec bärɛ piny kɛ pek kuec cuëëc, kä bi luaak Kuɔth Nhial te ni däär. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛy tɔ̱tɔ̱ bikɛ la ni bööth palä tin ca poth, kä kuay Dha-dok, tin la̱tkɛ lätkä, kä /ken kac raar kä ɣä, mëë ci ji̱ I-thɛ-rɛl kac raar kä ɣä, ce̱tkɛ mëë ca la̱t ɛ ji̱ Lii-bay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ a duŋdiɛn mi rɛl kɛn ɛ, kä mun in rɛl gɔɔydɛ rɔ, a kuɛ ka̱n ni këth ji̱ Lii-bay. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lɛnɛ ka̱n ni këth bööthni palä, bi ji̱ Lii-bay tekɛ kui̱c mi tekɛ theemni ti jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec bär ɛ piny kɛnɛ jua̱th tetni ti bathdɔɔri da̱ŋ wäl ɣäp ɣääpdɛ. Kä bärɛ piny ni kɛɛliw, bɛ a jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec, kä ɣäp ɣääpdɛ bɛ a jua̱th tetni ti bathdɔɔri da̱ŋ wäl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cikɛ mun bi kɔak kä /cikɛ jɛ bi luɛ̈l. Kä /cikɛ jɛ bi wäny kɛ mun dɔ̱diɛn, kɛ ɣöö ɛ mi rɛl gɔɔydɛ rɔ kä Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duɔth muɔ̱ɔ̱n ɛ bathdɔɔri da̱ŋ dhieec ɣäp ɣääpdɛ, kä bärɛ piny ɛ jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec, bɛ a gua̱a̱th mi la̱tkɛ nyin wec, ce̱tkɛ ciëëŋ, kɛnɛ tɔ̱ɔ̱r la̱k ɣɔ̱ɔ̱k. Kä bi wec te däärɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ti̱ti̱ a theemnikɛ. Kä bi kui̱c caam tekɛ jua̱th tetni ti bathdɔɔri da̱ŋ ŋuaan wi̱cdɛ kur dhieec, kä bi kui̱c cuëëc tekɛ jua̱th tetni ti bathdɔɔri da̱ŋ ŋuaan wi̱cdɛ kur dhieec, kä bi kui̱c känyä ca̱ŋ tekɛ jua̱th tetni ti bathdɔɔri da̱ŋ ŋuaan wi̱cdɛ kur dhieec, kä bi kui̱c konyä ca̱ŋ tekɛ jua̱th tetni ti bathdɔɔri da̱ŋ ŋuaan wi̱cdɛ kur dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi wec tekɛ mun mi bi te baaŋ. Kä bi kui̱c caam a jua̱th tetni ti kur rɛw wi̱cdɛ jiɛn dhieec, kä bi kui̱c cuëëc a jua̱th tetni ti kur da̱ŋ rɛw wi̱cdɛ jiɛn dhieec, kä bi kui̱c känyä ca̱ŋ a jua̱th tetni ti kur rɛw wi̱cdɛ jiɛn dhieec, kä bi kui̱c konyä cäŋ a jua̱th tetni ti kur da̱ŋ rɛw wi̱cdɛ jiɛn dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duɔth muɔ̱ɔ̱n in thieek kɛ kui̱c in rɛl gɔɔydɛ rɔ, bi bärɛ piny kui̱c känyä ca̱ŋ a jua̱th tetni ti bathdɔɔri da̱ŋ wäl, kä bi kui̱c konyä ca̱ŋ tekɛ jua̱th tetni ti bathdɔɔri da̱ŋ wäl, kä bɛ thiëëk kɛ kui̱c in rɛl gɔɔydɛ rɔ. Kä ba jɛ a piɛth kɛ ɛ ji̱ wec kɛ ti ba cam. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ji̱ wec diaal tin la ji̱ thukni duëli I-thɛ-rɛl jɛ pith. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn mun in bi kuany go̱lä kɛ kui̱ lätni ti̱ti̱ bɛ la jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec ala mi päär kui̱nikɛ diaal. Kä mɛmɛ ɛ kui̱c muɔ̱ɔ̱n in rɛl gɔɔydɛ rɔ kɛnɛ mun wec in ba ŋɔak la̱t thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɔ bi duɔth piny ɔ kä kui̱c in rɛl gɔɔydɛ rɔ kɛnɛ mun in la duŋ wec bɛ la duŋ rueecä. Kä bɛ ka̱n ni kui̱c in rɛl gɔɔydɛ rɔ min tekɛ jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec a wä ni këth kuec känyä ca̱ŋ, kä lɛnɛ jɛ ka̱n ni kui̱c konyä ca̱ŋ gua̱a̱th in tekɛ jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec a wä ni këth kui̱c konyä cäŋ, min car rɔ kɛ mun ji̱ thukni duëli, bɛ a duŋ rueecä. Kä bi kui̱c in rɛl gɔɔydɛ rɔ kɛnɛ luaak Kuɔth te ni däär. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi kui̱c ji̱ Lii-bay kɛnɛ wec te däär muɔ̱ɔ̱n rueecä. Kä kui̱c muɔ̱ɔ̱n rueecä bɛ te kamä muɔ̱ɔ̱n Juda kɛnɛ mun Ben-ya-min.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mun kɛ kui̱ thuk duëli tin kɔ̱ŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ thukni duëli tin kɔ̱kiɛn, a ka̱nɛ ni kui̱c känyä ca̱ŋ a wä ni kui̱ konyä ca̱ŋ, bi Ben-ya-min tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kuɛ ka̱n ni këth Ben-ya-min kui̱ känyä ca̱ŋ a wä kä kony ca̱ŋ bi Cim-on tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lɛnɛ ka̱n ni këth Cim-on kui̱c känyä ca̱ŋ a wä kä konyä ca̱ŋ, bi Yi-tha-kar tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kuɛ ka̱n ni këth Yi-tha-kar kui̱c känyä ca̱ŋ a wä kui̱ konyä ca̱ŋ, bi Dhɛ-bu-lun tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lɛnɛ ka̱n ni këth Dhɛ-bu-lun kui̱c känyä ca̱ŋ a wä kui̱ konyä ca̱ŋ, bi Gad tekɛ kui̱ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kuɛ ka̱n ni këth Gad a wä kui̱c cuëëc bi key rɔ tok nikä Ta-mar a wä ni tɔ̱ɔ̱rä Mɛ-ri-bath-ka-dec niɛ ɛn wani a wä ni dhiac dɔaar I-jëp a wä amäni Bar in te kam wi̱i̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɛmɛ ɛ jɛn mun in bia rɛl ala duŋdun yɛn ji̱ thukni duëli I-thɛ-rɛl diaal, kä ti̱ti̱ kɛ kui̱ckiɛn ruac ni ɣän Kuäär ni Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thuk Jɛ-ru-tha-lɛm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 48:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ti̱ti̱ a duɔ̱p wec tin bi a wä kɛ naath raar thi̱n. Bi pek kuec caam in bi theemnikɛ a jua̱th tetni ti bathdɔɔri da̱ŋ ŋuaan wi̱cdɛ kur dhieec, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "tekɛ thuk da̱ŋ diɔ̱k, thok kal Rɛ-u-ben, kɛ thok kal Juda, kɛ thok kal Lii-bay, kɛn thuk kal wec diaal ca kɛ cɔl kɛ ciööt thukni duëli ji̱ I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kui̱c känyä ca̱ŋ tëë kɛ jua̱th tetni ti bathdɔɔri da̱ŋ ŋuaan wi̱cdɛ kur dhieec, bɛ tekɛ thuk käli da̱ŋ diɔ̱k, thok kal Jo-thɛp, kɛnɛ thok kal Ben-ya-min, kɛ thok kal Daan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi pek kuec cuëëc tekɛ theemni jua̱thni tetni ti bathdɔɔri da̱ŋ ŋuaan wi̱cdɛ kur dhieec, bɛ tekɛ thuk käli da̱ŋ diɔ̱k, thok kal Cim-on, kɛ thok kal Yi-tha-kar, kɛ thok kal Dhɛ-bu-lun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi kui̱c konyä ca̱ŋ min theemnikɛ kɛ jua̱th tetni ti bathdɔɔri da̱ŋ ŋuaan wi̱cdɛ kur dhieec, bɛ tekɛ thuk käli da̱ŋ diɔ̱k, thok kal Gad, kɛ thok kal A-cɛr, kɛ thok kal Nap-ta-li. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn wec ni kɛɛliw bɛ a jua̱th tetni ti bathdɔɔri wäl wi̱cdɛ bädäk. Kä bi ciötdɛ ɛn wec niɛn guäth ɛmɔ a wee wä a ɣöö, Kuoth Nhial a wa̱nɔ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    }
