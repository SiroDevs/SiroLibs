    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puɔ̱th Kuɔth kɛ I-thɛ-rɛl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ji̱n lö gat ran lätni pääm I-thɛ-rɛl ruac go̱o̱kä läri jɛ kɛ, i̱ lö pääm I-thɛ-rɛl liɛŋɛ ruac Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.1",
            "verseOrgIds": [
              "EZK.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɛmɛ ɛ jɛn ruac Kua̱r ni Kuoth Nhial wëë i̱, “Kɛ ɣöö jio̱k gua̱n tɛ̈r ji̱ i̱, ‘Ɣa, kɛn pääm tëë wal cikɛn a nyin kɔn.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.2",
            "verseOrgIds": [
              "EZK.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, lat ruac go̱o̱kä, larɛ ɛn ɣöö ɛ Kuäär ni Kuoth Nhialɛ i̱, ‘Kɛ ɣöö ɛpuc, ca ji̱ jakä pa̱lkɛ ni baaŋ a thil raan, kä ca ji̱ däk pekni diaal kɛ ɣöö bi duɔth dööri ji̱ ka̱n ala duŋdiɛn, kä ci cua̱ cäät mi ŋɛ̈rkɛ rɛy dööri.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.3",
            "verseOrgIds": [
              "EZK.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, lö pääm I-thɛ-rɛl liɛŋɛ ruac Kua̱r ni Kuoth, mɛmɛ ɛ min ci Kuäär ni Kuoth ɛ la̱r pääm I-thɛ-rɛl kɛnɛ bi̱eli kɛ yiër kɛnɛ löli, kɛ wi̱i̱ tin ca päl baaŋ a ci da̱k, tin ca pɛ̈c kä dɔalkɛ ɛ döör diaal tin kɔ̱ŋ tin ca jɛ go̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.4",
            "verseOrgIds": [
              "EZK.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, lar Kuäär ni Kuoth Nhial ɛ wëë i̱, ‘Ɣän ruacä a jiäk kɛ tiɛla min bɛc bɛc kɛ duɔth dööri ti̱ti̱, kä gakä kɛ ji̱ Ɛ-dɔm diaal, tëë ca mundä ka̱n ala duŋdiɛn nikɛ tɛ̈th lɔaac mi di̱i̱t, kɛ ɣöö bikɛ dɔr walkɛ min gɔaa ka̱n.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.5",
            "verseOrgIds": [
              "EZK.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, lat ruac go̱o̱kä kɛ kui̱ muɔ̱ɔ̱n I-thɛ-rɛl, kä läri jɛ pääm kɛnɛ bi̱eli kɛ yiër kɛnɛ löli ɛn ɣöö mɛmɛ ɛ ruac Kua̱r ni Kuoth Nhial wëë i̱, ‘Ɣän ruacä kɛ lëth gaakdä kɛnɛ waŋ lɔaac, kɛ ɣöö cia cuuc kɛ kuethni dööri.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.6",
            "verseOrgIds": [
              "EZK.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, mɛmɛ larɛ ɣän Kuäär ni Kuoth Nhial ɛn ɣöö kɛn döör ti̱ti̱ diaal ti ca yɛ go̱l ti, cä rɔ yac ɛn ɣöö bi lɛ cuuc nikɛn kɛ kuethni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.7",
            "verseOrgIds": [
              "EZK.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.7",
            "verseOrgIds": [
              "EZK.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Duundɛ ɣöö yɛn pääm I-thɛ-rɛl, bia piith kɛ kar, kä bia dɛy kuir kɛ kui̱ nɛɛnikä ni ji̱ I-thɛ-rɛl. Kɛ ɣöö bikɛ luny cieŋ kɛ pɛ̈th. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.8",
            "verseOrgIds": [
              "EZK.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛ̈nɛ jɛ täämɛ, ɣän ta̱a̱ kɛɛl kɛ yɛ, ɣän bä luny kä yɛ, ba yɛ pur kä ba yɛ pith. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.9",
            "verseOrgIds": [
              "EZK.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän bä ji̱ wecdun rep, amäni thuk duëli I-thɛ-rɛl diaal. Ba wi̱i̱ diaal ciɛŋ kä ba gua̱th tëë ci da̱k nyɔk kɛ lätni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.10",
            "verseOrgIds": [
              "EZK.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä naath kɛnɛ ley jakä ŋuan wi̱i̱dun. Bikɛ rɔ̱ rep kä bikɛ gaat ti ŋuan dap. Kä bä ji̱ jakä ciaŋkɛ, ce̱tnikɛ ciaaŋdu ëë wal, kä bä ŋɔak ti ŋuan ti gɔw ti lënykɛ tëë wal lät kä ji̱. Kä bi jɛ cu ŋäc ɛn ɣöö ɛ ɣän Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.11",
            "verseOrgIds": [
              "EZK.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä naath nööŋ rɛydu, nɛɛkä ni ji̱ I-thɛ-rɛl bikɛ ji̱ ciɛŋ ala duŋdiɛn, kä bi cua̱ gua̱a̱th ciɛŋädiɛn. Kä cikɛ bi̱lɛ nyɔk kɛ pen gaatkiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.12",
            "verseOrgIds": [
              "EZK.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.12",
            "verseOrgIds": [
              "EZK.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ kui̱ ɛmɔ, cu Kuäär ni Kuoth Nhial ruac ɛn ɣöö, kɛ ɣöö ca ji̱ jiök i̱, ‘Ji̱n ci naath cam kä ci gaat dööru mac,’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.13",
            "verseOrgIds": [
              "EZK.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ kui̱ ɛmɔ, ji̱n /ci naath bi̱lɛ nyɔk kɛ ca̱m kä /ci gaat dööri bi̱lɛ nyɔk kɛ ma̱c, ruac ni ɣän Kuäär ni Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.14",
            "verseOrgIds": [
              "EZK.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cä ji̱ bi nyɔk kɛ jakä ɣöö liŋi kuethni dööri, kä /ci buar dööri bi nyɔk kɛ ruɔ̱t. Kä /ci do̱ru bilɛ jakä tɛth, ruac ni ɣän Kuäär ni Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.15",
            "verseOrgIds": [
              "EZK.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tëk I-thɛ-rɛl mi pay tuɔɔk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.15",
            "verseOrgIds": [
              "EZK.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ruac Kuɔth Nhial ben kä ɣä wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.16",
            "verseOrgIds": [
              "EZK.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gat ran, mëë cieŋ ji̱ I-thɛ-rɛl muundiɛn, cukɛ jɛ ya̱r kɛ duɔ̱pkiɛn kɛnɛ lätkiɛn. Kä ciaaŋdiɛn waaŋdä cu jiääkdɛ pa̱a̱r nikɛ jiääk ciëk mi tekɛ buɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.17",
            "verseOrgIds": [
              "EZK.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ, cua̱ ŋɛ̈ɛ̈nydä wuɔ̱ckɛ kɛ kui̱ riɛm in cikɛn ɛ wuɔ̱th piny muun kɛnɛ kui̱ kuthni guäyni tëë yär kɛn wec kɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.18",
            "verseOrgIds": [
              "EZK.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ kɛ riaw kä rɛy dööri, kä cua kɛ kiɛth rɛy wi̱i̱ni, ce̱tnikɛ ta̱a̱diɛn kɛ ciɛŋkiɛn kɛnɛ lätkiɛn cua̱kɛ luk. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.19",
            "verseOrgIds": [
              "EZK.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö, gua̱thni diaal tëë cikɛ wä thi̱n kä döör cikɛ ciötdä min rɛl rɔ mockɛ buar, kɛ ɣöö ruac naath kɛ kui̱diɛn wäkɛ i̱, ‘Kɛn ti̱ti̱ kɛ nɛɛ Kuɔth Nhial, kä ŋotdɛ ba̱nykɛ mun Kuɔthdiɛn piny.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.20",
            "verseOrgIds": [
              "EZK.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö, ɣän ta̱a̱ kɛ kui̱ cio̱tädä min rɛl rɔ, min ci ji̱ thuɔk duëël I-thɛ-rɛl ɛ ya̱r, rɛy dööri tëë cikɛ wä thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ kui̱ ɛmɔ, läri mɛmɛ thok duëël I-thɛ-rɛl, ɛ Kuäär ni Kuoth Nhial i̱, ‘/Ciɛ kui̱dun ɛn min bä lät ni nɛmɛ lö thok duëël I-thɛ-rɛl, la̱tdä jɛ kɛ kui̱ cio̱tädä min rɛl gɔɔydɛ rɔ, min cia ya̱r rɛy dööri tëë cia wä thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.22",
            "verseOrgIds": [
              "EZK.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä ciötdä mëë cia ya̱r rɛy dööri jakä gɔaa. Kä bi döör ɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial, ruac ni Kuäär ni Kuoth Nhial, mi wa̱a̱ gɔɔydä nyoth rɛydun nhiam dööri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.23",
            "verseOrgIds": [
              "EZK.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä yɛ nööŋ raar rɛy dööri diaal kä bä yɛ ruɔ̱ɔ̱l rɛy wi̱i̱ni diaal, kä bä yɛ nööŋ ni rɛy wecdun pa̱ny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.24",
            "verseOrgIds": [
              "EZK.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä yɛ kith kɛ pi̱w ti gɔw, bia cu gɔw kä jiäkun diaal, kä bä yɛ jakä gɔw kä kuth guäynikun diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.25",
            "verseOrgIds": [
              "EZK.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä yɛ moc kɛ lɔc mi gɔaa, kɛnɛ ca̱r mi gɔaa. Kä bä buɔ̱m lɔaac woc kä yɛ, bä yɛ ka̱m ni lɔc mi gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.26",
            "verseOrgIds": [
              "EZK.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä yiëëdä la̱th rɛydun, kä bä yɛ jakä guɔ̱ɔ̱rɛ ŋuɔ̱tkä, kä bia luëëkä luɔ̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.27",
            "verseOrgIds": [
              "EZK.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ, bia cu cieŋ ɛn muun ëë cä ka̱m gua̱ndɔɔŋnikun. Kä bi yɛn cua̱ nɛɛkä kä bi ɣän a Kuothdun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.28",
            "verseOrgIds": [
              "EZK.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä yɛ kän kä jiääk jiäkun diaal, kä bä yɛ moc kɛ bɛl ti ŋuan ɛlɔ̱ŋ, kä cä yɛ bi̱lɛ nyɔk kɛ no̱ŋ buɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.29",
            "verseOrgIds": [
              "EZK.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä dɛy jiɛnkun kɛnɛ tin do̱ny ka̱a̱knikun jakä ŋuan, kɛ ɣöö /cia rɔ̱, bi̱lɛ nyɔk kɛ cuɔ̱c kɛ buɔth rɛy dööri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.30",
            "verseOrgIds": [
              "EZK.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bia lät jiäknikun kɛnɛ ciɛŋ jiäknikun cu tim. Kä bia pua̱nykun lo̱k kɛ kui̱ nyuɔɔni kɛnɛ jiäkun diaal tëë cia la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.31",
            "verseOrgIds": [
              "EZK.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bia jɛ ŋa̱c ɛn ɣöö /cä mɛmɛ lät kɛ kui̱ gɔynikun. Pöcɛ kä dualɛ kɛ lätkun, lö thok duëël I-thɛ-rɛl ruac ni ɣän Kuäär ni Kuoth Nhial.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.32",
            "verseOrgIds": [
              "EZK.36.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.32",
            "verseOrgIds": [
              "EZK.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɛmɛ ɛ min laar Kuäär ni Kuoth Nhial ɛ wëë i̱, “Kɛ jɛn cäŋ in bä jak ni yɛ kä gɔw kä jiäkun, bä wec cu jakä ciaŋkɛ kä gua̱th tëë ca päl bakɛ nyɔk kɛ lätni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.33",
            "verseOrgIds": [
              "EZK.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ba mun ëë ca päl baaŋ pur, /cɛ bi la day ce̱tkɛ ta̱a̱ ëë la nɛ̈nkɛ jɛ ɛ nɛy tëë la ret kɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.34",
            "verseOrgIds": [
              "EZK.36.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bikɛ ruac wäkɛ i̱, ‘Ɛn mun ëë la te ni baaŋ jɛn cɛ ce̱tnikɛ kak E-dɛn. Kä wi̱i̱ tëë ca päl ala day tëë te baaŋ tëë ca däk ɛn täämɛ ciaŋkɛ kɛ, kä cikɛ buɔ̱m.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.35",
            "verseOrgIds": [
              "EZK.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛn döör tëë ci duɔth tin gölkɛ yɛ, bikɛn ɛ ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial, cä gua̱th tëë ci da̱k nyɔk kɛ lätni, kä cä tëë ca päl baaŋ nyɔk kɛ pi̱eth. Ɛ ɣän Kuoth Nhial ruac ɔ, kä bä jɛ la̱t.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.36",
            "verseOrgIds": [
              "EZK.36.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.36",
            "verseOrgIds": [
              "EZK.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuäär ni Kuoth Nhial ruac wëë i̱, “Ɣän bä ji̱ I-thɛ-rɛl jakä thieckɛ ɣä kɛ ɣöö bäkɛ lät kä mɛmɛ. Ɣän bäkɛ jakä rëpkɛ rɔ̱ ce̱tnikɛ det. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.37",
            "verseOrgIds": [
              "EZK.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱tnikɛ det mucni ti waŋkɛ tin la nööŋkɛ kä Jɛ-ru-tha-lɛm kɛ gua̱a̱th timnikɛ tin rɛl gɔɔydiɛn rɔ̱. Inɔ bi wi̱i̱ tëë ci da̱k thia̱ŋ kɛ naath. Kä bikɛn ɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.38",
            "verseOrgIds": [
              "EZK.36.38"
            ]
          }
        }
      ]
    }
