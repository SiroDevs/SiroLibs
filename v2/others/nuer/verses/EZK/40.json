            "number": "30",
            "style": "v",
            "sid": "EZK 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tëë kɛ ba̱ŋni kui̱ni diaal, bärɛ tëë kɛ jua̱th tetni ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec, kä tëë kɛ jua̱th tetni da̱ŋ dhieec kä ɣäp ɣääpdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
            "verseOrgIds": [
              "EZK.40.30"
            ]
          }
        },
