  "reference": "Jɔ̱Ɔ̱N 13",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
