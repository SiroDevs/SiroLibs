  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JHN 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Pay-lɛt Yecu naŋ, kä cuɛ jɛ jakä dua̱ckɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.1",
            "verseOrgIds": [
              "JHN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu lathkëëri thac mi ca tak kɛ kuiy la̱th wi̱i̱dɛ, kä cukɛ bi̱i̱ mi mɛr la̱th puɔ̱nydɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.2",
            "verseOrgIds": [
              "JHN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ ben kä jɛ, kä jiökɛ jɛ i̱, “Bi, Kuäär ji̱ Juudh jääny kɛ tëk.” Kä cukɛ jɛ pa̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.3",
            "verseOrgIds": [
              "JHN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Pay-lɛt loc raar, kä cuɛ naath jiök i̱, “Guɛcɛ jɛ, ɣän nöŋä jɛ yɛ, kɛ ɣöö bia jɛ ŋa̱c ɛn ɣöö thilɛ duer mi cä jek kä jɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.4",
            "verseOrgIds": [
              "JHN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yecu ben raar a ciɛŋɛ thac kuiyni kɛnɛ bi̱i̱ mi mɛr. Kä cu Pay-lɛt kɛ jiök i̱, “Guɛcɛ jɛ, jɛn ɛ ɛn wut!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.5",
            "verseOrgIds": [
              "JHN.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci bööth palä kɛnɛ lathkëëri jɛ nɛn, cukɛ wak kɛ jɔw mi di̱i̱t i̱, “Pua̱tdɛ jɛ jiaath, pua̱tdɛ jɛ jiaath!” Cu Pay-lɛt kɛ jiök i̱, “Naŋɛ jɛ ɛ yɛn pua̱nykun, bia jɛ wä pua̱t jiaath, kɛ ɣöö thilɛ duer mi cä jek kä jɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.6",
            "verseOrgIds": [
              "JHN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ji̱ Juudh ɛ loc i̱, “Kɔn ta̱kɔ kɛ ŋut, kä kɛ kui̱ ŋutdä ɛmɔ bɛ li̱w, kɛ ɣöö cɔlɛ rɔɔdɛ Gat Kuɔth.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.7",
            "verseOrgIds": [
              "JHN.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.7",
            "verseOrgIds": [
              "JHN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mëë ci Pay-lɛt ruaacni ti̱ti̱ liŋ, cuɛ dual ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.8",
            "verseOrgIds": [
              "JHN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ rɔ nyɔk kɛ wä guäth luɔ̱k, kä cuɛ Yecu thiec i̱, “Ji̱n bi̱i̱ nikä?” Kä thilɛ mi ci Yecu ɛ loc. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.9",
            "verseOrgIds": [
              "JHN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Pay-lɛt ɛ jiök i̱, “Lo̱ki ɣöö ruaci kɛ ɣä? Kui̱ci jɛ ɛn ɣöö ta̱a̱ kɛ lua̱ŋ mi dëë lony ni ji̱, kä ta̱a̱ kɛ lua̱ŋ mi dëë puɔ̱t ni ji̱ jiaath?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.10",
            "verseOrgIds": [
              "JHN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yecu jɛ jiök i̱, “Ji̱n thilɛ lua̱ŋ kɛ ɣä, ɛ ni mi /ca jɛ ka̱m ji̱ ni nhial. Kɛ kui̱ ɛmɔ ram ëë käm ɣä ji̱ cɛ duer kɛ duer mi di̱i̱t.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.11",
            "verseOrgIds": [
              "JHN.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä niɛ wanɔ cu Pay-lɛt luɔ̱nydɛ go̱r, duundɛ ɣöö cu ji̱ Juudh wak i̱, “Mi wi̱i̱ wut ɛmɔ lony, /ciɛ ji̱n määth kua̱r. Kä ram mi cɔl rɔ i̱ kuäär lo̱kɛ ni ruac Thii-thɛr.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.12",
            "verseOrgIds": [
              "JHN.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.12",
            "verseOrgIds": [
              "JHN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Pay-lɛt ruaacni ti̱ti̱ liŋ, cuɛ Yecu ciöl raar, kä cuɛ nyuur wi̱i̱ kɔam luɔ̱k, guäth mi cɔalkɛ i̱ “Ga-ba-tha” kɛ thok Ɣi-bɛ-ru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.13",
            "verseOrgIds": [
              "JHN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ɛ jɛn cäŋ riali ŋɔaani ikä kɛ kui̱ Ca̱ŋ Bälä, ce̱tdɛ kɛ gua̱a̱th ca̱ŋda̱a̱r. Cuɛ ji̱ Juudh jiök i̱, “Kuäärun in di̱i̱t ɛn!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.14",
            "verseOrgIds": [
              "JHN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ wak i̱, “Naŋɛ jɛ, Naŋɛ jɛ! Pua̱tdɛ jɛ jiaath!” Cu Pay-lɛt kɛ thiec i̱, “Bä Kuäärun jakä pua̱tkɛ jiaath?” Cu bööth palä tin di̱t wee i̱, “Thilɛ kɔ kuäär mi di̱i̱t dɔ̱diɛn ɛ ni Thii-thɛr kärɔa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jɛ ka̱m kɛ, kɛ ɣöö ba jɛ wä pua̱t jiaath.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puɔ̱t Yecu jiaath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ Yecu ka̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cuɛ ben raar a kapɛ jiathdɛ, cuɛ wä guäth mi cɔal i̱ “Gua̱a̱th Po̱o̱rä”, kä cɔalkɛ i̱ “Gɔl-gö-tha” kɛ thok Ɣi-bɛ-ru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.17",
            "verseOrgIds": [
              "JHN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ jɛ pua̱t jiaath ɛn wi̱ni kɛɛl kɛnɛ wutni da̱ŋ rɛw kɔ̱kiɛn. Te ram kɛl cueecdɛ kä te ram in dɔ̱ŋ caamdɛ, kä te Yecu däär. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.18",
            "verseOrgIds": [
              "JHN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Pay-lɛt ciöt gɔ̱a̱r puɔ̱ny jiaath, ca jɛ gɔ̱r i̱, “Yecu raan Na-dha-rɛth, Kuäär ji̱ Juudh.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.19",
            "verseOrgIds": [
              "JHN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ cu ji̱ Juudh ti ŋuan ruac ɛmɔ kuɛn, kɛ ɣöö thieek gua̱a̱th in ca Yecu pua̱t thi̱n kɛ wec. Kä ca jɛ gɔ̱r kɛ thok Ɣi-bɛ-ru, kɛ Lɛ̈-tin amäni thok Gɛ-rith. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.20",
            "verseOrgIds": [
              "JHN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu bööth palä tin di̱t Pay-lɛt jiök i̱, “/Cu jɛ gɔ̱r i̱, ‘Kuäär ji̱ Juudh,’ gɔ̱r ɛ i̱, ‘Cɛ lar i̱ ɛ ɣän Kuäär ji̱ Juudh.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.21",
            "verseOrgIds": [
              "JHN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Pay-lɛt kɛ jiök i̱, “Min cä gɔ̱r, cä gɔ̱r.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci lathkëëri Yecu ku pua̱t jiaath, cukɛ bieynikɛ dääk kä gua̱th da̱ŋ ŋuan a te ramɔ kɛ kɛl. Kä luɔ̱tdɛ thilɛ jɛ ko̱c, ca jɛ tak kɛɛl kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.23",
            "verseOrgIds": [
              "JHN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ ruac kä rɔ̱ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:24",
              "type": "text"
            },
            {
              "text": "Diit 22:18.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “/Cuar nɛ jɛ rɛt, yuɔrnɛ ni gaakni kä bɛ jɔɔc i̱ ɛ duŋ ŋa.” Mɛmɛ ɛ ɣöö bi ruac Kuɔth ëë ca gɔ̱r a thuɔ̱k i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu lathkëëri jɛ la̱t inɔ. Kä te man Yecu cuŋä gekä jiaath in ca Yecu pua̱t thi̱n, kɛnɛ manlendɛ, kɛ Mɛri min la ciek Ki-lo-päth, amäni Mɛri raan Mag-da-la. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.25",
            "verseOrgIds": [
              "JHN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Yecu man nɛn, kä te jakdɛ min nhɔkɛ cuŋä thiäkä, cuɛ man jiök i̱, “Ciek, nɔmɔ ɛ jɛn gatdu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jak jiök i̱, “Nɔmɔ ɛ jɛn muɔɔr.” Kä ni ɛn guäth ɛmɔ cu jak ɛ naŋ cieŋdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lia̱a̱ Yecu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä mɛmɛ, mëë ci Yecu ɛ ŋa̱c ɛn ɣöö ci ŋɔaani diaal ku thuuk, cuɛ mɛmɛ lat kɛ ɣöö bi ruacni Kuɔth tëë ca gɔ̱r a thuɔ̱k, cuɛ wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:28-29",
              "type": "text"
            },
            {
              "text": "Diit 69:21.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ci rɛw ɣä näk.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tëëkɛ dhaar mi ci thia̱ŋ kɛ kɔaŋ mi wac ɛn wanɔ. Cukɛ li̱pä mi ci thia̱a̱ŋ kɛ kɔaŋ, la̱th wi̱i̱ taŋ lurä, kä cua jɛ thi̱eŋ thok Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Yecu jɛ lot, cuɛ wee i̱, “Cɛ ku thuuk!” Cuɛ wi̱cdɛ guɔ̱l piny, kä cu yiëëdɛ cu jiɛɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yiëth buɔ̱lä Yecu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ɛn cäŋ ɛmɔ ɛ cäŋ mi rial naath rɔ̱ ikä kɛ jɛ, kɛ ɣöö cäŋ ɛ bëë mɔ ɛ cäŋ lɔ̱ŋä mi rɛl rɔ. Kä kɛ ɣöö ci ji̱ Juudh ɛ go̱r i̱ bi pua̱ny nɛɛni tɔ̱tɔ̱ duɔth wuɔ̱thni jiɛn tin cakɛ pua̱t thi̱n kɛ cäŋ lɔ̱ŋä. Cukɛ Pay-lɛt thiec kɛ ɣöö ba ciök nɛɛni tin ca pua̱t jiɛn töl, kä ba pua̱nykiɛn cu woc. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.31",
            "verseOrgIds": [
              "JHN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ cu lathkëëri ben, cukɛ ciök raam kɛl töl amäni ciök raam in dɔ̱diɛn tëë ca pua̱t kɛ jɛ kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.32",
            "verseOrgIds": [
              "JHN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cikɛ ben kä Yecu, cukɛ jɛ nɛn ɛn ɣöö cɛ thuŋ li̱w, /ka̱n ciökɛ lɛ töl. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.33",
            "verseOrgIds": [
              "JHN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ram kɛl kä lathkëëri bua̱lɛ yiɛth kɛ mut, kä ni kä kɛɛl cu riɛm kɛnɛ pi̱ lo̱ny raar",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.34",
            "verseOrgIds": [
              "JHN.19.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:34",
              "type": "text"
            },
            {
              "text": "Dhɛk 12:10.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.34",
            "verseOrgIds": [
              "JHN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram ëë ci mɛmɛ nɛn, cɛ nëndɛ lat kɛ ɣöö dee yɛn ɛ ŋäth bä. Kä nëndɛ ɛ thuɔ̱k, kä ŋäcɛ ɣöö latdɛ ni thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.35",
            "verseOrgIds": [
              "JHN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ŋɔak ti̱ti̱ tuɔɔk, kɛ ɣöö bi ruacni tëë ca gɔ̱r a thuɔ̱ɔ̱k i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:36",
              "type": "text"
            },
            {
              "text": "Diit 34:20, Ɣöth 12:46.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Thilɛ cɔa̱a̱dɛ kɛl mi ba to̱l.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ca jɛ gɔ̱r rɛy ruacni Kuɔth bä i̱,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:37",
              "type": "text"
            },
            {
              "text": "Dhɛk 12:10.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Bikɛ ram ëë cikɛn ɛ yiɛth guic.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuɔ̱ny Yecu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä mɛmɛ, cu Jo-thɛp raan A-ri-ma-thia, mëë guur Yecu kɛ tɛ̱̈ɛ̱̈ kɛ ɣöö dualɛ kɛ ji̱ Juudh, Pay-lɛt thiec, kɛ ɣöö derɛ puɔ̱ny Yecu wä kony. Cu Pay-lɛt ɛ nhök jɛ, cuɛ ben kä cuɛ puɔ̱ny Yecu naŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ni-kɔ-di̱i̱-mäth ben bä, ram ëë ci kɔŋ ben kä Yecu kɛ wäär, no̱o̱ŋɛ ni wal kunyä ti ca liɔm, kä tekɛ ŋuäny mi gɔaa, mi te thiak thëmdɛ kɛ ki̱luni ti jiɛn diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ puɔ̱ny Yecu ka̱n, kä cukɛ jɛ rith kɛ bieyni kɛnɛ wal, kɛ ciaŋ kunyä ji̱ Juudh. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ gua̱a̱th ëë ca jɛ pua̱t thi̱n tëëkɛ kak wal mi tekɛ kɔ̱a̱a̱k mi ca guaŋ puɔ̱ny pa̱a̱m, kä /ka̱n raan met kony thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ puɔ̱ny Yecu tɔa̱a̱c thi̱n, kɛ ɣöö kɔ̱a̱a̱k kunyä ɛmɔ thia̱kɛ, kɛnɛ ɣöö ɛ cäŋ rialikä ŋɔaani kä ji̱ Juudh.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
      ]
    }
