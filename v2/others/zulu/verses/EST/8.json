        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikhophi yombhalo womyalo okufanele ikhishwe kuzo zonke izifundazwe yaziswa kubantu bonke, nokuthi amaJuda kwakumelwe alungele ngalolo suku ukuziphindiselela ezitheni zawo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.13",
            "verseOrgIds": [
              "EST.8.13"
            ]
          }
        }
      ]
    },
    {
