          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngalusuku lunye kuzo zonke izifunda zenkosi u-Ahashiveroshi, okungukuthi, ngosuku lweshumi nantathu lwenyanga yeshumi nambili, eyinyanga ka-Adari.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.12",
            "verseOrgIds": [
              "EST.8.12"
            ]
          }
        }
      ]
