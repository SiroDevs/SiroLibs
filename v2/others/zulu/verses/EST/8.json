          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke amadodana ayegibele iminyuzi namakamela aphuma ngokushesha, ayala ngesiyalezo senkosi. Futhi umyalo wanikezwa esigodlweni uSusan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.14",
            "verseOrgIds": [
              "EST.8.14"
            ]
          }
        }
      ]
    },
