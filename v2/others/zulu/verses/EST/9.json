          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaJuda anquma futhi azithathela wona kanye nenzalo yawo nabo bonke abazihlanganisa nawo, ukuze kungapheli, ukuthi bagcine lezi zinsuku ezimbili njengemibhalo yabo nangesikhathi sazo esimisiwe unyaka nonyaka;",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        }
      ]
