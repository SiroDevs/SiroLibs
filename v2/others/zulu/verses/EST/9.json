          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathumela izincwadi kubo bonke abaJuda ezifundeni eziyikhulu namashumi amabili nesikhombisa zombuso ka-Ahashiveroshi, ngamazwi okuthula neqiniso,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        }
