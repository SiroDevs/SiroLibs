          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungakho namuhla baqamba igama elithi iPhurimi ngegama lePhure. Ngakho, ngenxa yawo wonke amazwi ale ncwadi, nalokho abakubonayo, abafika kubo ngale ndaba,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
