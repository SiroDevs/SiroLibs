          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze kuqinise lezo zinsuku zePhurimi ngezikhathi zazo ezimisiweyo, njengalokho uMoridekayi umJuda no-Esteri indlovukazi babayala, nanjengoko bezinqumile bona nenzalo yabo, izindaba zokuzila ukudla nokubiza kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        }
