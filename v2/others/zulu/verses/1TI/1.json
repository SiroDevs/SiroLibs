            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha umusa weNkosi yethu wavama kakhulu kanye nokukholwa nothando olukuKristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        }
      ]
