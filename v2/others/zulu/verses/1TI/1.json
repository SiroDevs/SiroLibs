          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likholekile leli zwi, lifanele ukwamukelwa konke, ukuthi uKristu Jesu weza ezweni ukusindisa izoni; engiyinduna yabo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        }
      ]
    },
