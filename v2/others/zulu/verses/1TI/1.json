              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "okukhona abanye sebephambukile baphambukela enkulumeni eyize;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.6",
            "verseOrgIds": [
              "1TI.1.6"
            ]
