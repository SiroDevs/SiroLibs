          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyambonga ongenzele amandla, uKristu Jesu iNkosi yethu, ngokuba wathi ngikholekile, engimisa enkonzweni;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        }
