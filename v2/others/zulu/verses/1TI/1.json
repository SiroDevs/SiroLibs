          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngake ngaba ngumhlambazi, nomzingeli, nomhlukumezi, kodwa ngahawukelwa, ngokuba ngangikwenza ngokungazi ngokungakholwa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        }
