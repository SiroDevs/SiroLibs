          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyo iNkosi yaphakade, engabhubhiyo, engabonakali, uNkulunkulu yedwa, makube ludumo nenkazimulo kuze kube phakade naphakade. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        }
