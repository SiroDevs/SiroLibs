          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izifebe, labazingcolisa kanye labantu, amasela abantu, abaqambimanga, abafunga amanga, njalo uba kukhona okunye okuphambana lemfundiso ephilileyo;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        }
