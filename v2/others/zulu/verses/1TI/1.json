            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengalokhu ngakuncenga ukuthi uhlale e-Efesu, ekungeneni kwami eMakedoniya, ukuze uyale abanye ukuthi bangafundisi enye imfundiso;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.3",
            "verseOrgIds": [
              "1TI.1.3"
            ]
          }
        }
      ]
    },
    {
