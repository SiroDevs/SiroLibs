          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "sisazi lokhu ukuthi umthetho kawumiselwe olungileyo, kodwa ongelamthetho, labangalaleliyo, abangamesabi uNkulunkulu, lezoni, abangcolileyo, labangcolileyo, ababulali oyise, ababulali babonina, ababulali;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        }
