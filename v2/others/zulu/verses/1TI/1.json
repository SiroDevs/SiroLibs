            "sid": "1TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawuli, umphostoli kaKristu Jesu ngomyalo kaNkulunkulu uMsindisi wethu noweNkosi uJesu Kristu, ithemba lethu;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        }
      ]
    },
    {
