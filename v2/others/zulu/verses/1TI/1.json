            "sid": "1TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha isiphetho somyalo siluthando oluphuma enhliziyweni ehlanzekileyo, nakunembeza omuhle, nasekukholweni okungazenzisi;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.5",
            "verseOrgIds": [
              "1TI.1.5"
            ]
          }
        }
      ]
    },
