          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zindla ngalezizinto; zinike ngokuphelele kuzo; ukuze ukuqhubeka kwakho kubonakale kubo bonke.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.15",
            "verseOrgIds": [
              "1TI.4.15"
            ]
          }
        }
      ]
    },
