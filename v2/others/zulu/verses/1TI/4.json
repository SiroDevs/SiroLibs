          "attrs": {
            "verseId": "1TI.4.15",
            "verseOrgIds": [
              "1TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziqaphele wena nesifundiso; hlala kuzo, ngokuba ngokwenza lokho uyakuzisindisa wena nabakuzwayo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.16",
            "verseOrgIds": [
              "1TI.4.16"
            ]
          }
        }
