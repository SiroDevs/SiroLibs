        {
          "text": "Nalaba mabaqale bahlolwe; khona-ke mabasebenzise isikhundla sobudikoni bengasoleki.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.10",
            "verseOrgIds": [
              "1TI.3.10"
