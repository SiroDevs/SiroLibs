          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phezu kwalokho umelwe ukunobufakazi obuhle kwabangaphandle; funa awele esihlazweni nasogibeni lukaSathane.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
