          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma ngilibala, ukuze wazi ukuthi kufanele ukuziphatha kanjani endlini kaNkulunkulu, eyibandla likaNkulunkulu ophilayo, insika nesisekelo seqiniso.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
