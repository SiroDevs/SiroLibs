      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongadakwanga iwayini, ongesiye oshayayo, ongahaheli inzuzo embi; kodwa ibekezele, ingabi yingxabano, ingabi ngabahahayo;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.3",
            "verseOrgIds": [
              "1TI.3.3"
            ]
          }
        }
      ]
    },
    {
