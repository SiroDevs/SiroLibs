          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanjalo omkabo mababe nesizotha, bangabi ngabahlebi, abaqondileyo, abathembekile ezintweni zonke.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
