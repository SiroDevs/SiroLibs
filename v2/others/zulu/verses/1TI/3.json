          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba abakhonze kahle bazizuzela udumo oluhle nesibindi esikhulu ekukholweni okukuKristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
