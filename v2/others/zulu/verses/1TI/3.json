          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunjalo namadiyakoni amelwe ukuba nesizotha, angabi ndimimbili, angabi ngabanakwa kakhulu, angahaheli inzuzo embi;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
