          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ngokuba uma umuntu engakwazi ukuphatha owakhe umuzi, angaliphatha kanjani ibandla likaNkulunkulu na?)",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        }
