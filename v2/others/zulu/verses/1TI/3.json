          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liqinisile izwi elithi: Uma umuntu efisa isikhundla sombonisi, unxanela umsebenzi omuhle;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        }
      ]
    },
    {
