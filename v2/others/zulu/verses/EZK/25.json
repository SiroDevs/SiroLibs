            "style": "v",
            "sid": "EZK 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.15",
            "verseOrgIds": [
              "EZK.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho isho kanje iNkosi uJehova, ithi: Bheka, ngiyakwelulela isandla sami phezu kwamaFilisti, nginqume amaKrethi, ngichithe insali ogwini lolwandle.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.16",
            "verseOrgIds": [
              "EZK.25.16"
            ]
          }
        }
