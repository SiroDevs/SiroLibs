              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuthi ophunyukayo ngalolosuku uzakuza kini ukuze akuzwe ngezindlebe zenu?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
            "verseOrgIds": [
