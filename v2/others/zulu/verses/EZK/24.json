          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wena ndodana yomuntu, akuyikuba mhla ngisusa kubo amandla abo, intokozo yenkazimulo yabo, isifiso samehlo abo, nalokho ababeka izinhliziyo zabo kukho, amadodana abo namadodakazi abo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.25",
            "verseOrgIds": [
              "EZK.24.25"
            ]
          }
        }
