            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndodana yomuntu, bheka, ngisusa isifiso samehlo akho ngokushaya; kodwa akumelwe nilile futhi nikhale, nezinyembezi zenu ngeke zigeleze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
        }
      ]
    },
