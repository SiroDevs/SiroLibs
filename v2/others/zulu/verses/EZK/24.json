            "number": "22",
            "style": "v",
            "sid": "EZK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi njengoba ngenzile, niyakwenza: aniyikuvala izindebe zenu, nidle isinkwa sabantu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.22",
