          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina, Jehova, ngikukhulumile; kuyakwenzeka, futhi ngiyakukwenza; angiyikubuyela emuva, futhi angiyikuyeka, futhi ngeke ngiphenduke; bayakukwahlulela njengezindlela zakho nangokwezenzo zakho, isho iNkosi uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        }
      ]
    },
