            "sid": "EZK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono kuyo indlu kaIsrayeli uthi: Itsho njalo iNkosi uJehova; “Bheka, ngiyayingcolisa indlu yami engcwele, ubuhle bamandla akho, isifiso samehlo akho nalokho umphefumulo wakho okuhawukelayo; amadodana enu namadodakazi enu aseleyo kini ayakuwa ngenkemba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.21",
            "verseOrgIds": [
              "EZK.24.21"
            ]
          }
        }
