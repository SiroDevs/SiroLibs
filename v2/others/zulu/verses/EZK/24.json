            "sid": "EZK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izibopho zenu ziyakuba semakhanda enu nezicathulo zenu ezinyaweni zenu; aniyikukhala, ningakhali; kodwa niyolila ngobubi benu, nilile omunye nomunye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.23",
            "verseOrgIds": [
