              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uHezekeli uyisibonakaliso kini: njengakho konke akwenzileyo niyakwenza; futhi lapho kufika, niyokwazi ukuthi ngiyiNkosi uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.24",
            "verseOrgIds": [
              "EZK.24.24"
            ]
          }
        }
