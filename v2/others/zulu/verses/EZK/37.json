          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono kubo uthi: Itsho njalo iNkosi uJehova; Bheka, ngiyakuthatha ukhuni lukaJosefa olusesandleni sika-Efrayimi nezizwe zakwa-Israyeli, abafowabo, ngibabeke kanye naye nezinkuni zakwaJuda, ngibenzele ukhuni olulodwa, babe munye esandleni sami.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.19",
            "verseOrgIds": [
              "EZK.37.19"
            ]
          }
        }
