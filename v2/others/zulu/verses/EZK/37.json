              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeke besazingcolisa ngezithombe zabo noma ngezinengiso zabo nanoma yiziphi iziphambeko zabo; kepha ngiyakubakhulula kuzo zonke izindawo zabo zokuhlala bonile, ngibahlanze; ngakho bazakuba ngabantu Kimi, lami ngibe nguNkulunkulu wabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.23",
            "verseOrgIds": [
              "EZK.37.23"
            ]
          }
        }
