          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho abantwana babantu bakini bekhuluma kuwe besithi: Kawufuni yini ukusitshengisa ukuthi uqondeni ngalokhu?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.18",
