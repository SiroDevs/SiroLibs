          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinti ozobhala kuzo kumelwe zibe sesandleni sakho phambi kwamehlo abo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.20",
