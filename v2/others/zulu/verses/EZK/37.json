          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inceku yami uDavide iyakuba yinkosi phezu kwabo; futhi bonke bayoba nomalusi oyedwa; bayakuhamba ngezimiso zami, bagcine izimiso zami, bazenze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.24",
            "verseOrgIds": [
