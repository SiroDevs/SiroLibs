          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubenza isizwe sinye ezweni ezintabeni zakwa-Israyeli; futhi inkosi eyodwa iyoba yinkosi phezu kwabo bonke, futhi ngeke besaba izizwe ezimbili, futhi ngeke besahlukana babe imibuso emibili.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.22",
            "verseOrgIds": [
              "EZK.37.22"
            ]
          }
        }
