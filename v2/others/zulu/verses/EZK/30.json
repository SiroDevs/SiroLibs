              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho isho kanje iNkosi uJehova, ithi: Bheka, nginakho ngoFaro inkosi yaseGibithe; ngiyakwenza inkemba iwe esandleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.22",
            "verseOrgIds": [
