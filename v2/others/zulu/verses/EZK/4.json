          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi kimi: “Ndodana yomuntu, bheka, ngiyakwephula udondolo lwesinkwa eJerusalema, badle isinkwa ngesilinganiso nangokukhathazeka; futhi bayophuza amanzi ngesilinganiso nangokumangala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.16",
            "verseOrgIds": [
              "EZK.4.16"
            ]
          }
        }
      ]
    },
