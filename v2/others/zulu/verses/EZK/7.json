            "style": "v",
            "sid": "EZK 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.1",
            "verseOrgIds": [
              "EZK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, ndodana yomuntu, isho kanje iNkosi uJehova ezweni lakwa-Israyeli; Ukuphela, ukuphela sekufikile emagumbini omane ezwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.2",
            "verseOrgIds": [
              "EZK.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.2",
            "verseOrgIds": [
              "EZK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje ukuphela sekufikile phezu kwakho, futhi ngizothumela intukuthelo yami phezu kwakho futhi ngikwahlulele njengezindlela zakho futhi ngibuyisele kuwe ngazo zonke izinengiso zakho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.3",
            "verseOrgIds": [
              "EZK.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.3",
            "verseOrgIds": [
              "EZK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iso lami aliyikukuhawukela, futhi angiyikuba nesihe; ngiyakwehlisela izindlela zakho phezu kwakho, nezinengiso zakho zibe phakathi kwakho; nizokwazi ukuthi nginguJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.4",
            "verseOrgIds": [
              "EZK.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.4",
            "verseOrgIds": [
              "EZK.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isho kanje iNkosi uJehova, ithi: Ububi, ububi obubodwa, bheka, bufikile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.5",
            "verseOrgIds": [
              "EZK.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.5",
            "verseOrgIds": [
              "EZK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuphela kufikile, ukuphela kufikile; liyakuqapha; bheka, selifikile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.6",
            "verseOrgIds": [
              "EZK.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.6",
            "verseOrgIds": [
              "EZK.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukusa sekufikile kini, nina enihlala ezweni; isikhathi sesifikile, usuku lwenhlupheko luseduze, akusilo umsindo wezintaba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.7",
            "verseOrgIds": [
              "EZK.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.7",
            "verseOrgIds": [
              "EZK.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje ngiyakuthulula ukufutheka kwami phezu kwakho masinyane, intukuthelo yami iphumele phezu kwakho; ngiyakukwahlulela njengezindlela zakho, ngibuyisele kuwe zonke izinengiso zakho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.8",
            "verseOrgIds": [
              "EZK.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.8",
            "verseOrgIds": [
              "EZK.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iso lami aliyikuhawukela, futhi angiyikuba nesihe; ngiyakukubuyisela ngokwezindlela zakho nezinengiso zakho eziphakathi kwakho; niyakwazi ukuthi nginguJehova oshayayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.9",
            "verseOrgIds": [
              "EZK.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.9",
            "verseOrgIds": [
              "EZK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, usuku, bheka, luyeza; kwasa kwadlula; yopha induku, kwaqhuma ukuziqhenya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.10",
            "verseOrgIds": [
              "EZK.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.10",
            "verseOrgIds": [
              "EZK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubudlwangudlwangu buvukile baba yinduku yobubi; akuyikusala noyedwa kubo, nasesixukuni sabo, nasebantwini babo, akuyikubakho ukukhala phezu kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.11",
            "verseOrgIds": [
              "EZK.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.11",
            "verseOrgIds": [
              "EZK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isikhathi sesifikile, usuku luyasondela; umthengi makangathokozi, nomthengisi angalili, ngokuba ulaka luphezu kwesixuku sakhe sonke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.12",
            "verseOrgIds": [
              "EZK.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
