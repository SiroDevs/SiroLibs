        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.12",
            "verseOrgIds": [
              "EZK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba umthengisi ngeke abuyele kulokho okuthengiswayo, nakuba esaphila; ngoba umbono uthinta lonke ixuku lawo elingayikubuya; futhi akekho oyomqinisa ebubini bempilo yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
