              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.1",
            "verseOrgIds": [
              "EZK.7.1"
            ]
          }
        }
