          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.15",
            "verseOrgIds": [
              "EZK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa labo abababalekelayo bayakubalekela, babe sezintabeni njengamajuba aphuma ezigodini, bonke belila, kube yilowo nalowo ngenxa yobubi bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.16",
            "verseOrgIds": [
              "EZK.7.16"
            ]
          }
        }
      ]
    },
