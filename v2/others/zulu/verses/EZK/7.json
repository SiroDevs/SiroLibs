          "type": "text",
          "attrs": {
            "verseId": "EZK.7.16",
            "verseOrgIds": [
              "EZK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izandla ziyakuba buthakathaka, namadolo onke ayakuba buthakathaka njengamanzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.17",
            "verseOrgIds": [
              "EZK.7.17"
            ]
          }
        }
      ]
    },
    {
