          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babetha icilongo ukuze balungise konke; kepha akakho oya empini, ngokuba ulaka lwami luphezu kwaso sonke isixuku sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.14",
            "verseOrgIds": [
              "EZK.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
