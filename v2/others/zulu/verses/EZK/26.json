              "type": "text"
            }
          ]
        },
        {
          "text": "Manje iziqhingi ziyothuthumela ngosuku lokuwa kwakho; yebo, iziqhingi ezisolwandle ziyokhathazeka ngokumuka kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
