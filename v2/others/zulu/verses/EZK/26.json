        },
        {
          "text": "Bayakuphakamisela isililo ngawe, bathi kuwe: ‘Yeka ukubhujiswa kwakho, owawuhlalwa ngabasolwandle, umuzi odumileyo owawunamandla olwandle, wona nabakhileyo kuwo, ababebanga ukwesabeka kwabo konke okuhlala kuwo!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
