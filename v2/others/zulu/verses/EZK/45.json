              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku isikhulu kumelwe silungiselele inkunzi njengomnikelo wesono ngenxa yaso nabo bonke abantu bezwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
