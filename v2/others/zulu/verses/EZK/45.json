          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsuku eziyisikhombisa zomkhosi kumelwe alungisele uJehova umnikelo wokushiswa: izinkunzi eziyisikhombisa nezinqama eziyisikhombisa ezingenasici nsuku zonke izinsuku eziyisikhombisa; nezinyane lembuzi libe ngumnikelo wesono imihla ngemihla.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
