          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze kuthuthumele phambi kwami izinhlanzi zolwandle, nezinyoni zezulu, nezilwane zasendle, nezilwanyana ezinwabuzelayo emhlabeni, nabantu bonke abasemhlabeni, nezintaba zithuthumele. Idiliziwe, nemimango iyowa, nalo lonke udonga luyowela phansi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.20",
            "verseOrgIds": [
              "EZK.38.20"
            ]
          }
        }
