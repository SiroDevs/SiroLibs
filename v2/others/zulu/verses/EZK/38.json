            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngomhawu wami nangomlilo wentukuthelo yami ngakhuluma ngathi: Impela ngalolo suku kuyakuba khona ukuzamazama okukhulu ezweni lakwa-Israyeli;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.19",
            "verseOrgIds": [
              "EZK.38.19"
            ]
          }
        }
