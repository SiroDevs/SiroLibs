        },
        {
          "text": "Usho kanje uJehova, uthi: “Nguwe yini engakhuluma ngaye endulo ngesandla sezinceku zami abaprofethi bakwa-Israyeli ababeprofetha ngalezo zinsuku iminyaka eminingi ukuthi ngiyakukuyisa kubo na?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.17",
            "verseOrgIds": [
              "EZK.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
