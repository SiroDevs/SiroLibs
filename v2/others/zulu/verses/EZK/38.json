          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.17",
            "verseOrgIds": [
              "EZK.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngesikhathi uGogi efika ngokumelene nezwe lakwa-Israyeli, kusho uJehova, ukufutheka kwami kuyakuvuka ebusweni bami.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.18",
            "verseOrgIds": [
              "EZK.38.18"
            ]
          }
        }
