          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubiza inkemba phezu kwazo zonke izintaba zami,” usho uJehova, “inkemba yomuntu imelane nomfowabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.21",
            "verseOrgIds": [
              "EZK.38.21"
            ]
          }
        }
