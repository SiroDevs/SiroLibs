              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho izidalwa eziphilayo zihamba, amasondo ahamba nazo; kwathi lapho izidalwa eziphilayo ziphakanyiswa emhlabeni, amasondo aphakanyiswa.",
          "type": "text",
          "attrs": {
