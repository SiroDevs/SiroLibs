              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phezu komkhathi owawuphezu kwamakhanda azo kwakukhona okufana nesihlalo sobukhosi, kufana nokubonakala kwetshe lesafire;",
          "type": "text",
          "attrs": {
