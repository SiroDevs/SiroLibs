              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho umoya wawusiya khona, zaya khona, umoya wazo wawuhamba; amasondo aphakanyiswa ngokumelene nazo, ngokuba umoya wezidalwa eziphilayo wawusemasondo.",
          "type": "text",
          "attrs": {
