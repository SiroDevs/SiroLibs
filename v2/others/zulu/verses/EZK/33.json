          "type": "text",
          "attrs": {
            "verseId": "EZK.33.30",
            "verseOrgIds": [
              "EZK.33.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beza kuwe njengokuza kwabantu, bahlale phambi kwakho njengabantu bami, bezwe amazwi akho, kepha bangawenzi; ngoba ngomlomo wabo batshengisa uthando olukhulu, kodwa inhliziyo yabo ilandela ukuhaha kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.31",
            "verseOrgIds": [
              "EZK.33.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
