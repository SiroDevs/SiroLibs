        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.32",
            "verseOrgIds": [
              "EZK.33.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi lapho lokhu kwenzeka, bheka, kuyofika, khona-ke bayokwazi ukuthi kwakukhona umprofethi phakathi kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.33",
            "verseOrgIds": [
              "EZK.33.33"
            ]
          }
        }
