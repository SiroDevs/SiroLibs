          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.31",
            "verseOrgIds": [
              "EZK.33.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, kubo unjengehubo elimnandi kakhulu, onomsindo omnandi, obetha kahle ugubhu; ngokuba bayawezwa amazwi akho, kepha abawenzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.32",
            "verseOrgIds": [
              "EZK.33.32"
            ]
          }
        }
      ]
    },
