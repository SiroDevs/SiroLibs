          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayakwazi ukuthi nginguJehova, lapho sengichithe izwe ngenxa yazo zonke izinengiso zabo abazenzileyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.29",
            "verseOrgIds": [
              "EZK.33.29"
            ]
          }
        }
      ]
