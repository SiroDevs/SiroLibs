          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiyakwenza izwe libe yihlane, nobukhosi bamandla alo buphele; futhi izintaba zakwa-Israyeli ziyoba ihlane ukuze kungabikho muntu odabula kuzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.28",
            "verseOrgIds": [
              "EZK.33.28"
            ]
          }
        }
      ]
    },
