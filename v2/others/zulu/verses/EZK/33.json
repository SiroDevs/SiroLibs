          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimi phezu kwenkemba yenu, nenza izinengiso, ningcolisa, kube yilowo nalowo umfazi womakhelwane wakhe; futhi niyakudla ifa lezwe na?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.26",
            "verseOrgIds": [
