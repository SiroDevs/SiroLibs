          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisho kanje kubo, uthi: ‘Isho kanje iNkosi uJehova, ithi: Kuphila kwami, labo abasezincithakalweni bayakuwa ngenkemba, nosendle ngiyakumnika izilo ukuba adliwe, abasezinqabeni nasemigedeni bayakudabula isifo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.27",
            "verseOrgIds": [
              "EZK.33.27"
            ]
          }
        }
      ]
    },
