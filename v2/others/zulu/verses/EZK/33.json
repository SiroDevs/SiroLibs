            "verseOrgIds": [
              "EZK.33.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wena ndodana yomuntu, abantwana babantu bakini basakhuluma ngawe ezindongeni naseminyango yezindlu, bakhuluma omunye komunye, kube yilowo nalowo kumfowabo, bathi: ‘Wozani nizwe ukuthi liyini izwi. OkukaJehova kuphume.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.30",
            "verseOrgIds": [
              "EZK.33.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
