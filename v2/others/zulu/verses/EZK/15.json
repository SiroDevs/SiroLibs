        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.4",
            "verseOrgIds": [
              "EZK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, lapho usuphelele wawungenamsebenzi; kakhulu kangakanani-ke, uma umlilo uwudla uwushise, awulungele umsebenzi na?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.5",
            "verseOrgIds": [
              "EZK.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
