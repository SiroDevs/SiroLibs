          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.5",
            "verseOrgIds": [
              "EZK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho isho kanje iNkosi uJehova, ithi: Njengomvini phansi kwemithi yasehlathini engawunikela emlilweni ube zinkuni, kanjalo ngiyakunikela abakhileyo eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.6",
            "verseOrgIds": [
              "EZK.15.6"
            ]
          }
        }
      ]
    },
