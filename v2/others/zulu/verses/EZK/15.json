            "sid": "EZK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndodana yomuntu, umvini udlulani yonke imithi, negatsha eliphakathi kwemithi yasehlathini, na?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.2",
            "verseOrgIds": [
              "EZK.15.2"
            ]
          }
        }
