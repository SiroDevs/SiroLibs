          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.3",
            "verseOrgIds": [
              "EZK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, iphonswa emlilweni njengenkuni; umlilo udla imikhawulo yawo yomibili, nengaphakathi lawo liyasha. Ingabe ilungele noma yimuphi umsebenzi?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.4",
            "verseOrgIds": [
              "EZK.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
