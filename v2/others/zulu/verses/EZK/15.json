          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwenza izwe libe yihlane, ngokuba bonile, isho iNkosi uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.8",
            "verseOrgIds": [
              "EZK.15.8"
            ]
          }
        }
