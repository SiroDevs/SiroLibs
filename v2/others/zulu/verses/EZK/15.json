        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.2",
            "verseOrgIds": [
              "EZK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukhuni luyathathwa kuwo ukwenza umsebenzi othile na? noma abantu bayothatha isikhonkwane kuwo ukuze balengise okuthile kuwo?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.3",
            "verseOrgIds": [
              "EZK.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
