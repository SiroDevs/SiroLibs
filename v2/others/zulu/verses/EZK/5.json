            "number": "15",
            "style": "v",
            "sid": "EZK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.15",
            "verseOrgIds": [
              "EZK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho ngithumela kubo imicibisholo emibi yendlala, eyakuba ngeyokubhubhisa, engiyithumele ukuba ibhubhise nina; ngiyakwandisa indlala phezu kwenu, ngiphule udondolo lwesinkwa senu;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.16",
            "verseOrgIds": [
              "EZK.5.16"
            ]
          }
        }
      ]
    },
