        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho yithi kuyo indlu kaIsrayeli: Itsho njalo iNkosi; Angikwenzi lokhu ngenxa yenu nina ndlu yakwa-Israyeli, kepha ngenxa yegama lami elingcwele enilingcolisile phakathi kwezizwe eniye kuzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.22",
            "verseOrgIds": [
              "EZK.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
