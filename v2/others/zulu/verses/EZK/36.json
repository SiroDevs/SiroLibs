          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngiyakunikhipha phakathi kwezizwe, nginibuthe emazweni onke, nginilethe ezweni lakini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.24",
            "verseOrgIds": [
              "EZK.36.24"
            ]
          }
        }
      ]
    },
