              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.27",
            "verseOrgIds": [
              "EZK.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakuhlala ezweni engalinika oyihlo; niyakuba yisizwe sami, mina ngibe nguNkulunkulu kini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.28",
            "verseOrgIds": [
              "EZK.36.28"
            ]
          }
        }
      ]
    },
