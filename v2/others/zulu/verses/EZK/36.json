          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabahlakazela ezizweni, bahlakazeka emazweni; ngabahlulela ngokwendlela yabo nangezenzo zabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.19",
