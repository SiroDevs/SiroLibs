            "number": "33",
            "style": "v",
            "sid": "EZK 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: Mhla nginihlanza kubo bonke ububi benu, ngiyakunenza nihlale emizini, kwakhiwe amanxiwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.33",
            "verseOrgIds": [
              "EZK.36.33"
            ]
          }
        }
      ]
    },
