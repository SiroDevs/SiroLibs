        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho sebengenile ezizweni ababengena kuzo, balihlambalaza igama lami elingcwele ngokuthi kubo: “Laba bangabantu bakaJehova, basuka ezweni lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.20",
            "verseOrgIds": [
              "EZK.36.20"
            ]
          }
        }
      ]
    },
    {
