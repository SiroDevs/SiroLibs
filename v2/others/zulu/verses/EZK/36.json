          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakufaka uMoya wami phakathi kwenu, ngenze ukuba nihambe ngezimiso zami, nigcine izahlulelo zami, nizenze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.27",
            "verseOrgIds": [
              "EZK.36.27"
            ]
          }
        }
      ]
    },
