        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.31",
            "verseOrgIds": [
              "EZK.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angikwenzi lokhu ngenxa yenu, usho uJehova, makwazeke kini; yibani namahloni, nibe namahloni ngezindlela zenu nina ndlu ka-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.32",
            "verseOrgIds": [
              "EZK.36.32"
            ]
          }
        }
      ]
    },
