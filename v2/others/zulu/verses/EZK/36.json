            "number": "29",
            "style": "v",
            "sid": "EZK 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakunisindisa kukho konke ukungcola kwenu, ngibize amabele, ngiwandise, kungabikho indlala phezu kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.29",
            "verseOrgIds": [
              "EZK.36.29"
            ]
          }
        }
      ]
    },
