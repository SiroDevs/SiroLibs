        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.22",
            "verseOrgIds": [
              "EZK.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakungcwelisa igama lami elikhulu elingcoliswe phakathi kwezizwe, enilingcolisile phakathi kwazo; izizwe ziyakwazi ukuthi nginguJehova,” usho uJehova, “lapho ngingcwelisiwe kini phambi kwamehlo azo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.23",
            "verseOrgIds": [
              "EZK.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
