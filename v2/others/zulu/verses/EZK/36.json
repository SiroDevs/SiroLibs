            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona ngiyakufafaza amanzi ahlanzekileyo phezu kwenu, nihlambuluke; ngiyakunihlambulula kukho konke ukungcola kwenu nakubo bonke onkulunkulu benu abangcolileyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.25",
            "verseOrgIds": [
              "EZK.36.25"
            ]
          }
        }
      ]
    },
