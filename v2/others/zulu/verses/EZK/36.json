          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.20",
            "verseOrgIds": [
              "EZK.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngalihawukela igama lami elingcwele indlu ka-Israyeli eyalingcolisa phakathi kwezizwe eyaya kuzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        }
      ]
    },
    {
