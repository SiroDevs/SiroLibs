        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.23",
            "verseOrgIds": [
              "EZK.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
