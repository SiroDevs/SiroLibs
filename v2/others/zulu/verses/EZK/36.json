          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.25",
            "verseOrgIds": [
              "EZK.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuninika inhliziyo entsha, ngifake phakathi kwenu umoya omusha; ngiyakukhipha inhliziyo yetshe enyameni yenu, ngininike inhliziyo yenyama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.26",
            "verseOrgIds": [
              "EZK.36.26"
            ]
          }
        }
