            "number": "34",
            "style": "v",
            "sid": "EZK 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwe eliyincithakalo liyakulinywa, lisahlezi liyincithakalo emehlweni abo bonke abadlulayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.34",
            "verseOrgIds": [
