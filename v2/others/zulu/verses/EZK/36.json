          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwandisa isithelo somuthi nezithelo zensimu, ukuze ningabe nisakwamukela isihlamba sendlala phakathi kwezizwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.30",
            "verseOrgIds": [
              "EZK.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
