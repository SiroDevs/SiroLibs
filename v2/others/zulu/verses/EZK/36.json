            "number": "31",
            "style": "v",
            "sid": "EZK 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakukhumbula izindlela zenu ezimbi nezenzo zenu ebezingezinhle, ninengeke emehlweni enu ngenxa yobubi benu nangenxa yezinengiso zenu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.31",
            "verseOrgIds": [
              "EZK.36.31"
            ]
          }
        }
