          "attrs": {
            "verseId": "2JN.1.8",
            "verseOrgIds": [
              "2JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo oweqayo, njalo engahlali emfundisweni kaKristu, kalaNkulunkulu; Lowo ohlala emfundisweni kaKristu unabo bobabili uYise neNdodana.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.9",
            "verseOrgIds": [
              "2JN.1.9"
            ]
          }
        }
      ]
    },
    {
