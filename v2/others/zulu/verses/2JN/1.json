          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nginezinto eziningi zokunilobela zona, angithandi ukunilobela ngephepha noyinki, kodwa ngiyethemba ukuza kini, ngikhulume nani umlomo nomlomo, ukuze intokozo yethu igcwale.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        }
