            "verseId": "2JN.1.9",
            "verseOrgIds": [
              "2JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma kufika umuntu kini engalethi lesi sifundiso, ningamamukeli endlini yenu, ningambulisi;",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.10",
            "verseOrgIds": [
              "2JN.1.10"
            ]
          }
        }
      ]
    },
