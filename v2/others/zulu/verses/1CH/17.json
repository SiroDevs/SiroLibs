            "sid": "1CH 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, Jehova, izwi olikhulumile ngenceku yakho nangendlu yayo malime kuze kube phakade, wenze njengokusho kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.23",
            "verseOrgIds": [
              "1CH.17.23"
            ]
          }
        }
