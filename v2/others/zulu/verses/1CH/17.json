            "number": "21",
            "style": "v",
            "sid": "1CH 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisiphi isizwe emhlabeni esinjengabantu bakho u-Israyeli, uNkulunkulu ahamba ukubasihlengela bona sibe ngabantu bakhe, ukuze azenzele igama elikhulu nelesabekayo, ngokuxosha izizwe phambi kwabantu bakho owabakhulula eGibithe;?",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.21",
            "verseOrgIds": [
              "1CH.17.21"
            ]
          }
        }
      ]
    },
