          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba wena, Nkulunkulu wami, ushilo encekwini yakho ukuthi uyakumakhela indlu; ngalokho inceku yakho ifumene enhliziyweni yayo ukukhuleka phambi kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.25",
            "verseOrgIds": [
              "1CH.17.25"
            ]
          }
        }
