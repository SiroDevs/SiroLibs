          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova, akakho onjengawe, akakho uNkulunkulu ngaphandle kwakho njengakho konke esikuzwileyo ngezindlebe zethu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
              "1CH.17.20"
            ]
          }
        }
