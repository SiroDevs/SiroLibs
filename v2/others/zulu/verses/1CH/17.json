          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Jehova, ngenxa yenceku yakho nangokwenhliziyo yakho wenzile zonke lezi zinto ezinkulu ngokwenza zonke lezi zinto ezinkulu zaziwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
