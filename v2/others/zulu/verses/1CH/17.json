          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi makuqiniswe ukuthi igama lakho likhulu kuze kube phakade ngokuthi: UJehova Sebawoti unguNkulunkulu ka-Israyeli, uNkulunkulu ka-Israyeli; indlu yenceku yakho uDavide mayime phambi kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        }
      ]
