            "number": "6",
            "style": "v",
            "sid": "1CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UShemaya indodana kaNethaneli, umbhali, omunye wamaLevi, waliloba phambi kwenkosi nezikhulu noSadoki umpristi no-Ahimeleki indodana ka-Abiyathara naphambi kwezinhloko zezindlu zawoyise babapristi namaLevi; zithathelwe u-Eleyazare, nenye eka-Itamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.6",
            "verseOrgIds": [
              "1CH.24.6"
            ]
          }
        }
      ]
    },
