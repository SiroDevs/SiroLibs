            "sid": "1CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezi ziyizigaba zamadodana ka-Aroni: oNadabi, no-Abihu, no-Eleyazare, no-Itamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha oNadabi no-Abihu bafa ngaphambi kukayise, bengenamntwana; ngalokho u-Eleyazare no-Itamari babe ngabapristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wabahlukanisa, uZadoki emadodaneni ka-Eleyazare no-Ahimeleki emadodaneni ka-Itamari ngokwezikhulu zabo enkonzweni yabo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwafunyanwa izinhloko zamadodana ka-Eleyazare eziningi kunasemadodaneni ka-Itamari; bahlukana kanjalo. Emadodaneni ka-Eleyazare kwakukhona izinhloko zezindlu zoyise eziyishumi nesithupha, nesishiyagalombili emadodaneni ka-Itamari ngezindlu zawoyise.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.4",
            "verseOrgIds": [
              "1CH.24.4"
            ]
          }
        }
      ]
    },
    {
