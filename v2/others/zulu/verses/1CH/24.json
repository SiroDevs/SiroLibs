            "number": "5",
            "style": "v",
            "sid": "1CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base behlukaniswa ngenkatho, omunye nomunye; ngoba ababusi bendlu engcwele lababusi bendlu kaNkulunkulu babevela emadodaneni ka-Eleyazare emadodaneni ka-Itamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.5",
            "verseOrgIds": [
              "1CH.24.5"
            ]
          }
        }
      ]
    },
    {
