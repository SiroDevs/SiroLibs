        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Orinani wayesethi kuDavide: “Zithathele, inkosi yami, inkosi, yenze okuhle emehlweni ayo; bhekani, ngininika izinkomo zomnikelo wokushiswa, nezibhulo zibe yizinkuni, nokolweni womnikelo wempuphu; Nginikela ngakho konke.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
