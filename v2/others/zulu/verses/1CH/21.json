          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke inkosi uDavide yathi ku-Orinani: “Qha! kodwa ngokuqinisekile ngizokuthenga ngenani eliphelele, ngoba ngeke ngithathele uJehova okungokwakho, futhi angiyikunikela ngeminikelo yokushiswa ngaphandle kwezindleko.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.24",
            "verseOrgIds": [
              "1CH.21.24"
            ]
          }
        }
      ]
    },
