          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wayiyala ingelosi; wayesehosha inkemba yakhe futhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        }
