              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uDavide wayengenakuhamba phambi kwakhe ukubuza kuNkulunkulu, ngokuba wayesaba inkemba yengelosi kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
