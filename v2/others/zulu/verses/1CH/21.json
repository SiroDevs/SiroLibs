          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wamakhela khona uJehova i-altare, wanikela ngeminikelo yokushiswa neyokubonga, wakhuleka kuJehova; wamphendula ngomlilo ovela ezulwini phezu kwe-altare lomnikelo wokushiswa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        }
      ]
    },
