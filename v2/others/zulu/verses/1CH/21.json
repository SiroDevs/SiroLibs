          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Orinani waphenduka wayibona ingelosi; amadodana akhe amane ayenaye acasha. U-Orinani wayebhula ukolweni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.20",
