          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba itabernakele likaJehova uMose alenza ehlane ne-altare lomnikelo wokushiswa ngaleso sikhathi kwakusendaweni ephakeme yaseGibeyoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
