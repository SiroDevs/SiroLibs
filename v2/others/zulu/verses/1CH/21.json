          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wamnika u-Orinani amashekeli angamakhulu ayisithupha egolide ngesisindo saleyo ndawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        }
