            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa lapho ephikisa u-Israyeli, uJonathani indodana kaShimeya umfowabo kaDavide wambulala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        }
      ]
    },
