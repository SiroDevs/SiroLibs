            "sid": "1CH 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "UShelomoti nabafowabo babephethe yonke ingcebo yezinto ezingcwele, inkosi uDavide, nezinhloko zawoyise, nezinduna zezinkulungwane nezamakhulu, nezinduna zempi ezazingcwelisile.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        }
