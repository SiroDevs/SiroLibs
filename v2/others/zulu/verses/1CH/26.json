          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafowabo ku-Eliyezeri; indodana yakhe uRehabiya, no-Isaya indodana yakhe, noJoramu indodana yakhe, noZigri indodana yakhe, noShelomoti indodana yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
