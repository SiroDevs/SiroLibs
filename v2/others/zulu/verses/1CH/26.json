          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "KumaHebroni, uHashabiya nabafowabo, amadoda anamandla, inkulungwane namakhulu ayisikhombisa, babe yizinduna kwa-Israyeli ngaphesheya kweJordani ngasentshonalanga emsebenzini wonke kaJehova nasenkonzweni yenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
