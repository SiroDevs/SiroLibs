            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke uSamuweli umboni, noSawule indodana kaKishi, no-Abineri indodana kaNeri, noJowabe, indodana kaSeruya, abakungcwelisayo; futhi wonke umuntu owayengcwelisa okuthile kwakungaphansi kwesandla sikaShelomoti nabafowabo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        }
      ]
    },
