          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadodana kaJehiyeli; oSethamu noJoweli umfowabo ababephethe ingcebo yendlu kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.22",
