            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "KumaHebroni kwakukhona uJeriya inhloko yamaHebroni ngokwezizukulwane zawoyise. Ngomnyaka wamashumi amane wokubusa kukaDavide bafunwa, kwafunyanwa kubo amaqhawe anamandla eJazeri kwaGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafowabo, amaqhawe anamandla, babe yizinkulungwane ezimbili namakhulu ayisikhombisa izinhloko zezindlu zoyise, inkosi uDavide eyababeka phezu kwabakwaRubeni, nabakwaGadi, nengxenye yesizwe sakwaManase, emsebenzini wonke kaNkulunkulu nomsebenzi wenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.32",
            "verseOrgIds": [
              "1CH.26.32"
            ]
          }
        }
