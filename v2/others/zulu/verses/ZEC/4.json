            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangiphendula yathi: Kawukwazi yini ukuthi kuyini? Ngathi: Cha, nkosi yami!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
