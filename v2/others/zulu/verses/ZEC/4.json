        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengiphendula ngathi kuyo: Iyini le minqumo emibili ngakwesokunene sothi lwesibani nangakwesokhohlo salo na?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
