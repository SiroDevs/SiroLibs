          "attrs": {
            "verseId": "ZEC.11.16",
            "verseOrgIds": [
              "ZEC.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kumalusi okhonza izithombe oshiya umhlambi! inkemba iyakuba phezu kwengalo yakhe naphezu kweso lakhe lokunene; ingalo yakhe iyobuna ihlanzekile, neso lakhe lokunene liyoba mnyama ngokuphelele.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
      ]
    }
