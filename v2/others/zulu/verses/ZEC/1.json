            "sid": "ZEC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenyanga yesishiyagalombili, ngomnyaka wesibili kaDariyu, izwi likaJehova lafika kuZakariya, indodana kaBerekiya, indodana ka-Ido umprofethi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wabathukuthelela kakhulu oyihlo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho uthi kubo: Usho kanje uJehova Sebawoti; Phendukelani kimi, usho uJehova Sebawoti, ngibuyele kini, usho uJehova Sebawoti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningabi njengawoyihlo abaprofethi bokuqala abamemeza kubo, bathi: Usho kanje uJehova Sebawoti; Phendukani ezindleleni zenu ezimbi nasezenzweni zenu ezimbi, kepha kabalalelanga, kabangilalelanga, usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyihlo bangaphi? nabaprofethi baphila phakade na?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha amazwi ami nezimiso zami engayala ngakho izinceku zami abaprofethi, akubambanga yini koyihlo na? babuya, bathi: “Njengokuba uJehova Sebawoti wayehlosile ukwenza kithi njengezindlela zethu nezenzo zethu, wenze njalo kithi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwamashumi amabili nane lwenyanga yeshumi nanye, eyinyanga kaSebati, ngomnyaka wesibili kaDariyu, izwi likaJehova lafika kuZakariya, indodana kaBeregiya, indodana ka-Ido umprofethi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabuka ebusuku, bheka, nango umuntu ekhwele ihhashi elibomvu emi phakathi kwemibomvana eyayiphansi; futhi emva kwakhe kwakukhona amahhashi abomvu, ezimanakanaka namhlophe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.8",
            "verseOrgIds": [
              "ZEC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.8",
            "verseOrgIds": [
              "ZEC.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasengisithi: O nkosi yami, kuyini lokhu? Futhi ingelosi eyayikhuluma kimi yathi kimi: Ngizokukhombisa ukuthi kuyini.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu owayemi phakathi kwemibomvana waphendula wathi: Laba ngabathunywe nguJehova ukuthi badabule emhlabeni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bephendula ingelosi kaJehova eyayimi phakathi kwemibomvana, zathi: “Siwuhambile umhlaba, bheka, umhlaba wonke uhlezi uyaphumula.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayisiphendula ingelosi kaJehova, yathi: “Jehova Sebawoti, koze kube nini ungahawukeli iJerusalema nemizi yakwaJuda osuyithukuthelele le minyaka engamashumi ayisithupha na?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wayiphendula ingelosi eyayikhuluma nami ngamazwi amahle naduduzayo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingelosi eyayikhuluma nami yathi kimi: “Memeza uthi: ‘Usho kanje uJehova Sebawoti; Nginomhawu ngeJerusalema nangeSiyoni ngomhawu omkhulu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi angigculisekile kakhulu ngabeZizwe abaphumulile, ngoba nganginganelisekile kancane, futhi basiza osizini.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
            "verseOrgIds": [
              "ZEC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
            "verseOrgIds": [
              "ZEC.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho usho kanje uJehova, uthi: “Ngibuyele eJerusalema ngomusa; indlu yami iyakwakhiwa kulo,” usho uJehova Sebawoti, kwelulwe umucu phezu kweJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memeza futhi uthi: Usho kanje uJehova Sebawoti; Imizi yami iyokwandiswa ngokuchuma; uJehova usazoliduduza iSiyoni, alikhethe futhi iJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
