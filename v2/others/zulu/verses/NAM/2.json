            "verseId": "NAM.2.12",
            "verseOrgIds": [
              "NAM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani, ngimelene nani, usho uJehova Sebawoti, ngishise izinqola zalo zibe ngumusi, nenkemba idle amabhongo enu ezingonyama; ngiyakunquma impango yakho emhlabeni, nezwi lezithunywa zakho alisayikuzwakala.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.13",
            "verseOrgIds": [
              "NAM.2.13"
            ]
          }
        }
      ]
    }
