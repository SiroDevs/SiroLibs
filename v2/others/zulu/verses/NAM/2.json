          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.11",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NAM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingonyama idwengule izicucu okwanele amawundlu ayo, iklimele izingonyamakazi zayo, igcwalise imigodi yayo ngempango, nemihume yayo ngemifantu.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.12",
            "verseOrgIds": [
              "NAM.2.12"
            ]
          }
        }
      ]
    },
    {
