            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHiramu wenza amakhanzi, namafosholo, nezitsha. UHiramu wawuqeda umsebenzi okwakumelwe awenzele inkosi uSolomoni yendlu kaNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
