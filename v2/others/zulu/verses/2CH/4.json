              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza nezinqola zokuwasha, wenza nezitsha zokugezela phezu kwezinqola;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
