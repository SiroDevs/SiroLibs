          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza negceke labapristi, negceke elikhulu, neminyango yegceke, wayinameka iminyango yakhona ngethusi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
