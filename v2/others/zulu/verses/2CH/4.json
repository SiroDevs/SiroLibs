          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsika ezimbili, nezinsika, nezinduna ezaziphezu kwezinsika zombili, nemigexo emibili yokusibekela izinsika zombili ezaziphezu kwezinsika;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        }
