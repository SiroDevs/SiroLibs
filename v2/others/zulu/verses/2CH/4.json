          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walubeka ulwandle ngakwesokunene ohlangothini lwasempumalanga, olubheke eningizimu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
