          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wanquma ukwakhela igama likaJehova indlu, nendlu yombuso wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.1",
            "verseOrgIds": [
              "2CH.2.1"
            ]
          }
        }
      ]
    },
    {
