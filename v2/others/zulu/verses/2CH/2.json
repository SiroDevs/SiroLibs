              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.10",
            "verseOrgIds": [
              "2CH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHiramu inkosi yaseTire waphendula ngombhalo awuthumela kuSolomoni, wathi: “Ngokuba uJehova wayebathanda abantu bakhe, wakubeka inkosi phezu kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.11",
            "verseOrgIds": [
              "2CH.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.11",
            "verseOrgIds": [
              "2CH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHuramu wasesithi: Kayibusiswe iNKOSI uNkulunkulu kaIsrayeli, owenza izulu lomhlaba, owanika inkosi uDavida indodana ehlakaniphileyo, ehlakaniphileyo, eqedisisayo, eyamakhelayo iNKOSI indlu, lendlu eyayakha umbuso wayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.12",
            "verseOrgIds": [
              "2CH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.12",
            "verseOrgIds": [
              "2CH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje ngithumele indoda ehlakaniphile, ehlakaniphile, evela kubaba uHuramu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.13",
            "verseOrgIds": [
              "2CH.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.13",
            "verseOrgIds": [
              "2CH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodana yowesifazane wamadodakazi akwaDani, noyise wayengumuntu waseTire, ochwepheshile ekusebenzeni ngegolide nangesiliva, ngethusi, nangensimbi, nangetshe, nangokhuni, nangokububende, nangokuluhlaza, nangelineni elicolekileyo. Futhi ngokunsomi; nokuqopha noma yiluphi uhlobo lwamathuna, nokuthola yonke icebo eliyakulethwa kuye, kanye namaqili enu, namaqili enkosi yami uyihlo uDavide.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.14",
            "verseOrgIds": [
              "2CH.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.14",
            "verseOrgIds": [
              "2CH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje makathumele ukolweni nebhali, amafutha newayini inkosi yami eyakhuluma ngakho ezincekwini zayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.15",
            "verseOrgIds": [
              "2CH.2.15"
            ]
          }
        }
      ]
