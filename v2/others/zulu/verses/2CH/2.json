          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thina siyakugawula izinkuni eLebanoni njengokudinga kwenu; futhi kumelwe ukukhuphulele eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.16",
            "verseOrgIds": [
              "2CH.2.16"
            ]
          }
        }
