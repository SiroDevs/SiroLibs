          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bememeza ngezwi elikhulu ngolimi lwamaJuda kwabakhileyo eJerusalema ababesogangeni ukuba besabe futhi besabise; ukuze bawuthathe umuzi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.18",
            "verseOrgIds": [
              "2CH.32.18"
            ]
          }
        }
