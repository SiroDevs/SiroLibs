        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho inkosi uHezekiya no-Isaya umprofethi, indodana ka-Amose, bakhuleka, babiza ezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.20",
            "verseOrgIds": [
              "2CH.32.20"
            ]
          }
        }
