        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.18",
            "verseOrgIds": [
              "2CH.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhuluma kabi ngoNkulunkulu waseJerusalema njengonkulunkulu bezizwe zomhlaba, ababengumsebenzi wezandla zabantu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.19",
            "verseOrgIds": [
              "2CH.32.19"
            ]
          }
        }
