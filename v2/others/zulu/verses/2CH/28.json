  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "2CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ahazi wayeneminyaka engamashumi amabili ekuqaleni kwakhe ukubusa, wabusa iminyaka eyishumi nesithupha eJerusalema; kepha akenzanga okulungile emehlweni kaJehova njengoDavide uyise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.1",
            "verseOrgIds": [
              "2CH.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahamba ezindleleni zamakhosi akwa-Israyeli, wenzela noBali izithombe ezibunjiweyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.2",
            "verseOrgIds": [
              "2CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu kwalokho, wabangela ukuba kushunqe umusi esigodini sendodana kaHinomu futhi washisa abantwana bakhe ngomlilo njengezinengiso zezizwe uJehova azixosha phambi kwabantwana bakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.3",
            "verseOrgIds": [
              "2CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanikela ngomhlatshelo, washunqisa umusi ezindaweni eziphakemeyo, nasemagqumeni, naphansi kwayo yonke imithi eluhlaza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uJehova uNkulunkulu wakhe wamnikela esandleni senkosi yase-Aramu; bamehlula, bathumba kubo isixuku esikhulu, babayisa eDamaseku. Naye wanikelwa esandleni senkosi yakwa-Israyeli, yamshaya ngokuceka okukhulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.5",
            "verseOrgIds": [
              "2CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPheka indodana kaRemaliya wabulala kwaJuda izinkulungwane eziyikhulu namashumi amabili ngalusuku lunye, bonke bengamadoda anamandla; ngoba bamshiya uJehova uNkulunkulu wawoyise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.6",
            "verseOrgIds": [
              "2CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "USigri, iqhawe lakwa-Efrayimi, wabulala uMahaseya, indodana yenkosi, no-Ashirikamu umbusi wendlu, no-Elkana owayelandela inkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.7",
            "verseOrgIds": [
              "2CH.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.7",
            "verseOrgIds": [
              "2CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli bathumba abesifazane abayizinkulungwane ezingamakhulu amabili, amadodana namadodakazi abafowabo, bathatha nempango eningi kubo, bayiletha impango eSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
              "2CH.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha kwakukhona umprofethi kaJehova ogama lakhe lingu-Odedi; waphuma phambi kwempi eyafika eSamariya, wathi kuyo: “Bhekani, ngokuba uJehova uNkulunkulu wawoyihlo wayethukuthelele uJuda, wabanikela esandleni senu, nababulala ngokufutheka kwenu ifinyelela ezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.9",
            "verseOrgIds": [
              "2CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje nihlose ukuhlala phakathi kwabantwana bakwaJuda naseJerusalema njengezigqila nezigqilakazi zenu; kepha phakathi kwenu akukho sono kuJehova uNkulunkulu wenu na?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.10",
            "verseOrgIds": [
              "2CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngilaleleni manje, nisindise abathunjwa enabathumba kubafowenu, ngokuba ulaka lukaJehova luphezu kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.11",
            "verseOrgIds": [
              "2CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekusukuma abathile ezikhulwini zabantwana bakwaEfrayimi, u-Azariya indodana kaJohanani, noBerekiya indodana kaMeshilemoti, noJishikiya indodana kaShalumi, no-Amasa indodana kaHadilayi, bamelana nabaphuma impi;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.12",
            "verseOrgIds": [
              "2CH.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.12",
            "verseOrgIds": [
              "2CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "wasesithi kubo: Lingalethi izibotshwa lapha; ngoba njengoba sesonile kuJehova, lina lihlose ukwengezelela ezonweni zethu leziphambeko zethu; ngoba isiphambeko sethu sikhulu futhi kukhona intukuthelo evuthayo ngokumelene no-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke amadoda ahlomile ashiya iziboshwa nempango kubabusi nalo lonke ibandla.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.14",
            "verseOrgIds": [
              "2CH.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.14",
            "verseOrgIds": [
              "2CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asukuma amadoda ayebiziwe, athatha iziboshwa, agqokisa bonke ababenqunu phakathi kwabo, abembathisa, abagqokisa izicathulo, abanika ukuba badle, baphuze, abagcoba, abaphulukisa bonke ababuthakathaka babathwala ngezimbongolo, abaletha. EJeriko, umuzi wamasundu, kubafowabo; ngemva kwalokho babuyela eSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaleso sikhathi inkosi u-Ahazi yathumela emakhosini ase-Asiriya ukuba ayisize.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.16",
            "verseOrgIds": [
              "2CH.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.16",
            "verseOrgIds": [
              "2CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba abakwa-Edomi baphinda beza, banqoba uJuda, bathumba abathunjwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.17",
            "verseOrgIds": [
              "2CH.28.17"
            ]
          }
        }
      ]
    },
    {
