        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngesikhathi sokucindezeleka kwakhe wabuye waphambuka kuJehova; yiyo leyo nkosi u-Ahazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
              "2CH.28.22"
            ]
          }
        }
