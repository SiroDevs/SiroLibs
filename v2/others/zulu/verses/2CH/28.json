          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
              "2CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba u-Ahazi wathatha isabelo sendlu kaJehova lendlu yenkosi lezikhulu wasinika inkosi yeAsiriya, kodwa kayimsizanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        }
      ]
    },
    {
