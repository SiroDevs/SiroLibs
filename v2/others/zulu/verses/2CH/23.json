              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamisa abalindisango emasangweni endlu kaJehova, ukuze kungangeni muntu ongcolile nganoma yini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
