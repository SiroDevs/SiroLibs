              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehoyada wamisa izikhundla zendlu kaJehova ngesandla sabapristi bamaLevi uDavide abahlukanisa endlini kaJehova ukuba banikele ngeminikelo yokushiswa kaJehova njengokulotshiweyo emthethweni kaMose, ngokuthokoza. Nangokuhlabelela, njengokunquma kukaDavide.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        }
