        },
        {
          "text": "Bonke abantu baya endlini kaBali bayidiliza, badiliza ama-altare ayo nemifanekiso yayo, babulala uMathani, umpristi kaBali, phambi kwama-altare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.17",
            "verseOrgIds": [
              "2CH.23.17"
            ]
          }
        }
