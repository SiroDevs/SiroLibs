            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaba khona intokozo enkulu eJerusalema, ngokuba kusukela emihleni kaSolomoni indodana kaDavide, inkosi yakwa-Israyeli, akuzange kube khona okunjalo eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
        }
      ]
