          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abapristi bamaLevi basukuma bababusisa abantu, izwi labo lezwakala, nomkhuleko wabo wakhuphukela endaweni yakhe yokuhlala engcwele ezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.27",
            "verseOrgIds": [
              "2CH.30.27"
            ]
          }
