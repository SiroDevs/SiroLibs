          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uquqaba lwabantu, abaningi bakwa-Efrayimi nakwaManase, kwa-Isakare nakwaZebuloni, alizange lizihlanze, kodwa ladla iphasika ngaphandle kwalokho okulotshiweyo. Kodwa uHezekiya wabathandazela wathi: “UJehova omuhle uthethelela wonke umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        }
