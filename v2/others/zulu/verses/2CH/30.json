          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lonke ibandla lakwaJuda, nabapristi namaLevi, nalo lonke ibandla elavela kwa-Israyeli, nabafokazi abavela ezweni lakwa-Israyeli nabahlala kwaJuda, bathokoza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        }
      ]
    },
    {
