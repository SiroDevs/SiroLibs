          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazithobanga phambi kukaJehova njengalokho wazithoba uManase uyise; kepha u-Amoni wona ngokwandayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
