          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomkhuleko wakhe nokuthi uNkulunkulu wezwakala kanjani kuye, nazo zonke izono zakhe, neziphambeko zakhe, nezindawo akhe kuzo izindawo eziphakemeyo, wamisa iziqu zemithi engcwele nemifanekiso ebaziweyo, ngaphambi kokuba athotshiswe; bheka, kulotshiwe phakathi kwezahlulelo zababoni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        }
