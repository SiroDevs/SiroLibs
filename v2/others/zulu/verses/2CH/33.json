            "sid": "2CH 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Amoni wayeneminyaka engamashumi amabili nambili ekuqaleni kwakhe ukubusa, wabusa iminyaka emibili eJerusalema;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
            "verseOrgIds": [
              "2CH.33.21"
            ]
          }
        }
