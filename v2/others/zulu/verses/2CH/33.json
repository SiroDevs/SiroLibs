            "sid": "2CH 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza okubi emehlweni kaJehova njengoManase uyise; u-Amoni wahlabela zonke izithombe ezibaziweyo uyise uManase ayezenzile, wazikhonza;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        }
      ]
