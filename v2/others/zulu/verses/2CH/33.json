            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zikaManase, nomkhuleko wakhe kuNkulunkulu wakhe, namazwi ababoni ababekhuluma kuye egameni likaJehova uNkulunkulu ka-Israyeli, bheka, kulotshiwe encwadini yamakhosi akwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        }
