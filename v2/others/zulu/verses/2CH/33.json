  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "2CH 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UManase wayeneminyaka eyishumi nambili ekuqaleni kwakhe ukubusa, wabusa iminyaka engamashumi ayisihlanu nanhlanu eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.1",
            "verseOrgIds": [
              "2CH.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.1",
            "verseOrgIds": [
              "2CH.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza okubi emehlweni kaJehova njengezinengiso zabezizwe uJehova abaxosha phambi kwabantwana bakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabuye wakha izindawo eziphakemeyo uHezekiya uyise ayezidilizile, wamisela oBhali ama-altare, wenza nemithi, wakhuleka, walikhonza ibandla lonke lasezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.3",
            "verseOrgIds": [
              "2CH.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.3",
            "verseOrgIds": [
              "2CH.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakha ama-altare endlini kaJehova, uJehova asho ngayo ukuthi: “EJerusalema igama lami liyakuba khona kuze kube phakade.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhela nalo lonke ibandla lasezulwini ama-altare emagcekeni omabili endlu kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
            "verseOrgIds": [
              "2CH.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
            "verseOrgIds": [
              "2CH.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadabulisa abantwana bakhe emlilweni esigodini sendodana kaHinomu; wagcina izikhathi, wenza imilingo, wenza imilingo, wahlobanisa nemimoya nabathakathi; wenza okubi okuningi emehlweni kaJehova ukuba amcunule.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasemisa isithombe esibaziweyo, isithombe abenzileyo, endlini kaNkulunkulu, uNkulunkulu akhuluma ngayo kuDavida lendodana yakhe uSolomoni, wathi: Kulindlu leJerusalema engilikhethileyo phezu kwezizwe zonke zakoIsrayeli, ngiyakumisa igama lami kuze kube phakade;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angisayikulususa unyawo luka-Israyeli ezweni engalimisela oyihlo; ukuze baqaphele ukwenza konke engabayala ngakho ngokomthetho wonke, nezimiso, nezahlulelo ngesandla sikaMose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UManase wadukisa uJuda nabakhileyo eJerusalema, benza okubi kunezizwe uJehova azichitha phambi kwabantwana bakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kuManase nakubantu bakhe, kepha abalalelanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.10",
            "verseOrgIds": [
              "2CH.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.10",
            "verseOrgIds": [
              "2CH.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uJehova wabehlisela izinduna zempi yenkosi yase-Asiriya, ezambamba uManase emeveni, zambopha ngamaketanga, zamyisa eBabele.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho esosizini, wancenga uJehova uNkulunkulu wakhe, wazithoba kakhulu phambi kukaNkulunkulu wawoyise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhuleka kuye, wamncenga, wezwa ukunxusa kwakhe, wambuyisela eJerusalema embusweni wakhe. UManase wazi ukuthi uJehova unguNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho wakha ugange ngaphandle komuzi kaDavide ngasentshonalanga kweGihoni esigodini kwaze kwaba sekungeneni kweSango Lezinhlanzi, walihaqa i-Ofeli, waliphakamisa kakhulu. Kuyo yonke imizi ebiyelweyo yakwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.14",
            "verseOrgIds": [
              "2CH.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.14",
            "verseOrgIds": [
              "2CH.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasusa onkulunkulu babezizwe nesithombe endlini kaJehova nawo wonke ama-altare ayewakhile entabeni yendlu kaJehova naseJerusalema, wakukhiphela ngaphandle komuzi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakha i-altare likaJehova, wanikela phezu kwalo imihlatshelo neminikelo yokubonga, wayala uJuda ukuba amkhonze uJehova uNkulunkulu ka-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa abantu babelokhu behlabela ezindaweni eziphakemeyo, kodwa kuJehova uNkulunkulu wabo yedwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
