          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayeneminyaka engamashumi amabili nanhlanu ekuqaleni kwakhe ukubusa, wabusa iminyaka eyishumi nesithupha eJerusalema;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.8",
            "verseOrgIds": [
              "2CH.27.8"
            ]
          }
        }
      ]
