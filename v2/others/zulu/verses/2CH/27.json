              "2CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJothamu wayeselala koyise, bammbela emzini kaDavide; u-Ahazi indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.9",
            "verseOrgIds": [
              "2CH.27.9"
            ]
          }
        }
