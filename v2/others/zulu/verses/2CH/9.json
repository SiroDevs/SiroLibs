            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke amakhosi omhlaba afuna ubuso bukaSolomoni ukuze ezwe ukuhlakanipha kwakhe uNkulunkulu ayekunike enhliziyweni yakhe.",
          "type": "text",
