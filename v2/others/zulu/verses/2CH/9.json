              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yenza isiliva eJerusalema njengamatshe, yenza nemisedari njengemithombe emithonjeni eminingi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
