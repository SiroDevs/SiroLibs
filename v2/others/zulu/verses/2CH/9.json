              "type": "text"
            }
          ]
        },
        {
          "text": "Wabusa phezu kwawo onke amakhosi kusukela emfuleni kuze kube sezweni lamaFilisti nasemkhawulweni waseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
