              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho sebeqala ukuhlabelela nokudumisa, uJehova wabeka abaqamekeli babantwana bakwa-Amoni, nabakwaMowabi, nasezintabeni zaseSeyiri ababefikele uJuda; bashaywa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.22",
            "verseOrgIds": [
              "2CH.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
