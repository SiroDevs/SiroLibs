          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zikaJehoshafati, ezokuqala nezokugcina, bheka, zilotshiwe encwadini kaJehu indodana kaHanani ekulotshweni kwayo encwadini yamakhosi akwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
