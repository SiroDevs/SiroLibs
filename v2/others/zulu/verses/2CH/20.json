            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavuka ekuseni kakhulu, basuka baya ehlane laseThekhowa; ekuphumeni kwabo, uJehoshafati wema, wathi: “Ngizweni, Juda, nani bakhileyo eJerusalema! Kholwani nguJehova uNkulunkulu wenu, niyakuqiniswa; kholwani ngabaprofethi bakhe, niyakuphumelela.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kokubonisana nabantu, wabeka abahlabeleli enkazimulweni kaJehova ukuze badumise inkazimulo engcwele lapho bephuma phambi kwebutho, futhi bathi: “Dumisani uJehova! ngokuba umusa wakhe umi phakade.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 20:21"
          },
          "items": [
