        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJuda esefika embhoshongweni wokulinda ehlane, babheka isixuku, bheka, kwakuyizidumbu eziwele phansi, kungaphunyuki muntu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.24",
            "verseOrgIds": [
              "2CH.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
