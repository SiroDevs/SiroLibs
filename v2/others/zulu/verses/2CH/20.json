        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.22",
            "verseOrgIds": [
              "2CH.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Amoni nabakwaMowabi bavukela abakhileyo ezintabeni zaseSeyiri ukuba babashaye ngesiqalekiso, bababhubhise;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.23",
            "verseOrgIds": [
              "2CH.20.23"
            ]
          }
        }
