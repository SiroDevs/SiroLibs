          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehoshafati wakhothamisa ubuso bakhe bubheke phansi; noJuda wonke nabakhileyo eJerusalema bawa phambi kukaJehova, bakhuleka kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
