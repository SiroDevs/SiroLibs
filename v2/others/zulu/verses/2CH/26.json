          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamelana nenkosi u-Uziya, bathi kuye: “Akukhona okwakho, Uziya, ukushisela uJehova impepho, kodwa kungokwabapristi, amadodana ka-Aroni, abangcweliselwe ukushisa impepho; ngoba wenile; futhi akuyikuba yinkazimulo kaJehova uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        }
