              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zika-Uziya, ezokuqala nezokugcina, zalotshwa ngu-Isaya umprofethi, indodana ka-Amose.",
          "type": "text",
          "attrs": {
