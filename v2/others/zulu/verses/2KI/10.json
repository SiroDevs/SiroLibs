        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.24",
            "verseOrgIds": [
              "2KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi eseqedile ukunikela ngomnikelo wokushiswa uJehu wathi kubalindi nasezikhulwini: Ngenani nibabulale; makungaphumi muntu. Bababulala ngosiko lwenkemba; abalindi nezinduna babaxosha, baya emzini wendlu kaBali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.25",
            "verseOrgIds": [
              "2KI.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.25",
            "verseOrgIds": [
              "2KI.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
