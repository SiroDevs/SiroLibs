        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehu wayesengena noJonadaba indodana kaRekabi endlini kaBali, wathi ezincekwini zikaBali: “Buzani nibone ukuthi akukho yini lapha phakathi kwezinceku zeNkosi, izinceku zikaBali kuphela.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.23",
            "verseOrgIds": [
              "2KI.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 10:23"
          },
          "items": [
