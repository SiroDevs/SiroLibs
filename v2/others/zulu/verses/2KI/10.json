          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wathi kuJehu: “Ngenxa yokuthi wenze kahle ngokwenza okulungile emehlweni ami futhi wenze kuyo indlu ka-Ahabi ngokuvumelana nakho konke okwakusenhliziyweni yami, abantwana bakho besizukulwane sesine bayohlala esihlalweni sobukhosi yakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.30",
            "verseOrgIds": [
              "2KI.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 10:30"
          },
          "items": [
