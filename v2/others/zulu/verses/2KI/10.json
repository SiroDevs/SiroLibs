            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusukela eJordani ngasempumalanga, lonke izwe lakwaGileyadi, labakwaGadi, nabakwaRubeni, nabakwaManase, kusukela e-Aroweri engasemfuleni i-Arinoni, kuze kufike eGileyadi naseBashani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
