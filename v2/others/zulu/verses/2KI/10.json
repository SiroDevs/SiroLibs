          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ezonweni zikaJerobowamu indodana kaNebati onisa ngazo u-Israyeli, uJehu akasukanga kuzo, amathole egolide ayeseBethele nakwaDani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.29",
            "verseOrgIds": [
              "2KI.10.29"
            ]
          }
        }
