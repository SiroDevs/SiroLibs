          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehu wasesithi: Memezelani umkhosi uBhali. Base beshumayela.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.20",
            "verseOrgIds": [
