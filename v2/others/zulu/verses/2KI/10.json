        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehu wathumela ku-Israyeli wonke, zafika zonke izinceku zikaBali, akwaze kwasala muntu ongafikanga. Bangena endlini kaBali; indlu kaBali yagcwala kusukela ekuqaleni kuze kufike ekugcineni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.21",
            "verseOrgIds": [
              "2KI.10.21"
            ]
          }
        }
      ]
    },
    {
