          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.30",
            "verseOrgIds": [
              "2KI.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJehu akaqaphelanga ukuhamba ngayo yonke inhliziyo yakhe emthethweni kaJehova uNkulunkulu ka-Israyeli, ngoba akazange aphambuke ezonweni zikaJerobowamu onisa ngazo u-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalezo zinsuku uJehova waqala ukunciphisa u-Israyeli, uHazayeli wawachitha kuzo zonke izifunda zakwa-Israyeli;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        }
      ]
    },
    {
