            "number": "26",
            "style": "v",
            "sid": "2KI 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.26",
            "verseOrgIds": [
              "2KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badiliza isithombe sikaBhali, badiliza indlu kaBhali, bayenza yaba yindlu eklanywe kahle kuze kube namuhla.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.27",
            "verseOrgIds": [
              "2KI.10.27"
            ]
          }
        }
      ]
    },
    {
