        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho bengena ukunikela ngemihlatshelo neminikelo yokushiswa, uJehu wabeka amadoda angamashumi ayisishiyagalombili ngaphandle, wathi: “Uma kuphunyuka oyedwa kumadoda engiwalethe esandleni senu, omkhululayo, ukuphila kwakhe kuyakuba sesikhundleni sokuphila kwakhe.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.24",
            "verseOrgIds": [
              "2KI.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 10:24"
          },
          "items": [
