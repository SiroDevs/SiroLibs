        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kumphathi wezingubo: Zikhiphele zonke izinceku zikaBali izingubo. Wabakhiphela izingubo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.22",
            "verseOrgIds": [
              "2KI.10.22"
            ]
          }
        }
