          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu bakwaJuda bathatha u-Azariya owayeneminyaka eyishumi nesithupha, bambeka inkosi esikhundleni sikayise u-Amaziya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.21",
