            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova akashongo ukuthi uyakwesula igama lika-Israyeli phansi kwezulu, kepha wabakhulula ngesandla sikaJerobowamu indodana kaJowashi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
    },
