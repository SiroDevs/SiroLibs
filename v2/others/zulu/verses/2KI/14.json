            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zikaJerobowamu nakho konke akwenzayo, namandla akhe, indlela alwa ngayo, nendlela abuyisela ngayo iDamaseku neHamati elalingelakwaJuda ku-Israyeli, azibhalwanga encwadini yeziKronike lamakhosi akoIsrayeli?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.28",
            "verseOrgIds": [
              "2KI.14.28"
            ]
          }
        }
      ]
    },
