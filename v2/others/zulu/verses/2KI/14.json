          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJerobowamu wayeselala koyise, amakhosi akwa-Israyeli; uZakariya indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
            "verseOrgIds": [
              "2KI.14.29"
            ]
          }
