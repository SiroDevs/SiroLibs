          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamthwala ngamahhashi, wembelwa eJerusalema koyise emzini kaDavide.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.20",
            "verseOrgIds": [
              "2KI.14.20"
