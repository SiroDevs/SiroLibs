          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.18",
            "verseOrgIds": [
              "2KI.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamenzela ugobe eJerusalema, wabalekela eLakishi; kodwa bathumela bamlandela eLakishi, bambulalela khona.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.19",
