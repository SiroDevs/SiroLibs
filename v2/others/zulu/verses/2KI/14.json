            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka weshumi nanhlanu ka-Amasiya indodana kaJowashi, inkosi yakwaJuda, uJerobowamu indodana kaJowashi, inkosi yakwa-Israyeli, wabusa eSamariya, wabusa iminyaka engamashumi amane nanye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        }
      ]
    },
    {
