              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinye izindaba zika-Amasiya azilotshiwe yini encwadini yezindaba zemihla ngemihla yamakhosi akwaJuda na?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.18",
            "verseOrgIds": [
              "2KI.14.18"
            ]
