              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavuka ekuseni kakhulu, ilanga lakhanya phezu kwamanzi, abakwaMowabi babona amanzi ngaphesheya ebomvu njengegazi.",
          "type": "text",
          "attrs": {
