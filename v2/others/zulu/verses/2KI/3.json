              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho befika ekamu lakwa-Israyeli, abantwana bakwa-Israyeli baqeda, banqoba abakwaMowabi, baze babaleka phambi kwabo; kepha baphuma, banqoba abakwaMowabi ezweni labo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
              "2KI.3.24"
            ]
