              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethi: “Lokhu kuyigazi; amakhosi abulewe impela, anqobile wodwa; manje-ke, Mowabi, ukuphanga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
