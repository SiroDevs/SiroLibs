    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka weshumi nesikhombisa kaPheka indodana kaRemaliya, u-Ahazi indodana kaJothamu, inkosi yakwaJuda, waba yinkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ahazi wayeneminyaka engamashumi amabili ekuqaleni kwakhe ukubusa, wabusa iminyaka eyishumi nesithupha eJerusalema; akenzanga okulungile emehlweni kaJehova uNkulunkulu wakhe njengoDavide uyise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha wahamba ngendlela yamakhosi akwa-Israyeli, yebo, nendodana yakhe yadabula emlilweni njengezinengiso zezizwe uJehova azixosha phambi kwabantwana bakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanikela ngomhlatshelo, washunqisa umusi ezindaweni eziphakemeyo, nasemagqumeni, naphansi kwayo yonke imithi eluhlaza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke uResini, inkosi yase-Aramu, noPheka, indodana kaRemaliya, inkosi yakwa-Israyeli, benyukela eJerusalema ukulwa, bavimbezela u-Ahazi, kodwa babengenakumehlula.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaleso sikhathi uResini, inkosi yase-Aramu, walibuyisela i-Elati e-Aramu, waxosha abaJuda e-Elati; ama-Aramu afika e-Elati, ahlala khona kuze kube namuhla.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ahazi wayesethuma izithunywa kuThigilati Phileseri inkosi yase-Asiriya, wathi: “Ngiyinceku yakho nendodana yakho; khuphuka ungisindise esandleni senkosi yase-Aramu nasesandleni senkosi yakwa-Israyeli evukayo ngokumelene nami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ahazi wathatha isiliva negolide okwakutholakala endlini kaJehova nasezingcebeni zendlu yenkosi, wakuthuma njengesipho enkosini yase-Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yase-Asiriya yamlalela, ngokuba inkosi yase-Asiriya yakhuphukela eDamaseku, yalithatha, yathumbela abantu bayo eKiri, yambulala uResini.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi u-Ahazi yaya eDamaseku ukumhlangabeza uThigilati Phileseri inkosi yase-Asiriya, yabona i-altare eDamaseku; inkosi u-Ahazi yathumela ku-Uriya umpristi isifanekiso se-altare nesifanekiso salo njengokwenziwa kwalo konke.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Uriya umpristi walakha i-altare njengakho konke inkosi u-Ahazi ebikuthumile iseDamaseku; umpristi u-Uriya wakwenza ngokumelene nenkosi u-Ahazi evela eDamaseku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi isifikile ivela eDamaseku, inkosi yalibona i-altare, inkosi yasondela e-altare, yanikela phezu kwalo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathulula umnikelo wakhe wokushiswa nomnikelo wakhe wempuphu, wathulula umnikelo wakhe wokuphuzwayo, wafafaza igazi leminikelo yakhe yokubonga e-altare.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi i-altare lethusi elaliphambi kukaJehova walisusa ngaphambi kwendlu phakathi kwe-altare nendlu kaJehova, walibeka ohlangothini olusenyakatho lwe-altare.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi u-Ahazi yamyala u-Uriya umpristi, yathi: “Shiselani e-altare elikhulu umnikelo wokushiswa wasekuseni nomnikelo wokudla wakusihlwa, nomnikelo wokushiswa wenkosi, nomnikelo wayo wokudla, kanye nomnikelo wokushiswa wabantu bonke bezwe, nomnikelo wabo wokushiswa wenkosi, nomnikelo wokushiswa, nomnikelo wokushiswa wenkosi, nomnikelo wokushiswa, nomnikelo wokushiswa, nomnikelo wokushiswa wenkosi.” umnikelo wokudla neminikelo yawo yokuphuzwa; ufafaze phezu kwawo lonke igazi lomnikelo wokushiswa, nalo lonke igazi lesisulu; i-altare lethusi liyakuba ngelami ukubona.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Uriya umpristi wenza njengakho konke inkosi u-Ahazi eyale ngakho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        }
