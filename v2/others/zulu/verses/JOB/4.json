          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma sizama ukukhuluma nawe, ingabe uzodabuka? kodwa ngubani ongazibamba ekukhulumeni?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
