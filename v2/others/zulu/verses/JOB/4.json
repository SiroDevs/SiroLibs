          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu akusikho yini ukwesatshwa kwakho, ithemba lakho, ithemba lakho, nobuqotho bezindlela zakho?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
