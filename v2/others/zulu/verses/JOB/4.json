          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomoya kaNkulunkulu bayabhubha, nangomoya wamakhala akhe bayaphela.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
