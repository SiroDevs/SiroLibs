          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazwi akho asekela owasezakuwa, waqinisa amadolo abuthakathaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
