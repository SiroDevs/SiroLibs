          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wema, kepha angikwazanga ukuhlukanisa isimo sawo; isithombe sasiphambi kwamehlo ami, kwathula, ngezwa izwi lithi:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
