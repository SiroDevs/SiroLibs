          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ufundisile abaningi, waqinisa izandla ezibuthakathaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
