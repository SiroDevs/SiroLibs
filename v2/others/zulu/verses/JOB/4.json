          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa manje sekufikile kuwe, futhi uyadangala; kuyakuthinta, uyesaba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
