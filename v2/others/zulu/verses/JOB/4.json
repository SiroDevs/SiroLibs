            "sid": "JOB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumbula, ngubani owake wabhubha ngenxa yokuthi wayengelacala? noma banqunyelwephi abalungileyo na?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
