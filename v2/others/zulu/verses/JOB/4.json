          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba ngibonile, abalima ububi bavuna, bahlwanyele ububi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
