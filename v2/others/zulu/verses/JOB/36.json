              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, uNkulunkulu unamandla, akadeleli muntu; Unamandla amakhulu nokuhlakanipha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
