          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawasusi amehlo akhe kwabalungileyo, kepha uhlezi kanye namakhosi esihlalweni sobukhosi; yebo, uyazimisa kuze kube phakade, futhi ziphakeme.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
