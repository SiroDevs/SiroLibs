          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalokho Ubabonisa umsebenzi wabo neziphambeko zabo ukuthi baphambukile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
