            "sid": "JOB 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyawuqondisa phansi kwezulu lonke nombani wakhe kuze kube semikhawulweni yomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
