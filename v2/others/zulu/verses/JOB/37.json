          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi iphendulwa ngeseluleko sakhe, ukuze benze konke abayala ngakho ebusweni bomhlaba emhlabeni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
