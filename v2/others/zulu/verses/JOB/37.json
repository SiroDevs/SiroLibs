          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uthi kulo iqhwa: Yiba emhlabeni! kanjalo nangemvula encane nemvula enkulu yamandla akhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
