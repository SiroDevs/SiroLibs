            "number": "4",
            "style": "v",
            "sid": "JOB 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekubhonga ilizwi; uyaduma ngezwi lobukhosi bakhe; futhi ngeke abavimbe uma izwi lakhe lizwakala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
