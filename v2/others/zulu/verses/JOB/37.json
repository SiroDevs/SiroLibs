              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuphefumula kukaNkulunkulu kuvela ungqoqwane, nobubanzi bamanzi bukhona manje.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
