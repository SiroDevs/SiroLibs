        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.1",
            "verseOrgIds": [
              "JOB.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungazibala yini izinyanga aziqedayo? noma uyasazi isikhathi ezizala ngaso na?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.2",
            "verseOrgIds": [
              "JOB.39.2"
            ]
          }
        }
      ]
    },
    {
