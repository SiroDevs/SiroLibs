        {
          "text": "Ungabophela inyoti ngebhande layo emseleni na? noma uzolandela izigodi kimi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.10",
            "verseOrgIds": [
              "JOB.39.10"
