          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abancane babo banesimo esihle, bakhula kanye nokolweni; bayaphuma bangabuyeli kubo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.4",
            "verseOrgIds": [
              "JOB.39.4"
            ]
          }
        }
