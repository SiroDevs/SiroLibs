          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngubani owakhulula imbongolo yasendle? Ngubani owathukulula izibopho zikababhemi wasendle?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.5",
            "verseOrgIds": [
              "JOB.39.5"
            ]
          }
        }
