        {
          "text": "engenze indlu yayo ibe yizigwadule, nomhlabathi owugwadule ube yizindlu zawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.39.6",
            "verseOrgIds": [
              "JOB.39.6"
            ]
