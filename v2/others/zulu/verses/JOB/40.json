          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.4",
            "verseOrgIds": [
              "JOB.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngake ngakhuluma; kodwa kangiyikuphendula: yebo, kabili; kodwa angiyikuqhubeka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.5",
            "verseOrgIds": [
              "JOB.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
