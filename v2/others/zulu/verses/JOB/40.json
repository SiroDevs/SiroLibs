          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka wonke umuntu ozidlayo, umthobise; futhi ninyathele ababi esikhundleni sabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.12",
            "verseOrgIds": [
              "JOB.40.12"
            ]
