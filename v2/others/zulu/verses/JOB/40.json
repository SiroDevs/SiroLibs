          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lahla ukufutheka kwentukuthelo yakho, ubuke bonke abazidlayo, ubathobe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.11",
            "verseOrgIds": [
              "JOB.40.11"
            ]
