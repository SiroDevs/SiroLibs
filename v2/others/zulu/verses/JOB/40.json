          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ophikisana noSomandla angamfundisa na? osola uNkulunkulu makaphendule.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.2",
            "verseOrgIds": [
              "JOB.40.2"
            ]
          }
        }
