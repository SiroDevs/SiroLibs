          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wayesemphendula uJobe esemoyeni esivunguvungu, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.6",
            "verseOrgIds": [
              "JOB.40.6"
            ]
          }
        }
      ]
    },
    {
