          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pho umuntu angalungisiswa kanjani nguNkulunkulu? Ozelwe ngowesifazane angaba msulwa kanjani na?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.4",
            "verseOrgIds": [
              "JOB.25.4"
            ]
