          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka enyangeni, futhi ayikhanyi; yebo, izinkanyezi azihlanzekile emehlweni akhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.5",
            "verseOrgIds": [
              "JOB.25.5"
