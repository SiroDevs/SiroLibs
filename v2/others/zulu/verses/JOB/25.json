          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhona yini inani lamabutho akhe? futhi ngubani ongaphakamisi ngobani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.3",
            "verseOrgIds": [
              "JOB.25.3"
            ]
          }
        }
