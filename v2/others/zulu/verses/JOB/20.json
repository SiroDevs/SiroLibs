          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakhe bayofuna ukujabulisa abampofu, futhi izandla zakhe ziyobuyisela impahla yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
