          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma ubukhosi bakhe bukhuphukela ezulwini, nekhanda lakhe lifinyelela emafwini;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
