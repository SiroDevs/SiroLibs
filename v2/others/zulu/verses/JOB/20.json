          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anazi yini ukuthi kwasendulo, selokhu umuntu abekwa emhlabeni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
