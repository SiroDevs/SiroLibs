          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikuzwile ukuthukwa kwami, nomoya wokuqonda kwami wangiphendula.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
