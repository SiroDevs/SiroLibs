            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuyotholakalaphi ukuhlakanipha? iphi indawo yokuqonda na?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
