          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu akazi ukuthi iyini inani layo; futhi ayitholakali ezweni labaphilayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
