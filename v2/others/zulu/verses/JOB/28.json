          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igolide nekristalu akunakulingana, futhi ukuhwebelana kwakho akufanele kube ngamatshe ayigugu egolide elicolekileyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
