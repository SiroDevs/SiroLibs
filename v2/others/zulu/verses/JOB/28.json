          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhorali namaparele akunakukhulunywa ngawo, ngokuba intengo yokuhlakanipha ingaphezu kwamarubi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
