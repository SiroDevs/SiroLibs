          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeke kwalinganiswa negolide lase-Ofiri, neshohamu eliyigugu nesafire.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
