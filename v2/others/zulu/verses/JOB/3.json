          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungani ngingafanga esizalweni sikanina? kungani ngingawulahlanga umoya ngiphuma esiswini?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.11",
            "verseOrgIds": [
              "JOB.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
