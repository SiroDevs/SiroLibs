          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba manje ngabe ngilele ngithule, ngabe ngilele; ukube ngangizolile ngaleso sikhathi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.13",
            "verseOrgIds": [
              "JOB.3.13"
            ]
          }
        }
