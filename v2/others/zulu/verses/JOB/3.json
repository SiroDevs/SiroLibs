          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.4",
            "verseOrgIds": [
              "JOB.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubumnyama nethunzi lokufa makulingcolise; ifu malihlale phezu kwalo; ubumnyama bemini mabulwesabise.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.5",
            "verseOrgIds": [
              "JOB.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ngalobo busuku, mabumehlele; makungahlanganiswa nezinsuku zomnyaka, kungangeni esibalweni sezinyanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.6",
            "verseOrgIds": [
              "JOB.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, lobo busuku mabube bodwa, makungangeni kubo izwi lokujabula.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.7",
            "verseOrgIds": [
              "JOB.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabaqalekise oqalekisa usuku, olungele ukuvuka ukulila kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.8",
            "verseOrgIds": [
              "JOB.3.8"
            ]
          }
        }
      ]
    },
    {
