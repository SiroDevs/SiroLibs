          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma bengingaba khona njengozalo olufihlwayo; njengezingane ezingakaze zikubone ukukhanya kwemini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.16",
