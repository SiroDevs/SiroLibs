            "number": "2",
            "style": "v",
            "sid": "JOB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, ukube usizi lwami belingalinganiswa nenhlekelele yami kanye esikalini!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.2",
            "verseOrgIds": [
              "JOB.6.2"
            ]
          }
        }
      ]
    },
    {
