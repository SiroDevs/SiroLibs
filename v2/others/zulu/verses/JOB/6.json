          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulowo ohluphekayo, ububele bumelwe kuboniswa kumngane wakhe; kodwa uyakulahla ukumesaba uSomandla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.14",
            "verseOrgIds": [
              "JOB.6.14"
            ]
