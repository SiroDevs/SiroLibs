          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafowethu benze ngenkohliso njengomfula, futhi njengomfula wezifufula bayadlula;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.15",
