          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amandla ami angamandla amatshe na? noma inyama yami iyithusi na?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.12",
            "verseOrgIds": [
              "JOB.6.12"
            ]
          }
        }
      ]
    },
