          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufaka izinyawo zami engongolweni, uthengisa zonke izindlela zami.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        }
