          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ephusheni, embonweni wasebusuku, lapho ubuthongo obunzima bubehlela abantu, ebuthongweni embhedeni;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        }
