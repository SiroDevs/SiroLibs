          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze asuse umuntu enjongweni yakhe futhi afihlele umuntu ukuzigqaja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
