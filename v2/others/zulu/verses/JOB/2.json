            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahlala phansi naye izinsuku eziyisikhombisa nobusuku obuyisikhombisa, akwabakho owakhuluma naye, ngokuba babona ukuthi usizi lwakhe lwalulukhulu kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.13",
