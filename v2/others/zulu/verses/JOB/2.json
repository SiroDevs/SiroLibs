            "verseId": "JOB.2.11",
            "verseOrgIds": [
              "JOB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho bephakamisa amehlo abo bekude, bengamazi, baphakamisa izwi labo, bakhala; baklebhula, kwaba yilowo nalowo ingubo yakhe, bafafaza ngothuli emakhanda abo ezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.12",
            "verseOrgIds": [
              "JOB.2.12"
            ]
          }
        }
      ]
    },
