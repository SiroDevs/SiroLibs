          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasethatha isitsha sobumba ukuze azinwaye ngaso; wahlala phansi emlotheni.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.8",
            "verseOrgIds": [
              "JOB.2.8"
            ]
          }
        }
      ]
    },
    {
