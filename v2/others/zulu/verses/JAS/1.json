        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kacele ekholweni engangabazi lutho. Ngokuba ongabazayo ufana negagasi lolwandle eliqhutshwa umoya linyakaziswa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        }
      ]
    },
    {
