        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.4",
            "verseOrgIds": [
              "JAS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma noma ubani kini entula ukuhlakanipha, makacele kuNkulunkulu opha bonke ngobuhle, engasoli; njalo uzakuphiwa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.5",
            "verseOrgIds": [
              "JAS.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
