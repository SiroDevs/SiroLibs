          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu onhliziyombili kagxilile kuzo zonke izindlela zakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.8",
