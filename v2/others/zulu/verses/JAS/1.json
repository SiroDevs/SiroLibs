          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubusisiwe umuntu okhuthazela ekulingweni, ngokuba lapho esevivinyiwe uyakwamukeliswa umqhele wokuphila iNkosi ewuthembisile kwabayithandayo.",
          "type": "text",
          "attrs": {
