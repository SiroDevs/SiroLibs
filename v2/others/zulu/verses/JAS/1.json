          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ilanga liyaphuma lilokushisa okutshisayo, kodwa libunisa utshani, lembali yabo iyawa, lobuhle besimo sabo bubhubha;",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.11",
            "verseOrgIds": [
              "JAS.1.11"
