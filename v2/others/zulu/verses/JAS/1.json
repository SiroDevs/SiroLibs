            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe, inceku kaNkulunkulu neyeNkosi uJesu Kristu, kubo izizwe eziyishumi nambili ezihlakazekile, ngiyabingelela.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
            ]
          }
        }
