          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.6",
            "verseOrgIds": [
              "JAS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
