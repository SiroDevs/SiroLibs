              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyanincenga, bazalwane, niyayazi indlu kaStefana ukuthi iyilibo lase-Akhaya nokuthi bazinikele enkonzweni yabangcwele;",
          "type": "text",
          "attrs": {
