            "sid": "1CO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma uThimothewu efika, bhekani ukuba abe kini engesabi, ngokuba usebenza umsebenzi weNkosi njengami.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.10",
            "verseOrgIds": [
              "1CO.16.10"
            ]
          }
        }
      ]
    },
