            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze nibathobele abanjalo, nakubo bonke abasizayo nabakhandlekayo kanye nathi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
