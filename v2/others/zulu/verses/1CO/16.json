          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqondana nomzalwane u-Apholo, ngamncenga kakhulu ukuba eze kini kanye nabazalwane; kodwa uyeza nxa enethuba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.12",
            "verseOrgIds": [
              "1CO.16.12"
            ]
          }
        }
      ]
    },
