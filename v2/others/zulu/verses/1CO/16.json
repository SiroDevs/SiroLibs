          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho makungabikho omdelelayo, kodwa mhambiseni ngokuthula, ukuze eze kimi, ngokuba ngimlindile kanye nabazalwane.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        }
