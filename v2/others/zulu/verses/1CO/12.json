          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba izitho zethu ezinhle azidingi, kepha uNkulunkulu uwuhlanganisile umzimba, esipha udumo olukhulu kakhulu leso esintulayo;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.24",
