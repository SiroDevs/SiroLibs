          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa-ke, ikakhulu lezozitho zomzimba ezibonakala zibuthakathaka kakhulu ziyadingeka;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.22",
