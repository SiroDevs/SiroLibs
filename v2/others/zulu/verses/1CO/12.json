          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma zonke beziyisitho sinye, umzimba ngabe uphi na?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.19",
            "verseOrgIds": [
              "1CO.12.19"
            ]
