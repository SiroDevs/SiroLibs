              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iso alinakusho esandleni ukuthi: ‘Angikudingi,’ nekhanda futhi alinakusho ezinyaweni ukuthi: ‘Anginidingi.’",
          "type": "text",
          "attrs": {
