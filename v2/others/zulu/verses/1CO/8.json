        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke uma ukudla kumkhubekisa umzalwane wami, angisoze ngadla nyama kusesekhona, funa ngimkhubekise umzalwane wami.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.13",
            "verseOrgIds": [
              "1CO.8.13"
            ]
          }
        }
