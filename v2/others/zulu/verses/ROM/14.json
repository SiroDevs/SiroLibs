              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhle ukungadli inyama, nokungaliphuzi iwayini, nokunye umfowenu akhubeka ngakho, akhubeke, noma abe buthakathaka.",
          "type": "text",
          "attrs": {
