      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho awunakuzilandulela, wena muntu, noma ungubani owahlulelayo; ngokuba ngalokho owahlulela ngakho omunye, uyazilahla wena; ngoba wena owahlulelayo uyakwenza okufanayo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.1",
            "verseOrgIds": [
              "ROM.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.1",
            "verseOrgIds": [
              "ROM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa siyazi ukuthi ukwahlulela kukaNkulunkulu kungokweqiniso kulabo abenza izinto ezinjalo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.2",
            "verseOrgIds": [
              "ROM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.2",
            "verseOrgIds": [
              "ROM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ucabanga ukuthi wena muntu, owahlulela abenza izinto ezinjalo, nawe uzenza nazo, ucabanga ukuthi uyakubalekela ukwahlulela kukaNkulunkulu na?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.3",
            "verseOrgIds": [
              "ROM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.3",
            "verseOrgIds": [
              "ROM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma udelela ingcebo yobubele bakhe nokubekezela nokubekezela kwakhe; ungazi ukuthi umusa kaNkulunkulu ukuyisa ekuphendukeni na?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.4",
            "verseOrgIds": [
              "ROM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.4",
            "verseOrgIds": [
              "ROM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ngobulukhuni bakho nenhliziyo engaphendukiyo uzibekelela ulaka ngosuku lolaka nolokwambulwa kokwahlulela okulungileyo kukaNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.5",
            "verseOrgIds": [
              "ROM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
