        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyakubuyisela kulowo nalowo ngokwemisebenzi yakhe;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.6",
            "verseOrgIds": [
              "ROM.2.6"
            ]
          }
        }
      ]
    },
    {
