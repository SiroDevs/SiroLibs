          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku uNkulunkulu azakwahlulela ngalo izimfihlo zabantu ngoJesu Khristu ngokwevangeli lami.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.16",
            "verseOrgIds": [
              "ROM.2.16"
            ]
          }
        }
      ]
