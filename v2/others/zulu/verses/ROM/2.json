          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba nxa abezizwe abangenawo umlayo benza ngokwemvelo okungokomlayo, laba, bengenawo umlayo, bangumlayo wabo ngokwabo;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.14",
            "verseOrgIds": [
              "ROM.2.14"
            ]
          }
        }
      ]
    },
