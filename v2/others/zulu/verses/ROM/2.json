          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, wena ubizwa ngokuthi ungumJuda, weyame emthethweni, uzibonga ngoNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.17",
            "verseOrgIds": [
              "ROM.2.17"
            ]
          }
        }
      ]
