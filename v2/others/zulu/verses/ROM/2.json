          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababonakalisa umsebenzi womthetho olotshiwe ezinhliziyweni zabo, unembeza wabo ufakaza futhi, nemicabango yabo isolana noma ithethelelana;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.15",
            "verseOrgIds": [
              "ROM.2.15"
            ]
          }
        }
      ]
