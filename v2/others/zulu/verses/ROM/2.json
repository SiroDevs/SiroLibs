          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba akusibo abezwa umthetho abalungile phambi kukaNkulunkulu, kepha abenza umthetho yibona abayakulungisiswa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.13",
            "verseOrgIds": [
              "ROM.2.13"
            ]
          }
        }
      ]
