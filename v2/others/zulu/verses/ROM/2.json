          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa inkazimulo, nodumo, nokuthula kubo bonke abenza okuhle, kumJuda kuqala, nakumGreki;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.10",
            "verseOrgIds": [
              "ROM.2.10"
            ]
          }
        }
      ]
    },
    {
