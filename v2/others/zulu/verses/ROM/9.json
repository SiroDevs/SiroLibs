          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngani na? Ngoba kabakufunanga ngokukholwa, kodwa ngokungathi ngemisebenzi yomthetho. Ngokuba bakhubeka etsheni lesikhubekiso;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.32",
            "verseOrgIds": [
              "ROM.9.32"
            ]
          }
        }
      ]
    },
