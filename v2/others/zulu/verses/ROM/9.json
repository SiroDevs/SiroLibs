          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbumbi akanalo yini igunya phezu kobumba ukuba ngenhlama efanayo enze isitsha esihloniphekayo nesinye esingahloniphekiyo na?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
