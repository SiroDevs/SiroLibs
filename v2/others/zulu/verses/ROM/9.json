          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyakuthi endaweni lapho kwathiwa kubo: “Anisibo abantu bami; lapho bayakuthiwa abantwana bakaNkulunkulu ophilayo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.26",
            "verseOrgIds": [
              "ROM.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "UIsaya umemeza ngoIsrayeli, uthi: Lanxa umumo wabantwana bakoIsrayeli ungangesihlabathi solwandle, insali izasindiswa;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uyakuqeda umsebenzi, awufinyeze ngokulunga, ngokuba uJehova uyakuwenza umsebenzi omfushane emhlabeni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.28",
            "verseOrgIds": [
              "ROM.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
