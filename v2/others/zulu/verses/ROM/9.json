          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze enze yaziwe ingcebo yenkazimulo yakhe ezitsheni zomusa, azilungisele ngaphambili inkazimulo;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
