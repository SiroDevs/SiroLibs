          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngitsho thina, asibizayo, kungeyisikho kumaJuda kuphela, kodwa lakwabezizwe?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.24",
