            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha u-Israyeli, obelandela umthetho wokulunga, akawufinyelelanga umthetho wokulunga.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
            "verseOrgIds": [
              "ROM.9.31"
            ]
          }
        }
      ]
    },
