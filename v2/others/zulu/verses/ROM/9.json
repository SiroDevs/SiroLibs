          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengokuba esho nakuHoseya ukuthi: “Abangesibo abantu bami ngiyakubabiza ngokuthi abantu bami; nothandiweyo wakhe, obengathandwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
