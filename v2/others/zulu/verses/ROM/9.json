          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wena muntu, ungubani wena ophendula ngoNkulunkulu? Okubunjiweyo kungasho yini kowakubumbayo ukuthi: ‘Ungenzeleni kanjalo na?",
          "type": "text",
