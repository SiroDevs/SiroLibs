          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma uNkulunkulu ethanda ukubonakalisa ulaka lwakhe nokwenza amandla akhe aziwe, wathwala ngokubekezela okukhulu izitsha zolaka ezilungiselwe ukubhujiswa;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.22",
            "verseOrgIds": [
              "ROM.9.22"
            ]
          }
