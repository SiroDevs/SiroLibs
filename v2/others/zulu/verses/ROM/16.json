              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wokuthula uzakumchoboza masinyane uSathane phansi kwezinyawo zenu. Umusa weNkosi yethu uJesu Kristu mawube nani. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
