          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa khathesi isibonakalisiwe, langemibhalo yabaprofethi, ngokomlayo kaNkulunkulu ophakade wenziwe waziwa ezizweni zonke ukuze balalele ngokukholwa;",
          "type": "text",
