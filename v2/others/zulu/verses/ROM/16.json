          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyamtusa kini uFebe udadewethu oyisikhonzi sebandla eliseKenikreya;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        }
      ]
    },
    {
