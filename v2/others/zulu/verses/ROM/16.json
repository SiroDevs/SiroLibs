          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakhonza kini uThimothewu, isisebenzi kanye nami, noLukiyu, noJasoni, noSosipatro, izihlobo zami.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
