          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UmKushe angasiguqula yini isikhumba sakhe, nengwe amabala ayo, na? khona-ke ningase nenze okuhle nina enijwayele ukwenza okubi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.23",
