              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngizakwembula izembatho zakho ebusweni bakho, ukuze kubonakale ihlazo lakho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.26",
