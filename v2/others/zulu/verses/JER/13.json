          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imizi yaseningizimu iyovalwa, kungabikho oyivulayo; UJuda wonke uyakuthunjwa, ayiswe ekuthunjweni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
