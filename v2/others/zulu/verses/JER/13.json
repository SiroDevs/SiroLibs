              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngiyobahlakaza njengamabibi adlula umoya ogwadule.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.24",
            "verseOrgIds": [
