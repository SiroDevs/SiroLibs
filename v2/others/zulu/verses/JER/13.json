          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phakamisa amehlo akho, ubheke abavela enyakatho: iphi imihlambi owaphiwa yona, umhlambi wakho omuhle?",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        }
