            "sid": "JER 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impepho enayinyusa emizini yakwaJuda nasezitaladini zaseJerusalema, nina nawoyihlo, namakhosi enu, nezikhulu zenu, nabantu bezwe, uJehova akayikhumbulanga, ayingenanga ingqondo yakhe?",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.21",
            "verseOrgIds": [
              "JER.44.21"
            ]
          }
        }
      ]
    },
