          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.15",
            "verseOrgIds": [
              "JER.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuqondene nezwi owalikhuluma kithi egameni likaJehova, ngeke sikulalele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.16",
            "verseOrgIds": [
              "JER.44.16"
            ]
          }
        }
      ]
