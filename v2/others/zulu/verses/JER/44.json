              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.26",
            "verseOrgIds": [
              "JER.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngiyabalinda kube kubi, kungabi kuhle; bonke abantu bakwaJuda abasezweni laseGibithe bayakuphela ngenkemba nangendlala, baze baqedwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.27",
            "verseOrgIds": [
              "JER.44.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.27",
            "verseOrgIds": [
              "JER.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaphunyuka enkembeni bayakubuya ezweni laseGibithe, babuyele ezweni lakwaJuda, bengaba yingcosana ngomumo; yonke insali yakwaJuda eye ezweni laseGibithe ukuba igogobale khona iyakwazi ukuthi yiliphi izwi eliyakuma, elami noma elabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.28",
            "verseOrgIds": [
              "JER.44.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 44:28"
          },
          "items": [
