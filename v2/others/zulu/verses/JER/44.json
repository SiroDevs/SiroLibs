        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.28",
            "verseOrgIds": [
              "JER.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Lesi siyakuba yisibonakaliso kini,’ usho uJehova, ‘ukuthi ngiyakunijezisa kule ndawo ukuba nazi ukuthi amazwi ami ayakuma amelane nani kube kubi.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.29",
            "verseOrgIds": [
              "JER.44.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.29",
            "verseOrgIds": [
              "JER.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: ‘Bhekani, ngiyakunikela uFaro uHofira inkosi yaseGibithe esandleni sezitha zakhe nasesandleni sabafuna ukuphila kwakhe, njengalokho nganikela uSedekiya inkosi yakwaJuda esandleni sikaNebukadinesari, inkosi yaseBabele, isitha sakhe esasifuna ukuphila kwakhe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.30",
            "verseOrgIds": [
              "JER.44.30"
            ]
          }
        }
