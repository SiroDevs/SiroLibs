              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.25",
            "verseOrgIds": [
              "JER.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho yizwani izwi likaJehova nina nonke bakwaJuda enihlala ezweni laseGibithe: ‘Bhekani, ngifungile igama lami elikhulu,’ usho uJehova, ‘ukuthi igama lami alisayikubizwa mlomo wamuntu wakwaJuda ezweni lonke laseGibithe ukuthi: “Kuphila kukaJehova.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.26",
            "verseOrgIds": [
              "JER.44.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 44:26"
          },
          "items": [
