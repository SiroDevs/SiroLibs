          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze uJehova angabe esakwazi ukukuthwala ngenxa yobubi bezenzo zenu nangenxa yezinengiso enazenzayo; ngalokho izwe lenu liyihlane, nesimangaliso, nesiqalekiso, alinamuntu ohlala khona, njenganamuhla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.22",
            "verseOrgIds": [
