          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yokuthi nakhuphula impepho nangenxa yokuthi nonile kuJehova futhi anizange nililalele izwi likaJehova futhi anihambanga ngomthetho wakhe nangezimiso zakhe nangobufakazi bakhe; ngalokho lobu bubi bukwehlele njenganamuhla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.23",
            "verseOrgIds": [
              "JER.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
