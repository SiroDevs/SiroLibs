          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa konke okuphuma emlonyeni wethu siyakukwenza nokushunqisela inkosikazi yezulu umusi, siyithululele iminikelo yokuphuzwa, njengalokho senzile, thina nawobaba, namakhosi ethu, nezikhulu zethu, emizini. KwaJuda nasezitaladini zaseJerusalema; ngokuba sasinokuningi ukudla ngaleso sikhathi, sasiphilile, asibonanga bubi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.17",
            "verseOrgIds": [
              "JER.44.17"
            ]
          }
        }
      ]
    },
