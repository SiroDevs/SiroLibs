          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJeremiya wayesethi kubo bonke abantu, kwabesilisa nakwabesifazane, nakubo bonke abantu abamphendulayo, wathi:",
          "type": "text",
          "attrs": {
