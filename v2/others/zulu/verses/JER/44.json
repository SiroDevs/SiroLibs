            "sid": "JER 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu kwalokho, uJeremiya wathi kubo bonke abantu nakubo bonke abesifazane: “Yizwani izwi likaJehova, nonke Juda osezweni laseGibhithe!",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.24",
            "verseOrgIds": [
              "JER.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.24",
            "verseOrgIds": [
              "JER.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uNkulunkulu ka-Israyeli, uthi: Nina nawomkenu nikhulumile ngemilomo yenu, nakugcwalisa ngezandla zenu, nathi: ‘Siyakugcwalisa nokugcwalisa izithembiso zethu esizenzileyo zokushisela inkosikazi yezulu impepho nokuyithululela iminikelo yokuphuzwa.’ Qinisani nokuqinisa izithembiso zenu, nigcwalise nokugcwalisa izithembiso zenu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.25",
            "verseOrgIds": [
              "JER.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 44:25"
          },
          "items": [
