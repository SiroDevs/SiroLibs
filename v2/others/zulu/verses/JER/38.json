          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJeremiya wathi: Kabayikukusindisa. Lalelani izwi likaJehova engilikhuluma kini; khona kuyakuba kuhle kuwe, uphile umphefumulo wakho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
