            "number": "18",
            "style": "v",
            "sid": "JER 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma ungaphumi uye ezikhulwini zenkosi yaseBabele, lo muzi uyakunikelwa esandleni samaKaledi, awushise ngomlilo, kepha wena awuyikuphunyuka esandleni sawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        }
      ]
