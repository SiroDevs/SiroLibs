          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zase zifika zonke izikhulu kuJeremiya, zambuza, wazitshela njengawo onke lawa mazwi inkosi eyalile ngawo. Basebeyeka ukukhuluma laye; ngoba indaba ayizange inakwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
