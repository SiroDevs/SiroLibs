          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJeremiya wahlala egcekeni letilongo kwaze kwaba usuku iJerusalema elathunjwa ngalo, futhi wayelapho lapho iJerusalema lithunjwa.",
          "type": "text",
          "attrs": {
