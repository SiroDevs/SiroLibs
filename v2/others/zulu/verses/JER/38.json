          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZedekhiya wasesithi kuJeremiya: Kangazi muntu lawamazwi, njalo kawuyikufa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.24",
            "verseOrgIds": [
              "JER.38.24"
            ]
          }
        }
