          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uZedekhiya yathi kuJeremiya: “Ngiyesaba abaJuda abahluthele kumaKaledi, funa anginikele esandleni sabo, badlale ngami.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        }
