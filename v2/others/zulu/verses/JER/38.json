          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuthi kibo: Ngilethe isicelo sami phambi kwenkosi ukuthi ingangivumeli ngibuyele endlini kaJonathani ukuze ngifele khona.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        }
