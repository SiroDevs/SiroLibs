          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uma izikhulu zizwa ukuthi ngikhulumile kuwe, bese beza kuwe, bathi kuwe: Ake usitshele lokho owakukhuluma enkosini, ungasifihleli, futhi ngeke sikubulale; nalokho inkosi eyakusho kini:",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.25",
            "verseOrgIds": [
              "JER.38.25"
            ]
          }
        }
      ]
