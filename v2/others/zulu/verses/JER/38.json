        },
        {
          "text": "UJeremiya wayesethi kuZedekiya: “Usho kanje uJehova uNkulunkulu Sebawoti, uNkulunkulu ka-Israyeli, uthi: Uma uphumela nokuphumela ezikhulwini zenkosi yaseBabele, umphefumulo wakho uyakuphila, nalo muzi awuyikushiswa ngomlilo; futhi uzophila kanye nendlu yakho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.17",
            "verseOrgIds": [
              "JER.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
