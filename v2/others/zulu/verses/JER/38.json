          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho bonke abafazi bakho nabantwana bakho bayakukhiphela kumaKaledi; aniyikuphunyuka esandleni sabo, kepha niyakubanjwa ngesandla senkosi yaseBabele; futhi kumelwe uwushise lo muzi ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        }
      ]
    },
