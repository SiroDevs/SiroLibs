          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kamuva baphenduka babuyisela izinceku nezigqilakazi ababezikhulule bazenza izigqila zezinceku nezincekukazi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        }
