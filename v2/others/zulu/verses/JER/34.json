          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho izwi likaJehova lafika kuJeremiya livela kuJehova, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.12",
            "verseOrgIds": [
              "JER.34.12"
            ]
          }
        }
