          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova uNkulunkulu ka-Israyeli, uthi: ‘Ngenza isivumelwano nawoyihlo mhla ngibakhipha ezweni laseGibithe endlini yobugqila, ngathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.13",
            "verseOrgIds": [
              "JER.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
