          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuthi kube yilowo nalowo akhulule isigqila sakhe, kube yilowo nalowo isigqilakazi sakhe, umHeberu noma umHeberukazi; ukuze kungabi khona omkhonzayo, umJuda umfowabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
