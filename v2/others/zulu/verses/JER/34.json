          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.1",
            "verseOrgIds": [
              "JER.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova uNkulunkulu ka-Israyeli, uthi: Hamba, ukhulume kuSedekiya, inkosi yakwaJuda, uthi kuye: ‘Isho kanje iNkosi, ithi; bheka, ngiyawunikela lo muzi esandleni senkosi yaseBabele, futhi izowushisa ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.2",
            "verseOrgIds": [
              "JER.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.2",
            "verseOrgIds": [
              "JER.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awuyikuphunyuka esandleni sakhe, kepha uyakubanjwa nokunikelwa esandleni sakhe; amehlo akho ayobona amehlo enkosi yaseBhabhiloni, futhi iyokhuluma nawe umlomo nomlomo, futhi kumelwe uye eBhabhiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.3",
            "verseOrgIds": [
              "JER.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
