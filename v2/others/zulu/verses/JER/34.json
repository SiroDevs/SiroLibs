          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.3",
            "verseOrgIds": [
              "JER.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yizwa izwi likaJehova, Sedekiya, nkosi yakwaJuda! Nanku okutshiwo nguJehova ngawe: Kawuyikufa ngenkemba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.4",
            "verseOrgIds": [
              "JER.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.4",
            "verseOrgIds": [
              "JER.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha wena uyakufa ngokuthula, nangokushiswa kwawoyihlo, amakhosi akuqala ayephambi kwakho, bayakukushisela impepho; bayakulilela, bathi: “Awu, Nkosi! ngoba mina ngikhulumile ilizwi, kutsho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.5",
            "verseOrgIds": [
              "JER.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.5",
            "verseOrgIds": [
              "JER.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umprofethi uJeremiya wawakhuluma onke lawa mazwi kuZedekiya, inkosi yakwaJuda, eJerusalema,",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.6",
            "verseOrgIds": [
              "JER.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.6",
            "verseOrgIds": [
              "JER.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho impi yenkosi yaseBhabhiloni ilwa neJerusalema nayo yonke imizi yakwaJuda eyayisele, neLakishi ne-Azeka, ngoba le mizi eyinqaba yayisele emizini yakwaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
