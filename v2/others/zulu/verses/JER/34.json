            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekupheleni kweminyaka eyisikhombisa liyakukhulula, kube yilowo nalowo umfowabo, umHeberu owathengiswa kuwe; uma ekusebenzele iminyaka eyisithupha, uyakumkhulula kuwe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.14",
            "verseOrgIds": [
              "JER.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
