          "attrs": {
            "verseId": "JER.34.7",
            "verseOrgIds": [
              "JER.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leli yizwi elafika kuJehova kuJeremiya ngemva kokuba inkosi uZedekiya yenze isivumelwano nabo bonke abantu ababeseJerusalema ukuba bakhalele ukukhululwa kwabo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.8",
            "verseOrgIds": [
              "JER.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
