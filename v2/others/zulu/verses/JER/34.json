          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje seniphendukile nenza okulungile emehlweni ami ngokumemeza kube yilowo nalowo inkululeko yomakhelwane wakhe; futhi wenze isivumelwano phambi kwami endlini ebizwa ngegama lami.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.15",
            "verseOrgIds": [
              "JER.34.15"
            ]
          }
        }
      ]
    },
    {
