            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa naphenduka, nalihlambalaza igama lami, nabuyisela, kwaba yilowo nalowo isigqila sakhe, kwaba yilowo nalowo incekukazi yakhe enayikhulula ngokuthanda kwenu, nabathobisa ukuba babe yizinceku nezincekukazi zenu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.16",
            "verseOrgIds": [
