          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho zonke izikhulu nabo bonke abantu ababengene esivumelwaneni bezwa ukuthi, kwaba yilowo nalowo kwakumelwe adedele inceku yakhe nencekukazi yakhe ukuba ihambe, ukuze bangabe besabakhonza, balalela bahambe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.10",
            "verseOrgIds": [
              "JER.34.10"
            ]
          }
        }
      ]
    },
    {
