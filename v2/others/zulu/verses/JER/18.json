            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi elafika kuJeremiya livela kuJehova, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        }
