            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukwenza izwe labo libe yihlane nomnyenyezo waphakade; wonke umuntu odlulayo uyoma ngokumangala anikine ikhanda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
