              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingabe ububi buyobuyiselwa ngokuhle? ngoba bembele umphefumulo wami umgodi. Khumbula ukuthi ngema phambi kwakho ukubakhulumela kahle, ngisuse ulaka lwakho kubo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
            ]
          }
        }
