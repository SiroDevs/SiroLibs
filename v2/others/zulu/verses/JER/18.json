          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngilalele, Jehova, ulalele izwi labaphikisana nami.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
