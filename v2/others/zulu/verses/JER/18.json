          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubahlakaza njengomoya wasempumalanga phambi kwesitha; ngiyakubukisa umhlane wabo, hhayi ubuso babo ngosuku lobubi babo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
