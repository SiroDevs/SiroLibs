      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova Sebawoti, uNkulunkulu ka-Israyeli, ngo-Ahabi indodana kaKholaja, nakuSedekiya indodana kaMahaseya, abaprofetha amanga kini egameni lami; Bheka, ngiyabanikela esandleni sikaNebukadinesari, inkosi yaseBabele; futhi iyakubabulala phambi kwamehlo enu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
