      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wangibonisa; bheka, amaqoma amabili amakhiwane emi phambi kwethempeli likaJehova emva kukaNebukadinesari, inkosi yaseBabele, noJekoniya, indodana kaJehoyakimi, inkosi yakwaJuda, nezikhulu zakwaJuda kanyekanye. Ababazi bathunjwa. Nabakhandi bensimbi bevela eJerusalema, babayisa eBabele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esinye isitsha sasinamakhiwane amahle kakhulu, njengamakhiwane avuthwa kuqala; esinye isitsha sasinamakhiwane amaningi amabi, ayengenakudliwa ngokuba mabi kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.2",
            "verseOrgIds": [
              "JER.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.2",
            "verseOrgIds": [
              "JER.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi kimi: Ubonani, Jeremiya? Ngathi: Amakhiwane; amakhiwane amahle, emahle kakhulu; nokubi, kubi kakhulu, okungadliwa, kubi kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
