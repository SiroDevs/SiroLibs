          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuthuma phakathi kwabo inkemba, nendlala, nesifo, baze baqedwe ezweni engalinika bona nawoyise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.10",
            "verseOrgIds": [
              "JER.24.10"
            ]
          }
        }
