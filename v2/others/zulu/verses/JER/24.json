            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uNkulunkulu ka-Israyeli; Njengalawa makhiwane amahle, kanjalo ngiyakubabona abathunjwa bakwaJuda, engabasusa kule ndawo, babayisa ezweni lamaKaledi, kube kuhle kubo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubeka iso lami kubo kube kuhle, ngibabuyisele kuleli zwe; ngiyakubakha, ngingababhidli; ngiyakubatshala, ngingabasindi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakubanika inhliziyo yokungazi mina, ukuthi nginguJehova; bayakuba ngabantu Kimi, mina ngibe nguNkulunkulu wabo; ngoba bayobuyela kimi ngenhliziyo yabo yonke.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengamakhiwane amabi angadliwa, mabi kakhulu; “Usho kanje uJehova, uthi: “Usho kanje uJehova, uthi: Ngiyakumnika kanje uSedekiya inkosi yakwaJuda, nezikhulu zakhe, nensali yaseJerusalema esele kuleli zwe nabakhileyo ezweni laseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 24:8"
          },
          "items": [
            {
