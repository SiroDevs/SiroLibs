            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathumela bamthatha uJeremiya egcekeni letilongo bamnikela kuGedaliya indodana ka-Ahikamu kaShafani ukuba amlethe ekhaya; ngalokho wahamba wayohlala phakathi kwabantu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
            "verseOrgIds": [
              "JER.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 39:14"
          },
          "items": [
            {
              "text": "14",
