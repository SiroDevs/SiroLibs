          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNebusaradani induna yabalindi wathuma, noNebusabhani, noRabisarisi, noNergali-Sareseri, uRabimagi, nazo zonke izikhulu zenkosi yaseBabele;",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.13",
            "verseOrgIds": [
              "JER.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
