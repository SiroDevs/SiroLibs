          "type": "text",
          "attrs": {
            "verseId": "JER.39.14",
            "verseOrgIds": [
              "JER.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kuJeremiya evalelwe egcekeni letilongo, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.15",
            "verseOrgIds": [
              "JER.39.15"
            ]
          }
        }
      ]
    },
    {
