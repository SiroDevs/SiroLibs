          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.15",
            "verseOrgIds": [
              "JER.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamba ukhulume ku-Ebhedi-Melegi umKushe, uthi: Usho kanje uJehova Sebawoti, uNkulunkulu ka-Israyeli; Bheka, ngiletha amazwi ami ngalo muzi ngokubi, kungabi ngokuhle; futhi ziyogcwaliseka phambi kwenu ngalolo suku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.16",
            "verseOrgIds": [
              "JER.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.16",
            "verseOrgIds": [
              "JER.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa mina ngizalisindisa ngalolosuku, kutsho uJehova, njalo kawuyikunikelwa esandleni sabantu elibesabayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.17",
            "verseOrgIds": [
              "JER.39.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
