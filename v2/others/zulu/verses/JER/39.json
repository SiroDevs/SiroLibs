          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.11",
            "verseOrgIds": [
              "JER.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mthathe, umbheke kahle, ungamenzi okubi; kodwa yenzani kuye njengokutsho kwakhe kini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.12",
            "verseOrgIds": [
              "JER.39.12"
            ]
          }
        }
      ]
    },
    {
