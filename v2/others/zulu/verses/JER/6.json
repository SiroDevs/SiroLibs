          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayakuthatha umnsalo nomkhonto; banonya futhi abanasihe; izwi labo liduma njengolwandle; bagibele amahhashi, behlomele njengamadoda okulwa nawe, ndodakazi yaseSiyoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.23",
            "verseOrgIds": [
              "JER.6.23"
            ]
          }
        }
