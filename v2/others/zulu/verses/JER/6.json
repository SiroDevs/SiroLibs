          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, yizwani, O zizwe, futhi wazi, O bandla, ukuthi yini phakathi kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.18",
