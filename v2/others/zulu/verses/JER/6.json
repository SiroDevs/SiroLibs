          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isifutho siyasha, umthofu udliwa ngumlilo; umsunguli uncibilika ngeze, ngokuba ababi abasishulwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.29",
