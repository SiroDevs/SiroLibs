          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungani kufike kimi impepho evela eSheba, nomhlanga omnandi ovela ezweni elikude? iminikelo yenu yokushiswa ayamukeleki, neminikelo yenu yokushiswa ayimnandi Kimi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.20",
