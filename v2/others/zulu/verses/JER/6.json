          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningangeni ensimini, ningahambi endleleni; ngokuba inkemba yesitha nokwesaba kuzungezile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.25",
            "verseOrgIds": [
              "JER.6.25"
            ]
          }
        }
