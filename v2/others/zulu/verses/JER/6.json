          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sizwile umbiko ngakho: izandla zethu zibuthakathaka; sibanjwe usizi nobuhlungu njengobelethayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.24",
