          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikwenze umbhoshongo nenqaba phakathi kwabantu bami, ukuze wazi indlela yabo, ubavivinye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.27",
            "verseOrgIds": [
              "JER.6.27"
            ]
          }
