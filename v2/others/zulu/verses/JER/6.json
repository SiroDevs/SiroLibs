              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke bangabahlengi abanonya, abahamba ngokuhlambalaza; bayithusi nensimbi; bonke bakhohlakele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.28",
