          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: “Bheka, kuyakuvela abantu ezweni lasenyakatho, kuvele isizwe esikhulu emikhawulweni yomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.22",
