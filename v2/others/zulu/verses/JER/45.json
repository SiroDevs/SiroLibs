          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi umprofethi uJeremiya alikhuluma kuBaruki indodana kaNeriya ekulobeni lawa mazwi encwadini ephuma emlonyeni kaJeremiya, ngomnyaka wesine kaJehoyakimi, indodana kaJosiya, inkosi yakwaJuda, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
