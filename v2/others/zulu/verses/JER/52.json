            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wamashumi amabili nantathu kaNebukadinesari uNebuzaradani induna yabalindi wathumba phakathi kwabaJuda abantu abangamakhulu ayisikhombisa namashumi amane nanhlanu; bonke abantu babe yizinkulungwane ezine namakhulu ayisithupha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
