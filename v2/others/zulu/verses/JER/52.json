            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke uNebuzaradani, induna yabalindi, nabanye babampofu babantu, nensali yabantu ababesele emzini, nabahlubukayo, abahlubuka enkosini yaseBabele, nabanye abantu bahola. Kude njengeziboshwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
