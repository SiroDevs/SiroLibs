          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "USedekiya wayeneminyaka engamashumi amabili nanye ekuqaleni kwakhe ukubusa, wabusa iminyaka eyishumi nanye eJerusalema; Igama likanina lalinguHamuthali, indodakazi kaJeremiya, waseLibina.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        }
      ]
    },
    {
