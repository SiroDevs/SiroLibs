        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.10",
            "verseOrgIds": [
              "JER.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhipha amehlo kaZedekiya; inkosi yaseBabele yambopha ngamaketanga, yamyisa eBabele, yamfaka etilongweni kwaze kwaba lusuku lokufa kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        }
      ]
    },
    {
