            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uNebuzaradani induna yabalindi watshiya abanye babampofu belizwe kubalimi bewayini labalimi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
