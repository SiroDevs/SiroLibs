          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba ngabantu uNebukadinesari abathumbile: ngomnyaka wesikhombisa abaJuda abayizinkulungwane ezintathu namashumi amabili nantathu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
