            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke impi yamaKaledi eyayinenduna yemilindankosi yadiliza zonke izindonga zaseJerusalema nxazonke.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        }
      ]
    },
    {
