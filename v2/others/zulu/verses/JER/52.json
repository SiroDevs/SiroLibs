          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka weshumi nesishiyagalombili kaNebukadinesari wathumba eJerusalema abantu abangamakhulu ayisishiyagalombili namashumi amathathu nambili.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
