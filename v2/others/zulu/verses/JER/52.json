            "number": "17",
            "style": "v",
            "sid": "JER 52:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi izinsika zethusi ezazisendlini kaJehova, nezitsha zokugezela nolwandle lwethusi okwakusendlini kaJehova amaKhaledi akuhlephula alithatha kuzo lonke ithusi aliyisa eBhabhiloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
