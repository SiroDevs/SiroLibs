        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.12",
            "verseOrgIds": [
              "JER.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
