      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZedekiya indodana kaJosiya wabusa esikhundleni sikaKhoniya indodana kaJehoyakimi owabekwa inkosi ezweni lakwaJuda uNebukadinesari, inkosi yaseBabele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha yena nezinceku zakhe nabantu bezwe abawalalelanga amazwi kaJehova awakhuluma ngomprofethi uJeremiya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uZedekiya yathuma uJehukali indodana kaShelemiya noZefaniya indodana kaMahaseya umpristi kuJeremiya umprofethi ukuthi: “Sikhulekele kuJehova uNkulunkulu wethu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJeremiya wayesengena ephuma phakathi kwabantu, ngokuba abamfakanga etilongweni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impi kaFaro yaphuma eGibithe; kwathi amaKaledi avimbezela iJerusalema ezwa umbiko kubo, asuka eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kuJeremiya umprofethi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova uNkulunkulu ka-Israyeli, uthi: ‘Nakhu eniyakukusho enkosini yakwaJuda othumele kimi ukubuza kimi; bheka, impi kaFaro eyaphuma ukunisiza iyakubuyela ezweni layo eGibithe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaKaledi ayakubuya alwe nalo muzi, awuthathe, awushise ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: Ningazikhohlisi, nithi: AmaKaledi ayakusishiya nokusishiya, ngokuba awayikumuka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba noma benilichithe lonke ibutho lamaKaledi alwa nani, kwasala abalimele phakathi kwabo, nokho bebeyakuma, kube yilowo nalowo etendeni lakhe, awushise lo muzi ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho impi yamaKaledi iphuma eJerusalema ngenxa yokwesaba impi kaFaro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJeremiya wayesesuka eJerusalema waya ezweni lakwaBenjamini, azehlukanise khona phakathi kwabantu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi esesangweni lakwaBenjamini, kwakukhona induna yabalindi, igama layo lingu-Iriya indodana kaShelemiya kaHananiya; yambamba umprofethi uJeremiya, yathi: “Niwela kumaKaledi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJeremiya wasesithi: Lokhu kungamanga; angihlubukeli kumaKaledi. Kodwa akazange amlalele, ngakho u-Iriya wamthatha uJeremiya wamyisa ezikhulwini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhulu zamthukuthelela uJeremiya, zamehlula, zamfaka etilongweni endlini kaJonathani umbhali, ngokuba zayenza itilongo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uJeremiya engena emthonjeni nasezindlini zamakamelo, uJeremiya ehlala khona izinsuku eziningi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uZedekhiya yasithuma yamkhupha; inkosi yambuza ngasese endlini yayo, yathi: “Likhona izwi elivela kuJehova na? Wathi uJeremiya: “Kukhona, ngokuba wathi, uyakunikelwa esandleni senkosi yaseBabele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
