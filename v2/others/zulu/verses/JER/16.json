            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kimi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        }
