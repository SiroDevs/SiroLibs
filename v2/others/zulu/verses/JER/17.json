          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kabalalelanga, kababekanga indlebe yabo, kodwa bayenza lukhuni intamo yabo ukuze bangezwa loba bemukele ukulaywa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
