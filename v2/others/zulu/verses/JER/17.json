          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "uthi kubo: ‘Yizwani izwi likaJehova nina makhosi akwaJuda noJuda wonke nani nonke enakhileyo eJerusalema eningena ngalawa masango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
