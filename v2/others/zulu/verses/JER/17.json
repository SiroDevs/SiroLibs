          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.16",
            "verseOrgIds": [
              "JER.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungabi yingebhe kimi; uyithemba lami ngosuku lobubi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.17",
            "verseOrgIds": [
              "JER.17.17"
            ]
          }
        }
      ]
    },
