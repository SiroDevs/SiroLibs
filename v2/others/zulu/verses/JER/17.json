          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: Ziqapheleni nina, ningathwali mthwalo ngosuku lwesabatha, ningawungenisi ngamasango aseJerusalema;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
