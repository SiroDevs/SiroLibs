        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impela, njengokungathi umfazi eshiya umyeni wakhe ngokungathembeki, kanjalo nenzé ubuphambeko kimi nina ndlu ka-Israyeli,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.20",
            "verseOrgIds": [
              "JER.3.20"
            ]
          }
        }
      ]
    },
