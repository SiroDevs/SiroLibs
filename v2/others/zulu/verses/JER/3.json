          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngathi: Ngizakubeka njani phakathi kwabantwana, ngikunike ilizwe elihle, ilifa elihle elivela emaviyweni ezizwe? futhi ngathi: Kumelwe ningibize ngokuthi ubaba; njalo kayikusuka kimi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
