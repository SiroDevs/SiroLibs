            "number": "22",
            "style": "v",
            "sid": "JER 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buyani, nina bantwana abahlubukayo, ngizakwelapha iziphambeko zenu. Bheka, siyeza kuwe; ngoba wena unguJehova uNkulunkulu wethu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
