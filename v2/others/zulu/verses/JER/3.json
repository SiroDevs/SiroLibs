          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngempela, insindiso ithenjwa ize evela emagqumeni nasebuningini bezintaba; ngempela, ikuJehova uNkulunkulu wethu ukusindiswa kuka-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
