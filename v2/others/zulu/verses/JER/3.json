        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwezwakala izwi ezindaweni eziphakemeyo, ukukhala nokunxusa kwabantwana bakwa-Israyeli, ngokuba babephambukile indlela yabo, bamkhohlwa uJehova uNkulunkulu wabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
