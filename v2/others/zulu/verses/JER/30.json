            "sid": "JER 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhulu zabo ziyophuma kubo, umbusi wabo aphume phakathi kwabo; ngiyakumsondeza, asondele Kimi; kusho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.21",
