          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi kubo kuyophuma ukubonga nezwi labajabulayo; ngiyakubandisa, bangabi yingcosana; futhi ngizobakhazimulisa, futhi ngeke badelelwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.19",
            "verseOrgIds": [
