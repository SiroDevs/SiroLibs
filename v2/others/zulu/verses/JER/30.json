          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana babo bayakuba njengakuqala, nenhlangano yabo ime phambi kwami, ngihambele bonke ababacindezelayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.20",
            "verseOrgIds": [
              "JER.30.20"
            ]
          }
        }
