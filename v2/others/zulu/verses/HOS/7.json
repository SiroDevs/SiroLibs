          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kubo! ngoba bangibalekile, incithakalo iphezu kwabo. Ngoba beqile kimi; nakuba ngibahlengile, bakhuluma amanga ngami.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        }
      ]
    },
    {
