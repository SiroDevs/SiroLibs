          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abangibizanga ngenhliziyo, lapho bekhala emibhedeni yabo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.14",
            "verseOrgIds": [
              "HOS.7.14"
            ]
          }
        }
      ]
