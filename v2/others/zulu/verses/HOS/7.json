          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayabuya, kepha ababuyeli koPhezukonke; banjengomnsalo okhohlisayo; izikhulu zabo ziyakuwa ngenkemba ngenxa yentukuthelo yolimi lwabo; kuyakuba yinhlekisa kubo ezweni laseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.16",
            "verseOrgIds": [
              "HOS.7.16"
            ]
          }
        }
