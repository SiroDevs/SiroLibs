          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.14",
            "verseOrgIds": [
              "HOS.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma ngizibophile ngaziqinisa izingalo zabo, nokho bacabanga okubi ngami.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.15",
            "verseOrgIds": [
              "HOS.7.15"
            ]
          }
        }
      ]
