      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho behamba, ngiyozendlala phezu kwabo; ngizabehlisela phansi njengezinyoni zezulu; Ngizobajezisa njengokuzwa kwabo ukuhlangana.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
            ]
          }
        }
      ]
    },
    {
