        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungathokozi, Israyeli, ngokuthokoza njengezizwe; ngokuba ufebile kuNkulunkulu wakho, wathanda umvuzo ezibuyani zamabele.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isibuya nesikhamo sewayini akuyikubapha ukudla, notshani buyophela kubo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayikuhlala ezweni likaJehova; kepha u-Efrayimi uyakubuyela eGibithe, badle okungcolileyo e-Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanakunikela ngewayini kuJehova, futhi abayikumthokozisa; izisulu zabo ziyoba njengesinkwa sokulila kubo; bonke abakudlayo bayakuba ngabangcolile, ngokuba isinkwa sabo asiyikungena endlini kaJehova ngenxa yomphefumulo wabo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakwenzani ngosuku lomkhosi nangosuku lomkhosi kaJehova na?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bhekani, sebehambile ngenxa yokubhujiswa; izindawo zobumnandi besiliva labo liyakudliwa yizimbabazane; ameva ayakuba sematendeni abo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsuku zokuhanjelwa sezifikile, izinsuku zokuphindisela sezifikile; U-Israyeli uyakukwazi lokhu: Umprofethi uyisiwula, nomuntu ongokomoya uyahlanya, ngenxa yobuningi bobubi bakho nenzondo enkulu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umlindi ka-Efrayimi wayenoNkulunkulu wami, kepha umprofethi ulugibe lomcuphi wezinyoni ezindleleni zakhe zonke, nenzondo endlini kaNkulunkulu wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazonakalisa ngokujulile njengasezinsukwini zaseGibeya; ngalokho uyakukhumbula ububi babo, ahambele izono zabo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngafumana u-Israyeli enjengezithelo zomvini ehlane; Ngabona oyihlo njengezithwathwa zokuqala emkhiwaneni ekuqaleni kwawo; kepha baya eBali Peyori, bazihlukanisela ihlazo; nezinengiso zabo zazinjengokuthanda kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha u-Efrayimi, udumo lwakhe luyondiza lumuke njengenyoni, ekuzalweni nasesiswini nasekukhulelweni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.11",
            "verseOrgIds": [
              "HOS.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.11",
            "verseOrgIds": [
              "HOS.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma bekhulisa abantwana babo, nokho ngiyakubaphanga, kungabikho muntu; yebo, maye kubo futhi lapho ngisuka kubo!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.12",
            "verseOrgIds": [
              "HOS.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.12",
            "verseOrgIds": [
              "HOS.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Efrayimi, njengalokho ngabona iTire, litshalwe endaweni emnandi, kepha u-Efrayimi uyakukhiphela umbulali abantwana bakhe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.13",
            "verseOrgIds": [
              "HOS.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.13",
            "verseOrgIds": [
              "HOS.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baphe, Jehova, uzabanikani? abakhiphe isisu futhi ome amabele.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.14",
            "verseOrgIds": [
              "HOS.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.14",
            "verseOrgIds": [
              "HOS.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke ububi babo buseGiligali, ngokuba ngabazonda khona; ngenxa yobubi bezenzo zabo ngiyakubaxosha endlini yami, angisayikubathanda; zonke izikhulu zabo ziyizihlubuki.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.15",
            "verseOrgIds": [
              "HOS.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.15",
            "verseOrgIds": [
              "HOS.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Efrayimi ushayiwe, impande yabo yomile, abayikuthela; noma bezala, nokho ngiyakubulala isithelo esithandekayo sesisu sabo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.16",
            "verseOrgIds": [
              "HOS.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.16",
            "verseOrgIds": [
              "HOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HOS 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wami uyakubalahla, ngokuba abamlalelanga, bayakuba yizihambi phakathi kwezizwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.17",
            "verseOrgIds": [
              "HOS.9.17"
            ]
          }
        }
      ]
    }
