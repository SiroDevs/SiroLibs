        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho abantwana bakwa-Israyeli bayakubuya bamfune uJehova uNkulunkulu wabo noDavide inkosi yabo; bayakumesaba uJehova nomusa wakhe ekupheleni kwezinsuku.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
