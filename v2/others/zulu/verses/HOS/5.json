          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.12",
            "verseOrgIds": [
              "HOS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho u-Efrayimi ebona ukugula kwakhe, noJuda ebona isilonda sakhe, u-Efrayimi waya e-Asiriya, wathumela enkosini uJarebi; kodwa akakwazanga ukukuphulukisa nokukuphulukisa isilonda sakho.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.13",
            "verseOrgIds": [
              "HOS.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
