          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.13",
            "verseOrgIds": [
              "HOS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiyoba njengengonyama ku-Efrayimi nanjengebhongo lengonyama endlini kaJuda; nami ngiyakuklebhula, ngimuke; ngiyakususa, akakho oyomsindisa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.14",
            "verseOrgIds": [
              "HOS.5.14"
            ]
          }
        }
      ]
    },
