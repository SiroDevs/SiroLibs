          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZebuloni uyakuhlala ngasechwebeni lolwandle; futhi uyakuba yichweba lemikhumbi; futhi umkhawulo wakhe uyofinyelela eSidoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
