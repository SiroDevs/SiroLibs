          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke kuyoba khona inyoka endleleni, inyoka endleleni, iluma ihhashi ezithendeni, ukuze umgibeli walo awe nyovane.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        }
      ]
