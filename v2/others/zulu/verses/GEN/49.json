          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Isakare uyimbongolo enamandla elele phakathi kwemithwalo emibili;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.14",
            "verseOrgIds": [
              "GEN.49.14"
            ]
          }
        }
      ]
