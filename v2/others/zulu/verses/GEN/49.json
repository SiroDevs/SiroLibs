          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabona ukuthi ukuphumula kuhle, nezwe limnandi; wagoba ihlombe lakhe ukuba athwale, waba yisigqila sokutheliswa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.15",
            "verseOrgIds": [
              "GEN.49.15"
            ]
          }
        }
      ]
    },
