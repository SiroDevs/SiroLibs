            "sid": "GEN 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke abantu bayo bayokwahlulela njengesinye sezizwe zakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.16",
            "verseOrgIds": [
              "GEN.49.16"
            ]
          }
        }
      ]
