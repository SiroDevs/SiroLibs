          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wanisa isibabule nomlilo phezu kweSodoma neGomora kuvela ezulwini;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        }
      ]
    },
    {
