          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka-ke, lo muzi useduze ukuba ngibalekele kuwo, futhi mncane;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.20",
            "verseOrgIds": [
              "GEN.19.20"
            ]
          }
        }
      ]
