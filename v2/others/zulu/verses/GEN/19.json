          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka manje, inceku yakho ifumene umusa emehlweni akho, futhi ukhulise umusa wakho ongenzele wona kimi ngokusindisa ukuphila kwami; futhi anginakubalekela entabeni, funa ububi bungifike ngife.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.19",
            "verseOrgIds": [
              "GEN.19.19"
            ]
          }
        }
      ]
    },
    {
