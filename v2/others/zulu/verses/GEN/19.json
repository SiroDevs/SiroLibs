          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: “Bheka, nami ngikuthokozisile ngale ndaba, ukuthi angiyikuwubhubhisa lo muzi okhulume ngawo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        }
      ]
    },
    {
