              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wathi: “Lokhu kuyisibonakaliso sesivumelwano engisenza phakathi kwami nani nazo zonke izidalwa eziphilayo ezikini kuze kube phakade.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.12",
            "verseOrgIds": [
              "GEN.9.12"
            ]
          }
        }
      ]
    },
