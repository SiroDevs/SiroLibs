          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nazo zonke izidalwa eziphilayo ezikini, izinyoni, nezinkomo, nezilwane zonke zomhlaba ezikanye nani; kubo bonke abaphuma emkhunjini, kuzo zonke izilwane zomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
            "verseOrgIds": [
              "GEN.9.10"
            ]
