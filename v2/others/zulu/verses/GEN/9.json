          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngempela, igazi lempilo yenu ngizolibiza; esandleni sazo zonke izilwane ngiyakulibiza, nasesandleni somuntu; esandleni somfowabo ngamunye ngiyakufuna ukuphila komuntu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        }
      ]
    },
    {
