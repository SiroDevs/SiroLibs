            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngiyamisa isivumelwano sami nawe nenzalo yakho emva kwakho;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.9",
            "verseOrgIds": [
