              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ngehlisela ifu phezu komhlaba, uthingo luyobonakala efwini;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
              "GEN.9.14"
