          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha inyama enomphefumulo wayo, okuyigazi layo, aniyikuyidla.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.4",
            "verseOrgIds": [
              "GEN.9.4"
            ]
          }
        }
      ]
