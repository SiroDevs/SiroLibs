          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakuqinisa isivumelwano sami nawe; futhi yonke inyama ayisayikunqunywa ngamanzi kazamcolo; futhi ngeke kusaba khona uzamcolo wokubhubhisa umhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        }
