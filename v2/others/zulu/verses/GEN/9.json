          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochitha igazi lomuntu, igazi lakhe liyakuchithwa ngumuntu, ngokuba umuntu wamenza umuntu ngomfanekiso kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
