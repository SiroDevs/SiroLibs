          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konke okuphilayo kuzakuba ngukudla kwenu; njengekhambi eliluhlaza ngikunike konke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        }
      ]
    },
    {
