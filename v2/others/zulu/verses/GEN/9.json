              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wambusisa uNowa namadodana akhe, wathi kubo: “Zalani nande nigcwalise umhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
