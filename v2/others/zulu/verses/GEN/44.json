          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uma futhi nikususa kimi futhi ehlelwa okubi, niyokwehlisela izinwele zami ezimpunga endaweni yabafileyo ngokudabuka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.29",
            "verseOrgIds": [
              "GEN.44.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
