            "verseOrgIds": [
              "GEN.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yami yasibuza izinceku zayo yathi: Lilobaba yini kumbe umfowenu?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.19",
            "verseOrgIds": [
              "GEN.44.19"
            ]
          }
        }
      ]
    },
    {
