          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi ubaba: “Buyelani, nisithengele ukudla.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.25",
            "verseOrgIds": [
              "GEN.44.25"
            ]
          }
        }
      ]
    },
