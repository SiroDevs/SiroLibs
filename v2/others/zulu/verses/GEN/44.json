          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngingakhuphukela kanjani kubaba, umfana engekho nami? ukuze ngingabuboni ububi obehlela ubaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.34",
            "verseOrgIds": [
              "GEN.44.34"
            ]
          }
        }
