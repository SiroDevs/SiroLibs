          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sathi enkosini yami: Indodana ayinakumshiya uyise, ngokuba uma imshiya uyise, uyise uyakufa;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.22",
            "verseOrgIds": [
              "GEN.44.22"
            ]
          }
        }
      ]
    },
    {
