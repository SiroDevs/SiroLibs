          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi wena ezincekwini zakho: ‘Uma umfowenu omncane engehli nani, anisayikubona ubuso bami futhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.23",
            "verseOrgIds": [
              "GEN.44.23"
            ]
          }
        }
      ]
    },
