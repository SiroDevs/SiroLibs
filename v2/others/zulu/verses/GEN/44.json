      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.19",
            "verseOrgIds": [
              "GEN.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sathi enkosini yami: ‘Sinobaba ixhegu, nomntwana wobungane bakhe omncane; umfowabo wafa, yena wasala yedwa kunina, uyise wamthanda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.20",
            "verseOrgIds": [
              "GEN.44.20"
            ]
          }
        }
      ]
    },
    {
