        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.29",
            "verseOrgIds": [
              "GEN.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ngifika encekwini yakho, ubaba, futhi indodana ingekho kithi; ebona ukuthi impilo yakhe iboshelwe empilweni yomfana;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.30",
            "verseOrgIds": [
              "GEN.44.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.30",
            "verseOrgIds": [
              "GEN.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ebona ukuthi umfana akekho kithi, uzokufa; izinceku zakho ziyakwehlisela izinwele ezimpunga zenceku yakho, ubaba ethuneni ngosizi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.31",
            "verseOrgIds": [
              "GEN.44.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.31",
            "verseOrgIds": [
              "GEN.44.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 44:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba inceku yakho yenze isibambiso sendodana nobaba, yathi: ‘Uma ngingayikumletha kuwe, ngiyakuthwala icala likababa kuze kube phakade.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.32",
            "verseOrgIds": [
              "GEN.44.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 44:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.32",
            "verseOrgIds": [
              "GEN.44.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 44:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje ake inceku yakho ihlale esikhundleni somfana, isigqila senkosi yami; umfana akhuphuke nabafowabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.33",
            "verseOrgIds": [
              "GEN.44.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 44:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.33",
            "verseOrgIds": [
