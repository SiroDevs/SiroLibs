        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekusithi ekunyukeni kwethu kunceku yakho, ubaba, samtshela amazwi enkosi yami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.24",
            "verseOrgIds": [
              "GEN.44.24"
            ]
          }
        }
      ]
    },
    {
