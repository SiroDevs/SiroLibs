        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.20",
            "verseOrgIds": [
              "GEN.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi wena ezincekwini zakho: ‘Mehliseleni kimi, ukuze ngimbone ngamehlo ami.’",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.21",
            "verseOrgIds": [
              "GEN.44.21"
            ]
          }
        }
      ]
    },
    {
