        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasebiza ibizo leN kosi eyayikhuluma laye wathi: UNkulunkulu wakho uyangibona, ngoba wathi: Kambe ngimbonile yini lapha ongibonayo?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        }
      ]
    },
    {
