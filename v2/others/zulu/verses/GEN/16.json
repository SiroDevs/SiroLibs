          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrama wayeneminyaka engamashumi ayisishiyagalombili nesithupha mhla uHagari emzalela u-Abrama u-Ishmayeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
