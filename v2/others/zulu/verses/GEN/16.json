        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakuba ngumuntu wasendle; isandla sakhe siyakuba phezu kwawo wonke umuntu, nesandla sawo wonke sibe phezu kwakhe; futhi uyakuhlala phambi kwabo bonke abafowabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 16:12"
          },
          "items": [
            {
              "text": "12",
