          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabathatha, wabawelisa umfula, wathumela lokho anakho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.23",
            "verseOrgIds": [
              "GEN.32.23"
            ]
          }
        }
      ]
    },
