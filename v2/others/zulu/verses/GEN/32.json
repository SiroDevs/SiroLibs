              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe wambuza wathi: “Ngitshele igama lakho.” Wathi: “Ubuzelani igama lami na? Wambusisa lapho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
