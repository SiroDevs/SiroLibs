          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe wasala yedwa; kwaba khona umuntu wabambana naye kwaze kwasa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.24",
            "verseOrgIds": [
              "GEN.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 32:24"
          },
          "items": [
