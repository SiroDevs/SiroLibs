            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho abantwana bakwa-Israyeli abawudli umsipha wenyonga kuze kube namuhla, ngokuba wathinta esikhoxeni senyonga kaJakobe emsipheni oshwabeneyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
        }
