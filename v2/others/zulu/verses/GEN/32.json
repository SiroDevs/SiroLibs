        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.21",
            "verseOrgIds": [
              "GEN.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wavuka ngalobo busuku, wathatha abafazi bakhe ababili nezincekukazi zakhe ezimbili namadodana akhe ayishumi nanye, wadabula isigodi saseJabhoki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.22",
            "verseOrgIds": [
              "GEN.32.22"
            ]
          }
        }
      ]
    },
    {
