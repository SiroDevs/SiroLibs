              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "USara wayeneminyaka eyikhulu namashumi amabili nesikhombisa; le yayiyiminyaka yokuhamba kukaSara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.1",
