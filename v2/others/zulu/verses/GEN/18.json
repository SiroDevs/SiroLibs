        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.22",
            "verseOrgIds": [
              "GEN.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrahama wasondela, wathi: “Niyakubhubhisa olungileyo kanye nomubi na?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.23",
            "verseOrgIds": [
              "GEN.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.23",
            "verseOrgIds": [
              "GEN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhlawumbe kukhona abalungileyo abangamashumi amahlanu emzini; uyakuyichitha indawo, ungahawukeli abalungileyo abangamashumi ayisihlanu abakuyo na?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.24",
            "verseOrgIds": [
              "GEN.18.24"
            ]
          }
        }
      ]
    },
    {
