        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: “Mayingathukutheli iNkosi, mina-ke ngiyakukhuluma: Mhlawumbe kungafunyanwa abangamashumi amathathu.” Wathi: “Angiyikukwenza uma ngithola amashumi amathathu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        }
      ]
    },
    {
