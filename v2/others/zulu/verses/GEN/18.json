          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiyamazi, ukuze ayale abantwana bakhe nendlu yakhe emva kwakhe, bagcine indlela yeNkosi, benze ukulunga nokulunga; ukuze uJehova amehlisele u-Abrahama lokho ekushilo ngaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
