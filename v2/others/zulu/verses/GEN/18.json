          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.25",
            "verseOrgIds": [
              "GEN.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yathi iNkosi: “Uma eSodoma ngifumana abalungileyo abangamashumi ayisihlanu emzini, ngiyakuhawukela yonke indawo ngenxa yabo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrahama waphendula, wathi: “Bheka, nginqume ukukhuluma neNkosi, eluthuli nomlotha.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
