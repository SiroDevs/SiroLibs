          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “INkosi mayingathukutheli, ngisakhuluma kanye nje: Mhlawumbe kungafunyanwa abayishumi khona.” Wathi: “Angiyikuwubhubhisa ngenxa yabayishumi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        }
