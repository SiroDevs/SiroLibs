              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasihamba indlela yayo, isiqedile ukukhuluma loAbrahama; uAbrahama wasebuyela endaweni yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.33",
