          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi: Ngoba isililo seSodoma leGomora sikhulu, langoba isono sabo sinzima kakhulu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        }
      ]
    },
    {
