          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Bheka-ke, ngibeke phezu kwami ukukhuluma neNkosi: Mhlawumbe kuyotholwa abangamashumi amabili.” Wathi: “Angiyikuwubhubhisa ngenxa yabangamashumi amabili.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
              "GEN.18.31"
            ]
          }
        }
