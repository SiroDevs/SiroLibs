              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Adamu waziqamba amagama zonke izinkomo, nezinyoni zonke zezulu, nezilwane zasendle; kepha u-Adamu akafunyanwanga umsizi onjengaye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.20",
