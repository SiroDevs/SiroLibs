              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwase kupheleliswa izulu nomhlaba kanye nebandla lakho lonke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.1",
            "verseOrgIds": [
