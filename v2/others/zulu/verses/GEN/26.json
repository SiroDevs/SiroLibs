          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indoda yakhula, yaqhubeka ikhula, yaze yaba nkulu kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.13",
            "verseOrgIds": [
              "GEN.26.13"
