          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze ungasenzeli okubi, ngoba kasizange sikuthintile, lanjengoba sikwenzele okuhle kuphela, sikumukisa ngokuthula; manje usubusisiwe weNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.29",
            "verseOrgIds": [
              "GEN.26.29"
            ]
          }
        }
