          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke imithombo ezayimba izinceku zikayise ezinsukwini zika-Abrahama uyise, amaFilisti ayivala ayigcwalisa ngomhlabathi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
