              "GEN.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadoda aleyondawo ambuza ngomkakhe; wathi: “Ungudadewethu, ngokuba wayesaba ukuthi: ‘Ungumkami;’ wathi, ukuze bangangibulali abantu baleyondawo ngenxa kaRebeka; ngoba wayemuhle ukubukwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi, eselapho isikhathi eside, u-Abimeleki, inkosi yamaFilisti, walunguza ngefasitela, wabona, bheka, u-Isaka edlala noRebeka umkakhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.8",
            "verseOrgIds": [
              "GEN.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.8",
            "verseOrgIds": [
              "GEN.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abimeleki wambiza u-Isaka, wathi: “Bheka, ngempela ungumkakho; futhi utheni, Ungudadewethu? UIsaka wasesithi kuye: Ngoba ngithe: Kangiyikufela yena.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi u-Abimeleki: “Wenzeni kithi na? omunye wabantu ubengalala nomkakho kalula, nawe ubungasilethela icala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.10",
            "verseOrgIds": [
              "GEN.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 26:10"
          },
          "items": [
            {
              "text": "10",
