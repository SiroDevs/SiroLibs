            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abimeleki wayeseyala bonke abantu bakhe, wathi: “Yilowo nalowo othinta le ndoda noma umkakhe uyakubulawa nokubulawa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        }
      ]
