              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abimeleki wayesethi ku-Isaka: “Suka kithi; ngoba wena ulamandla kakhulu kulathi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.16",
            "verseOrgIds": [
              "GEN.26.16"
