          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abelusi baseGerari baphikisana nabelusi baka-Isaka, bathi: “Amanzi ngawethu; wabiza umthombo ngokuthi i-Eseke; ngoba baphikisana laye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        }
      ]
