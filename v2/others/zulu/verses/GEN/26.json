          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wabonakala kuye ngalobo busuku, wathi: “NginguNkulunkulu kayihlo u-Abrahama; ungesabi, ngokuba nginawe, ngikubusise, ngandise inzalo yakho ngenxa ka-Abrahama inceku yami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.24",
            "verseOrgIds": [
              "GEN.26.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 26:24"
          },
          "items": [
