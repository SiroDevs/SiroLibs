              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.24",
            "verseOrgIds": [
              "GEN.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakha khona i-altare, wabiza igama likaJehova, wamisa itende lakhe khona; izinceku zika-Isaka zemba umthombo khona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        }
      ]
    },
