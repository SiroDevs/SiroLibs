          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethi: “Sibonile nokubona ukuthi uJehova unawe; sathi: ‘Makube khona isifungo phakathi kwethu, phakathi kwethu nawe, senze isivumelwano nawe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
