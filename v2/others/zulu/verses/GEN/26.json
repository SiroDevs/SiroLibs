              "GEN.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba u-Abrahama walilalela izwi lami, wagcina umyalo wami, nemiyalo yami, nezimiso zami, nemithetho yami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
