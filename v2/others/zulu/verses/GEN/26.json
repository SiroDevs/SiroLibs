        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.2",
            "verseOrgIds": [
              "GEN.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "hlala njengowezizwe kuleli zwe, ngiyakuba nawe, ngikubusise; ngokuba ngiyakukunika wena nenzalo yakho onke lawa mazwe, futhi ngigcwalise isifungo engasifunga kuyihlo u-Abrahama;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakwenza inzalo yakho yande ibe ngangezinkanyezi zezulu, nginike inzalo yakho onke lawa mazwe; nangenzalo yakho ziyakubusiswa izizwe zonke zomhlaba;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.4",
            "verseOrgIds": [
              "GEN.26.4"
            ]
          }
        }
      ]
    },
    {
