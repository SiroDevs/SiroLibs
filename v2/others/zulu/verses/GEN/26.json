          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasuka lapho, wemba omunye umthombo; ngakho-ke abaxabananga; wayibiza ngokuthi iRehoboti; wathi: “Ngokuba manje uJehova usesenzele indawo, futhi siyakuzala ezweni.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        }
