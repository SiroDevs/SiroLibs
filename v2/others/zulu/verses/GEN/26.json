            "sid": "GEN 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wabonakala kuye, wathi: “Ungehleli eGibithe; hlala ezweni engizokutshela ngalo:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.2",
            "verseOrgIds": [
              "GEN.26.2"
            ]
          }
        }
      ]
    },
    {
