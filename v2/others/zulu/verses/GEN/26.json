            "sid": "GEN 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngemva kwalokho u-Abimeleki waya kuye evela eGerari, no-Ahusati umngane wakhe noPikoli induna yebutho lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        }
      ]
    },
