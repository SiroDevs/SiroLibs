          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebevuka ekuseni kakhulu, bafunga omunye komunye; u-Isaka wabamukisa, basuka kuye ngokuthula.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
