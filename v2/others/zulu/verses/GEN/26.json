          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Isaka wahlwanyela kulelo zwe, wazuza ngokuphindwe kayikhulu ngawo lowo mnyaka, uJehova wambusisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.12",
            "verseOrgIds": [
              "GEN.26.12"
            ]
          }
        }
      ]
    },
