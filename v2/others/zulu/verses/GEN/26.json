          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaba khona indlala ezweni, kuphela indlala yokuqala eyayikhona emihleni ka-Abrahama. U-Isaka waya ku-Abimeleki, inkosi yamaFilisti, eGerari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.1",
            "verseOrgIds": [
              "GEN.26.1"
            ]
          }
        }
      ]
    },
    {
