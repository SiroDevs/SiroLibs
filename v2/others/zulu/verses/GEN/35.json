          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekusithi esobelethweni olunzima, umbelethisi wathi kuye: Ungesabi; nawe uzoba nayo lendodana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.17",
            "verseOrgIds": [
              "GEN.35.17"
            ]
          }
        }
      ]
