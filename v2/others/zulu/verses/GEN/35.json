          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuka eBethele; kwasekusele ingcosana ukuthi ufike e-Efrathi, uRaheli waba lomhelo, wabeletha kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.16",
            "verseOrgIds": [
              "GEN.35.16"
            ]
          }
        }
      ]
    },
