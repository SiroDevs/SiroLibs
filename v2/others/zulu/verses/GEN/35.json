              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi umphefumulo wakhe usaphuma, ngokuba wafa, waqamba igama layo ngokuthi uBenoni; kepha uyise wayiqamba ngokuthi uBenjamini.",
          "type": "text",
          "attrs": {
