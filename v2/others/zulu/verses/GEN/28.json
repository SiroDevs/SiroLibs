          "type": "text",
          "attrs": {
            "verseId": "GEN.28.15",
            "verseOrgIds": [
              "GEN.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJakobe waphaphama ebuthongweni bakhe, wathi: “Impela uJehova ukhona kule ndawo; futhi bengingakwazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        }
      ]
    },
    {
