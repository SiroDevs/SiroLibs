          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "URubeni wabaphendula wathi: “Angikhulumanga kini ngathi: Ningoni kumntwana; kanti ubungafuni ukuzwa? ngakho-ke, bheka, igazi lakhe liyabizwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.22",
            "verseOrgIds": [
