          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa babengazi ukuthi uJosefa wayebazwisisa; ngoba wayekhuluma kubo ngomhumushi.",
          "type": "text",
