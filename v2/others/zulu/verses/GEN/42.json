          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi: “Izinceku zakho ziyizelamani eziyishumi nambili, amadodana andodanye ezweni laseKhanani; bheka, encane ikubaba namuhla, enye ayikho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.13",
            "verseOrgIds": [
              "GEN.42.13"
            ]
          }
        }
      ]
