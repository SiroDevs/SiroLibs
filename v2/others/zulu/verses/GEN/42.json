          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethi omunye komunye: “Impela sinecala ngomfowethu, ngokuba sabona usizi lomphefumulo wakhe lapho esincenga, kepha asilalelanga; ngakho-ke lolu sizi lusehlele.",
          "type": "text",
