          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wayesethi kubo ngosuku lwesithathu: “Yenzani lokhu, niphile; ngokuba ngiyamesaba uNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.18",
            "verseOrgIds": [
