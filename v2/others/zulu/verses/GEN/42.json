        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.1",
            "verseOrgIds": [
              "GEN.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Bheka, ngizwile ukuthi kukhona amabele eGibithe; yehlela lapho, usithengele khona; ukuze siphile, singafi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.2",
            "verseOrgIds": [
              "GEN.42.2"
            ]
          }
        }
      ]
    },
    {
