              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uJakobe ebona ukuthi kukhona ukolweni eGibithe, uJakobe wathi emadodaneni akhe: “Nibukana ngani na?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.1",
            "verseOrgIds": [
              "GEN.42.1"
            ]
          }
        }
      ]
    },
    {
