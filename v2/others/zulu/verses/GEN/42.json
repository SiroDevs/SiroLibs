          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilethe umfowenu omncane kimi; khona ngiyakwazi ukuthi anisizo izinhloli, kodwa ukuthi ningamadoda angempela; ngalokho ngiyakuhlenga wena, umfowenu, uhwebe ezweni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
