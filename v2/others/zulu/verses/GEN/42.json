          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thumani omunye wenu ukuba amlande umfowenu, wena uyakuba etilongweni, ukuze kuvivinywe amazwi akho ukuthi kukhona yini iqiniso kuwe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.16",
            "verseOrgIds": [
              "GEN.42.16"
            ]
          }
        }
      ]
