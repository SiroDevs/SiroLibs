          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sonke singamadodana andodanye; singamadoda angempela, izinceku zakho azizona izinhloli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.11",
            "verseOrgIds": [
              "GEN.42.11"
            ]
          }
        }
      ]
    },
