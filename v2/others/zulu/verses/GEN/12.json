        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaba khona indlala ezweni; u-Abrama wehlela eGibithe ukuba agogobale khona; ngoba indlala yayinzima elizweni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esesondele ukungena eGibithe, wathi kuSarayi umkakhe: “Bheka, ngiyazi ukuthi ungowesifazane omuhle obukekayo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
              "GEN.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
              "GEN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyakuthi lapho abaseGibithe bekubona, bathi: ‘Lo ngumkakhe; bazangibulala mina, kodwa wena bakugcine uphila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.12",
            "verseOrgIds": [
              "GEN.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
