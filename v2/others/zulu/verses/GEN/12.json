        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.12",
            "verseOrgIds": [
              "GEN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wothi, ungudadewethu, ukuze kube kuhle kimi ngenxa yakho; futhi umphefumulo wami uyakuphila ngawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        }
      ]
    },
    {
