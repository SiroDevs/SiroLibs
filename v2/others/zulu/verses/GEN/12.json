          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamncenga u-Abrama ngenxa yakhe, waba nezimvu, nezinkomo, nezimbongolo, nezinceku, nezincekukazi, nezimbongolo zakhe, namakamela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        }
      ]
    },
