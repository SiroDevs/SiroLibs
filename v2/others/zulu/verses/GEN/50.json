          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nina, nangicambela okubi; kepha uNkulunkulu wakuceba kwaba kuhle ukuba kwenziwe, njenganamuhla, ukugcina abantu abaningi bephila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.20",
            "verseOrgIds": [
              "GEN.50.20"
            ]
          }
        }
      ]
    },
