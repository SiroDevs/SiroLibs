          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wasefungisa abantwana bakoIsrayeli, wathi: UNkulunkulu uzalilalela lokulilalela, njalo lizakhupha amathambo ami lapho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.25",
