          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningesabi manje; ngiyakunondla nina nabancane benu. Wabaduduza, wakhuluma kubo ngomusa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.21",
            "verseOrgIds": [
              "GEN.50.21"
            ]
          }
        }
