          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wabona abantwana bakwa-Efrayimi besizukulwane sesithathu; nabantwana bakwaMagiri, indodana kaManase, bakhuliselwa emadolweni kaJosefa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.23",
            "verseOrgIds": [
              "GEN.50.23"
            ]
