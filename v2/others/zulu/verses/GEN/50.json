          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wathi kubo: “Ningesabi, ngokuba mina ngisesikhundleni sikaNkulunkulu na?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.19",
            "verseOrgIds": [
              "GEN.50.19"
            ]
          }
        }
