          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wayesethi kubafowabo: “Sengiyafa, uNkulunkulu uyakuninakekela nokuninakekela, anikhiphe kuleli zwe, aniyise ezweni alifungela o-Abrahama, no-Isaka, noJakobe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.24",
            "verseOrgIds": [
              "GEN.50.24"
