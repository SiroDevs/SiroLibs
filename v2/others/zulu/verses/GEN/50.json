          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJosefa wahlala eGibithe, yena nendlu kayise; uJosefa waphila iminyaka eyikhulu neshumi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.22",
            "verseOrgIds": [
              "GEN.50.22"
            ]
