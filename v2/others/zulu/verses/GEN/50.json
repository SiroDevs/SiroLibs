            "sid": "GEN 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabafowabo bahamba, bawa phansi phambi kwakhe; futhi bathi: “Bheka, siyizinceku zakho.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.18",
            "verseOrgIds": [
              "GEN.50.18"
            ]
          }
        }
      ]
    },
