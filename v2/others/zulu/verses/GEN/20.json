              "GEN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje buyisela indoda leyo umkayo; ngokuba ungumprofethi, uyakunikhulekela, niphile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.7",
            "verseOrgIds": [
              "GEN.20.7"
            ]
          }
        }
      ]
