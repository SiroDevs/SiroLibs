            "sid": "GEN 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abimeleki wayesembiza u-Abrahama, wathi kuye: “Wenzeni kithi na? futhi ngone ngani ukuba ulethe isono esikhulu phezu kwami naphezu kombuso wami na? Ungenzele izinto okungafanele zenziwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.9",
            "verseOrgIds": [
              "GEN.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
