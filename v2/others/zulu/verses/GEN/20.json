          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abimeleki wathatha izimvu, nezinkomo, nezinceku, nezincekukazi, wakunika u-Abrahama, wambuyisela uSara umkakhe kuye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.14",
            "verseOrgIds": [
              "GEN.20.14"
