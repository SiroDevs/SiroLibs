            "sid": "GEN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uNkulunkulu weza ku-Abimeleki ngephupho ebusuku, wathi kuye: “Bheka, ungofileyo ngenxa yowesifazane omthathileyo; ngoba ungumfazi womuntu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.3",
            "verseOrgIds": [
              "GEN.20.3"
            ]
          }
        }
      ]
    },
    {
