        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.5",
            "verseOrgIds": [
              "GEN.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wathi kuye ngephupho: Yebo, ngiyazi ukuthi ukwenzile lokhu ngobuqotho benhliziyo yakho; ngokuba nami nganivimbela ukuba ningoni kimi; ngalokho ngakuvumela ukuba ungamthinti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.6",
            "verseOrgIds": [
              "GEN.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
