            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi u-Abimeleki: “Bheka, izwe lami liphambi kwakho; hlala lapho uthanda khona.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.15",
            "verseOrgIds": [
              "GEN.20.15"
