        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrahama wathi ngoSara umkakhe: “Ungudadewethu; u-Abimeleki inkosi yaseGerari wathumela wamthatha uSara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.2",
            "verseOrgIds": [
              "GEN.20.2"
            ]
          }
        }
      ]
    },
    {
