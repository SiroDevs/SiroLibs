          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokho ungudadewethu ngempela; uyindodakazi kababa, kodwa akasiyo indodakazi kamame; waba ngumkami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.12",
            "verseOrgIds": [
              "GEN.20.12"
            ]
          }
        }
      ]
