          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abimeleki wavuka ekuseni kakhulu, wabiza zonke izinceku zakhe, wakhuluma zonke lezi zinto ezindlebeni zazo; abantu besaba kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.8",
            "verseOrgIds": [
              "GEN.20.8"
            ]
