            "number": "5",
            "style": "v",
            "sid": "GEN 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akashongo yini kimi ukuthi: “Ungudadewethu na?” yena wathi: “Ungumfowethu; ngobuqotho benhliziyo yami nangobumsulwa bezandla zami ngikwenzile lokhu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.5",
            "verseOrgIds": [
              "GEN.20.5"
            ]
          }
        }
      ]
    },
    {
