            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuSara: “Bheka, ngimnikile umnewenu amashekeli ayinkulungwane esiliva; bheka, uyisigubuzelo samehlo kuwe, kubo bonke abanawe nakubo bonke abanye; ngakho wakhuzwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.16",
            "verseOrgIds": [
