        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.3",
            "verseOrgIds": [
              "GEN.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abimeleki akasondelanga kuye, wathi: “Nkosi, uyathanda ukubulala nawe isizwe esilungileyo na?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.4",
            "verseOrgIds": [
              "GEN.20.4"
            ]
          }
        }
      ]
    },
    {
