              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abrahama wasuka lapho waya ezweni laseningizimu, wakha phakathi kweKadeshi neSuri, wagogobala eGerari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.1",
            "verseOrgIds": [
