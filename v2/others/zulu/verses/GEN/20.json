          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abimeleki wayesethi ku-Abrahama: “Uboneni ukuba wenze le nto na?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.10",
            "verseOrgIds": [
              "GEN.20.10"
            ]
          }
        }
      ]
