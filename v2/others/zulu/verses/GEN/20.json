          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi u-Abrahama: “Ngokuba ngithe: Impela ukumesaba uNkulunkulu akukho kule ndawo; futhi bazongibulala ngenxa yomkami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.11",
            "verseOrgIds": [
              "GEN.20.11"
            ]
          }
        }
      ]
