      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Amoni babuthana, bamisa kwaGileyadi. Abantwana bakwa-Israyeli babuthana, bamisa eMispa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.17",
            "verseOrgIds": [
              "JDG.10.17"
            ]
          }
        }
      ]
    },
