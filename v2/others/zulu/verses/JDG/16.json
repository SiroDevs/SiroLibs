          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.4",
            "verseOrgIds": [
              "JDG.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zase zifika kuye izikhulu zamaFilisti, zathi kuye: “Mlinge, ubone ukuthi amandla akhe amakhulu akuphi, nokuthi singamehlula kanjani, ukuze simbophe, simcindezele; siyakukunika, kube yilowo nalowo amashekeli esiliva ayishumi nekhulu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDelila wasesithi kuSamsoni: Ngitshele ukuthi angaphi amandla akho amakhulu lokuthi ungabotshwa ngani ukukucindezela.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.6",
            "verseOrgIds": [
              "JDG.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
