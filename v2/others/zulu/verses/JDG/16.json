        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu sebembonile badumisa unkulunkulu wabo, ngokuba bathi: “Unkulunkulu wethu unikele esandleni sethu isitha sethu nomchithi wezwe lethu, owabulala abaningi bethu.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        }
      ]
    },
    {
