            "sid": "JDG 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaFilisti amthatha, amkhipha amehlo, amyisa eGaza, ambopha ngamaketanga ethusi; waphela amandla etilongweni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.21",
            "verseOrgIds": [
