          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona amadoda ayeqamekele futhi ehlezi naye ekamelweni. Wathi kuye: “AmaFilisti aphezu kwakho, Samsoni; Wahlephula izinwele, njengokugqashuka kwentambo lapho ithinta umlilo. Ngakho amandla akhe ayengaziwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.9",
            "verseOrgIds": [
              "JDG.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
