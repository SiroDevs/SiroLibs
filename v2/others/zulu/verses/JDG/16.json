              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDelila wayesethatha izintambo ezintsha, wambopha ngazo, wathi kuye: “AmaFilisti akuhaqa, Samsoni; Futhi kwakukhona amanga ayehlala ekamelweni. Wawaklebhula ezingalweni zakhe njengocu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        }
