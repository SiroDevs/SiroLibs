          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDelila wasesithi kuSamsoni: Khangela, udlale ngami, wangiqambela amanga; ngitshele ukuthi ungaboshwa ngani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.10",
            "verseOrgIds": [
              "JDG.16.10"
            ]
