          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamsoni wabamba izinsika ezimbili eziphakathi indlu eyayimi phezu kwazo wamisa phezu kwazo, enye ngesandla sokunene nenye ngesandla sakhe sobunxele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.29",
            "verseOrgIds": [
              "JDG.16.29"
            ]
          }
        }
      ]
