        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.7",
            "verseOrgIds": [
              "JDG.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhulu zamaFilisti zamlethela imifino eyisikhombisa eyomileyo, wambopha ngayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.8",
            "verseOrgIds": [
              "JDG.16.8"
            ]
          }
        }
      ]
    },
    {
