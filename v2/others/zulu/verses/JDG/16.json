              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.1",
            "verseOrgIds": [
              "JDG.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekutshelwa amaGasi ukuthi: USamsoni ufikile lapha. Bamhaqa bamlinda ubusuku bonke esangweni lomuzi, bathula ubusuku bonke, bathi: “Kusasa, uma kusile, sizombulala.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.2",
            "verseOrgIds": [
              "JDG.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.2",
            "verseOrgIds": [
              "JDG.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamsoni walala kwaze kwaba phakathi kwamabili, wavuka phakathi kobusuku, wathatha iminyango yesango lomuzi nezinsika zombili, wahamba nazo, imigoqo nakho konke, wakuthwala emahlombe akhe, wakuyisa emzini. Esiqongweni sentaba ephambi kweHebroni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho wathanda owesifazane esigodini saseSoreki, ogama lakhe lalinguDelila.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.4",
            "verseOrgIds": [
              "JDG.16.4"
            ]
          }
        }
      ]
    },
    {
