            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamsoni waya eGaza, wabona lapho isifebe, wangena naso;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.1",
            "verseOrgIds": [
              "JDG.16.1"
            ]
          }
        }
