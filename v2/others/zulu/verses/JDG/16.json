          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamsoni wasesithi: Ake ngife lamaFilisti. Wakhothama ngamandla akhe onke; indlu yawela phezu kwezikhulu naphezu kwabo bonke abantu ababe kuyo. Ngakho abafileyo ababulala ekufeni kwakhe babe baningi kunalabo ababulala esaphila.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        }
      ]
