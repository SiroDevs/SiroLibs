            "sid": "JDG 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho izinhliziyo zabo sezithokozile, bathi: “Bizani uSamsoni ukuba asidlalele.” Basebembiza uSamsoni etilongweni; basebemmisa phakathi kwezinsika.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        }
      ]
