          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamsoni wayesebiza uJehova, wathi: “Nkosi Jehova, ngikhumbule, ungiqinise kube kanye nje, Nkulunkulu, ukuze ngiphindisele kumaFilisti impindiselo yamehlo ami womabili.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.28",
            "verseOrgIds": [
              "JDG.16.28"
            ]
          }
        }
      ]
    },
    {
