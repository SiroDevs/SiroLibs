          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasibophela ngesikhonkwane, wathi kuye: “AmaFilisti aphezu kwakho, Samsoni; Wavuka ebuthongweni bakhe, wahamba nesikhonkwane sogodo nolwembu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
