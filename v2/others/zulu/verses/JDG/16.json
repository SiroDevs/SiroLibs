            "number": "15",
            "style": "v",
            "sid": "JDG 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: “Ungasho kanjani ukuthi: ‘Ngiyakuthanda, uma inhliziyo yakho ingekimi na?’ Udlale ngami kathathu, awungitshelanga ukuthi akuphi amandla akho amakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.15",
            "verseOrgIds": [
              "JDG.16.15"
            ]
          }
        }
      ]
