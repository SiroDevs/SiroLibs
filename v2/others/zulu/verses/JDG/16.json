          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: “Uma bengibopha ngamagoda amasha, angakaze abanjwe, ngiyakuba buthakathaka, ngibe njengomunye umuntu.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.11",
            "verseOrgIds": [
              "JDG.16.11"
            ]
