            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu yayigcwele abesilisa nabesifazane; zonke izikhulu zamaFilisti zazilapho; ophahleni kwakukhona amadoda nabesifazane kungathi izinkulungwane ezintathu, bebukela uSamsoni edlala.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        }
      ]
