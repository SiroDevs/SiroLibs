          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamsoni wathi kumfana owayembambe ngesandla: “Ngivumele ngizwe izinsika indlu emi phezu kwazo, ukuze ngencike kuzo.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.26",
            "verseOrgIds": [
              "JDG.16.26"
            ]
          }
        }
