          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekusithi insuku zonke wamcindezela ngamazwi akhe, wamncenga, waze wakhathazeka umphefumulo wakhe kwaze kwaba sekufeni;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.16",
            "verseOrgIds": [
              "JDG.16.16"
            ]
          }
        }
