          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphini waso wangena emva kwenkemba; amanoni avala inkemba, ukuze angawukhiphi inkemba esiswini sakhe; kwaphuma ukungcola.",
          "type": "text",
          "attrs": {
