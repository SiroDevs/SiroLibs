          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho uMowabi wathotshiswa ngalolo suku phansi kwesandla sika-Israyeli. Izwe laba nokuthula iminyaka engamashumi ayisishiyagalombili.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
        }
