          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babulala ngaleso sikhathi amadoda akwaMowabi kungathi izinkulungwane eziyishumi, onke amaqhawe namaqhawe; akwaphunyuka muntu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        }
      ]
