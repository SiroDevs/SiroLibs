          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ehudi welula isandla sakhe sobunxele, wathatha inkemba ethangeni lakhe lokunene, wayigwaza esiswini sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
