          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: “Ngilandeleni, ngokuba uJehova unikele izitha zenu, abakwaMowabi, esandleni senu.” Behla bamlandela, bathumba amazibuko aseJordani kwaMowabi, abavumelanga muntu ukuba awele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.28",
            "verseOrgIds": [
              "JDG.3.28"
            ]
          }
        }
      ]
    },
