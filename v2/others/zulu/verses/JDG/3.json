          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esefikile wabetha icilongo ezintabeni zakwa-Efrayimi, abantwana bakwa-Israyeli behla naye entabeni, yena waphuma phambi kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.27",
