              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ehudi wayesephumela egcekeni, wamvalela iminyango yekamelo lokuhlala, wayihluthulela;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
