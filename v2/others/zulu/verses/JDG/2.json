          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli benza okubi emehlweni kaJehova, bakhonza oBali.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
            "verseOrgIds": [
              "JDG.2.11"
            ]
          }
        }
      ]
    },
    {
