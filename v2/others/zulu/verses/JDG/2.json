            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bammbela emkhawulweni wefa lakhe eThimnatha ezintabeni zakwa-Efrayimi ngasenyakatho kwentaba iGahashi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        }
      ]
    },
    {
