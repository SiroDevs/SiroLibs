          "type": "text",
          "attrs": {
            "verseId": "JDG.2.15",
            "verseOrgIds": [
              "JDG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJehova wavusa abahluleli ababasindisa esandleni salabo ababebaphanga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.16",
            "verseOrgIds": [
              "JDG.2.16"
            ]
          }
        }
      ]
    },
