          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.14",
            "verseOrgIds": [
              "JDG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomaphi lapho bephumela khona, isandla sikaJehova sasimelene nabo ngokubi, njengokukhuluma kukaJehova nanjengoba uJehova wayebathembisile ngesifungo; bakhathazeka kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.15",
            "verseOrgIds": [
              "JDG.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
