            "sid": "JDG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokho kabalalelanga abahluleli bawo, kodwa baphinga ngokulandela abanye onkulunkulu, babakhothamela. Kodwa kabakwenzanga lokho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.17",
            "verseOrgIds": [
              "JDG.2.17"
            ]
          }
        }
      ]
