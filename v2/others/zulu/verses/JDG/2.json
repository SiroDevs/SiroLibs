          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamshiya uJehova, bakhonza oBali no-Ashitaroti.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.13",
            "verseOrgIds": [
              "JDG.2.13"
            ]
          }
        }
      ]
    },
    {
