        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sonke leso sizukulwane sabuthelwa koyise, kwavela esinye isizukulwane emva kwaso uJehova ayengasazi nemisebenzi ayeyenzele u-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
