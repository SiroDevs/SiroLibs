            "sid": "JDG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intukuthelo kaJehova yamvuthela u-Israyeli, wabanikela esandleni sabaphangi ababaphanga, wathengisa ngabo esandleni sezitha zabo nxazonke, ukuze bangabe besakwazi ukuma phambi kwezitha zabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.14",
            "verseOrgIds": [
              "JDG.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
