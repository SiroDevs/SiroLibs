        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
              "JDG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
