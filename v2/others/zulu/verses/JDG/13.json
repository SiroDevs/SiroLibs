              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ingelosi kaJehova ayisabonakalanga kuManowa nomkakhe. UManowa wazi ukuthi uyingelosi kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.21",
