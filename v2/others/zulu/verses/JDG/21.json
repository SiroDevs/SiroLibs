  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JDG 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bakwa-Israyeli bafunga eMispa, bathi: “Makungabikho kithina oyakunikela ngendodakazi yakhe kuBenjamini, ibe ngumkakho.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.1",
            "verseOrgIds": [
              "JDG.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.1",
            "verseOrgIds": [
              "JDG.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu base befika endlini kaNkulunkulu, bahlala khona kwaze kwahlwa phambi kukaNkulunkulu; baphakamisa izwi labo, bakhala kakhulu;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.2",
            "verseOrgIds": [
              "JDG.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.2",
            "verseOrgIds": [
              "JDG.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Jehova Nkulunkulu ka-Israyeli, kwenzekeni kwa-Israyeli ukuthi namuhla kungabikho isizwe esisodwa kwa-Israyeli na?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.3",
            "verseOrgIds": [
              "JDG.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.3",
            "verseOrgIds": [
              "JDG.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngangomuso abantu bavuka ekuseni, bakha khona i-altare, banikela ngeminikelo yokushiswa neminikelo yokubonga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.4",
            "verseOrgIds": [
              "JDG.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.4",
            "verseOrgIds": [
              "JDG.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethi abantwana bakwa-Israyeli: “Ngubani phakathi kwazo zonke izizwe zakwa-Israyeli ongakhuphukelanga eNkosini kanye nenhlangano na?” Ngokuba benza isifungo esikhulu ngaye ongakhuphukelanga kuJehova eMispa, wathi: “Umelwe ukubulawa nokubulawa.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.5",
            "verseOrgIds": [
              "JDG.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.5",
            "verseOrgIds": [
              "JDG.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli baphenduka ngomfowabo uBenjamini, bathi: “Namuhla esinye isizwe sakwa-Israyeli sinqunyiwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.6",
            "verseOrgIds": [
              "JDG.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.6",
            "verseOrgIds": [
              "JDG.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyakwenza kanjani ngabafazi kwabaseleyo, thina safunga uJehova ukuthi asiyikuwanika amadodakazi ethu abe ngomkakho?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.7",
            "verseOrgIds": [
              "JDG.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.7",
            "verseOrgIds": [
              "JDG.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebesithi: Ngubani ezizweni zakoIsrayeli ongakhuphukelanga eNkosini eMispa? bheka, kwakungekho muntu ekamu laseJabeshi kwaGileyadi emva kokuhlangana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.8",
            "verseOrgIds": [
              "JDG.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.8",
            "verseOrgIds": [
              "JDG.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu babalwa, bheka, kwakungekho noyedwa kwabakhileyo eJabeshi kwaGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.9",
            "verseOrgIds": [
              "JDG.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.9",
            "verseOrgIds": [
              "JDG.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inhlangano yathuma khona amadoda ayizinkulungwane eziyishumi nambili kumaqhawe amakhulu, yabayala, yathi: “Hambani nibulale abakhileyo eJabeshi kwaGileyadi ngosiko lwenkemba kanye nabesifazane nabantwana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.10",
            "verseOrgIds": [
              "JDG.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.10",
            "verseOrgIds": [
              "JDG.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nansi into eniyakuyenza: niqalekise bonke abesilisa nabo bonke abesifazane abake balala nendoda;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.11",
            "verseOrgIds": [
              "JDG.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.11",
            "verseOrgIds": [
              "JDG.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafumana kwabakhileyo eJabeshi kwaGileyadi izintombi ezingamakhulu amane, okwakungaziwa muntu ngokulala nendoda; babayisa ekamu eShilo esezweni laseKhanani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.12",
            "verseOrgIds": [
              "JDG.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.12",
            "verseOrgIds": [
              "JDG.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibandla lonke lathuma ukukhuluma nabantwana bakwaBenjamini ababesedwaleni laseRimoni, ukuba bababizele ukuthula.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.13",
            "verseOrgIds": [
              "JDG.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.13",
            "verseOrgIds": [
              "JDG.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBenjamini wabuya ngaleso sikhathi; babanika abafazi ababebakhulise kubafazi baseJabeshi kwaGileyadi, kepha ababanelanga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.14",
            "verseOrgIds": [
              "JDG.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.14",
            "verseOrgIds": [
              "JDG.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu basebezisola ngoBenjamini, ngoba uJehova wayeqhamuke ezizweni zakoIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.15",
            "verseOrgIds": [
              "JDG.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.15",
            "verseOrgIds": [
              "JDG.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadala benhlangano bathi: “Siyakwenze njani ngabesifazane kwabaseleyo, kuyilapho abesifazane bakwaBenjamini bebhujiswa?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.16",
            "verseOrgIds": [
              "JDG.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.16",
            "verseOrgIds": [
              "JDG.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathi: “Kumelwe kube nefa lababaleki bakwaBenjamini, ukuze kungachithwa isizwe kwa-Israyeli.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.17",
            "verseOrgIds": [
              "JDG.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
