          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nesancinza sakhe esasiseShekemi naso samzalela indodana, igama layo laqamba igama layo ngokuthi u-Abimeleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.31",
