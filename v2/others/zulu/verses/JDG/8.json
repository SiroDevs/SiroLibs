          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanjalo amaMidiyani athotshiswa phambi kwabantwana bakwa-Israyeli, kangangokuthi abazange baphinde baphakamise amakhanda abo. Izwe lathula iminyaka engamashumi amane emihleni kaGideyoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.28",
            "verseOrgIds": [
              "JDG.8.28"
            ]
          }
        }
      ]
    },
