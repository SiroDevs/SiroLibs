          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UGideyoni wayenamadodana angamashumi ayisithupha esinqeni sakhe, ngokuba wayenabafazi abaningi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.30",
            "verseOrgIds": [
