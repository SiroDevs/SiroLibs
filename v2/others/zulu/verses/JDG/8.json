          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho uGideyoni efa, abantwana bakwa-Israyeli baphenduka baphinga ngokulandela oBhali, benza uBhali-bheriti unkulunkulu wabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.33",
            "verseOrgIds": [
              "JDG.8.33"
            ]
