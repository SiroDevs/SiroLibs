          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UGideyoni indodana kaJowashi wafa esemdala, wembelwa ethuneni likaJowashi uyise e-Ofira lama-Abiyezeri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.8.32",
