              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli abamkhumbulanga uJehova uNkulunkulu wabo owabakhulula esandleni sezitha zabo zonke nxazonke.",
          "type": "text",
          "attrs": {
