          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.15",
            "verseOrgIds": [
              "JDG.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasehlukanisa abantu abangamakhulu amathathu aba izingxenye ezintathu, wabeka icilongo esandleni ngasinye, nezimbiza ezingenalutho nezibani phakathi kwezimbiza.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.16",
            "verseOrgIds": [
              "JDG.7.16"
            ]
          }
        }
      ]
