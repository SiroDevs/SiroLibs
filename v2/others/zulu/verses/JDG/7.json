          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalungu amathathu abetha amacilongo, aphihliza izitsha, aphatha izibani ngesandla sobunxele namacilongo ngezandla zokunene ukuba awashaye; bamemeza bathi: “Inkemba kaJehova nekaGideyoni!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.20",
            "verseOrgIds": [
              "JDG.7.20"
            ]
