          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abangamakhulu amathathu bavuthela izimpondo, uJehova wabeka inkemba yalowo nalowo kumngane wakhe nakuyo yonke impi;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        }
