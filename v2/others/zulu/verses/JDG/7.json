          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadoda akwa-Israyeli abuthana kwaNafetali, nakwa-Asheri, nakuManase wonke, abaxosha abakwaMidiyani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.23",
