          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bema, kwaba yilowo nalowo endaweni yakhe nxazonke zekamu; yonke impi yagijima, yamemeza, yabaleka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.21",
            "verseOrgIds": [
              "JDG.7.21"
