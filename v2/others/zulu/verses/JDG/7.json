            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.12",
            "verseOrgIds": [
              "JDG.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uGideyoni efika, bheka, kwakukhona umuntu owaxoxela umngane wakhe iphupho, wathi: “Bheka, ngiphuphe iphupho, bheka, iqebelengwane lesinkwa sebhali liwela phakathi kwebutho lakwaMidiyani nasetendeni, layishaya. Yawa, yawugumbuqela, kwaze kwalala itende ngohlangothi lwayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.13",
            "verseOrgIds": [
              "JDG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.13",
            "verseOrgIds": [
              "JDG.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umngane wakhe waphendula wathi: “Akusilutho ngaphandle kwenkemba kaGideyoni, indodana kaJowashi, indoda yakwa-Israyeli, ngokuba uNkulunkulu wanikela esandleni sakhe abakwaMidiyani nayo yonke impi.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.14",
            "verseOrgIds": [
              "JDG.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.14",
            "verseOrgIds": [
              "JDG.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uGideyoni esizwa indaba yephupho nokuchazwa kwalo, wakhuleka, wabuyela ebuthweni lakwa-Israyeli, wathi: “Sukumani! ngokuba uJehova unikele impi yakwaMidiyani esandleni sakho.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.15",
            "verseOrgIds": [
              "JDG.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
