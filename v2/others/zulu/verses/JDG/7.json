          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UGideyoni wathuma izithunywa ezintabeni zakwa-Efrayimi, wathi: “Yehlani niye kwabakwaMidiyani, niwathumbe amanzi phambi kwabo kuze kube seBeti Bara naseJordani; Khona-ke bonke abantu bakwa-Efrayimi babuthana ndawonye, bathatha amanzi kwaze kwaba seBeti Bara naseJordani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.24",
            "verseOrgIds": [
              "JDG.7.24"
            ]
