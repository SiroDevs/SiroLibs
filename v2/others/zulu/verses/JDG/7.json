          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UGideyoni namadoda ayikhulu ayenaye bafika emaphethelweni ekamu ekuqaleni kwabalindi abaphakathi; sebemise umlindi, bavuthela izimpondo zenqama, baphahlaza izimbiza ezazisezandleni zabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.19",
            "verseOrgIds": [
