          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Efrayimi akawaxoshanga amaKhanani ayakhe eGezeri; kepha amaKhanani ahlala phakathi kwabo eGezeri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
              "JDG.1.29"
            ]
          }
        }
      ]
    },
