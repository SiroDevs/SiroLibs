      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.25",
            "verseOrgIds": [
              "JDG.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo muntu waya ezweni lamaHeti, wakha umuzi, wawubiza ngokuthi iLusi, okuyigama lawo kuze kube namuhla.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
