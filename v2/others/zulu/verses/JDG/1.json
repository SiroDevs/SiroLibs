          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu kaJosefa nayo yakhuphukela eBethele, futhi uJehova wayenabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
