          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamnika uKalebi iHebroni, njengokusho kukaMose; wawaxosha khona amadodana amathathu ka-Anaki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.20",
            "verseOrgIds": [
              "JDG.1.20"
            ]
          }
        }
