            "sid": "JDG 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UZebuloni akabaxoshanga abahlali baseKitroni nabakhe eNahaloli; kepha amaKhanani ahlala phakathi kwabo, aba yizinceku zakhe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        }
      ]
    },
    {
