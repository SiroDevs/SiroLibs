          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu kaJosefa yathumela ukuhlola iBethele. (Manje igama lomuzi laliyiLuze.)",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.23",
            "verseOrgIds": [
