          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wayenaye uJuda; wabaxosha abakhe entabeni; kodwa babengenakuxosha abakhe esigodini, ngokuba babenezinqola zensimbi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.19",
            "verseOrgIds": [
              "JDG.1.19"
            ]
          }
        }
