            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJuda wathumba iGaza nogu lwalo, ne-Ashikeloni nogu lwalo, ne-Ekroni nogu lwalo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.18",
