          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi lapho u-Israyeli esenamandla, wakhokhisa amaKhanani, awazange awaxoshe ngokuphelele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
