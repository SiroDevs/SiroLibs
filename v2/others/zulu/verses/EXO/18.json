              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuqinisekile uzokhathala, wena nalaba bantu abakanye nawe, ngoba le nto inzima kakhulu kuwe; awukwazi ukukwenza ngokwakho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
