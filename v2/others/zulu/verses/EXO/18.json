          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMozisi wasesithi kuyisezala: Ngoba abantu beza kimi ukubuza kuNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.15",
            "verseOrgIds": [
              "EXO.18.15"
            ]
          }
        }
      ]
    },
