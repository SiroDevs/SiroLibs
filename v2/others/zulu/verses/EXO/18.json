          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uJetro, umpristi wakwaMidiyani, umukhwe kaMose, esezwile ngakho konke uNkulunkulu abekwenzile kuMose nakubantu bakhe u-Israyeli, nokuthi uJehova wayemkhiphile u-Israyeli eGibithe;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
