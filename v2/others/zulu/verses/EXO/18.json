          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJetiro, umukhwe kaMose, wamthatha uZipora umkaMose, esemmukisile;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        }
      ]
    },
    {
