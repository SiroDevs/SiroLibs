        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJetiro, umukhwe kaMose, wamthathela uNkulunkulu umnikelo wokushiswa nemihlatshelo; weza u-Aroni nawo onke amalunga akwa-Israyeli ukuba badle isinkwa nomukhwe kaMose phambi kukaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
