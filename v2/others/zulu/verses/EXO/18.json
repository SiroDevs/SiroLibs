          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa benecala, bayeza kimi; ngiyakwahlulela phakathi kwabo, ngibazise izimiso zikaNkulunkulu nemithetho yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.16",
