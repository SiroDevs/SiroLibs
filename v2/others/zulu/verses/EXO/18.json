          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngangomuso uMose wahlala ukwahlulela abantu, abantu bema ngakuMose kusukela ekuseni kwaze kwahlwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.13",
            "verseOrgIds": [
              "EXO.18.13"
            ]
          }
        }
