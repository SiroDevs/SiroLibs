        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.16",
            "verseOrgIds": [
              "EXO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usaziphakamisa yini phezu kwabantu bami, ukuze ungabayekeli bahambe?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.17",
            "verseOrgIds": [
              "EXO.9.17"
            ]
          }
        }
      ]
