          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulekani eNkosini (ngoba sekwanele) ukuthi kungabe kusaba khona ukuduma okukhulu lesichotho; ngiyakunivumela ukuba nihambe, ningabe nisahlala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
