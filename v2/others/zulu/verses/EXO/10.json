          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uJehova wayenza lukhuni inhliziyo kaFaro, kabavumelanga abantwana bakwa-Israyeli ukuba bahambe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
