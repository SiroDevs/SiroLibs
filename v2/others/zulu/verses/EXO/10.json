            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJehova wayenza lukhuni inhliziyo kaFaro, kabavumelanga ukuba bahambe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
