          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wambiza uMose, wathi: “Hambani nikhonze uJehova; kuphela izimvu zenu nezinkomo zenu mazime; yeka nabantwana bakho bahambe nawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        }
