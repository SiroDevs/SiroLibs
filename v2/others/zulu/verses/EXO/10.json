          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UFaro wasesithi kuye: Suka kimi, uzinakekele, ungabe usabona ubuso bami; ngoba ngalolosuku uba libona ubuso bami lizakufa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        }
      ]
