        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi uMose: “Futhi kumelwe usinike iminikelo yokushiswa neminikelo yokushiswa, ukuze sinikele ngayo kuJehova uNkulunkulu wethu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        }
      ]
    },
