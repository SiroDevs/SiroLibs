            "number": "26",
            "style": "v",
            "sid": "EXO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfuyo yethu izohamba nathi; akukho luzipho olungashiywa ngemuva; ngenxa yalokho kumelwe sithathe ukukhonza uJehova uNkulunkulu wethu; futhi asazi ukuthi yini okufanele siyikhonze iNkosi size sifike lapho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        }
      ]
    },
