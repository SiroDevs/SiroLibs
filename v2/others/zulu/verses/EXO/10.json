          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayeselula isandla sakhe ezulwini; kwaba khona ubumnyama obukhulu ezweni lonke laseGibithe izinsuku ezintathu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
            "verseOrgIds": [
