          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yazisa uyihlo nonyoko, ukuze izinsuku zakho zande ezweni uJehova uNkulunkulu wakho akunika lona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
