        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngezinsuku eziyisithupha uJehova wenza izulu nomhlaba, nolwandle, nakho konke okukukho, waphumula ngosuku lwesikhombisa; ngalokho uJehova walubusisa usuku lwesabatha, walungcwelisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
