        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa usuku lwesikhombisa luyisabatha leNkosi uNkulunkulu wakho; awuyikusebenza msebenzi ngalo, wena nendodana yakho noma indodakazi yakho, nenceku yakho, nencekukazi yakho, nezinkomo zakho, nomfokazi wakho okuwe. Amasango:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
