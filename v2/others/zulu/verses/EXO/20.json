            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu babona ukuduma, nemibani, nomsindo wecilongo, nentaba ethunqayo; abantu sebekubona bahlehla bamela khatshana.",
          "type": "text",
