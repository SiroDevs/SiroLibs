            "number": "3",
            "style": "v",
            "sid": "EXO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.3",
            "verseOrgIds": [
              "EXO.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungazenzeli izithombe ezibaziweyo, noma umfanekiso wokusezulwini phezulu, nokusemhlabeni phansi, nowokusemanzini phansi komhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 20:4"
          },
          "items": [
            {
