              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wakhuluma onke lawa mazwi, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.1",
            "verseOrgIds": [
              "EXO.20.1"
            ]
          }
        }
