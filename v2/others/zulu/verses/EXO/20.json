          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungafisi indlu yomakhelwane wakho, ungafisi umfazi womakhelwane wakho, nenceku yakhe, nencekukazi yakhe, nenkabi yakhe, nembongolo yakhe, nokunye okomakhelwane wakho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.17",
            "verseOrgIds": [
              "EXO.20.17"
            ]
          }
        }
      ]
