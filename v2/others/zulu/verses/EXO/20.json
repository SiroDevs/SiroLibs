          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngihawukele izinkulungwane zalabo abangithandayo futhi bagcine imiyalo yami.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
    },
    {
