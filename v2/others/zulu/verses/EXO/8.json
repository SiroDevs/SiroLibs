          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi kuMozisi: Tshono kuAroni uthi: Yelula intonga yakho, utshaye uthuli lwelizwe, lube omiyane elizweni lonke leGibhithe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.16",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        }
      ]
    },
    {
