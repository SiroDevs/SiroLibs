          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazibuthela izinqwaba, izwe lanuka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uFaro esebonile ukuthi sekuphuzile, wayenza lukhuni inhliziyo yakhe, kabalalelanga; njengokutsho kweNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        }
      ]
    },
    {
