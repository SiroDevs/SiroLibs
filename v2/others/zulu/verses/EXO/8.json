      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.16",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benza njalo; ngokuba u-Aroni welula isandla sakhe esinenduku yakhe, washaya uthuli lomhlabathi, lwaba omiyane kubantu nasezinkomeni; lonke uthuli lwezwe lwaba omiyane ezweni lonke laseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.17",
            "verseOrgIds": [
              "EXO.8.17"
            ]
          }
        }
      ]
    },
    {
