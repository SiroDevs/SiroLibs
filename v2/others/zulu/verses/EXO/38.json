          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza izimpondo zalo emagumbini alo omane; izimpondo zakhe zaziphuma kulo, wazinameka ngethusi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.2",
            "verseOrgIds": [
              "EXO.38.2"
