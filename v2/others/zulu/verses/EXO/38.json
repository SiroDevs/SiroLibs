              "type": "text"
            }
          ]
        },
        {
          "text": "Wabumbela amasongo amane emaphethelweni omane ehele lethusi, abe yizindawo zezinti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.5",
