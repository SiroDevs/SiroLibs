          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walenzela i-altare ihele lethusi elinenetha phansi kokuzungeza kwalo kuze kube phakathi nalo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.4",
