          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazenza zonke izinto ze-altare, amakhanzi, namafosholo, nezitsha, namakhona enyama, nemicengezi yomlilo; zonke izitsha zalo wazenza ngethusi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.3",
            "verseOrgIds": [
              "EXO.38.3"
            ]
          }
        }
