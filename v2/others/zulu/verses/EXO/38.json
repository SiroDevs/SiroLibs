          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsika zawo zazingamashumi amabili, nezinyawo zazo zazingamashumi amabili zethusi; izisekelo zezinsika namasongo azo ayeyisiliva.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.10",
