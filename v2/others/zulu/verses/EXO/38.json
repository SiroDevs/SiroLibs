              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walenza i-altare lomnikelo wokushiswa ngomuthi womtholo; ubude balo babuyizingalo eziyisihlanu, nobubanzi balo babuyizingalo eziyisihlanu; laliyisikwele; ukuphakama kwawo kube yizingalo ezintathu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.1",
            "verseOrgIds": [
              "EXO.38.1"
            ]
          }
        }
      ]
    },
    {
