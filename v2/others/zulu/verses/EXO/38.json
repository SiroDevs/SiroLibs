          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazifaka izinti emasongweni ezinhlangothini ze-altare ukuba lithwalwe; i-altare walenza ngamapulangwe laba umgodi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.7",
