              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ububanzi begceke ohlangothini olusempumalanga ngasempumalanga bube yizingalo ezingamashumi ayisihlanu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
