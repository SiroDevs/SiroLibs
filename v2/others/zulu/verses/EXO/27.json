            "sid": "EXO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakwenza igceke letabernakele ohlangothini oluseningizimu, ngaseningizimu, kube khona izilenge zegceke ngelineni elicolekileyo lemicu ephothiweyo, ubude bazo bube yizingalo eziyikhulu ngalapha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        }
      ]
    },
    {
