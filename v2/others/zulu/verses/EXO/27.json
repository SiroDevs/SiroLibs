          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebubanzini begceke ohlangothini olusentshonalanga makube khona izilenge eziyizingalo ezingamashumi amahlanu, izinsika zazo zibe yishumi nezinyawo zazo zibe yishumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
