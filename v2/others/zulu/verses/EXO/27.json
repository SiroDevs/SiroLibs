        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsika zalo ezingamashumi amabili nezinyawo zazo zibe ngamashumi amabili zethusi; izisekelo zezinsika namasongo azo abe yisiliva.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        }
