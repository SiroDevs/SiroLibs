          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakolunye uhlangothi makube khona izilenge eziyizingalo eziyishumi nanhlanu, izinsika zazo zibe zintathu, nezinyawo zazo zibe zintathu.",
          "type": "text",
          "attrs": {
