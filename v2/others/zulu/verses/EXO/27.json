              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izilenge ohlangothini olulodwa lwesango kumelwe zibe yizingalo eziyishumi nanhlanu, izinsika zazo zibe ntathu nezinyawo zazo zibe zintathu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
