          "type": "text",
          "attrs": {
            "verseId": "EXO.27.6",
            "verseOrgIds": [
              "EXO.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinti kumelwe zifakwe emasongweni, futhi izinti zibe sezinhlangothini zombili ze-altare ukuze lithwalwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.7",
            "verseOrgIds": [
              "EXO.27.7"
            ]
          }
        }
      ]
    },
    {
