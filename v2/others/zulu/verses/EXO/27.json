          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izinsika zegceke nxazonke kumelwe zigcwaliswe ngesiliva; izikhonkwane zazo zibe ngezesiliva, nezinyawo zazo zibe ngezethusi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
