          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.7",
            "verseOrgIds": [
              "EXO.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ulenze libe yigobolondo elinezitayela; njengalokho waboniswa wena entabeni, bayakukwenza kanjalo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.8",
            "verseOrgIds": [
              "EXO.27.8"
            ]
          }
        }
