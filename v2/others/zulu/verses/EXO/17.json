          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Ngokuba uJehova ufungile ukuthi uJehova uyakulwa no-Amaleki izizukulwane ngezizukulwane.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
