        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.13",
            "verseOrgIds": [
              "EXO.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi yasisithi kuMozisi: Kubhale egwalweni kube yisikhumbuzo, ukuphindaphinde endlebeni zikaJoshuwa, ngoba ngizacima ngokupheleleyo isikhumbuzo sikaAmaleki ngaphansi kwezulu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
