          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wohlanganisa izindwangu zetende eziyisihlanu zodwa, nezindwangu zetende eziyisithupha zihlukane, wenze indwangu yetende yesithupha ibe mibili ngaphambi kwetabernakele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.9",
            "verseOrgIds": [
              "EXO.26.9"
            ]
          }
