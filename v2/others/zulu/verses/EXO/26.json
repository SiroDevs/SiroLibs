              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubude besitayela bube yizingalo eziyishumi, ububanzi bube yingalo nenxenye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
