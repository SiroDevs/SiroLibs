          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingalo ngalapha nengalo ngalapha kokuseleyo kwezindwangu zetende, ilenga emaceleni etabernakele ngapha nangapha, ukuze lilisibekele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        }
