          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.4",
            "verseOrgIds": [
              "EXO.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenze izihibe ezingamashumi ayisihlanu engutsheni yetende eyodwa, wenze izihibe ezingamashumi ayisihlanu emphethweni wendwangu yetende esengeleni lesibili letende; ukuthi izihibe zingabambana zodwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.5",
            "verseOrgIds": [
              "EXO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
