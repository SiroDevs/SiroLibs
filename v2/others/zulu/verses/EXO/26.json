              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenze izingwegwe ezingamashumi ayisihlanu zethusi, uzifake izingwegwe ezihibeni, uhlanganise itende libe linye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.11",
            "verseOrgIds": [
              "EXO.26.11"
            ]
