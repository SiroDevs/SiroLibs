              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe wenzele itabernakele izisekelo ngokhuni lomtholo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.15",
            "verseOrgIds": [
