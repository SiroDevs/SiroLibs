              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhonkwane ezimbili mazibekwe endleleni eyodwa, zihlelwe esinye nesinye; uyakwenze njalo kuzo zonke izitayela zetabernakele.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.17",
            "verseOrgIds": [
              "EXO.26.17"
            ]
