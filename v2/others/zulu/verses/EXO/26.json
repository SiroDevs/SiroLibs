          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubude bendwangu yetende eyodwa kumelwe bube yizingalo ezingamashumi amathathu, ububanzi bendwangu yetende eyodwa bube yizingalo ezine; nezindwangu zetende eziyishumi nanye kumelwe zonke zibe yisilinganiso sinye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        }
      ]
    },
    {
