        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenze izihibe ezingamashumi ayisihlanu emphethweni welinye itende elingaphandle kokuhlangana, nezihibe ezingamashumi ayisihlanu emphethweni wendwangu yetende ehlangene nelesibili letende.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.10",
            "verseOrgIds": [
              "EXO.26.10"
            ]
          }
        }
      ]
    },
    {
