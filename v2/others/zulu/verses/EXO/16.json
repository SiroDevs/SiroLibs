      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.26",
            "verseOrgIds": [
              "EXO.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi kwenzeka ukuthi abanye abantu baphuma ngosuku lwesikhombisa ukuyobutha, futhi abatholanga lutho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.27",
            "verseOrgIds": [
              "EXO.16.27"
            ]
          }
        }
      ]
    },
    {
