            "number": "20",
            "style": "v",
            "sid": "EXO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha abamlalelanga uMose; kepha enye yasala kukho kwaze kwasa, yazala izimpethu, yanuka; uMose wabathukuthelela.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        }
      ]
    },
    {
