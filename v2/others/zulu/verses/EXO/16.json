          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlu ka-Israyeli yaqamba igama lakho ngokuthi imana, futhi yayimhlophe njengembewu yekoriyanderi; ukunambitheka kwayo kwakunjengezinyosi ezenziwe ngoju.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
