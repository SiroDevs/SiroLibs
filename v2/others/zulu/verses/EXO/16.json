          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengalokho uJehova emyalile uMose, u-Aroni wawubeka phambi kobufakazi ukuba ulondolozwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        }
