          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho sebelinganisa ngegomere, owayebuthe okuningi akasalanga lutho, nowayebuthe okuyingcosana akaswelanga; babutha, kwaba yilowo nalowo njengokudla kwakhe.",
          "type": "text",
          "attrs": {
