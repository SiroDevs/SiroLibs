            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakubutha ekuseni njalo, kwaba yilowo nalowo njengokudla kwakhe; kwathi ilanga selifudumala, yancibilika.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        }
      ]
    },
    {
