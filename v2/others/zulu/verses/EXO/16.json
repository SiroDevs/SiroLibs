          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayesethi: “Nansi indaba uJehova ayale ngayo: Gcwalisani igomere kulo, ligcinelwe izizukulwane zenu; ukuze babone isinkwa enganidlisa ngaso ehlane lapho nginikhipha ezweni laseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
