            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.28",
            "verseOrgIds": [
              "EXO.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani, ngokuba uJehova uninike isabatha, ngalokho uyaninika ngosuku lwesithupha isinkwa sezinsuku ezimbili; hlalani, kube yilowo nalowo endaweni yakhe, makungaphumi muntu endaweni yakhe ngosuku lwesikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.29",
            "verseOrgIds": [
              "EXO.16.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
