          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathi ku-Aroni: “Thatha imbiza, ubeke kuyo imana, uyibeke phambi kukaJehova, igcinelwe izizukulwane zenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
