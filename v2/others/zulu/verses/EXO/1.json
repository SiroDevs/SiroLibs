          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonke imiphefumulo eyaphuma okhalweni lukaJakobe yayiyimiphefumulo engamashumi ayisikhombisa, ngoba uJosefa wayeseGibhithe kakade.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
