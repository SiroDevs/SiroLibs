          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke abantu bahlakazeka ezweni lonke laseGibhithe ukuze babuthe izinhlanga esikhundleni sotshani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.12",
            "verseOrgIds": [
              "EXO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
