            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinceku zabantwana bakwa-Israyeli ezazimise izikhulu zikaFaro phezu kwabo zashaywa, zathi: “Aniwuqedanga ngani umsebenzi wenu wokwenza izitini izolo nanamuhla njengakuqala na?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
