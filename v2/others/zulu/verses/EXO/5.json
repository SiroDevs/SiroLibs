          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinceku zakho azinikwanga tshani, kepha bathi kithi: ‘Yenzani izitina, nibone, izinceku zakho ziyashaywa; kodwa icala likubantu bakho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.16",
            "verseOrgIds": [
