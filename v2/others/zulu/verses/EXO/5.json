            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zase zifika izinceku zabantwana bakwa-Israyeli, zambiza uFaro, zathi: “Uziphatheleni kanje izinceku zakho na?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.15",
            "verseOrgIds": [
              "EXO.5.15"
            ]
          }
        }
      ]
    },
