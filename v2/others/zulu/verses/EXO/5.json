          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izikhulu zashesha zathi: “Qedelani imisebenzi yenu yezinsuku zonke njengalapho kunotshani.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.13",
            "verseOrgIds": [
              "EXO.5.13"
            ]
          }
        }
      ]
    },
    {
