          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha wathi: “Niyavilapha, niyavilapha; ngalokho nithi: ‘Masihambe sihlabele uJehova.’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.17",
            "verseOrgIds": [
              "EXO.5.17"
            ]
          }
        }
