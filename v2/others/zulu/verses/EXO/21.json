          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uma iyithembise indodana yayo, kumelwe yenze kuyo ngokwendlela yamadodakazi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.9",
            "verseOrgIds": [
              "EXO.21.9"
            ]
