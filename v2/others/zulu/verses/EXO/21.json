        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.3",
            "verseOrgIds": [
              "EXO.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma inkosi yaso isinika umfazi, walizalela amadodana noma amadodakazi; umfazi nabantwana bakhe bayakuba nenkosi yakhe, yona iphume iyodwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.4",
            "verseOrgIds": [
              "EXO.21.4"
            ]
          }
        }
      ]
    },
    {
