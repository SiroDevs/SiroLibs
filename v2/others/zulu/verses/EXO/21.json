          "type": "text",
          "attrs": {
            "verseId": "EXO.21.5",
            "verseOrgIds": [
              "EXO.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yaso iyakusiletha kubahluleli; amlethe ngasemnyango noma ensikeni yomnyango; inkosi yaso iyakuyibhoboza indlebe yaso ngosungulo; futhi uyomkhonza kuze kube phakade.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.6",
            "verseOrgIds": [
              "EXO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
