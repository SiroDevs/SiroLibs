              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umuntu engaboni, kepha uNkulunkulu uyamnikela esandleni sakhe; khona-ke ngizakutshengisa indawo lapho azabalekela khona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
