        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma uthenga isigqila esingumHeberu, siyakusebenza iminyaka eyisithupha; kanti kowesikhombisa kumelwe ahambe ngokukhululeka mahhala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.2",
            "verseOrgIds": [
              "EXO.21.2"
            ]
          }
        }
      ]
    },
    {
