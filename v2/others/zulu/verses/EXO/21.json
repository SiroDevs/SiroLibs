          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma izithathela omunye umfazi; ukudla kwakhe, nezingubo zakhe, nemfanelo yakhe yokugana, makanganciphisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.10",
            "verseOrgIds": [
              "EXO.21.10"
            ]
          }
        }
      ]
    },
