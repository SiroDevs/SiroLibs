        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.2",
            "verseOrgIds": [
              "EXO.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ingene yodwa, kumelwe iphume yodwa; uma ishadile, umkayo makaphume nayo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.3",
            "verseOrgIds": [
              "EXO.21.3"
            ]
          }
        }
      ]
    },
    {
