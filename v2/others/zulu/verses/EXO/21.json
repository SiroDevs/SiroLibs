            "number": "8",
            "style": "v",
            "sid": "EXO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ingathokozisi inkosi yaso, eyakugana yona, iyakumvumela ukuba ahlengwe; ukuyithengisa esizweni sabezizwe, ayiyikuba namandla, ngokuba iyenze ngobuqili kuyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.8",
            "verseOrgIds": [
              "EXO.21.8"
            ]
          }
        }
      ]
    },
    {
