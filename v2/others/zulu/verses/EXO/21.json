        {
          "text": "Kepha uma umuntu efika kumakhelwane wakhe ngokugabadela, ukumbulala ngobuqili; kumelwe umsuse e-altare lami, ukuze afe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
