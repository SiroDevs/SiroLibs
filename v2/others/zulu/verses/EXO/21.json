            "sid": "EXO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umuntu ethengisa ngendodakazi yakhe ukuba ibe yisigqila, ayiyikuphuma njengezigqila.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.7",
            "verseOrgIds": [
              "EXO.21.7"
            ]
          }
        }
