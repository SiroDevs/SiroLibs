          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakusekuncane emehlweni akho, Nkosi Jehova; kodwa wakhuluma okwesikhathi eside ngendlu yenceku yakho. Futhi le yindlela yomuntu, Nkosi Jehova?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
            "verseOrgIds": [
              "2SA.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
