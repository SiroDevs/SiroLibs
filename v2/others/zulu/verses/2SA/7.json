              "2SA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi uDavide yangena, yahlala phambi kukaJehova, yathi: “Ngingubani mina, Nkosi Jehova? futhi iyini indlu yami ukuthi ungilethe lapha?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        }
      ]
    },
    {
