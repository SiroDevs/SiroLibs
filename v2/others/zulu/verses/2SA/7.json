          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yezwi lakho nanjengokwenhliziyo yakho wenzile zonke lezi zinto ezinkulu ukuba uzazise inceku yakho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.21",
            "verseOrgIds": [
              "2SA.7.21"
            ]
          }
        }
      ]
