          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
