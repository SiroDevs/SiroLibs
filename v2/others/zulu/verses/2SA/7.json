            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho umkhulu, Jehova Nkulunkulu, ngokuba akakho onjengawe, akakho uNkulunkulu ngaphandle kwakho njengakho konke esikuzwileyo ngezindlebe zethu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.22",
            "verseOrgIds": [
              "2SA.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
