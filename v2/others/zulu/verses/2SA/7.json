          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uDavida angakutshoni kuwe? ngoba wena Nkosi Jehova uyayazi inceku yakho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.20",
            "verseOrgIds": [
              "2SA.7.20"
            ]
          }
        }
