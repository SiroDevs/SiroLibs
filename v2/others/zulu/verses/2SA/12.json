            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakhipha amadoda ayekulo, wawafaka ngaphansi kwamasaha, nangaphansi kwezimbazo zensimbi, nangaphansi kwezimbazo zensimbi, wawadabulisa esithandweni samatshe; wenze njalo kuyo yonke imizi yabantwana bakwa-Amoni. UDavide nabo bonke abantu babuyela eJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.31",
            "verseOrgIds": [
              "2SA.12.31"
            ]
          }
