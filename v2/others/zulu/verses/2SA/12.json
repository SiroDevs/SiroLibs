          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje-ke hlanganisa abantu abaseleyo futhi umise ngokumelene nomuzi futhi uwuthathe, ukuze ngingawuthathi umuzi futhi ubizwe ngegama lami.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
