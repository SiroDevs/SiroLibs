          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathatha umqhele wenkosi yabo ekhanda lakhe, isisindo sawo sasiyitalenta legolide, namatshe ayigugu, wafakwa ekhanda likaDavide. Wakhipha impango yomuzi ngobuningi obukhulu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        }
      ]
    },
