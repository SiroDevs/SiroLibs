          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wamduduza uBati Sheba umkakhe, wangena kuye, walala naye; wazala indodana, yaqamba igama layo ngokuthi uSolomoni; uJehova wamthanda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
