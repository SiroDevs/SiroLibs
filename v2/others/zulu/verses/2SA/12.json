          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinceku zakhe zathi kuye: “Kuyini lokhu okwenzileyo na?” Wazila ukudla, wakhala ngomntwana esaphila; kodwa esefile umntwana, wavuka wadla isinkwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.21",
            "verseOrgIds": [
              "2SA.12.21"
            ]
          }
        }
      ]
    },
