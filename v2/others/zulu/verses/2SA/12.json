            "number": "21",
            "style": "v",
            "sid": "2SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.21",
            "verseOrgIds": [
              "2SA.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Umntwana esaphila, ngazila ukudla, ngakhala, ngokuba ngathi: ‘Ngubani ongazi, uma uNkulunkulu eyakuba nomusa kimi, ukuze umntwana aphile?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.22",
            "verseOrgIds": [
              "2SA.12.22"
            ]
          }
        }
      ]
    },
