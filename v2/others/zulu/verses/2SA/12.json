            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wayesesuka emhlabathini, wageza, wamgcoba, washintsha izingubo zakhe, wangena endlini kaJehova, wakhuleka; wacela, babeka isinkwa phambi kwakhe, wadla.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        }
