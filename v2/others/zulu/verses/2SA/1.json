        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.13",
            "verseOrgIds": [
              "2SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wayesethi kuye: “Awuzange wesabe kanjani ukwelula isandla sakho ukubhubhisa ogcotshiweyo weNkosi na?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        }
      ]
    },
    {
