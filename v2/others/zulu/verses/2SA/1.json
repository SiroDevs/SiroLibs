              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egazini lababuleweyo, emanoni amaqhawe, umnsalo kaJonathani awubuyanga, nenkemba kaSawule ayibuyanga ilambatha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
