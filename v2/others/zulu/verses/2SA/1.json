            "verseId": "2SA.1.14",
            "verseOrgIds": [
              "2SA.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasebiza enye yezinsizwa, wathi: Sondela umhlasele. Futhi wamshaya waze wafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.15",
            "verseOrgIds": [
              "2SA.1.15"
            ]
          }
        }
      ]
    },
