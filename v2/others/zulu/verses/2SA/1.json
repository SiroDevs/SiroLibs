          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "OSawule noJonathani babebahle, bethandeka ekuphileni kwabo, nasekufeni kwabo abahlukananga; babenejubane kunezinkozi, babenamandla kunezingonyama.",
          "type": "text",
          "attrs": {
