          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasesithi kuye: Igazi lakho liphezu kwekhanda lakho; ngoba umlomo wakho ufakazile ngawe, wathi: Mina ngibulele ogcotshiweyo weNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.16",
            "verseOrgIds": [
              "2SA.1.16"
            ]
          }
        }
