          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Ahithofeli wayesethi ku-Abisalomu: “Ngena kuzo izancinza zikayihlo azishiyile ukuba zilinde indlu; wonke u-Israyeli uyakuzwa ukuthi unengwa nguyihlo; khona izandla zabo bonke abanawe ziyakuba namandla.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.21",
            "verseOrgIds": [
