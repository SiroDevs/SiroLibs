          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bammisela u-Abisalomu itende phezu kwendlu; u-Abisalomu wangena kuzo izancinza zikayise emehlweni abo bonke abakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.22",
