          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngizakhonza bani? angiyikukhonza phambi kwendodana yakhe na? njengalokho ngakhonza phambi kukayihlo, ngiyakuba njalo phambi kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
