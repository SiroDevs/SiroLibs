          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Abisalomu wayesethi ku-Ahithofeli: “Cemani phakathi kwenu ukuthi siyakwenzani.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        }
