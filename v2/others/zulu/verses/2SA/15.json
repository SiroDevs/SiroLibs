            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.23",
            "verseOrgIds": [
              "2SA.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, uZadoki nawo onke amaLevi babe naye abathwala umphongolo wesivumelwano sikaNkulunkulu; bawubeka phansi umphongolo kaNkulunkulu; u-Abiyathara wenyuka, baze baqeda bonke abantu ukuphuma emzini.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.24",
            "verseOrgIds": [
              "2SA.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.24",
            "verseOrgIds": [
              "2SA.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yathi kuSadoki: “Buyisela umphongolo kaNkulunkulu emzini; uma ngifumana umusa emehlweni kaJehova, uyakungibuyisa, angibonise wona nendawo yakhe yokuhlala.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.25",
            "verseOrgIds": [
              "2SA.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.25",
            "verseOrgIds": [
              "2SA.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma ethi: “Angithokozi ngawe; bheka, ngilapha, makenze kimi okuhle kuye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.26",
            "verseOrgIds": [
              "2SA.15.26"
            ]
          }
        }
      ]
    },
    {
