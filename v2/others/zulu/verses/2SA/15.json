      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.19",
            "verseOrgIds": [
              "2SA.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba ufikile izolo, kufanele ngikuvumele wehle njalo kanye nathi namuhla? njengoba ngiya lapho engiya khona, buyani nithathe abafowenu; umusa neqiniso makube nawe!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.20",
            "verseOrgIds": [
              "2SA.15.20"
            ]
          }
        }
      ]
    },
    {
