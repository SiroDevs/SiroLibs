      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.22",
            "verseOrgIds": [
              "2SA.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwe lonke lakhala ngezwi elikhulu, nabantu bonke badabula; nenkosi yadabula umfudlana iKidroni, nabantu bonke bawela ngendlela yasehlane.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.23",
            "verseOrgIds": [
              "2SA.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
