            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.21",
            "verseOrgIds": [
              "2SA.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavide wayesethi ku-Ithayi: “Dlula.” U-Ithayi umGiti wadabula namadoda akhe nabo bonke abantwana ababenaye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.22",
            "verseOrgIds": [
              "2SA.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
