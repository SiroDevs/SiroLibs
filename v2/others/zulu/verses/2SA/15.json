            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasisithi kuIthayi umGithi: Kungani lawe uhambe lathi? buyela endaweni yakho, uhlale nenkosi, ngokuba ungowezizwe futhi ungumdingi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.19",
            "verseOrgIds": [
              "2SA.15.19"
            ]
          }
        }
      ]
    },
    {
