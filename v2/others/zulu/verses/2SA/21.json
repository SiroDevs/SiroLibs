            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwalokho kwaba nenye impi namaFilisti eGobi;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
