          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaba khona enye impi namaFilisti eGobi, lapho u-Elihanani indodana kaJahare-oregimi waseBetlehema, umfowabo kaGoliyati, umGiti, omkhonto wakhe wawunjengogongolo lomaluki, wahlula khona.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
