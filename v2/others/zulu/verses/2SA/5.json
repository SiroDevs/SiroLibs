          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDavida wasebona ukuthi uJehova wayemmisile ukuthi abe yinkosi phezu kukaIsrayeli lokuthi wawuphakamisile umbuso wakhe ngenxa yabantu bakhe uIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.12",
            "verseOrgIds": [
              "2SA.5.12"
            ]
