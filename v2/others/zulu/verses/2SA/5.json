          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHiramu inkosi yaseTire wathuma izithunywa kuDavide, nemisedari, nababazi, nabakhi, bamakhela uDavide indlu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.11",
