          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengalokho nasivuma nganxanye, ukuthi siyikuzibonga kwenu, njengalokhu nani ningabethu ngosuku lweNkosi uJesu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
