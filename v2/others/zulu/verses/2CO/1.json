          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke lapho ngicabanga kanjalo, ngenza ubuwula na? Noma lokho engikuhlosileyo ngihlose ngokwenyama yini ukuba kimi kube uyebo, yebo, noqhabo?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        }
      ]
    },
