          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunalokho nginethemba, bengihlose ukuza kini ngaphambili, ukuze nizuze okwesibili;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        }
      ]
    },
