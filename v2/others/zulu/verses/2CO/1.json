        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani nisiza kanye nathi ngokusikhulekela, ukuze isipho esisiphiwe thina ngabantu abaningi sibongwe ngabaningi ngenxa yethu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
    {
