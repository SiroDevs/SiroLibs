          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngidlule kini ngiye eMakedoniya, ngibuye ngize kini ngivela eMakedoniya, ningiphelezele ngibheke eJudiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
