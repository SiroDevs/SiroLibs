            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba asinilobeli okunye, kuphela lokho enikufundayo nenikuqondayo; futhi ngiyethemba ukuthi niyakuvuma kuze kube sekupheleni;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        }
      ]
    },
    {
