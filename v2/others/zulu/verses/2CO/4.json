              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kasidangali; kepha noma kubhubha umuntu wethu wangaphandle, owangaphakathi wenziwa musha imihla ngemihla.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.16",
            "verseOrgIds": [
