          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba konke kungenxa yenu, ukuze umusa ngokwandayo ngokubonga kwabaningi uvame, kube ludumo kuNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        }
