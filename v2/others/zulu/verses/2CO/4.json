              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thina silomoya wokukholwa, njengokulotshiweyo ukuthi: Ngakholwa, ngakho ngakhuluma; nathi siyakholwa, ngakho siyakhuluma;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
