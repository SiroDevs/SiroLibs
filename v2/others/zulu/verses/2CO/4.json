          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba thina esiphilayo sihlala sinikelwa ekufeni ngenxa kaJesu, ukuze nokuphila kukaJesu kubonakaliswe enyameni yethu efayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
