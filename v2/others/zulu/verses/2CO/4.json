        {
          "text": "sisazi ukuthi yena owavusa iNkosi uJesu uzasivusa lathi ngoJesu, asethule kanye lani.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
            "verseOrgIds": [
