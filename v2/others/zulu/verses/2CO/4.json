            "style": "v",
            "sid": "2CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.3",
            "verseOrgIds": [
              "2CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "okukubo unkulunkulu walelizwe uphuphuthekisile ingqondo yabangakholwayo, ukuze kungasi kubo ukukhanya kwevangeli lenkazimulo kaKristu ongumfanekiso kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.4",
            "verseOrgIds": [
              "2CO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
