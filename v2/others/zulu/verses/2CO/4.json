          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sithwele njalonjalo emzimbeni wethu ukufa kweNkosi uJesu, ukuze lempilo kaJesu ibonakaliswe emizimbeni yethu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
              "2CO.4.10"
            ]
