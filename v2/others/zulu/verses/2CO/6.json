          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.6",
            "verseOrgIds": [
              "2CO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngezwi leqiniso, ngamandla kaNkulunkulu, ngezikhali zokulunga ngakwesokunene nangakwesokhohlo;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.7",
            "verseOrgIds": [
              "2CO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.7",
            "verseOrgIds": [
              "2CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekuhlonitshweni nasekuhlazweni, ngemibiko emibi negama elihle, njengabakhohlisi, nokho abaqinisileyo;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.8",
            "verseOrgIds": [
              "2CO.6.8"
            ]
          }
        }
      ]
    },
