          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke kube yimbuyiselo (ngikhuluma njengakubantwana bami), yandiswani nani.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        }
      ]
    },
    {
