        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho phumani phakathi kwabo, nahlukane nabo, isho iNkosi, ningathinti okungcolileyo; futhi ngizokwamukela,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    },
