              "2CO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nina baseKorinte, umlomo wethu uvulekele kini, inhliziyo yethu yenziwe banzi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
          }
        }
      ]
    },
