          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengabangaziwa, kodwa baziwa kakhulu; njengabafayo, futhi, bheka, siyaphila; njengabalaywayo, njalo abangabulawanga;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.9",
            "verseOrgIds": [
              "2CO.6.9"
            ]
          }
