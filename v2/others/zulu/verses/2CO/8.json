          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengokulotshiweyo ukuthi: Owayebuthe okunengi akabanga nokusalela; nowabutha okuncane akaswelanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.15",
            "verseOrgIds": [
              "2CO.8.15"
            ]
          }
        }
