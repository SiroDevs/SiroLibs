          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa ukulingana, ukuze kuthi khathesi inala yenu isizele ukuswela kwabo, ukuze lokunala kwabo kugcwalise ukuswela kwenu, ukuze kube lokulingana;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.14",
            "verseOrgIds": [
              "2CO.8.14"
            ]
          }
        }
