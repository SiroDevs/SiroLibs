          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.11",
            "verseOrgIds": [
              "2CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma kuqala kukhona ukuvuma, kwamukeleka ngokwalokho umuntu anakho, kungenjengalokho angenakho.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.8.12",
            "verseOrgIds": [
              "2CO.8.12"
            ]
          }
        }
      ]
    },
