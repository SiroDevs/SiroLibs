            "sid": "2CO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke kusukela manje asisazi muntu ngokwenyama; yebo, noma sesimazi uKristu ngokwenyama, nokho kusukela manje asisamazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        }
      ]
    },
