          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uma umuntu ekuKristu, uyisidalwa esisha; bheka, sekuvele okusha.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.17",
            "verseOrgIds": [
              "2CO.5.17"
            ]
          }
        }
      ]
    },
