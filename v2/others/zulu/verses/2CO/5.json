          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
            "verseOrgIds": [
              "2CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho sisebenza nzima ukuthi, loba sikhona kumbe singekho, sibe ngabamukelekayo kuye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
            "verseOrgIds": [
              "2CO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
