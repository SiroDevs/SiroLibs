          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke kufanele nimthethelele, nimduduze, funa onjalo agwinywe usizi olukhulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.7",
            "verseOrgIds": [
              "2CO.2.7"
            ]
          }
        }
