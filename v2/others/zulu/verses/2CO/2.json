          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angibanga nakuphumula emoyeni wami, ngokuba angimfumananga uThithu umzalwane wami;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
