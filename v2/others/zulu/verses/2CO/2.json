              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke ekufikeni kwami eTrowa ukutshumayela ivangeli likaKristu, ngasengivulelwe umnyango eNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
