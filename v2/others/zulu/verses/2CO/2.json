          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabanye siyiphunga lokufa kube ngukufa; futhi kwabanye iphunga lokuphila kube ngukuphila. Futhi ngubani owanele lezi zinto?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
        }
