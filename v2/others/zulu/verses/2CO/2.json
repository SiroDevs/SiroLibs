            "style": "v",
            "sid": "2CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.3",
            "verseOrgIds": [
              "2CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ekuhluphekeni okukhulu lobuhlungu benhliziyo ngalibhalela ngezinyembezi ezinengi; kungeyisikho ukuthi nidabuke, kodwa ukuze nazi uthando enginithanda kakhulu ngalo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.4",
            "verseOrgIds": [
              "2CO.2.4"
            ]
          }
        }
      ]
    },
    {
