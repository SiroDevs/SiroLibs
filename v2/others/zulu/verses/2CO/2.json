          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba thina siyiphunga elimnandi likaKristu kuNkulunkulu phakathi kwabasindiswayo nakwababhubhayo;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        }
