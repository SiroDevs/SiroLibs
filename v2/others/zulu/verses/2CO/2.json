          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makabongwe uNkulunkulu osihola njalo ekunqobeni kuKristu, ebonakalisa ngathi iphunga lokwazi kwakhe ezindaweni zonke.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
