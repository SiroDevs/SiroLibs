        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.2",
            "verseOrgIds": [
              "2CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganilobela lokhu, ukuze kuthi ekufikeni kwami ngingabi lusizi yilabo engimelwe ukuthokoza ngabo; nginethemba ngani nonke ukuthi intokozo yami iyinjabulo yenu nonke.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.3",
            "verseOrgIds": [
              "2CO.2.3"
            ]
          }
        }
      ]
    },
    {
