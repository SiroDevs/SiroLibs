              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngazimisela lokhu ngokwami ukuthi ngingabuyi ngize kini ngidabukile.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.1",
            "verseOrgIds": [
