            "sid": "2CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma mina nginidabukisa, ngubani-ke ongithokozisayo, uma kungesiye lowo engidabukisayo na?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.2",
            "verseOrgIds": [
              "2CO.2.2"
            ]
          }
        }
      ]
    },
    {
