          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "funa uSathane asidle, ngokuba asibona abangenalwazi ngamacebo akhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.11",
