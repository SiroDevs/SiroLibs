          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma ekhona odabukisile, akadabukisanga mina, kodwa nganxanye, ukuze nginganiqiqi nonke.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.5",
            "verseOrgIds": [
              "2CO.2.5"
            ]
          }
        }
      ]
    },
