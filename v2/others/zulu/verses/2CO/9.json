          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabongwe uNkulunkulu ngesipho sakhe esingakhulumekiyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.15",
            "verseOrgIds": [
