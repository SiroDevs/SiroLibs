          "type": "text",
          "attrs": {
            "verseId": "2CO.9.13",
            "verseOrgIds": [
              "2CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nangokukhuleka kwabo ngani, benilangazelela ngenxa yomusa omkhulu kaNkulunkulu phakathi kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.14",
            "verseOrgIds": [
              "2CO.9.14"
            ]
          }
        }
      ]
