            "sid": "MRK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uJesu ekwazi wathi kubo: Kungani liphikisana ngokuthi lingelazinkwa? anikaqondi, anikaqondi na? Inhliziyo yenu iselukhuni na?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        }
      ]
    },
