          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasebalaya wathi: Qaphelani, lixwaye imvubelo yabaFarisi lemvubelo kaHerodi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.15",
            "verseOrgIds": [
              "MRK.8.15"
            ]
          }
        }
      ]
