            "sid": "2TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nina, bazalwane, ningakhathali ekwenzeni okuhle.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.13",
            "verseOrgIds": [
              "2TH.3.13"
            ]
          }
        }
      ]
