            "sid": "2TH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ekhona ongalaleli izwi lethu kule ncwadi, mphawuleni lowo, ningahlanganyeli naye, ukuze abe namahloni.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.14",
            "verseOrgIds": [
              "2TH.3.14"
            ]
          }
        }
      ]
    },
    {
