          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha iNkosi yokuthula uqobo mayiniphe ukuthula ngezikhathi zonke ngezindlela zonke. INkosi mayibe nani nonke.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        }
      ]
    },
