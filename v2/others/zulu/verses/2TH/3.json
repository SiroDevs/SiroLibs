        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanjalo siyabayala, sibayala ngeNkosi yethu uJesu Kristu, ukuba basebenze ngokuthula, badle okwabo isinkwa.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
            "verseOrgIds": [
              "2TH.3.12"
            ]
          }
        }
      ]
    },
    {
