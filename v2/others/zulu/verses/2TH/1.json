          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.3",
            "verseOrgIds": [
              "2TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze nathi ngokwethu sizibonga ngani emabandleni kaNkulunkulu ngokubekezela nokukholwa kukho konke ukuzingelwa kwenu nezinsizi enibekezelayo;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        }
      ]
    },
