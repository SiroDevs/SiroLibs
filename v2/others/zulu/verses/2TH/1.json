          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawulu, noSilvanu, noThimothewu kulo ibandla labaseThesalonika elikuNkulunkulu uBaba wethu naseNkosini uJesu Kristu:",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
