            "sid": "2TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "abayakujeziswa ngokubhujiswa okuphakade basuke ebusweni beNkosi nasenkazimulweni yamandla ayo;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.9",
            "verseOrgIds": [
              "2TH.1.9"
            ]
          }
        }
