            "sid": "2TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho isiza ukukhazinyuliswa kwabangcwele bayo, nokutuswa yibo bonke abakholwayo (ngokuba kwakholwa ubufakazi bethu phakathi kwenu) ngalolo suku.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.10",
            "verseOrgIds": [
              "2TH.1.10"
            ]
          }
        }
      ]
