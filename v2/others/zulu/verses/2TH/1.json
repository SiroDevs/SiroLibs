        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuwuphawu lokwahlulela okulungileyo kukaNkulunkulu, ukuze nibalwe njengabafanele umbuso kaNkulunkulu, enihlupheka ngenxa yawo;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.5",
            "verseOrgIds": [
              "2TH.1.5"
            ]
          }
        }
      ]
    },
