            "number": "7",
            "style": "v",
            "sid": "2TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.7",
            "verseOrgIds": [
              "2TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elangabi lomlilo liphindisela kwabangamaziyo uNkulunkulu, labangalaleli ivangeli leNkosi yethu uJesu Kristu;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.8",
            "verseOrgIds": [
              "2TH.1.8"
            ]
          }
        }
      ]
    },
