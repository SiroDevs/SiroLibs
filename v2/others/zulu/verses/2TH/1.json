        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakini enihluphekayo, niphumule kanye nathi, lapho iNkosi uJesu yambulwa ezulwini inezingelosi zayo ezinamandla;",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.7",
            "verseOrgIds": [
              "2TH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
