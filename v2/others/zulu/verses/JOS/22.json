              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana bakwa-Israyeli bathumela kubantwana bakwaRubeni nakubantwana bakwaGadi nasengxenyeni yesizwe sakwaManase ezweni lakwaGileyadi uFinehasi indodana ka-Eleyazare umpristi;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.13",
            "verseOrgIds": [
              "JOS.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.13",
            "verseOrgIds": [
              "JOS.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanye naye izikhulu eziyishumi, isikhulu kuzo zonke izindlu zezikhulu, kube yisikhulu ezizweni zonke zakwa-Israyeli; bonke babeyizinhloko zezindlu zoyise phakathi kwezinkulungwane zakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafika kubantwana bakwaRubeni nakubantwana bakwaGadi nasenxenyeni yesizwe sakwaManase ezweni lakwaGileyadi, bakhuluma kubo, bathi:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.15",
            "verseOrgIds": [
              "JOS.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.15",
            "verseOrgIds": [
              "JOS.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isho kanje yonke inhlangano kaJehova, ithi: ‘Yisiphi isiphambeko esinenzile kuNkulunkulu ka-Israyeli ukuba nisuke kuJehova namuhla ngokuzakhela i-altare ukuba nihlubuke uJehova namuhla na?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        }
      ]
    },
