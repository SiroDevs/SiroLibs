            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yempi kaJehova yathi kuJoshuwa: “Khumula izicathulo zakho onyaweni lwakho; ngoba indawo omi kuyo ingcwele. UJoshuwa wenze njalo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        }
