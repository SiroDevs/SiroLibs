              "JOS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Qha; kodwa manje ngiyinduna yebutho leNkosi. UJoshuwa wawa ngobuso bakhe emhlabathini, wakhuleka kuye, wathi kuye: “Ithini inkosi yami encekwini yayo na?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        }
      ]
    },
