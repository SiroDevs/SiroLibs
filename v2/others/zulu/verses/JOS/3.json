          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.16",
            "verseOrgIds": [
              "JOS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abapristi abathwala umphongolo wesivumelwano sikaJehova bema baqina emhlabathini owomileyo phakathi neJordani, bonke abakwa-Israyeli badabula emhlabathini owomileyo, kwaze kwaba yilapho isizwe sonke siwela iJordani sihlambulukile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        }
