              "type": "text"
            }
          ]
        },
        {
          "text": "Zakukhipha phakathi kwetende zakuyisa kuJoshuwa nakubo bonke abantwana bakwa-Israyeli zakubeka phambi kukaJehova.",
          "type": "text",
          "attrs": {
