              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJoshuwa wayesethuma izithunywa, zagijimela etendeni; bheka, kwakufihliwe etendeni lakhe, nesiliva liphansi kwakho.",
          "type": "text",
          "attrs": {
