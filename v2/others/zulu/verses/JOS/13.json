          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inxenye yakwaGileyadi, ne-Ashitaroti, ne-Edireyi, imizi yombuso ka-Ogi eBashani, yayingelabantwana bakwaMagiri indodana kaManase, inxenye yabantwana bakwaMagiri ngemindeni yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
      ]
    },
