        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.16",
            "verseOrgIds": [
              "JOS.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "iHeshiboni nayo yonke imizi yalo esethafeni; iDiboni, neBamoti Bali, neBeti Bali-meyoni,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.17",
            "verseOrgIds": [
              "JOS.13.17"
            ]
          }
        }
      ]
    },
    {
