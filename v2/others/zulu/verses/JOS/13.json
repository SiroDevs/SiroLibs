            "sid": "JOS 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhawulo wabantwana bakwaRubeni wawuyiJordani nomkhawulo walo. Leli laliyifa labantwana bakwaRubeni ngemindeni yabo, imizi nemizana yayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.23",
            "verseOrgIds": [
