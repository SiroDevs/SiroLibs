              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhawulo wabo wasukela eMahanayimi, lonke iBashani, wonke umbuso ka-Ogi, inkosi yaseBashani, nayo yonke imizana yaseJayire eseBashani: imizi engamashumi ayisithupha;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        }
