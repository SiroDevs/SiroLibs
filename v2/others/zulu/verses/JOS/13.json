            "sid": "JOS 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhawulo wabo wasukela e-Aroweri elisosebeni lomfula i-Arinoni, nomuzi ophakathi nomfula, nethafa lonke eMedeba;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.16",
            "verseOrgIds": [
              "JOS.13.16"
            ]
          }
        }
      ]
    },
