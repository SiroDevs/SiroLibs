          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawa angamafa uMose awanika ukuba abe yifa emathafeni akwaMowabi ngaphesheya kweJordani eJeriko ngasempumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
        }
