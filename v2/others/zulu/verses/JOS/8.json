          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.20",
            "verseOrgIds": [
              "JOS.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uJoshuwa no-Israyeli wonke bebona ukuthi abaqamekeli bawuthathile umuzi nokuthi umusi wawukhuphuka emzini, baphenduka bawabulala amadoda ase-Ayi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.21",
            "verseOrgIds": [
              "JOS.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
