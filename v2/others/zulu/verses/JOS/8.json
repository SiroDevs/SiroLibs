              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.18",
            "verseOrgIds": [
              "JOS.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaqamekeli bavuka masinyane endaweni yabo, bagijima lapho nje elula isandla sakhe; bangena emzini bawuthatha baphuthuma bawuthungela ngomlilo umuzi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.19",
            "verseOrgIds": [
              "JOS.8.19"
            ]
          }
        }
      ]
    },
    {
