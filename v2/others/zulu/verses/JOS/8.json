          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wayesethi kuJoshuwa: “Yelulela umkhonto osesandleni sakho ngase-Ayi; ngokuba ngiyakuwunikela esandleni sakho. UJoshuwa welulela umkhonto owawusesandleni sakhe ngasedolobheni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.18",
            "verseOrgIds": [
              "JOS.8.18"
            ]
          }
        }
      ]
    },
    {
