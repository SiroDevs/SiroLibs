            "sid": "PHM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.3",
            "verseOrgIds": [
              "PHM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyambonga uNkulunkulu wami njalo ngikukhumbula emikhulekweni yami;",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.4",
            "verseOrgIds": [
              "PHM.1.4"
            ]
          }
        }
      ]
    },
    {
