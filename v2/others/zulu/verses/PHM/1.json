          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engabi njengenceku, kodwa ongaphezu kwenceku, engumzalwane othandekayo, ikakhulukazi kimi, kodwa kakhulu kangakanani kuwe, enyameni naseNkosini.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.16",
            "verseOrgIds": [
              "PHM.1.16"
            ]
          }
        }
