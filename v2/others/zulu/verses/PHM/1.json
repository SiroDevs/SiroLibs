        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizwa ngothando lwakho nokukholwa onakho eNkosini uJesu nakubo bonke abangcwele;",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.5",
            "verseOrgIds": [
              "PHM.1.5"
            ]
          }
        }
      ]
    },
    {
