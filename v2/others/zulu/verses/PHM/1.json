          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze ukuhlanganyela kokukholwa kwakho kube nempumelelo ekwazini konke okuhle okukini kuKristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.6",
            "verseOrgIds": [
              "PHM.1.6"
            ]
          }
        }
      ]
    },
    {
