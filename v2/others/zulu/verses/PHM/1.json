          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokho ngenxa yothando kungcono ngikuncenge, mina enginjengoPawulu ixhegu, namanje futhi ngiyisiboshwa sikaKristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.9",
            "verseOrgIds": [
              "PHM.1.9"
            ]
          }
        }
      ]
    },
