          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.7",
            "verseOrgIds": [
              "PHM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
