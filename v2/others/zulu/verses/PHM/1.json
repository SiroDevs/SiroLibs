              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngaphandle kwakho kangiyikwenza lutho; ukuze inzuzo yakho ingabi njengengokucindezelwa, kodwa ngokuzithandela.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.14",
            "verseOrgIds": [
              "PHM.1.14"
            ]
