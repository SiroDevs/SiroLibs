        {
          "text": "Ngakho-ke uma ungibheka njengomhlanganyeli, mamukele njengami.",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.17",
            "verseOrgIds": [
              "PHM.1.17"
            ]
          }
        }
