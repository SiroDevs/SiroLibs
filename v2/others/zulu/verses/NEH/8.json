        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathola izincazelo emthethweni uJehova ayala ngawo ngesandla sikaMose ukuthi abantwana bakwa-Israyeli bahlale emadokodweni ngomkhosi wenyanga yesikhombisa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
