        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuthi bakumemezele, bamemeze emizini yabo yonke naseJerusalema, bathi: ‘Phumani niye entabeni, nithathe amagatsha omnqumo, nezingatsha zikaphayini, nezingatsha zemibomvana, namagatsha esundu, namagatsha emithi eminyene ukwenza amadokodo, njengokuba kunjalo kubhaliwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
        }
      ]
    },
