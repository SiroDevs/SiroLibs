            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesibili izinhloko zawoyise babo bonke abantu, abapristi namaLevi, zabuthana kanye no-Ezra umbhali ukuze baqonde amazwi omthetho.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.13",
            "verseOrgIds": [
              "NEH.8.13"
            ]
          }
        }
      ]
    },
    {
