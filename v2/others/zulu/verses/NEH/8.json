          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.6",
            "verseOrgIds": [
              "NEH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "OJehuwa, noBani, noSherebiya, noJamini, no-Akubi, noSabhethayi, noHodiya, noMahaseya, noKelitha, no-Azariya, noJozabadi, noHanani, noPhelaya, namaLevi, baqondisa abantu umthetho, nabantu bema ezindaweni zabo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.7",
            "verseOrgIds": [
              "NEH.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
