            "sid": "NEH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baphuma bawaletha, bawenza amadokodo, kwaba yilowo nalowo ophahleni lwendlu yakhe nasemagcekeni abo nasemagcekeni endlu kaNkulunkulu, nasesigcawini seSango Lamanzi nasezitaladini zakwa-Efrayimi. Isango.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.16",
            "verseOrgIds": [
              "NEH.8.16"
            ]
          }
        }
      ]
    },
