          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodwa iphansi kwabaphathi nababusi kuze kufike isikhathi esamiswa nguyise.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.2",
            "verseOrgIds": [
              "GAL.4.2"
            ]
          }
        }
      ]
    },
    {
