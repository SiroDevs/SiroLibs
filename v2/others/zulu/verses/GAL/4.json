          "type": "text",
          "attrs": {
            "verseId": "GAL.4.9",
            "verseOrgIds": [
              "GAL.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
