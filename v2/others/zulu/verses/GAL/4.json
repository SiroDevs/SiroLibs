          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuhle ukutshiseka entweni enhle njalonjalo, kungabi nxa ngilani kuphela.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.18",
            "verseOrgIds": [
              "GAL.4.18"
            ]
          }
