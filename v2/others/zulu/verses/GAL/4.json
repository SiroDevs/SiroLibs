            "verseOrgIds": [
              "GAL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pho-ke iphi isibusiso enakhuluma ngaso na? ngokuba ngiyanifakazela ukuthi, uma bekungenzeka, beniyakukhupha amehlo enu, ninginike wona.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.15",
            "verseOrgIds": [
              "GAL.4.15"
            ]
          }
        }
      ]
    },
    {
