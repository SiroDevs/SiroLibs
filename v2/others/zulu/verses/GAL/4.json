          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayanishisekela, kodwa hhayi kahle; yebo, bafuna ukunivalela ngaphandle, ukuze nibaphathe kabi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.17",
            "verseOrgIds": [
              "GAL.4.17"
            ]
          }
        }
