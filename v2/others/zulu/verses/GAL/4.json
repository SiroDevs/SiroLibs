          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyanesaba, funa ngisebenzele ize phezu kwenu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.11",
            "verseOrgIds": [
              "GAL.4.11"
            ]
          }
        }
      ]
    },
    {
