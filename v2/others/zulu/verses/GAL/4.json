        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.15",
            "verseOrgIds": [
              "GAL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho sengaba yisitha senu yini, ngokuba nginitshela iqiniso?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.16",
            "verseOrgIds": [
              "GAL.4.16"
            ]
          }
        }
      ]
