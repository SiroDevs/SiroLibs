              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ngithi indlalifa iseyingane, kayahlukanga ngalutho encekwini, nakuba iyinkosi yakho konke;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.1",
            "verseOrgIds": [
              "GAL.4.1"
            ]
          }
        }
      ]
    },
    {
