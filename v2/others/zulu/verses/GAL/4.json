          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukulingwa kwami okwakusenyameni yami anikudelelanga, anikuyekanga; kodwa nangamukela njengengelosi kaNkulunkulu, njengoKristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.14",
            "verseOrgIds": [
              "GAL.4.14"
            ]
          }
        }
      ]
    },
    {
