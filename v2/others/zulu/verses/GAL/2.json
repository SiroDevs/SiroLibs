          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi oJakobe, noKhefase, noJohane, ababebonakala beyizinsika, bebona umusa engiwuphiweyo, banika mina noBarnaba isandla sokunene sokuhlangana; ukuze siye kwabezizwe, bona baye kwabasokile.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        }
      ]
    },
    {
