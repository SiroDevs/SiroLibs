          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "esabanika ngokuzithoba, hatshi okwehola; ukuze iqiniso levangeli lihlale kini.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
