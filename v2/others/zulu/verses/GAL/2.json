          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "futhi ngenxa yabazalwane bamanga abangeniswa bengazi, abangena ngokunyenya ukuze bahlole ukukhululeka kwethu esilakho kuKristu Jesu, ukuze basenze izigqili;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        }
      ]
