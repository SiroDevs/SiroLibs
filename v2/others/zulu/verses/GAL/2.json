        {
          "text": "Kepha uPetru esefikile e-Antiyokiya ngamelana naye ebusweni, ngokuba wayenecala.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
