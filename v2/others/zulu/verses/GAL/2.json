          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kulaba abathi banje, (loba babeyini, kakunandaba kimi, uNkulunkulu kakhethi ubuso bamuntu;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        }
      ]
    },
    {
