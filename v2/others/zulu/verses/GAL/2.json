          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuthe ngibona ukuthi kabahambanga ngokuqondileyo njengokweqiniso levangeli, ngathi kuPetro phambi kwabo bonke: Uba wena ongumJuda uphila ngendlela yabezizwe, hatshi eyamaJuda, ubacindezela ngani abaJuda? AbeZizwe ukuba baphile njengamaJuda?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
    {
