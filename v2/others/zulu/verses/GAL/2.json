          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "sisazi ukuthi umuntu kalungisiswa ngemisebenzi yomthetho, kodwangokholo lukaJesu Kristu, lathi sakholwa kuKristu Jesu, ukuze silungisiswe ngokukholwa kuKristu, njalo kungeyisikho ngemisebenzi yomlayo; ngoba ngemisebenzi yomthetho kakulanyama ezalungisiswa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        }
