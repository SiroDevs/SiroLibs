          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bathanda ukuthi sikhumbule abayanga; lokho nami ebengikulangazelela ukukwenza.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
