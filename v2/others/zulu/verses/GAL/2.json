          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenyuka ngesambulo, ngabalandisa ivangeli engilishumayelayo phakathi kwabezizwe, kepha ngasese kwabadumileyo, funa mhlawumbe ngigijime noma ngigijimele ize.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        }
      ]
    },
