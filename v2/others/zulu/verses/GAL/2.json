            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba yena owasebenza ngokuphumelelayo kuPetru ebuphostoli bokusoka nguyena owayenamandla kimi kwabezizwe;)",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        }
      ]
