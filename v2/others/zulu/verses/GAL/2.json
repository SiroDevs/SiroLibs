          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thina esingabaJuda ngemvelo, singezona izoni kwabezizwe;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        }
