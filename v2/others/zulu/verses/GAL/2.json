              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi emva kweminyaka eyishumi nane ngabuye ngenyukela eJerusalema kanye noBarnaba, ngathatha noThithu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        }
      ]
    },
