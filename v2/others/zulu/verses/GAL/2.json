          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabanye abaJuda bazenzisa kanye naye; waze wathatheka noBarnabasi ngokuzenzisa kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
