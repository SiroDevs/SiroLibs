      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona ububi engibubonile phansi kwelanga, futhi buvamile phakathi kwabantu:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
              "ECC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
              "ECC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu uNkulunkulu amnike ingcebo nodumo, angasweli lutho emphefumulweni wakhe kukho konke akufisayo, kepha uNkulunkulu akamniki amandla okukudla, kepha owezizweni uyakudla; kuyize, kuyize. yisifo esibi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.2",
            "verseOrgIds": [
              "ECC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.2",
            "verseOrgIds": [
              "ECC.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umuntu ezala abantwana abayikhulu, aphile iminyaka eminingi, zibe ziningi izinsuku zeminyaka yakhe, nomphefumulo wakhe ungasuthi ngokuhle, futhi angabi nakumbelwa; Ngithi, ukuzalwa okungakafiki kuhle kunaye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ingena kuyize, imuka ebumnyameni, negama layo liyosibekela ubumnyama.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu kwalokho, akazange alibone ilanga futhi engazi lutho; inokuphumula okwedlula ezinye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yebo, noma ephila iminyaka eyinkulungwane ephindwe kabili, akabonanga lutho oluhle; abayi bonke endaweni eyodwa?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke umshikashika womuntu wenzelwa umlomo wakhe, kepha inkanuko ayisuthi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ohlakaniphileyo unenani elingaphezu kwesiwula na? uyini ompofu okwaziyo ukuhamba phambi kwabaphilayo na?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungcono ukubona kwamehlo kunokuzulazula kwesifiso, futhi kuyize nokuxhamazela.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho osekukhulunyiwe, futhi kuyaziwa ukuthi kungumuntu;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba kukhona izinto eziningi ezandisa ize, umuntu ungcono ngani?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngubani owaziyo okumlungele umuntu kulokhu kuphila, zonke izinsuku zokuphila kwakhe okuyize azidlayo njengesithunzi na? ngoba ngubani ongazi okuzakuba emva kwakhe phansi kwelanga?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.12",
            "verseOrgIds": [
              "ECC.6.12"
            ]
          }
        }
      ]
    }
