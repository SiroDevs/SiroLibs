          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganikela inhliziyo yami ukuba yazi, ihlole, ifune ukuhlakanipha nesizathu sezinto, nokwazi ububi bobuwula, yebo, nobuwula, nobuwula.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
