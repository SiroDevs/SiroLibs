          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngifumana okubaba kunokufa, owesifazane onhliziyo yakhe iyizingibe namanetha, nezandla zakhe ziyizibopho; othokozisa uNkulunkulu uyakuphunyuka kuyo; kodwa isoni siyakubanjwa yiyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
