          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, nakhu engikutholile, usho umshumayeli, ngibala ngamunye ngamunye, ukuze ngithole umbiko:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
