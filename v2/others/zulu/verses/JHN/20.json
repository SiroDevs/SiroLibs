              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezinye izibonakaliso ezinengi uJesu wazenza phambi kwabafundi bakhe, ezingalotshiweyo kulugwalo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
