          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona wathi kuTomase: Letha lapha umunwe wakho, ubone izandla zami; letha isandla sakho, usifake ohlangothini lwami, ungabi ngongakholwayo, kodwa okholwayo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.27",
            "verseOrgIds": [
              "JHN.20.27"
            ]
          }
        }
      ]
