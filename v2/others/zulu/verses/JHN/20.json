          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona uJesu wabuye wathi kubo: “Ukuthula makube kinina, njengalokho uBaba engithumile, nami ngiyanithuma nina.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.21",
            "verseOrgIds": [
