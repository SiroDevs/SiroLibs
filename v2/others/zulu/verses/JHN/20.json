              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uTomase, omunye wabayishumi nambili, othiwa uDidimu, wayengekho kubo mhla efika uJesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.24",
