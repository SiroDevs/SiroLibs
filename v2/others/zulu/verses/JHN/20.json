          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eseshilo lokho wababonisa izandla nohlangothi lwakhe. Khona-ke abafundi bajabula lapho bebona iNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.20",
            "verseOrgIds": [
