          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esekushilo lokho wabaphefumulela, wathi kubo: “Yamukelani uMoya oNgcwele;",
          "type": "text",
          "attrs": {
