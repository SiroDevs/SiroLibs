          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi emva kwezinsuku eziyisishiyagalombili abafundi bakhe bengaphakathi futhi, noTomase enabo; uJesu wafika, iminyango ivaliwe, wema phakathi kwabo, wathi: “Ukuthula makube kinina.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.26",
            "verseOrgIds": [
              "JHN.20.26"
            ]
          }
        }
