          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiqinisile, ngiqinisile ngithi kini: Inceku ayinkulu kunenkosi yayo; futhi othunyiweyo mkhulu kunalowo omthumileyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.16",
