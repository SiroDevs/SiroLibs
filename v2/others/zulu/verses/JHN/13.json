            "sid": "JHN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "USimoni Petru wathi kuye: “Nkosi, kungabi izinyawo zami zodwa, kodwa nezandla nekhanda lami.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.9",
            "verseOrgIds": [
              "JHN.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.9",
            "verseOrgIds": [
              "JHN.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wathi kuye: “Ogeziweyo akasweli lutho ngaphandle kokugezwa izinyawo, kodwa uhlanzekile ngokuphelele;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ubemazi ozakumkhaphela; ngakho wathi: Kalihlambulukile lonke.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.11",
            "verseOrgIds": [
              "JHN.13.11"
            ]
          }
        }
      ]
    },
    {
