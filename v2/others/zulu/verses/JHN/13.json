            "sid": "JHN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esezigezile izinyawo zabo, wathatha izembatho zakhe, wabuye wahlala phansi, wathi kubo: Niyakwazi yini engikwenzile kini?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.12",
            "verseOrgIds": [
              "JHN.13.12"
            ]
          }
        }
      ]
    },
    {
