          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningibiza ngokuthi, Mfundisi, neNkosi; ngoba nginjalo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.13",
            "verseOrgIds": [
              "JHN.13.13"
            ]
          }
        }
      ]
    },
