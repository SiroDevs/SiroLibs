          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uMduduzi, uMoya oNgcwele, uBaba ayakumthumela egameni lami uyakunifundisa zonke izinto, anikhumbuze konke enginitshele khona.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.26",
            "verseOrgIds": [
              "JHN.14.26"
            ]
          }
        }
