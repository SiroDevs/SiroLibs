          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalokhu nginitshelile kungakenzeki, ukuze, nxa sekwenzeka, nikholwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.29",
            "verseOrgIds": [
              "JHN.14.29"
            ]
          }
        }
