          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nizwile ukuthi ngithe kini: Ngiyamuka, futhi ngibuye ngize kini. Uma beningithanda, beniyakujabula, ngokuba ngithé: Ngiya kuBaba, ngokuba uBaba mkhulu kunami.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.28",
            "verseOrgIds": [
              "JHN.14.28"
            ]
          }
        }
