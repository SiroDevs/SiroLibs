            "verseOrgIds": [
              "JHN.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu waphendula wathi kuye: “Uma umuntu engithanda, uyakugcina amazwi ami, noBaba uyakumthanda;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        }
