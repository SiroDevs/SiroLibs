            "number": "23",
            "style": "v",
            "sid": "JHN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ongangithandiyo akagcini amazwi ami; nezwi enilizwayo akusilo elami, kodwa ngelikaBaba ongithumileyo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.24",
            "verseOrgIds": [
