          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuthula ngikushiya kini, ukuthula kwami ngininika khona; angininiki njengokupha kwezwe. Inhliziyo yenu mayingakhathazeki, ingesabi;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.27",
            "verseOrgIds": [
              "JHN.14.27"
            ]
          }
        }
