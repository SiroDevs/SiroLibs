          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onemiyalo yami, ayigcine, nguyena ongithandayo; ongithandayo uyakuthandwa nguBaba, nami ngiyakumthanda, ngizibonakalise kuye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.21",
