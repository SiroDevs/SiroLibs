          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuseyisikhashana izwe lingabe lisangibona; kodwa nina niyangibona, ngokuba ngiphila mina, nani nizakuphila.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.19",
