          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJudasi ongesiye u-Iskariyothe wathi kuye: “Nkosi, kuza kanjani ukuba uzibonakalise kithi, ungazibonakalisi ezweni na?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.22",
            "verseOrgIds": [
              "JHN.14.22"
            ]
          }
        }
