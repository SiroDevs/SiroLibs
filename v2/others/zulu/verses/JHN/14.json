          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angisasayikukhuluma okuningi nani, ngokuba uyeza umbusi walumhlaba, kepha akanalutho kimi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.30",
            "verseOrgIds": [
              "JHN.14.30"
            ]
          }
        }
