          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke acacile kwabahlakaniphileyo, alungile kwabathola ukwazi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
