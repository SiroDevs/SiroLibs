          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nina bangenalwazi, qondani ukuhlakanipha, nani ziwula, hlakaniphani ngenhliziyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        }
      ]
    },
    {
