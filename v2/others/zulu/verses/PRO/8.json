            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibiza emasangweni, ekungeneni komuzi, ekungeneni kweminyango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        }
      ]
    },
    {
