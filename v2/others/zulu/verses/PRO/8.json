              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ukuhlakanipha kungcono kunamarubi; futhi zonke izinto ezifiselekayo azinakuqhathaniswa nawo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
