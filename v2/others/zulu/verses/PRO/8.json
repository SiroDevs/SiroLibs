          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamukelani ukulaywa kwami, hatshi isiliva; nolwazi kunegolide elihle.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
