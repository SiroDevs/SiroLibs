          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.14",
            "verseOrgIds": [
              "PRO.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekukhanyeni kobuso benkosi kukhona ukuphila; futhi injabulo yakhe injengefu lemvula yakamuva.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
