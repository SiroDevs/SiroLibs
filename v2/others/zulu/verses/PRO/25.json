              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ofakaza amanga ngomakhelwane wakhe uyisambatho nenkemba nomcibisholo obukhali.",
          "type": "text",
          "attrs": {
