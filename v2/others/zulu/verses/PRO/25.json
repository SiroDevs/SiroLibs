          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Susa unyawo lwakho endlini yomakhelwane wakho; ukuthi angakhathali ngawe futhi akuzonde kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.17",
            "verseOrgIds": [
              "PRO.25.17"
            ]
          }
        }
