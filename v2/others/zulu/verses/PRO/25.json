          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thatha omubi phambi kwenkosi, isihlalo sayo sobukhosi sizaqiniswa ngokulunga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungazimiseli phambi kwenkosi, futhi ungemi esikhundleni sabakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
            "verseOrgIds": [
              "PRO.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
