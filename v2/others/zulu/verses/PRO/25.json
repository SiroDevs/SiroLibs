          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozincoma ngesipho samanga unjengamafu nomoya okungenamvula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.14",
            "verseOrgIds": [
              "PRO.25.14"
            ]
          }
        }
      ]
