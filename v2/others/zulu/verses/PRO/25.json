            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuludumo lukaNkulunkulu ukufihla into, kodwa udumo lwamakhosi luwukuhlola indaba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.2",
            "verseOrgIds": [
              "PRO.25.2"
            ]
          }
        }
      ]
    },
    {
