          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengecici legolide nomhlobiso wegolide elicwengekileyo, kunjalo ukusola okuhlakaniphileyo endlebeni elalelayo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
