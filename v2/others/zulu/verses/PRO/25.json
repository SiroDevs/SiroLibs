        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
