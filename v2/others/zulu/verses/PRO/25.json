          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengamakhaza eqhwa ngesikhathi sokuvuna, sinjalo isithunywa esithembekileyo kwabasithumayo, ngokuba sivuselela umphefumulo wamakhosi aso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
