        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.7",
            "verseOrgIds": [
              "PRO.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vula umlomo wakho kuso isimungulu ngenxa yabo bonke abamiselwe ukubhujiswa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.8",
            "verseOrgIds": [
              "PRO.31.8"
            ]
          }
        }
      ]
    },
    {
