          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvuka kusesebusuku, aphe abendlu yakhe ukudla, aphe izincekukazi zakhe isabelo.",
          "type": "text",
