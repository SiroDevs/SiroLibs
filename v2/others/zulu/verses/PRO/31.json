            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazwi kaLemuweli inkosi, isiprofetho unina amfundisa sona.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.1",
            "verseOrgIds": [
              "PRO.31.1"
            ]
          }
        }
      ]
    },
    {
