              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubheka izwe alithenge; ngezithelo zezandla zakhe utshala isivini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.16",
            "verseOrgIds": [
