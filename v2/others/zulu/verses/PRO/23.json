            "sid": "PRO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nika inhliziyo yakho ekulayweni, nezindlebe zakho emazwini okwazi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.12",
            "verseOrgIds": [
              "PRO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
