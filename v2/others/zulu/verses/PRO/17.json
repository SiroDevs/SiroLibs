          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Othethelela omubi, nolahla olungileyo, bayisinengiso kuJehova bobabili.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
