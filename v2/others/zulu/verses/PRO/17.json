          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikhanzi ngeyesiliva, nesithando ngesegolide, kepha uJehova uhlola izinhliziyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        }
      ]
    },
    {
