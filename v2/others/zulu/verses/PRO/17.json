          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungani kukhona umvuzo esandleni sesiwula ukuze sizuze ukuhlakanipha, njengoba singenanhliziyo yakho?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        }
      ]
    },
