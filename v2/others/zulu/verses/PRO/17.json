          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osibekela isiphambeko ufuna uthando; kepha ophinda indaba wehlukanisa abangane abaningi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
