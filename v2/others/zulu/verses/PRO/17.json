          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umngane uthanda ngezikhathi zonke, nomzalwane uzalelwa ukuhlupheka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.17",
            "verseOrgIds": [
              "PRO.17.17"
