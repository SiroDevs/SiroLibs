          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiqephu esomile esinokuthula singcono kunendlu egcwele iminikelo nokuxabana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        }
      ]
    },
    {
