          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oklolodela ompofu usola uMenzi wakhe; futhi lowo ojabulela izinhlekelele ngeke angajeziswa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        }
      ]
    },
    {
