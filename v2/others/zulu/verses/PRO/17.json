          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu omubi uyazinaka izindebe zamanga; nomqambimanga ulalela ulimi olubi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
