          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukukhuzwa kuyeza kumuntu ohlakaniphileyo kunemivimbo eyikhulu koyisiwula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
