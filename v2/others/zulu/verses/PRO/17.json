          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu makahlangabeze ibhere elilahlekelwe amawundlu alo kunesiwula ebuwula baso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
            "verseOrgIds": [
              "PRO.17.12"
            ]
