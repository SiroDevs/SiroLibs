          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuqala kokuxabana kunjengokuvulela amanzi; ngakho shiya ingxabano ngaphambi kokuphazamisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
