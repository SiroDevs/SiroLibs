            "sid": "PRO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzanika ikhanda lakho umqhele womusa; uyakukunika umqhele wenkazimulo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
