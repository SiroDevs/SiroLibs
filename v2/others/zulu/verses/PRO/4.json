          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugweme, ungadluli kuyo, suka kuyo, udlule.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
