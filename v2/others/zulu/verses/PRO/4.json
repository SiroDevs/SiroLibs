          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungangeni endleleni yababi, ungahambi endleleni yabantu ababi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
