      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbhede wami ngawuhlobisa ngezindwangu ezibaziweyo, ngelineni elicolekileyo laseGibithe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        }
      ]
    },
    {
