          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izibusiso zisekhanda lolungileyo, kodwa ubudlova busibekela umlomo wababi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
