          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osebenza ngesandla esibuthakathaka uba mpofu, kepha isandla sabakhutheleyo siyacebisa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
