              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izaga zikaSolomoni. Indodana ehlakaniphileyo ijabulisa uyise, kepha indodana eyisiwula ingumthwalo kanina.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
