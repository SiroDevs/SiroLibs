            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutha ehlobo ungumfana ohlakaniphileyo; kodwa olalayo ngesikhathi sokuvuna uyindodana yehlazo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
