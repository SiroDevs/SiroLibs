              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukukhunjulwa kolungileyo kubusisiwe, kodwa ibizo lababi lizabola.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
