          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova kayikuyekela umphefumulo wolungileyo ulambe, kodwa uchitha okuhle komubi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
            "verseOrgIds": [
              "PRO.10.3"
