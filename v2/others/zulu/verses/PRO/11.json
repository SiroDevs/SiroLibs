          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyisibambiso somfokazi uyakuhlakanipha; futhi ozonda ibheyili uqinisekile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.15",
