              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazane onomusa ulondoloza udumo, namadoda anamandla alondoloza inotho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.16",
            "verseOrgIds": [
