          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odelela izwi uyakubhujiswa; kepha owesaba umyalo uyakuvuzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
