          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubumpofu nehlazo kowenqaba ukulaywa, kepha ohlonipha ukusolwa uyakudunyiswa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.18",
            "verseOrgIds": [
              "PRO.13.18"
            ]
          }
        }
      ]
