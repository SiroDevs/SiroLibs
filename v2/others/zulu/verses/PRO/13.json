          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inotho ezuzwe yize izancipha, kodwa obutha ngomshikashika uzakwanda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        }
      ]
    },
    {
