          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isihlengo sokuphila komuntu siyingcebo yakhe, kepha ompofu akalaleli ukusolwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        }
      ]
    },
    {
