          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abahlakaniphileyo benza ngokwazi, kepha isiwula sivula ubuwula baso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.16",
            "verseOrgIds": [
              "PRO.13.16"
            ]
          }
        }
