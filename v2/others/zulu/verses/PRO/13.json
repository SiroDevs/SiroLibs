          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umthetho wohlakaniphileyo ungumthombo wokuphila, ukuze kusukwe ezingibeni zokufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        }
      ]
