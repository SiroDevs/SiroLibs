              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungeze umboleke umfowenu ngenzalo; obolekwa ngemali, obolekwa ngokudla, noma obolekwayo nganoma yini ebolekwa ngenzuzo;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
