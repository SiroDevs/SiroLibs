              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.15",
            "verseOrgIds": [
              "DEU.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izahlala lani phakathi kwenu, endaweni ezayikhetha kwelinye lamasango enu, lapho ithanda khona kakhulu; ungamcindezeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.16",
            "verseOrgIds": [
              "DEU.23.16"
            ]
          }
        }
      ]
    },
