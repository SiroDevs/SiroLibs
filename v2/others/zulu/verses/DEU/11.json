              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba lizawela iJordani lingene ukulidla ilizwe uJehova uNkulunkulu wenu azalinika lona, njalo lizalidla lihlale kulo.",
          "type": "text",
          "attrs": {
