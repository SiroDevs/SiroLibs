          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azikho yini ngaphesheya kweJordani endleleni eya ekushoneni kwelanga ezweni lamaKhanani akhileyo ekamu malungana neGiligali ngasemathafeni aseMore na?",
          "type": "text",
          "attrs": {
