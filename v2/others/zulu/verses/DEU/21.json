          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe bathi emadodeni amadala omuzi wakubo: ‘Le ndodana yethu inenkani futhi idlubulunda, ayifuni ukulalela izwi lethu; uyisiminzi nesidakwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.20",
            "verseOrgIds": [
              "DEU.21.20"
            ]
          }
        }
