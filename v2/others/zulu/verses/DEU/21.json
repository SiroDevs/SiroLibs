            "sid": "DEU 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyise nonina bayakumbamba, bamkhiphele kumalunga omuzi wakubo nasesangweni lendawo yakhe yokuhlala;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.19",
            "verseOrgIds": [
              "DEU.21.19"
            ]
          }
        }
