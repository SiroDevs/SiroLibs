          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu bomuzi wakubo bayakumkhanda ngamatshe, afe; khona-ke kumelwe ususe ububi ngaphansi kwakho; wonke u-Israyeli uyakuzwa, esabe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.21",
            "verseOrgIds": [
              "DEU.21.21"
            ]
