          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uma umuntu enendodana enenkani nehlubukayo engalaleli izwi likayise noma izwi likanina, noma eyilaya, engayikulalela;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.18",
            "verseOrgIds": [
              "DEU.21.18"
            ]
          }
        }
