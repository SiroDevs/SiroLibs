          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumelwe nenze njengazo zonke izinto esizenzayo lapha namuhla, wonke umuntu olungile emehlweni akhe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.8",
            "verseOrgIds": [
              "DEU.12.8"
            ]
          }
        }
      ]
    },
