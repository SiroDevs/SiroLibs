          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho uJehova uNkulunkulu wakho echitha izizwe phambi kwakho, lapho uya khona ukuzidla, wena uzilandele, uhlale ezweni lazo;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        }
      ]
    },
