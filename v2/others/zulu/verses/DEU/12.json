              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniyikwenza lokhu kuJehova uNkulunkulu wenu; ngokuba zonke izinengiso kuJehova azizondayo zenzile konkulunkulu bazo; ngoba ngisho namadodana abo namadodakazi abo babashisa ngomlilo konkulunkulu babo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
