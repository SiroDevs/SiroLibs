          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniyikwenza lokhu kuJehova uNkulunkulu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        }
