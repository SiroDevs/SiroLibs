          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyakuba khona indawo uJehova uNkulunkulu wakho ayakuyikhetha ukuba ahlale kuyo igama lakhe; lapho uyakuletha konke engikuyala ngakho; iminikelo yenu yokushiswa nemihlatshelo yenu, okweshumi kwenu nomnikelo wokuphakanyiswa wesandla senu nazo zonke izithembiso zenu zekhethelo enizenza kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        }
