          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uma niwela iJordani, nihlala ezweni uJehova uNkulunkulu wenu aninika lona njengefa, futhi uma eniphumuza ezitheni zenu zonke nxazonke, ukuze nihlale nilondekile;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        }
      ]
    },
