            "sid": "DEU 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezi ziyizimiso nezahlulelo eniyakuzigcina ukuba nizenze ezweni uJehova uNkulunkulu wawoyihlo akunika lona ukuba ulidle zonke izinsuku zokuphila kwenu emhlabeni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        }
      ]
    },
    {
