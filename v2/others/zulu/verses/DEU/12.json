          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalela, uzwe wonke lawa mazwi engikuyala ngawo, ukuze kukuhambele kahle wena nabantwana bakho emva kwakho kuze kube phakade, uma nenza okuhle nokulungile emehlweni kaJehova uNkulunkulu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
