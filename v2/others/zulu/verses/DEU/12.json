              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ujabule phambi kukaJehova uNkulunkulu wakho, wena namadodana akho namadodakazi akho nezinceku zakho nezincekukazi zakho nomLevi osemasangweni akho; ngoba akanasabelo nafa kanye nawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        }
