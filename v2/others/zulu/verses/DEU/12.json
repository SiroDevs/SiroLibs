          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izipho zenu ezingcwele kuphela eninazo, nezithembiso zenu, niyakuhamba niye endaweni uJehova ayakuyikhetha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
