        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa endaweni uJehova uNkulunkulu wenu ayakuyikhetha kuzo zonke izizwe zenu ukuba amise igama lakhe kuyo, ngisho nalapho ehlala khona kumelwe nifune, futhi niyofika lapho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        }
      ]
    },
    {
