        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.2",
            "verseOrgIds": [
              "DEU.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe nigumbuqele ama-altare abo, niphihlize izinsika zabo futhi nishise iziqu zabo zemithi ngomlilo; futhi kumelwe nigawule izithombe ezibaziweyo zonkulunkulu bazo nichithe amagama azo kuleyo ndawo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        }
      ]
    },
    {
