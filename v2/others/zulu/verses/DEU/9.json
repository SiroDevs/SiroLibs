        },
        {
          "text": "Ngase ngithatha amatafula amabili ngawalahla ezandleni zami zombili, ngawaphahlaza phambi kwamehlo enu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.17",
            "verseOrgIds": [
