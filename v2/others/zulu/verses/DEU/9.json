          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngiwa phansi phambi kukaJehova izinsuku ezingamashumi amane nobusuku obungamashumi amane, lapho ngawa phansi ekuqaleni; ngokuba uJehova ushilo ukuthi uyakunibhubhisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        }
      ]
    },
    {
