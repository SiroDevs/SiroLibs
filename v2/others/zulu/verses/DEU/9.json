          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa bangabantu bakho nefa lakho, obakhiphile ngamandla akho amakhulu nangengalo yakho eyeluliweyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.29",
            "verseOrgIds": [
