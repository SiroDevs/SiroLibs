          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhuleka kuJehova ngathi: ‘Nkosi Jehova, ungabhubhisi abantu bakho nefa lakho olihlengile ngobukhulu bakho owalikhipha eGibithe ngesandla esinamandla.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
