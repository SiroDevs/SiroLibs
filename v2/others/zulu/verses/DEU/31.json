        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayala amaLevi athwala umphongolo wesivumelwano sikaJehova, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        }
