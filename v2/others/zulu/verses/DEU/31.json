            "number": "20",
            "style": "v",
            "sid": "DEU 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma ngibangenisa ezweni engalifungela oyise ngesifungo, elivame ubisi nezinyosi; bayakudla, basuthe, bakhuluphale; bese bephendukela kwabanye onkulunkulu, babakhonze, bangigcone, bephule isivumelwano Sami.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.20",
            "verseOrgIds": [
              "DEU.31.20"
            ]
          }
        }
