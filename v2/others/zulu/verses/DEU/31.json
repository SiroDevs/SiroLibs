          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.20",
            "verseOrgIds": [
              "DEU.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuyakuthi lapho ububi obuningi nezinsizi bubehlela, le ngoma ifakaze ngabo, ibe ngufakazi; ngokuba akuyikukhohlakala emilonyeni yezizukulwane zabo; ngoba mina ngiyayazi imicabango yabo abayizulazulayo khathesi, ngingakafiki elizweni engathembisa ngalo ngesifungo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        }
      ]
    },
    {
