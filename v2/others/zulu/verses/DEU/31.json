          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngibuthele onke amalunga ezizwe zakho nezinceku zakho ukuba ngikhulume lawa mazwi ezindlebeni zabo, ngibize izulu nomhlaba ngokumelene nabo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
