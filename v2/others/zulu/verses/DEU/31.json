          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wawakhuluma amazwi ale ngoma ezindlebeni zayo yonke inhlangano yakwa-Israyeli, yaze yaphela.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
            "verseOrgIds": [
              "DEU.31.30"
            ]
