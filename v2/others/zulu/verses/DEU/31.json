          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakufihla nokubufihla ubuso bami ngalolo suku kukho konke okubi abakwenzileyo ngokuphendukela kwabanye onkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.18",
