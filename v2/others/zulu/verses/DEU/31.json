          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi uMose eseqedile ukubhala amazwi alo mthetho encwadini aze aphela,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.24",
            "verseOrgIds": [
              "DEU.31.24"
            ]
          }
        }
      ]
    },
    {
