            "verseId": "DEU.31.18",
            "verseOrgIds": [
              "DEU.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manje zibhaleleni lelihubo, nibafundise abantwana bakwa-Israyeli; ulibeke emlonyeni wabo, ukuze lelihubo libe ngufakazi wami kubantwana bakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.19",
            "verseOrgIds": [
              "DEU.31.19"
            ]
          }
        }
      ]
    },
    {
