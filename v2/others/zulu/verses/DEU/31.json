            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiyazi ukuthi emva kokufa kwami niyozibhubhisa ngokuphelele, futhi niyophambuka endleleni enganiyala ngayo; ububi buyakukwehlela ekupheleni kwezinsuku; ngokuba niyakwenza okubi emehlweni kaJehova ukuba nimcunule ngomsebenzi wezandla zenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        }
      ]
    },
