        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ivangeli lethu alifikanga kini ngezwi kuphela, kodwa nangamandla, nangoMoya oNgcwele, nangokuqiniseka okukhulu; njengokuba nazi ukuthi sasinjani phakathi kwenu ngenxa yenu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.5",
            "verseOrgIds": [
              "1TH.1.5"
            ]
          }
        }
      ]
    },
