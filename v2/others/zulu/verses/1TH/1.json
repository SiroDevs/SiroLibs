          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "sisazi, bazalwane abathandekayo, ukukhethwa kwenu kukaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.4",
            "verseOrgIds": [
              "1TH.1.4"
            ]
          }
        }
