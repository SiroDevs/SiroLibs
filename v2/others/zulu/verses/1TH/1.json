          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bona uqobo babika ngathi ukungena kwethu kini, nokuthi naphendukela kanjani kuNkulunkulu, niphuma ezithombeni, nikhonza uNkulunkulu ophilayo noweqiniso;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.9",
            "verseOrgIds": [
              "1TH.1.9"
            ]
          }
        }
      ]
    },
