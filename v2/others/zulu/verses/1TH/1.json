        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.2",
            "verseOrgIds": [
              "1TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "sikhumbula ngokungaphezi umsebenzi wenu wokholo, nomshikashika wothando, nokubekezela kwethemba eNkosini yethu uJesu Kristu phambi kukaNkulunkulu uBaba wethu;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        }
      ]
    },
    {
