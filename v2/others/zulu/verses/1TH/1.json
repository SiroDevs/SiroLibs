            "sid": "1TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba izwi leNkosi lazwakala livela kini, kungesikho eMakedoniya nase-Akhaya kuphela, kepha nasezindaweni zonke ukukholwa kwenu kuNkulunkulu kwanda; ukuze singadingi ukukhuluma utho.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.8",
            "verseOrgIds": [
              "1TH.1.8"
            ]
          }
        }
      ]
    },
