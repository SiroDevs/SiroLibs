          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokulinda iNdodana yakhe ivela ezulwini, ayivusa kwabafileyo, uJesu osikhulula olakeni oluzayo.",
          "type": "text",
          "attrs": {
