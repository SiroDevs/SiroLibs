          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani naba ngabalingisi bethu nabeNkosi, selamukele izwi ekuhluphekeni okukhulu ngentokozo kaMoya oNgcwele;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.6",
            "verseOrgIds": [
              "1TH.1.6"
            ]
          }
        }
      ]
    },
