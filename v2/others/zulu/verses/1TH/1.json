            "sid": "1TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "naze naba yisibonelo kubo bonke abakholwayo eMakedoniya nase-Akhaya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.7",
            "verseOrgIds": [
              "1TH.1.7"
            ]
          }
        }
