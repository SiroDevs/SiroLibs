          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawulu, noSilvanu, noThimothewu kulo ibandla labaseThesalonika elikuNkulunkulu uBaba naseNkosini uJesu Kristu: Makube kini umusa nokuthula okuvela kuNkulunkulu uBaba wethu naseNkosini uJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
