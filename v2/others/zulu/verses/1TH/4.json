          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona thina esisekhona sisasele siyakuhlwithwa kanye nabo emafwini, sihlangabeze iNkosi emoyeni; kanjalo siyakuba neNkosi njalo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.17",
