          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha maqondana nothando lobuzalwane anidingi ukuba nginilobele, ngokuba nina uqobo ningabafundiswe nguNkulunkulu ukuba nithandane.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
            "verseOrgIds": [
              "1TH.4.9"
            ]
          }
        }
