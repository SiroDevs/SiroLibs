          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uma sikholwa ukuthi uJesu wafa wabuye wavuka, ngokunjalo-ke nalabo abalele kuJesu uNkulunkulu uyobaletha kanye naye.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.14",
