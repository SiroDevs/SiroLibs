          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba lokhu sikusho kini ngezwi leNkosi ukuthi thina esisekhona esisasele ekufikeni kweNkosi asiyikubandulela abaleleyo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
