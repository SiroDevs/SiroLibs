            "number": "6",
            "style": "v",
            "sid": "1TH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze kungabi khona oweqa umfowabo kunoma iyiphi indaba, ngokuba iNkosi ingumphindiseli wakho konke lokho, njengalokho sanixwayisa futhi safakaza.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
