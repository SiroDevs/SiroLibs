          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba iNkosi uqobo iyakwehla ezulwini ngokumemeza, ngezwi lengelosi enkulu, nangecilongo likaNkulunkulu, nabafileyo kuKristu bayakuvuka kuqala;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        }
