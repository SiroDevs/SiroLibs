          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha angithandi, bazalwane, ukuba ningabi nakwazi ngabalalayo, ukuze ningadabuki njengabanye abangenathemba.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.13",
