          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuba nikhuthalele ukuthula, nenze izindaba zenu, nokusebenza ngezandla zenu, njengalokho saniyala;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
