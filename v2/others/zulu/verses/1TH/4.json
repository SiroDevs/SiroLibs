          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
              "1TH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke owalayo akali umuntu, kepha wala uNkulunkulu osinikile noMoya wakhe oNgcwele.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        }
