          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kungabi ngenkanuko, njengabezizwe abangamazi uNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
            ]
          }
        }
      ]
    },
    {
