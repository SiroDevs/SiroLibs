      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "SNG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.15",
            "verseOrgIds": [
              "SNG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "SNG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Othandiweyo wami ungowami, mina ngingowakhe; udla ngaphansi kweminduze.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.16",
            "verseOrgIds": [
              "SNG.2.16"
            ]
          }
        }
      ]
    },
