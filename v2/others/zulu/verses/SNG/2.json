          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "SNG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.16",
            "verseOrgIds": [
              "SNG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "SNG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuze kuse, amathunzi abaleke, phenduka, sithandwa sami, ube njengenkela noma ithole lendluzele ezintabeni ezingcono.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.17",
            "verseOrgIds": [
              "SNG.2.17"
            ]
          }
        }
