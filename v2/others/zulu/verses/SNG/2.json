          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "SNG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juba lami elisemifantwini yedwala, ekusithekeni kwezitebhisi, mangibone ubuso bakho, ngizwe ilizwi lakho; ngokuba limnandi izwi lakho, nobuso bakho buhle.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.14",
            "verseOrgIds": [
              "SNG.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "SNG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.14",
            "verseOrgIds": [
              "SNG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "SNG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sithatheleni izimpungushe, izimpungushe ezincane ezichitha izivini, ngokuba izivini zethu zinezithelo zomvini.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.15",
            "verseOrgIds": [
              "SNG.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
