            "sid": "SNG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngamfuna embhedeni wami ebusuku othandwa ngumphefumulo wami; Ngamfuna kodwa angimtholanga.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakusukuma, ngihambahambe emzini ezitaladini nasezitaladini ngiyakumfuna othandwa ngumphefumulo wami; Ngamfuna kodwa angimtholanga.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalindi bangifumana bezulazula emzini; ngathi kubo: “Umbonile othandwa ngumphefumulo wami na?”",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngadlula kubo kancane, kepha ngamfumana othandwa ngumphefumulo wami; Ngambamba, angizange ngimyeke, ngaze ngamngenisa endlini kamama, ekamelweni lalowo owangithwala.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyanifungisa, madodakazi aseJerusalema, ngezimpungushe nangendluzele yasendle, ukuba ningaluvusi, ningaluvusi uthando lwami, lungakamthandi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngubani lo ophuma ehlane njengezinsika zomusi, egcotshwe ngemure nangempepho, kanye nazo zonke izimila zomthengisi?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
