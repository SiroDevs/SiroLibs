            "sid": "SNG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza izinsika zalo ngesiliva, iphansi lazo ngegolide, nesembozo sazo ngokunsomi, phakathi kwazo simbozwe uthando lwamadodakazi aseJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
