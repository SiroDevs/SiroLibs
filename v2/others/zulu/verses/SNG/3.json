            "number": "11",
            "style": "v",
            "sid": "SNG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phumani, madodakazi aseZiyoni, nibone iNkosi uSolomoni, inomqhele unina ayithwesa ngawo ngosuku lomshado wayo nangosuku lwentokozo yenhliziyo yayo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
