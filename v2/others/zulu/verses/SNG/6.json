            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buya, buya, Shulamiti! buya, buya, ukuze sikubheke. Yini ozoyibona kumShulami? Iqembu lamabutho amabili, njengokungathi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.13",
            "verseOrgIds": [
              "SNG.6.13"
            ]
          }
        }
