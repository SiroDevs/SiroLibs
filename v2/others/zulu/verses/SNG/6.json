          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma ngangazi, umphefumulo wami wangenza ngaba njengenqola yase-Aminadibi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.12",
            "verseOrgIds": [
              "SNG.6.12"
            ]
          }
        }
      ]
    },
