      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.13",
            "verseOrgIds": [
              "SNG.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "SNG 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shesha, sithandwa sami, ube njengenkemane noma njengendluzele phezu kwezintaba zamakha.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.14",
            "verseOrgIds": [
              "SNG.8.14"
            ]
          }
        }
      ]
