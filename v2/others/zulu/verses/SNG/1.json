          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma ungazi lokhu, wena muhlekazi phakathi kwabesifazane, hamba ezinyathelweni zomhlambi, nezimbuzi zakho zeluse ngasematendeni abelusi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.8",
            "verseOrgIds": [
              "SNG.1.8"
            ]
