            "style": "v",
            "sid": "SNG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.3",
            "verseOrgIds": [
              "SNG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngidonsa, siyakugijima emva kwakho; inkosi yangingenisa emakamelweni ayo; sizojabula futhi sijabule ngawe, sizocabanga ngothando lwakho ngaphezu kwewayini; abaqotho bayakuthanda.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        }
      ]
    },
    {
