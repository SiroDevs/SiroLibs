          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izihlathi zakho zinhle ngezinhlobonhlobo zamatshe ayigugu, intamo yakho ngamaketanga egolide.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.10",
            "verseOrgIds": [
              "SNG.1.10"
