              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.4",
            "verseOrgIds": [
              "SNG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngimnyama, kepha ngimuhle, madodakazi aseJerusalema, njengamatende akwaKedari, njengezilenge zikaSolomoni.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.5",
            "verseOrgIds": [
              "SNG.1.5"
            ]
          }
        }
      ]
    },
    {
