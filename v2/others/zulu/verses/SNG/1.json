          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitshele, wena othanda umphefumulo wami, lapho uklaba khona, lapho uphumula khona umhlambi wakho emini; ngoba kungani ngizakuba njengohlubuke emihlambini yabangane bakho?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.7",
            "verseOrgIds": [
              "SNG.1.7"
            ]
          }
        }
      ]
    },
