            "number": "2",
            "style": "v",
            "sid": "SNG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makangange ngokwanga komlomo wakhe, ngokuba uthando lwakho lungcono kunewayini.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.1.2",
            "verseOrgIds": [
              "SNG.1.2"
            ]
          }
        }
