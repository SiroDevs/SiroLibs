          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amehlo omuntu aphakemeyo ayakuthotshiswa, nokuzidla kwabantu kuyakuthotshiswa, kube nguJehova yedwa ophakeme ngalolo suku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
