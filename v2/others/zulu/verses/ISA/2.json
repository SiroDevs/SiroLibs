          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba usuku lukaJehova Sebawoti luyakuba phezu kwabo bonke abazidlayo nabakhukhumeleyo, naphezu kwabo bonke abaziphakamisayo; futhi uyothotshiswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        }
      ]
