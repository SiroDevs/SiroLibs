        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
