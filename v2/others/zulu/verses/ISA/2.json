          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naphezu kwayo yonke imisedari yaseLebanoni ephakemeyo nephakemeyo, naphezu kwawo wonke ama-oki aseBashani;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.13",
            "verseOrgIds": [
