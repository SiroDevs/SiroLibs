          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwe labo ligcwele izithombe; bakhonza umsebenzi wezandla zabo, owenziwe yiminwe yabo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
