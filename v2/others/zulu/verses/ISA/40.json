          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pho lingangifanisa lobani, kumbe ngilingane? Kusho uNgcwele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.25",
            "verseOrgIds": [
              "ISA.40.25"
