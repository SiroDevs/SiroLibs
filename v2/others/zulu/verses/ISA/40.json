          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beningazi na? awuzwanga? anitshelwanga kwasekuqaleni na? aniqondanga izisekelo zomhlaba na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.21",
            "verseOrgIds": [
              "ISA.40.21"
            ]
          }
        }
