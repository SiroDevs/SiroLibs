        },
        {
          "text": "Kepha abamethembayo uJehova bathola amandla amasha; bayakukhuphuka ngamaphiko njengezinkozi; bayogijima bangakhathali; futhi bayohamba bangadangali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.31",
