          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichitha izikhulu; Ubenza ize abahluleli bomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.23",
            "verseOrgIds": [
              "ISA.40.23"
