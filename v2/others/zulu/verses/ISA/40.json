          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.19",
            "verseOrgIds": [
              "ISA.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompofu kangangokuthi akanamnikelo wokudla, ukhetha umuthi ongaboli; uzifunela isisebenzi sobuqili ukuze silungise isithombe esibaziweyo esingantengantengi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.20",
            "verseOrgIds": [
              "ISA.40.20"
            ]
          }
        }
      ]
    },
