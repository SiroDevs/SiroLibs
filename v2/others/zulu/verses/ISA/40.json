          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pho lingamfanisa lobani uNkulunkulu? noma ningamfanisa nani na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.18",
            "verseOrgIds": [
              "ISA.40.18"
            ]
          }
        }
      ]
    },
