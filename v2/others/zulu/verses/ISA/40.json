              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngisho nezinsizwa ziyokhathala futhi zikhathale, nezinsizwa ziyowa ngokuphelele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.30",
            "verseOrgIds": [
              "ISA.40.30"
            ]
          }
        }
      ]
