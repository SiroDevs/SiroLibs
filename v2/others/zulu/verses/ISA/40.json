          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isisebenzi sincibilikisa isithombe esibaziweyo, nomkhandi wegolide usihuqa ngegolide, abumbe amaketanga esiliva.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.19",
            "verseOrgIds": [
              "ISA.40.19"
            ]
          }
        }
      ]
    },
    {
