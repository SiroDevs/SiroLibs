          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 40:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beningazi na? Anizwanga yini ukuthi uNkulunkulu waphakade, uJehova, uMdali wemikhawulo yomhlaba, akakhathali, akakhathali? akukho ukuhlolwa komqondo wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.28",
            "verseOrgIds": [
              "ISA.40.28"
            ]
          }
        }
      ]
    },
