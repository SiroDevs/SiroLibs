          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izizwe zinjengento engelutho phambi kwakhe; babalwa kuye njengabancane kunalutho futhi kuyize.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.17",
            "verseOrgIds": [
              "ISA.40.17"
            ]
          }
        }
      ]
