          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phakamiselani amehlo enu phezulu, nibone ukuthi ngubani owadala lezi zinto, okhipha impi yazo ngokwesibalo; Uzibiza zonke ngamagama ngobukhulu bamandla akhe, ngokuba unamandla amakhulu; akukho neyodwa eyehlulekayo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.26",
            "verseOrgIds": [
              "ISA.40.26"
            ]
          }
        }
      ]
    },
    {
