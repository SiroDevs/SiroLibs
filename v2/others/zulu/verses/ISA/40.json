          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unika okhatheleyo amandla; nakulabo abangenawo amandla, uyabandisa amandla.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.29",
            "verseOrgIds": [
              "ISA.40.29"
            ]
          }
        }
      ]
