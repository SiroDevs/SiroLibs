          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguye ohlezi esiyingelezini somhlaba, nabakhileyo kuwo banjengesikhonyane; oweneka izulu njengesihenqo, waleneka njengetende lokuhlala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.22",
            "verseOrgIds": [
              "ISA.40.22"
            ]
          }
        }
      ]
