          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usholoni, Jakobe, uthi, Israyeli: Indlela yami isithekile kuJehova, nokulunga kwami kudlulile kuNkulunkulu wami?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.27",
            "verseOrgIds": [
              "ISA.40.27"
            ]
          }
        }
      ]
    },
