              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngubani phakathi kwabo bonke onkulunkulu balawa mazwe abasindise izwe labo esandleni sami, ukuba uJehova asindise iJerusalema esandleni sami na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.20",
            "verseOrgIds": [
