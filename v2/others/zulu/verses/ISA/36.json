          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaphelani ukuba uHezekiya anganiyengi ngokuthi: ‘UJehova uyakusisindisa. Onkulunkulu bezizwe walisindisa yini izwe lakhe esandleni senkosi yase-Asiriya na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.18",
            "verseOrgIds": [
              "ISA.36.18"
            ]
          }
        }
      ]
