          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baphi onkulunkulu baseHamati nase-Arfadi na? baphi onkulunkulu baseSefarivayimi na? balikhulule iSamariya esandleni sami na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.19",
            "verseOrgIds": [
              "ISA.36.19"
            ]
          }
        }
