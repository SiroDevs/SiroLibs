            "verseOrgIds": [
              "ISA.49.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 49:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba incithakalo yakho nezindawo zakho eziyincithakalo nezwe lakho eliyincithakalo liyoba ncane kakhulu ngisho namanje ngenxa yabakhileyo, nalabo abakushwabadelayo bayoba kude.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.19",
            "verseOrgIds": [
              "ISA.49.19"
            ]
          }
        }
      ]
    },
    {
