          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa isho kanje iNkosi, ithi: Ngisho nabathunjwa babanamandla bayothathwa, futhi impango yowesabekayo iyosindiswa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.25",
            "verseOrgIds": [
              "ISA.49.25"
            ]
