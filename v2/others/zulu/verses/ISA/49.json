          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impango iyothathwa yini kwabanamandla, noma isiboshwa esisemthethweni sisindiswe?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.24",
            "verseOrgIds": [
              "ISA.49.24"
            ]
          }
