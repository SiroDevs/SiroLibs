              "ISA.49.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakuthi enhliziyweni yakho: Ngubani ongizalele lokhu, mina ngilahlekelwe ngabantwana bami, ngilahliwe, ngiyisibotshwa njalo ngizulazula? futhi ubani oveze lokhu? Bheka, ngisele ngedwa; laba, bebekuphi na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.21",
            "verseOrgIds": [
              "ISA.49.21"
            ]
          }
        }
      ]
