          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 49:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana oyakuba nabo, emva kokuba ulahlekelwe ngomunye, bayophinde bathi phambi kwezindlebe zakho: Indawo incane kakhulu kimi; nginike indawo yokuhlala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.20",
            "verseOrgIds": [
              "ISA.49.20"
            ]
          }
        }
      ]
    },
