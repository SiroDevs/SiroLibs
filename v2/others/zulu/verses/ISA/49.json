            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 49:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phakamisa amehlo akho nxazonke, ubone: bonke bayabuthana, beza kuwe. Kuphila kwami,” usho uJehova, “ufanele ugqokise bonke njengemvunulo, uzibophe kuwe njengomlobokazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.18",
            "verseOrgIds": [
              "ISA.49.18"
            ]
          }
        }
      ]
