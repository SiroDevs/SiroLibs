          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhosi ayakuba ngoyise, nezindlovukazi zabo zibe ngonyoko; bayakukhothama phambi kwakho ubuso babo bubheke phansi, bakhothe uthuli ezinyaweni zakho; futhi niyokwazi ukuthi nginguJehova, ngoba abalindele kimi ngeke babe namahloni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.49.23",
            "verseOrgIds": [
              "ISA.49.23"
            ]
          }
        }
      ]
