          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba itsho njalo iN kosi kimi: Ngizaphumula, futhi ngizalalela endaweni yami yokuhlala njengokutshisa okutshisayo phezu kwemifino, lanjengeyezi lamazolo ekushiseni kokuvuna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        }
      ]
