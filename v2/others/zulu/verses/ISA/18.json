          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nina nonke enakhileyo emhlabeni nabakhileyo emhlabeni, bhekani lapho ephakamisa ibhanela ezintabeni; futhi lapho eshaya icilongo, uyezwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        }
      ]
