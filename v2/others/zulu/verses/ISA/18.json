            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngaphambi kokuvuna, lapho ihlumela seliphelele futhi izithelo zomvini ezimuncu sezivuthiwe embalini, kumelwe anqume amagatsha ngemimese yokuthena imithi futhi asuse amagatsha futhi awanqume.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        }
