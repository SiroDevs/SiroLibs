          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "othuma izithunywa ngasolwandle, yebo, ngezimbiza zomhlanga phezu kwamanzi, ukuthi: Hambani, nina zithunywa ezinejubane, esizweni esihlakazekile nesihlukene phakathi, kubantu abesabekayo kusukela ekuqaleni kuze kube manje; isizwe esilinganisiwe, esinyathelweyo, esilizwe laso imifula yalichitha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
