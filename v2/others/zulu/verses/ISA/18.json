          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakushiyelwa ndawonye abe izinyoni zezintaba nezilwane zomhlaba, izinyoni ziyakuba phezu kwawo ehlobo, nezilwane zonke zomhlaba zingene ebusika phezu kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
