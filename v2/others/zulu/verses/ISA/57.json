            "number": "15",
            "style": "v",
            "sid": "ISA 57:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba usho kanje oPhezukonke, ohlala phakade, ogama lakhe lingcwele; ngihlala phezulu nasendlini engcwele, ngikanye nabadabukileyo komoya othobekileyo, ukuvuselela umoya wabathobekileyo, ngivuselele inhliziyo yabadabukileyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
