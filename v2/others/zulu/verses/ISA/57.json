          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngathukuthela ngobubi bokuhaha kwakhe, ngamshaya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        }
