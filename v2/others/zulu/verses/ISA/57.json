          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 57:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngeke ngilwe ingunaphakade, futhi ngeke ngihlale ngithukuthele, ngokuba umoya uyohluleka phambi kwami kanye nemiphefumulo engiyenzile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
