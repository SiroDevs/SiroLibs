      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 54:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.15",
            "verseOrgIds": [
              "ISA.54.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 54:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngadala umkhandi wensimbi ofutha amalahle emlilweni, akhiqize ithuluzi lomsebenzi wakhe; futhi ngadala umchithi ukuba abhubhise.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.16",
            "verseOrgIds": [
              "ISA.54.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 54:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.16",
            "verseOrgIds": [
              "ISA.54.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 54:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asikho isikhali esenzelwa wena esiyophumelela; nalo lonke ulimi olukuvukelayo ekwahluleleni kumelwe ululahle. Leli yifa lezinceku zikaJehova, nokulunga kwazo okuvela kimi,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.17",
            "verseOrgIds": [
              "ISA.54.17"
            ]
          }
        }
      ]
    }
