          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba amanzi aseDimoni ayakugcwala igazi, ngokuba ngiyakwehlisela okwengeziwe phezu kweDimoni, izingonyama phezu kwabaphunyukileyo bakwaMowabi, naphezu kwensali yezwe.",
          "type": "text",
