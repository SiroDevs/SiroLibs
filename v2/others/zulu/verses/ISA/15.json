              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiprofetho ngoMowabi. Ngokuba ebusuku i-Ari lakwaMowabi liyachithwa, lithulisiwe; ngoba ebusuku iKiri lakwaMowabi liyachithwa, lithulisiwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
