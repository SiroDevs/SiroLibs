          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inhliziyo yami izokhalela uMowabi; ababaleki bakhe bayakubalekela eSowari, ithokazi elineminyaka emithathu; ngoba endleleni yaseHoronayimi bayakumemeza ukukhala kwencithakalo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
