          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba isililo sazungeza imikhawulo yakwaMowabi; ukukhala kwakhe kwaze kwaba se-Eglayimi, nokukhala kwakhe kwaze kwaba seBerelimi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.8",
            "verseOrgIds": [
              "ISA.15.8"
            ]
