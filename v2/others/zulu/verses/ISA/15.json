          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke inala abayitholile abayibeke emthonjeni weminyezane bayakumuka nayo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.7",
            "verseOrgIds": [
              "ISA.15.7"
            ]
          }
        }
