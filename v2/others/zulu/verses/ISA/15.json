            "sid": "ISA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "IHeshiboni liyakubiza, ne-Elale; izwi labo liyozwakala kuze kufike eJahazi; ngakho-ke ibutho lakwaMowabi liyakukhala; ukuphila kwakhe kuyoba nzima kuye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
