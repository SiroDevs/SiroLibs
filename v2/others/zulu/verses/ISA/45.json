          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani Kimi, nisindiswe, nonke mikhawulo yomhlaba, ngokuba nginguNkulunkulu, akakho omunye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.22",
            "verseOrgIds": [
              "ISA.45.22"
            ]
          }
        }
      ]
    },
