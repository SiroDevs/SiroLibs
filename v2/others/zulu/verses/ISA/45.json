          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizifungile mina, izwi liphumile emlonyeni wami ngokulunga, aliyikubuya, ukuthi kimi amadolo onke ayakuguqa, nezilimi zonke ziyakufunga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.23",
            "verseOrgIds": [
              "ISA.45.23"
            ]
          }
        }
