          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba usho kanje uJehova owadala izulu, uthi: “UNkulunkulu uqobo lwakhe owabumba nowenza umhlaba; Waliqinisa, engadalelwanga ize, walibumba ukuba kuhlalwe kulo. NginguJehova; futhi akekho omunye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.18",
            "verseOrgIds": [
              "ISA.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
