          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "NgoJehova yonke inzalo ka-Israyeli iyakulungisiswa futhi ikhazinyuliswe.",
          "type": "text",
