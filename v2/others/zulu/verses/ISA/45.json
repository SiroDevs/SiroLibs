            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuluma lokhu futhi ubasondeze; yebo, mabacebisane kanyekanye: Ngubani owashumayela lokhu kwasendulo na? ubani owakutshela kusukela lapho? Angithi mina uJehova? futhi akakho omunye uNkulunkulu ngaphandle kwami; uNkulunkulu olungileyo noMsindisi; akakho omunye ngaphandle kwami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.21",
            "verseOrgIds": [
              "ISA.45.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
