        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.19",
            "verseOrgIds": [
              "ISA.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buthanani nize; sondelani kanyekanye nina enibalekele ezizweni!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.20",
            "verseOrgIds": [
              "ISA.45.20"
            ]
          }
        }
      ]
    },
    {
