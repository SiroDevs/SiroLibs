            "number": "24",
            "style": "v",
            "sid": "ISA 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impela omunye uyakuthi: “KuJehova nginokulunga namandla; kuye abantu bayokuza; bonke abamthukuthelele bayakujabha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.24",
            "verseOrgIds": [
              "ISA.45.24"
            ]
          }
        }
      ]
