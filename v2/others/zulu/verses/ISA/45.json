  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "ISA 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova kogcotshiweyo wakhe, kuKoresi, osandla sakhe sokunene ngisibambile, ukuba ngehlisele izizwe phambi kwakhe; futhi ngiyothukulula izinkalo zamakhosi ukuze ngivule amasango amabili phambi kwayo; namasango awayikuvalwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.1",
            "verseOrgIds": [
              "ISA.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngizohamba phambi kwakho futhi ngiqondise izindawo ezigwegwile; ngizaphahlaza amasango ethusi, ngiphule imigoqo yensimbi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.2",
            "verseOrgIds": [
              "ISA.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyakukunika ingcebo yasebumnyameni nengcebo efihliweyo ezindaweni zokucasha, ukuze wazi ukuthi mina Jehova okubiza ngegama lakho, nginguNkulunkulu ka-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.3",
            "verseOrgIds": [
              "ISA.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa kaJakobe, inceku yami, no-Israyeli, abakhethiweyo bami, ngikubizile ngegama lakho; Ngikubize ngeziteketiso, nakuba ungangazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.4",
            "verseOrgIds": [
              "ISA.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "NginguJehova, akakho omunye, akakho uNkulunkulu ngaphandle kwami; Ngikubhincile, nakuba ningangazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.5",
            "verseOrgIds": [
              "ISA.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuze bazi kusukela empumalanga nasentshonalanga ukuthi akakho omunye ngaphandle kwami. NginguJehova, akakho omunye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.6",
            "verseOrgIds": [
              "ISA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.6",
            "verseOrgIds": [
              "ISA.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina ngakha ukukhanya, ngidala ubumnyama; Ngenza ukuthula, ngidala ububi; Mina Jehova ngenza zonke lezi zinto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehlani, mazulu, phezulu, izulu linise ukulunga; Mina, Jehova, ngikudalile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.8",
            "verseOrgIds": [
              "ISA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.8",
            "verseOrgIds": [
              "ISA.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maye kulowo oxabana noMenzi wakhe! Izindengezi maziphikisana nezindengezi zomhlaba. Ubumba luthi kumbumbi walo: Wenzani na? noma umsebenzi wakho, Akanazandla na?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.9",
            "verseOrgIds": [
              "ISA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.9",
            "verseOrgIds": [
              "ISA.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo kuye othi kuyise: Uzalani na? noma kowesifazane: “Ubeletheni na?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.10",
            "verseOrgIds": [
              "ISA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.10",
            "verseOrgIds": [
              "ISA.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, oNgcwele ka-Israyeli, uMenzi wakhe, uthi: Ngibuzeni ngokuzayo ngamadodana ami, ningiyale ngomsebenzi wezandla zami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.11",
            "verseOrgIds": [
              "ISA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.11",
            "verseOrgIds": [
              "ISA.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina ngenza umhlaba, ngadala abantu phezu kwawo; Mina, izandla zami, ngelula izulu, futhi ngayala wonke amabutho awo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.12",
            "verseOrgIds": [
              "ISA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.12",
            "verseOrgIds": [
              "ISA.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngimvusile ngokulunga, ngizaqondisa zonke izindlela zakhe; uyakwakha umuzi wami, akhulule iziboshwa zami, kungabi ngenani, kungabi ngenzuzo, usho uJehova Sebawoti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.13",
            "verseOrgIds": [
              "ISA.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usho kanje uJehova, uthi: “Umsebenzi waseGibithe nempahla ethengiswayo yaseKushe neyamaSheba, abantu abade, kuyakufika kuwe, kube okwakho; bayakuza emva kwakho; bayakuza kuwe beboshwe ngamaketanga; bayokuncenga bathi: Ngempela, uNkulunkulu ukuwe; futhi akakho omunye, akakho uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.14",
            "verseOrgIds": [
              "ISA.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impela wena unguNkulunkulu ozifihlayo, Nkulunkulu ka-Israyeli, uMhlengi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.15",
            "verseOrgIds": [
              "ISA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.15",
            "verseOrgIds": [
              "ISA.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayokuma benamahloni futhi beme benamahloni, bonke;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.16",
            "verseOrgIds": [
              "ISA.45.16"
            ]
          }
        }
      ]
    },
    {
