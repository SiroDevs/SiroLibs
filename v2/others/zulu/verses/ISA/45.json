      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.16",
            "verseOrgIds": [
              "ISA.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha u-Israyeli uyakusindiswa ngoJehova ngensindiso yaphakade;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.17",
            "verseOrgIds": [
              "ISA.45.17"
            ]
          }
        }
      ]
    },
    {
