            "sid": "ISA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku niyakuthi: Dumisani uJehova, nibize igama lakhe, nimemezele izenzo zakhe phakathi kwezizwe, nisho ukuthi igama lakhe liphakeme.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
