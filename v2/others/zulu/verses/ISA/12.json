            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolosuku uyakuthi: Jehova, ngiyakukubonga; nakuba wawungithukuthelele, intukuthelo yakho yaphenduka futhi wangiduduza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
