          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memeza ujabule, wena owakhileyo eSiyoni, ngokuba mkhulu oNgcwele ka-Israyeli ophakathi kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
