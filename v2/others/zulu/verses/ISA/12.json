        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hlabelelani inkazimulo kaJehova; ngoba wenzile izinto ezinhle kakhulu; kuyaziwa emhlabeni wonke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        }
      ]
