        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wabayisa kude abantu, kwaba khona incithakalo enkulu phakathi nezwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.12",
            "verseOrgIds": [
              "ISA.6.12"
            ]
          }
        }
      ]
    },
