              "ISA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuzakuba khona okwetshumi kulo, njalo lizabuya lidliwe: njengesihlahla setiye lanjengesihlahla se-okhi esiluthuli lwaso lapho sivuthulula amahlamvu awo; kanjalo inzalo engcwele iyakuba yimpahla yayo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
