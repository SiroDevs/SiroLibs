            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Landizela kimi elinye lamaserafi liphethe ilahle elivuthayo esandleni salo, elalilithatha ngodlawu e-altare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
