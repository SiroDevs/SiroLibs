          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasibeka emlonyeni wami, yathi: “Bheka, isithinte izindebe zakho; ububi bakho sebususiwe, nesono sakho siyahlanjululwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        }
      ]
    },
    {
