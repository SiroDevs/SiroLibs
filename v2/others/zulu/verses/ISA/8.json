          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho bheka, uJehova ubangela ukuba amanzi omfula, anamandla, maningi, enyukele phezu kwabo, inkosi yase-Asiriya nobukhosi bayo bonke; iyakwenyukela ezinqenqemeni zalo zonke, idabule lonke usebe lwalo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
