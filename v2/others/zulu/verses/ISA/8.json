          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uJehova wathi kimi: “Zithathele umqulu omkhulu, ulobe kuwo ngosiba lomuntu ngokuthi iMahersalhasbas.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngithathela ofakazi bami abathembekileyo ukuba babhale, u-Uriya umpristi noZakariya indodana kaJeberekiya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
