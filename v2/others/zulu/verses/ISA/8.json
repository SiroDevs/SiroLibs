          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningasho ukuthi: “Isivumelwano kubo bonke laba bantu abasho kubo ukuthi: ‘Isivumelwano;’ futhi ningesabi ukwesaba kwabo, futhi ningesabi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
