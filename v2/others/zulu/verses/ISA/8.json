          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uJehova wakhuluma kanje kimi ngesandla esinamandla, wangiyala ukuba ngingahambi ngendlela yalaba bantu, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
            "verseOrgIds": [
              "ISA.8.11"
            ]
          }
        }
      ]
