              "ISA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyanicela, nina bantu, niyophihlizwa; futhi nilalele, nonke mazwe akude; bhincani, niyakuchotshozwa; bhincani, niyochotshozwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
