              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyakuphakamisela izizwe ezikude ibhanela, izishayele ikhwelo ezivela emikhawulweni yomhlaba; futhi bheka, bazofika ngokushesha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.26",
