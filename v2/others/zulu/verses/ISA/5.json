        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.13",
            "verseOrgIds": [
              "ISA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke indawo yabafileyo yalikhulisa futhi yavula umlomo walo ngokungenasilinganiso, futhi inkazimulo yabo nesixuku sabo nobuhle babo kanye nojabulayo bayokwehlela kuso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.14",
            "verseOrgIds": [
              "ISA.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.14",
            "verseOrgIds": [
              "ISA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi umuntu ophansi uyophonswa phansi, futhi iqhawe liyothotshiswa, futhi amehlo abaphakeme ayothotshiswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.15",
            "verseOrgIds": [
              "ISA.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
