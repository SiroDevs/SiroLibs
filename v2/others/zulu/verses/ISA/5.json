        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungakho abantu bami baya ekudingisweni, ngokuba bengenalwazi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.13",
            "verseOrgIds": [
              "ISA.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
