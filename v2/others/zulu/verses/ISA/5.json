            "sid": "ISA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke amawundlu ayoklaba ngendlela yawo, futhi izincithakalo zamanoni ziyodla abezizwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
            "verseOrgIds": [
              "ISA.5.17"
            ]
          }
        }
      ]
    },
