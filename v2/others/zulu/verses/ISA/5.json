          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.15",
            "verseOrgIds": [
              "ISA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJehova Sebawoti uyophakanyiswa ekwahluleleni, futhi uNkulunkulu ongcwele uyongcweliswa ngokulunga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.16",
            "verseOrgIds": [
              "ISA.5.16"
            ]
          }
        }
      ]
    },
    {
