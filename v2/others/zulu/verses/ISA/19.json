              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku kuyakuba khona i-altare likaJehova phakathi kwezwe laseGibithe, netshe lesikhumbuzo kuJehova emngceleni walo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
