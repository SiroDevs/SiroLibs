            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalolo suku imizi emihlanu ezweni laseGibithe iyakukhuluma ulimi lwaseKhanani, ifunge uJehova Sebawoti; omunye uyakuthiwa: uMuzi Wokubhujiswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
