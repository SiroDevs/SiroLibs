              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova uyakulishaya iGibithe; Uyoyishaya futhi ayiphulukise; futhi bayobuyela kuJehova, futhi uyobazwa futhi abaphulukise.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
