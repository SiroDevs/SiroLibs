              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, ukube ubuyilalele imiyalo yami! ukuthula kwakho kwaba njengomfula, nokulunga kwakho njengamagagasi olwandle;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
