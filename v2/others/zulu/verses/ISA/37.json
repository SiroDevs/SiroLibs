              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.18",
            "verseOrgIds": [
              "ISA.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "babaphonsa emlilweni onkulunkulu bawo, ngokuba babengesibo onkulunkulu, babengumsebenzi wezandla zomuntu, ukhuni netshe; ngalokho babachitha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.19",
            "verseOrgIds": [
              "ISA.37.19"
            ]
          }
        }
      ]
    },
    {
