            "number": "18",
            "style": "v",
            "sid": "ISA 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impela, Jehova, amakhosi ase-Asiriya azichithile zonke izizwe namazwe azo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.18",
            "verseOrgIds": [
              "ISA.37.18"
            ]
          }
        }
      ]
