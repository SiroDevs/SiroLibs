            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.14",
            "verseOrgIds": [
              "ISA.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho, isikhova esikhulu siyakwakha isidleke saso, sizalele, sichanyuselwe, sibuthele phansi komthunzi waso; kuyakubuthana amanqe, kube yilowo nalowo nomngane wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.15",
            "verseOrgIds": [
              "ISA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.15",
            "verseOrgIds": [
              "ISA.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funani incwadi kaJehova, nifunde; ngokuba umlomo wami uyakuyala, nomoya wakhe ukubuthile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.16",
            "verseOrgIds": [
              "ISA.34.16"
            ]
          }
        }
      ]
    },
    {
