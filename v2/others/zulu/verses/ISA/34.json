          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.13",
            "verseOrgIds": [
              "ISA.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izilo zasendle zasogwadule nazo ziyohlangana nezilo zasendle zesiqhingi, nombusi uyobiza umngane wakhe; nesikhova siyophumula khona simtholele indawo yokuphumula.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.14",
            "verseOrgIds": [
              "ISA.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 34:14"
          },
          "items": [
            {
              "text": "14",
