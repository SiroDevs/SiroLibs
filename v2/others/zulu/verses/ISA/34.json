          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.16",
            "verseOrgIds": [
              "ISA.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wawenzela inkatho, isandla sakhe sawahlukanisela wona ngomucu wokulinganisa; bayakulidla kuze kube phakade, bahlale kulo izizukulwane ngezizukulwane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.17",
            "verseOrgIds": [
              "ISA.34.17"
            ]
          }
        }
      ]
    }
