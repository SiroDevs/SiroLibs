            "number": "1",
            "style": "v",
            "sid": "ISA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sondelani nina zizwe, nizwe; nilalele nina zizwe! umhlaba mawuzwe nakho konke okukuwo; umhlaba nakho konke okuvela kuwo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba intukuthelo kaJehova iphezu kwezizwe zonke, nentukuthelo yakhe iphezu kwawo wonke amabutho azo; Wabashaya ngesiqalekiso, Wabanikela ekuhlatshweni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi labo ababulewe bayokhishelwa ngaphandle, futhi ukunuka kwabo kuyokhuphuka ezidunjini zabo, futhi izintaba ziyoncibilika ngegazi labo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lonke ibutho lezulu lizabhubha, lezulu lizagoqwa njengomqulu, lebutho lonke lalo lizawa njengehlamvu eliwa emvinini, lanjengekhiwane eliwa emkhiwaneni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba inkemba yami iyogezwa ezulwini; bheka, liyokwehlela phezu kwe-Idumiya naphezu kwabantu besiqalekiso sami, kube ukwahlulelwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkemba kaJehova igcwele igazi, ikhuluphaliswe ngamanoni, nangegazi lamawundlu nelezimbuzi, namanoni ezinso zezinqama; ngoba uJehova unomhlatshelo eBhozira nokuhlaba okukhulu ezweni lakwa-Idumiya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyathi ziyakwehla kanye nazo, nezinkunzi kanye nezinkunzi; izwe labo liyakugcwala igazi, uthuli lwabo lukhuluphele ngamanoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba lolu wusuku lwempindiselo kaJehova nomnyaka wokuphindisela ngokuxabana kweSiyoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imifudlana yalo iyophendulwa ikolitayi nothuli lwalo lube yisibabule, izwe lalo libe yikolitayi elivuthayo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeke ucinywe ubusuku nemini; intuthu yalo iyakukhuphuka kuze kube phakade; liyincithakalo ezizukulwaneni ngezizukulwane; akekho oyodabula kukho kuze kube phakade naphakade.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa inkalakatha nenyongo bayokudla ifa; isikhova negwababa kuyohlala kulo, futhi uyokwendlala phezu kwalo isikela lesiyaluyalu namatshe okuyize.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayakubizela izikhulu zalo embusweni, kepha akuyikubakho muntu lapho, nazo zonke izikhulu zalo ziyakuba yize.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.12",
            "verseOrgIds": [
              "ISA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.12",
            "verseOrgIds": [
              "ISA.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyovela ameva ezindlini zakhe zobukhosi, izimbabazane nameva ezinqabeni zakhe, kube yindawo yokuhlala yezimpungushe negceke lezikhova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.13",
            "verseOrgIds": [
              "ISA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
