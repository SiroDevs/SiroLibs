            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.10",
            "verseOrgIds": [
              "ISA.61.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 61:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba njengalokhu umhlaba uthela imbewu yawo, nanjengensimu ehlwanyelwe kuwo iwuhlumisa; kanjalo iNkosi uJehova iyakwenza ukuba kuhlume ubulungisa nodumo phambi kwezizwe zonke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.11",
            "verseOrgIds": [
              "ISA.61.11"
            ]
          }
        }
      ]
