              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Baboneni endlini yakho na?” UHezekiya wathi: “Bakubonile konke okusendlini yami; akukho lutho phakathi kwengcebo yami engingababonisanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
