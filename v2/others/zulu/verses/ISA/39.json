          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emadodaneni akho ayakuphuma kuwe, oyakuwazala, uyakuwasusa; futhi bayoba ngabathenwa esigodlweni senkosi yaseBhabhiloni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
