            }
          ]
        },
        {
          "text": "Ngaleso sikhathi uMerodagi Baladani indodana kaBaladani inkosi yaseBabele wathumela izincwadi nezipho kuHezekiya, ngokuba wayezwile ukuthi wayegula, wasinda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.1",
            "verseOrgIds": [
              "ISA.39.1"
            ]
          }
        }
      ]
