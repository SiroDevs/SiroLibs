              "ISA.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UHezekiya wathokoza ngabo, wababonisa indlu yengcebo yakhe, isiliva, negolide, namakha, namafutha amahle, nayo yonke indlu yezikhali zakhe, nakho konke okwakutholakala engcebweni yakhe. Akubangakho lutho endlini yakhe nasekubuseni kwakhe konke uHezekiya angabavumelanga ukuba bakubone.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.2",
            "verseOrgIds": [
              "ISA.39.2"
            ]
          }
        }
      ]
    },
    {
