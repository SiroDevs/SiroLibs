            "number": "5",
            "style": "v",
            "sid": "ISA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi u-Isaya kuHezekiya: “Yizwa izwi likaJehova Sebawoti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
