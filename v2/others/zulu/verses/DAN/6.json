          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke inkosi yajabula kakhulu ngaye, yayala ukuba bamkhiphe uDaniyeli emgodini. UDaniyeli wakhishwa emgodini, akwafunyanwa ububi kuye, ngokuba wayekholwa kuNkulunkulu wakhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        }
      ]
    },
    {
