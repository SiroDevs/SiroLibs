          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yayisingena endlini yayo, yachitha ubusuku izila ukudla; alethwanga izinsimbi zomculo phambi kwakhe, ubuthongo bakhe bamuka kuye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.18",
            "verseOrgIds": [
