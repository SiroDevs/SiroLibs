          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyahlenga, asindise, wenza izibonakaliso nezimangaliso ezulwini nasemhlabeni, owakhulula uDaniyeli emandleni ezingonyama.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.27",
            "verseOrgIds": [
              "DAN.6.27"
            ]
