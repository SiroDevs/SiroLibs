          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDariyu inkosi wayeselobela bonke abantu, nezizwe, nezilimi ezikhona emhlabeni wonke; Ukuthula kuphindaphindwe kuwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        }
