          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDaniyeli wasesithi enkosini: O nkosi, phila kuze kube nininini!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.21",
            "verseOrgIds": [
              "DAN.6.21"
            ]
          }
        }
