          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke inkosi yavuka ekuseni kakhulu yaphuthuma emphandwini wezingonyama.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.19",
            "verseOrgIds": [
              "DAN.6.19"
