            "number": "20",
            "style": "v",
            "sid": "DAN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho ifika emgodini, yakhala kuDaniyeli ngesililo; inkosi yakhuluma, yathi kuDaniyeli: “Daniyeli, nceku kaNkulunkulu ophilayo, uNkulunkulu wakho omkhonza njalo unamandla okukophula ezingonyameni na?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.20",
            "verseOrgIds": [
              "DAN.6.20"
            ]
          }
        }
      ]
    },
    {
