        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasilaya, alethwa amadoda ayemangalele uDaniyeli, awaphosela emphandwini wezingonyama, wona, nabantwana bawo, nawomkawo; amabhubesi ababamba, bawaphula onke amathambo abo, noma baze bafika phansi emgodini.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.24",
            "verseOrgIds": [
              "DAN.6.24"
            ]
          }
        }
      ]
    },
