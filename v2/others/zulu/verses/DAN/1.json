          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uMelzari wathatha ingxenye yenyama yabo newayini ababenalo ukuze baliphuze; futhi wanikeza umphefumulo wabo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        }
