            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yasikhuluma ku-Aspenasi induna yabathenwa bakhe ukuthi alethe abanye babantwana bakoIsrayeli labenzalo yenkosi leyeziphathamandla;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantwana abangenasici kubo, kodwa abathandekayo nabanamandla kukho konke ukuhlakanipha nobuqili olwazini nasekuqondeni kwesayensi, ababenamandla okuma esigodlweni senkosi, ababengafundisa kubo ukufunda nolimi lamaKaledi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yababekela isabelo semihla ngemihla sokudla kwenkosi nesewayini eliphuzayo; ngakho wabapha ukudla iminyaka emithathu, ukuze ekupheleni kwayo beme phambi kwenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phakathi kwabo kwakukhona kubantwana bakwaJuda, uDaniyeli, noHananiya, noMishayeli, no-Azariya;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yabathenwa yabaqamba amagama, ngokuba yaqamba uDaniyeli ngokuthi uBelitshasari; noHananiya kaShadiraki; noMishayeli kaMeshaki; no-Azariya, ku-Abhedinego.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uDaniyeli wanquma enhliziyweni yakhe ukuthi angazingcolisi ngokudla kwenkosi nangewayini aliphuzayo; ngakho wacela induna yenkundla ukuthi ingamngcolisi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
