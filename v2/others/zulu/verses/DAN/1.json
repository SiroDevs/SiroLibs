          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Induna yabalindi yathi kuDaniyeli: “Ngiyayesaba inkosi yami, inkosi, emisile ukudla kwenu nesiphuzo senu; khona-ke kumelwe ubeke ikhanda lami engozini ngenxa yenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke uDaniyeli wathi kuMelzari owabeka induna yezikhulu phezu kukaDaniyeli, uHananiya, uMishayeli no-Azariya:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
