            "sid": "DAN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngomnyaka wesithathu wokubusa kukaJehoyakimi inkosi yakwaJuda, uNebukadinesari, inkosi yaseBabele, wafika eJerusalema walivimbezela.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        }
      ]
    },
    {
