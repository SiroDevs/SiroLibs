              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma kunjalo, uNkulunkulu wethu osikhonzayo angasikhulula esithandweni somlilo ovuthayo, asikhulule esandleni sakho, nkosi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.17",
            "verseOrgIds": [
              "DAN.3.17"
            ]
          }
        }
