            "sid": "DAN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke la madoda aboshwa egqoke izingubo zawo, amabhulukwe nezigqoko nezinye izingubo zawo, aphonswa phakathi kwesithando somlilo ovuthayo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.21",
