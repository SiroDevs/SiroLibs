            "sid": "DAN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungakho amaKaledi athile asondela ngaleso sikhathi asola amaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.8",
            "verseOrgIds": [
              "DAN.3.8"
            ]
          }
        }
      ]
