          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNebukadinesari wakhuluma, wathi: “Makatuswe uNkulunkulu kaShadiraki, uMeshaki no-Abedi Nego, othume ingelosi yakhe, wakhulula izinceku zakhe ezimethembayo, waguqula izwi lenkosi, wakhulula imizimba yazo, ukuze bangamkhonzi, bakhulekele noma yimuphi unkulunkulu. Kodwa uNkulunkulu wabo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.28",
            "verseOrgIds": [
              "DAN.3.28"
            ]
          }
        }
      ]
