            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukhona abaJuda abathile owabeke phezu kwezindaba zesifunda saseBabele, oShadiraki, noMeshaki, no-Abhedinego; Lawa madoda, nkosi, awakunakanga; azikhonzi onkulunkulu bakho, azikhuleki esithombeni segolide osimisileyo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        }
      ]
    },
    {
