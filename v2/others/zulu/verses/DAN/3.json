            "sid": "DAN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNebukadinesari wayala ngokuthukuthela nangokufutheka ukuba kulethwe oShadiraki, noMeshaki, no-Abhedinego. Base beletha lawa madoda phambi kwenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.13",
            "verseOrgIds": [
              "DAN.3.13"
            ]
          }
        }
      ]
    },
    {
