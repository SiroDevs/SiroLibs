              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yayisikhulisa oShadiraki, noMeshaki, no-Abhedinego esifundeni saseBabele.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.30",
