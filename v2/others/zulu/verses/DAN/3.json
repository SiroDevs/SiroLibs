          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNebukadinesari wakhuluma kubo, wathi: “Kuyiqiniso yini, Shadiraki, Meshaki, no-Abedi Nego, ukuthi anibakhonzi onkulunkulu bami, anikhuleki esithombeni segolide engisimisileyo na?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.14",
            "verseOrgIds": [
              "DAN.3.14"
            ]
          }
        }
      ]
    },
