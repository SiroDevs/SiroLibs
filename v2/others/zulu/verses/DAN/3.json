          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayala amaqhawe ayesempini yakhe ukuba abophe oShadiraki, noMeshaki, no-Abhedinego, abaphonse esithandweni somlilo ovuthayo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.20",
