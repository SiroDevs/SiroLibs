            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma kungenjalo, makwazeke kuwe, nkosi, ukuthi asiyikukhonza onkulunkulu bakho, sikhuleke esithombeni segolide osimisileyo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
