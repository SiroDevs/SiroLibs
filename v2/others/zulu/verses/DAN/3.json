          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena, nkosi, ukhiphe isimemezelo sokuthi wonke umuntu ozwa ukukhala kwecilongo, negenkle, nehabhu, nehabhu, nehabhu, nehabhu, nazo zonke izinhlobo zezinsimbi zokubethwa, makawe phansi, akhuleke esithombeni segolide.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
