          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawa madoda amathathu, oShadiraki, noMeshaki, no-Abhedinego, awela eboshwe izandla phakathi kwesithando somlilo ovuthayo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        }
      ]
    },
    {
