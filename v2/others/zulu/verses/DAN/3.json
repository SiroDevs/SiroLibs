          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waphendula wathi: “Bheka, ngibona amadoda amane ehamba phakathi komlilo, awalimalanga; nesimo sesine sinjengeNdodana kaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        }
      ]
