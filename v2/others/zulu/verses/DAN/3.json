        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona uNebukadinesari wagcwala intukuthelo, nesimo sobuso bakhe sashintsha kuShadiraki, noMeshaki, no-Abhedinego; ngakho-ke wakhuluma futhi wayala ukuthi isithando somlilo kufanele sibase ngokuphindwe kasikhombisa kunalokho esijwayele ukushiswa ngaso.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.19",
            "verseOrgIds": [
              "DAN.3.19"
            ]
          }
        }
      ]
    },
    {
