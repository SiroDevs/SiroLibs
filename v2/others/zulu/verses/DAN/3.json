          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi lapho senilungile ngesikhathi enizwa ngaso ukukhala kwecilongo, negenkle, nehabhu, nehabhu, nehabhu, nehabhu, nempumputhe, nazo zonke izinhlobo zezinsimbi zomculo, niwela phansi nikhuleke esithombeni engiwenzile; yebo, kodwa uma ningakhuleki, ngaso leso sikhathi niyophonswa phakathi kwesithando somlilo esivuthayo; futhi ngubani uNkulunkulu oyakunikhulula esandleni sami na?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.15",
            "verseOrgIds": [
              "DAN.3.15"
            ]
          }
        }
