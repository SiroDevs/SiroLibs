        {
          "text": "Ngenxa yokuhlanganyela kwenu evangelini kusukela osukwini lokuqala kuze kube manje;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.5",
            "verseOrgIds": [
              "PHP.1.5"
