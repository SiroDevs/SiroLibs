              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uNkulunkulu ungumfakazi wami wokuthi ngililangazelela kangakanani lonke ngenhliziyo kaJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
