        {
          "text": "Makube kini umusa nokuthula okuvela kuNkulunkulu uBaba wethu naseNkosini uJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
