              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawulu noThimothewu, izinceku zikaJesu Kristu, kubo bonke abangcwele abakuKristu Jesu abaseFilipi, kanye nababonisi namadiyakoni;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
