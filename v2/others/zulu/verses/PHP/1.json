              "type": "text"
            }
          ]
        },
        {
          "text": "njengokuba kufanele ukuba ngikucabangele lokhu nonke, ngokuba nginenu enhliziyweni yami; njengoba naseziboshweni zami, nasekuvikeleni nasekuqiniseni ivangeli, nina nonke ningabahlanganyeli bomusa wami.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        }
