        {
          "text": "nginethemba lalokho ukuthi owaqala umsebenzi omuhle kinina uyakuwufeza kuze kube lusuku lukaJesu Kristu;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
