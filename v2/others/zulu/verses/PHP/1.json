        {
          "text": "Abazalwane abaningi eNkosini, beqiniseka ngezibopho zami, banesibindi esikhulu kakhulu sokukhuluma izwi ngokungesabi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
