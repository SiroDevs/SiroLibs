        {
          "text": "Kepha ngithanda ukuba nazi, bazalwane, ukuthi okwenzeka kimi kwaphumela ekuqhubekiseleni phambili ivangeli;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
