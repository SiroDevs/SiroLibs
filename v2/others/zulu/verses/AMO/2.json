      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.15",
            "verseOrgIds": [
              "AMO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onesibindi phakathi kwamaqhawe uyobaleka enqunu ngalolo suku,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.16",
            "verseOrgIds": [
              "AMO.2.16"
            ]
          }
        }
      ]
