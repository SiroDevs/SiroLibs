        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.14",
            "verseOrgIds": [
              "AMO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngiyochitha indlu yasebusika kanye nendlu yasehlobo; izindlu zophondo lwendlovu ziyakubhubha, nezindlu ezinkulu ziphele,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.15",
            "verseOrgIds": [
              "AMO.3.15"
            ]
          }
        }
      ]
