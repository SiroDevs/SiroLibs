              "type": "text"
            }
          ]
        },
        {
          "text": "Usuku lukaJehova aluyikuba ngubumnyama, lungabi ngukukhanya na? ngisho emnyama kakhulu futhi akukho ukukhanya kuyo?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.20",
