              "type": "text"
            }
          ]
        },
        {
          "text": "Njengokungathi umuntu ubalekela ingonyama, ahlangane nebhere; noma engena endlini, wancika isandla sakhe odongeni, walunywa yinyoka.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.19",
