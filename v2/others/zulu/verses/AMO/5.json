    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zwanini lelilizwi engiliphakamisa phezu kwenu, isililo, lina ndlu kaIsrayeli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwile intombi yakwa-Israyeli; ngeke lisavuka; washiywa ezweni lakubo; akakho ongamvusa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba isho kanje iNkosi uJehova, ithi: Umuzi owaphuma uyinkulungwane uyakusala uyikhulu, owaphuma unekhulu, uyakusalela indlu ka-Israyeli ishumi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba usho kanje uJehova kuyo indlu yakwa-Israyeli, uthi: “Ngifuneni, nizakuphila;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ningalifuni iBethele, ningangeni eGiligali, ningaweli eBeri Sheba; ngoba iGiligali lizakuya ekuthunjweni, leBhetheli lizabhubha.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funani uJehova, niyakuphila; funa avuthe njengomlilo endlini kaJosefa, awuqede, kungabikho owucimayo eBethele.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena ophendula ukwahlulela kube ngumhlonyane, umise ukulunga emhlabeni,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.7",
            "verseOrgIds": [
              "AMO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.7",
            "verseOrgIds": [
              "AMO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfuneni owenza izinkanyezi eziyisikhombisa ne-Oriyoni, ophendula ithunzi lokufa libe ukusa, afiphaze imini nobusuku, obiza amanzi olwandle, awathululele emhlabeni: nguJehova igama lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaqinisa abaphangiwe kwabanamandla, abaphangiweyo beze bemelene nenqaba.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayamzonda okhuzayo esangweni, bamenyanya okhuluma ukulunga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusukela lapho ninyathela ompofu, nithatha isithungu senu, nakhe izindlu zamatshe abaziweyo, kepha aniyikuhlala kuzo; nitshale izivini ezithandekayo, kepha aniyikuphuza iwayini lazo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiyazazi iziphambeko zenu eziningi nezono zenu ezinamandla;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho abahlakaniphileyo bayakuthula ngalesi sikhathi; ngoba kuyisikhathi esibi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.13",
            "verseOrgIds": [
              "AMO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.13",
            "verseOrgIds": [
              "AMO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funani okuhle, hhayi okubi, ukuze niphile; kanjalo iNkosi, uNkulunkulu Sebawoti, ibe nani, njengalokho nikhulumile.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.14",
            "verseOrgIds": [
              "AMO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.14",
            "verseOrgIds": [
              "AMO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zondani okubi, nithande okuhle, nimise ukulunga esangweni; mhlawumbe uJehova uNkulunkulu Sebawoti uyakuba nomusa kuyo insali kaJosefa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.15",
            "verseOrgIds": [
              "AMO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.15",
            "verseOrgIds": [
              "AMO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho usho kanje uJehova uNkulunkulu Sebawoti, uJehova, uthi: Kuyakuba khona ukulila ezitaladini zonke; futhi kuyo yonke imigwaqo bayothi: Maye! maye! futhi bayobiza umlimi ukuba alile, nalabo abakwaziyo ukusuka ekulileni baye ekulileni.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.16",
            "verseOrgIds": [
              "AMO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.16",
            "verseOrgIds": [
              "AMO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "AMO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonke izivini ziyakukhala, ngokuba ngiyakudabula phakathi kwakho,” usho uJehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.17",
            "verseOrgIds": [
              "AMO.5.17"
            ]
          }
        }
      ]
    },
