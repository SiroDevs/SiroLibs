        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.11",
            "verseOrgIds": [
              "HEB.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi njengesambatho uyakuzisonga, futhi ziyakuguqulwa; kepha wena unjalo, neminyaka yakho ayiyikuphela.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa yiyiphi yezingilosi ake atsho kuyo ukuthi: Hlala ngakwesokunene sami, ngize ngenze izitha zakho zibe yisenabelo senyawo zakho?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        }
      ]
    },
