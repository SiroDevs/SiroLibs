        {
          "text": "Kodwa khuthazanani insuku zonke, kusathiwa Namuhla; hlezi kube khona kini owenziwa lukhuni ngokukhohlisa kwesono.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.13",
