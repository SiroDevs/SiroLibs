              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke, bazalwane abangcwele, eningabahlanganyeli bokubizwa kwasezulwini, cabangani ngomphostoli nomPristi omkhulu wesivumo sethu, uKristu Jesu;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.1",
            "verseOrgIds": [
              "HEB.3.1"
            ]
          }
        }
