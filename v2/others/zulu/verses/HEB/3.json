              "type": "text"
            }
          ]
        },
        {
          "text": "UMose nempela wayethembekile endlini yakhe yonke njengenceku, kube ngubufakazi balokho okwakuzakhulunywa;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.5",
            "verseOrgIds": [
              "HEB.3.5"
            ]
