          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba lo ubalelwe inkazimulo enkulu kunoMose, njengalokhu owakhileyo indlu enodumo olukhulu kunendlu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.3",
            "verseOrgIds": [
              "HEB.3.3"
            ]
