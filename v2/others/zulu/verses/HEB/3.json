          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xwayani, bazalwane, ukuba kungabikho kinina kini inhliziyo embi, engakholwayo, emhlubukisa uNkulunkulu ophilayo.",
          "type": "text",
          "attrs": {
