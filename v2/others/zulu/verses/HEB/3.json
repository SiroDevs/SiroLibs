          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba yileyo naleyondlu yakhiwa ngumuntu; kodwa owakha izinto zonke nguNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.4",
            "verseOrgIds": [
              "HEB.3.4"
            ]
