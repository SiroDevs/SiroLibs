          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke ngaba lusizi ngaleso sizukulwane, ngathi: Bahlala beduka ezinhliziyweni zabo; futhi abazazi izindlela zami.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.10",
            "verseOrgIds": [
              "HEB.3.10"
            ]
