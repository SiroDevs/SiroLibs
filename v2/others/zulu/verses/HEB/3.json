        {
          "text": "Kuthiwa: “Namuhla, uma nilizwa izwi lakhe, ningazenzi lukhuni izinhliziyo zenu njengasekucunuleni;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.15",
