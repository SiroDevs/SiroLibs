          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uKristu njengendodana phezu kwendlu yakhe; esiyindlu yakhe thina, uma sibambisisa isibindi nokuzibonga kwethemba kuze kube sekupheleni.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.6",
            "verseOrgIds": [
              "HEB.3.6"
            ]
