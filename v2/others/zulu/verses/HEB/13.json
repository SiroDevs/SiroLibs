            "sid": "HEB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho masinikele njalonjalo kuNkulunkulu ngaye umhlatshelo wokubonga, okungukuthi isithelo sezindebe ezivuma igama lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.15",
            "verseOrgIds": [
              "HEB.13.15"
            ]
          }
        }
      ]
    },
    {
