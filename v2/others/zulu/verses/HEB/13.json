          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikhulekeleni, ngokuba siyethemba ukuthi sinonembeza omuhle, sithanda ukuhamba kahle ezintweni zonke.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.18",
