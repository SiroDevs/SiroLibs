          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMoya oNgcwele efakaza lokhu, ukuthi indlela eya endaweni engcwele yayingakabonakali, itabernakele lokuqala lisamile;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        }
