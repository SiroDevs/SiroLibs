              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kungengegazi lezimbuzi nelamathole, kodwa ngelakhe igazi wangena kanye nje endaweni engcwele, esizuzele ukukhululwa okuphakade.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
