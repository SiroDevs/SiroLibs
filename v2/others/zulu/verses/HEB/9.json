          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uKristu esefikile engumpristi omkhulu wezinto ezinhle ezizayo, wadabula itabernakele elikhulu neliphelele kakhulu, elingenziwanga ngezandla, okungukuthi elingelona elalesi sakhiwo;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        }
