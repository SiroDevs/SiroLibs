              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba uba igazi lezinkunzi lelezimbuzi lomlotha wethokazi ufafaza abangcolileyo, kungcwelisela ekuhlambululeni inyama;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        }
