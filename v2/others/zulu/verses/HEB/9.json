            "number": "2",
            "style": "v",
            "sid": "HEB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba kwakhiwa itabernakele; eyokuqala okwakukhona kuyo uthi lwesibani, netafula, nezinkwa zokubukwa; okuthiwa ithempeli.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        }
      ]
    },
    {
