          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwakuwumfanekiso walesi sikhathi esikhona, lapho kwanikelwa khona izipho nemihlatshelo, okungekwenze lowo owenza inkonzo aphelele ngokukanembeza;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
