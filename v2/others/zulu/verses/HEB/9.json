          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababemi kuphela ekudleni lekuphuzweni, lokugezisa izinhlobonhlobo, lezimiso zenyama, ababekwe phezu kwabo kuze kufike isikhathi sokuguqulwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
