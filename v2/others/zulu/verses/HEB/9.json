            "number": "4",
            "style": "v",
            "sid": "HEB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyayinomcengezi wegolide wempepho, nomphongolo wesivumelwano unamekwe ngegolide nxazonke, okwakukhona kuwo imbiza yegolide eyayinemana, nenduku ka-Aroni eyahlumayo, nezibhebhe zesivumelwano;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        }
      ]
    },
    {
