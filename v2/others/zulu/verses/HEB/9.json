              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nesivumelwano sokuqala sasinezimiso zenkonzo nendlu engcwele yasezweni.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        }
