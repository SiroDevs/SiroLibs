          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kweyesibili umpristi omkhulu yedwa kungena kanye ngomnyaka, kungeyisikho ngaphandle kwegazi, azinikela ngenxa yakhe langenxa yeziphambeko zabantu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        }
      ]
    },
