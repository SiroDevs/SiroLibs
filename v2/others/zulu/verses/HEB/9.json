        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwesihenqo sesibili kwakukhona itabernakele elithiwa iNgcwelengcwele;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        }
      ]
