              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu kwalokho, inkosi yenza isihlalo sobukhosi esikhulu sezinyo lendlovu yasinameka ngegolide elihle kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
