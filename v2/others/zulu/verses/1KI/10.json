              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkosi yenza isiliva eJerusalema libe njengamatshe, nemisedari yayenza yaba njengemikhiwane esesigodini ngobuningi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
