              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanjalo inkosi uSolomoni yaba ngaphezu kwawo wonke amakhosi omhlaba ngengcebo nokuhlakanipha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
