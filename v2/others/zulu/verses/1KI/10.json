          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahhashi uSolomoni ayenawo aphuma eGibithe nezindwangu zelineni; abathengisi benkosi bamukela ilineni ngentengo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
