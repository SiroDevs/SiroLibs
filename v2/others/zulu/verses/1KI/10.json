          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonke umhlaba wamfuna uSolomoni ukuze uzwe ukuhlakanipha kwakhe uNkulunkulu ayekunikile enhliziyweni yakhe.",
          "type": "text",
