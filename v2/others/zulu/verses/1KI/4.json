          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wayenezikhulu eziyishumi nambili phezu kuka-Israyeli wonke ezazinika inkosi nendlu yayo ukudla; yilowo nalowo wazilungisela inyanga yakhe ngomnyaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.7",
            "verseOrgIds": [
              "1KI.4.7"
            ]
          }
        }
