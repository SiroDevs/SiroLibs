            "number": "5",
            "style": "v",
            "sid": "1KI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Azariya indodana kaNathani wayephezu kwezikhulu, noZabudi indodana kaNathani wayeyinduna enkulu nomngane wenkosi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.5",
            "verseOrgIds": [
              "1KI.4.5"
            ]
          }
        }
      ]
    },
    {
