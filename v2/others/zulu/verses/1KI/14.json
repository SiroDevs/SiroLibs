          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinsuku zokubusa kukaJerobowamu zaziyiminyaka engamashumi amabili nambili; walala koyise, uNadabi indodana yakhe waba yinkosi esikhundleni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.20",
