          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "USolomoni wayeseyakha indlu, wayiqeda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        }
