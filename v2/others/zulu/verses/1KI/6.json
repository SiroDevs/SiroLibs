          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakha indlu, wayiqeda; wayibekela indlu ngemishayo namapulangwe emisedari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
