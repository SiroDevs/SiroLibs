          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika kuSolomoni, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        }
