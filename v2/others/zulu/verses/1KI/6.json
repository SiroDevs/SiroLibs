          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazakha izindonga zendlu ngaphakathi ngamapulangwe emisedari, nephansi lendlu, nezindonga zophahla; wayimboza ngokhuni ngaphakathi, wayibekela phansi endlini ngamapulangwe omsayipuresi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        }
      ]
    },
