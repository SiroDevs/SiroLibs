            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngale ndlu oyakhayo, uma nihamba ngezimiso zami, nenza izahlulelo zami, nigcina yonke imiyalo yami ukuhamba ngayo; khona ngiyakuligcwalisa kuwe izwi lami engalikhuluma kuyihlo uDavide.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        }
      ]
    },
