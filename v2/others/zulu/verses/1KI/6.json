          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakha izingalo ezingamashumi amabili ezinhlangothini zendlu ngamapulangwe emisedari kusukela phansi kuze kufike odongeni; futhi walakhela yona ngaphakathi, yendlu engaphakathi, yebo, iNgcwelengcwele.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        }
      ]
    },
