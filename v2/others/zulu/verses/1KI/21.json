          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.15",
            "verseOrgIds": [
              "1KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi u-Ahabi esezwile ukuthi uNaboti ufile, u-Ahabi wasuka, wehlela esivinini sikaNaboti waseJizreyeli ukuba asidle.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        }
      ]
    },
