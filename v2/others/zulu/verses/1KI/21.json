          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwi likaJehova lafika ku-Eliya waseThishibi, lathi:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        }
