          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenza izinengiso eziningi ngokulandela izithombe, njengalokho enza ama-Amori uJehova awaxosha phambi kwabantwana bakwa-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
    },
