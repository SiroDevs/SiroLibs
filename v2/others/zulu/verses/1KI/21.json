          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa akubangakho onjengo-Ahabi ozithengisele ukwenza okubi emehlweni kaJehova owavusa u-Izebeli umkakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        }
      ]
