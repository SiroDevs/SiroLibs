        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngiyakwenza indlu yakho ibe njengendlu kaJerobowamu indodana kaNebati nanjengendlu kaBahesa indodana ka-Ahiya ngenxa yokuklolodeka ongicunule ngakho, onisa ngakho u-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.22",
            "verseOrgIds": [
              "1KI.21.22"
            ]
          }
        }
