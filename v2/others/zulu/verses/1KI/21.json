            "sid": "1KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma nango-Izebeli, wathi: “Izinja ziyakumudla u-Izebeli odongeni lwaseJizreyeli.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        }
