        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngiyakwehlisela okubi phezu kwakho, ngisuse inzalo yakho, nginqume ku-Ahabi olwa nomduli, noboshiwe nosala kwa-Israyeli;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.21",
            "verseOrgIds": [
              "1KI.21.21"
            ]
          }
        }
      ]
    },
