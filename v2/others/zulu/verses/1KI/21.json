        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona kwangena amadoda amabili, amadodana kaBheliyali, ahlala phambi kwakhe; abantu ababi bafakaza ngaye uNaboti phambi kwabantu, bathi: “UNabhoti uthukile uNkulunkulu nenkosi; Base bemkhiphela ngaphandle komuzi, bamkhanda ngamatshe, wafa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.13",
            "verseOrgIds": [
              "1KI.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
