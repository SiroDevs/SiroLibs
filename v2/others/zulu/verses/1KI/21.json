            "number": "19",
            "style": "v",
            "sid": "1KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi kumelwe ukhulume kuye uthi: ‘Usho kanje uJehova, uthi: Ingabe ubulele wathatha futhi? Uzakhuluma kuye, uthi: Usho kanje uJehova, uthi: Endaweni lapho izinja zaxhapha khona igazi likaNabhoti, izinja ziyakukhotha igazi lakho, okungukuthi eyakho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        }
      ]
