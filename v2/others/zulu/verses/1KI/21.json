              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suka, wehle, ukuhlangabezana no-Ahabi, inkosi yakwa-Israyeli, oseSamariya; bheka, usesivinini sikaNaboti, lapho ehlele khona ukuyosidla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.18",
