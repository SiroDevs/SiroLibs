          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UDemetriyu ufakazelwa yibo bonke nayiqiniso uqobo lwalo; yebo, nathi siyafakaza; niyazi ukuthi ubufakazi bethu buqinisile.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        }
