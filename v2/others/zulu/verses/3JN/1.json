          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.4",
            "verseOrgIds": [
              "3JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "3JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sithandwa, wenza ngokwethembeka loba yini oyenza kubazalwane lakwabezizweni;",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.5",
            "verseOrgIds": [
              "3JN.1.5"
            ]
          }
        }
      ]
    },
