          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abafakazele uthando lwakho phambi kwebandla; uba ubaqhubela ngendlela yokuhlonipha uNkulunkulu, ube wenza kuhle;",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.6",
            "verseOrgIds": [
              "3JN.1.6"
            ]
          }
        }
