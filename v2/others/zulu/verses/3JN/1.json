              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilunga kuGayu othandekayo, engimthanda ngeqiniso.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        }
