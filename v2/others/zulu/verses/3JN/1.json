          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngiyethemba ukuthi ngizakubona masinyane, sikhulume ubuso nobuso. Ukuthula makube kuwe. Abangane bethu bayakubingelela. Bingelela abangani ngamagama.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        }
      ]
    },
