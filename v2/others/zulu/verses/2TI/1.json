          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yalokhu lami ngihlupheka ngalezizinto, kodwa kangilanhloni, ngoba ngiyamazi engikholiweyo, njalo ngiqinisekile ukuthi ulamandla okulondoloza lokho engikubeke kuye kuze kufike lolosuku.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
