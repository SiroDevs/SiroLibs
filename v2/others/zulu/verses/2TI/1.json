              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "INkosi mayiphe umusa endlini ka-Onesiforu; ngokuba wangiqabula kaningi, akabanga namahloni ngamaketanga ami;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.16",
