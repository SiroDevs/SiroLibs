            "sid": "2TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawulu, umphostoli kaKristu Jesu ngentando kaNkulunkulu ngokwesithembiso sokuphila okukuKristu Jesu,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuThimothewu, indodana yami ethandekayo: Makube umusa, nesihawu, nokuthula okuvela kuNkulunkulu uBaba nakuKristu Jesu iNkosi yethu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyambonga uNkulunkulu engimkhonzayo kokhokho ngonembeza omhlophe, ngokuba ngingaphezi ukukukhumbula emikhulekweni yami ubusuku nemini;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.3",
            "verseOrgIds": [
              "2TI.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.3",
            "verseOrgIds": [
              "2TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngifisa kakhulu ukukubona, ngikhumbula izinyembezi zakho, ukuze ngigcwaliswe ngentokozo;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.4",
            "verseOrgIds": [
              "2TI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.4",
            "verseOrgIds": [
              "2TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa ngikhumbula ukholo lwakho olungazenzisiyo olwahlala kuqala kugogo wakho uLowisi lakunyoko uYunike; ngiyaqiniseka ukuthi nakuwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho ngiyakukhumbuza ukuba uvuse isipho somusa sikaNkulunkulu esikuwe ngokubeka izandla zami.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
