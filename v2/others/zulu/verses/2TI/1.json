        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uNkulunkulu akasinikanga umoya wokwesaba; kodwa ngamandla, lothando, lengqondo ephilileyo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ungabi namahloni ngobufakazi beNkosi yethu, nangami isiboshwa sayo, kodwa hlanganyela osizini lwevangeli ngokwamandla kaNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.8",
            "verseOrgIds": [
              "2TI.1.8"
            ]
          }
        }
      ]
    },
    {
