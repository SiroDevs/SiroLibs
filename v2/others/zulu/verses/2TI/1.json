          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa khathesi sibonakalisiwe ngokubonakala koMsindisi wethu uJesu Kristu, osechithile ukufa, waseveza ekukhanyeni ukuphila lokungabhubhi ngevangeli;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
        }
      ]
    },
