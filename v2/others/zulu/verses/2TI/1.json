        {
          "text": "Bambelela endleleni yamazwi aphilileyo owawezwa kimi ekukholweni nangothando olukuKristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
