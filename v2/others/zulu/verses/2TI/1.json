          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "engamiselwa ukuthi ngibe ngumshumayeli, nomphostoli, nomfundisi wabezizwe.",
          "type": "text",
