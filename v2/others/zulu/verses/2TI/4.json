          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa wena qaphela ezintweni zonke, ubekezele ezinhluphekweni, wenze umsebenzi womvangeli, ugcwalise inkonzo yakho.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.5",
            "verseOrgIds": [
              "2TI.4.5"
            ]
          }
        }
      ]
    },
    {
