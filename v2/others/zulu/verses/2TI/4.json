          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uDema ungishiyile, ethanda leli zwe lamanje, waya eThesalonika; uKreske eGalathiya, uThithu eDalmatiya.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
            "verseOrgIds": [
              "2TI.4.10"
            ]
