            "sid": "2TI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba siyeza isikhathi abangayikuvuma ngaso isifundiso esiphilileyo; kodwa ngokwezinkanuko zabo bayakuzibuthela abafundisi, beluma izindlebe;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.3",
            "verseOrgIds": [
              "2TI.4.3"
            ]
          }
        }
      ]
    },
    {
