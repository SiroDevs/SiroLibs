          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngiyakuyala phambi kukaNkulunkulu neNkosi uJesu Kristu ozakwahlulela abaphilayo nabafileyo ngokubonakala kwakhe nombuso wakhe;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.1",
            "verseOrgIds": [
              "2TI.4.1"
            ]
          }
        }
      ]
    },
    {
