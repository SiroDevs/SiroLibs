          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.2",
            "verseOrgIds": [
              "2TI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
