        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.3",
            "verseOrgIds": [
              "2TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "njalo bazafulathelisa izindlebe zabo eqinisweni, baphendukele ezinganekwaneni.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.4",
            "verseOrgIds": [
              "2TI.4.4"
            ]
          }
        }
