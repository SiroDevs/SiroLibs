          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusukela khathesi ngibekelwe umqhele wokulunga, ezanginika wona ngalolosuku iNkosi, umahluleli olungileyo, kungeyisimi ngedwa, kodwa lakubo bonke abathanda ukubonakala kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.8",
            "verseOrgIds": [
              "2TI.4.8"
