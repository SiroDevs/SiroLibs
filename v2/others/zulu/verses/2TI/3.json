              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhapheli, abalukhuni, abakhukhumeleyo, abathanda injabulo kunokuthanda uNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.4",
            "verseOrgIds": [
