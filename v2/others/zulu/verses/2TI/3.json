        },
        {
          "text": "ngaphandle kokuthanda imvelo, abaphula isivumelwano, abahlebi, abangafuni ukuzithiba, abanolaka, abadeleli abalungileyo,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
