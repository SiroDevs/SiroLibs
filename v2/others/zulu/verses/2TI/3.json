          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengoba uJane loJambre bamelana loMozisi, ngokunjalo laba bamelana leqiniso, abantu abalengqondo eyonakeleyo, abalamandla ekukholweni.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
