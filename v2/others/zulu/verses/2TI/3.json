          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukushushiswa, nezinhlupheko, eza kimi e-Antiyokiya, e-Ikoniyu, eListra; ukuzingelwa okungaka ngakubekezelela, kepha iNkosi yangikhulula kukho konke.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
