              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba kulaba kukhona abanyebelezela ezindlini, bathumbe abesifazane abayiziwula abasindwa yizono, abaholwa yizinkanuko eziyizinhlobonhlobo;",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.6",
