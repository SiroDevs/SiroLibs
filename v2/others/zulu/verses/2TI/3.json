              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kabayikuqhubekela phambili, ngoba ubuthutha babo buzakuba sobala kubo bonke, njengoba kwaba njalo obabo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
