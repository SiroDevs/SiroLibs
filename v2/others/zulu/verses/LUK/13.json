            "sid": "LUK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu waphendula wathi kubo: “Nithi labo baseGalile babeyizoni kunabaseGalile bonke ngokuba behlushwe ngalezi zinto na?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        }
      ]
    },
    {
