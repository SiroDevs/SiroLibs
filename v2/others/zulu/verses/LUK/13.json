            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi: Umbuso kaNkulunkulu ufana lani? futhi ngiyakulifanisa nani?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        }
      ]
    },
    {
