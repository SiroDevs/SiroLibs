          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona ngaleso sikhathi abathile abamtshela ngabaseGalile igazi labo uPilatu ayelixubanise nemihlatshelo yabo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.1",
            "verseOrgIds": [
              "LUK.13.1"
            ]
          }
        }
      ]
    },
    {
