          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
