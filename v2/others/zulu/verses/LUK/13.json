        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umphathi wesinagoge waphendula ngokuthukuthela, ngokuba uJesu esilisa ngesabatha, wathi kubantu: Zikhona izinsuku eziyisithupha okufanele kusetshenzwe ngazo; ngakho wozani ngazo, niphulukiswe, kungabi ngesabatha usuku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
