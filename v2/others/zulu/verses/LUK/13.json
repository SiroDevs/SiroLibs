          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalabo abayishumi nesishiyagalombili owawela phezu kwabo umbhoshongo waseSilowama, wababulala, nithi bona babeyizoni kunabo bonke abantu abakhileyo eJerusalema na?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.4",
            "verseOrgIds": [
              "LUK.13.4"
            ]
          }
        }
