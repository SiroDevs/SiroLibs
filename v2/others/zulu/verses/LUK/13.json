            "sid": "LUK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasekhuluma lomfanekiso; Umuntu othile wayenomkhiwane utshalwe esivinini sakhe; weza wadinga isithelo kuwo, kodwa akasitholanga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesethi kuso isisebenzi sesivini: ‘Bheka, sekuyiminyaka emithathu ngiza ngifuna isithelo kulo mkhiwane, ngingasifumani; uwuthelelelani umhlabathi?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.7",
            "verseOrgIds": [
              "LUK.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.7",
            "verseOrgIds": [
              "LUK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaphendula yathi kuye: “Nkosi, wuyeke nangalo nyaka, ngize ngimbe emaceleni awo, ngithele umquba;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma uthela isithelo, kuhle; uma kungenjalo, wowugawula emva kwalokho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.9",
            "verseOrgIds": [
              "LUK.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.9",
            "verseOrgIds": [
              "LUK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayefundisa kwelinye lamasinagoge ngesabatha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, kwakukhona owesifazane onomoya wobuthakathaka iminyaka eyishumi nesishiyagalombili, eqhothile engakwazi nokusukuma.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
