          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasebeka izandla phezu kwakhe; njalo wahle waqonda, wadumisa uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        }
