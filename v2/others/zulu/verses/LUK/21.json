            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuqondene nalezi zinto enizibonayo, kuyeza izinsuku okungayikushiywa ngazo itshe phezu kwetshe elingayikudilizelwa phansi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.6",
            "verseOrgIds": [
              "LUK.21.6"
            ]
          }
        }
      ]
    },
    {
