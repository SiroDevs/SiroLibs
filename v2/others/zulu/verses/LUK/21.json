          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngiyakuninika umlomo nokuhlakanipha, abangayikuphika noma ukumelana nabo bonke abamelene nani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.15",
            "verseOrgIds": [
