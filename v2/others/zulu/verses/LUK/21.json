          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebembuza besithi: Mfundisi, kodwa lezizinto zizakuba nini? futhi siyakuba yini isibonakaliso lapho lezi zinto zizokwenzeka na?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        }
      ]
    },
