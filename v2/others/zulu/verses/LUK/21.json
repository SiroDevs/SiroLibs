          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nxa nizwa ngezimpi neziyaluyalu, ningethuki; kepha ukuphela akusikho masinyane.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.9",
            "verseOrgIds": [
              "LUK.21.9"
            ]
          }
        }
