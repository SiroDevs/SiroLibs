              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabona nomfelokazi othile ompofu ephonsa khona ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        },
        {
          "text": " amabili.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        }
      ]
    },
    {
