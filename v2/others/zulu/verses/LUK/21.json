              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi: “Ngiqinisile ngithi kini: Lo mfelokazi ompofu ubeke okuningi kunabo bonke;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
