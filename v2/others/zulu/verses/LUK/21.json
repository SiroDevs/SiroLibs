          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kugcineni ezinhliziyweni zenu ukuba ningacabangi ngaphambili eniyakuziphendulela ngakho;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.14",
