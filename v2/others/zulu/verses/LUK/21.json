            "sid": "LUK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ngaphambi kwakho konke lokho bayakunibamba, banizingele, baninikele emasinagogeni nasematilongweni, niyiswe phambi kwamakhosi nababusi ngenxa yegama lami.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.12",
            "verseOrgIds": [
              "LUK.21.12"
            ]
          }
        }
      ]
    },
