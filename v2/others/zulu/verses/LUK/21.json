            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bonke laba baphosele eminikelweni kaNkulunkulu kokuchichima kwabo, kepha yena ekusweleni kwakhe ubeke konke abephila ngakho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.4",
            "verseOrgIds": [
              "LUK.21.4"
            ]
          }
        }
      ]
    },
    {
