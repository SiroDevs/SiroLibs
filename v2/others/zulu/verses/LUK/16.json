              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasesithi: Ngakho ngiyakucela, baba, ukuthi umthume endlini kababa;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.27",
            "verseOrgIds": [
              "LUK.16.27"
            ]
          }
