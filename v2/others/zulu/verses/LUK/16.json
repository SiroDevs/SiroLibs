          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samemeza sathi: ‘Baba Abrahama, ngihawukele, uthume uLazaru, agcobhoze isihloko somunwe wakhe emanzini, aphozise ulimi lwami; ngoba ngiyahlushwa kulelilangabi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.24",
