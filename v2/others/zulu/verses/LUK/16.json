              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba nginabafowethu abayisihlanu; ukuze afakaze kubo, hlezi nabo beze kulendawo yokuhlupheka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.28",
