          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha u-Abrahama wathi: “Ndodana, khumbula ukuthi wamukela okuhle kwakho usesekuphileni, noLazaru ngokunjalo nokubi;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.25",
