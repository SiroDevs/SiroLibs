              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yilowo nalowo olahla umkakhe, aganwe ngomunye, uyaphinga;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
