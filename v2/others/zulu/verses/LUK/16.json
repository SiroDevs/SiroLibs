          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi phezu kwakho konke lokhu phakathi kwethu lani kubekiwe umhosha omkhulu, ukuze abafuna ukuwela besuka lapha besiya kini bangabi; futhi abanakuwelela kithi abafuna ukuvela khona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.26",
            "verseOrgIds": [
              "LUK.16.26"
            ]
          }
        }
