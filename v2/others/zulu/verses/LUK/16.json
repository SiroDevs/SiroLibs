          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifisa ukusuthiswa ngemvuthuluka ewa etafuleni lesicebi, phezu kwalokho kwafika nezinja zayikhotha izilonda zaso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.21",
