          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esihogweni saphakamisa amehlo aso, sisebuhlungwini, sabona u-Abrahama ekude, noLazaru esesifubeni sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.23",
