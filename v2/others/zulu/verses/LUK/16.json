          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha kulula ukuba kudlule izulu nomhlaba kunokuba kuphele ichashana elilodwa lomlayo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
      ]
