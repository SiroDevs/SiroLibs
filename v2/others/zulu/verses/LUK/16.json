          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakukhona isinxibi esithile, nguLazaru, esasibekwe esangweni laso sigcwele izilonda;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.20",
