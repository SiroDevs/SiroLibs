            "sid": "LUK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodana yakhe enkulu yayisensimini; yathi isiza isondela endlini, yezwa ukuhlabelela nokusina.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        }
