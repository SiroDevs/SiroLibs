          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasehamba wazihlanganisa nesakhamuzi salelo zwe; Wayithumela emadlelweni akhe ukuba yaluse izingulube.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.15",
            "verseOrgIds": [
              "LUK.15.15"
            ]
          }
        }
