          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Encane yawo yathi kuyise: ‘Baba, nginike isabelo sempahla esiqondene nami.’ Futhi wabahlukanisela impahla yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.12",
            "verseOrgIds": [
