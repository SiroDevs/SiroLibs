            "sid": "LUK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumuphi umuntu kini onezimvu eziyikhulu, kuthi uma elahlekelwa ngenye yazo, angazishiyi ezingamashumi ayisishiyagalolunye nesishiyagalolunye ehlane, alandele elahlekileyo, aze ayithole, na?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.4",
            "verseOrgIds": [
              "LUK.15.4"
            ]
          }
        }
      ]
    },
    {
