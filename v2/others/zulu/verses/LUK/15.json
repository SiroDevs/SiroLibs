              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: “Mntanami, wena uhlezi unami, nakho konke enginakho kungokwakho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
              "LUK.15.31"
            ]
          }
        }
