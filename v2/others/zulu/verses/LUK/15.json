          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.20",
            "verseOrgIds": [
              "LUK.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodana yathi kuye: ‘Baba, ngonile kulo izulu naphambi kwakho, angisafanele ukuthiwa indodana yakho.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.21",
            "verseOrgIds": [
              "LUK.15.21"
            ]
          }
        }
      ]
    },
