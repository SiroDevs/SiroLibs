            "sid": "LUK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esefikile ekhaya, abizele ndawonye abangani bakhe nomakhelwane, athi kubo: “Thokozani nami; ngoba ngiyitholile imvu yami ebilahlekile.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.6",
            "verseOrgIds": [
              "LUK.15.6"
            ]
          }
        }
      ]
    },
    {
