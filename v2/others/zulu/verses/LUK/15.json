            "sid": "LUK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathukuthela, akavumanga ukungena; wayesephuma uyise, wamncenga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.28",
            "verseOrgIds": [
              "LUK.15.28"
            ]
          }
        }
