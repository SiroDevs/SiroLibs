            "number": "19",
            "style": "v",
            "sid": "LUK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.19",
            "verseOrgIds": [
              "LUK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasuka, yaya kuyise. Kuthe isekude, uyise wayibona, waba nesihe, wagijima, wawa entanyeni yakhe, wayanga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.20",
            "verseOrgIds": [
              "LUK.15.20"
            ]
          }
        }
      ]
    },
    {
