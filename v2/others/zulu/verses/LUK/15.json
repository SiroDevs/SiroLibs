          "text": "Ngiyakusuka, ngiye kubaba, ngithi kuye: Baba, ngonile kulo izulu naphambi kwakho;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.18",
            "verseOrgIds": [
              "LUK.15.18"
            ]
          }
        }
      ]
    },
    {
