          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanjalo, ngithi kini: Kukhona ukuthokoza phambi kwezingelosi zikaNkulunkulu ngesoni sisinye esiphendukayo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.10",
            "verseOrgIds": [
              "LUK.15.10"
            ]
          }
        }
      ]
