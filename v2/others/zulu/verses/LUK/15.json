          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayesefisa ukugcwalisa isisu sakhe ngamakhoba adliwa yizingulube, kepha kwakungekho muntu owamnikayo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.16",
