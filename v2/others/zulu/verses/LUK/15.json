            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngithi kini: Kanjalo kuyakuba khona ukuthokoza ezulwini ngesoni sisinye esiphendukayo, kunabalungileyo abangamashumi ayisishiyagalolunye nesishiyagalolunye abangadingi kuphenduka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.7",
            "verseOrgIds": [
              "LUK.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
