            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuye: “Umfowenu ufikile; uyihlo uhlabile ithole elikhuluphalisiwe, ngokuba umamukele ephilile.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.27",
            "verseOrgIds": [
              "LUK.15.27"
            ]
          }
        }
