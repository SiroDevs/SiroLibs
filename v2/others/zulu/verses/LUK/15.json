          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kuthe ifika le ndodana yakho, edle ukudla kwakho lezifebe, uyihlabele ithole elikhuluphalisiweyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.30",
            "verseOrgIds": [
              "LUK.15.30"
            ]
          }
        }
      ]
