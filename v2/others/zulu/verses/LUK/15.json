          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma ngumuphi owesifazane onezinhlamvu zesiliva eziyishumi, kuthi uma elahlekelwa uhlamvu lunye, angalumeki isibani, ashanele indlu, adingisise, aze aluthole?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.8",
            "verseOrgIds": [
              "LUK.15.8"
            ]
          }
        }
