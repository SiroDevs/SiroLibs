          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi emva kwezinsuku ezingeziningi indodana encane yayisibutha konke, yamuka, yaya ezweni elikude;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.13",
