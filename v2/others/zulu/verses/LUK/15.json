          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba le ndodana yami ibifile, isiyaphila futhi; ubelahlekile, usetholakele. Basebeqala ukujabula.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.24",
            "verseOrgIds": [
              "LUK.15.24"
            ]
          }
        }
      ]
    },
    {
