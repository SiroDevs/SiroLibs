          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athi eseyitholile, ayibeke emahlombe akhe ethokoza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.5",
            "verseOrgIds": [
              "LUK.15.5"
            ]
          }
