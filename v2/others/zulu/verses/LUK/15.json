          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bekufanele ukuthi sijabule sithokoze, ngokuba umfowenu lo ubefile, wabuye waphila; yayilahlekile, yafunyanwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.32",
            "verseOrgIds": [
              "LUK.15.32"
            ]
          }
        }
