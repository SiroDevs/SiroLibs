            "number": "18",
            "style": "v",
            "sid": "LUK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.18",
            "verseOrgIds": [
              "LUK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angisafanele ukuthiwa indodana yakho; ngenze ngibe njengomunye wabaqashwa bakho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.19",
            "verseOrgIds": [
              "LUK.15.19"
            ]
          }
        }
      ]
    },
    {
