          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasephendula wathi kuyise: Khangela, leminyaka eminengi ngikukhonza, kangizange ngeqe umlayo wakho;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        }
      ]
