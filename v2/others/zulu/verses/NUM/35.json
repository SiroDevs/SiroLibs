          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noma yiliphi itshe angafa ngalo umuntu engaboni, aliphonse phezu kwakhe, aze afe, engesona isitha sakhe, engafunanga okubi kwakhe;",
          "type": "text",
