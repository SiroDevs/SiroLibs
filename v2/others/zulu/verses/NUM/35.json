              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uma umbulali efika noma nini ngaphandle komngcele womuzi wakhe okhululekile abebalekele kuwo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
