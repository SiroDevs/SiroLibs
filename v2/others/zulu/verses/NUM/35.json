              "NUM.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakunikela imizi emithathu ngaphesheya kweJordani, ninike imizi emithathu ezweni laseKhanani, ibe yimizi ekhululekile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.14",
            "verseOrgIds": [
              "NUM.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.14",
            "verseOrgIds": [
              "NUM.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le mizi eyisithupha iyakuba yindawo yokuphephela yabantwana bakwa-Israyeli, nakumfokazi, nakomfokazi phakathi kwabo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        }
      ]
    },
    {
