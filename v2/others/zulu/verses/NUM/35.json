            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kuMose emathafeni akwaMowabi ngaseJordani ngaseJeriko, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.1",
            "verseOrgIds": [
              "NUM.35.1"
            ]
          }
        }
      ]
    },
    {
