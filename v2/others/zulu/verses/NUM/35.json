          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma emshaya ngokujikijela ngetshe angafa ngalo, aze afe, ungumbulali; umbulali wobulawa nokubulawa.",
          "type": "text",
          "attrs": {
