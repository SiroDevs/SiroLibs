          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu kwalokho, aniyikuthatha noma iyiphi inhlawulo yomphefumulo wombulali onecala lokubulala, kodwa kumelwe abulawe nakanjani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
