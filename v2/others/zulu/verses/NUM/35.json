              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba ngubani obulala umuntu, umbulali kumele abulawe ngomlomo wabofakazi; kepha ufakazi oyedwa akayikufakaza ngomuntu ukuba afe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
