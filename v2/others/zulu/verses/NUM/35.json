          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kuMose, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono ebantwaneni bakoIsrayeli uthi kibo: Uba liwela iJordani liye elizweni leKhanani;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.10",
            "verseOrgIds": [
              "NUM.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.10",
            "verseOrgIds": [
              "NUM.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakumisela imizi eyakuba yimizi ekhululekile kini; ukuze umbulali abalekele khona, obulale umuntu engazi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.11",
            "verseOrgIds": [
              "NUM.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.11",
            "verseOrgIds": [
              "NUM.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawa ayakuba yimizi yenu njengesiphephelo kubaphindiseli; ukuze umbulali angafi, aze eme phambi kwebandla ekwahlulelweni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.12",
            "verseOrgIds": [
              "NUM.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
