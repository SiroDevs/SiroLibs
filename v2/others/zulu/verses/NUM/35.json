          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniyikuthatha isihlawulo ngomuntu obalekele emzini wakhe okhululekileyo ukuba abuye ahlale ezweni aze afe umpristi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        }
