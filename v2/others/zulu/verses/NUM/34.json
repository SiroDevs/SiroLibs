          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wabayala abantwana bakwa-Israyeli, wathi: “Nali izwe eniyakulidla ngenkatho uJehova ayala ukuba nilinike izizwe eziyisishiyagalolunye nenxenye yesizwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        }
      ]
