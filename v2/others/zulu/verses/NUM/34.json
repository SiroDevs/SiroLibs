            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba isizwe sabantwana bakwaRubeni ngokwezindlu zoyise, nesizwe sabantwana bakwaGadi ngokwezindlu zoyise, sazuza ifa laso; inxenye yesizwe sakwaManase yazuza ifa laso.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        }
