              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izizwe ezimbili nengxenye yesizwe zadla ifa lazo nganeno kweJordani ngaseJeriko ngasempumalanga ngasempumalanga.",
          "type": "text",
          "attrs": {
