          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umngcele kumelwe wehlele eJordani, uphumele oLwandle Lukasawoti: lokhu kuyakuba yizwe lenu nezwe lalo nxazonke.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
            "verseOrgIds": [
              "NUM.34.12"
            ]
