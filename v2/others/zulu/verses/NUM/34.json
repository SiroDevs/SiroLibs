            "sid": "NUM 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umkhawulo uyakudlula uye eZifroni, ukuphuma kwawo kube eHasarenani; lokhu kuyakuba ngumkhawulo wenu wasenyakatho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.9",
            "verseOrgIds": [
              "NUM.34.9"
            ]
          }
