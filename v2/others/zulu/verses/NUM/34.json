          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yala abantwana bakoIsrayeli, uthi kubo: Nxa lifika elizweni leKhanani; (leli yizwe eliyakuwela kini njengefa, izwe laseKhanani nemikhawulo yalo.)",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.2",
            "verseOrgIds": [
              "NUM.34.2"
            ]
          }
        }
      ]
    },
    {
