        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugu luyokwehla lusuka eSefamu luye eRibila, ngasempumalanga kwase-Ayini; futhi umucu wokulinganisa uyakwehla wenyukele ohlangothini loLwandle lwaseKinereti ngasempumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.11",
            "verseOrgIds": [
              "NUM.34.11"
            ]
          }
        }
      ]
    },
