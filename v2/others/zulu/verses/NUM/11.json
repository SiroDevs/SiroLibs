          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu basuka eKibroti-Hathava baya eHaseroti; wahlala eHaseroti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
            "verseOrgIds": [
              "NUM.11.35"
            ]
          }
        }
      ]
