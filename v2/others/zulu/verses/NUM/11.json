            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabiza leyondawo ngokuthi iKibrothathava, ngokuba bambela khona izinkanuko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        }
      ]
    },
