          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.32",
            "verseOrgIds": [
              "NUM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama isaphakathi kwamazinyo abo, ingakahlafunwa, intukuthelo kaJehova yavuthela abantu, uJehova wabashaya abantu ngokushaywa okukhulu kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
