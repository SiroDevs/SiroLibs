            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waphendula wathi: “Angiyikuqaphela yini ukukhuluma lokho uJehova akubeke emlonyeni wami na?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        }
      ]
    },
