              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngamukele umyalo wokuba ngibusise, futhi wabusisa; futhi angikwazi ukukuhlehlisa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.20",
