          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamyisa ensimini yaseSofimi esiqongweni sasePisga, wakha ama-altare ayisikhombisa, wanikela ngenkunzi nangenqama kulelo nalelo altare.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
