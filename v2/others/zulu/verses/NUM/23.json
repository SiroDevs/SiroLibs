          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBileyamu wayesethi kuBalaki: “Yima ngasemnikelweni wakho wokushiswa, mina ngihambe; mhlawumbe iNkosi ingangihlangabeza; Futhi waya endaweni ephakeme.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        }
      ]
    },
    {
