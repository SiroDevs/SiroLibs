          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UBalaki wayesethi kuye: “Woza nami siye kwenye indawo lapho ungababona khona; uzobona kuphela ukweqisa kwabo hhayi bonke; ungiqalekisele wona usulapho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
