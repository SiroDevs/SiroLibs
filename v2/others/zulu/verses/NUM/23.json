              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kuBalaki: “Yima lapha ngasemnikelweni wakho wokushiswa, ngize ngihlangane neNkosi khona.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
