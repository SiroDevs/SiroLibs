          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu wahlangana noBileyamu, wathi kuye: “Ngalungisa ama-altare ayisikhombisa, nganikela ngenkunzi nangenqama kulelo nalelo altare.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        }
      ]
    },
    {
