            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu akasiye umuntu ukuba aqambe amanga; nendodana yomuntu ukuba iphenduke; wathi futhi ngeke? noma ukhulumile angalungisi na?",
          "type": "text",
