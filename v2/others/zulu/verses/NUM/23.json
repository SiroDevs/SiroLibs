            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wahlangana noBileyamu, wafaka izwi emlonyeni wakhe, wathi: “Buyela kuBalaki, ukhulume kanjalo;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
