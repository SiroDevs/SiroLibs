            "sid": "NUM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AmaLevi kumelwe abeke izandla zawo phezu kwezinhloko zezinkunzi, futhi kumelwe ulungise enye ibe ngumnikelo wesono nenye ibe ngumnikelo wokushiswa kuJehova ukwenzela amaLevi ukubuyisana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        }
      ]
    },
    {
