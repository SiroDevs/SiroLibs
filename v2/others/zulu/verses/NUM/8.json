          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono kuAroni uthi kuye: Nxa ukhanyisa izibane, izibane eziyisikhombisa zizakhanyisa phambi koluthi lwesibane.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        }
      ]
