            "sid": "NUM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba baphiwa mina impela phakathi kwabantwana bakwa-Israyeli; esikhundleni salabo abavula zonke izizalo zikanina, esikhundleni samazibulo abo bonke abantwana bakwa-Israyeli, ngabathatha bona.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.16",
            "verseOrgIds": [
              "NUM.8.16"
            ]
          }
        }
      ]
    },
