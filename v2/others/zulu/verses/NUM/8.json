          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ngawami onke amazibulo abantwana bakwa-Israyeli, abantu nawezilwane; mhla ngibulala amazibulo onke ezweni laseGibithe, ngawangcwelisela kimi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.17",
            "verseOrgIds": [
              "NUM.8.17"
            ]
          }
        }
