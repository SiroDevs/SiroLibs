          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho kumelwe uwahlukanise amaLevi phakathi kwabantwana bakwa-Israyeli, amaLevi abe ngawami.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.14",
            "verseOrgIds": [
              "NUM.8.14"
            ]
          }
        }
      ]
    },
