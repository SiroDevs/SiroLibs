          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasemuva amaLevi ayakungena ukwenza inkonzo yetende lokuhlangana; kumelwe uzihlanze futhi uzinikele njengomhlatshelo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.15",
            "verseOrgIds": [
              "NUM.8.15"
            ]
          }
        }
      ]
    },
