          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ubeke amaLevi phambi kuka-Aroni naphambi kwamadodana akhe futhi unikele ngawo njengomnikelo kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        }
      ]
    },
