          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyasithululela phezu kwethu ngokuchichimayo ngoJesu Kristu uMsindisi wethu;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.6",
            "verseOrgIds": [
              "TIT.3.6"
            ]
          }
        }
