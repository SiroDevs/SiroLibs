          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nxa ngithuma u-Artemase kuwe noma uThikhiku, khuthala ukuza kimi eNikopholi, ngokuba nginqume ukuhlala khona ebusika.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        }
