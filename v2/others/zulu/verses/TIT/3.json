          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ongumhlubuki emva kokuyalwa kokuqala nokwesibili umlahle;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.10",
            "verseOrgIds": [
              "TIT.3.10"
            ]
          }
        }
