          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uze ukhuthalele uZena, usazimthetho, loApolosi, bahambe ngohambo lwabo, ukuze bangasweli lutho.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
