          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "lisazi ukuthi onjalo uphambukisiwe, njalo uyona, ezilahlile yena.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.11",
            "verseOrgIds": [
              "TIT.3.11"
            ]
