          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likholekile leli zwi, futhi lezizinto ngithanda ukuba uziqinise ungayeki, ukuze abakholwa nguNkulunkulu baqaphele ukugcina imisebenzi emihle. Lezi zinto zinhle futhi zinenzuzo kubantu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.8",
            "verseOrgIds": [
              "TIT.3.8"
            ]
          }
        }
      ]
    },
