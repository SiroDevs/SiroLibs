          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungengemisebenzi yokulunga esayenzayo thina, kodwa ngokwesihawu sakhe wasisindisa, ngesigezo sokuzalwa kutsha, nangokwenziwa basha ngoMoya oNgcwele;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.5",
            "verseOrgIds": [
              "TIT.3.5"
            ]
          }
        }
      ]
    },
