          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha gwema imibuzo yobuwula, nezindaba zozalo, nokubanga, nokubanga ngomthetho; ngoba azisizi futhi ziyize.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.9",
            "verseOrgIds": [
              "TIT.3.9"
            ]
