          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhumbuze ukuba bathobele izikhulu namandla, balalele izinduna, balungele yonke imisebenzi emihle;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.1",
            "verseOrgIds": [
              "TIT.3.1"
            ]
          }
        }
      ]
    },
    {
