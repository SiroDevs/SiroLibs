          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.1",
            "verseOrgIds": [
              "TIT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangahlambalazi muntu, bangabi-ingxabano, kodwa babe mnene, bebonisa ubumnene bonke kubantu bonke.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.2",
            "verseOrgIds": [
              "TIT.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
