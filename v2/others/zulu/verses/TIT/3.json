          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze sesilungisisiwe ngomusa wakhe, sibe yizindlalifa ngokwethemba lokuphila okuphakade.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.7",
            "verseOrgIds": [
