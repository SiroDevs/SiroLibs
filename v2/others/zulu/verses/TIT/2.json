          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "babe ngabaqondayo, abamhlophe, abagcina imizi, abalungile, abathobela amadoda abo, ukuze izwi likaNkulunkulu lingahlanjalazwa.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        }
      ]
    },
    {
