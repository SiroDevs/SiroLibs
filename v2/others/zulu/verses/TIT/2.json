          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "silindele ithemba elibusisiweyo, nokubonakala kwenkazimulo kaNkulunkulu omkhulu noMsindisi wethu uJesu Kristu;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        }
