          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "owazinikela ngenxa yethu, ukuze asihlenge kubo bonke ububi, futhi azihlambulule isizwe esiyisizwe, esishisekela imisebenzi emihle.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
