          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuluma lezizinto, uyale, ukhuze ngawo wonke amandla. Makungabikho muntu okudelelayo.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.15",
            "verseOrgIds": [
