            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezintweni zonke uzibonakalise uyisiboniso semisebenzi emihle: esifundiseni ukhombisa ukungonakali, ukulunga, ubuqotho,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.7",
            "verseOrgIds": [
              "TIT.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.7",
            "verseOrgIds": [
              "TIT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkulumo ephilileyo engenakulahlwa; ukuze ophambeneyo abe namahloni, engenalutho olubi angalusho ngani.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
