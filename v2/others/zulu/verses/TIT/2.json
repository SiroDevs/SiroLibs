            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yala izinceku ukuba zilalele amakhosi azo, zibathokozise ezintweni zonke; angaphenduli futhi;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.9",
            "verseOrgIds": [
              "TIT.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.9",
            "verseOrgIds": [
              "TIT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingazenzisi, kodwa ibonise ukwethembeka konke okuhle; ukuze bahlotshise imfundiso kaNkulunkulu uMsindisi wethu ezintweni zonke.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        }
      ]
    },
