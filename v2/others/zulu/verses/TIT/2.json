            "number": "12",
            "style": "v",
            "sid": "TIT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isifundisa ukuthi, sidele ukungamesabi uNkulunkulu nezinkanuko zezwe, sihambe ngokuqonda, nangokulunga, nangokumesaba uNkulunkulu kuleli zwe lamanje;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        }
      ]
