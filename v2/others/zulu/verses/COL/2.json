          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.13",
            "verseOrgIds": [
              "COL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wesula umbhalo wesandla wemithetho owawumelene nathi, owawumelene nathi, wawususa endleleni, wawubethela esiphambanweni sakhe;",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.14",
            "verseOrgIds": [
              "COL.2.14"
            ]
          }
        }
      ]
    },
    {
