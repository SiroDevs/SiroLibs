        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho njengalokho namamukele uKristu Jesu iNkosi, hambani kuye;",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.6",
            "verseOrgIds": [
              "COL.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
