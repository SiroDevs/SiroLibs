        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.14",
            "verseOrgIds": [
              "COL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esephucile imibuso namandla, wabukisa ngabo obala, ebanqoba ngawo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        }
      ]
    },
    {
