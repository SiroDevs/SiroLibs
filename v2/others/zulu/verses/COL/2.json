        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.2",
            "verseOrgIds": [
              "COL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
