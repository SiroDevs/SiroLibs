          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho makungabikho muntu onahlulelayo ngokudla noma ngokunathwayo noma ngokuphathelene nomkhosi noma ukwethwasa kwenyanga noma amasabatha.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.16",
            "verseOrgIds": [
              "COL.2.16"
            ]
          }
        }
      ]
    },
    {
