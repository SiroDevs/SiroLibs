          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nina niphelele kuye, eyinhloko yakho konke ukubusa namandla;",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
              "COL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
              "COL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enisokwa kuye futhi ngokusoka okwenziwa ngaphandle kwezandla, ngokukhumula umzimba wezono zenyama ngokusoka kukaKristu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.11",
            "verseOrgIds": [
              "COL.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.11",
            "verseOrgIds": [
              "COL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nangcwatshwa kanye naye embhapathizweni, okungawo futhi navuswa kanye naye ngokholo lwamandla kaNkulunkulu owamvusa kwabafileyo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.12",
            "verseOrgIds": [
              "COL.2.12"
            ]
          }
        }
      ]
    },
