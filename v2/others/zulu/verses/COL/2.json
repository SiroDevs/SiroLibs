        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze izinhliziyo zabo ziduduzeke, behlanganiswe othandweni, nakuyo yonke ingcebo yesiqinisekiso esigcwele sokuqonda, ekwazini imfihlakalo kaNkulunkulu, nekaYise, nekaKristu;",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.2",
            "verseOrgIds": [
              "COL.2.2"
            ]
          }
        }
      ]
    },
    {
