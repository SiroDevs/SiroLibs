        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.3",
            "verseOrgIds": [
              "COL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikusho lokhu, ukuze kungabikho muntu onikhohlisayo ngamazwi ahungayo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.4",
            "verseOrgIds": [
              "COL.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.4",
            "verseOrgIds": [
              "COL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba noma ngingekho ngenyama, nokho nginani ngomoya, ngithokoza, ngibona ukuhleleka kwenu, nokuqina kokukholwa kwenu kuKristu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
