          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okufihlwe kuye yonke ingcebo yokuhlakanipha nolwazi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.3",
            "verseOrgIds": [
              "COL.2.3"
            ]
          }
        }
      ]
    },
    {
