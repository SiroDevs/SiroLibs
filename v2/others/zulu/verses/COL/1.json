        {
          "text": "njengalokhu lafunda kuEphafra inceku kanye lathi ethandekayo, oyisikhonzi esithembekileyo sikaKristu ngenxa yenu;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        }
