          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "elifikile kini, njengasezweni lonke; lithela isithelo, njengalokhu lisenza lakini, kusukela osukwini elakuzwa ngalo, lawazi umusa kaNkulunkulu ngeqiniso;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        }
