        {
          "text": "Niqiniswe ngamandla onke ngokwamandla enkazimulo yakhe, kube kukho konke ukubekezela nokubekezela kanye nentokozo;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
