          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba ithemba enibekelwe lona ezulwini, enalizwa ngaphambili ngezwi leqiniso levangeli;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        }
