          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "njengoba sezwa ngokukholwa kwenu kuKristu Jesu, nothando eninalo kubo bonke abangcwele.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        }
      ]
