        },
        {
          "text": "Ngalokho nathi, kusukela osukwini esakuzwa ngalo, asiphezi ukunikhulekela, nokunxusa ukuba nigcwaliswe ukwazi intando yakhe kukho konke ukuhlakanipha nokuqonda kokomoya;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.9",
            "verseOrgIds": [
              "COL.1.9"
            ]
          }
