        {
          "text": "Ongumfanekiso kaNkulunkulu ongabonwayo, izibulo lezidalwa zonke.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
