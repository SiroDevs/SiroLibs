              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawuli, umphostoli kaKristu Jesu ngentando kaNkulunkulu, noThimothewu umzalwane,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        }
      ]
