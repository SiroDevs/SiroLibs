          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi yona iyinhloko yomzimba, ibandla, eyisiqalo, izibulo kwabafileyo; ukuze ibe ngeyokuqala ezintweni zonke.",
          "type": "text",
          "attrs": {
