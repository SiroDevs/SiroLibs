          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena ungaphambi kwazo zonke izinto, futhi zonke izinto zihlangana ngayo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.17",
            "verseOrgIds": [
              "COL.1.17"
