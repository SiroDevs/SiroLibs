              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze nihambe ngokufanele iNkosi ngokuthokozisa konke, nithela kuyo yonke imisebenzi emihle, nikhule ekwazini uNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
