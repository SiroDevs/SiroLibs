          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibonga uNkulunkulu uYise weNkosi yethu uJesu Kristu, sinikhulekela njalo,",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        }
      ]
    },
