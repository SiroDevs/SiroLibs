        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba kwadalwa ngayo zonke izinto ezisezulwini nezisemhlabeni, ezibonakalayo nezingabonakali, kungakhathaliseki ukuthi ziyizihlalo zobukhosi, noma imibuso, noma imibuso, noma amandla;",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.16",
            "verseOrgIds": [
              "COL.1.16"
            ]
          }
        }
      ]
