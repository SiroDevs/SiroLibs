          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonke abantu bayibona ihamba, idumisa uNkulunkulu;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.9",
            "verseOrgIds": [
              "ACT.3.9"
            ]
          }
        }
