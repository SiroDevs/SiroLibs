          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPetru ekubona waphendula abantu wathi: “Madoda akwa-Israyeli, nimangala ngalokho na? Kumbe nisigqolozeleni ngokungathi ngamandla ethu nangobungcwele bethu senze lo ukuba ahambe na?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.12",
            "verseOrgIds": [
              "ACT.3.12"
            ]
          }
        }
      ]
    },
    {
