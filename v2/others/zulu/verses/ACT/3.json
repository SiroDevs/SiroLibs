          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyathi ibona uPetro loJohane sebezangena ethempelini, yacela isipho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.3",
            "verseOrgIds": [
              "ACT.3.3"
            ]
          }
        }
      ]
