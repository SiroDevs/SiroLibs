          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi isinyonga esisilisiweyo sibambe oPetru noJohane, abantu bonke bagijimela kubo kanyekanye ekhulusini elithiwa elikaSolomoni, bemangele kakhulu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.11",
            "verseOrgIds": [
              "ACT.3.11"
            ]
          }
        }
