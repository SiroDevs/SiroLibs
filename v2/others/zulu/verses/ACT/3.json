          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bemazi ukuthi nguye owayehlalela isipho ngaseSangweni Elihle lethempeli; bagcwala ukumangala nokumangala ngalokho okwakwenzakele kuye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.10",
            "verseOrgIds": [
              "ACT.3.10"
            ]
          }
        }
      ]
