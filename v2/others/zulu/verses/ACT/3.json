          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakuthwala indoda ethile eyayilunyonga kwasesiswini sikanina, ababeyibeka imihla ngemihla ngasesangweni lethempeli elithiwa Elihle, ukuba icele izipho kwabangena ethempelini;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.2",
            "verseOrgIds": [
              "ACT.3.2"
            ]
          }
        }
      ]
    },
