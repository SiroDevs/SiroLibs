              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negama layo ngokukholwa egameni layo liyiqinisile le ndoda eniyibonayo neniyaziyo;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.16",
            "verseOrgIds": [
