          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPetro wasesithi: Isiliva legolide kangilalo; kodwa lokho enginakho ngikunika khona: Egameni likaJesu Kristu waseNazaretha, sukuma uhambe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.6",
            "verseOrgIds": [
              "ACT.3.6"
            ]
          }
        }
      ]
    },
    {
