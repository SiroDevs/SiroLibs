          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayibamba ngesandla sokunene, wayiphakamisa;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.7",
            "verseOrgIds": [
              "ACT.3.7"
            ]
          }
        }
