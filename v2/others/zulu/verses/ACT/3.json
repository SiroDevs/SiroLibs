          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "UNkulunkulu ka-Abrahama, no-Isaka, noJakobe, uNkulunkulu wawokhokho bethu, uyikhazimulisile iNdodana yakhe uJesu; enamkhaphela nina, namphika phambi kukaPilatu, yena esenqumile ukumkhulula.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.13",
            "verseOrgIds": [
              "ACT.3.13"
            ]
          }
        }
      ]
    },
