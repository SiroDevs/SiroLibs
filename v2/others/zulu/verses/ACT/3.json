            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPetro wasemgqolozela kanye loJohane, wathi: Sikhangele.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.4",
            "verseOrgIds": [
              "ACT.3.4"
