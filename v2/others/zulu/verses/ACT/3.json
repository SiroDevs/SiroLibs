              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha oPetru noJohane benyukela kanyekanye ethempelini ngehora lokukhuleka eliyihora lesishiyagalolunye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.1",
            "verseOrgIds": [
              "ACT.3.1"
            ]
          }
        }
