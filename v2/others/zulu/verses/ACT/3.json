          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labulala uMbusi wokuphila, uNkulunkulu amvusa kwabafileyo; esingofakazi bakho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.15",
            "verseOrgIds": [
              "ACT.3.15"
            ]
          }
        }
