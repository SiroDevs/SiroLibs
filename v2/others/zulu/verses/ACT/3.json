          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabanaka, ethemba ukuthola utho kubo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.5",
            "verseOrgIds": [
              "ACT.3.5"
