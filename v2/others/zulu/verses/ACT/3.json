          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasegxuma wema, wahamba, wangena nabo ethempelini, ehamba egxuma, edumisa uNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.8",
            "verseOrgIds": [
              "ACT.3.8"
