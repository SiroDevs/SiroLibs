          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha naphika oNgcwele noLungileyo, nacela ukuba niphiwe umbulali;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.14",
            "verseOrgIds": [
              "ACT.3.14"
            ]
          }
        }
      ]
