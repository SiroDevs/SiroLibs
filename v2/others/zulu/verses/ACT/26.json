            "verseId": "ACT.26.13",
            "verseOrgIds": [
              "ACT.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuthe sesiwile phansi sonke emhlabathini, ngezwa izwi likhuluma kimi ngolimi lwesiHeberu, lithi: ‘Sawulu, Sawulu, ungizingelelani na? kulukhuni kuwe ukukhahlela izinkandi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.14",
            "verseOrgIds": [
              "ACT.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
