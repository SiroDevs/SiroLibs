          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.4",
            "verseOrgIds": [
              "ACT.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ababengazi kwasekuqaleni, uma befuna ukufakaza, ukuthi ngokwehlelo eliqine kakhulu lenkonzo yethu ngahamba ngingumFarisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.5",
            "verseOrgIds": [
              "ACT.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.5",
            "verseOrgIds": [
              "ACT.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalokhu ngimi futhi ngigwetshiwe ngenxa yethemba lesithembiso uNkulunkulu asinika okhokho bethu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.6",
            "verseOrgIds": [
              "ACT.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.6",
            "verseOrgIds": [
              "ACT.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezithemba ukufika kuso izizwe eziyishumi nambili zakithi, zikhonza uNkulunkulu masinyane imini nobusuku; Ngenxa yalelithemba, nkosi Agripha, ngimangalelwa ngabaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.7",
            "verseOrgIds": [
              "ACT.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.7",
            "verseOrgIds": [
              "ACT.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungani kucatshangwa ukuthi yinto engakholeki kini, ukuthi uNkulunkulu uvusa abafileyo na?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mina-ke ngangicabanga ngokwami ukuthi ngifanele ukwenza izinto ezinengi eziphambene lebizo likaJesu waseNazaretha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokho nami ngakwenza eJerusalema; abaningi kwabangcwele ngabavalela etilongweni, ngithole amandla kubapristi abakhulu; futhi lapho bebulawa, ngazwakalisa izwi lami ngokumelene nabo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.10",
            "verseOrgIds": [
              "ACT.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.10",
            "verseOrgIds": [
              "ACT.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasemasinagogeni onke ngabajezisa kaningi, ngibacindezela ukuba bahlambalaze; futhi njengoba ngibathukuthelele kakhulu, ngabazingela kwaze kwaba semizini yabezizwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwathi lapho ngiya eDamaseku nginegunya nokuthunywa kubapristi abakhulu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.12",
            "verseOrgIds": [
              "ACT.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.12",
            "verseOrgIds": [
              "ACT.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emini enkulu, nkosi, ngisendleleni ngabona ukukhanya okuvela ezulwini okungaphezu kokukhanya kwelanga, kungikhanyisa nxazonke zami nababehamba nami.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.13",
            "verseOrgIds": [
              "ACT.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
