        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indlela yami yokuphila kwasebusheni bami ekuqaleni eyayiphakathi kwesizwe sakithi eJerusalema ayazi bonke abaJuda;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.4",
            "verseOrgIds": [
              "ACT.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
