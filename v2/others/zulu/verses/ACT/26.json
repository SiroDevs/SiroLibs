          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngikukhulula kubantu nakwabezizwe, engikuthuma kubo manje.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
            ]
          }
