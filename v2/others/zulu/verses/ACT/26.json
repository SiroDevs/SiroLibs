          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha sukuma, ume ngezinyawo zakho, ngokuba ngibonakale kuwe ngalokho ukuba ngikwenze ube yisikhonzi nofakazi walezi zinto ozibonileyo nowalezo zinto engizakuzibonakalisa kuwe ngazo;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        }
      ]
    },
