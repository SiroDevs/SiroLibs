          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanye kubo kwakungamadoda aseKhupro naseKhurene, abathi sebefikile e-Antiyokiya, bakhuluma kumaGreki, beshumayela ivangeli ngeNkosi uJesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.20",
            "verseOrgIds": [
              "ACT.11.20"
            ]
