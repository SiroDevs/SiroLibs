              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekusukuma omunye wabo obizo lakhe lingu-Agabu, watshengisa ngoMoya ukuthi kuzakuba khona indlala enkulu emhlabeni wonke;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.28",
            "verseOrgIds": [
