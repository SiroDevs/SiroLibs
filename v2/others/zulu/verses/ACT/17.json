          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazihlupha izixuku nababusi bedolobha bezwa lokho.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.8",
            "verseOrgIds": [
              "ACT.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
