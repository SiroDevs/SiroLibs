        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebedabule i-Amfipholi ne-Apholoniya, bafika eThesalonika, lapho kwakukhona isinagoge labaJuda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.1",
            "verseOrgIds": [
              "ACT.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.1",
            "verseOrgIds": [
              "ACT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawuli njengomkhuba wakhe wangena kubo, lamasabatha amathathu wabonisana labo ngemibhalo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.2",
            "verseOrgIds": [
              "ACT.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
