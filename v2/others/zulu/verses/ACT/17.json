        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona masinyane abazalwane bamukisa uPawulu ukuba ahambe ngaselwandle, kepha oSila noThimothewu basala.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.14",
            "verseOrgIds": [
              "ACT.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.14",
            "verseOrgIds": [
              "ACT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
