            "style": "v",
            "sid": "ACT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.12",
            "verseOrgIds": [
              "ACT.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwathi abaJuda baseThesalonika sebezwile ukuthi ilizwi likaNkulunkulu litshunyayelwe nguPawuli eBereya, beza lakhona, bavusa ixuku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.13",
            "verseOrgIds": [
              "ACT.17.13"
            ]
          }
        }
      ]
    },
    {
