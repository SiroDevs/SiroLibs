          "type": "text",
          "attrs": {
            "verseId": "ACT.17.16",
            "verseOrgIds": [
              "ACT.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho waxoxa esinagogeni nabaJuda nabamesabayo, nasesigcawini imihla ngemihla nababehlangana naye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.17",
            "verseOrgIds": [
              "ACT.17.17"
            ]
          }
        }
      ]
