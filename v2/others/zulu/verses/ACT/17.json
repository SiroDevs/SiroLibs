          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.6",
            "verseOrgIds": [
              "ACT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "abamamukele uJasoni; bonke laba benza okuphambene nezimiso zikaKesari, bethi kukhona enye inkosi, uJesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.7",
            "verseOrgIds": [
              "ACT.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
