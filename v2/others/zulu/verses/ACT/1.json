          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba wayebalwa nathi, wazuza ingxenye yalo msebenzi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        }
      ]
