              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "UPawuli wahlala iminyaka emibili egcweleyo endlini yakhe ayeyiqatshile, wemukela bonke ababeza kuye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
            "verseOrgIds": [
              "ACT.28.30"
            ]
          }
        }
