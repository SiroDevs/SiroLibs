          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha sithanda ukuzwa ngawe ukuthi yini oyicabangayo, ngokuba ngaleli hlelo siyazi ukuthi liyaphikiswa ezindaweni zonke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.22",
            "verseOrgIds": [
              "ACT.28.22"
            ]
          }
        }
