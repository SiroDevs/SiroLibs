          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanye bakholwa yilokho okwakhulunywayo, kepha abanye kabakholwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.24",
            "verseOrgIds": [
              "ACT.28.24"
            ]
          }
        }
