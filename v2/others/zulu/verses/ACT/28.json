          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ngenxa yalokhu nginibizele ukulibona, ngikhulume lani, ngoba ngenxa yethemba likaIsrayeli ngibotshiwe ngamaketane.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.20",
            "verseOrgIds": [
              "ACT.28.20"
            ]
          }
