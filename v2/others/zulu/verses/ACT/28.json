          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi bengavumelananga phakathi kwabo, basuka uPawuli esekhulume ilizwi linye lokuthi: Ukhulume kuhle uMoya oNgcwele ngoIsaya umprofethi kokhokho bethu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.25",
            "verseOrgIds": [
              "ACT.28.25"
            ]
          }
        }
