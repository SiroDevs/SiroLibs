          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebemmisele usuku, kweza kuye abaningi endlini yakhe yezihambi; wabachasisela, wafakaza ngombuso kaNkulunkulu, ebancenga ngoJesu, ethatha emthethweni kaMozisi lakubaprofethi, kusukela ekuseni kwaze kwahlwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.23",
            "verseOrgIds": [
              "ACT.28.23"
            ]
          }
        }
      ]
    },
