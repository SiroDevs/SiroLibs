          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke makwazeke kini ukuthi usindiso lukaNkulunkulu luthunyelwa kwabezizwe, futhi bayakuzwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
              "ACT.28.28"
            ]
          }
        }
      ]
    },
