          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bethi kuye: “Thina asamukelanga ncwadi ngawe evela eJudiya, futhi akufikanga namunye wabazalwane owabika noma wakhuluma utho olubi ngawe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.21",
            "verseOrgIds": [
              "ACT.28.21"
            ]
          }
        }
      ]
    },
    {
