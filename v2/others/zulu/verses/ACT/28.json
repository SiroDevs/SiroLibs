          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esithi: Hamba uye kulababantu uthi: Ukuzwa lizakuzwa, kodwa kaliyikuqedisisa; nokubona nizakubona, ningabonisi;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.26",
            "verseOrgIds": [
              "ACT.28.26"
            ]
          }
        }
      ]
    },
