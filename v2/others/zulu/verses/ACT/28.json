              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshumayela umbuso kaNkulunkulu, efundisa izinto eziphathelene neNkosi uJesu Kristu ngesibindi esikhulu, engavinjelwa muntu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.31",
