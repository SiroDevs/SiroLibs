          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba inhliziyo yalaba bantu seyaba lukhuni, bezwa ngezindlebe zabo, bacimezile namehlo abo; funa babone ngamehlo, bezwe ngezindlebe, baqonde ngenhliziyo, baphenduke, ngibaphilise.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.27",
            "verseOrgIds": [
              "ACT.28.27"
            ]
          }
        }
      ]
    },
