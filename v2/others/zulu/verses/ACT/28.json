          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha abaJuda sebekuphikisa, ngacindezelwa ukuba ngilidlulisele kuKesari; kungeyisikho ukuthi bengifanele ukusola isizwe sakithi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.19",
            "verseOrgIds": [
              "ACT.28.19"
            ]
          }
