          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma nihlupheka ngenxa yokulunga, nibusisiwe;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        }
