            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilonembeza omuhle; ukuze kuthi lapho benihleba ngokungathi ningabenzi bokubi, bajabhe labo abaqamba amanga ukuziphatha kwenu okuhle kuKristu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        }
