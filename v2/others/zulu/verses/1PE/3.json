          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa ngcwelisani iNkosi uNkulunkulu ezinhliziyweni zenu, njalo lilungele ukuphendula wonke umuntu olibuza ngesizatho sethemba elikini, ngobumnene langokwesaba;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        }
      ]
    },
