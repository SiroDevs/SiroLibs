          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elokugcina manibe nomqondo munye nonke, nihawukelane, nithandane njengabazalwane, nihawukele, nibe nomusa;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        }
