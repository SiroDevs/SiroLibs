          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makagweme okubi, enze okuhle; makafune ukuthula, akulandele.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.11",
            "verseOrgIds": [
              "1PE.3.11"
            ]
