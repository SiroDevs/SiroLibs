          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokunjalo, bafazi, thobelani amadoda enu; ukuze kuthi, uma bekhona abangalilaleli izwi, bazuzwe ngaphandle kwezwi ngenkambo yabafazi;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        }
      ]
    },
