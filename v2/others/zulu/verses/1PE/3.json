          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ningaphindiseli okubi ngokubi, nokuthuka ngokuthuka, kodwa ngokuphambene nibusise; nazi ukuthi nabizelwa lokho, ukuze nidle ifa lesibusiso.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        }
      ]
