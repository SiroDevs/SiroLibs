          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuhloba kwenu makungabi ngokokwangaphandle, okokwaluka izinwele, nokokufaka igolide, noma okokwembatha izingubo;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        }
      ]
    },
    {
