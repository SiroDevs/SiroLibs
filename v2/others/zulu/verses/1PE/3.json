          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba amehlo eNkosi aphezu kwabalungileyo, nezindlebe zayo zisemikhulekweni yabo; kepha ubuso beNkosi bumelene nabenza okubi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        }
