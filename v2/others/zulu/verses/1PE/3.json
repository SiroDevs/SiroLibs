          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba kungcono ukuhlupheka ngokwenza okuhle, uma kuyintando kaNkulunkulu, kunokuhlupheka nenza okubi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
