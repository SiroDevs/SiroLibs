              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bingelelanani ngokwanga kothando. Ukuthula makube kini nonke enikuKristu Jesu. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
