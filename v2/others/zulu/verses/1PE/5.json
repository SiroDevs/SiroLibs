          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "melanani naye niqinile ekukholweni, nazi ukuthi zona lezi zinhlupheko ziyafezwa kubazalwane benu abasezweni.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.9",
            "verseOrgIds": [
              "1PE.5.9"
            ]
          }
        }
