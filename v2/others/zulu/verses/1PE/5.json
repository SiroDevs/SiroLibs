            "number": "10",
            "style": "v",
            "sid": "1PE 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uNkulunkulu womusa wonke owanibizela enkazimulweni yakhe yaphakade ngoKristu Jesu, senihluphekile isikhashana, uyakuniphelelisa, aniqinise, aniqinise, anisekele.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.10",
            "verseOrgIds": [
              "1PE.5.10"
            ]
          }
        }
      ]
    },
    {
