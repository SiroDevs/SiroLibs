          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalinganisa nazo amathalenta esiliva angamakhulu ayisithupha namashumi amahlanu namatalenta ayikhulu ezinto zesiliva namatalenta ayikhulu egolide;",
          "type": "text",
          "attrs": {
