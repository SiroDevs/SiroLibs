          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho abapristi namaLevi bathatha isisindo sesiliva negolide nezitsha ukuba bakuyise eJerusalema endlini kaNkulunkulu wethu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
      ]
    },
