        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulindeni, nikugcine, nize nikukale phambi kwabapristi abakhulu namaLevi nezinhloko zawoyise bakwa-Israyeli eJerusalema, emakamelweni endlu kaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        }
      ]
    },
