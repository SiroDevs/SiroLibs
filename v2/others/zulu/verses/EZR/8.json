          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nezitsha ezingamashumi amabili zegolide zamadarike ayinkulungwane; nezitsha ezimbili zethusi elicolekileyo, eziyigugu njengegolide.",
          "type": "text",
