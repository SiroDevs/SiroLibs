            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi ngolweshumi nambili lwenyanga yokuqala sasuka emfuleni i-Ahava saya eJerusalema; isandla sikaNkulunkulu wethu sasiphezu kwethu, wasikhulula esandleni sesitha nakulabo abalindile. Konje.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
