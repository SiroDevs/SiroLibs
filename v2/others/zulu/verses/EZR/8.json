          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngihlukanisa abayishumi nambili kubapristi abakhulu, oSherebiya, noHashabiya, nabafowabo abayishumi kanye nabo;",
          "type": "text",
          "attrs": {
