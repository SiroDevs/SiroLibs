          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngosuku lwesine kwalinganiswa isiliva negolide nezitsha zendlu kaNkulunkulu wethu ngesandla sikaMeremoti indodana ka-Uriya umpristi; kanye naye kwakungu-Eleyazare indodana kaFinehasi; kanye nabo kwakunguJozabadi indodana kaJeshuwa, noNowa, indodana kaBinuwi, amaLevi;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        }
      ]
