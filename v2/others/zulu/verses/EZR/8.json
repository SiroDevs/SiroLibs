              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emadodaneni kaFinehasi; emadodaneni ka-Itamari: emadodaneni kaDavide; Hattush.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
