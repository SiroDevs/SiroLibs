          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emadodaneni kaSeganja, emadodaneni kaFaro; uZakariya, enaye kwabhalwa ohlwini lozalo lwamadoda, ikhulu namashumi ayisihlanu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
