        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.16",
            "verseOrgIds": [
              "EZR.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 5:17"
          },
          "items": [
