          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nansi ikhophi yencwadi inkosi u-Aritahishashita eyayinika u-Ezra, umpristi, umbhali, umbhali wamazwi emiyalo kaJehova nezimiso zakhe ku-Israyeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        }
      ]
    },
    {
