          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalo lonke isiliva negolide ongalifumana kuso sonke isifunda saseBabele, kanye nomnikelo wesihle wabantu nowabapristi abavuma ukuhlabela indlu kaNkulunkulu wabo eseJerusalema;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        }
      ]
    },
