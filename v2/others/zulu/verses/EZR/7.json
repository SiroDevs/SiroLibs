            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikhipha umyalo wokuthi bonke abantu bakwa-Israyeli nabapristi babo namaLevi embusweni wami, abayothanda ukukhuphukela eJerusalema ngokuzithandela kwabo, kumelwe bahambe nawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
