        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Aritahishashita, inkosi yamakhosi, ku-Ezra umpristi, isazi somthetho kaNkulunkulu wezulu, ukuthula okupheleleyo nangaleso sikhathi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
