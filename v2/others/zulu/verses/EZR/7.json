          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze usheshe uthenge ngale mali izinkunzi, nezinqama, namawundlu, neminikelo yako yokudla, neminikelo yako yokuphuzwa, unikele ngakho e-altare lendlu kaNkulunkulu wenu eseJerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
