          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoba ngosuku lokuqala lwenyanga yokuqala waqala ukukhuphuka eBhabhiloni, futhi ngosuku lokuqala lwenyanga yesihlanu wafika eJerusalema, ngokwesandla esihle sikaNkulunkulu wakhe esasiphezu kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
