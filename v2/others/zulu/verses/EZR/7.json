          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba uthunywe yinkosi nabeluleki bayo abayisikhombisa ukuba uhlole uJuda neJerusalema ngokomthetho kaNkulunkulu wakho osesandleni sakho;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        }
      ]
    },
