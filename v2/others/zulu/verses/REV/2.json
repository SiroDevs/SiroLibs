          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyayazi imisebenzi yakho, nothando, nokukhonza, nokukholwa, nokubekezela kwakho, nemisebenzi yakho; futhi abokugcina babe baningi kunezokuqala.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.19",
