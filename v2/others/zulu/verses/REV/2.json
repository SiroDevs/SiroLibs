          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyo ingelosi yebandla lase-Efesu loba ukuthi: “Nakhu akushoyo ophethe izinkanyezi eziyisikhombisa esandleni sakhe sokunene, ohamba phakathi kwezinti zezibani eziyisikhombisa zegolide;",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.1",
            "verseOrgIds": [
              "REV.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.1",
            "verseOrgIds": [
              "REV.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyayazi imisebenzi yakho, nomshikashika wakho, nokubekezela kwakho, nokuthi ungebekezelele ababi;",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.2",
            "verseOrgIds": [
              "REV.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
