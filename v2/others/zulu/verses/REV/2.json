            "sid": "REV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabekezela, wabekezela, ngenxa yebizo lami wakhandleka, kawuphela amandla.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.3",
            "verseOrgIds": [
              "REV.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.3",
            "verseOrgIds": [
              "REV.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nginento ngawe, ngokuba uluyekile uthando lwakho lokuqala.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.4",
            "verseOrgIds": [
              "REV.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.4",
            "verseOrgIds": [
              "REV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho khumbula lapho uwe khona, uphenduke, wenze imisebenzi yakuqala; uma kungenjalo, ngizakuza kuwe masinyane, ngilususe uthi lwesibane sakho endaweni yalo, ngaphandle kokuthi uphenduke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.5",
            "verseOrgIds": [
              "REV.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.5",
            "verseOrgIds": [
              "REV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa unakho lokhu, ukuthi uyazizonda izenzo zamaNikolawu, engizizondayo lami.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.6",
            "verseOrgIds": [
              "REV.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.6",
            "verseOrgIds": [
              "REV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onendlebe makezwe lokho akushoyo uMoya emabandleni; Onqobayo ngiyakumnika ukuba adle kuwo umuthi wokuphila, ophakathi kwepharadesi likaNkulunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuyo ingelosi yebandla laseSmirna loba ukuthi: Nakhu akushoyo owokuqala nowokugcina, owayefile, futhi wabuye waphila;",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyayazi imisebenzi yakho, nosizi, nobumpofu, (kodwa ucebile) futhi ngiyakwazi nenhlamba yalabo abathi bangamaJuda, kanti bengesiwo, kodwa isinagoge likaSathane.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.9",
            "verseOrgIds": [
              "REV.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.9",
            "verseOrgIds": [
              "REV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungesabi lezinto ozahlupheka ngazo; khangela, uSathane uzaphosela abanye benu entolongweni, ukuze nilingwe; futhi niyakuba nosizi izinsuku eziyishumi: thembeka kuze kube sekufeni, futhi ngizokunika umqhele wokuphila.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.10",
            "verseOrgIds": [
              "REV.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.10",
            "verseOrgIds": [
              "REV.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onendlebe makezwe lokho akushoyo uMoya emabandleni; Onqobayo kayikulinyazwa ngukufa kwesibili.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.11",
            "verseOrgIds": [
              "REV.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.11",
            "verseOrgIds": [
              "REV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuyo ingelosi yebandla lasePhergamu loba ukuthi: “Nakhu akushoyo onenkemba ebukhali esika nhlangothi zombili;",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngiyayazi imisebenzi yakho, lalapho ohlala khona, lalapho isihlalo sikaSathane sikhona; njalo ulibambile ibizo lami, kawuphikanga ukholo lwami, langalezonsuku uAntipasi engumfakazi wami othembekileyo, owabulawa phakathi kwenu, lapho uSathane ehlala khona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha nginezinto eziyingcosana ngawe, ngokuba unabo lapho ababambe isifundiso sikaBileyamu owafundisa uBalaki ukuphonsa isikhubekiso phambi kwabantwana bakwa-Israyeli, ukuba badle okuhlatshelwe izithombe, benze ubufebe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanjalo nawe unababambisisa isifundiso samaNikolawu, into engiyizondayo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phendukani; uma kungenjalo, ngizakuza kuwe masinyane, ngilwe nabo ngenkemba yomlomo wami.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        }
      ]
    },
    {
