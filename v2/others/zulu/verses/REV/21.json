          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angibonanga ithempeli kuwo, ngokuba iNkosi uNkulunkulu uMninimandla onke neWundlu bayithempeli lawo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.22",
