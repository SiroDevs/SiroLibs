              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuzi awudingi ilanga nenyanga ukuba kukhanye kuwo, ngokuba inkazimulo kaNkulunkulu iyawukhanyisa, nokukhanya kwawo iWundlu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
