              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izizwe zabasindiswayo ziyakuhamba ekukhanyeni kwawo, namakhosi omhlaba aletha kuwo inkazimulo nodumo lwawo.",
          "type": "text",
