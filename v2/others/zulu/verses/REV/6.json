            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngibona lapho iWundlu livula olunye lwezimpawu, ngezwa esinye sezidalwa ezine eziphilayo sithi, njengezwi lokuduma: “Woza ubone!",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        }
      ]
    },
    {
