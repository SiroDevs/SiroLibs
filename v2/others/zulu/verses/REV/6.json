            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhosi omhlaba, nezikhulu, nezinduna, nezicebi, nabanamandla, nezigqila zonke, nabakhululekileyo, bacasha emihumeni nasemadwaleni ezintaba;",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        }
      ]
    },
