          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngibona lapho livula uphawu lwesithupha, bheka, kwaba khona ukuzamazama komhlaba okukhulu; ilanga laba mnyama njengendwangu yesaka yoboya, nenyanga yaba njengegazi;",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
