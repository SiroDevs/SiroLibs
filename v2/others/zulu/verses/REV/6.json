        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinkanyezi zezulu zawela emhlabeni, njengomkhiwane uvuthulula amakhiwane awo amadala, lapho unyakaziswa ngumoya onamandla.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        }
      ]
    },
