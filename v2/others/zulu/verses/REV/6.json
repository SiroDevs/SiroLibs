          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho livula uphawu lwesibili, ngezwa isidalwa sesibili esiphilayo sithi: Woza ubone.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        }
      ]
    },
    {
