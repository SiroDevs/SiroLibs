      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngibona, bheka, nanto ihhashi elimhlophe, nohlezi phezu kwalo wayenomnsalo; wanikwa umqhele, waphuma enqoba, futhi eyakunqoba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
    },
    {
