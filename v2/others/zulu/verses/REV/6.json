            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.9",
            "verseOrgIds": [
              "REV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base bememeza ngezwi elikhulu, bathi: “Koze kube nini, Nkosi, ongcwele noqinisileyo, ungahluleli uphindisele igazi lethu kwabakhileyo emhlabeni na?",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.10",
            "verseOrgIds": [
              "REV.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.10",
            "verseOrgIds": [
              "REV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Base benikwa bonke izingubo ezimhlophe; Kwathiwa kubo ukuthi basaphumule isikhashana, kuze kugcwaliseke nezinceku ezikanye nabo nabafowabo ababezobulawa njengabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
