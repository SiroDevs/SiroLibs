        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngibona, bheka, nanto ihhashi elimpofu nohlezi phezu kwalo igama lakhe lalinguKufa, neHayidese lamlandela. Banikwa amandla phezu kwengxenye yesine yomhlaba, ukubulala ngenkemba, nendlala, nangokufa, nangezilwane zomhlaba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
