          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "bathi ezintabeni nasemadwaleni: Welani phezu kwethu, nisifihle ebusweni balowo ohlezi esihlalweni sobukhosi nasolakeni lweWundlu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.16",
