          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho livula uphawu lwesihlanu, ngabona phansi kwe-altare imiphefumulo yababulewe ngenxa yezwi likaNkulunkulu nangenxa yobufakazi ababenabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.9",
            "verseOrgIds": [
              "REV.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 6:9"
          },
          "items": [
            {
              "text": "9",
