          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "esizweni sakwaSimeyoni abayizinkulungwane eziyishumi nambili, esizweni sakwaLevi abayizinkulungwane eziyishumi nambili, esizweni sakwa-Isakare abayizinkulungwane eziyishumi nambili,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
