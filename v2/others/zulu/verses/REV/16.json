        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyokuqala yahamba, yathululela isitsha sayo emhlabeni; kwasekuvela isilonda esibi esibuhlungu phezu kwabantu ababelophawu lwesilo, labo abakhonza umfanekiso waso.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
