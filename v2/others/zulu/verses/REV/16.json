        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
