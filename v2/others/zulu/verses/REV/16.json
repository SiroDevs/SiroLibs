            "sid": "REV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyesine yathululela isitsha sayo elangeni; lanikwa amandla okutshisa abantu ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        }
      ]
    },
    {
