          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngabona kuphuma emlonyeni kadrako, nasemlonyeni wesilo, nasemlonyeni womprofethi wamanga omoya abathathu abangcolileyo, befana namasele.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        }
