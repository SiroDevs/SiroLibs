          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyesihlanu yathululela isitsha sayo esihlalweni sobukhosi sesilo; nombuso wakhe waba mnyama; baluma ulimi lwabo ngenxa yobuhlungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        }
      ]
    },
    {
