              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyesithupha yathululela isitsha sayo emfuleni omkhulu u-Ewufrathe; amanzi awo atsha, ukuze ilungiswe indlela yamakhosi asempumalanga.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
