            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngase ngizwa ingelosi yamanzi ithi: “Ulungile, Nkosi, okhona nowayekhona nosekhona, ngokuba wahlulele kanje.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
