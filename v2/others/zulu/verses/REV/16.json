          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, ngiza njengesela; Ubusisiwe olindayo, ogcina izingubo zakhe, funa ahambe nqunu, babone ihlazo lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        }
