          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba bayimimoya yamademoni, eyenza izibonakaliso, ephumela emakhosini omhlaba wonke ukubabuthela ekulweni kosuku olukhulu lukaNkulunkulu uMninimandla onke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        }
