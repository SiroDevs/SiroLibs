            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahlambalaza uNkulunkulu wezulu ngenxa yobuhlungu babo nezilonda zabo, futhi abaphendukanga emisebenzini yabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
