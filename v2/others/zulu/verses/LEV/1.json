      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.10",
            "verseOrgIds": [
              "LEV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe alihlabe ohlangothini lwe-altare olungasenyakatho phambi kobuso bukaJehova; abapristi, amadodana ka-Aroni, bayochitha igazi lakhe phezu kwe-altare nxazonke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.11",
            "verseOrgIds": [
              "LEV.1.11"
            ]
          }
        }
      ]
    },
