        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.15",
            "verseOrgIds": [
              "LEV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe akha isivuno sawo kanye nezimpaphe zawo, akuphonse eceleni kwe-altare, ohlangothini olusempumalanga, endaweni yomlotha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.16",
            "verseOrgIds": [
              "LEV.1.16"
            ]
          }
        }
