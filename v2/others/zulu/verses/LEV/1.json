          "type": "text",
          "attrs": {
            "verseId": "LEV.1.14",
            "verseOrgIds": [
              "LEV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kumelwe awulethe e-altare, asuse ikhanda lawo, awuthungele ngomlilo e-altare; igazi lawo lichithelwe eceleni kwe-altare.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.15",
            "verseOrgIds": [
              "LEV.1.15"
            ]
          }
        }
      ]
    },
