            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wambiza uMose, wakhuluma kuye etendeni lokuhlangana, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.1",
            "verseOrgIds": [
              "LEV.1.1"
            ]
          }
        }
      ]
    },
    {
