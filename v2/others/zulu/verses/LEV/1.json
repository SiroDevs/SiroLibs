        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kumelwe ageze izibilini nezinyawo ngamanzi, futhi umpristi kumelwe akulethe konke akushise e-altare; kungumnikelo wokushiswa, umnikelo womlilo onephunga elimnandi kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        }
      ]
