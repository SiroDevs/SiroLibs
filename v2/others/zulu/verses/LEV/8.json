            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wathatha amafutha okugcoba, waligcoba itabernakele nakho konke okwakukulo, wakungcwelisa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
