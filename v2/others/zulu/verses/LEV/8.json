          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafafaza ngawo i-altare kasikhombisa, waligcoba i-altare nezinto zalo zonke, nomcengezi nesinqe sawo, ukulingcwelisa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.11",
            "verseOrgIds": [
              "LEV.8.11"
            ]
          }
        }
      ]
    },
