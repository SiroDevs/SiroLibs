          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayesethi kuyo inhlangano: “Nansi into uJehova ayala ngayo ukuba yenziwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
