          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thatha u-Aroni namadodana akhe kanye naye, nezingubo, namafutha okugcoba, nenkunzi yomnikelo wesono, nezinqama ezimbili, neqoma lesinkwa esingenamvubelo;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.2",
            "verseOrgIds": [
              "LEV.8.2"
            ]
          }
        }
      ]
    },
    {
