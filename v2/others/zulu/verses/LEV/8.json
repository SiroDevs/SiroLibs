        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waletha inkunzi yomnikelo wesono; u-Aroni namadodana akhe babeka izandla zabo enhloko yenkunzi yomnikelo wesono.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.14",
            "verseOrgIds": [
              "LEV.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
