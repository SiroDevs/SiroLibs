          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamembathisa ingubo, wambhincisa ibhande, wamembathisa ingubo, wamfaka indwangu yasehlombe, wambhincisa indwangu yasehlombe, wambopha ngayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.7",
            "verseOrgIds": [
              "LEV.8.7"
            ]
          }
        }
      ]
    },
    {
