              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengokwenza kwakhe lamuhla, njalo iN kosi yalaya ukuthi kwenziwe ukulenenzele ukubuyisana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
