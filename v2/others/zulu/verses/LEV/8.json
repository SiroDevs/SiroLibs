        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waletha inqama yomnikelo wokushiswa; u-Aroni namadodana akhe babeka izandla zabo enhloko yenqama.",
          "type": "text",
