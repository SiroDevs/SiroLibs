          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafaka isitsha sesifuba; wafaka ne-Urimi neThumimi esihlangwini sesifuba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        }
      ]
    },
    {
