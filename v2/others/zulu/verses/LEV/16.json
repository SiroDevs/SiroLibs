              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapho eseqedile ukwenzela indlu engcwele isihlawulelo, netende lokuhlangana ne-altare, kumelwe alethe impongo ephilayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
