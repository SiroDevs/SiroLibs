          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkunzi yomnikelo wesono nembuzi yomnikelo wesono okugazi lazo langeniswa ukuze kwenziwe isihlawulelo endlini engcwele, kumelwe akukhiphele ngaphandle kwekamu; bashise izikhumba zazo nenyama yazo nomswani wazo ngomlilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
