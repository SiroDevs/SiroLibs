          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe enzele indlu engcwele isihlawulelo, enzele itende lokuhlangana ne-altare isihlawulelo, enzele abapristi nabo bonke abantu benhlangano isihlawulelo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        }
      ]
    },
