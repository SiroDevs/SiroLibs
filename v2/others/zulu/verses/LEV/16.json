          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osishisayo kumelwe ahlanze izingubo zakhe futhi ageze umzimba wakhe ngamanzi, ngemva kwalokho kumelwe angene ekamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
