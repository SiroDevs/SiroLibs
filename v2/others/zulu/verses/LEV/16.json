            "sid": "LEV 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "U-Aroni kumelwe angene etendeni lokuhlangana akhumule izingubo zelineni azigqokile lapho engena endlini engcwele, azishiye lapho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
