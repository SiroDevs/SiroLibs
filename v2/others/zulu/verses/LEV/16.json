          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi azomgcoba futhi amngcwelise ukuba akhonze esikhundleni sobupristi esikhundleni sikayise, kumelwe enze isihlawulelo futhi embathe izingubo zelineni, okuyizingubo ezingcwele.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        }
      ]
    },
