            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe kube isabatha lokuphumula kini, futhi kumelwe nihluphe imiphefumulo yenu ngokwesimiso esiphakade.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        }
      ]
    },
    {
