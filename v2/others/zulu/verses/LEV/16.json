          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impongo iyothwala phezu kwayo bonke ububi babo, iye ezweni elingahlalwa muntu; futhi uyoyikhulula impongo ehlane.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
