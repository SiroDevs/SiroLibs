          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe afafaze elinye legazi ngomunwe wakhe phezu kwalo kasikhombisa futhi alihlanze futhi alingcwelise ekungcoleni kwabantwana bakwa-Israyeli.",
          "type": "text",
