              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowo odedela impongo ka-Azazeli uyakuhlanza izingubo zakhe, ageze umzimba wakhe ngamanzi, angene ekamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
