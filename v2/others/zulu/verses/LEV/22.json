              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wakhuluma kuMose, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
