            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisho ku-Aroni nakumadodana akhe nakubo bonke abantwana bakwa-Israyeli, uthi kubo: ‘Yilowo nalowo owendlu ka-Israyeli noma owezizweni kwa-Israyeli uyini umnikelo wakhe wokudla kuzo zonke izithembiso zakhe nakuyo yonke iminikelo yakhe yesihle anikela ngayo. Bayakunikela kuJehova njengomnikelo wokushiswa;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        }
      ]
