          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izwe liyangcoliswa; ngalokho ngiyakuhambela ububi bakhe phezu kwalo, izwe liyabakhafula abakhileyo kulo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
        }
