              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuluma kubantwana bakoIsrayeli uthi kubo: NgiyiNkosi uNkulunkulu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.2",
