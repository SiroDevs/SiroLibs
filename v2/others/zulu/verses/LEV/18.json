              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ungasondeli kowesifazane ukuze uveze ihlazo lakhe, uma nje eyedwa ngenxa yokungcola kwakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
