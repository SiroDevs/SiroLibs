          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungalidaluli ihlazo likayihlo nehlazo likanyoko; ungunyoko; ungalidaluli ihlazo lakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        }
      ]
