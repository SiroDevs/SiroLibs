          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyakwenza izimiso zami, nigcine izimiso zami, nihambe ngazo; nginguJehova uNkulunkulu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.4",
            "verseOrgIds": [
              "LEV.18.4"
