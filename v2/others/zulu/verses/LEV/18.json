          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aniyikulala naso isilwane ukuba ningcoliswe ngaso; akuyikuma phambi kwesilwane ukuba alale kuso; yikudideka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
