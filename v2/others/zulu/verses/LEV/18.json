          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukuze izwe linganikhafuli, uma nilingcolisa, njengalokho laphalaza izizwe ezaziphambi kwenu.",
          "type": "text",
          "attrs": {
