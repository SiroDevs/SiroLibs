          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengokwezenzo zezwe laseGibithe enahlala kulo, aniyikwenza; futhi ningenzi njengokwenza kwezwe laseKhanani enginiyisa kulo; futhi aniyikuhamba ngezimiso zabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.3",
            "verseOrgIds": [
              "LEV.18.3"
            ]
