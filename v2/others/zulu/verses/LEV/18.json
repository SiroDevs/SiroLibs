          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungavumeli noyedwa wenzalo yakho ukuba adabule uMoloki emlilweni, ungahlambalazi igama likaNkulunkulu wakho. Mina nginguJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
