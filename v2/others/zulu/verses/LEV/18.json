        {
          "text": "Ihlazo lendodakazi yendodana yakho noma lendodakazi yendodakazi yakho, ungalidaluli ihlazo labo, ngokuba bayihlazo kuwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
