          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningazingcolisi nganoma iyiphi yalezo zinto, ngokuba ngazo zonke lezi izizwe engizixosha phambi kwenu zingcolisiwe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.24",
            "verseOrgIds": [
              "LEV.18.24"
            ]
          }
        }
      ]
