          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphezu kwalokho, akufanele ulale nomkamakhelwane wakho ukuze ungcoliswe ngaye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
