          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe nigcine izimiso zami nezahlulelo zami, ningenzi neyodwa yalezi zinengiso; kungabi khona owesizwe sakini, noma umfokazi ogogobeleyo phakathi kwenu;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26",
            "verseOrgIds": [
              "LEV.18.26"
            ]
          }
        }
