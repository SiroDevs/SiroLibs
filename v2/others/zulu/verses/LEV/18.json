          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makungabikho noyedwa kini osondela koyisihlobo sakhe ukuze adalule ihlazo lakhe; nginguJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        }
