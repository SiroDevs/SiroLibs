          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakubeka isandla sakhe enhloko yomnikelo wakhe, awuhlabe ngasemnyango wetende lokuhlangana; amadodana ka-Aroni, abapristi, afafaze i-altare ngegazi nxazonke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
