          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woletha umnikelo womlilo kuJehova ovela emnikelweni wokubonga; amanoni asibekela izibilini, nawo onke amanoni aphezu kwezibilini;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        }
