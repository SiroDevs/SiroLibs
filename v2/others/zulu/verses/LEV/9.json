              "type": "text"
            }
          ]
        },
        {
          "text": "Namanoni enkunzi nawenqama, nomlenze, namanoni asibekela izibilini, nezinso, namanoni esibindi;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
