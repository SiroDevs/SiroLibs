          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waletha umnikelo womlilo, wagcwalisa isandla kuwo, wawushisa e-altare, ngomnikelo wokushiswa wasekuseni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.17",
            "verseOrgIds": [
              "LEV.9.17"
            ]
          }
        }
      ]
