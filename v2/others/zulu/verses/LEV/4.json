          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalunga enhlangano kumelwe abeke izandla zawo enhloko yenkunzi phambi kukaJehova, futhi inkunzi kumelwe ihlatshwe phambi kukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        }
      ]
    },
