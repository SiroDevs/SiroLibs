              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.1",
            "verseOrgIds": [
              "LEV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshono ebantwaneni bakoIsrayeli uthi: Uba umuntu wona ngokungazi emithetho ye Nkosi engayikwenziwa, enze komunye wayo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umpristi ogcotshiweyo ona njengesono sabantu; woletha kuJehova iduna elingenasici, libe ngumnikelo wesono ngesono sakhe one ngaso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe alethe inkunzi emnyango wetende lokuhlangana phambi kukaJehova; futhi kumelwe abeke isandla sakhe enhloko yenkunzi ayihlabe inkunzi phambi kukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi ogcotshiweyo kumelwe athathe igazi lenkunzi alilethe etendeni lokuhlangana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.5",
            "verseOrgIds": [
              "LEV.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.5",
            "verseOrgIds": [
              "LEV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi agcobhoze umunwe wakhe egazini, afafaze ngegazi kasikhombisa phambi kukaJehova, phambi kwesihenqo sendlu engcwele.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpristi kumelwe abhece elinye igazi ezimpondweni zempepho phambi kukaJehova osetendeni lokuhlangana; lonke igazi lenkunzi kumelwe lithululwe esinqeni se-altare lomnikelo wokushiswa elisemnyango wetende lokuhlangana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe asuse wonke amanoni enkunzi yomnikelo wesono; amanoni asibekela izibilini, nawo onke amanoni aphezu kwezibilini;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.8",
            "verseOrgIds": [
              "LEV.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.8",
            "verseOrgIds": [
              "LEV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izinso zombili namanoni akuzo, asezindaweni, nengqamuzana eliphezu kwesibindi, kanye nezinso;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.9",
            "verseOrgIds": [
              "LEV.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.9",
            "verseOrgIds": [
              "LEV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njengalokho kwathathwa enkunzini yomnikelo wokuthula, umpristi uyakuyishisa e-altare lomnikelo wokushiswa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.10",
            "verseOrgIds": [
              "LEV.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.10",
            "verseOrgIds": [
              "LEV.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nesikhumba senkunzi, nayo yonke inyama yalo, nekhanda layo, namathambo alo, nezibilini zalo, nomswani walo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.11",
            "verseOrgIds": [
              "LEV.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.11",
            "verseOrgIds": [
              "LEV.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngisho nenkunzi yonke kumelwe ayikhiphele ngaphandle kwekamu endaweni ehlanzekile lapho kulahlwa khona umlotha, futhi kumelwe ayishise phezu kwezinkuni ngomlilo; lapho okulahlwa khona umlotha, kumelwe ashiswe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma inhlangano yonke yakwa-Israyeli yona ngokungazi, le ndaba isithekile emehlweni enhlangano, benze utho okuphambene nanoma yimuphi wemiyalo kaJehova okungafanele kwenziwe, benecala;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.13",
            "verseOrgIds": [
              "LEV.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 4:13"
          },
          "items": [
