            "number": "14",
            "style": "v",
            "sid": "LEV 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkhipheni othukile ngaphandle kwekamu; bonke abamuzwayo mababeke izandla zabo ekhanda lakhe, futhi lonke ibandla limkhande ngamatshe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.14",
            "verseOrgIds": [
              "LEV.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
