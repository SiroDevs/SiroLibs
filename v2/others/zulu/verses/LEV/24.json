              "LEV.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyakukhuluma kubantwana bakwa-Israyeli, uthi: ‘Yilowo nalowo othuka uNkulunkulu wakhe uyakuthwala isono sakhe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.15",
            "verseOrgIds": [
              "LEV.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.15",
            "verseOrgIds": [
              "LEV.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohlambalaza igama likaJehova wobulawa nokubulawa, inhlangano yonke imkhande ngamatshe; kokubili umfokazi nowokuzalwa ezweni, lapho ehlambalaza iGama leNkosi, uyabulawa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.16",
            "verseOrgIds": [
              "LEV.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.16",
            "verseOrgIds": [
              "LEV.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi obulala umuntu kumelwe abulawe nokubulawa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.17",
            "verseOrgIds": [
              "LEV.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
