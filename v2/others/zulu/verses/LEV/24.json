          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.1",
            "verseOrgIds": [
              "LEV.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yala abantwana bakwa-Israyeli ukuba balethe kuwe amafutha acwengekileyo agqunyiwe okukhanyisa ukuze izibani zivutha njalo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.2",
            "verseOrgIds": [
              "LEV.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.2",
            "verseOrgIds": [
              "LEV.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaphandle kwesihenqo sobufakazi etendeni lokuhlangana u-Aroni uyakuyala njalo, kusukela kusihlwa kuze kube sekuseni phambi kukaJehova; kuyakuba yisimiso esiphakade ezizukulwaneni zenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe abeke izibani othini lwesibani oluhlanzekile njalo phambi kukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe uthathe ufulawa ocolekileyo ubhake kuwo amaqebelengwane ayishumi nambili; okweshumi okubili kufanele kube ekhekheni elilodwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wowabeka abe yizinhlu ezimbili, ayisithupha emugqeni wawo, phezu kwetafula elihlanzekile phambi kukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumelwe ubeke impepho ehlanzekile ohlwini ngalunye, ibe phezu kwesinkwa, ibe yisikhumbuzo, umnikelo womlilo kuJehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isabatha ngalinye uyakukuhlela phambi kukaJehova njalo, kususwe kubantwana bakwa-Israyeli ngesivumelwano esiphakade.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
              "LEV.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
              "LEV.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyakuba ngelika-Aroni nelamadodana akhe; bayakukudla endaweni engcwele, ngokuba kungcwelengcwele kuye okuvela eminikelweni yomlilo kaJehova njengesimiso esiphakade.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodana yowesifazane wakwa-Israyeli uyise engowaseGibithe yaphuma phakathi kwabantwana bakwa-Israyeli;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.10",
            "verseOrgIds": [
              "LEV.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.10",
            "verseOrgIds": [
              "LEV.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indodana yowesifazane wakwa-Israyeli yahlambalaza, yathuka iGama leNkosi. Bamyisa kuMose; igama likanina lalinguShelomoti, indodakazi kaDibri, wesizwe sakwaDani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.11",
            "verseOrgIds": [
              "LEV.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.11",
            "verseOrgIds": [
              "LEV.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basebemfaka esitokisini, ukuze kwaziwe kubo imicabango yeNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.12",
            "verseOrgIds": [
              "LEV.24.12"
            ]
          }
        }
      ]
    },
