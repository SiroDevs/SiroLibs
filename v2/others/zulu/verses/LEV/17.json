        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uma engazigezi futhi engawugezi umzimba wakhe; khona izathwala ububi bayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.16",
            "verseOrgIds": [
              "LEV.17.16"
            ]
