        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilowo nalowo muntu odla okuzifeleyo noma okudweshulwe emfuyweni, kungakhathaliseki ukuthi ungowakubo noma ungowemzini, kumelwe ahlanze izingubo zakhe, ageze ngamanzi, abe ngongcolile kuze kube yileso sikhathi uyoba ongcolile iIhlanzekile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        }
      ]
    },
