            "sid": "LEV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wothi kubo: Yilowo nalowo wendlu yakwa-Israyeli noma owezizwe ohlala njengowezizwe phakathi kwenu oletha umnikelo wokushiswa noma umhlatshelo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
