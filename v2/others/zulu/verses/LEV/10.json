          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "UMose wayifunisisa impongo, bheka, yayishisiwe, wabathukuthelela u-Eleyazare no-Itamari, amadodana ka-Aroni ayesele, wathi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.16",
            "verseOrgIds": [
              "LEV.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.16",
            "verseOrgIds": [
              "LEV.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungani ningawudli umnikelo wesono endaweni engcwele, lokhu ungcwelengcwele, futhi uNkulunkulu waninika wona ukuba nithwale ububi benhlangano ukuba niwenzele ukubuyisana phambi kukaJehova na?",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
