            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalezo zinsuku kwafika uJohane uMbhapathizi, eshumayela ehlane laseJudiya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        }
      ]
    },
