          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu waphendula wathi kuye: Vuma kalokhu, ngokuba kusifanele ukugcwalisa kanjalo ukulunga konke. Wase emvumela.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        }
      ]
    },
