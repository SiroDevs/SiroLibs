        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona uJesu wafika eJordani evela eGalile kuJohane ukuba abhapathizwe nguye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa uJohane wamalela, esithi: Mina ngiswela ukubhabhathizwa nguwe, kanti wena uza kimi yini?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.14",
            "verseOrgIds": [
              "MAT.3.14"
            ]
          }
        }
      ]
    },
    {
