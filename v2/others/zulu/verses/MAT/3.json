          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, kwavela izwi ezulwini, lithi: “Lo uyiNdodana yami ethandekayo engithokozile ngayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
