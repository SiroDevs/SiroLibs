        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kwathi ebona abanengi babaFarisi labaSadusi besiza ekubhabhathizeni kwakhe, wathi kubo: Nzalo yezinyoka, ngubani olixwayisile ukubalekela ulaka oluzayo?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.7",
            "verseOrgIds": [
              "MAT.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.7",
            "verseOrgIds": [
              "MAT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho vezani izithelo ezifanele ukuphenduka;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.8",
            "verseOrgIds": [
              "MAT.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
