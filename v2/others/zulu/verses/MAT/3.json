        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.11",
            "verseOrgIds": [
              "MAT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwelo lwakhe lusesandleni sakhe, aze ahlanze isibuya sakhe, abuthele ukolweni wakhe enqolobaneni; kepha amakhoba uyakuwashisa ngomlilo ongacimekiyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
