        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.6",
            "verseOrgIds": [
              "MAT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
