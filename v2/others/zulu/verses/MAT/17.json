          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emva kwezinsuku eziyisithupha uJesu wathatha oPetru, noJakobe, noJohane umfowabo, wakhuphukela nabo entabeni ende bebodwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.1",
            "verseOrgIds": [
              "MAT.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
