        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.13",
            "verseOrgIds": [
              "MAT.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwathi sebefikile exukwini, kweza kuye indoda ethile, yaguqa phambi kwakhe, yathi:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.14",
            "verseOrgIds": [
              "MAT.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.14",
            "verseOrgIds": [
              "MAT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkosi, hawukela indodana yami, ngokuba inosathane, ikhathazekile; ngokuba iwela kaningi emlilweni, kaningi emanzini.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.15",
            "verseOrgIds": [
              "MAT.17.15"
            ]
          }
        }
      ]
    },
    {
