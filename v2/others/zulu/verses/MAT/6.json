          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho ningakhathazeki nithi: Siyakudlani na? noma: Siyakuphuzani na? noma: Siyakwembatha ngani na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        }
      ]
    },
