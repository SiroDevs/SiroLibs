            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma ningathetheleli abantu iziphambeko zabo, noYihlo akayikunithethelela iziphambeko zenu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.15",
            "verseOrgIds": [
              "MAT.6.15"
            ]
          }
        }
