          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usithethelele amacala ethu, njengalokhu nathi sibathethelela abanamacala kithi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.12",
            "verseOrgIds": [
              "MAT.6.12"
            ]
          }
        }
      ]
    },
