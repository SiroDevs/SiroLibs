              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.23",
            "verseOrgIds": [
              "MAT.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakho ongakhonza amakhosi amabili, ngokuba uyakuzonda enye, athande enye; noma ibambelele kwenye, idelele enye. Anikwazi ukukhonza uNkulunkulu noMamona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.24",
            "verseOrgIds": [
              "MAT.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.24",
            "verseOrgIds": [
              "MAT.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho ngithi kini: Ningakhathazeki ngokuphila kwenu, ukuthi niyakudlani noma niyakuphuzani; nomzimba wenu ukuthi niyakwembathani. Ukuphila kakukhulu yini kunokudla, nomzimba kunesambatho?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhekani izinyoni zezulu, ngokuba azihlwanyeli, azivuni, azibutheli eziphaleni; nokho uYihlo osezulwini uyazondla. Anizincono kakhulu na?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
