          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho anokhuleka kanje: Baba wethu osezulwini, malingcweliswe igama lakho.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.9",
            "verseOrgIds": [
              "MAT.6.9"
            ]
          }
        }
      ]
    },
    {
