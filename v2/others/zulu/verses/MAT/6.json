            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba konke lokho abezizwe bayakufuna; ngokuba uYihlo osezulwini uyazi ukuthi niyakudinga lokho konke.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        }
      ]
    },
