          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.21",
            "verseOrgIds": [
              "MAT.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isibani somzimba yiso; ngakho uma iso lakho lilihle, umzimba wakho wonke uyakuba nokukhanya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha uma iso lakho lilibi, umzimba wakho wonke uyakuba mnyama. Ngakho uma ukukhanya okukuwe kungubumnyama, bukhulu kangakanani lobo bumnyama!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.23",
            "verseOrgIds": [
              "MAT.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
