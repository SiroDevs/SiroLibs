          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungasingenisi ekulingweni, kodwa usikhulule kokubi, ngokuba umbuso ungowakho, namandla, nenkazimulo, kuze kube phakade. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.13",
            "verseOrgIds": [
              "MAT.6.13"
            ]
          }
        }
      ]
