          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa funani kuqala umbuso kaNkulunkulu lokulunga kwakhe; futhi zonke lezi zinto ziyakwenezelwa nina.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        }
      ]
    },
