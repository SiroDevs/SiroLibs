              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningazibekeleli ingcebo emhlabeni, lapho inundu nokugqwala konakalisa khona, nalapho amasela efohla khona, ebe;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        }
