          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nizikhathazelani ngesambatho na? Cabangani ngeminduze yasendle, ukuthi imila kanjani; azikhandleki, aziphothi;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
              "MAT.6.28"
            ]
          }
        }
      ]
    },
