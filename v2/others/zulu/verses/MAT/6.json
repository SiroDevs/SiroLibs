        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngokuba lapho kukhona ingcebo yenu, nenhliziyo yenu iyakuba-khona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.21",
            "verseOrgIds": [
              "MAT.6.21"
            ]
          }
        }
