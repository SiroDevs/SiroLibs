          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiphe lamuhla isinkwa sethu sensuku zonke;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.11",
            "verseOrgIds": [
              "MAT.6.11"
            ]
          }
        }
      ]
