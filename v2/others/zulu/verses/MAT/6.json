              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho-ke ningakhathazeki ngengomuso, ngokuba ikusasa liyazihlupha ngokwalo. Banele usuku ububi balo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.34",
            "verseOrgIds": [
              "MAT.6.34"
            ]
          }
        }
