          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbuso wakho mawufike. Mayenziwe intando yakho emhlabeni njengasezulwini.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.10",
            "verseOrgIds": [
              "MAT.6.10"
            ]
          }
        }
      ]
