          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha ngithi kini: NoSolomoni ebukhazikhazini bakhe bonke wayengembathisile okomunye wayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
            "verseOrgIds": [
              "MAT.6.29"
            ]
          }
        }
      ]
