          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebembonile bakhuleka kuye, kodwa abanye bangabaza.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.17",
            "verseOrgIds": [
              "MAT.28.17"
            ]
          }
        }
      ]
    },
