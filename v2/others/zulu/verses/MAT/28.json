          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.16",
            "verseOrgIds": [
              "MAT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
