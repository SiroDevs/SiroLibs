          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJesu wasondela wakhuluma kubo, wathi: “Ngiphiwe amandla onke ezulwini nasemhlabeni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
            "verseOrgIds": [
              "MAT.28.18"
            ]
          }
        }
      ]
