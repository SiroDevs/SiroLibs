          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma kuzwakala lokho kumbusi, siyakuncenga thina, sinivikele.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.14",
            "verseOrgIds": [
              "MAT.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
