          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodwa kungabi njalo phakathi kwenu, kodwa loba ngubani ofuna ukuba mkhulu phakathi kwenu kabe yisikhonzi senu;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
