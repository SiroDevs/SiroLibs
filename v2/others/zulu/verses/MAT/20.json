          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isixuku sabakhuza ukuba bathule; kepha bamemeza kakhulu, bathi: “Sihawukele, Nkosi, Ndodana kaDavide!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
