          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: “Impela nizakuphuza indebe yami, nibhapathizwe ngombhapathizo engibhapathizwa ngawo mina; kulabo abakulungiselweyo nguBaba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        }
      ]
