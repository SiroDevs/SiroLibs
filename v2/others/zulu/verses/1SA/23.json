              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha kwafika isithunywa kuSawule, sathi: “Shesha uze; ngoba amaFilisti ayelihlasele ilizwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
