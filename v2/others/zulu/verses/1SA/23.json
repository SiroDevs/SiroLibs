          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "USawuli labantu bakhe laye bahamba ukuyamdinga. Bamtshela uDavide, bathi: “Wafika edwaleni, wahlala ehlane laseMawoni. USawule ekuzwa lokho wamxosha uDavide ehlane laseMahoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
