          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyakuthatha izinceku zenu nezincekukazi zenu nezinsizwa zenu ezinhle nezimbongolo zenu ikwenzele umsebenzi wayo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        }
