              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izathatha okwetshumi kwezimvu zenu, lina libe yizinceku zayo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.17",
