          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokhu kuyakuba yisibonakaliso kuwe esiyakwehlela amadodana akho omabili, phezu kukaHofini noFinehasi; ngelinye ilanga bayofa bobabili.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.34",
            "verseOrgIds": [
