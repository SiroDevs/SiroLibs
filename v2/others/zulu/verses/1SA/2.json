          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wathi kubo: “Nenzelani izinto ezinjalo na?” Ngoba ngiyezwa ngezenzo zakho ezimbi phakathi kwabo bonke lababantu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
