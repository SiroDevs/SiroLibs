          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJehova wamhambela uHana, wakhulelwa, wazala amadodana amathathu namadodakazi amabili. Umntwana uSamuweli wakhula phambi kukaJehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
