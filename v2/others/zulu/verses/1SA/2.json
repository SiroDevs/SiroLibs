        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi ngimkhethile yini kuzo zonke izizwe zakwa-Israyeli ukuba abe ngumpristi wami, anikele phezu kwami, akhuphule impepho, embathe indwangu yesaka phambi kobuso bami, na? Ngiyinikile indlu kayihlo yonke iminikelo yokushiswa yabantwana bakwa-Israyeli na?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
