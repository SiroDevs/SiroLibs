          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheka, izinsuku ziyeza engiyakunquma ngazo ingalo yakho nengalo yendlu kayihlo ukuba kungabikho xhegu endlini yakho;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        }
      ]
