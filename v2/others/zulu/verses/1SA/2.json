            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma umuntu ona komunye, umahluleli makamahlulele; kepha uma umuntu ona kuJehova, ngubani ongamlamulela na? Kodwa kabalilalelanga ilizwi lendoda, ngoba uJehova wayezababulala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        }
      ]
    },
    {
