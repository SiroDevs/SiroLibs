          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalokho usho uJehova uNkulunkulu ka-Israyeli, uthi: “Ngishilo nokusho ukuthi indlu yakho nendlu kayihlo iyakuhamba phambi kwami kuze kube phakade; kepha Jehova muntu, makube kude nami; Ngokuba abangidumisayo ngiyakubadumisa, nabangidelelayo bayakuba-delelekile.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        }
      ]
    },
