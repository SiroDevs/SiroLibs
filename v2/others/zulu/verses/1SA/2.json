          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wakini engingayikumbhubhisa kumama, uyakuqeda amehlo akho, enze inhliziyo yakho ibe lusizi;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        }
      ]
