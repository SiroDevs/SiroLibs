          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cha, madodana ami; ngokuba akusiwo umbiko omuhle engiwezwayo: nenza abantu bakaJehova ukuba baphambuke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
