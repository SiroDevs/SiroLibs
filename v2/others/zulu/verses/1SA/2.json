          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasekufika umuntu kaNkulunkulu kuEli, wathi kuye: “Usho kanje uJehova, uthi: ‘Ingabe ngabonakala nokubona endlini kayihlo beseseGibithe endlini kaFaro na?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        }
      ]
    },
