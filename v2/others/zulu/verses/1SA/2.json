          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungakho ukhahlela isisulu sami nomhlatshelo wami enginawo endaweni yami yokuhlala; nidumise amadodana enu ngaphezu kwami, ukuze nizikhukhumeze ngenhlokweni yemihlatshelo yonke yabantu bami u-Israyeli na?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
