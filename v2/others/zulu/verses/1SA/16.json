              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakho uSawule wathuma izithunywa kuJese, wathi: “Thumela kimi indodana yakho uDavide osemhlambini.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
