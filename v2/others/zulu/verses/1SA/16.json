          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "UJese wathatha imbongolo, ithweswe isinkwa, nesaka lewayini, nezinyane lembuzi, wakuthuma kuSawule ngoDavide indodana yakhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
