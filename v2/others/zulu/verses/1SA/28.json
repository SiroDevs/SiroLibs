            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Futhi uJehova uyakunikela no-Israyeli kanye nawe esandleni samaFilisti; kusasa wena namadodana akho niyakuba naMi; uJehova uyakunikela impi yakwa-Israyeli esandleni samaFilisti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        }
      ]
