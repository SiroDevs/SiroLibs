          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakuletha phambi kukaSawule naphambi kwezinceku zakhe; badla. Base besukuma bahamba ngalobo busuku.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.25",
