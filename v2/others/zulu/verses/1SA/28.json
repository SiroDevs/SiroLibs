        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owesifazana wasesiza kuSawuli, wabona ukuthi ukhathazekile kakhulu, wathi kuye: Khangela, incekukazi yakho ililalele ilizwi lakho, njalo nginikele impilo yami esandleni sami, ngalalela amazwi akho owawakhuluma kimi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.21",
            "verseOrgIds": [
              "1SA.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
