          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khona-ke uSawule wahle wawa phansi emhlabeni wonke, wesaba kakhulu ngenxa yamazwi kaSamuweli, kwakungekho mandla kuye; ngoba akadlanga sinkwa imini yonke nobusuku bonke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.20",
            "verseOrgIds": [
              "1SA.28.20"
            ]
          }
        }
      ]
    },
