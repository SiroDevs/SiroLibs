          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lalela futhi izwi lenceku yakho, ngibeke ucezu lwesinkwa phambi kwakho; udle, ukuze ube namandla ekuhambeni kwakho.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.22",
            "verseOrgIds": [
              "1SA.28.22"
            ]
          }
        }
      ]
