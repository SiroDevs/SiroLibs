            "number": "23",
            "style": "v",
            "sid": "1SA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepha wala wathi: “Angiyikudla.” Kodwa izinceku zakhe kanye nowesifazane bamcindezela; walalela izwi labo. Wavuka phansi wahlala embhedeni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
