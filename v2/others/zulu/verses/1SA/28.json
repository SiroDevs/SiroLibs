          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenxa yokuthi awulilalelanga izwi likaJehova, futhi awuvumelanga ukufutheka kwentukuthelo yakhe kuma-Amaleki, yingakho uJehova enze le nto kini namuhla.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        }
