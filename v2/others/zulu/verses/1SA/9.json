              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behla endaweni ephakemeyo beza emzini, uSamuweli wakhuluma kuSawule phezu kwendlu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
