          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "USamuweli wayesemthatha uSawule nenceku yakhe, wabangenisa endlini yokuphumula, wabahlalisa endaweni ephakemeyo phakathi kwabamenyiweyo, kungathi abantu abangamashumi amathathu.",
          "type": "text",
