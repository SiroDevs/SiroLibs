        {
          "text": "Okwathi kwezinye izikhathi okungakaziswanga kubantwana babantu, njengalokhu sekubonakalisiwe kubaphostoli bakhe abangcwele labaprofethi ngoMoya;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.5",
