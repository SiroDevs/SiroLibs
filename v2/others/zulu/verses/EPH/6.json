          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani bobaba, ningabathukuthelisi abantwana benu, kodwa nibondle ngokuyala nangokuqondisa kweNkosi.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
