          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kungabi ngokukhonza kwamehlo, njengabathokozisa abantu; kodwa njengezinceku zikaKristu, zenza intando kaNkulunkulu ngenhliziyo;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.6",
            "verseOrgIds": [
              "EPH.6.6"
            ]
          }
        }
