          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nina zinceku, thobelani abaphathi benu ngokwenyama, ngokwesaba nangokuthuthumela, ngobuqotho bezinhliziyo zenu, njengakuKristu;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.5",
            "verseOrgIds": [
              "EPH.6.5"
            ]
          }
        }
