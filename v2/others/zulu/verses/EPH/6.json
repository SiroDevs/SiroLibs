        {
          "text": "lisebenza ngenhliziyo enhle, kungathi lisebenzela iNkosi, hatshi abantu;",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.7",
            "verseOrgIds": [
              "EPH.6.7"
            ]
