          "text": "De quien",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "fué",
              "type": "text",
              "attrs": {
                "verseId": "1CH.3.11",
                "verseOrgIds": [
                  "1CH.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "hijo Joram, cuyo hijo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "fué",
              "type": "text",
              "attrs": {
                "verseId": "1CH.3.11",
                "verseOrgIds": [
                  "1CH.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ochôzias, hijo del cual",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "fué",
              "type": "text",
              "attrs": {
                "verseId": "1CH.3.11",
                "verseOrgIds": [
                  "1CH.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Joas;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        }
      ]
    },
