              "attrs": {
                "verseId": "1CH.3.13",
                "verseOrgIds": [
                  "1CH.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Achâz, del que",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.13",
            "verseOrgIds": [
              "1CH.3.13"
            ]
          }
        },
        {
