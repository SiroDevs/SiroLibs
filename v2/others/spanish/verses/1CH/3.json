                "verseId": "1CH.3.12",
                "verseOrgIds": [
                  "1CH.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": "hijo Amasías, cuyo hijo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.12",
            "verseOrgIds": [
              "1CH.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "fué",
