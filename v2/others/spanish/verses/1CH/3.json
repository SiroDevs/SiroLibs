          },
          "items": [
            {
              "text": "fué",
              "type": "text",
              "attrs": {
                "verseId": "1CH.3.14",
                "verseOrgIds": [
                  "1CH.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": "hijo Amón, cuyo hijo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.14",
            "verseOrgIds": [
              "1CH.3.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
