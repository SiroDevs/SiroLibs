              "attrs": {
                "verseId": "1CH.3.12",
                "verseOrgIds": [
                  "1CH.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Azarías, é hijo de éste Jotham;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.12",
            "verseOrgIds": [
              "1CH.3.12"
            ]
          }
        }
      ]
    },
