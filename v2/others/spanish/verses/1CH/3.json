          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "fué",
              "type": "text",
              "attrs": {
                "verseId": "1CH.3.13",
                "verseOrgIds": [
                  "1CH.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "hijo Ezechîas, cuyo hijo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.13",
            "verseOrgIds": [
              "1CH.3.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "fué",
              "type": "text",
              "attrs": {
                "verseId": "1CH.3.13",
                "verseOrgIds": [
                  "1CH.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Manasés;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.13",
            "verseOrgIds": [
              "1CH.3.13"
            ]
          }
        }
      ]
