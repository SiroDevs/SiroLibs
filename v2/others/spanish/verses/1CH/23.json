          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "fruta",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.29",
                "verseOrgIds": [
                  "1CH.23.29"
                ]
              }
            }
          ]
        },
