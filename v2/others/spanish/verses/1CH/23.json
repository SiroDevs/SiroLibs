            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        },
        {
          "text": "Leví en las familias de sus padres, cabeceras de familias en sus delineaciones,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        },
        {
          "text": "contados por sus nombres, por sus cabezas, los cuales hacían obra en el ministerio de la casa de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        },
        {
          "text": "de veinte años arriba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        }
      ]
    },
