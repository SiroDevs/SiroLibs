                "verseOrgIds": [
                  "JDG.1.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Beth-sean, ni á",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
