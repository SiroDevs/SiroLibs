            {
              "text": "los de",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.27",
                "verseOrgIds": [
                  "JDG.1.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sus aldeas, ni á",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
