                "verseOrgIds": [
                  "JDG.1.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Taanach y sus aldeas, ni á los de Dor y sus aldeas, ni á los habitantes de Ibleam y sus aldeas, ni á los que habitaban en Megiddo y en sus aldeas: mas el Cananeo quiso habitar en esta tierra.",
          "type": "text",
          "attrs": {
