                "verseId": "NUM.2.7",
                "verseOrgIds": [
                  "NUM.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "la tribu de Zabulón: y el jefe de los hijos de Zabulón, Eliab hijo de Helón;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        }
      ]
    },
    {
