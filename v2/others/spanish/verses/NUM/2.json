          "text": "Junto á él estará la tribu de Manasés; y el jefe de los hijos de Manasés, Gamaliel hijo de Pedasur;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
              "NUM.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y su hueste, con los contados de ellos, treinta y dos mil y doscientos:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
            ]
          }
        }
      ]
    },
    {
