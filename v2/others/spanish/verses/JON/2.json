{
  "id": "JON.2",
  "number": "2",
  "bookId": "JON",
  "reference": "Jonás 2",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JON 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MAS Jehová había prevenido un gran pez que tragase á Jonás: y",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.1",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        },
        {
          "text": "estuvo Jonás en el vientre del pez tres días y tres noches.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.1",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y oró Jonás desde el vientre del pez á Jehová su Dios,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "Clamé de mi tribulación á Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "Y él me oyó;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "Del vientre del sepulcro clamé,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "Y mi voz oiste.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echásteme en el profundo, en medio de los mares,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:4"
      },
      "items": [
        {
          "text": "Y rodeóme la corriente;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:4"
      },
      "items": [
        {
          "text": "Todas tus ondas y tus olas pasaron sobre mí.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.4",
            "verseOrgIds": [
              "JON.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        },
        {
          "text": "yo dije: Echado soy de delante de tus ojos:",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:5"
      },
      "items": [
        {
          "text": "Mas aun veré",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        },
        {
          "text": "tu santo templo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.5",
            "verseOrgIds": [
              "JON.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las aguas",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        },
        {
          "text": "me rodearon",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        },
        {
          "text": "hasta el alma,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:6"
      },
      "items": [
        {
          "text": "Rodeóme el abismo;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:6"
      },
      "items": [
        {
          "text": "La ova se enredó á mi cabeza.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.6",
            "verseOrgIds": [
              "JON.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Descendí á las raíces de los montes;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:7"
      },
      "items": [
        {
          "text": "La tierra",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "echó",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.7",
                "verseOrgIds": [
                  "JON.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sus cerraduras sobre mí para siempre:",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:7"
      },
      "items": [
        {
          "text": "Mas tú sacaste mi vida",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        },
        {
          "text": "de la sepultura, oh Jehová Dios mío.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.7",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        },
        {
          "text": "mi alma desfallecía en mí, acordéme de Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:8"
      },
      "items": [
        {
          "text": "Y mi oración entró hasta ti en tu santo templo.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los que guardan las vanidades ilusorias,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:9"
      },
      "items": [
        {
          "text": "Su misericordia abandonan.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo empero con voz de",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        },
        {
          "text": "alabanza te sacrificaré;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:10"
      },
      "items": [
        {
          "text": "Pagaré lo que prometí.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JON 2:10"
      },
      "items": [
        {
          "text": "La salvación",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "pertenece",
              "type": "text",
              "attrs": {
                "verseId": "JON.2.10",
                "verseOrgIds": [
                  "JON.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "á Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y mandó Jehová al pez, y vomitó á Jonás en tierra.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.11",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JON.3",
    "number": "3",
