{
  "id": "JOB.11",
  "number": "11",
  "bookId": "JOB",
  "reference": "Job 11",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JOB 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y RESPONDIÓ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.1",
            "verseOrgIds": [
              "JOB.11.1"
            ]
          }
        },
        {
          "text": "Sophar Naamathita, y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.1",
            "verseOrgIds": [
              "JOB.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Las",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        },
        {
          "text": "muchas palabras no han de tener respuesta?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:2"
      },
      "items": [
        {
          "text": "¿Y el hombre parlero será justificado?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.2",
            "verseOrgIds": [
              "JOB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Harán tus falacias callar á los hombres?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:3"
      },
      "items": [
        {
          "text": "¿Y harás escarnio, y no habrá quien te avergüence?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.3",
            "verseOrgIds": [
              "JOB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú dices: Mi conversar es puro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:4"
      },
      "items": [
        {
          "text": "Y yo soy limpio delante de tus ojos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.4",
            "verseOrgIds": [
              "JOB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas ¡oh quién diera que Dios hablara,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:5"
      },
      "items": [
        {
          "text": "Y abriera sus labios contigo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.5",
            "verseOrgIds": [
              "JOB.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y que te declarara los arcanos de la sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "son",
              "type": "text",
              "attrs": {
                "verseId": "JOB.11.6",
                "verseOrgIds": [
                  "JOB.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "de doble",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "valor",
              "type": "text",
              "attrs": {
                "verseId": "JOB.11.6",
                "verseOrgIds": [
                  "JOB.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "que la hacienda!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:6"
      },
      "items": [
        {
          "text": "Conocerías entonces que Dios te ha castigado menos que tu iniquidad merece.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.6",
            "verseOrgIds": [
              "JOB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Alcanzarás tú el rastro de Dios?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:7"
      },
      "items": [
        {
          "text": "¿Llegarás tú á la",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        },
        {
          "text": "perfección del Todopoderoso?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.7",
            "verseOrgIds": [
              "JOB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Es más alto que los cielos: ¿qué harás?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:8"
      },
      "items": [
        {
          "text": "Es más profundo que el infierno: ¿cómo lo conocerás?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.8",
            "verseOrgIds": [
              "JOB.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Su dimensión es más larga que la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:9"
      },
      "items": [
        {
          "text": "Y más ancha que la mar.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.9",
            "verseOrgIds": [
              "JOB.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si cortare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        },
        {
          "text": "o encerrare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:10"
      },
      "items": [
        {
          "text": "O juntare, ¿quién podrá contrarrestarle?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.10",
            "verseOrgIds": [
              "JOB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque él conoce á los",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        },
        {
          "text": "hombres vanos:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:11"
      },
      "items": [
        {
          "text": "Ve asimismo la iniquidad, ¿y no hará caso?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.11",
            "verseOrgIds": [
              "JOB.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "El hombre vano se hará entendido,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:12"
      },
      "items": [
        {
          "text": "Aunque nazca como el pollino del asno montés.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.12",
            "verseOrgIds": [
              "JOB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si tú apercibieres tu corazón,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:13"
      },
      "items": [
        {
          "text": "Y extendieres á él tus manos;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.13",
            "verseOrgIds": [
              "JOB.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si alguna iniquidad hubiere en tu mano, y la echares de ti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:14"
      },
      "items": [
        {
          "text": "Y no consintieres que more maldad en tus habitaciones;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.14",
            "verseOrgIds": [
              "JOB.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces levantarás tu rostro limpio de mancha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:15"
      },
      "items": [
        {
          "text": "Y serás fuerte y no temerás:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.15",
            "verseOrgIds": [
              "JOB.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y olvidarás tu trabajo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:16"
      },
      "items": [
        {
          "text": "O te acordarás de él como de aguas que pasaron:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.16",
            "verseOrgIds": [
              "JOB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y en mitad de la siesta se levantará bonanza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.17",
            "verseOrgIds": [
              "JOB.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 11:17"
      },
      "items": [
        {
          "text": "Resplandecerás, y serás como la mañana:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.17",
            "verseOrgIds": [
              "JOB.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y confiarás, que habrá esperanza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.11.18",
            "verseOrgIds": [
