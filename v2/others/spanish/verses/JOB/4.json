{
  "id": "JOB.4",
  "number": "4",
  "bookId": "JOB",
  "reference": "Job 4",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOB 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y RESPONDIÓ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.1",
            "verseOrgIds": [
              "JOB.4.1"
            ]
          }
        },
        {
          "text": "Eliphaz el Temanita, y dijo:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.1",
            "verseOrgIds": [
              "JOB.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si probáremos á hablarte, serte ha molesto;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:2"
      },
      "items": [
        {
          "text": "Mas ¿quién podrá detener las palabras?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí, tú enseñabas á muchos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:3"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        },
        {
          "text": "las manos flacas corroborabas;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al que vacilaba, enderezaban tus palabras,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:4"
      },
      "items": [
        {
          "text": "Y esforzabas las rodillas que decaían.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas ahora que",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "el mal",
              "type": "text",
              "attrs": {
                "verseId": "JOB.4.5",
                "verseOrgIds": [
                  "JOB.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sobre ti ha venido, te es duro;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:5"
      },
      "items": [
        {
          "text": "Y cuando ha llegado hasta ti, te turbas.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Es este",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        },
        {
          "text": "tu temor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        },
        {
          "text": "tu confianza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:6"
      },
      "items": [
        {
          "text": "Tu esperanza, y la perfección de tus caminos?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Recapacita ahora, ¿quién que fuera inocente se perdiera?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:7"
      },
      "items": [
        {
          "text": "Y ¿en dónde los rectos fueron cortados?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como yo he visto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        },
        {
          "text": "los que aran iniquidad",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:8"
      },
      "items": [
        {
          "text": "Y siembran injuria, la siegan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perecen por el aliento de Dios,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:9"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        },
        {
          "text": "por el espíritu de su furor son consumidos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El bramido del león, y la voz del león,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:10"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        },
        {
          "text": "los dientes de los leoncillos son quebrantados.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "El león viejo perece por falta de presa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.11",
            "verseOrgIds": [
              "JOB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:11"
      },
      "items": [
        {
          "text": "Y los hijos del león son esparcidos.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.11",
            "verseOrgIds": [
              "JOB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "El negocio también me era á mí oculto;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.12",
            "verseOrgIds": [
              "JOB.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:12"
      },
      "items": [
        {
          "text": "Mas mi oído ha percibido algo de ello.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.12",
            "verseOrgIds": [
              "JOB.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "En imaginaciones de visiones nocturnas,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.13",
            "verseOrgIds": [
              "JOB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:13"
      },
      "items": [
        {
          "text": "Cuando el sueño cae sobre los hombres,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.13",
            "verseOrgIds": [
              "JOB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sobrevínome un espanto y un temblor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.14",
            "verseOrgIds": [
              "JOB.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:14"
      },
      "items": [
        {
          "text": "Que estremeció todos mis huesos:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.14",
            "verseOrgIds": [
              "JOB.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y un espíritu pasó por delante de mí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.15",
            "verseOrgIds": [
              "JOB.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:15"
      },
      "items": [
        {
          "text": "Que hizo se erizara el pelo de mi carne.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.15",
            "verseOrgIds": [
              "JOB.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paróse un fantasma delante de mis ojos,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "Cuyo rostro yo no conocí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "Y quedo, oí que decía:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Si será el hombre más justo que Dios?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.17",
            "verseOrgIds": [
              "JOB.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:17"
      },
      "items": [
        {
          "text": "¿Si será el varón más limpio que el que lo hizo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.17",
            "verseOrgIds": [
              "JOB.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "He aquí que en sus siervos no confía,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.18",
            "verseOrgIds": [
              "JOB.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "JOB 4:18"
      },
