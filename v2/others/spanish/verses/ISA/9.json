              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por la ira de Jehová de los ejércitos se oscureció la tierra, y será el pueblo como pábulo del fuego:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.19",
            "verseOrgIds": [
              "ISA.9.18"
            ]
          }
        },
        {
          "text": "el hombre no tendrá piedad de su hermano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.19",
            "verseOrgIds": [
              "ISA.9.18"
            ]
          }
        }
      ]
    },
