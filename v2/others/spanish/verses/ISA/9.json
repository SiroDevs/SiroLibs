                "verseId": "ISA.9.20",
                "verseOrgIds": [
                  "ISA.9.19"
                ]
              }
            }
          ]
        },
        {
          "text": "hurtará á la mano derecha, y tendrá hambre; y comerá á la izquierda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.20",
            "verseOrgIds": [
              "ISA.9.19"
            ]
          }
        },
        {
