              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque la maldad",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.18",
            "verseOrgIds": [
              "ISA.9.17"
            ]
          }
        },
        {
          "text": "se encendió como fuego, cardos y espinas devorará; y encenderáse en lo espeso de la breña, y serán alzados como humo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.18",
            "verseOrgIds": [
              "ISA.9.17"
            ]
          }
        }
