          "type": "text",
          "attrs": {
            "verseId": "ISA.9.20",
            "verseOrgIds": [
              "ISA.9.19"
            ]
          }
        },
        {
          "text": "cada cual comerá la carne de su brazo:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.20",
            "verseOrgIds": [
              "ISA.9.19"
