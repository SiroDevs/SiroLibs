          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.25",
            "verseOrgIds": [
              "ISA.43.25"
            ]
          }
        },
        {
          "text": "yo soy el que borro tus rebeliones por amor de mí; y no me acordaré de tus pecados.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.25",
            "verseOrgIds": [
              "ISA.43.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
