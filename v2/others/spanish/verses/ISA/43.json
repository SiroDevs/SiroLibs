              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.28",
            "verseOrgIds": [
              "ISA.43.28"
            ]
          }
        },
        {
          "text": "yo profané los príncipes del santuario, y puse por anatema á Jacob, y por oprobio á Israel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.28",
            "verseOrgIds": [
              "ISA.43.28"
            ]
          }
