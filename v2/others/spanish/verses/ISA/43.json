          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "No compraste para mí caña",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "aromática",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.24",
                "verseOrgIds": [
                  "ISA.43.24"
                ]
              }
            }
          ]
        },
        {
          "text": "por dinero, ni me saciaste con la grosura de tus sacrificios; antes me hiciste servir en tus pecados,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        },
        {
          "text": "me has fatigado con tus maldades.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.24",
            "verseOrgIds": [
              "ISA.43.24"
            ]
          }
        }
      ]
