            "sid": "ISA 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "No me trajiste á mí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        },
        {
          "text": "los animales de tus holocaustos, ni á mí me honraste con tus sacrificios: no te hice servir con presente, ni te hice fatigar con perfume.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.23",
            "verseOrgIds": [
              "ISA.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
