          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu primer padre pecó, y tus enseñadores prevaricaron contra mí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.27",
            "verseOrgIds": [
              "ISA.43.27"
            ]
          }
        }
      ]
