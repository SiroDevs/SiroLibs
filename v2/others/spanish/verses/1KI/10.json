              "text": "ver",
              "type": "text",
              "attrs": {
                "verseId": "1KI.10.24",
                "verseOrgIds": [
                  "1KI.10.24"
                ]
              }
            }
          ]
        },
        {
          "text": "la cara de Salomón, para oir su sabiduría, la cual Dios había puesto en su corazón.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        }
      ]
    },
