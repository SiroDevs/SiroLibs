        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Cántico gradual.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 130:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DE",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        },
        {
          "text": "los profundos, oh Jehová, á ti clamo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.1",
            "verseOrgIds": [
              "PSA.130.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 130:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Señor, oye mi voz;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:2"
      },
      "items": [
        {
          "text": "Estén atentos tus oídos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:2"
      },
      "items": [
        {
          "text": "A la voz de mi súplica.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.2",
            "verseOrgIds": [
              "PSA.130.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 130:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "JAH, si",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        },
        {
          "text": "mirares á los pecados,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:3"
      },
      "items": [
        {
          "text": "¿Quién, oh Señor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        },
        {
          "text": "podrá mantenerse?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.3",
            "verseOrgIds": [
              "PSA.130.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 130:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero hay",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        },
        {
          "text": "perdón cerca de ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:4"
      },
      "items": [
        {
          "text": "Para que seas temido.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.4",
            "verseOrgIds": [
              "PSA.130.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 130:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esperé yo á Jehová, esperó mi alma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:5"
      },
      "items": [
        {
          "text": "En su palabra he esperado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.5",
            "verseOrgIds": [
              "PSA.130.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 130:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi alma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "espera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.130.6",
                "verseOrgIds": [
                  "PSA.130.6"
                ]
              }
            }
          ]
        },
        {
          "text": "á Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Más que",
              "type": "text",
              "attrs": {
                "verseId": "PSA.130.6",
                "verseOrgIds": [
                  "PSA.130.6"
                ]
              }
            }
          ]
        },
        {
          "text": "los centinelas á la mañana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Más que",
              "type": "text",
              "attrs": {
                "verseId": "PSA.130.6",
                "verseOrgIds": [
                  "PSA.130.6"
                ]
              }
            }
          ]
        },
        {
          "text": "los vigilantes á la mañana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.6",
            "verseOrgIds": [
              "PSA.130.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 130:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Espere Israel á Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:7"
      },
      "items": [
        {
          "text": "Porque en Jehová hay misericordia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:7"
      },
      "items": [
        {
          "text": "Y abundante redención con él.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.7",
            "verseOrgIds": [
              "PSA.130.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Humildad de espíritu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Excelencia de Sión.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 130:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y él redimirá á Israel",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 130:8"
      },
      "items": [
        {
          "text": "De todos sus pecados.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.130.8",
            "verseOrgIds": [
              "PSA.130.8"
            ]
          }
        }
      ]
    }
