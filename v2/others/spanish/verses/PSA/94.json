{
  "id": "PSA.94",
  "number": "94",
  "bookId": "PSA",
  "reference": "Salmos 94",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "94",
        "style": "c",
        "sid": "PSA 94"
      },
      "items": [
        {
          "text": "94",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 94:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        },
        {
          "text": "Dios de las venganzas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:1"
      },
      "items": [
        {
          "text": "Dios de las venganzas, muéstrate.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 94:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensálzate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        },
        {
          "text": "oh Juez de la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:2"
      },
      "items": [
        {
          "text": "Da el pago á los soberbios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 94:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Hasta cuándo los impíos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:3"
      },
      "items": [
        {
          "text": "Hasta cuándo, oh Jehová, se gozarán los impíos?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 94:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Hasta cuándo pronunciarán, hablarán cosas duras,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:4"
      },
      "items": [
        {
          "text": "Y se vanagloriarán todos los que obran iniquidad?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 94:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A tu pueblo, oh Jehová, quebrantan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:5"
      },
      "items": [
        {
          "text": "Y á tu heredad afligen.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 94:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A la viuda y al extanjero matan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:6"
      },
      "items": [
        {
          "text": "Y á los huérfanos quitan la vida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 94:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y dijeron: No verá JAH,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:7"
      },
      "items": [
        {
          "text": "Ni entenderá el Dios de Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Seguridad del justo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Toda la tierra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 94:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entended, necios del pueblo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:8"
      },
      "items": [
        {
          "text": "Y vosotros fatuos, ¿cuándo seréis sabios?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 94:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que plantó el oído, ¿no oirá?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:9"
      },
      "items": [
        {
          "text": "El que formó el ojo, ¿no verá?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 94:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que castiga las gentes, ¿no reprenderá?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "¿No sabrá",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.10",
                "verseOrgIds": [
                  "PSA.94.10"
                ]
              }
            }
          ]
        },
        {
          "text": "el que enseña al hombre la ciencia?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 94:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová conoce los pensamientos de los hombres,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:11"
      },
      "items": [
        {
          "text": "Que son vanidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 94:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienaventurado el hombre á quien tú, JAH, castigares,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:12"
      },
      "items": [
        {
          "text": "Y en tu ley lo instruyeres;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 94:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para tranquilizarle en los días de aflicción,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:13"
      },
      "items": [
        {
          "text": "En tanto que para el impío se cava el hoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 94:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no dejará Jehová su pueblo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:14"
      },
      "items": [
        {
          "text": "Ni desamparará su heredad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 94:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sino que el juicio será vuelto á justicia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.15",
            "verseOrgIds": [
              "PSA.94.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:15"
      },
      "items": [
        {
          "text": "Y en pos de ella irán todos los rectos de corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.15",
            "verseOrgIds": [
              "PSA.94.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 94:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién se levantará por mí contra los malignos?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.16",
            "verseOrgIds": [
              "PSA.94.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:16"
      },
      "items": [
        {
          "text": "¿Quién estará por mí contra los que obran iniquidad?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.16",
            "verseOrgIds": [
              "PSA.94.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 94:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si no me ayudara Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.17",
            "verseOrgIds": [
              "PSA.94.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:17"
      },
      "items": [
        {
          "text": "Presto morara mi alma en el silencio.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.17",
            "verseOrgIds": [
              "PSA.94.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 94:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando yo decía:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.18",
            "verseOrgIds": [
              "PSA.94.18"
            ]
          }
        },
        {
          "text": "Mi pie resbala:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.18",
            "verseOrgIds": [
              "PSA.94.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:18"
      },
      "items": [
        {
          "text": "Tu misericordia, oh Jehová, me sustentaba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.18",
            "verseOrgIds": [
              "PSA.94.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 94:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "En la multitud de mis pensamientos dentro de mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.19",
            "verseOrgIds": [
              "PSA.94.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:19"
      },
      "items": [
        {
          "text": "Tus consolaciones alegraban mi alma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.19",
            "verseOrgIds": [
              "PSA.94.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 94:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Juntaráse contigo el trono",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.20",
            "verseOrgIds": [
              "PSA.94.20"
            ]
          }
        },
        {
          "text": "de iniquidades,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.20",
            "verseOrgIds": [
              "PSA.94.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:20"
      },
      "items": [
        {
          "text": "Que forma agravio en el mandamiento?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.20",
            "verseOrgIds": [
              "PSA.94.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 94:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pónense en corros contra la vida del justo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.21",
            "verseOrgIds": [
              "PSA.94.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:21"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.21",
            "verseOrgIds": [
              "PSA.94.21"
            ]
          }
        },
        {
          "text": "condenan la sangre inocente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.21",
            "verseOrgIds": [
              "PSA.94.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 94:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas Jehová me ha sido por refugio;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.22",
            "verseOrgIds": [
              "PSA.94.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:22"
      },
      "items": [
        {
          "text": "Y mi Dios por",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.22",
            "verseOrgIds": [
              "PSA.94.22"
            ]
          }
        },
        {
          "text": "roca de mi confianza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.22",
            "verseOrgIds": [
              "PSA.94.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 94:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y él hará tornar sobre ellos su iniquidad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.23",
            "verseOrgIds": [
              "PSA.94.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:23"
      },
      "items": [
        {
          "text": "Y los destruirá por su propia maldad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.23",
            "verseOrgIds": [
              "PSA.94.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 94:23"
      },
      "items": [
        {
          "text": "Los talará Jehová nuestro Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.23",
            "verseOrgIds": [
              "PSA.94.23"
            ]
          }
        }
      ]
    }
