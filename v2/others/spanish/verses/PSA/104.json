{
  "id": "PSA.104",
  "number": "104",
  "bookId": "PSA",
  "reference": "Salmos 104",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "104",
        "style": "c",
        "sid": "PSA 104"
      },
      "items": [
        {
          "text": "104",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 104:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BENDICE,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        },
        {
          "text": "alma mía, á Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:1"
      },
      "items": [
        {
          "text": "Jehová, Dios mío, mucho te has engrandecido;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:1"
      },
      "items": [
        {
          "text": "Haste vestido de gloria y de magnificencia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 104:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que se cubre de luz como de vestidura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:2"
      },
      "items": [
        {
          "text": "Que extiende los cielos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        },
        {
          "text": "como una cortina;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 104:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que establece sus aposentos entre las aguas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:3"
      },
      "items": [
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        },
        {
          "text": "que pone las nubes por su carroza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:3"
      },
      "items": [
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        },
        {
          "text": "que anda sobre las alas del viento;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 104:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que hace á sus ángeles espíritus,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:4"
      },
      "items": [
        {
          "text": "Sus ministros al fuego flameante.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 104:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El fundó la tierra sobre sus basas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:5"
      },
      "items": [
        {
          "text": "No será jamás removida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 104:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con el abismo, como con vestido, la cubriste;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:6"
      },
      "items": [
        {
          "text": "Sobre los montes estaban las aguas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 104:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A tu reprensión huyeron;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:7"
      },
      "items": [
        {
          "text": "Al sonido de tu trueno se apresuraron;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 104:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Subieron los montes, descendieron los valles,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:8"
      },
      "items": [
        {
          "text": "Al lugar que tú les fundaste.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 104:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pusísteles término,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        },
        {
          "text": "el cual no traspasarán;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:9"
      },
      "items": [
        {
          "text": "Ni volverán á cubrir la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 104:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Tú eres",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.10",
                "verseOrgIds": [
                  "PSA.104.10"
                ]
              }
            }
          ]
        },
        {
          "text": "el que envías las fuentes por los arroyos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:10"
      },
      "items": [
        {
          "text": "Van entre los montes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 104:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrevan á todas las bestias del campo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:11"
      },
      "items": [
        {
          "text": "Quebrantan su sed los asnos montaraces.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 104:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Junto á aquellos habitarán las aves de los cielos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:12"
      },
      "items": [
        {
          "text": "Entre las ramas dan voces.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 104:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que riega los montes desde sus aposentos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:13"
      },
      "items": [
        {
          "text": "Del fruto de sus obras se sacia la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 104:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que hace producir el heno para las bestias,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:14"
      },
      "items": [
        {
          "text": "Y la hierba para el servicio del hombre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:14"
      },
      "items": [
        {
          "text": "Sacando",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        },
        {
          "text": "el pan de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 104:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y el vino que alegra el corazón del hombre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Y",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.15",
                "verseOrgIds": [
                  "PSA.104.15"
                ]
              }
            }
          ]
        },
        {
          "text": "el aceite que hace lucir el rostro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:15"
      },
      "items": [
        {
          "text": "Y el pan que sustenta el corazón del hombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 104:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Llénanse de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "jugo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.16",
                "verseOrgIds": [
                  "PSA.104.16"
                ]
              }
            }
          ]
        },
        {
          "text": "los árboles de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:16"
      },
      "items": [
        {
          "text": "Los",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        },
        {
          "text": "cedros del Líbano",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        },
        {
          "text": "que él plantó.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 104:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allí anidan las aves;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:17"
      },
      "items": [
        {
          "text": "En las hayas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "hace",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.17",
                "verseOrgIds": [
                  "PSA.104.17"
                ]
              }
            }
          ]
        },
        {
          "text": "su casa la cigüeña.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 104:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los montes altos para las cabras monteses;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.18",
            "verseOrgIds": [
              "PSA.104.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:18"
      },
      "items": [
        {
          "text": "Las peñas, madrigueras para",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.18",
            "verseOrgIds": [
              "PSA.104.18"
            ]
          }
        },
        {
          "text": "los conejos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.18",
            "verseOrgIds": [
              "PSA.104.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 104:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hizo la luna para los tiempos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.19",
            "verseOrgIds": [
              "PSA.104.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:19"
      },
      "items": [
        {
          "text": "El sol conoce su ocaso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.19",
            "verseOrgIds": [
              "PSA.104.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 104:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pone las tinieblas, y es la noche:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.20",
            "verseOrgIds": [
              "PSA.104.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:20"
      },
      "items": [
        {
          "text": "En ella corretean todas las bestias de la selva.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.20",
            "verseOrgIds": [
              "PSA.104.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 104:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los leoncillos braman á la presa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.21",
            "verseOrgIds": [
              "PSA.104.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:21"
      },
      "items": [
        {
          "text": "Y para buscar de Dios su comida.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.21",
            "verseOrgIds": [
              "PSA.104.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 104:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sale el sol, recógense,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.22",
            "verseOrgIds": [
              "PSA.104.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:22"
      },
      "items": [
        {
          "text": "Y échanse en sus cuevas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.22",
            "verseOrgIds": [
              "PSA.104.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 104:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sale el hombre á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.23",
            "verseOrgIds": [
              "PSA.104.23"
            ]
          }
        },
        {
          "text": "su hacienda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.23",
            "verseOrgIds": [
              "PSA.104.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:23"
      },
      "items": [
        {
          "text": "Y á su labranza hasta la tarde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.23",
            "verseOrgIds": [
              "PSA.104.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 104:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡Cuán muchas son tus obras, oh Jehová!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:24"
      },
      "items": [
        {
          "text": "Hiciste todas ellas con sabiduría:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:24"
      },
      "items": [
        {
          "text": "La tierra está llena de tus beneficios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.24",
            "verseOrgIds": [
              "PSA.104.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 104:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Asimismo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.25",
                "verseOrgIds": [
                  "PSA.104.25"
                ]
              }
            }
          ]
        },
        {
          "text": "esta gran mar y ancha de términos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.25",
            "verseOrgIds": [
              "PSA.104.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:25"
      },
      "items": [
        {
          "text": "En ella pescados sin número,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.25",
            "verseOrgIds": [
              "PSA.104.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:25"
      },
      "items": [
        {
          "text": "Animales pequeños y grandes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.25",
            "verseOrgIds": [
              "PSA.104.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 104:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allí andan navíos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.26",
            "verseOrgIds": [
              "PSA.104.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:26"
      },
      "items": [
        {
          "text": "Allí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.26",
            "verseOrgIds": [
              "PSA.104.26"
            ]
          }
        },
        {
          "text": "este leviathán que hiciste para que jugase en ella.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.26",
            "verseOrgIds": [
              "PSA.104.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 104:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todos ellos esperan en ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.27",
            "verseOrgIds": [
              "PSA.104.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:27"
      },
      "items": [
        {
          "text": "Para que les des su comida á su tiempo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.27",
            "verseOrgIds": [
              "PSA.104.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 104:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les das, recogen;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.28",
            "verseOrgIds": [
              "PSA.104.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:28"
      },
      "items": [
        {
          "text": "Abres tu mano, hártanse de bien.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.28",
            "verseOrgIds": [
              "PSA.104.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Poder benéfico de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Liberaciones de Dios",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 104:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escondes tu rostro, túrbanse:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.29",
            "verseOrgIds": [
              "PSA.104.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:29"
      },
      "items": [
        {
          "text": "Les quitas el espíritu, dejan de ser,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.29",
            "verseOrgIds": [
              "PSA.104.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:29"
      },
      "items": [
        {
          "text": "Y tórnanse en su polvo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.29",
            "verseOrgIds": [
              "PSA.104.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 104:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Envías tu espíritu, críanse:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.30",
            "verseOrgIds": [
              "PSA.104.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:30"
      },
      "items": [
        {
          "text": "Y renuevas la haz de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.30",
            "verseOrgIds": [
              "PSA.104.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 104:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea la gloria de Jehová para siempre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.31",
            "verseOrgIds": [
              "PSA.104.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:31"
      },
      "items": [
        {
          "text": "Alégrese Jehová en sus obras;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.31",
            "verseOrgIds": [
              "PSA.104.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PSA 104:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "El cual mira á la tierra, y ella tiembla;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.32",
            "verseOrgIds": [
              "PSA.104.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 104:32"
      },
      "items": [
        {
          "text": "Toca los montes, y humean.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.32",
            "verseOrgIds": [
              "PSA.104.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PSA 104:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Jehová cantaré en mi vida:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.33",
            "verseOrgIds": [
              "PSA.104.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
