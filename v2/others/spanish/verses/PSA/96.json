{
  "id": "PSA.96",
  "number": "96",
  "bookId": "PSA",
  "reference": "Salmos 96",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "96",
        "style": "c",
        "sid": "PSA 96"
      },
      "items": [
        {
          "text": "96",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 96:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "CANTAD á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        },
        {
          "text": "Jehová canción nueva;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:1"
      },
      "items": [
        {
          "text": "Cantad á Jehová, toda la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 96:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantad á Jehová, bendecid su nombre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:2"
      },
      "items": [
        {
          "text": "Anunciad de día en día su salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 96:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Contad entre las gentes su gloria,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:3"
      },
      "items": [
        {
          "text": "En todos los pueblos sus maravillas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 alabe á Jehová.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 \"Cantad á Jehová canción nueva.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 96:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque grande es Jehová, y digno de suprema alabanza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:4"
      },
      "items": [
        {
          "text": "Terrible sobre todos los dioses.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 96:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque todos los dioses de los pueblos son ídolos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:5"
      },
      "items": [
        {
          "text": "Mas Jehová hizo los cielos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 96:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alabanza y magnificencia delante de él:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:6"
      },
      "items": [
        {
          "text": "Fortaleza y gloria en su santuario.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 96:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dad á Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        },
        {
          "text": "oh familias de los pueblos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:7"
      },
      "items": [
        {
          "text": "Dad á Jehová la gloria y la fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
              "PSA.96.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 96:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dad á Jehová la honra debida á su nombre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:8"
      },
      "items": [
        {
          "text": "Tomad presentes, y venid á sus",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        },
        {
          "text": "atrios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.8",
            "verseOrgIds": [
              "PSA.96.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 96:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Encorvaos á Jehová en la hermosura de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "su",
              "type": "text",
              "attrs": {
                "verseId": "PSA.96.9",
                "verseOrgIds": [
                  "PSA.96.9"
                ]
              }
            }
          ]
        },
        {
          "text": "santuario:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:9"
      },
      "items": [
        {
          "text": "Temed delante de él, toda la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 96:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Decid en las gentes: Jehová reinó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "También afirmó el mundo, no será conmovido:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "Juzgará á los pueblos en justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 96:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alégrense los cielos, y gócese la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:11"
      },
      "items": [
        {
          "text": "Brame la mar y su plenitud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 96:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regocíjese el campo, y todo lo que en él está:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:12"
      },
      "items": [
        {
          "text": "Entonces todos los árboles del bosque rebosarán de contento.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 96:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delante de Jehová que vino:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "Porque vino á juzgar la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "Juzgará al mundo con justicia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 96:13"
      },
      "items": [
        {
          "text": "Y á los pueblos con su verdad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.13",
            "verseOrgIds": [
              "PSA.96.13"
            ]
          }
        }
      ]
    }
  ],
