{
  "id": "PSA.34",
  "number": "34",
  "bookId": "PSA",
  "reference": "Salmos 34",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "PSA 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David,",
          "type": "text"
        },
        {
          "text": "cuando mudó su semblante delante de",
          "type": "text"
        },
        {
          "text": "Abimelech, y él lo echó, y fuése.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "BENDECIRÉ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        },
        {
          "text": "a Jehová en todo tiempo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:1"
      },
      "items": [
        {
          "text": "Su alabanza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "será",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.1",
                "verseOrgIds": [
                  "PSA.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "siempre en mi boca.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "En Jehová se gloriará mi alma:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:2"
      },
      "items": [
        {
          "text": "Oiránlo los mansos, y se alegrarán.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engrandeced á Jehová conmigo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:3"
      },
      "items": [
        {
          "text": "Y ensalcemos su nombre á una.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busqué á Jehová, y él me oyó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:4"
      },
      "items": [
        {
          "text": "Y libróme de todos mis temores.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A él miraron y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        },
        {
          "text": "fueron alumbrados:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:5"
      },
      "items": [
        {
          "text": "Y sus rostros no se avergonzaron.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Este pobre clamó, y oyóle Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:6"
      },
      "items": [
        {
          "text": "Y librólo de todas sus angustias.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El ángel de Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        },
        {
          "text": "acampa en derredor de los que le temen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:7"
      },
      "items": [
        {
          "text": "Y los defiende.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gustad, y ved que es bueno Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:8"
      },
      "items": [
        {
          "text": "Dichoso el hombre que confiará en él.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temed á Jehová, vosotros sus santos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:9"
      },
      "items": [
        {
          "text": "Porque no hay falta para los que le temen.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los leoncillos necesitaron, y tuvieron hambre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:10"
      },
      "items": [
        {
          "text": "Pero los que buscan á Jehová, no tendrán falta de ningún bien.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Venid, hijos, oidme;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:11"
      },
      "items": [
        {
          "text": "El temor de Jehová os enseñaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién es el hombre que desea vida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:12"
      },
      "items": [
        {
          "text": "Que codicia días para ver bien?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guarda tu lengua de mal,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
            "verseOrgIds": [
              "PSA.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:13"
      },
      "items": [
        {
          "text": "Y tus labios",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
            "verseOrgIds": [
              "PSA.34.14"
            ]
          }
        },
        {
          "text": "de hablar engaño.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
            "verseOrgIds": [
              "PSA.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apártate del mal, y haz el bien;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.14",
            "verseOrgIds": [
              "PSA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:14"
      },
      "items": [
        {
          "text": "Busca la paz, y síguela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.14",
            "verseOrgIds": [
              "PSA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los ojos de Jehová están sobre los justos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.15",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:15"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.15",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "atentos",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.15",
                "verseOrgIds": [
                  "PSA.34.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sus oídos al clamor de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.15",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "La ira de Jehová contra los que mal hacen,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.16",
            "verseOrgIds": [
              "PSA.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:16"
      },
      "items": [
        {
          "text": "Para cortar de la tierra la memoria de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.16",
            "verseOrgIds": [
              "PSA.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Clamaron",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.17",
            "verseOrgIds": [
              "PSA.34.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "los justos,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.17",
                "verseOrgIds": [
                  "PSA.34.18"
                ]
              }
            }
          ]
        },
        {
          "text": "y Jehová oyó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.17",
            "verseOrgIds": [
              "PSA.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:17"
      },
      "items": [
        {
          "text": "Y librólos de todas sus angustias.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.17",
            "verseOrgIds": [
