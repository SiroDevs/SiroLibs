      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:21"
      },
      "items": [
        {
          "text": "Y los que aborrecen al justo serán asolados.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.21",
            "verseOrgIds": [
              "PSA.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.22",
            "verseOrgIds": [
              "PSA.34.23"
            ]
          }
        },
        {
          "text": "redime el alma de sus siervos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.22",
            "verseOrgIds": [
              "PSA.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:22"
      },
      "items": [
        {
          "text": "Y no serán asolados cuantos en él confían.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.22",
            "verseOrgIds": [
              "PSA.34.23"
            ]
