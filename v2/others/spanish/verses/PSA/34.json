            "sid": "PSA 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchos son los males del justo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.19",
            "verseOrgIds": [
              "PSA.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:19"
      },
      "items": [
        {
          "text": "Mas de todos ellos lo librará Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.19",
            "verseOrgIds": [
              "PSA.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "El guarda todos sus huesos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.20",
            "verseOrgIds": [
              "PSA.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:20"
      },
      "items": [
        {
          "text": "Ni uno de ellos será quebrantado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.20",
            "verseOrgIds": [
              "PSA.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matará al malo la maldad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.21",
            "verseOrgIds": [
              "PSA.34.22"
            ]
          }
        }
      ]
    },
