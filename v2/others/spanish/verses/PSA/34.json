          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cercano está Jehová á",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.18",
            "verseOrgIds": [
              "PSA.34.19"
            ]
          }
        },
        {
          "text": "los quebrantados de corazón;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.18",
            "verseOrgIds": [
              "PSA.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 34:18"
      },
      "items": [
        {
          "text": "Y salvará á los contritos de espíritu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.18",
            "verseOrgIds": [
              "PSA.34.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 David pide á Dios que",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 le libre de sus enemigos.",
          "type": "text"
        }
      ]
    },
