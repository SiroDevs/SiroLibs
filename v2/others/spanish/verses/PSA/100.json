  "verseCount": 5,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "100",
        "style": "c",
        "sid": "PSA 100"
      },
      "items": [
        {
          "text": "100",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de alabanza.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 100:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "CANTAD",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.1",
            "verseOrgIds": [
              "PSA.100.1"
            ]
          }
        },
        {
          "text": "alegres á Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.1",
            "verseOrgIds": [
              "PSA.100.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "habitantes de",
              "type": "text",
              "attrs": {
                "verseId": "PSA.100.1",
                "verseOrgIds": [
                  "PSA.100.1"
                ]
              }
            }
          ]
        },
        {
          "text": "toda la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.1",
            "verseOrgIds": [
              "PSA.100.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 100:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Servid á Jehová con alegría:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.2",
            "verseOrgIds": [
              "PSA.100.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 100:2"
      },
      "items": [
        {
          "text": "Venid ante su acatamiento con regocijo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.2",
            "verseOrgIds": [
              "PSA.100.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 100:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reconoced que Jehová él es Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "El nos hizo, y no nosotros á nosotros mismos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "Pueblo suyo somos, y ovejas de su prado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 100:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entrad por sus puertas con reconocimiento,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 100:4"
      },
      "items": [
        {
          "text": "Por sus atrios con alabanza:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 100:4"
      },
      "items": [
        {
          "text": "Alabadle, bendecid su nombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 100:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque Jehová es bueno: para siempre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PSA.100.5",
                "verseOrgIds": [
                  "PSA.100.5"
                ]
              }
            }
          ]
        },
        {
          "text": "su misericordia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 100:5"
      },
      "items": [
        {
          "text": "Y su verdad por todas las generaciones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
        }
      ]
    }
  ],
