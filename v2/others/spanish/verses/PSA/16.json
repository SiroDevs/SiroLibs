{
  "id": "PSA.16",
  "number": "16",
  "bookId": "PSA",
  "reference": "Salmos 16",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "PSA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Michtham de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "GUÁRDAME, oh Dios, porque en ti he confiado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.1",
            "verseOrgIds": [
              "PSA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Confianza de David",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 en la bondad de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dijiste,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "oh alma mía,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.2",
                "verseOrgIds": [
                  "PSA.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "á Jehová: Tú eres el Señor:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:2"
      },
      "items": [
        {
          "text": "Mi bien á ti no",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.2",
            "verseOrgIds": [
              "PSA.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "aprovecha;",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.2",
                "verseOrgIds": [
                  "PSA.16.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Sino",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.3",
                "verseOrgIds": [
                  "PSA.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "á los santos que están en la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:3"
      },
      "items": [
        {
          "text": "Y á los íntegros: toda mi afición en ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Multiplicaránse los dolores de aquellos que sirven diligentes á otro",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "dios:",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.4",
                "verseOrgIds": [
                  "PSA.16.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "No ofreceré yo sus libaciones de sangre,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:4"
      },
      "items": [
        {
          "text": "Ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        },
        {
          "text": "en mis labios tomaré sus nombres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová es la porción de mi parte y de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        },
        {
          "text": "mi copa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:5"
      },
      "items": [
        {
          "text": "Tú sustentarás mi suerte.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las cuerdas me cayeron en lugares deleitosos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.6",
            "verseOrgIds": [
              "PSA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:6"
      },
      "items": [
        {
          "text": "Y es hermosa la heredad que me ha tocado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.6",
            "verseOrgIds": [
              "PSA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendeciré á Jehová que me aconseja:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:7"
      },
      "items": [
        {
          "text": "Aun en las noches me enseñan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        },
        {
          "text": "mis riñones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        },
        {
          "text": "he puesto siempre delante de mí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:8"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        },
        {
          "text": "está á mi diestra no seré conmovido.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.8",
            "verseOrgIds": [
              "PSA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alegróse por tanto mi corazón, y se gozó mi gloria:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:9"
      },
      "items": [
        {
          "text": "También mi carne reposará segura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no dejarás mi alma en el",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        },
        {
          "text": "sepulcro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:10"
      },
      "items": [
        {
          "text": "Ni permitirás que tu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        },
        {
          "text": "santo vea corrupción.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me mostrarás",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        },
        {
          "text": "la senda de la vida:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "Hartura de alegrías hay con tu rostro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "Deleites en tu diestra para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.17",
    "number": "17",
    "bookId": "PSA"
  },
