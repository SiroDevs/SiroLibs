{
  "id": "PSA.74",
  "number": "74",
  "bookId": "PSA",
  "reference": "Salmos 74",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "74",
        "style": "c",
        "sid": "PSA 74"
      },
      "items": [
        {
          "text": "74",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Masquil de Asaph.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 74:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿POR qué, oh Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "nos",
              "type": "text",
              "attrs": {
                "verseId": "PSA.74.1",
                "verseOrgIds": [
                  "PSA.74.1"
                ]
              }
            }
          ]
        },
        {
          "text": "has desechado para siempre?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:1"
      },
      "items": [
        {
          "text": "¿Por qué ha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        },
        {
          "text": "humeado tu furor contra las",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        },
        {
          "text": "ovejas de tu dehesa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.1",
            "verseOrgIds": [
              "PSA.74.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Desolación del",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 santuario.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 74:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acuérdate de tu congregación,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        },
        {
          "text": "que adquiriste de antiguo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Cuando",
              "type": "text",
              "attrs": {
                "verseId": "PSA.74.2",
                "verseOrgIds": [
                  "PSA.74.2"
                ]
              }
            }
          ]
        },
        {
          "text": "redimiste la vara de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        },
        {
          "text": "tu heredad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:2"
      },
      "items": [
        {
          "text": "Este monte de Sión, donde has habitado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.2",
            "verseOrgIds": [
              "PSA.74.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 74:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Levanta tus pies á los",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        },
        {
          "text": "asolamientos eternos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:3"
      },
      "items": [
        {
          "text": "A todo enemigo que ha hecho mal en el santuario.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.3",
            "verseOrgIds": [
              "PSA.74.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 74:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tus enemigos han bramado en medio de tus sinagogas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:4"
      },
      "items": [
        {
          "text": "Han puesto sus divisas por señas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.4",
            "verseOrgIds": [
              "PSA.74.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 74:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Cualquiera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.74.5",
                "verseOrgIds": [
                  "PSA.74.5"
                ]
              }
            }
          ]
        },
        {
          "text": "se hacía famoso según que había levantado",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:5"
      },
      "items": [
        {
          "text": "El hacha sobre los gruesos maderos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.5",
            "verseOrgIds": [
              "PSA.74.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 74:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ahora con hachas y martillos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:6"
      },
      "items": [
        {
          "text": "Han quebrado todas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        },
        {
          "text": "sus entalladuras.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.6",
            "verseOrgIds": [
              "PSA.74.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 74:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Han puesto á fuego tus santuarios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:7"
      },
      "items": [
        {
          "text": "Han profanado el tabernáculo de tu nombre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "echándolo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.74.7",
                "verseOrgIds": [
                  "PSA.74.7"
                ]
              }
            }
          ]
        },
        {
          "text": "á tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.7",
            "verseOrgIds": [
              "PSA.74.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 74:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dijeron en su corazón: Destruyámoslos de una vez;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:8"
      },
      "items": [
        {
          "text": "Han quemado todas las sinagogas de Dios en el tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.8",
            "verseOrgIds": [
              "PSA.74.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 74:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "No vemos ya nuestras señales:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "No hay más profeta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:9"
      },
      "items": [
        {
          "text": "Ni con nosotros hay quien sepa hasta cuándo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.9",
            "verseOrgIds": [
              "PSA.74.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 74:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Hasta cuándo, oh Dios, el angustiador",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "nos",
              "type": "text",
              "attrs": {
                "verseId": "PSA.74.10",
                "verseOrgIds": [
                  "PSA.74.10"
                ]
              }
            }
          ]
        },
        {
          "text": "afrentará?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:10"
      },
      "items": [
        {
          "text": "¿Ha de blasfemar el enemigo perpetuamente tu nombre?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.10",
            "verseOrgIds": [
              "PSA.74.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 74:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué retraes tu mano, y tu diestra?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "¿Por qué",
              "type": "text",
              "attrs": {
                "verseId": "PSA.74.11",
                "verseOrgIds": [
                  "PSA.74.11"
                ]
              }
            }
          ]
        },
        {
          "text": "la escondes dentro de tu seno?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.11",
            "verseOrgIds": [
              "PSA.74.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 74:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empero",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        },
        {
          "text": "Dios es mi rey ya de antiguo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:12"
      },
      "items": [
        {
          "text": "El que obra saludes en medio de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.12",
            "verseOrgIds": [
              "PSA.74.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 74:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú hendiste la mar con tu fortaleza:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:13"
      },
      "items": [
        {
          "text": "Quebrantaste cabezas de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        },
        {
          "text": "ballenas en las aguas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.13",
            "verseOrgIds": [
              "PSA.74.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 74:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú magullaste las cabezas del",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        },
        {
          "text": "leviathán;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:14"
      },
      "items": [
        {
          "text": "Dístelo por comida al pueblo de los desiertos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.14",
            "verseOrgIds": [
              "PSA.74.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 74:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú abriste fuente y río;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.15",
            "verseOrgIds": [
              "PSA.74.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:15"
      },
      "items": [
        {
          "text": "Tú secaste ríos impetuosos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.15",
            "verseOrgIds": [
              "PSA.74.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 74:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuyo es el día, tuya también es la noche:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.16",
            "verseOrgIds": [
              "PSA.74.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:16"
      },
      "items": [
        {
          "text": "Tú aparejaste la luna y el sol.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.16",
            "verseOrgIds": [
              "PSA.74.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 74:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
            ]
          }
        },
        {
          "text": "estableciste todos los términos de la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:17"
      },
      "items": [
        {
          "text": "El verano y el invierno tú los formaste.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 74:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acuerdáte de esto: que el enemigo ha dicho afrentas á Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
              "PSA.74.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:18"
      },
      "items": [
        {
          "text": "Y que el pueblo insensato ha blasfemado tu nombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
              "PSA.74.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 74:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "No entregues á las bestias el alma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        },
        {
          "text": "de tu tórtola:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:19"
      },
      "items": [
        {
          "text": "Y no olvides para siempre la congregación de tus afligidos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 74:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mira al pacto:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.20",
            "verseOrgIds": [
              "PSA.74.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:20"
      },
      "items": [
        {
          "text": "Porque las tenebrosidades de la tierra llenas están de habitaciones de violencia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.20",
            "verseOrgIds": [
              "PSA.74.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 74:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "No vuelva avergonzado el abatido:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.21",
            "verseOrgIds": [
              "PSA.74.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:21"
      },
      "items": [
        {
          "text": "El afligido y el menesteroso alabarán tu nombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.21",
            "verseOrgIds": [
              "PSA.74.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 74:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Levántate, oh Dios, aboga tu causa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.22",
            "verseOrgIds": [
              "PSA.74.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:22"
      },
      "items": [
        {
          "text": "Acuérdate de cómo el insensato te injuria cada día.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.22",
            "verseOrgIds": [
              "PSA.74.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 74:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "No olvides las voces de tus enemigos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.23",
            "verseOrgIds": [
              "PSA.74.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 74:23"
      },
      "items": [
        {
          "text": "El alboroto de los que se levantan contra ti sube continuamente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.23",
            "verseOrgIds": [
              "PSA.74.23"
            ]
          }
        }
      ]
    }
  ],
