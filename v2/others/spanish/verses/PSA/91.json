{
  "id": "PSA.91",
  "number": "91",
  "bookId": "PSA",
  "reference": "Salmos 91",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "91",
        "style": "c",
        "sid": "PSA 91"
      },
      "items": [
        {
          "text": "91",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 91:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EL",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        },
        {
          "text": "que habita al abrigo del Altísimo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:1"
      },
      "items": [
        {
          "text": "Morará",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        },
        {
          "text": "bajo la sombra del Omnipotente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 91:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diré yo á Jehová: Esperanza mía, y castillo mío;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:2"
      },
      "items": [
        {
          "text": "Mi Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        },
        {
          "text": "en él confiaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 91:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y él",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        },
        {
          "text": "te librará del lazo del cazador:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:3"
      },
      "items": [
        {
          "text": "De la peste destruidora.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 91:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con sus plumas te cubrirá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        },
        {
          "text": "debajo de sus alas estarás seguro:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "Escudo y adarga es su verdad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 91:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "No tendrás temor de espanto nocturno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:5"
      },
      "items": [
        {
          "text": "Ni de saeta que vuele de día;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 91:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni de pestilencia que ande en oscuridad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:6"
      },
      "items": [
        {
          "text": "Ni de mortandad que en medio del día destruya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 91:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caerán á tu lado mil,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "Y diez mil á tu diestra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "PSA.91.7",
                "verseOrgIds": [
                  "PSA.91.7"
                ]
              }
            }
          ]
        },
        {
          "text": "á ti no llegará.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 91:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente con tus ojos mirarás,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:8"
      },
      "items": [
        {
          "text": "Y verás la recompensa de los impíos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 91:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque tú has puesto á Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que es",
              "type": "text",
              "attrs": {
                "verseId": "PSA.91.9",
                "verseOrgIds": [
                  "PSA.91.9"
                ]
              }
            }
          ]
        },
        {
          "text": "mi esperanza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:9"
      },
      "items": [
        {
          "text": "Al Altísimo por",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        },
        {
          "text": "tu habitación,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 91:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "No te sobrevendrá mal,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:10"
      },
      "items": [
        {
          "text": "Ni plaga tocará tu morada.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 91:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues que á sus ángeles mandará acerca de ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:11"
      },
      "items": [
        {
          "text": "Que te guarden en todos tus caminos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 91:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "En las manos te llevarán,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:12"
      },
      "items": [
        {
          "text": "Porque tu pie no tropiece en piedra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 91:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sobre el león y el basilisco pisarás;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:13"
      },
      "items": [
        {
          "text": "Hollarás al cachorro del león y al dragón.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 91:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por cuanto en mí ha puesto su voluntad, yo también lo libraré:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:14"
      },
      "items": [
        {
          "text": "Pondrélo en alto, por cuanto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        },
        {
          "text": "ha conocido mi nombre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 \"Bueno es alabar á Jehová.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 \"Jehová reina.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 91:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me invocará, y yo le responderé:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:15"
      },
      "items": [
        {
          "text": "Con él estare yo en la angustia:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 91:15"
      },
      "items": [
        {
          "text": "Lo libraré, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        },
        {
          "text": "le glorificaré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 91:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saciarélo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.16",
            "verseOrgIds": [
              "PSA.91.16"
            ]
          }
        },
        {
          "text": "de larga vida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.16",
            "verseOrgIds": [
