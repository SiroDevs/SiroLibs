      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 93:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JEHOVÁ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        },
        {
          "text": "reina,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        },
        {
          "text": "vistióse de magnificencia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:1"
      },
      "items": [
        {
          "text": "Vistióse Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        },
        {
          "text": "ciñose de fortaleza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:1"
      },
      "items": [
        {
          "text": "Afirmó también el mundo, que no se moverá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 93:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Firme es tu trono desde entonces:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.2",
            "verseOrgIds": [
              "PSA.93.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:2"
      },
      "items": [
        {
          "text": "Tú eres eternalmente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.2",
            "verseOrgIds": [
              "PSA.93.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 93:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alzaron los ríos, oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:3"
      },
      "items": [
        {
          "text": "Alzaron los ríos su sonido;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:3"
      },
      "items": [
        {
          "text": "Alzaron los ríos sus ondas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 93:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová en las alturas es más poderoso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.4",
            "verseOrgIds": [
              "PSA.93.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:4"
      },
      "items": [
        {
          "text": "Que el estruendo de las muchas aguas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.4",
            "verseOrgIds": [
              "PSA.93.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Más que",
              "type": "text",
              "attrs": {
                "verseId": "PSA.93.4",
                "verseOrgIds": [
                  "PSA.93.4"
                ]
              }
            }
          ]
        },
        {
          "text": "las recias ondas de la mar.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.4",
            "verseOrgIds": [
              "PSA.93.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 93:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tus testimonios son muy firmes:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.5",
            "verseOrgIds": [
              "PSA.93.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:5"
      },
      "items": [
        {
          "text": "La santidad conviene á tu casa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.5",
            "verseOrgIds": [
              "PSA.93.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 93:5"
      },
      "items": [
        {
          "text": "Oh Jehová, por los siglos y para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.5",
            "verseOrgIds": [
              "PSA.93.5"
            ]
          }
        }
      ]
    }
  ],
