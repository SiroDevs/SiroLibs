{
  "id": "PSA.70",
  "number": "70",
  "bookId": "PSA",
  "reference": "Salmos 70",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 5,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "70",
        "style": "c",
        "sid": "PSA 70"
      },
      "items": [
        {
          "text": "70",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Salmo de David,",
          "type": "text"
        },
        {
          "text": "para conmemorar.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 70:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OH Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "acude",
              "type": "text",
              "attrs": {
                "verseId": "PSA.70.1",
                "verseOrgIds": [
                  "PSA.70.2"
                ]
              }
            }
          ]
        },
        {
          "text": "á librarme;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:1"
      },
      "items": [
        {
          "text": "Apresúrate, oh Dios, á socorrerme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 70:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sean avergonzados y confusos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "Los que buscan mi vida;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "Sean vueltos atrás y avergonzados",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "Los que mi mal desean.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 70:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sean vueltos, en pago de su afrenta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "hecha,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.70.3",
                "verseOrgIds": [
                  "PSA.70.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:3"
      },
      "items": [
        {
          "text": "Los que dicen: ¡Ah! ¡ah!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 70:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gócense y alégrense en ti todos los que te buscan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "Y digan siempre los que aman tu salud:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "Engrandecido sea Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 70:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo estoy afligido y menesteroso;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "Apresúrate á mí, oh Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "Ayuda mía y mi libertador eres tú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "Oh Jehová, no te detengas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.71",
    "number": "71",
