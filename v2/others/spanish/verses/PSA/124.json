        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Cántico gradual: de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 124:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A NO haber estado Jehová por nosotros,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 124:1"
      },
      "items": [
        {
          "text": "Diga ahora Israel;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 124:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A no haber estado Jehová por nosotros,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 124:2"
      },
      "items": [
        {
          "text": "Cuando se levantaron contra nosotros los hombres,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.2",
            "verseOrgIds": [
              "PSA.124.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 124:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.3",
            "verseOrgIds": [
              "PSA.124.3"
            ]
          }
        },
        {
          "text": "nos habrían entonces tragado,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.3",
            "verseOrgIds": [
              "PSA.124.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 124:3"
      },
      "items": [
        {
          "text": "Cuando se encendió su furor en nosotros.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.3",
            "verseOrgIds": [
              "PSA.124.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 124:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entonces nos habrían inundado",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.4",
            "verseOrgIds": [
              "PSA.124.4"
            ]
          }
        },
        {
          "text": "las aguas;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.4",
            "verseOrgIds": [
              "PSA.124.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 124:4"
      },
      "items": [
        {
          "text": "Sobre nuestra alma hubiera pasado el torrente:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.4",
            "verseOrgIds": [
              "PSA.124.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 124:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hubieran entonces pasado sobre nuestra alma las aguas soberbias.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.5",
            "verseOrgIds": [
              "PSA.124.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 124:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendito Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.6",
            "verseOrgIds": [
              "PSA.124.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 124:6"
      },
      "items": [
        {
          "text": "Que no nos dió por presa á sus dientes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.6",
            "verseOrgIds": [
              "PSA.124.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 124:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuestra alma escapó cual ave del lazo de los cazadores:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 124:7"
      },
      "items": [
        {
          "text": "Quebróse el lazo, y escapamos nosotros.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.7",
            "verseOrgIds": [
              "PSA.124.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 124:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuestro socorro es en el nombre de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.8",
            "verseOrgIds": [
              "PSA.124.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 124:8"
      },
      "items": [
        {
          "text": "Que hizo el cielo y la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.8",
            "verseOrgIds": [
              "PSA.124.8"
            ]
          }
        }
      ]
    }
  ],
