  "verseCount": 5,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "43",
        "style": "c",
        "sid": "PSA 43"
      },
      "items": [
        {
          "text": "43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "JÚZGAME,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        },
        {
          "text": "oh Dios, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        },
        {
          "text": "aboga mi causa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "Líbrame de gente impía, del hombre de engaño é iniquidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues que tú eres el Dios de mi fortaleza, ¿por qué me has",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        },
        {
          "text": "desechado?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "¿Por qué andaré enlutado por la opresión del enemigo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Envía tu luz y tu verdad: éstas me guiarán,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "Me conducirán al monte de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        },
        {
          "text": "tu santidad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "Y á tus tabernáculos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y entraré al altar de Dios,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "Al Dios alegría de mi gozo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "Y alabaréte con arpa, oh Dios, Dios mío.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Por qué te abates, oh alma mía,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Y por qué te conturbes en mí?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Espera á Dios; porque aun le tengo de alabar;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es él",
              "type": "text",
              "attrs": {
                "verseId": "PSA.43.5",
                "verseOrgIds": [
                  "PSA.43.5"
                ]
              }
            }
          ]
        },
        {
          "text": "salvamento delante de mí, y el Dios mío.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    }
  ],
