{
  "id": "PSA.11",
  "number": "11",
  "bookId": "PSA",
  "reference": "Salmos 11",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "PSA 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EN Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        },
        {
          "text": "he confiado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:1"
      },
      "items": [
        {
          "text": "¿Cómo decís á mi alma:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:1"
      },
      "items": [
        {
          "text": "Escapa al monte",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "cual",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.1",
                "verseOrgIds": [
                  "PSA.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ave?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        },
        {
          "text": "he aquí, los malos flecharon el arco,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:2"
      },
      "items": [
        {
          "text": "Apercibieron sus saetas sobre la cuerda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:2"
      },
      "items": [
        {
          "text": "Para asaetear en oculto á los rectos de corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.2",
            "verseOrgIds": [
              "PSA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si fueren destruídos los fundamentos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.3",
            "verseOrgIds": [
              "PSA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:3"
      },
      "items": [
        {
          "text": "¿Qué ha de hacer el justo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.3",
            "verseOrgIds": [
              "PSA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová en el templo de su santidad:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:4"
      },
      "items": [
        {
          "text": "La silla de Jehová está en el cielo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:4"
      },
      "items": [
        {
          "text": "Sus ojos ven, sus párpados examinan á los hijos de los hombres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová prueba al justo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:5"
      },
      "items": [
        {
          "text": "Empero al malo y al que ama la violencia, su alma aborrece.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sobre los malos lloverá lazos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:6"
      },
      "items": [
        {
          "text": "Fuego y azufre, con vientos de torbellinos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        },
        {
          "text": "será la porción del cáliz de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque el justo Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        },
        {
          "text": "ama la justicia:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 11:7"
      },
      "items": [
        {
          "text": "Al recto mirará su rostro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.12",
    "number": "12",
    "bookId": "PSA"
  },
