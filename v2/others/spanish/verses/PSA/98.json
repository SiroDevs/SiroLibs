{
  "id": "PSA.98",
  "number": "98",
  "bookId": "PSA",
  "reference": "Salmos 98",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "98",
        "style": "c",
        "sid": "PSA 98"
      },
      "items": [
        {
          "text": "98",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 98:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "CANTAD á Jehová canción nueva;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "Porque ha hecho maravillas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "Su diestra lo ha salvado, y su santo brazo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 98:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehová ha hecho notoria su salud:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:2"
      },
      "items": [
        {
          "text": "En ojos de las gentes ha descubierto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        },
        {
          "text": "su justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 98:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hase acordado de su misericordia y de su verdad para con la casa de Israel:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "Todos los términos de la tierra han visto la salud de nuestro Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Grandeza del reino de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Propósitos de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 98:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantad alegres á Jehová, toda la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:4"
      },
      "items": [
        {
          "text": "Levantad la voz, y aplaudid, y salmead.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 98:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salmead á Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        },
        {
          "text": "con arpa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:5"
      },
      "items": [
        {
          "text": "Con arpa y voz de cántico.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 98:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aclamad con trompetas y sonidos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:6"
      },
      "items": [
        {
          "text": "De bocina delante del rey Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 98:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Brame la mar y su plenitud;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:7"
      },
      "items": [
        {
          "text": "El mundo y los que en él habitan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 98:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los ríos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        },
        {
          "text": "batan las manos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:8"
      },
      "items": [
        {
          "text": "Los montes todos hagan regocijo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 98:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delante de Jehová;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        },
        {
          "text": "porque vino á juzgar la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "Juzgará al mundo con justicia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "Y á los pueblos con rectitud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    }
  ],
