{
  "id": "PSA.65",
  "number": "65",
  "bookId": "PSA",
  "reference": "Salmos 65",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "65",
        "style": "c",
        "sid": "PSA 65"
      },
      "items": [
        {
          "text": "65",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: Salmo: Cántico de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 65:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A TI es plácida la alabanza en Sión, oh Dios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.1",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:1"
      },
      "items": [
        {
          "text": "Y á ti se pagarán los votos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.1",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú oyes la oración:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:2"
      },
      "items": [
        {
          "text": "A ti vendrá toda carne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Acciones de gracias por",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 los beneficios de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 65:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palabras de iniquidades me sobrepujaron:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Mas",
              "type": "text",
              "attrs": {
                "verseId": "PSA.65.3",
                "verseOrgIds": [
                  "PSA.65.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nuestras rebeliones",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        },
        {
          "text": "tú las perdonarás.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichoso el que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        },
        {
          "text": "tú escogieres, é hicieres llegar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "á ti,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.65.4",
                "verseOrgIds": [
                  "PSA.65.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "Para que habite en tus atrios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "Seremos saciados del bien de tu casa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "De tu santo templo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con tremendas cosas, en justicia, nos responderás tú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "Oh Dios de nuestra salud,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "Esperanza de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        },
        {
          "text": "todos los términos de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "Y de los más remotos",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "confines",
              "type": "text",
              "attrs": {
                "verseId": "PSA.65.5",
                "verseOrgIds": [
                  "PSA.65.6"
                ]
              }
            }
          ]
        },
        {
          "text": "de la mar.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Tú,",
              "type": "text",
              "attrs": {
                "verseId": "PSA.65.6",
                "verseOrgIds": [
                  "PSA.65.7"
                ]
              }
            }
          ]
        },
        {
          "text": "el que afirma los montes con su potencia,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:6"
      },
      "items": [
        {
          "text": "Ceñido de valentía:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que amansa el estruendo de los mares, el estruendo de sus ondas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:7"
      },
      "items": [
        {
          "text": "Y el alboroto de las gentes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 65:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tanto los habitadores de los fines",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "de la tierra",
              "type": "text",
              "attrs": {
                "verseId": "PSA.65.8",
                "verseOrgIds": [
                  "PSA.65.9"
                ]
              }
            }
          ]
        },
        {
          "text": "temen de tus maravillas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "Tú haces alegrar las salidas de la mañana y de la tarde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Visitas la tierra, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        },
        {
          "text": "la riegas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "En gran manera la enriqueces",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "Con el río de Dios, lleno de aguas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "Preparas el grano de ellos, cuando así la dispones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haces se empapen sus surcos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "Haces descender sus canales:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "Ablándasla con lluvias,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "Bendices sus renuevos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 65:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú coronas el año de tus bienes;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:11"
      },
      "items": [
        {
          "text": "Y tus nubes destilan grosura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Destilan sobre las",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        },
        {
          "text": "estancias del desierto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:12"
      },
      "items": [
        {
          "text": "Y los collados se ciñen de alegría.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 65:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vístense los llanos de manadas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 65:13"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
