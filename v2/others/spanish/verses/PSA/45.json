{
  "id": "PSA.45",
  "number": "45",
  "bookId": "PSA",
  "reference": "Salmos 45",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "PSA 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Al Músico principal: sobre Sosannim: para los hijos de Coré: Masquil: Canción de amores.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "REBOSA mi corazón palabra buena:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:1"
      },
      "items": [
        {
          "text": "Refiero yo al Rey mis obras:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:1"
      },
      "items": [
        {
          "text": "Mi lengua es pluma de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        },
        {
          "text": "escribiente muy ligero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haste hermoseado más que los hijos de los hombres;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "La gracia se derramó en tus labios:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "Por tanto Dios te ha bendecido para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cíñete tu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        },
        {
          "text": "espada sobre el muslo, oh valiente,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:3"
      },
      "items": [
        {
          "text": "Con tu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        },
        {
          "text": "gloria y con tu majestad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y en tu gloria sé prosperado:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "Cabalga sobre palabra de verdad, y de humildad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "y",
              "type": "text",
              "attrs": {
                "verseId": "PSA.45.4",
                "verseOrgIds": [
                  "PSA.45.5"
                ]
              }
            }
          ]
        },
        {
          "text": "de justicia;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "Y tu diestra te enseñará",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        },
        {
          "text": "cosas terribles.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tus",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        },
        {
          "text": "saetas agudas",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Con que",
              "type": "text",
              "attrs": {
                "verseId": "PSA.45.5",
                "verseOrgIds": [
                  "PSA.45.6"
                ]
              }
            }
          ]
        },
        {
          "text": "caerán pueblos debajo de ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Penetrarán",
              "type": "text",
              "attrs": {
                "verseId": "PSA.45.5",
                "verseOrgIds": [
                  "PSA.45.6"
                ]
              }
            }
          ]
        },
        {
          "text": "en el corazón de los enemigos del Rey.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu trono, oh Dios, eterno y para siempre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:6"
      },
      "items": [
        {
          "text": "Vara de justicia la vara de tu reino.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaste la justicia y aborreciste la maldad:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "Por tanto te ungió",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        },
        {
          "text": "Dios, el Dios tuyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "Con óleo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        },
        {
          "text": "de gozo sobre tus compañeros.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirra, áloe, y casia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "exhalan",
              "type": "text",
              "attrs": {
                "verseId": "PSA.45.8",
                "verseOrgIds": [
                  "PSA.45.9"
                ]
              }
            }
          ]
        },
        {
          "text": "todos tus vestidos:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "En estancias de marfil te han recreado.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hijas de reyes entre tus ilustres:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:9"
      },
      "items": [
        {
          "text": "Está la reina á tu diestra con",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        },
        {
          "text": "oro de Ophir.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oye, hija, y mira, é inclina tu oído;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:10"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        },
        {
          "text": "olvida tu pueblo, y la casa de tu padre;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y deseará el rey tu hermosura:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:11"
      },
      "items": [
        {
          "text": "E inclínate á él, porque él es tu Señor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Confianza completa en Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Adoración gozosa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y las hijas de Tiro",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "vendrán",
              "type": "text",
              "attrs": {
                "verseId": "PSA.45.12",
                "verseOrgIds": [
                  "PSA.45.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        },
        {
          "text": "con presente;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:12"
      },
      "items": [
        {
          "text": "Implorarán tu favor los ricos del pueblo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toda ilustre es de dentro la hija del rey:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 45:13"
      },
      "items": [
        {
          "text": "De brocado de oro es su vestido.",
          "type": "text",
          "attrs": {
