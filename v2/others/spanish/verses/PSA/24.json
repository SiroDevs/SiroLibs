      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salmo de David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DE Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        },
        {
          "text": "es la tierra y su plenitud;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:1"
      },
      "items": [
        {
          "text": "El mundo, y los que en él habitan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque él la fundó sobre los mares,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.2",
            "verseOrgIds": [
              "PSA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:2"
      },
      "items": [
        {
          "text": "Y afirmóla sobre los ríos.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.2",
            "verseOrgIds": [
              "PSA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién subirá al monte de Jehová?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:3"
      },
      "items": [
        {
          "text": "¿Y quién estará en el",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        },
        {
          "text": "lugar de su santidad?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.3",
            "verseOrgIds": [
              "PSA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "El limpio de manos, y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        },
        {
          "text": "puro de corazón:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:4"
      },
      "items": [
        {
          "text": "El que no ha elevado su alma á la vanidad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:4"
      },
      "items": [
        {
          "text": "Ni jurado con engaño.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El recibirá bendición de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:5"
      },
      "items": [
        {
          "text": "Y justicia del",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        },
        {
          "text": "Dios de salud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tal es la generación de los que le buscan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:6"
      },
      "items": [
        {
          "text": "De los que buscan tu rostro, oh",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Dios de",
              "type": "text",
              "attrs": {
                "verseId": "PSA.24.6",
                "verseOrgIds": [
                  "PSA.24.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Jacob. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alzad, oh puertas, vuestras cabezas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:7"
      },
      "items": [
        {
          "text": "Y alzaos vosotras, puertas eternas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:7"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        },
        {
          "text": "entrará el Rey de gloria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién es este Rey de gloria?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:8"
      },
      "items": [
        {
          "text": "Jehová el fuerte y valiente,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:8"
      },
      "items": [
        {
          "text": "Jehová el poderoso en batalla.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 David implora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 el socorro de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alzad, oh puertas, vuestras cabezas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.9",
            "verseOrgIds": [
              "PSA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:9"
      },
      "items": [
        {
          "text": "Y alzaos vosotras, puertas eternas,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.9",
            "verseOrgIds": [
              "PSA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:9"
      },
      "items": [
        {
          "text": "Y entrará el Rey de gloria.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.9",
            "verseOrgIds": [
              "PSA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién es este Rey de gloria?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.10",
            "verseOrgIds": [
              "PSA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:10"
      },
      "items": [
        {
          "text": "Jehová de los ejércitos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.10",
            "verseOrgIds": [
              "PSA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 24:10"
      },
      "items": [
        {
          "text": "El es el Rey de la gloria. (Selah.)",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.10",
            "verseOrgIds": [
              "PSA.24.10"
            ]
          }
        }
      ]
