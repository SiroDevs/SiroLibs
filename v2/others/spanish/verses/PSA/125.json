{
  "id": "PSA.125",
  "number": "125",
  "bookId": "PSA",
  "reference": "Salmos 125",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 5,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "125",
        "style": "c",
        "sid": "PSA 125"
      },
      "items": [
        {
          "text": "125",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Cántico gradual.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 125:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "LOS que confían en Jehová",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 125:1"
      },
      "items": [
        {
          "text": "Son como el monte de Sión que no deslizará: estará para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 125:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como Jerusalem tiene montes alrededor de ella,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "Así Jehová alrededor de su pueblo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "Desde ahora y para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 125:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        },
        {
          "text": "no reposará la vara de la impiedad sobre la",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        },
        {
          "text": "suerte de los justos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 125:3"
      },
      "items": [
        {
          "text": "Porque no extiendan los justos sus manos á la iniquidad.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 125:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haz bien, oh Jehová, á los buenos,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 125:4"
      },
      "items": [
        {
          "text": "Y á los que son rectos en sus corazones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 125:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas á los que",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        },
        {
          "text": "se apartan tras sus perversidades,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 125:5"
      },
      "items": [
        {
          "text": "Jehová los llevará con los que obran iniquidad:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 125:5"
      },
      "items": [
        {
          "text": "Y paz sea sobre Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    }
  ],
