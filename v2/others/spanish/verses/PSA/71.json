{
  "id": "PSA.71",
  "number": "71",
  "bookId": "PSA",
  "reference": "Salmos 71",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "71",
        "style": "c",
        "sid": "PSA 71"
      },
      "items": [
        {
          "text": "71",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 71:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "EN ti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        },
        {
          "text": "oh Jehová, he esperado;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:1"
      },
      "items": [
        {
          "text": "No sea yo confuso para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 71:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazme escapar, y líbrame en tu justicia:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.2",
            "verseOrgIds": [
              "PSA.71.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:2"
      },
      "items": [
        {
          "text": "Inclina tu oído y sálvame.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.2",
            "verseOrgIds": [
              "PSA.71.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 71:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Séme por peña de estancia, adonde recurra yo continuamente:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:3"
      },
      "items": [
        {
          "text": "Mandado has que yo sea salvo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:3"
      },
      "items": [
        {
          "text": "Porque tú eres mi roca, y mi fortaleza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.3",
            "verseOrgIds": [
              "PSA.71.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 71:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dios mío, líbrame de la mano del impío,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.4",
            "verseOrgIds": [
              "PSA.71.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:4"
      },
      "items": [
        {
          "text": "De la mano del perverso y violento.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.4",
            "verseOrgIds": [
              "PSA.71.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 71:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque tú, oh Señor Jehová, eres",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        },
        {
          "text": "mi esperanza:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:5"
      },
      "items": [
        {
          "text": "Seguridad mía desde mi juventud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 71:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por ti he sido sustentado desde el vientre:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:6"
      },
      "items": [
        {
          "text": "De las entrañas de mi madre tú fuiste el que me sacaste:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:6"
      },
      "items": [
        {
          "text": "De ti será siempre mi alabanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 71:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como prodigio he sido á muchos;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:7"
      },
      "items": [
        {
          "text": "Y tú mi refugio fuerte.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 71:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        },
        {
          "text": "llena mi boca de tu alabanza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:8"
      },
      "items": [
        {
          "text": "De tu gloria todo el día.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 71:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "No me deseches en el tiempo de la vejez;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:9"
      },
      "items": [
        {
          "text": "Cuando mi fuerza se acabare, no me desampares.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 71:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque mis enemigos han tratado de mí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:10"
      },
      "items": [
        {
          "text": "Y los que acechan mi alma, consultaron juntamente.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 71:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diciendo: Dios lo ha dejado:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:11"
      },
      "items": [
        {
          "text": "Perseguid y tomadle, porque no hay quien le libre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 71:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Dios, no te alejes de mí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:12"
      },
      "items": [
        {
          "text": "Dios mío,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        },
        {
          "text": "acude presto á mi socorro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 71:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sean avergonzados, fallezcan los adversarios de mi alma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:13"
      },
      "items": [
        {
          "text": "Sean cubiertos de vergüenza y de confusión los que mi mal buscan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 71:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas yo siempre esperaré,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.14",
            "verseOrgIds": [
              "PSA.71.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:14"
      },
      "items": [
        {
          "text": "Y añadiré sobre toda tu alabanza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.14",
            "verseOrgIds": [
              "PSA.71.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 71:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi boca publicará tu justicia",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:15"
      },
      "items": [
        {
          "text": "Y tu salud todo el día,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:15"
      },
      "items": [
        {
          "text": "Aunque no sé el número",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.15",
            "verseOrgIds": [
              "PSA.71.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "de ellas.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.71.15",
                "verseOrgIds": [
                  "PSA.71.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 71:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vendré á las valentías del Señor Jehová:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.16",
            "verseOrgIds": [
              "PSA.71.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:16"
      },
      "items": [
        {
          "text": "Haré memoria de sola tu justicia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.16",
            "verseOrgIds": [
              "PSA.71.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Las bondades de Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Plegaria por Salomón.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 71:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Dios, enseñásteme desde mi mocedad;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.17",
            "verseOrgIds": [
              "PSA.71.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:17"
      },
      "items": [
        {
          "text": "Y hasta ahora he manifestado tus maravillas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.17",
            "verseOrgIds": [
              "PSA.71.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 71:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y aun hasta la vejez y las canas; oh Dios, no me desampares,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.18",
            "verseOrgIds": [
              "PSA.71.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:18"
      },
      "items": [
        {
          "text": "Hasta que denuncie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.18",
            "verseOrgIds": [
              "PSA.71.18"
            ]
          }
        },
        {
          "text": "tu brazo á la posteridad,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.18",
            "verseOrgIds": [
              "PSA.71.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:18"
      },
      "items": [
        {
          "text": "Tus valentías á todos los que han de venir.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.18",
            "verseOrgIds": [
              "PSA.71.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 71:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y tu justicia, oh Dios, hasta lo excelso;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.19",
            "verseOrgIds": [
              "PSA.71.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:19"
      },
      "items": [
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.19",
            "verseOrgIds": [
              "PSA.71.19"
            ]
          }
        },
        {
          "text": "has hecho grandes cosas:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.19",
            "verseOrgIds": [
              "PSA.71.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:19"
      },
      "items": [
        {
          "text": "Oh Dios, ¿quién como tú?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.19",
            "verseOrgIds": [
              "PSA.71.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 71:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tú, que me has hecho ver muchas angustias y males,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.20",
            "verseOrgIds": [
              "PSA.71.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:20"
      },
      "items": [
        {
          "text": "Volverás á darme vida,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.20",
            "verseOrgIds": [
              "PSA.71.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:20"
      },
      "items": [
        {
          "text": "Y de nuevo me levantarás de los abismos de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.20",
            "verseOrgIds": [
              "PSA.71.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 71:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aumentarás mi grandeza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.21",
            "verseOrgIds": [
              "PSA.71.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:21"
      },
      "items": [
        {
          "text": "Y volverás á consolarme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.21",
            "verseOrgIds": [
              "PSA.71.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 71:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asimismo yo te alabaré con instrumento de salterio,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:22"
      },
      "items": [
        {
          "text": "Oh Dios mío: tu verdad cantaré yo á ti en el arpa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:22"
      },
      "items": [
        {
          "text": "Oh Santo de Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 71:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mis labios cantarán cuando á ti salmeare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.23",
            "verseOrgIds": [
              "PSA.71.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:23"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.23",
            "verseOrgIds": [
              "PSA.71.23"
            ]
          }
        },
        {
          "text": "mi alma, á la cual redimiste.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.23",
            "verseOrgIds": [
              "PSA.71.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 71:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi lengua hablará también de tu justicia todo el día:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.24",
            "verseOrgIds": [
              "PSA.71.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PSA 71:24"
      },
      "items": [
        {
          "text": "Por cuanto fueron avergonzados, porque fueron confusos los que mi mal procuraban.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.24",
            "verseOrgIds": [
              "PSA.71.24"
            ]
          }
        }
      ]
    }
