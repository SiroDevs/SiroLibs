          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        },
        {
          "text": "censo? ¿de sus hijos ó de los extraños?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        }
