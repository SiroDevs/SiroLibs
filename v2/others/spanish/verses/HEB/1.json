{
  "id": "HEB.1",
  "number": "1",
  "bookId": "HEB",
  "reference": "Hebreos 1",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "HEB 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "DIOS, habiendo hablado muchas veces y",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "text": "en muchas maneras en otro tiempo á los padres por los profetas,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "En",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "text": "estos porstreros días nos ha hablado por",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "text": "el Hijo, al cual constituyó",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "text": "heredero de todo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "text": "por el cual asimismo hizo el universo:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "El cual",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "text": "siendo el resplandor",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "text": "de su gloria, y",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "text": "la misma imagen de su sustancia, y",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "text": "sustentando todas las cosas con la palabra de su potencia,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "text": "habiendo hecho la purgación de nuestros pecados por sí mismo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "text": "se sentó á la diestra de la Majestad en las alturas,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hecho tanto más excelente que los ángeles, cuanto",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
        {
          "text": "alcanzó por herencia más excelente nombre que ellos.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque ¿á cuál de los ángeles dijo",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Dios",
              "type": "text",
              "attrs": {
                "verseId": "HEB.1.5",
                "verseOrgIds": [
                  "HEB.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "jamás:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "Mi hijo eres tú,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "Hoy yo te he engendrado?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "Y otra vez:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "Yo seré á él Padre,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:5"
      },
      "items": [
        {
          "text": "Y él me será á mí hijo?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y otra vez, cuando introduce",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        },
        {
          "text": "al Primogénito en la tierra, dice: Y adórenle todos los ángeles de Dios.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ciertamente de los ángeles dice:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:7"
      },
      "items": [
        {
          "text": "El que hace á sus ángeles espíritus,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:7"
      },
      "items": [
        {
          "text": "Y á sus ministros llama de fuego.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas al hijo:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:8"
      },
      "items": [
        {
          "text": "Tu trono, oh Dios, por el siglo del siglo;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:8"
      },
      "items": [
        {
          "text": "Vara de equidad la vara de tu reino;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Has amado la justicia, y aborrecido la maldad;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:9"
      },
      "items": [
        {
          "text": "Por lo cual te ungió Dios, el Dios tuyo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:9"
      },
      "items": [
        {
          "text": "Con óleo de alegría más que á tus compañeros.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.10",
            "verseOrgIds": [
              "HEB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:10"
      },
      "items": [
        {
          "text": "Tú, oh Señor, en el principio fundaste la tierra;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.10",
            "verseOrgIds": [
              "HEB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:10"
      },
      "items": [
        {
          "text": "Y los cielos son obras de tus manos:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.10",
            "verseOrgIds": [
              "HEB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ellos perecerán, mas tú eres permanente;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.11",
            "verseOrgIds": [
              "HEB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:11"
      },
      "items": [
        {
          "text": "Y todos ellos se envejecerán como una vestidura;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.11",
            "verseOrgIds": [
              "HEB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y como un vestido los envolverás, y serán mudados;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:12"
      },
      "items": [
        {
          "text": "Empero tú eres el mismo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:12"
      },
      "items": [
        {
          "text": "Y tus años no acabarán.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues, ¿á cuál de los ángeles dijo jamás:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:13"
      },
      "items": [
        {
          "text": "Siéntate á mi diestra,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "HEB 1:13"
      },
      "items": [
        {
          "text": "Hasta que ponga á tus enemigos por estrado de tus pies?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿No son",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.14",
            "verseOrgIds": [
              "HEB.1.14"
            ]
          }
        },
        {
          "text": "todos espíritus administradores, enviados para servicio á favor de los que serán herederos de salud?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.14",
            "verseOrgIds": [
              "HEB.1.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "HEB.2",
    "number": "2",
