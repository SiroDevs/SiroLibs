      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Y qué más digo? porque el tiempo me faltará contando",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
