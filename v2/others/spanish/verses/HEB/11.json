          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teniendo por mayores riquezas",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        },
        {
          "text": "el vituperio de Cristo que los tesoros de los Egipcios; porque miraba á",
