          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        },
        {
          "text": "la remuneración.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        }
      ]
    },
