              "HEB.11.32"
            ]
          }
        },
        {
          "text": "de Barac,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "text": "de Samsón,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "text": "de Jephté, de",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "text": "David,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "text": "de Samuel, y de los profetas:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        }
      ]
    },
    {
