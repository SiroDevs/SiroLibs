          "text": "Por fe",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.24",
            "verseOrgIds": [
              "HEB.11.24"
            ]
          }
        },
        {
          "text": "Moisés, hecho ya grande, rehusó ser llamado hijo de la hija de Faraón;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.24",
            "verseOrgIds": [
              "HEB.11.24"
            ]
          }
        }
