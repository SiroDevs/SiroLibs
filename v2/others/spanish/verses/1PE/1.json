{
  "id": "1PE.1",
  "number": "1",
  "bookId": "1PE",
  "reference": "1 Pedro 1",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1PE 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "PEDRO, apóstol de Jesucristo, á los extranjeros",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "text": "esparcidos en Ponto, en Galacia, en Capadocia, en Asia, y en Bithinia,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elegidos",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        },
        {
          "text": "según",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        },
        {
          "text": "la presciencia de Dios Padre en santificación del Espíritu, para obedecer y",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        },
        {
          "text": "ser rociados con la sangre de Jesucristo:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        },
        {
          "text": "Gracia y paz os sea multiplicada.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bendito el Dios",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "text": "y Padre de nuestro Señor Jesucristo, que según su grande misericordia",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "text": "nos ha regenerado en esperanza viva,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "text": "por la resurrección de Jesucristo de los muertos,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para una herencia incorruptible, y que no puede contaminarse, ni marchitarse,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "text": "reservada en los cielos",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para nosotros",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "text": "que somos guardados en la virtud de Dios por fe, para alcanzar la salud que está aparejada para ser manifestada en el postrimero tiempo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "En lo cual vosotros os alegráis, estando",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "text": "al presente un poco de tiempo afligidos en diversas tentaciones,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "text": "si es necesario,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para que",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "text": "la prueba de vuestra fe, mucho más preciosa que el oro, el cual perece, bien que sea",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "text": "probado con fuego,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "text": "sea hallada en alabanza, gloria y honra,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "text": "cuando Jesucristo fuere manifestado:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al cual, no habiendo visto, le amáis;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "text": "en el cual creyendo, aunque al presente no lo veáis,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "text": "os alegráis con gozo inefable y glorificado;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obteniendo el fin de vuestra fe,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que es",
              "type": "text",
              "attrs": {
                "verseId": "1PE.1.9",
                "verseOrgIds": [
                  "1PE.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "la salud de",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "vuestras",
              "type": "text",
              "attrs": {
                "verseId": "1PE.1.9",
                "verseOrgIds": [
                  "1PE.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "almas.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "De la cual salud",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "text": "los profetas que profetizaron de la gracia que había de venir á vosotros, han inquirido y diligentemente buscado,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Escudriñando cuándo y en qué punto de tiempo significaba",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "text": "el Espíritu de Cristo que estaba en ellos, el cual prenunciaba",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "text": "las aflicciones que habían de venir á Cristo, y las glorias después de ellas.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "A los cuales fué revelado, que no para sí mismos, sino para nosotros administraban las cosas que ahora os son anunciadas de los que os han predicado el evangelio por",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        },
        {
          "text": "el Espíritu Santo enviado del cielo; en las cuales desean mirar los ángeles.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por lo cual,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "text": "teniendo los lomos de vuestro entendimiento ceñidos,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "text": "con templanza, esperad perfectamente en la gracia que os es",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "text": "presentada cuando Jesucristo os es manifestado:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como hijos obedientes,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "text": "no conformándoos con los deseos que antes teníais estando",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "text": "en vuestra ignorancia;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sino como aquel",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "text": "que os ha llamado es santo, sed también vosotros santos en toda",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "text": "conversación:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque escrito está:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        },
        {
          "text": "Sed santos, porque yo soy santo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y si invocáis por Padre á aquel que",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "text": "sin acepción de personas juzga según la obra de cada uno, conversad en",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "text": "temor todo el tiempo de vuestra",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "text": "peregrinación:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabiendo",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "text": "que habéis sido rescatados de vuestra vana",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "text": "conversación, la cual",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "text": "recibisteis de vuestros padres, no con cosas corruptibles,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "como",
              "type": "text",
              "attrs": {
                "verseId": "1PE.1.18",
                "verseOrgIds": [
                  "1PE.1.18"
                ]
              }
            }
          ]
        },
        {
          "text": "oro ó plata;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sino con la",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "text": "sangre preciosa de Cristo, como de",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "text": "un cordero",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "text": "sin mancha y sin contaminación:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya ordenado de antes de la fundación del mundo, pero manifestado",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.20",
            "verseOrgIds": [
              "1PE.1.20"
            ]
          }
        },
        {
          "text": "en los postrimeros tiempos por amor de vosotros,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.20",
            "verseOrgIds": [
              "1PE.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que por él creéis á Dios,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        },
        {
          "text": "el cual le resucitó de los muertos, y",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        },
        {
          "text": "le ha dado gloria, para que vuestra fe y esperanza sea en Dios.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habiendo",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "text": "purificado vuestras almas en la obediencia de la verdad, por el Espíritu,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "text": "en caridad hermanable sin fingimiento, amaos unos á otros",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "text": "entrañablemente de corazón puro:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Cristo, la piedra angular.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Sumisión á la autoridad.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siendo renacidos, no de simiente corruptible, sino de incorruptible,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "text": "por la",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "text": "palabra de Dios,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "text": "que vive y permanece para siempre.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "Toda carne es como la hierba,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "Y toda la gloria del hombre como la flor de la hierba:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "Secóse la hierba, y la flor se cayó;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1PE 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas la palabra del Señor permanece perpetuamente.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.25",
            "verseOrgIds": [
              "1PE.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1PE 1:25"
      },
      "items": [
        {
          "text": "Y esta es la palabra que por el evangelio os ha sido anunciada.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.25",
            "verseOrgIds": [
              "1PE.1.25"
            ]
          }
        }
      ]
    }
