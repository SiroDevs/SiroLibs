          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque á ninguno tengo tan unánime,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.20",
            "verseOrgIds": [
              "PHP.2.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "y",
              "type": "text",
              "attrs": {
                "verseId": "PHP.2.20",
                "verseOrgIds": [
                  "PHP.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "que con sincera afición esté solícito por vosotros.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.20",
            "verseOrgIds": [
              "PHP.2.20"
            ]
          }
        }
      ]
    },
