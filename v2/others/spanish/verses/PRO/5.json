      "attrs": {
        "style": "q",
        "vid": "PRO 5:20"
      },
      "items": [
        {
          "text": "Y abrazarás el seno de la extraña?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.20",
            "verseOrgIds": [
              "PRO.5.20"
            ]
          }
        }
      ]
