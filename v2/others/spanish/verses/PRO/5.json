{
  "id": "PRO.5",
  "number": "5",
  "bookId": "PRO",
  "reference": "Proverbios 5",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "PRO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "HIJO mío, está atento á mi sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:1"
      },
      "items": [
        {
          "text": "Y á mi inteligencia inclina tu oído;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para que guardes consejo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:2"
      },
      "items": [
        {
          "text": "Y tus labios",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        },
        {
          "text": "conserven la ciencia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque los labios de la extraña destilan miel,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:3"
      },
      "items": [
        {
          "text": "Y su paladar es más blando que el aceite;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas su fin es",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        },
        {
          "text": "amargo como el ajenjo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:4"
      },
      "items": [
        {
          "text": "Agudo como cuchillo de dos filos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sus pies descienden á la muerte;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:5"
      },
      "items": [
        {
          "text": "Sus pasos sustentan el sepulcro:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sus caminos son instables; no",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "los",
              "type": "text",
              "attrs": {
                "verseId": "PRO.5.6",
                "verseOrgIds": [
                  "PRO.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "conocerás,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:6"
      },
      "items": [
        {
          "text": "Si no considerares el camino de vida.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahora pues, hijos, oidme,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:7"
      },
      "items": [
        {
          "text": "Y no os apartéis de las razones de mi boca.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aleja de ella tu camino,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:8"
      },
      "items": [
        {
          "text": "Y no te acerques á la puerta de su casa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no des á los extraños tu honor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:9"
      },
      "items": [
        {
          "text": "Y tus años á cruel;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque no se harten los extraños de tu fuerza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:10"
      },
      "items": [
        {
          "text": "Y tus trabajos",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "estén",
              "type": "text",
              "attrs": {
                "verseId": "PRO.5.10",
                "verseOrgIds": [
                  "PRO.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "en casa del extraño;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y gimas en tus postrimerías,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:11"
      },
      "items": [
        {
          "text": "Cuando se consumiere tu carne y tu cuerpo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y digas: ¡Cómo aborrecí el consejo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:12"
      },
      "items": [
        {
          "text": "Y mi corazón",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        },
        {
          "text": "menospreció la reprensión;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y no oí la voz de los que me adoctrinaban,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:13"
      },
      "items": [
        {
          "text": "Y á los que me enseñaban no incliné mi oído!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Exhortación a",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 no salir fiador.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Casi en todo mal he estado,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:14"
      },
      "items": [
        {
          "text": "En medio de la sociedad y de la congregación.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bebe el agua de tu cisterna,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:15"
      },
      "items": [
        {
          "text": "Y los raudales de tu pozo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derrámense por de fuera tus fuentes,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:16"
      },
      "items": [
        {
          "text": "En las plazas los ríos de aguas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sean para ti solo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:17"
      },
      "items": [
        {
          "text": "Y no para los extraños contigo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sea bendito tu manantial;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.18",
            "verseOrgIds": [
              "PRO.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 5:18"
      },
      "items": [
        {
          "text": "Y alégrate con",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.18",
            "verseOrgIds": [
              "PRO.5.18"
            ]
          }
        },
        {
