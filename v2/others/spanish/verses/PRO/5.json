              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Y por qué, hijo mío, andarás ciego con la ajena,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.20",
            "verseOrgIds": [
              "PRO.5.20"
            ]
          }
        }
