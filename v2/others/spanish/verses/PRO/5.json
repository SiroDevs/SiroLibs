              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pues que los caminos del hombre están",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.21",
            "verseOrgIds": [
              "PRO.5.21"
            ]
          }
        },
        {
