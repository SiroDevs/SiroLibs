      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 18:22"
      },
      "items": [
        {
          "text": "Y alcanzó la benevolencia de Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.22",
            "verseOrgIds": [
              "PRO.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
