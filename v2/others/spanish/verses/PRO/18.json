          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que halló esposa halló el bien,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.22",
            "verseOrgIds": [
              "PRO.18.22"
            ]
          }
        }
      ]
