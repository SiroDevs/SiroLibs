      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 18:23"
      },
      "items": [
        {
          "text": "Mas el rico responde",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.23",
            "verseOrgIds": [
              "PRO.18.23"
            ]
          }
        },
        {
          "text": "durezas.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.23",
            "verseOrgIds": [
              "PRO.18.23"
            ]
          }
        }
      ]
    },
    {
