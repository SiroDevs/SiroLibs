          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "El pobre habla con ruegos;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.23",
            "verseOrgIds": [
              "PRO.18.23"
            ]
          }
        }
      ]
    },
