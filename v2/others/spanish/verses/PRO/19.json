{
  "id": "PRO.19",
  "number": "19",
  "bookId": "PRO",
  "reference": "Proverbios 19",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "PRO 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MEJOR",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.1",
            "verseOrgIds": [
              "PRO.19.1"
            ]
          }
        },
        {
          "text": "es el pobre que camina en su sencillez,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.1",
            "verseOrgIds": [
              "PRO.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:1"
      },
      "items": [
        {
          "text": "Que el de perversos labios y fatuo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.1",
            "verseOrgIds": [
              "PRO.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Proverbios sobre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 diversos asuntos.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "El alma sin ciencia no es buena;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.2",
            "verseOrgIds": [
              "PRO.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:2"
      },
      "items": [
        {
          "text": "Y el presuroso de pies peca.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.2",
            "verseOrgIds": [
              "PRO.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "La insensatez del hombre tuerce su camino;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.3",
            "verseOrgIds": [
              "PRO.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:3"
      },
      "items": [
        {
          "text": "Y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.3",
            "verseOrgIds": [
              "PRO.19.3"
            ]
          }
        },
        {
          "text": "contra Jehová se aira su corazón.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.3",
            "verseOrgIds": [
              "PRO.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las riquezas allegan muchos amigos:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.4",
            "verseOrgIds": [
              "PRO.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:4"
      },
      "items": [
        {
          "text": "Mas el pobre, de su amigo es apartado.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.4",
            "verseOrgIds": [
              "PRO.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "El testigo falso no quedará sin castigo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.5",
            "verseOrgIds": [
              "PRO.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:5"
      },
      "items": [
        {
          "text": "Y el que habla mentiras no escapará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.5",
            "verseOrgIds": [
              "PRO.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchos rogarán al príncipe:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.6",
            "verseOrgIds": [
              "PRO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:6"
      },
      "items": [
        {
          "text": "Mas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.6",
            "verseOrgIds": [
              "PRO.19.6"
            ]
          }
        },
        {
          "text": "cada uno es amigo del hombre que da.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.6",
            "verseOrgIds": [
              "PRO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todos los hermanos del pobre le aborrecen:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:7"
      },
      "items": [
        {
          "text": "¡Cuánto más sus amigos se alejarán de él!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:7"
      },
      "items": [
        {
          "text": "Buscará la palabra y no la hallará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.7",
            "verseOrgIds": [
              "PRO.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que posee entendimiento, ama su alma:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.8",
            "verseOrgIds": [
              "PRO.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:8"
      },
      "items": [
        {
          "text": "El que guarda la inteligencia, hallará el bien.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.8",
            "verseOrgIds": [
              "PRO.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "El testigo falso no quedará sin castigo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.9",
            "verseOrgIds": [
              "PRO.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:9"
      },
      "items": [
        {
          "text": "Y el que habla mentiras, perecerá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.9",
            "verseOrgIds": [
              "PRO.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "No conviene al necio el deleite:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.10",
            "verseOrgIds": [
              "PRO.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:10"
      },
      "items": [
        {
          "text": "¡Cuánto menos",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.10",
            "verseOrgIds": [
              "PRO.19.10"
            ]
          }
        },
        {
          "text": "al siervo ser señor de los príncipes!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.10",
            "verseOrgIds": [
              "PRO.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "La cordura del hombre detiene su furor;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.11",
            "verseOrgIds": [
              "PRO.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:11"
      },
      "items": [
        {
          "text": "Y su honra es disimular la ofensa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.11",
            "verseOrgIds": [
              "PRO.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como el bramido del cachorro de león es la ira del rey;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.12",
            "verseOrgIds": [
              "PRO.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:12"
      },
      "items": [
        {
          "text": "Y su favor",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.12",
            "verseOrgIds": [
              "PRO.19.12"
            ]
          }
        },
        {
          "text": "como el rocío sobre la hierba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.12",
            "verseOrgIds": [
              "PRO.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dolor es para su padre el hijo necio;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.13",
            "verseOrgIds": [
              "PRO.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:13"
      },
      "items": [
        {
          "text": "Y gotera continua las contiendas de la mujer.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.13",
            "verseOrgIds": [
              "PRO.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "La casa y las riquezas herencia son de los padres:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.14",
            "verseOrgIds": [
              "PRO.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:14"
      },
      "items": [
        {
          "text": "Mas de Jehová la mujer prudente.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.14",
            "verseOrgIds": [
              "PRO.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "La pereza hace caer en sueño;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.15",
            "verseOrgIds": [
              "PRO.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:15"
      },
      "items": [
        {
          "text": "Y el alma negligente",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.15",
            "verseOrgIds": [
              "PRO.19.15"
            ]
          }
        },
        {
          "text": "hambreará.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.15",
            "verseOrgIds": [
              "PRO.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El que guarda",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.16",
            "verseOrgIds": [
              "PRO.19.16"
            ]
          }
        },
        {
          "text": "el mandamiento, guarda su alma:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.16",
            "verseOrgIds": [
              "PRO.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:16"
      },
      "items": [
        {
          "text": "Mas el que menospreciare sus caminos, morirá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.16",
            "verseOrgIds": [
              "PRO.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.17",
            "verseOrgIds": [
              "PRO.19.17"
            ]
          }
        },
        {
          "text": "Jehová empresta el que da al pobre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.17",
            "verseOrgIds": [
              "PRO.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 19:17"
      },
      "items": [
        {
          "text": "Y él le dará su paga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.17",
            "verseOrgIds": [
              "PRO.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Castiga á tu hijo en tanto que hay esperanza;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.18",
            "verseOrgIds": [
              "PRO.19.18"
            ]
          }
