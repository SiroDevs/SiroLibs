{
  "id": "PRO.30",
  "number": "30",
  "bookId": "PRO",
  "reference": "Proverbios 30",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PRO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "PALABRAS de Agur, hijo de Jachê:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PRO 30:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:1"
      },
      "items": [
        {
          "text": "La profecía que dijo el varón á Ithiel, á Ithiel y á Ucal.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciertamente más rudo soy yo que ninguno,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:2"
      },
      "items": [
        {
          "text": "Ni tengo entendimiento de hombre.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo ni aprendí sabiduría,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:3"
      },
      "items": [
        {
          "text": "Ni conozco la ciencia del Santo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "¿Quién subió al cielo, y descendió?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "¿Quién encerró los vientos en sus puños?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "¿Quién ató las aguas en un paño?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "¿Quién afirmó todos los términos de la tierra?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "¿Cuál es su nombre, y el nombre de su hijo, si sabes?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toda palabra de Dios",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "es",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.5",
                "verseOrgIds": [
                  "PRO.30.5"
                ]
              }
            }
          ]
        },
        {
          "text": "limpia:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:5"
      },
      "items": [
        {
          "text": "Es escudo á los que en él esperan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Las palabras",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 de Agur.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "No añadas á sus palabras, porque no te reprenda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:6"
      },
      "items": [
        {
          "text": "Y seas hallado mentiroso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dos cosas te he demandado;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:7"
      },
      "items": [
        {
          "text": "No me",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "las",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.7",
                "verseOrgIds": [
                  "PRO.30.7"
                ]
              }
            }
          ]
        },
        {
          "text": "niegues antes que muera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanidad y palabra mentirosa aparta de mí.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "No me des pobreza ni riquezas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "Manténme del pan que he menester;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "No sea que me harte, y",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "te",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.9",
                "verseOrgIds": [
                  "PRO.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "niegue, y diga, ¿Quién es Jehová?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "O no sea que siendo pobre, hurte,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "Y blasfeme el nombre de mi Dios.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "No acuses al siervo ante su señor,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:10"
      },
      "items": [
        {
          "text": "Porque no te maldiga, y peques.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay generación que maldice á su padre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:11"
      },
      "items": [
        {
          "text": "Y á su madre no bendice.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay generación",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        },
        {
          "text": "limpia en su opinión,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:12"
      },
      "items": [
        {
          "text": "Si bien no se ha limpiado su inmundicia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay generación cuyos ojos son",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        },
        {
          "text": "altivos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:13"
      },
      "items": [
        {
          "text": "Y cuyos párpados son alzados.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hay generación cuyos dientes son espadas, y sus muelas cuchillos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "Para devorar á los pobres de la tierra, y de entre los hombres á los menesterosos.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "La sanguijuela tiene dos hijas",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "que se llaman,",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.15",
                "verseOrgIds": [
                  "PRO.30.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Trae, trae.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:15"
      },
      "items": [
        {
          "text": "Tres cosas hay que nunca se hartan;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Aun",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.15",
                "verseOrgIds": [
                  "PRO.30.15"
                ]
              }
            }
          ]
        },
        {
          "text": "la cuarta nunca dice, Basta:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "El sepulcro, y la matriz estéril,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.16",
            "verseOrgIds": [
              "PRO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:16"
      },
      "items": [
        {
          "text": "La tierra no harta de aguas,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.16",
            "verseOrgIds": [
              "PRO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:16"
      },
      "items": [
        {
          "text": "Y el fuego que jamás dice, Basta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.16",
            "verseOrgIds": [
              "PRO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "El ojo que escarnece á su padre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:17"
      },
      "items": [
        {
          "text": "Y menosprecia la enseñanza de la madre,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:17"
      },
      "items": [
        {
          "text": "Los cuervos lo saquen de la arroyada,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:17"
      },
      "items": [
        {
          "text": "Y tráguenlo los hijos del águila.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tres cosas me son ocultas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.18",
            "verseOrgIds": [
              "PRO.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:18"
      },
      "items": [
        {
          "text": "Aun tampoco sé la cuarta:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.18",
            "verseOrgIds": [
              "PRO.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "El rastro del águila en el aire;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.19",
            "verseOrgIds": [
              "PRO.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "El rastro de la culebra sobre la peña;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.19",
            "verseOrgIds": [
              "PRO.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "El rastro de la nave en medio de la mar;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.19",
            "verseOrgIds": [
              "PRO.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "Y el rastro del hombre en la moza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.19",
            "verseOrgIds": [
              "PRO.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tal es el rastro de la mujer adúltera:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:20"
      },
      "items": [
        {
          "text": "Come, y limpia su boca,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:20"
      },
      "items": [
        {
          "text": "Y dice: No he hecho maldad.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por tres cosas se alborota la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.21",
            "verseOrgIds": [
              "PRO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:21"
      },
      "items": [
        {
          "text": "Y la cuarta no puede sufrir:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.21",
            "verseOrgIds": [
              "PRO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por el siervo cuando reinare;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.22",
            "verseOrgIds": [
              "PRO.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:22"
      },
      "items": [
        {
          "text": "Y por el necio cuando se hartare de pan;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.22",
            "verseOrgIds": [
              "PRO.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por la aborrecida cuando se casare;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.23",
            "verseOrgIds": [
              "PRO.30.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:23"
      },
      "items": [
        {
          "text": "Y por la sierva cuando heredare á su señora.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.23",
            "verseOrgIds": [
              "PRO.30.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuatro cosas son de las más pequeñas de la tierra,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.24",
            "verseOrgIds": [
              "PRO.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:24"
      },
      "items": [
        {
          "text": "Y las mismas son más sabias que los sabios:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.24",
            "verseOrgIds": [
              "PRO.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las hormigas, pueblo no fuerte,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.25",
            "verseOrgIds": [
              "PRO.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:25"
      },
      "items": [
        {
          "text": "Y en el verano preparan su comida;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.25",
            "verseOrgIds": [
              "PRO.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los conejos, pueblo nada esforzado,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.26",
            "verseOrgIds": [
              "PRO.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:26"
      },
      "items": [
        {
          "text": "Y ponen su casa en la piedra;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.26",
            "verseOrgIds": [
              "PRO.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las langostas, no tienen rey,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.27",
            "verseOrgIds": [
              "PRO.30.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:27"
      },
      "items": [
        {
          "text": "Y salen todas acuadrilladas;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.27",
            "verseOrgIds": [
              "PRO.30.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "La araña, ase con las manos,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.28",
            "verseOrgIds": [
              "PRO.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:28"
      },
      "items": [
        {
          "text": "Y está en palacios de rey.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.28",
            "verseOrgIds": [
              "PRO.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tres cosas hay de hermoso andar,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.29",
            "verseOrgIds": [
              "PRO.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:29"
      },
      "items": [
        {
          "text": "Y la cuarta pasea muy bien:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.29",
            "verseOrgIds": [
              "PRO.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "El león, fuerte entre todos los animales,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.30",
            "verseOrgIds": [
              "PRO.30.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "PRO 30:30"
      },
      "items": [
        {
          "text": "Que no torna atrás por nadie;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.30",
            "verseOrgIds": [
              "PRO.30.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "El",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.31",
            "verseOrgIds": [
              "PRO.30.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lebrel",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.31",
                "verseOrgIds": [
                  "PRO.30.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ceñido de lomos; asimismo el macho cabrío;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.31",
            "verseOrgIds": [
              "PRO.30.31"
            ]
          }
        }
      ]
