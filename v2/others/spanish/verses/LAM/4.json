{
  "id": "LAM.4",
  "number": "4",
  "bookId": "LAM",
  "reference": "Lamentaciones 4",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "LAM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "¡CÓMO se ha oscurecido el oro!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "¡Cómo",
              "type": "text",
              "attrs": {
                "verseId": "LAM.4.1",
                "verseOrgIds": [
                  "LAM.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "el buen oro se ha demudado!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "Las piedras del santuario están esparcidas por",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        },
        {
          "text": "las encrucijadas de todas las calles.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Calamidades de Sión",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 por sus muchos pecados.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los hijos de Sión, preciados y estimados más que el oro puro,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "¡Cómo son tenidos por vasos de barro, obra de manos de alfarero!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aun los monstruos marinos sacan la teta, dan de mamar á sus chiquitos:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "La hija de mi pueblo es cruel,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        },
        {
          "text": "como los avestruces en el desierto.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "La lengua del niño de",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        },
        {
          "text": "teta, de sed se pegó á su paladar:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:4"
      },
      "items": [
        {
          "text": "Los chiquitos pidieron pan, y no hubo quien se lo partiese.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.4",
            "verseOrgIds": [
              "LAM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los que comían delicadamente, asolados fueron en las calles;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:5"
      },
      "items": [
        {
          "text": "Los que se criaron en carmesí,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        },
        {
          "text": "abrazaron los estercoleros.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.5",
            "verseOrgIds": [
              "LAM.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y aumentóse la iniquidad de la hija de mi pueblo más que el pecado de Sodoma,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:6"
      },
      "items": [
        {
          "text": "Que",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        },
        {
          "text": "xué trastornada en un momento, y no asentaron sobre ella compañías.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.6",
            "verseOrgIds": [
              "LAM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sus",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        },
        {
          "text": "Nazareos fueron blancos más que la nieve, más lustrosos que la leche.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "Su compostura más rubicunda que los rubíes, más bellos que el zafiro:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oscura más que la negrura es la forma de ellos; no los conocen por las calles:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "Su piel está pegada á sus huesos, seca como un palo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Más dichosos fueron los muertos á cuchillo que los muertos del hambre;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "Porque éstos murieron poco á poco por falta de los frutos de la tierra.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Las manos de las mujeres",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        },
        {
          "text": "piadosas cocieron á sus hijos;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:10"
      },
      "items": [
        {
          "text": "Fuéronles comida en el quebrantamiento de la hija de mi pueblo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cumplió Jehová su enojo, derramó el ardor de su ira;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.11",
            "verseOrgIds": [
              "LAM.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:11"
      },
      "items": [
        {
          "text": "Y encendió fuego en Sión, que consumió sus fundamentos.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.11",
            "verseOrgIds": [
              "LAM.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunca los reyes de la tierra, ni todos los que habitan en el mundo,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.12",
            "verseOrgIds": [
              "LAM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:12"
      },
      "items": [
        {
          "text": "Creyeron que el enemigo y el adversario entrara por las puertas de Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.12",
            "verseOrgIds": [
              "LAM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LAM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Es",
              "type": "text",
              "attrs": {
                "verseId": "LAM.4.13",
                "verseOrgIds": [
                  "LAM.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "por los pecados de sus profetas, por las maldades de sus sacerdotes,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.13",
            "verseOrgIds": [
              "LAM.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:13"
      },
      "items": [
        {
          "text": "Que derramaron en medio de ella la sangre de los justos.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.13",
            "verseOrgIds": [
              "LAM.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LAM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Titubearon como ciegos en las calles, fueron contaminados en sangre,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.14",
            "verseOrgIds": [
              "LAM.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:14"
      },
      "items": [
        {
          "text": "De modo que no pudiesen tocar á sus vestiduras.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.14",
            "verseOrgIds": [
              "LAM.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LAM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apartaos ¡inmundos!, les",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        },
        {
          "text": "gritaban, Apartaos, apartaos, no toquéis.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:15"
      },
      "items": [
        {
          "text": "Cuando huyeron y fueron dispersos, dijeron entre las gentes: Nunca más morarán",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "aquí",
              "type": "text",
              "attrs": {
                "verseId": "LAM.4.15",
                "verseOrgIds": [
                  "LAM.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.15",
            "verseOrgIds": [
              "LAM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LAM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "La ira de Jehová los apartó, no los mirará más:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.16",
            "verseOrgIds": [
              "LAM.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:16"
      },
      "items": [
        {
          "text": "No respetaron la faz de los sacerdotes, ni tuvieron compasión de los viejos.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.16",
            "verseOrgIds": [
              "LAM.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LAM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aun nos han desfallecido nuestros ojos",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.17",
            "verseOrgIds": [
              "LAM.4.17"
            ]
          }
        },
        {
          "text": "tras nuestro vano socorro:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.17",
            "verseOrgIds": [
              "LAM.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:17"
      },
      "items": [
        {
          "text": "En nuestra esperanza aguardamos",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.17",
            "verseOrgIds": [
              "LAM.4.17"
            ]
          }
        },
        {
          "text": "gente que no puede salvar.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.17",
            "verseOrgIds": [
              "LAM.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LAM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cazaron nuestro pasos,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.18",
            "verseOrgIds": [
              "LAM.4.18"
            ]
          }
        },
        {
          "text": "que no anduviésemos por nuestras calles:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.18",
            "verseOrgIds": [
              "LAM.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:18"
      },
      "items": [
        {
          "text": "Acercóse nuestro fin, cumpliéronse nuestros días; porque nuestro fin vino.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.18",
            "verseOrgIds": [
              "LAM.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LAM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligeros fueron nuestros perseguidores",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.19",
            "verseOrgIds": [
              "LAM.4.19"
            ]
          }
        },
        {
          "text": "más que las águilas del cielo:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.19",
            "verseOrgIds": [
              "LAM.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:19"
      },
      "items": [
        {
          "text": "Sobre los montes nos persiguieron, en el desierto nos pusieron emboscadas.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.19",
            "verseOrgIds": [
              "LAM.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LAM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "El resuello de nuestras narices, el ungido de Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.20",
            "verseOrgIds": [
              "LAM.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:20"
      },
      "items": [
        {
          "text": "De quien habíamos dicho: A su sombra tendremos vida entre las gentes:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.20",
            "verseOrgIds": [
              "LAM.4.20"
            ]
          }
        },
        {
          "text": "fué preso en sus hoyos.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.20",
            "verseOrgIds": [
              "LAM.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LAM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gózate y alégrate, hija de Edom, la que habitas en tierra de",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.21",
            "verseOrgIds": [
              "LAM.4.21"
            ]
          }
        },
        {
          "text": "Hus:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.21",
            "verseOrgIds": [
              "LAM.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:21"
      },
      "items": [
        {
          "text": "Aun hasta ti pasará el cáliz; embriagarte has, y vomitarás.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.21",
            "verseOrgIds": [
              "LAM.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 Oración del pueblo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 afligido á Dios.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LAM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cumplido es tu castigo, oh hija de Sión:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.22",
            "verseOrgIds": [
              "LAM.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:22"
      },
      "items": [
        {
          "text": "Nunca más te hará trasportar.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.22",
            "verseOrgIds": [
              "LAM.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:22"
      },
      "items": [
        {
          "text": "Visitará tu iniquidad, oh hija de Edom;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.22",
            "verseOrgIds": [
              "LAM.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 4:22"
      },
      "items": [
        {
          "text": "Descubrirá tus pecados.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.22",
            "verseOrgIds": [
              "LAM.4.22"
            ]
          }
        }
      ]
