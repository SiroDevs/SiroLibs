{
  "id": "LAM.5",
  "number": "5",
  "bookId": "LAM",
  "reference": "Lamentaciones 5",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "LAM 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LAM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ACUÉRDATE, oh Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        },
        {
          "text": "de lo que nos ha sucedido:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:1"
      },
      "items": [
        {
          "text": "Ve y mira nuestro oprobio.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LAM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuestra heredad se ha",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        },
        {
          "text": "vuelto á extraños,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:2"
      },
      "items": [
        {
          "text": "Nuestras casas á forasteros.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LAM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huérfanos somos sin padre,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:3"
      },
      "items": [
        {
          "text": "Nuestras madres como viudas.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuestra agua bebemos por dinero;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:4"
      },
      "items": [
        {
          "text": "Nuestra leña por precio compramos.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Persecución padecemos sobre nuestra cerviz:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:5"
      },
      "items": [
        {
          "text": "Nos cansamos, y no hay para nosotros reposo.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LAM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Al Egipcio y al Asirio dimos la mano, para saciarnos de pan.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.6",
            "verseOrgIds": [
              "LAM.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LAM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuestros padres pecaron, y son muertos;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:7"
      },
      "items": [
        {
          "text": "Y nosotros llevamos sus castigos.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.7",
            "verseOrgIds": [
              "LAM.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LAM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siervos se enseñorearon",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        },
        {
          "text": "de nosotros;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:8"
      },
      "items": [
        {
          "text": "No hubo quien de su mano nos librase.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Con peligro de nuestras vidas traíamos nuestro pan",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:9"
      },
      "items": [
        {
          "text": "Delante del cuchillo del desierto.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuestra piel",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        },
        {
          "text": "se ennegreció como un horno",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:10"
      },
      "items": [
        {
          "text": "A causa del ardor del hambre.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LAM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Violaron á las mujeres",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        },
        {
          "text": "en Sión,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:11"
      },
      "items": [
        {
          "text": "A las vírgenes en las ciudades de Judá.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.11",
            "verseOrgIds": [
              "LAM.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LAM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "A los príncipes colgaron por su mano;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.12",
            "verseOrgIds": [
              "LAM.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:12"
      },
      "items": [
        {
          "text": "No respetaron el rostro de los viejos.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.12",
            "verseOrgIds": [
              "LAM.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LAM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Llevaron los mozos",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.13",
            "verseOrgIds": [
              "LAM.5.13"
            ]
          }
        },
        {
          "text": "a moler,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.13",
            "verseOrgIds": [
              "LAM.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:13"
      },
      "items": [
        {
          "text": "Y los muchachos desfallecieron en la leña.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.13",
            "verseOrgIds": [
              "LAM.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LAM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Los ancianos cesaron de la puerta,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.14",
            "verseOrgIds": [
              "LAM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:14"
      },
      "items": [
        {
          "text": "Los mancebos de sus canciones.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.14",
            "verseOrgIds": [
              "LAM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LAM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cesó el gozo de nuestro corazón;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.15",
            "verseOrgIds": [
              "LAM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:15"
      },
      "items": [
        {
          "text": "Nuestro corro se tornó en luto.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.15",
            "verseOrgIds": [
              "LAM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LAM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cayó la corona de nuestra cabeza:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.16",
            "verseOrgIds": [
              "LAM.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:16"
      },
      "items": [
        {
          "text": "¡Ay ahora de nosotros! porque pecamos.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.16",
            "verseOrgIds": [
              "LAM.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LAM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por esto fué entristecido nuestro corazón,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.17",
            "verseOrgIds": [
              "LAM.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:17"
      },
      "items": [
        {
          "text": "Por esto se entenebrecieron nuestros ojos:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.17",
            "verseOrgIds": [
              "LAM.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LAM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Por el monte de Sión que está asolado;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.18",
            "verseOrgIds": [
              "LAM.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
        "vid": "LAM 5:18"
      },
      "items": [
        {
          "text": "Zorras andan en él.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.18",
            "verseOrgIds": [
              "LAM.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LAM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas tú, Jehová,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.19",
            "verseOrgIds": [
              "LAM.5.19"
            ]
          }
        },
        {
          "text": "permanecerás para siempre:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.19",
            "verseOrgIds": [
              "LAM.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q",
