              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y pasado el luto, envió David y recogióla á su casa:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.27",
            "verseOrgIds": [
              "2SA.11.27"
            ]
          }
        },
        {
          "text": "y fué ella su mujer, y parióle un hijo. Mas esto que David había hecho, fué desagradable á los ojos de Jehová.",
          "type": "text",
          "attrs": {
