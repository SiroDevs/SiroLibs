            "sid": "JER 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque la muerte ha subido por nuestras ventanas, ha entrado en nuestros palacios; para talar",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        },
        {
          "text": "los niños",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        },
        {
          "text": "de las calles, los mancebos de las plazas.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
