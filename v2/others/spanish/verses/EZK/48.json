                  "EZK.48.21"
                ]
              }
            }
          ]
        },
        {
          "text": "de la suerte hasta el término oriental, y al occidente delante de las veinticinco mil hasta el término occidental, delante de las partes",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "dichas",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.21",
                "verseOrgIds": [
                  "EZK.48.21"
                ]
              }
            }
          ]
        },
        {
          "text": "será del príncipe: y suerte santa será; y el santuario de la casa estará en medio de ella.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
