                "verseOrgIds": [
                  "EZK.48.21"
                ]
              }
            }
          ]
        },
        {
          "text": "delante de las veinticinco mil",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
