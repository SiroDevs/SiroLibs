          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Este día vendrá á ti",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
            "verseOrgIds": [
              "EZK.24.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "un",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.26",
                "verseOrgIds": [
                  "EZK.24.26"
                ]
              }
            }
          ]
        },
        {
          "text": "escapado para traer las nuevas.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
            "verseOrgIds": [
              "EZK.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
