            "verseId": "EZK.24.27",
            "verseOrgIds": [
              "EZK.24.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "para hablar",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.27",
                "verseOrgIds": [
                  "EZK.24.27"
                ]
              }
            }
          ]
        },
        {
          "text": "con el escapado, y hablarás, y no estarás más mudo; y les serás por señal, y sabrán que yo soy Jehová.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.27",
            "verseOrgIds": [
              "EZK.24.27"
            ]
          }
        }
