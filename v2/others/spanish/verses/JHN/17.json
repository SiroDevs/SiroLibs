{
  "id": "JHN.17",
  "number": "17",
  "bookId": "JHN",
  "reference": "San Juan 17",
  "copyright": "Reina-Valera 1909 - Dominio público. Fue realizada por Sociedades Bíblicas Unidas y publicada por primera vez en 1909.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JHN 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "ESTAS cosas habló Jesús, y",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        },
        {
          "text": "levantados los ojos al cielo, dijo: Padre, la hora es llegada;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        },
        {
          "text": "glorifica á tu Hijo, para que también tu Hijo te glorifique á ti;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "text": "le has dado la potestad de toda carne, para que dé vida eterna á",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "text": "todos los que le diste.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esta empero es la vida eterna: que te conozcan el solo",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        },
        {
          "text": "Dios verdadero, y á Jesucristo,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        },
        {
          "text": "al cual has enviado.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
        {
          "text": "te he glorificado en la tierra:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
        {
          "text": "he acabado la obra que me diste que hiciese.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahora pues, Padre,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        },
        {
          "text": "glorifícame tú cerca de ti mismo con aquella gloria",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        },
        {
          "text": "que tuve cerca de ti",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        },
        {
          "text": "antes que el mundo fuese.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "He manifestado tu nombre á los hombres",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "text": "que del mundo me diste: tuyos eran, y me los diste, y",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "text": "guardaron tu palabra.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahora",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "text": "han conocido que todas las cosas que me diste, son de ti;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porque las palabras que me diste, les he dado; y ellos",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "las",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.8",
                "verseOrgIds": [
                  "JHN.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "recibieron, y han conocido verdaderamente que salí de ti, y han creído que tú me enviaste.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo ruego por ellos:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "text": "no ruego por el mundo, sino por los que me diste;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "text": "porque tuyos son:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y todas mis cosas son tus cosas, y tus cosas son mis cosas: y he sido glorificado en ellas.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y ya no estoy en el mundo; mas éstos están en el mundo, y yo á ti vengo. Padre santo, á los que me has dado, guárdalos por tu nombre,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "text": "para que sean una cosa,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "text": "como también nosotros.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuando estaba con ellos en el mundo, yo los guardaba en tu nombre; á los que me diste, yo los guardé, y",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        },
        {
          "text": "ninguno de ellos se perdió, sino",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        },
        {
          "text": "el hijo de perdición;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        },
        {
          "text": "para que la Escritura se cumpliese.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas ahora vengo á ti; y hablo esto en el mundo, para que tengan",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
        {
          "text": "mi gozo cumplido en sí mismos.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo les he dado tu palabra;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        },
        {
          "text": "y el mundo los aborreció, porque no son del mundo, como tampoco yo soy del mundo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ruego que los quites del mundo, sino que los guardes",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        },
        {
          "text": "del mal.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "No son del mundo, como tampoco yo soy del mundo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.16",
            "verseOrgIds": [
              "JHN.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Santifícalos",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        },
        {
          "text": "en tu verdad:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        },
        {
          "text": "tu palabra es verdad.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Como tú",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.18",
            "verseOrgIds": [
              "JHN.17.18"
            ]
          }
        },
        {
          "text": "me enviaste al mundo, también los he enviado al mundo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.18",
            "verseOrgIds": [
              "JHN.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "1 \"Que todos sean una cosa.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "2 Prendimiento de Jesús.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y por ellos yo",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.19",
            "verseOrgIds": [
              "JHN.17.19"
            ]
          }
        },
        {
          "text": "me santifico á mí mismo, para que también ellos sean santificados en verdad.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.19",
            "verseOrgIds": [
              "JHN.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mas no ruego solamente por éstos, sino también por los que han de creer en mí por la palabra de ellos.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.20",
            "verseOrgIds": [
              "JHN.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Para que todos sean",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.21",
            "verseOrgIds": [
              "JHN.17.21"
            ]
          }
        },
        {
          "text": "una cosa; como tú, oh Padre, en mí, y yo en ti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.21",
            "verseOrgIds": [
              "JHN.17.21"
            ]
          }
        },
        {
          "text": "que también ellos sean en nosotros una cosa: para que el mundo crea que tú me enviaste.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.21",
            "verseOrgIds": [
              "JHN.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y yo,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.22",
            "verseOrgIds": [
              "JHN.17.22"
            ]
          }
        },
        {
          "text": "la gloria que me diste",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.22",
            "verseOrgIds": [
              "JHN.17.22"
            ]
          }
        },
        {
          "text": "les he dado; para que sean una cosa, como también nosotros somos una cosa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.22",
            "verseOrgIds": [
              "JHN.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo en ellos, y tú en mí,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.23",
            "verseOrgIds": [
              "JHN.17.23"
            ]
          }
        },
        {
          "text": "para que sean consumadamente una cosa;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.23",
            "verseOrgIds": [
              "JHN.17.23"
            ]
          }
        },
        {
          "text": "que el mundo conozca que tú me enviaste, y que los has amado, como también á mí me has amado.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.23",
            "verseOrgIds": [
              "JHN.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Padre,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.24",
            "verseOrgIds": [
              "JHN.17.24"
            ]
          }
        },
        {
          "text": "aquellos que me has dado, quiero que donde yo estoy, ellos estén también conmigo;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.24",
            "verseOrgIds": [
              "JHN.17.24"
            ]
          }
        },
        {
          "text": "para que vean mi gloria que me has dado: por cuanto me has amado",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.24",
            "verseOrgIds": [
              "JHN.17.24"
            ]
          }
        },
        {
          "text": "desde antes de la constitución del mundo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.24",
            "verseOrgIds": [
              "JHN.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Padre justo, el mundo no te ha conocido, mas yo te he conocido; y éstos han conocido que tú me enviaste;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.25",
            "verseOrgIds": [
              "JHN.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y yo les he manifestado",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.26",
            "verseOrgIds": [
              "JHN.17.26"
            ]
          }
        },
        {
          "text": "tu nombre, y manifestaré",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.26",
            "verseOrgIds": [
              "JHN.17.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "lo aún;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.26",
                "verseOrgIds": [
                  "JHN.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": "para que el amor",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.26",
            "verseOrgIds": [
              "JHN.17.26"
            ]
          }
        },
        {
          "text": "con que me has amado, esté en ellos, y yo en ellos.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.26",
            "verseOrgIds": [
              "JHN.17.26"
            ]
          }
        }
      ]
