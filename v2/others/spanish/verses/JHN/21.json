          ]
        },
        {
          "text": "Dícele Jesús: Si quiero que él quede",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        },
        {
          "text": "hasta que yo venga, ¿qué á tí? Sígueme tú.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        }
      ]
