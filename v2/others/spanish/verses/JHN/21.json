                "verseId": "JHN.21.20",
                "verseOrgIds": [
                  "JHN.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "había dicho: Señor, ¿quién es el que te ha de entregar?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.20",
            "verseOrgIds": [
              "JHN.21.20"
            ]
