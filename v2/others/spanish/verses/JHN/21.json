          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Así que Pedro vió á éste, dice á Jesús: Señor, ¿y éste, qué?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
          }
        }
      ]
