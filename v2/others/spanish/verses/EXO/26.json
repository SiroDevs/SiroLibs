              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y cubrirás las tablas de oro, y harás sus anillos de oro",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        },
        {
          "text": "para meter por ellos las barras: también cubrirás las barras de oro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        }
