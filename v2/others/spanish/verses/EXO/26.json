          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y pondrás el velo debajo de los corchetes, y meterás allí, del velo adentro,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "text": "el arca del testimonio; y aquel velo os hara separación entre el lugar santo y el santísimo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
