              "attrs": {
                "verseId": "EXO.39.30",
                "verseOrgIds": [
                  "EXO.39.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        }
      ]
    },
    {
