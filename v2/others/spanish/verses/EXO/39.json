              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y fué acabada toda la obra del tabernáculo, del tabernáculo del testimonio:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "text": "e hicieron los hijos de Israel como Jehová lo había mandado á Moisés: así lo hicieron.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        }
      ]
    },
