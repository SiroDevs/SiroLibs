          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "La mesa, todos sus vasos, y el pan de la proposición;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
            "verseOrgIds": [
              "EXO.39.36"
            ]
          }
        }
      ]
    },
    {
