          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "HEB.1.1",
                "verseOrgIds": [
                  "HEB.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ayant autrefois",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "text": ", à plusieurs reprises et en plusieurs manières, parlé aux pères par",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "text": "les prophètes,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.1",
            "verseOrgIds": [
              "HEB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "à la fin de ces jours-là, nous a parlé dans [le] Fils",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "text": ", qu'il a établi héritier de toutes choses, par lequel aussi il a fait les mondes,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.2",
            "verseOrgIds": [
              "HEB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "qui, étant le resplendissement de sa gloire et l'empreinte de sa substance, et soutenant toutes choses par la parole de sa",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "text": "puissance, ayant fait par lui-même la purification des péchés, s'est assis à la droite de la majesté dans les hauts [lieux] ;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.3",
            "verseOrgIds": [
              "HEB.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "étant devenu d'autant plus excellent que les anges, qu'il a hérité d'un nom plus excellent qu'eux.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car auquel des anges a-t-il jamais dit : « Tu es mon Fils, moi je t'ai aujourd'hui engendré »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        },
        {
          "text": "? Et encore : « Moi, je lui serai pour père, et lui me sera pour fils »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.5",
            "verseOrgIds": [
              "HEB.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et encore, quand il introduit",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        },
        {
          "text": "le Premier-né dans le monde habité, il dit : « Et que tous les anges de",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "HEB.1.6",
                "verseOrgIds": [
                  "HEB.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "lui rendent hommage »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.6",
            "verseOrgIds": [
              "HEB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et quant aux anges, il dit : « Qui fait ses anges des esprits, et ses ministres",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        },
        {
          "text": "une flamme de feu »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais quant au Fils : « Ton trône, ô",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "HEB.1.8",
                "verseOrgIds": [
                  "HEB.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", [est] aux siècles des siècles",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        },
        {
          "text": "; c'est un sceptre de droiture que le sceptre de ton règne ;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.8",
            "verseOrgIds": [
              "HEB.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "tu as aimé la justice et haï l'iniquité",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        },
        {
          "text": "; c'est pourquoi",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "HEB.1.9",
                "verseOrgIds": [
                  "HEB.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "HEB.1.9",
                "verseOrgIds": [
                  "HEB.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", t'a oint d'une huile de joie au-dessus de tes compagnons »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.9",
            "verseOrgIds": [
              "HEB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et : « Toi, dans les commencements, ✶Seigneur, tu as fondé la terre, et les cieux sont les œuvres de tes mains :",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.10",
            "verseOrgIds": [
              "HEB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "eux, ils périront, mais toi, tu demeures ; et ils vieilliront tous comme un habit,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.11",
            "verseOrgIds": [
              "HEB.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "et tu les plieras comme un vêtement, et ils seront changés ; mais toi, tu es le même",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        },
        {
          "text": ", et tes ans ne cesseront point »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.12",
            "verseOrgIds": [
              "HEB.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et auquel des anges a-t-il jamais dit : « Assieds-toi à ma droite, jusqu'à ce que j'aie mis tes ennemis pour marchepied de tes pieds »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.13",
            "verseOrgIds": [
              "HEB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne sont-ils pas tous des esprits administrateurs, envoyés pour servir en faveur de ceux qui vont hériter du salut ?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.14",
            "verseOrgIds": [
              "HEB.1.14"
            ]
          }
        }
      ]
    }
  ],
