              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jésus leur répondit : Vous croyez maintenant ?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici, l'heure vient, et elle est venue, que vous serez dispersés chacun chez soi, et que vous me laisserez seul ; – et je ne suis pas seul, car le Père est avec moi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.32",
            "verseOrgIds": [
              "JHN.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je vous ai dit ces choses, afin qu'en moi vous ayez la paix. Vous avez de la tribulation dans le monde ; mais ayez bon courage, moi j'ai vaincu le monde.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.33",
            "verseOrgIds": [
              "JHN.16.33"
            ]
          }
        }
