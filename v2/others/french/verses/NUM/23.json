                "verseId": "NUM.23.21",
                "verseOrgIds": [
                  "NUM.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", est avec lui, et un chant de triomphe royal est au milieu de lui.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        }
      ]
