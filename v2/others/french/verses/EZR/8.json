  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "EZR 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "*Et voici les chefs des pères et la généalogie de ceux qui montèrent avec moi de Babylone, sous le règne du roi Artaxerxès :",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "des fils de Phinées, Guershom ; des fils d'Ithamar, Daniel ; des fils de David, Hattush ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "des fils de Shecania, des fils de Parhosh, Zacharie, et avec lui, enregistrés par généalogies, les mâles, 150 ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "des fils de Pakhath-Moab, Élioénaï, fils de Zerakhia, et avec lui 200 hommes",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.4",
            "verseOrgIds": [
              "EZR.8.4"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.4",
            "verseOrgIds": [
              "EZR.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "des fils de Shecania, le fils de Jakhaziel, et avec lui 300 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.5",
            "verseOrgIds": [
              "EZR.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des fils d'Adin, Ébed, fils de Jonathan, et avec lui 50 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.6",
            "verseOrgIds": [
              "EZR.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des fils d'Élam, Ésaïe, fils d'Athalia, et avec lui 70 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.7",
            "verseOrgIds": [
              "EZR.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des fils de Shephatia, Zebadia, fils de Micaël, et avec lui 80 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.8",
            "verseOrgIds": [
              "EZR.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "[et] des fils de Joab, Abdias, fils de Jekhiel, et avec lui 218 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des fils de Shelomith, le fils de Josiphia, et avec lui 160 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.10",
            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des fils de Bébaï, Zacharie, fils de Bébaï, et avec lui 28 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des fils d'Azgad, Jokhanan, fils d'Hakkatan, et avec lui 110 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des fils d'Adonikam, les derniers, et ce sont ici leurs noms : Éliphéleth, Jehiel, et Shemahia, et avec eux 60 hommes ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des fils de Bigvaï, Uthaï et Zabbud, et avec eux 70 hommes.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et je les rassemblai vers le fleuve qui s'en va vers Ahava, et nous avons campé là trois jours ; et je considérai le peuple et les sacrificateurs, et je n'y trouvai aucun des fils de Lévi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alors j'envoyai chercher Éliézer, Ariel, Shemahia, et Elnathan, et Jarib, et Elnathan, et Nathan, et Zacharie, et Meshullam, qui étaient des chefs, et Joïarib, et Elnathan, hommes intelligents ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "et je les envoyai à Iddo, qui était chef dans la localité [appelée] Casiphia, et je mis dans leurs bouches des paroles pour les dire à Iddo [et] à ses frères",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "text": ", les Nethiniens, dans la localité [appelée] Casiphia, pour nous amener des serviteurs pour la maison de notre",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.17",
                "verseOrgIds": [
                  "EZR.8.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils nous amenèrent, selon que la bonne main de notre",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.18",
                "verseOrgIds": [
                  "EZR.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "était sur nous, un homme intelligent d'entre les fils de Makhli, fils de Lévi, fils d'Israël, et Shérébia et ses fils et ses frères, [au nombre de] 18 ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "et Hashabia, et avec lui Ésaïe, d'entre les fils de Merari, ses frères et leurs fils, [au nombre de] 20 ;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "et des Nethiniens, que David et les princes avaient donnés pour le service des lévites, 220 Nethiniens, tous désignés par [leurs] noms.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et là, près du fleuve Ahava, je publiai un jeûne, pour nous humilier devant notre",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.21",
                "verseOrgIds": [
                  "EZR.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", pour lui demander le vrai",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "text": "chemin, pour nous et pour nos enfants, et pour tout notre avoir.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car j'avais honte de demander au roi des forces et de la cavalerie pour nous aider en chemin contre l'ennemi ; car nous avions parlé au roi, en disant : La main de notre",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.22",
                "verseOrgIds": [
                  "EZR.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": "est en bien sur tous ceux qui le cherchent ; et sa force et sa colère sont contre tous ceux qui l'abandonnent.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et nous avons jeûné, et nous avons demandé cela à notre",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.23",
                "verseOrgIds": [
                  "EZR.8.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", et il nous exauça.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et je séparai douze des chefs des sacrificateurs, Shérébia, Hashabia, et dix de leurs frères avec eux,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "et je leur pesai l'argent et l'or, et les ustensiles, l'offrande",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "text": "pour la maison de notre",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "EZR.8.25",
                "verseOrgIds": [
                  "EZR.8.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", qu'avaient offerte le roi, et ses conseillers, et ses princes, et tout Israël qui se trouvait là.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et je pesai en leurs mains 650 talents d'argent, et en ustensiles d'argent 100 talents, [et] en or 100 talents,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "et 20 coupes",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "text": "d'or valant 1 000 dariques, et deux vases d'airain d'un beau brillant, précieux",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "text": "comme l'or.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
