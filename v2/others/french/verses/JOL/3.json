          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il arrivera que, quiconque invoquera le nom de l'",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JOL.3.5",
                "verseOrgIds": [
                  "JOL.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sera sauvé. Car sur la montagne de Sion il y aura délivrance, et à Jérusalem, comme l'",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JOL.3.5",
                "verseOrgIds": [
                  "JOL.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "l'a dit, et pour les réchappés que l'",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
