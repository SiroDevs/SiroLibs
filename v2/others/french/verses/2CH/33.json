                "verseId": "2CH.33.16",
                "verseOrgIds": [
                  "2CH.33.16"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
