          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
          "text": "que l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
