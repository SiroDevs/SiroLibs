          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les fils d'Israël marchèrent à sec au milieu de la mer, et les eaux étaient pour eux un mur à leur droite et à leur gauche.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
            "verseOrgIds": [
              "EXO.14.29"
            ]
          }
        },
