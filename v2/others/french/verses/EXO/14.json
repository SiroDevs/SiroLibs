                "verseOrgIds": [
                  "EXO.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "avait déployée",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
          "text": "contre les Égyptiens ; et le peuple craignit l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
