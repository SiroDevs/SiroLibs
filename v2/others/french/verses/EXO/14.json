          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse étendit sa main sur la mer : et, vers le matin, la mer reprit sa force ; et les Égyptiens s'enfuirent à sa rencontre ; et l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.27",
                "verseOrgIds": [
                  "EXO.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "précipita les Égyptiens au milieu de la mer.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
