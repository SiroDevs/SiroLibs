                "verseOrgIds": [
                  "EXO.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "dit à Moïse : Étends ta main sur la mer, et les eaux retourneront sur les Égyptiens, sur leurs chars et sur leurs cavaliers.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
