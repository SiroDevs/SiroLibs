              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
