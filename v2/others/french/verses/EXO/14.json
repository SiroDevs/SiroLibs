                "verseId": "EXO.14.31",
                "verseOrgIds": [
                  "EXO.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", et ils crurent à l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
