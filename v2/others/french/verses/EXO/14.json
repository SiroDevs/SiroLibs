          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.30",
                "verseOrgIds": [
                  "EXO.14.30"
                ]
              }
            }
          ]
        },
        {
          "text": "délivra en ce jour-là Israël de la main des Égyptiens, et Israël vit les Égyptiens morts sur le rivage de la mer.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
