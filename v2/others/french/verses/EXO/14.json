                "verseOrgIds": [
                  "EXO.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "combat pour eux contre les Égyptiens.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        }
