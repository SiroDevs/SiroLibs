{
  "id": "PSA.106",
  "number": "106",
  "bookId": "PSA",
  "reference": "Psaumes 106",
  "copyright": "Texte libre de droits",
  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "106",
        "style": "c",
        "sid": "PSA 106"
      },
      "items": [
        {
          "text": "106",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 106:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Louez Jah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.1",
            "verseOrgIds": [
              "PSA.106.1"
            ]
          }
        },
        {
          "text": "Célébrez l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.1",
            "verseOrgIds": [
              "PSA.106.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.1",
                "verseOrgIds": [
                  "PSA.106.1"
                ]
              }
            }
          ]
        },
        {
          "text": "! Car il est bon ; car sa bonté demeure à",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.1",
            "verseOrgIds": [
              "PSA.106.1"
            ]
          }
        },
        {
          "text": "toujours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.1",
            "verseOrgIds": [
              "PSA.106.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 106:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui dira les actes puissants de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.2",
            "verseOrgIds": [
              "PSA.106.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.2",
                "verseOrgIds": [
                  "PSA.106.2"
                ]
              }
            }
          ]
        },
        {
          "text": "? Qui fera entendre toute sa louange ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.2",
            "verseOrgIds": [
              "PSA.106.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 106:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienheureux ceux qui gardent le juste jugement, qui pratiquent la justice en tout temps !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.3",
            "verseOrgIds": [
              "PSA.106.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 106:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Souviens-toi de moi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.4",
            "verseOrgIds": [
              "PSA.106.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.4",
                "verseOrgIds": [
                  "PSA.106.4"
                ]
              }
            }
          ]
        },
        {
          "text": "! selon [ta] faveur envers ton peuple ; visite-moi par ton salut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.4",
            "verseOrgIds": [
              "PSA.106.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 106:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afin que je voie le bien de tes élus, que je me réjouisse de la joie de ta nation, [et] que je me glorifie avec ton héritage.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.5",
            "verseOrgIds": [
              "PSA.106.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 106:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nous avons péché avec nos pères ; nous avons commis l'iniquité, nous avons agi méchamment.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.6",
            "verseOrgIds": [
              "PSA.106.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 106:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nos pères, en Égypte, n'ont pas été attentifs à tes merveilles ; ils ne se sont pas souvenus de la multitude de tes bontés ; mais ils ont été rebelles, près de la mer, à la mer Rouge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.7",
            "verseOrgIds": [
              "PSA.106.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 106:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cependant il les sauva à cause de son nom, afin de donner à connaître sa puissance.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.8",
            "verseOrgIds": [
              "PSA.106.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 106:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il tança la mer Rouge, et elle sécha ; et il les fit marcher par les abîmes comme par un désert.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.9",
            "verseOrgIds": [
              "PSA.106.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 106:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il les sauva de la main de celui qui les haïssait, et les racheta de la main de l'ennemi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.10",
            "verseOrgIds": [
              "PSA.106.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 106:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les eaux couvrirent leurs oppresseurs : il n'en resta pas un seul.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.11",
            "verseOrgIds": [
              "PSA.106.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 106:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alors ils crurent à ses paroles, ils chantèrent sa louange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.12",
            "verseOrgIds": [
              "PSA.106.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 106:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils oublièrent vite ses œuvres, ils ne s'attendirent point à son conseil",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.13",
            "verseOrgIds": [
              "PSA.106.13"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.13",
            "verseOrgIds": [
              "PSA.106.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 106:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils furent remplis de convoitise dans le désert, et ils tentèrent",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.14",
            "verseOrgIds": [
              "PSA.106.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.14",
                "verseOrgIds": [
                  "PSA.106.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dans le lieu désolé ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.14",
            "verseOrgIds": [
              "PSA.106.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 106:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il leur donna ce qu'ils avaient demandé, mais il envoya la consomption dans leurs âmes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.15",
            "verseOrgIds": [
              "PSA.106.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 106:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils furent jaloux de Moïse dans le camp, [et] d'Aaron, le saint de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.16",
            "verseOrgIds": [
              "PSA.106.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.16",
                "verseOrgIds": [
                  "PSA.106.16"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.16",
            "verseOrgIds": [
              "PSA.106.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 106:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "La terre s'ouvrit, et engloutit Dathan, et couvrit l'assemblée d'Abiram ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.17",
            "verseOrgIds": [
              "PSA.106.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 106:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et un feu s'alluma dans leur assemblée, une flamme consuma les méchants.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.18",
            "verseOrgIds": [
              "PSA.106.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 106:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils firent un veau en Horeb, et se prosternèrent devant une image de fonte ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.19",
            "verseOrgIds": [
              "PSA.106.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 106:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils changèrent leur gloire en la figure d'un bœuf qui mange l'herbe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.20",
            "verseOrgIds": [
              "PSA.106.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 106:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils oublièrent",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.21",
            "verseOrgIds": [
              "PSA.106.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.21",
                "verseOrgIds": [
                  "PSA.106.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", leur sauveur, qui avait fait de grandes choses en Égypte,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.21",
            "verseOrgIds": [
              "PSA.106.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 106:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Des choses merveilleuses dans le pays de Cham, des choses terribles près de la mer Rouge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.22",
            "verseOrgIds": [
              "PSA.106.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 106:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il dit qu'il les aurait détruits, – si Moïse, son élu, ne s'était pas tenu à la brèche devant lui, pour détourner sa fureur de sorte qu'il ne les détruise pas.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.23",
            "verseOrgIds": [
              "PSA.106.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 106:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils méprisèrent le pays désirable ; ils ne crurent point à sa parole ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.24",
            "verseOrgIds": [
              "PSA.106.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 106:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils murmurèrent dans leurs tentes, ils n'écoutèrent pas la voix de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.25",
            "verseOrgIds": [
              "PSA.106.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.25",
                "verseOrgIds": [
                  "PSA.106.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.25",
            "verseOrgIds": [
              "PSA.106.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 106:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il jura",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.26",
            "verseOrgIds": [
              "PSA.106.26"
            ]
          }
        },
        {
          "text": "à leur sujet qu'il les ferait tomber dans le désert,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.26",
            "verseOrgIds": [
              "PSA.106.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 106:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et qu'il ferait tomber leur semence parmi les nations, et les disperserait par les pays.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.27",
            "verseOrgIds": [
              "PSA.106.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 106:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils s'attachèrent à Baal-Péor",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.28",
            "verseOrgIds": [
              "PSA.106.28"
            ]
          }
        },
        {
          "text": ", et mangèrent des sacrifices des morts ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.28",
            "verseOrgIds": [
              "PSA.106.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 106:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils provoquèrent [",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.29",
            "verseOrgIds": [
              "PSA.106.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.29",
                "verseOrgIds": [
                  "PSA.106.29"
                ]
              }
            }
          ]
        },
        {
          "text": "] par leurs œuvres, et une peste éclata parmi eux.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.29",
            "verseOrgIds": [
              "PSA.106.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 106:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alors Phinées se leva, et exécuta le jugement, et la peste fut arrêtée ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.30",
            "verseOrgIds": [
              "PSA.106.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 106:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et cela lui a été compté à justice, de génération en génération, pour toujours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.31",
            "verseOrgIds": [
              "PSA.106.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PSA 106:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils l'irritèrent aux eaux de Meriba, et il en arriva du mal à Moïse à cause d'eux ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.32",
            "verseOrgIds": [
              "PSA.106.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PSA 106:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car ils chagrinèrent son esprit, de sorte qu'il parla légèrement de ses lèvres.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.33",
            "verseOrgIds": [
              "PSA.106.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PSA 106:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils ne détruisirent point les peuples, comme l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.34",
            "verseOrgIds": [
              "PSA.106.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.34",
                "verseOrgIds": [
                  "PSA.106.34"
                ]
              }
            }
          ]
        },
        {
          "text": "leur avait dit ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.34",
            "verseOrgIds": [
              "PSA.106.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PSA 106:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais ils se mêlèrent parmi les nations, et ils apprirent leurs œuvres ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.35",
            "verseOrgIds": [
              "PSA.106.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "PSA 106:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils servirent leurs idoles, et elles leur furent en piège ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.36",
            "verseOrgIds": [
              "PSA.106.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "PSA 106:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils sacrifièrent leurs fils et leurs filles aux démons,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.37",
            "verseOrgIds": [
              "PSA.106.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "PSA 106:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et versèrent le sang innocent, le sang de leurs fils et de leurs filles, qu'ils sacrifièrent aux idoles de Canaan ; et le pays fut profané par le sang.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.38",
            "verseOrgIds": [
              "PSA.106.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "PSA 106:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils se rendirent impurs par leurs œuvres, et se prostituèrent par leurs pratiques.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.39",
            "verseOrgIds": [
              "PSA.106.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "PSA 106:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et la colère de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.40",
            "verseOrgIds": [
              "PSA.106.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.40",
                "verseOrgIds": [
                  "PSA.106.40"
                ]
              }
            }
          ]
        },
        {
          "text": "s'embrasa contre son peuple, et il abhorra son héritage ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.40",
            "verseOrgIds": [
              "PSA.106.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "PSA 106:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il les livra en la main des nations ; et ceux qui les haïssaient dominèrent sur eux ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.41",
            "verseOrgIds": [
              "PSA.106.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "PSA 106:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et leurs ennemis les opprimèrent, et ils furent humiliés sous leur main.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.42",
            "verseOrgIds": [
              "PSA.106.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "PSA 106:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maintes fois il les délivra ; mais ils le chagrinèrent par leur conseil, et ils déchurent par leur iniquité.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.43",
            "verseOrgIds": [
              "PSA.106.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "PSA 106:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il les regarda dans leur détresse, quand il entendit leur cri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.44",
            "verseOrgIds": [
              "PSA.106.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "PSA 106:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il se souvint en leur faveur de son alliance, et se repentit selon la multitude de ses bontés ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.45",
            "verseOrgIds": [
              "PSA.106.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "PSA 106:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il leur fit trouver compassion auprès de tous ceux qui les avaient emmenés captifs.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.46",
            "verseOrgIds": [
              "PSA.106.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "PSA 106:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauve-nous,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.47",
            "verseOrgIds": [
              "PSA.106.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.47",
                "verseOrgIds": [
                  "PSA.106.47"
                ]
              }
            }
          ]
        },
        {
          "text": ", notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.47",
            "verseOrgIds": [
              "PSA.106.47"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.47",
                "verseOrgIds": [
                  "PSA.106.47"
                ]
              }
            }
          ]
        },
        {
          "text": "! et rassemble-nous d'entre les nations, afin que nous célébrions ton saint nom, et que nous nous glorifiions de ta louange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.47",
            "verseOrgIds": [
              "PSA.106.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "PSA 106:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Béni soit l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.48",
            "verseOrgIds": [
              "PSA.106.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.48",
                "verseOrgIds": [
                  "PSA.106.48"
                ]
              }
            }
          ]
        },
        {
          "text": ", le",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.48",
            "verseOrgIds": [
              "PSA.106.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.106.48",
                "verseOrgIds": [
                  "PSA.106.48"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël, de l'éternité jusqu'en éternité ! et que tout le peuple dise : Amen ! Louez Jah !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.106.48",
            "verseOrgIds": [
              "PSA.106.48"
            ]
          }
        }
      ]
    }
  ],
