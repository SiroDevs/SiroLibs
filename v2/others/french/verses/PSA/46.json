                "verseId": "PSA.46.12",
                "verseOrgIds": [
                  "PSA.46.12"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées est avec nous ; le",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.12",
            "verseOrgIds": [
              "PSA.46.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.12",
                "verseOrgIds": [
                  "PSA.46.12"
                ]
              }
            }
          ]
        },
        {
          "text": "de Jacob nous est une haute retraite. Sélah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.12",
            "verseOrgIds": [
              "PSA.46.12"
            ]
          }
        }
      ]
    }
