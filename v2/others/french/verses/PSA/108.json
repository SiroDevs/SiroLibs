{
  "id": "PSA.108",
  "number": "108",
  "bookId": "PSA",
  "reference": "Psaumes 108",
  "copyright": "Texte libre de droits",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "108",
        "style": "c",
        "sid": "PSA 108"
      },
      "items": [
        {
          "text": "108",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 108:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantique. Psaume de David.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.1",
            "verseOrgIds": [
              "PSA.108.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 108:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon cœur est affermi, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.2",
                "verseOrgIds": [
                  "PSA.108.2"
                ]
              }
            }
          ]
        },
        {
          "text": "! je chanterai, et je psalmodierai,… mon âme",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        },
        {
          "text": "aussi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.2",
            "verseOrgIds": [
              "PSA.108.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 108:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Éveillez-vous, luth et harpe ! Je m'éveillerai à l'aube du jour.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.3",
            "verseOrgIds": [
              "PSA.108.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 108:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je te célébrerai parmi les peuples, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.4",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.4",
                "verseOrgIds": [
                  "PSA.108.4"
                ]
              }
            }
          ]
        },
        {
          "text": "! et je chanterai tes louanges parmi les peuplades ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.4",
            "verseOrgIds": [
              "PSA.108.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 108:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car ta bonté est grande par-dessus les cieux, et ta vérité [atteint] jusqu'aux nues.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.5",
            "verseOrgIds": [
              "PSA.108.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 108:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Élève-toi, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.6",
            "verseOrgIds": [
              "PSA.108.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.6",
                "verseOrgIds": [
                  "PSA.108.6"
                ]
              }
            }
          ]
        },
        {
          "text": "! au-dessus des cieux, et que ta gloire soit au-dessus de toute la terre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.6",
            "verseOrgIds": [
              "PSA.108.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 108:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afin que tes bien-aimés soient délivrés, sauve par ta droite, et réponds-moi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.7"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.7",
            "verseOrgIds": [
              "PSA.108.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 108:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.8",
                "verseOrgIds": [
                  "PSA.108.8"
                ]
              }
            }
          ]
        },
        {
          "text": "a parlé dans sa sainteté : je me réjouirai ; je partagerai Sichem et je mesurerai la vallée de Succoth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.8",
            "verseOrgIds": [
              "PSA.108.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 108:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galaad est à moi, Manassé est à moi, et Éphraïm est la force",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        },
        {
          "text": "de ma tête ; Juda est mon législateur ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.9",
            "verseOrgIds": [
              "PSA.108.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 108:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moab est le bassin où je me lave ; sur Édom j'ai jeté ma sandale ; sur la Philistie je pousserai des cris de triomphe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.10",
            "verseOrgIds": [
              "PSA.108.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 108:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui me conduira dans la ville forte ? Qui me mènera jusqu'en Édom ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.11",
            "verseOrgIds": [
              "PSA.108.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 108:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne sera-ce pas toi, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.12",
                "verseOrgIds": [
                  "PSA.108.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", qui nous as rejetés, et qui n'es pas sorti, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.12",
                "verseOrgIds": [
                  "PSA.108.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", avec nos armées ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.12",
            "verseOrgIds": [
              "PSA.108.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 108:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donne-nous du secours pour sortir de détresse ; car la délivrance qui vient de l'homme est vaine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.13",
            "verseOrgIds": [
              "PSA.108.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 108:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Par",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.14",
            "verseOrgIds": [
              "PSA.108.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.108.14",
                "verseOrgIds": [
                  "PSA.108.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nous ferons des actes de valeur, et c'est lui qui foulera nos adversaires.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.108.14",
            "verseOrgIds": [
              "PSA.108.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.109",
    "number": "109",
    "bookId": "PSA"
  },
