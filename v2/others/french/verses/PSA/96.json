              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chantez à l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.1",
            "verseOrgIds": [
              "PSA.96.1"
            ]
          }
        },
        {
