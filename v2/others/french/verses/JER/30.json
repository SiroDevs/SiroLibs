          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici, une tempête de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.23",
            "verseOrgIds": [
              "JER.30.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.30.23",
                "verseOrgIds": [
                  "JER.30.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", la fureur, est sortie ; une tempête continue",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.23",
            "verseOrgIds": [
              "JER.30.23"
            ]
          }
        },
        {
          "text": "fondra sur la tête des méchants.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.23",
            "verseOrgIds": [
              "JER.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'ardeur de la colère de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.24",
            "verseOrgIds": [
              "JER.30.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.30.24",
                "verseOrgIds": [
                  "JER.30.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ne retournera pas, jusqu'à ce qu'il ait exécuté et accompli les pensées de son cœur. À la fin des jours vous le comprendrez.",
          "type": "text",
          "attrs": {
