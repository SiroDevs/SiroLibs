                "verseOrgIds": [
                  "JER.29.21"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées, le",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.21",
                "verseOrgIds": [
                  "JER.29.21"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël, touchant Achab, fils de Kolaïa, et touchant Sédécias, fils de Maascéïa, qui vous prophétisent le mensonge en mon nom : Voici, je les livre en la main de Nebucadretsar, roi de Babylone, et il les frappera devant vos yeux ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
