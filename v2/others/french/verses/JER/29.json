                "verseId": "JER.29.26",
                "verseOrgIds": [
                  "JER.29.26"
                ]
              }
            }
          ]
        },
        {
          "text": "t'a établi sacrificateur à la place de Jehoïada, le sacrificateur, pour qu'il y ait des intendants dans la maison de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.26",
                "verseOrgIds": [
                  "JER.29.26"
                ]
              }
            }
          ]
        },
        {
          "text": "pour tout homme qui fait l'inspiré",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "text": "et qui prophétise, afin que tu le mettes au bloc et au carcan ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
