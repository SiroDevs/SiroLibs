                "verseOrgIds": [
                  "JER.29.25"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées, le",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
