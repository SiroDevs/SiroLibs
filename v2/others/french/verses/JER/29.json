          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.25",
                "verseOrgIds": [
                  "JER.29.25"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël, disant : Parce que tu as envoyé en ton nom des lettres à tout le peuple qui est à Jérusalem, et à Sophonie, fils de Maascéïa, le sacrificateur, et à tous les sacrificateurs, disant :",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
