          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et en ce jour-là Josué les établit coupeurs de bois et puiseurs d'eau pour l'assemblée et pour l'autel de l'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        },
