                "verseOrgIds": [
                  "JOS.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", avait commandé à Moïse, son serviteur, de vous donner tout le pays et d'exterminer tous les habitants du pays devant vous ; et nous avons beaucoup craint pour nos vies à cause de vous, et nous avons fait cela.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
