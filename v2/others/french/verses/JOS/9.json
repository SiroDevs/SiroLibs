          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et maintenant nous voici en ta main ; fais comme il est bon et droit à tes yeux de nous faire.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
              "JOS.9.25"
            ]
          }
        },
