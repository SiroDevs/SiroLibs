            "sid": "JOS 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il leur fit ainsi, et les sauva de la main des fils d'Israël ; et ils ne les tuèrent pas.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
