              "type": "text",
              "attrs": {
                "verseId": "LEV.22.33",
                "verseOrgIds": [
                  "LEV.22.33"
                ]
              }
            }
          ]
        },
        {
          "text": ". Moi, je suis l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
