          "text": "à Silo ; et l'enfant",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "text": "était très jeune.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
