            "style": "v",
            "sid": "1SA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et elle dit : Ah, mon seigneur ! ton âme est vivante, mon seigneur, je suis la femme qui se tenait ici près de toi pour prier l'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
