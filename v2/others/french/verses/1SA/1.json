              "attrs": {
                "verseId": "1SA.1.22",
                "verseOrgIds": [
                  "1SA.1.22"
                ]
              }
            }
          ]
        },
        {
          "text": "et qu'il habite là pour toujours.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        },
