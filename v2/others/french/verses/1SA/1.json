                "verseOrgIds": [
                  "1SA.1.23"
                ]
              }
            }
          ]
        },
        {
          "text": "accomplisse sa parole ! Et la femme demeura, et elle allaita son fils jusqu'à ce qu'elle l'ait sevré.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
