          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'ai prié pour cet enfant, et l'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
