          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils égorgèrent le taureau, et ils amenèrent le jeune garçon à Éli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.25",
            "verseOrgIds": [
