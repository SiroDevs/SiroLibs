                "verseId": "1SA.1.21",
                "verseOrgIds": [
                  "1SA.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "le sacrifice annuel et son vœu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.21",
            "verseOrgIds": [
              "1SA.1.21"
            ]
          }
