                "verseOrgIds": [
                  "1SA.1.27"
                ]
              }
            }
          ]
        },
        {
          "text": "m'a accordé la demande que je lui ai faite.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
