          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les meurtrissures [et] les plaies nettoient le mal, et les coups, les profondeurs de l'âme",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.30",
            "verseOrgIds": [
              "PRO.20.30"
            ]
          }
        },
        {
