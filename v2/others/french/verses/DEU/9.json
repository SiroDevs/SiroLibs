                "verseOrgIds": [
                  "DEU.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "depuis le jour où je vous ai connus.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
