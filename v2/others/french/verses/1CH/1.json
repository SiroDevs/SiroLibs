{
  "id": "1CH.1",
  "number": "1",
  "bookId": "1CH",
  "reference": "1 Chroniques 1",
  "copyright": "Texte libre de droits",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1CH 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adam, Seth, Énosh,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.1",
            "verseOrgIds": [
              "1CH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kénan, Mahalaleël, Jéred,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.2",
            "verseOrgIds": [
              "1CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hénoc, Methushélah, Lémec,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.3",
            "verseOrgIds": [
              "1CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noé ; Sem, Cham, et Japheth.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.4",
            "verseOrgIds": [
              "1CH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils de Japheth : Gomer, et Magog, et Madaï, et Javan, et Tubal, et Méshec, et Tiras.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.5",
            "verseOrgIds": [
              "1CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et les fils de Gomer : Ashkenaz, et Diphath, et Togarma.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.6",
            "verseOrgIds": [
              "1CH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et les fils de Javan : Élisha, et Tarsis, Kittim, et Rodanim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.7",
            "verseOrgIds": [
              "1CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils de Cham : Cush, et Mitsraïm, Puth, et Canaan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.8",
            "verseOrgIds": [
              "1CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et les fils de Cush : Seba, et Havila, et Sabta, et Rahma, et Sabteca. – Et les fils de Rahma : Sheba et Dedan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.9",
            "verseOrgIds": [
              "1CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Cush engendra Nimrod : lui, commença à être puissant sur la terre.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.10",
            "verseOrgIds": [
              "1CH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Mitsraïm engendra les Ludim, et les Anamim, et les Lehabim, et les Naphtukhim,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.11",
            "verseOrgIds": [
              "1CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "et les Pathrusim, et les Caslukhim (d'où sont sortis les Philistins), et les Caphtorim.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.12",
            "verseOrgIds": [
              "1CH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Canaan engendra Sidon, son premier-né, et Heth,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.13",
            "verseOrgIds": [
              "1CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "et le Jébusien, et l'Amoréen, et le Guirgasien,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.14",
            "verseOrgIds": [
              "1CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "et le Hévien, et l'Arkien, et le Sinien,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.15",
            "verseOrgIds": [
              "1CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "et l'Arvadien, et le Tsemarien, et le Hamathien.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.16",
            "verseOrgIds": [
              "1CH.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils de Sem : Élam, et Assur, et Arpacshad, et Lud, et Aram, et Uts, et Hul, et Guéther, et Méshec.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.17",
            "verseOrgIds": [
              "1CH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Arpacshad engendra Shélakh, et Shélakh engendra Héber.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.18",
            "verseOrgIds": [
              "1CH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il naquit à Héber deux fils : le nom de l'un fut Péleg",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.19",
            "verseOrgIds": [
              "1CH.1.19"
            ]
          }
        },
        {
          "text": ", car en ses jours la terre fut partagée ; et le nom de son frère fut Joktan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.19",
            "verseOrgIds": [
              "1CH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Joktan engendra Almodad, et Shéleph, et Hatsarmaveth, et Jérakh,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.20",
            "verseOrgIds": [
              "1CH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "et Hadoram, et Uzal, et Dikla,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.21",
            "verseOrgIds": [
              "1CH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "et Ébal, et Abimaël, et Sheba,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.22",
            "verseOrgIds": [
              "1CH.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "et Ophir, et Havila, et Jobab : tous ceux-là sont fils de Joktan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.23",
            "verseOrgIds": [
              "1CH.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sem, Arpacshad, Shélakh,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.24",
            "verseOrgIds": [
              "1CH.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Héber, Péleg, Rehu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.25",
            "verseOrgIds": [
              "1CH.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Serug, Nakhor, Térakh,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.26",
            "verseOrgIds": [
              "1CH.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abram, qui est Abraham.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.27",
            "verseOrgIds": [
              "1CH.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils d'Abraham : Isaac et Ismaël.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.28",
            "verseOrgIds": [
              "1CH.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Ce sont ici leurs générations : le premier-né d'Ismaël, Nebaïoth ; et Kédar, et Adbeël, et Mibsam ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.29",
            "verseOrgIds": [
              "1CH.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishma, et Duma ; Massa, Hadad, et Théma ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.30",
            "verseOrgIds": [
              "1CH.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jetur, Naphish, et Kedma : ce sont là les fils d'Ismaël.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.31",
            "verseOrgIds": [
              "1CH.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et les fils de Ketura, concubine d'Abraham : elle enfanta Zimran, et Jokshan, et Medan, et Madian, et Jishbak, et Shuakh. Et les fils de Jokshan : Sheba et Dedan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.32",
            "verseOrgIds": [
              "1CH.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les fils de Madian : Épha, et Épher, et Hénoc, et Abida, et Eldaa. Tous ceux-là étaient fils de Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.33",
            "verseOrgIds": [
              "1CH.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Abraham engendra Isaac. Les fils d'Isaac : Ésaü et Israël.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.34",
            "verseOrgIds": [
              "1CH.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Les fils d'Ésaü : Éliphaz, Rehuel, et Jehush, et Jahlam, et Coré.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.35",
            "verseOrgIds": [
              "1CH.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Les fils d'Éliphaz : Théman, et Omar, Tsephi, et Gahtam ; Kenaz, et Thimna, et Amalek.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.36",
            "verseOrgIds": [
              "1CH.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Les fils de Rehuel : Nakhath, Zérakh, Shamma, et Mizza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.37",
            "verseOrgIds": [
              "1CH.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les fils de Séhir : Lotan, et Shobal, et Tsibhon, et Ana, et Dishon, et Étser, et Dishan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.38",
            "verseOrgIds": [
              "1CH.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et les fils de Lotan : Hori et Homam ; et la sœur de Lotan : Thimna.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.39",
            "verseOrgIds": [
              "1CH.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Les fils de Shobal : Alian, et Manakhath, et Ébal, Shephi, et Onam. – Et les fils de Tsibhon : Aïa et Ana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.40",
            "verseOrgIds": [
              "1CH.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Les fils d'Ana : Dishon. – Et les fils de Dishon : Hamran, et Eshban, et Jithran, et Keran.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.41",
            "verseOrgIds": [
              "1CH.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Les fils d'Étser : Bilhan, et Zaavan, [et] Jaakan. – Les fils de Dishan : Uts et Aran.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.42",
            "verseOrgIds": [
              "1CH.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ce sont ici les rois qui régnèrent dans le pays d'Édom, avant qu'un roi règne sur les fils d'Israël : Béla, fils de Béor ; et le nom de sa ville était Dinhaba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.43",
            "verseOrgIds": [
              "1CH.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Béla mourut ; et Jobab, fils de Zérakh, de Botsra, régna à sa place.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.44",
            "verseOrgIds": [
              "1CH.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Jobab mourut ; et Husham, du pays des Thémanites, régna à sa place.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.45",
            "verseOrgIds": [
              "1CH.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Husham mourut ; et à sa place régna Hadad, fils de Bedad, qui frappa Madian dans les champs de Moab ; et le nom de sa ville était Avith.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.46",
            "verseOrgIds": [
              "1CH.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Hadad mourut ; et Samla, de Masréka, régna à sa place.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.47",
            "verseOrgIds": [
              "1CH.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Samla mourut ; et Saül, de Rehoboth sur le fleuve, régna à sa place.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.48",
            "verseOrgIds": [
              "1CH.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Saül mourut ; et Baal-Hanan, fils d'Acbor, régna à sa place.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.49",
            "verseOrgIds": [
              "1CH.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Baal-Hanan mourut ; et Hadad régna à sa place ; et le nom de sa ville était Pahi ; et le nom de sa femme, Mehétabeël, fille de Matred, fille de Mézahab.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.50",
            "verseOrgIds": [
              "1CH.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Hadad mourut.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.51",
            "verseOrgIds": [
              "1CH.1.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 1:51"
      },
      "items": [
        {
          "text": "Et il y eut des chefs",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.51",
            "verseOrgIds": [
              "1CH.1.51"
            ]
          }
        },
        {
          "text": "d'Édom : le chef Thimna, le chef Alia, le chef Jetheth,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.51",
            "verseOrgIds": [
              "1CH.1.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CH 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "le chef Oholibama, le chef Éla, le chef Pinon,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.52",
            "verseOrgIds": [
              "1CH.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CH 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "le chef Kenaz, le chef Théman, le chef Mibtsar,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.53",
            "verseOrgIds": [
              "1CH.1.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 1:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "le chef Magdiel, le chef Iram. Ce sont là les chefs d'Édom.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.54",
            "verseOrgIds": [
              "1CH.1.54"
            ]
          }
        }
      ]
    }
  ],
