                "verseOrgIds": [
                  "1KI.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", et que la parole de l'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.24",
            "verseOrgIds": [
              "1KI.17.24"
            ]
          }
        },
