                "verseOrgIds": [
                  "1KI.17.21"
                ]
              }
            }
          ]
        },
        {
          "text": "! fais revenir, je te prie, l'âme de cet enfant au-dedans de lui.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.21",
            "verseOrgIds": [
              "1KI.17.21"
