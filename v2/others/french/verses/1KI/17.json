                "verseId": "1KI.17.21",
                "verseOrgIds": [
                  "1KI.17.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", et dit :",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.21",
            "verseOrgIds": [
              "1KI.17.21"
            ]
          }
        },
