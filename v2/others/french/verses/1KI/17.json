                "verseOrgIds": [
                  "1KI.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "! as-tu aussi fait venir du mal sur la veuve chez laquelle je séjourne, en faisant mourir son fils ?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.20",
            "verseOrgIds": [
              "1KI.17.20"
            ]
          }
        },
