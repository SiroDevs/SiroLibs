                "verseOrgIds": [
                  "1KI.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "écouta la voix d'Élie, et fit revenir l'âme de l'enfant au-dedans de lui, et il vécut.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.22",
