          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ce Daniel prospéra pendant le règne de Darius et pendant le règne de Cyrus, le Perse.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.29",
            "verseOrgIds": [
