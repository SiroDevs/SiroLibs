          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Samla mourut ; et Saül, de Rehoboth sur le fleuve, régna à sa place.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.37",
            "verseOrgIds": [
              "GEN.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
