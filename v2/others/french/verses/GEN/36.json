          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et Baal-Hanan, fils d'Acbor, mourut ; et Hadar",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        },
        {
          "text": "régna à sa place ; et le nom de sa ville était Pahu ; et le nom de sa femme, Mehétabeël, fille de Matred, fille de Mézahab.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        }
      ]
