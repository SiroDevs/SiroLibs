                "verseId": "GEN.2.16",
                "verseOrgIds": [
                  "GEN.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "commanda à l'homme, disant : Tu mangeras librement de tout arbre du jardin ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.16",
            "verseOrgIds": [
              "GEN.2.16"
            ]
          }
        },
