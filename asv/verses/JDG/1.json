          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "but the Asherites dwelt among the Canaanites, the inhabitants of the land; for they did not drive them out.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
