        },
        {
          "text": "In the third year of Asa king of Judah began Baasha the son of Ahijah to reign over all Israel in Tirzah, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
