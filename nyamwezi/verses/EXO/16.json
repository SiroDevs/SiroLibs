            "number": "31",
            "style": "v",
            "sid": "EXO 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho V'aizilaeli v'aki'paga lina ki'liwa cheni'cho “Mana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:31",
              "type": "text"
            },
            {
              "text": "Muhayo “Mana” ku' Ki'ebulania gwikolile na muhayo “ki' cheni'chi'?”",
              "type": "text"
            }
          ]
        },
        {
          "text": ".” Nacho ki'liwa cheni'cho chav'age kikolile ki'ti' mbiyu' zya wu'si'ga wape, na wu'semu wacho ki'ti' mugate mulelemazu u'go gu'v'eziv'ilwe ku' wu'ki'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Mose wav'awi'laga ati', “U'gu' hu' mulagi' gwamwa Gu'ku' Mulungu: ‘Musole muteko gu'mo gwa mana na ku'yi'tu'u'la, ku'nguno ya wu'v'yalwa winywe u'wo wu'lalonde, ki'gele v'ize v'awone ki'liwa i'cho ndi' namupa mulye ku' ibalangu', aho ndi' mufumizye ku' nsi' ya Misili.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
