          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene Mose wamuwi'laga Aloni ati', “U'sole muteko gwa mana, u'gu'ti'ti'le mugati' na ki'seme. Hangi' u'ki'tu'u'le ha mbele yamwa Gu'ku' Mulungu, ki'gele ki'su'ngwe ku'nguno ya v'av'yalwa v'inywe av'o v'alalonde.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
