              "EXO.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Mose wahafumaga hamwa Falao, wayaga ha ibala na kaya. Hohene wawu'syaga makono gakwe ku'mulomba Gu'ku' Mulungu. Ngilimo na nvula ya mawe zyadugaga, na nvula yalekaga ku'tonya mu nsi'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi Falao aho wawonaga ku'v'a nvula, ngilimo na nvula ya mawe zyadugaga, wasu'v'i'laga hangi' wu'kenagu'zi wakwe. Mweni'ki'li' na v'akumba v'akwe v'av'aga na myoyo milambu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene moyo gwamwa Falao gwendeleyaga ku'v'a mulambu. Wakaanaga ku'v'aleku'li'la V'aizilaeli v'aye, ki'ti' i'vyo Gu'ku' Mulungu wayombile ku'v'i'ti'la mulomo gwamwa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
