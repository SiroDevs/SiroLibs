          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katani na shayili vyose vyav'ipaga, ku'nguno shayili yasangwa yi'li' na ngala na katani yav'age yi'li' na malawu', ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ali'vi ngano na mimelo zingi' zya mpese zikav'ipile ku'nguno ndi' zikaali' ku'komeela.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
