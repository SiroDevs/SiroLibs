        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yi'li'ku'dima u'v'aku'zye so na nnoko, ki'gele u'v'e na wikalo wu'lihu mu nsi' i'yo ali'ku'pa Gu'ku' Mulungu, Mulungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.12",
            "verseOrgIds": [
              "EXO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
