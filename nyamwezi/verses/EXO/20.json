          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ku'du' u'wu'lage.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.13",
            "verseOrgIds": [
              "EXO.20.13"
            ]
