          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugati' nazyo lu'gito lu'mo lwav'i'taga hagati' na felemu ku'fuma ku' mpelo yi'mo mpaka ku' mpelo yi'ngi'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
