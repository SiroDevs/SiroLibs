              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "V'av'ezyaga ngito zya muti' gwa mugu'nga: ngito itano ku'nguno ya felemu zya lwandi' lu'mo lwa ihema, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
