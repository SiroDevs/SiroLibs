          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngito itano ku'nguno ya lwandi' lwa wu'v'i'li', na ngito itano ku'nguno ya felemu zya lwandi' lwa ku' mupi'ndo gwa ihema, u'lo lu'li' ku' mweli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
