          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "V'av'ezyaga felemu mukaga ku'nguno ya lwandi' lwa ku' mupi'ndo gwa ihema, u'go gu'li' ku' mweli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.27",
            "verseOrgIds": [
              "EXO.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' v'av'ezyaga felemu zingi' iv'i'li' ku'nguno ya vituzi vya ihema ku' lwandi' lwalyo lwa ku' mupi'ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.28",
            "verseOrgIds": [
              "EXO.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku' vituzi vyeni'vyo viv'i'li' felemu zyeni'zyo ndi' ziki'ndi'kilwe yi'mo yi'mo ku' ki'la ki'tuzi kwandi'zya ha nsi' mpaka ku' igu'lya, na ki'la felemu ndi' yi'dimilwe na pete ku' ki'tuzi ku' igu'lya. Felemu zyeni'zyo iv'i'li' ziv'eziv'ilwe vyene vivyo ku' vituzi viv'i'li'. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.29",
            "verseOrgIds": [
              "EXO.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku'nguno yeni'yo kwav'ageho felemu munane ku' mupi'ndo gwa ihema, na vikali'lo iku'mi na mukaga zya mawe ga feza. Ki'la felemu yav'age na vikali'lo viv'i'li'.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.30",
            "verseOrgIds": [
              "EXO.36.30"
            ]
          }
        }
      ]
