          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Felemu zyose v'azikumbi'laga zahabu na ku'ziv'ezezya pete zya zahabu zya ku'dimi'li'la ngito zyeni'zyo. Hangi' na ngito v'azikumbi'laga zahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
