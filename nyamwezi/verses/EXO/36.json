              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' v'av'ezyaga muki'ngo gwa mugati' ku' wu'zi wa langi ya bululu, zambalawo na yazaa, na katani nsoga i'yo yi'pelegilwe. Muki'ngo gwenu'go gu'fuumilwe ku' wu'tonto na kolwa masu'mbano ga v'akelubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
