              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pete zya kamufuko kenako zilatungani'ziwe na pete zya ki'zibao ku' lu'goye lwa langi ya bululu, ki'gele kaleke ku'soka na kikali'le mukwato gwa wu'lembwe gwa mu muki'mbi'li'.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itungo i'lo Aloni alav'e ali'wingi'la Hantu' Hasondo, alazwalage kamufuko ka ha ki'kuv'a ku'nguno ya ku'v'ezezya wu'yangu' ako kali' na mina ga v'ana v'amwa Izilaeli, ku'v'a mwizu' ku' matungo gose ha mbele yanne ene Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' mu kamufuko kenako u'latu'u'le Ulimu na Sumimu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:30",
              "type": "text"
            },
            {
              "text": "Mihayo Ulimu na Sumimu yi'li'wigelisya ku'v'a gav'age mawe masondo ago muhozya wagatu'u'lage mu kamufuko. Ku' itungo li'mo v'ahozya v'agatu'mi'lage ku'manya wu'yangu' wamwa Mulungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " viv'e ha igu'lya na ki'kuv'a gwamwa Aloni. Nsiku' zyose aho Aloni alav'e ali'wingi'la ha mbele yamwa Gu'ku' Mulungu, vintu' vyeni'vyo alavisombe ha igu'lya na ki'kuv'a gwakwe. I'vi hu' vyene alakowole ku'fumya wu'yangu' ku' V'aizilaeli ha mbele yanne.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hangi' u'lasume ijoho lya ku'zwali'la ki'zibao ku' ki'tambala cha langi ya bululu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.31",
            "verseOrgIds": [
              "EXO.28.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hagati' u'ladu'le idu'lu'lu' lya ku'v'i'ti'zya mutwe. Ha lwandi' lwa nhingo u'lahapilimye ki'tambala i'cho ki'fuumilwe ki'gele ku'du' li'tandu'ke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku' wu'pi'nde walyo wa ha nsi'li'li' ku'pilima lwandi' lose yi'lalembwe ku' masu'mbano ga makomamanga ga langi ya bululu, zambalawo na yazaa. Hagati' na ki'la ikomamanga ku'v'e na muyi'mba gwa zahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zyeni'zyo miyi'mba zya zahabu na makomamanga zilihele ku'li'pilima ipi'ndo lya ijoho lyeni'lo: ikomamanga, muyi'mba, ikomamanga, muyi'mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloni alazwale ijoho lyeni'lo aho alav'e ali'tu'mama muli'mo gwa wu'hozya, na muzwi gwa zyeni'zyo miyi'mba mulagwigwe aho ali'wingi'la Hantu' Hasondo ha mbele yanne na aho ali'fuma, ki'gele aleke ku'fwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 28:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hangi' u'lav'ezye ndezi ya zahabu nsoso, na ku'yi'tona ha igu'lya yayo, ki'ti' i'vyo gu'li'tonagwa muhuli, ‘MUSONDO KU'MWA GU'KU' MULUNGU.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndezi yeni'yo u'layi'tunge ha igu'lya na isimangi'la ku' lwandi' lwa ku' mbele ku' lu'goye lwa langi ya bululu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloni alayi'zwalage ndezi yeni'yo ha wu'syu' wakwe ku' matungo gose aho alav'e ali'v'ezya muli'mo gwa wu'hozya, na alasombage musango gwa V'aizilaeli u'go v'akowolile ku'v'a v'ahu'v'ile ku' ku'nfumi'zya vitaambo visondo, nanne ndavizumyage vitaambo vyav'o. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "U'lamufuumi'le Aloni nhanzo ku' katani nsoga, na u'muv'ezezye isimangi'la ku' katani nsoga na mukwato gwa wu'pu'ndwe gwa mu muki'mbi'li'.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'lav'asumi'le v'ana v'amwa Aloni nhanzo, mikwato zya mu muki'mbi'li' na nkofila, ki'gele v'apandi'ke lu'kumo na wu'soga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aho u'lav'e wav'azwi'ka Aloni, muku'lu'yo, haki'mo na v'ana v'akwe vizwalo vyeni'vyo, u'lav'av'ile maguta na ku'v'asondohya na ku'v'asimi'ka, ki'gele v'antu'mami'le muli'mo gwa wu'hozya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyene vivyo u'lav'asumi'le vizwalo vya mugati' vya katani, i'vyo vilav'akumbi'le ki'la yu'mo ku'fuma mu muki'mbi'li' mpaka mu matango, ki'gele v'iku'v'i'le miv'i'li' zyav'o. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloni na v'ana v'akwe yi'lav'adime ku'vizwala ki'la aho v'alav'e v'ali'wingi'la mu Ihema lya Ku'sangi'zya, ninga aho v'alav'e v'ali'lyegela ihozezyo lya vitaambo itungo lya muli'mo gwa wu'hozya ha lu'gu'tu' lwa Ihema Isondo, ki'gele v'ize v'aleke ku'pu'v'ya v'afwe. Yeni'yi' yi'v'e nhama ya nhananhana ku'mwa Aloni na wu'v'yalwa wakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
