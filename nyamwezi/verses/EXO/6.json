        },
        {
          "text": "wamuwi'laga, “Ene hu' ni' Gu'ku' Mulungu. Muwi'le Falao, mutemi wa Misili, mihayo zyose i'zyo nu'ku'wi'la.” ",
          "type": "text",
          "attrs": {
