    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mose na Aloni v'ali'zumya ku'dima mulagi' gwamwa Gu'ku' Mulungu",
          "type": "text"
        }
      ]
    },
    {
