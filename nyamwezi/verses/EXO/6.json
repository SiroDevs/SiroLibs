              "type": "text"
            }
          ]
        },
        {
          "text": "Aloni na Mose, hu' av'o ndi' v'awi'lwa na Gu'ku' Mulungu, “Muv'afumye v'antu' v'a Izilaeli mu nsi' ya Misili, ku' madale gav'o.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
