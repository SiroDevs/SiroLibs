              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazali, mwana wamwa Aloni, wamutoolaga yu'mo mugati' na v'aniki' v'ana v'amwa Putieli, nawe wamuv'yali'laga mwana, lina lyakwe Finehasi. V'enav'a hu' v'av'age v'ahanya v'a V'alawi na magongo gatemulilwe ku' mina gav'o.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
