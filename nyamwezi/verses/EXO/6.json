              "type": "text"
            }
          ]
        },
        {
          "text": "Yav'aga lu'siku' u'lo Gu'ku' Mulungu wav'age ali'yomba na Mose mu nsi' ya Misili, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
