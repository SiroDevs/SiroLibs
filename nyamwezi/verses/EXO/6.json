          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hu' v'ene v'av'o av'o ndi' v'ayombaga na Falao, mutemi wa Misili, ki'gele ku'v'afumya V'aizilaeli mu nsi' ya Misili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
            "verseOrgIds": [
