              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gu'ku' Mulungu wamuwi'laga Aloni ati', “Yaga ku' ibalangu' u'kamusu'ngane Mose.” Hohene Aloni wayaga na wapomaga na Mose ku' lu'gu'lu' lwa Mulungu, na wamusu'naga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Mose wamuwi'laga Aloni mihayo zyose zyamwa Gu'ku' Mulungu, haki'mo na lu'manyi'lo lwa migaka zyose i'zyo walagi'li'ziv'ilwe ku'ziv'ezya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Mose na Aloni v'ayaga, na v'av'akunganiaga v'anamala v'ose v'a V'aizilaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.29",
            "verseOrgIds": [
              "EXO.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Aloni wav'awi'laga mihayo zyose zyamwa Gu'ku' Mulungu i'zyo wamuwi'lile Mose. Hangi' wav'ezyaga lu'manyi'lo lwa migaka ha mbele ya v'antu' v'ose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene v'antu' v'asani'zyaga. Aho v'igagwa ku'v'a Gu'ku' Mulungu wav'izi'i'laga V'aizilaeli, na ku'v'a walu'wonaga lu'duko lwav'o, v'ose v'akundamyaga mitwe zyav'o na ku'ku'v'i'i'la.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        }
      ]
