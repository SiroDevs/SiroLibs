          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zyav'i'taga nsiku' mupungati' ku'fuma aho Gu'ku' Mulungu wagu'gu'maga mongo gwa Naili.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
