          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.12",
            "verseOrgIds": [
              "GEN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Gu'ku' Mulungu wamuwu'zyaga muki'ma mwenu'yo, “Wav'ezyaga vihe ev'e?” Muki'ma wasu'v'yaga, “Nzoka yene yanhu'mbyaga nanne nalyaga.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nfwizi' zyamwa Mulungu ku' v'akenagu'zi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        },
        {
          "name": "verse",
