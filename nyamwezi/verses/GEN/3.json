          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho wamugalu'ki'laga muki'ma na ku'muwi'la,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
