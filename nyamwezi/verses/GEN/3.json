          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi Gu'ku' Mulungu wayombaga, “Lingaga, mwenu'yu' muntu' wav'aga ki'ti' iswe, mu ku'manya tu'soga na tu'v'i. Yi'li'ku'dima ku'mugizya ku'du' ize ayav'e visumo vya muti' gwa wu'panga, ku'nguno u'lu' ize alye alav'e na wikalo wa nhananhana.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Gu'ku' Mulungu wav'asagaga ku'fuma mu mugu'nda gwa Edeni, ki'gele Adamu aye akayi'li'me nsi' i'yo watundi'lwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho wav'asagaga v'antu' v'enav'a, wav'atu'u'laga v'amalaika v'akelubi mu lwandi' lwa mu ki'ya ya mugu'nda gwa Edeni, na lu'panga lwa moto u'lo lu'li'galu'ka kosekose ku'yi'lindi'li'zya nzi'la ya ku'ya ku' muti' gwa wu'panga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        }
      ]
    }
