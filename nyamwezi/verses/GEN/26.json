          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau aho wafikyaga musimo gwa myaka maku'mi ane, watoolaga v'aki'ma v'av'i'li' V'ahiti: Yudisi, mwaniki' wamwa Beeli, na Basemati, mwaniki' wamwa Eloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "V'aki'ma v'enav'a hu' yav'aga nnandyo ya misayo ku'mwa Isaka na Lebeka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
            ]
          }
        }
