          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yav'aga mu lu'siku' lwa wu'v'i'li', mwaniki' muhanya wamuwi'laga muzunaye ati', “Lingaga, wu'ziku' u'wu' wav'i'taga ene nalalaga na v'av'a. Ku'mukozye hangi' malwa, nanho u'kalale nawe ki'gele ku'pandi'ke v'ana na wu'v'yalwa ku'fuma ku' wakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
