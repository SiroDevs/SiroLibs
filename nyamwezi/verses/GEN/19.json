          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "I'vi hu' vyene v'aniki' v'enav'o v'ana v'amwa Loto v'apandi'kaga mwitungo v'ose v'av'i'li' ku'fuma ku'mwa sav'o. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yav'aga u'yo mwaniki' muhanya wav'yalaga mwana wa ki'gosya nawe wamupaga lina Mowabu, na hu' mwene sav'o lya V'amowabu ninga walelo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaniki' mudo na mwene wav'yalaga mwana wa ki'gosya, na wamupaga lina Benami, na hu' mwene sav'o lya V'aamoni v'ose ninga walelo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
