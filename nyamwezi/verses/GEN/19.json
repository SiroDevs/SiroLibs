          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe malaika wamuwi'laga, “Endita! Nazumyaga ku'lomba kwako, na kaya yeni'yo i'yo wayi'temulaga nku'leka ku'yi'zimangu'zya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi yi'li'ku'dima u'peelele mwenu'mo wangu', ku'nguno nkakowola ku'v'ezya ki'ntu' u'lu' u'ku'v'a u'kaali' ku'fika mwenu'mo.” Hu' nguno ya kaya yeni'yo kwitanwa Soali",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:22",
              "type": "text"
            },
            {
              "text": "Muhayo “Soali” ku' Ki'ebulania nguno yago “hado”",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mulungu ali'zizimangu'zya kaya zya Sodoma na Gomola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
