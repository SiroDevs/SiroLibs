              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Yosefu wav'awi'laga v'adu'gu'ye ati', “Ene gi'si' ni' bi'hi' ku'fwa. Ali'vi nhana Mulungu alize ku'mugwasya ku' ku'mufumya mu nsi' yeni'yi', na alamufile ku' nsi' i'yo ndi' wav'alagana Abalahamu, Isaka na Yakobo ku' mulahi'.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.24",
            "verseOrgIds": [
              "GEN.50.24"
            ]
          }
        },
        {
          "name": "verse",
