        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene Yosefu wayi'v'ezyaga yi'v'e nhama ya mu nsi' ya Misili ninga walelo, ku'v'a ifungu li'mo mugati' na atano lya lyi'mbu'la yi'li' nsawo yamwa Falao. Migu'nda zya v'ahozya du' hu' zyene zikav'ile zyamwa Falao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo ali'fumya ilagi'li'zyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
