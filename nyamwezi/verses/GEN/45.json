          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene, v'adu'gu'ye v'awu'kaga ku' Misili na ku'su'v'a ku'mwa sav'o Yakobo, ku' nsi' ya Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.25",
            "verseOrgIds": [
              "GEN.45.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 45:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho v'afikaga ku'mwa sav'o, v'amuwi'laga ati', “Yosefu ali'ho ali'zuwu'ka! Hu' mwene mutemi wa nsi' yose ya Misili!” Sav'o aho wigagwa vyeni'vyo wagwaga nkekev'azi, ku'nguno akasani'zizye mihayo zyav'o. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali'vi aho v'amutentemuli'laga yose ki'ti' i'vyo Yosefu wav'awi'lile, na ku'wona mikokoteni i'zyo wamutu'mi'lile ki'gele zimusole na ku'mufila ku' Misili, haho moyo gwamwa Yakobo gwatogagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 45:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Izilaeli wayombaga ati', “Gi'si' nazumya! Mwana wanne Yosefu akaali' ali'zuwu'ka. Nku'ya nkamuwone aho nkaali' ku'fwa!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.28",
            "verseOrgIds": [
              "GEN.45.28"
            ]
          }
        }
