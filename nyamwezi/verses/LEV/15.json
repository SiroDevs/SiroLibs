              "LEV.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘U'lu' mugosya alale na muki'ma u'yo ali' ku' nsiku' zyakwe na magazi gamukuumye mugosya mwenu'yo, hohene mugosya mwenu'yo alav'e na zoma ku' itungo lya nsiku' mupungati'. Ki'la wu'li'li' u'wo alawikali'le mwenu'yo wu'lav'e na zoma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Muki'ma u'yo alav'e ali'fuma magazi gakwe ku' nsiku' nyingi ku'ki'la i'vyo yi'li'v'aga ku' wakwe, ninga ali'fuma magazi ku' itungo ilihu i'lo li'kav'ile lya nsiku' zyakwe, nsiku' zyeni'zyo zyose alav'e na zoma ki'ti' i'vyo ali'v'aga ha itungo lya ku' nsiku' zyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki'la wu'li'li' u'wo alav'e ali'lali'la ninga i'cho alav'e ali'wikali'la mu itungo lyeni'lo lya ku'fuma magazi ki'lav'e na zoma, ki'ti' i'vyo yi'li'v'aga ha itungo lya nsiku' zyakwe zya zoma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu' u'yo alavikuumye vintu' vyeni'vyo alav'e na zoma na yi'lamudime avikanze vizwalo vyakwe, na koga mu minzi', nawe alav'e na zoma mpaka mpi'ndi'.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
