              "LEV.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Yeni'yo hu' nhama ku'nguno ya mugosya wa ku'fuma wu'fila, na u'yo zili'mufume mbiyu' zyakwe na ku'muv'ezya av'e na zoma, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ku'nguno ya muki'ma u'yo alav'e ali' ku' nsiku' zyakwe. Yaani, av'e mugosya ninga muki'ma u'yo ali'fuma ki'ntu' i'cho ki'li'yela. Hangi' yi'li' ku' u'yo alalale na muki'ma u'yo ali' na zoma ya magazi gakwe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.33",
            "verseOrgIds": [
              "LEV.15.33"
            ]
          }
        }
