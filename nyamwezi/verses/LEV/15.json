          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘I'vi hu' vyene mulav'e muli'v'akoma V'aizilaeli ku'fuma ku' zoma yav'o, ki'gele ku'du' v'ali'v'ezezye zoma Ihema lyanne Isondo, i'lo li'li' hagati' nav'o, na ku'fwa ku' zoma yav'o.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
        }
      ]
