            "number": "28",
            "style": "v",
            "sid": "LEV 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ali'vi muki'ma mwenu'yo u'lu' magazi galeke ku'fuma, yi'lamudime av'azye nsiku' mupungati', haho alav'e wasosoka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lu'siku' lwa munane alasole mapu'u'la av'i'li' ninga makune av'i'li' ga nkunda, na ku'mufili'la muhozya bi'hi' na wingi'li'lo wa Ihema lya Ku'sangi'zya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe muhozya alali'fumye li'mo ku'nguno ya ki'taambo cha ku'sini'zya wu'kenagu'zi, na lya wu'v'i'li' ku'nguno ya ki'taambo cha ku'zigya. I'vi hu' vyene muhozya alamuv'ezezye wu'swanano ha mbele yamwa Gu'ku' Mulungu ku'nguno ya zoma ya ku'fuma magazi gakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        }
      ]
    },
