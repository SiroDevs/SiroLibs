        },
        {
          "text": "“ ‘Ku' lwandi' lwa v'antu' v'angi', u'lu' muntu' yu'mo mugati' nav'o ize av'ezye wu'kenagu'zi bila ku'loma na av'ezye ki'ntu' i'cho ki'giziv'ilwe na nhama yamwa Gu'ku' Mulungu, muntu' mwenu'yo alav'e na musango. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho alav'e wawi'lwa wu'kenagu'zi wakwe, yi'lamudime ku'leta mbu'li nki'ma i'yo yi'li' wu'du'hu' wu'lema ku'v'a ki'taambo chakwe ku'nguno ya wu'kenagu'zi u'wo wawu'v'ezizye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alatu'u'le mukono gwakwe ha igu'lya na mutwe gwa mbu'li yeni'yo ya ku'sini'zya wu'kenagu'zi na ku'yi'si'nzi'la aho ha ku'zigi'zya vitaambo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' muhozya alasole magazi ga ki'taambo cheni'cho, aladobye ku' lyala lyakwe na ku'v'ila ku' mapembe ga ihozezyo lya ku'zigi'zya vitaambo. Magazi ago galasigali'le alagite ha nsi'li'li' na ihozezyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maguta gose ga mbu'li yeni'yo galasiniwe ki'ti' i'vyo gali'siniv'agwa maguta ga vitaambo vya kwiswanania, nawe muhozya alagazigye ha ihozezyo, gav'e wu'motu wa ku'mutogezya Gu'ku' Mulungu. Ku' nzi'la yeni'yo muhozya alamuv'ezezye wu'swanano muntu' mwenu'yo, nawe alatondolwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
          }
        }
      ]
