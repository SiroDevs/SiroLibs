    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ku'sosohya ku'fuma ku'landi'ki'ziwa malwile ga ndi'li'",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Gu'ku' Mulungu wamuwi'laga Mose ati', ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“I'yi' hu' nhama ku'nguno ya muntu' wa wu'lwile wa ndi'li', mu lu'siku' lwa ku'sosohiwa kwakwe. Mmola yakwe yi'laletwe ku' muhozya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawe muhozya alafume ha ibala na nkambi' na ku'mwikomya. U'lu' muntu' mwenu'yo wapi'laga wu'lwile wakwe wa ndi'li', ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "haho muhozya alasemuzye viletwe vintu' i'vi ku'nguno ya muntu' u'yo alasosohiwe: Nnoni iv'i'li' nsoso i'zyo mpanga, ki'pande cha muti' gwa mwelezi, wu'zi wa langi yazaa haki'mo na itambi' lya hisopo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohene muhozya alasemuzye mugati' na nnoni zyeni'zyo v'asi'nze nnoni yi'mo ha igu'lya na nnungu' i'yo yi'li' na minzi' masoga ga kasela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' muhozya alayi'sole i'yo nnoni yi'ngi' mpanga, ki'pande cha muti' gwa mwelezi, wu'zi wa langi yazaa haki'mo na itambi' lya hisopo, na ku'vidobya mu magazi ga i'yo nnoni ya wu'si'nzwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe alamunyanyagi'le magazi kali' mupungati' mwenu'yo u'yo ali'sosohiwa, na alamutangazye ku'v'a ali' musoso. Hangi' alayi'leku'li'le i'yo nnoni mpanga ki'gele yiyagalu'le.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Haho mwenu'yo muntu' u'yo ali'sosohiwa yi'lamudime avikanze vizwalo vyakwe, asenye nyele zyakwe zyose na koga mu minzi', nawe alav'e wasosoka. Hohene alasu'v'e ha nkambi', ali'vi yi'lamudime kwikala ha ibala na ihema lyakwe ku' itungo lya nsiku' mupungati'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lu'siku' lwa mupungati' alamoge nyele zyakwe zyose, yaani amoge nyele zya ku' mutwe, ndezu, vikuti na nyele zingi' zyose. Hangi' yi'lamudime avikanze vizwalo vyakwe, na oge mu minzi', haho alav'e wasosoka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hangi' lu'siku' lwa munane alalete tu'di'lana twa ng'ondi tu'v'i'li' na kaki'ma kamo, tose tu'v'e na musimo gwa mwaka gu'mo, na tu'v'e tu'li' wu'du'hu' wu'lema, haki'mo na kilo idatu' zya wu'fuma wu'nelezu u'wo wu'seleganiv'ilwe na maguta ga muzeituni ku'v'a kalu'mbi'lo ka mbutoo, na selusi ya lita ya maguta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhozya u'yo alamutangazye ku'v'a ali' musoso, hu' mwene alamulete muntu' mwenu'yo haki'mo na kalu'mbi'lo kakwe kose ha mbele yamwa Gu'ku' Mulungu bi'hi' na wingi'li'lo wa Ihema lya Ku'sangi'zya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hangi' muhozya alakasole kadi'lana ka ng'ondi kamo mugati' na tu'di'lana twenu'to, na ku'kafumya ki'taambo cha ku'sini'zya musango, haki'mo na maguta genago. Hangi' alaviwu'sye ha mbele yamwa Gu'ku' Mulungu ku'v'a lu'manyi'lo lwa kalu'mbi'lo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' alakasi'nzi'le kadi'lana kenako ha hantu' hasondo aho v'ali'si'nzi'laga vitaambo vya ku'sini'zya wu'kenagu'zi na vitaambo vya ku'zigya. Ki'ti' ki'taambo cha ku'sini'zya wu'kenagu'zi i'vyo ki'li' cha muhozya, hu' vyene ki'taambo cha ku'sini'zya musango ki'li' nsawo ya muhozya. Nacho ki'li' ki'sondo muno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho muhozya mwenu'yo alasole magazi madoo ga ki'taambo cha ku'sini'zya musango na ku'muv'ila mwenu'yo u'yo ali'sosohiwa ku' mpelo na itwi lya mulyi'la na ku' li'nkumwa lya ku' mukono gwakwe gwa mulyi'la na li'nkumwa lya ku' mugu'lu' gwakwe gwa mulyi'la. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' muhozya alasole lwandi' lwa genago maguta na ku'gapu'ngu'li'la mu ki'ganza cha mukono gwakwe gwa mumoso. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' aladobye maguta genago ku' lyala lyakwe lya mukono gwa mulyi'la na ku'nyanyagi'la kali' mupungati' ha mbele yamwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhozya alamuv'ile u'yo ali'sosohiwa lwandi' lwa maguta ago gali' mu ki'ganza ku' mpelo ya itwi lya mulyi'la na ku' li'nkumwa lya ku' mukono gwakwe gwa mulyi'la haki'mo na ku' li'nkumwa lya ku' mugu'lu' gwakwe gwa mulyi'la, mu lwandi' lwene lu'lo u'mo wamuv'ilaga magazi ga ki'taambo cha ku'sini'zya musango. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maguta ago galasigali'le mu ki'ganza chakwe muhozya, alagav'ile ku' mutwe gwa mwenu'yo muntu' u'yo ali'sosohiwa, na ku'v'ezya wu'swanano ku'nguno yakwe ha mbele yamwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhozya alaki'egezye i'cho ki'taambo cha ku'sini'zya wu'kenagu'zi, na ku'v'ezya wu'swanano ku'nguno ya muntu' mwenu'yo. Hangi' alasi'nze kadi'lana ka ki'taambo cha ku'zigya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ku'kafumya ha igu'lya na ihozezyo, haki'mo na kalu'mbi'lo ka mbutoo, ki'gele ku'mali'zi'zya ku'muv'ezezya wu'swanano, nawe alav'e wasosoka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sumbwa muntu' mwenu'yo u'lu' av'e mupi'na, na akakowola ku'pandi'ka vintu' vyeni'vyo, haho alafumye kadi'lana kamo ka ng'ondi ku'v'a ki'taambo cha ku'sini'zya musango, ki'gele ki'wu'siwe ki'v'e lu'manyi'lo lwa kalu'mbi'lo, na ku'muv'ezezya wu'swanano. Hangi' alafumye kilo yi'mo ya wu'fuma wu'nelezu u'wo wu'seleganiv'ilwe na maguta ga muzeituni ku'v'a kalu'mbi'lo ka mbutoo, na selusi ya lita ya maguta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alalete na mapu'u'la av'i'li' ninga makune av'i'li' ga nkunda, ku'londana na i'vyo alakowole ku'pandi'ka. Li'mo li'lav'e lya ki'taambo cha ku'sini'zya wu'kenagu'zi, na lya wu'v'i'li' lya ki'taambo cha ku'zigya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lu'siku' lwa munane alamuletele muhozya vintu' vyeni'vyo bi'hi' na wingi'li'lo wa Ihema lya Ku'sangi'zya ha mbele yamwa Gu'ku' Mulungu, ku'nguno ya ku'sosohiwa kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe muhozya alakasombe kenako kadi'lana ka ki'taambo cha ku'sini'zya musango, haki'mo na selusi ya lita ya maguta, haho alaviwu'sye viv'e lu'manyi'lo lwa kalu'mbi'lo ha mbele yamwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho alakasi'nze kenako kadi'lana ka ki'taambo cha ku'sini'zya musango. Hangi' alasole lwandi' lwa magazi na ku'muv'ila ku' itwi lya mulyi'la lya muntu' u'yo alav'e ali'sosohiwa, na ku'muv'ila hangi' ku' li'nkumwa lya ku' mukono gwa mulyi'la lya mwenu'yo muntu', haki'mo na ku' li'nkumwa lya ku' mugu'lu' gwa mulyi'la. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' muhozya alasole lwandi' lwa genago maguta na ku'gapu'ngu'li'la mu ki'ganza cha mukono gwakwe gwa mumoso, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na alamunyanyagi'le muntu' mwenu'yo maguta genago ku' ku'tu'mi'la lyala lyakwe lya mukono gwa mulyi'la kali' mupungati' ha mbele yamwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhozya alamuv'ile u'yo ali'sosohiwa lwandi' lwa maguta ago gali' mu ki'ganza, ku' itwi lya mulyi'la, ku' li'nkumwa lya ku' mukono gwa mulyi'la, na ku' li'nkumwa lya ku' mugu'lu' gwa mulyi'la, mu lwandi' lwene lu'lo u'mo wamuv'ilaga magazi ga ki'taambo cha ku'sini'zya musango. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maguta ago galasigali'le mu ki'ganza chakwe, muhozya alamuv'ile ku' mutwe muntu' mwenu'yo u'yo ali'sosohiwa, ki'gele ku'v'ezya wu'swanano ku'nguno yakwe ha mbele yamwa Gu'ku' Mulungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' muhozya alasole ago mapu'u'la ninga ago makune ga nkunda ku'londana na i'vyo muntu' mwenu'yo akowolile ku'leta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugati' nago li'mo li'lav'e ku'nguno ya ki'taambo cha ku'sini'zya wu'kenagu'zi na li'ngi' ku'nguno ya ki'taambo cha ku'zigya, haki'mo na kalu'mbi'lo ka mbutoo. Ku' nzi'la yeni'yi' muhozya alamuv'ezezye muntu' mwenu'yo wu'swanano ha mbele yamwa Gu'ku' Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yeni'yi' hu' nhama ya ki'la muntu' wa wu'lwile wa ndi'li' wa ku'landi'ki'zya u'yo akakowola ku'pandi'ka kalu'mbi'lo ako kali'koov'iwa ka ku'musosohya.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndoowu mu magelele ga nnumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' Gu'ku' Mulungu wav'awi'laga Mose na Aloni ati', ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aho mulav'e mwingi'la mu nsi' ya Kanaani, i'yo nu'mupa muyi'teme, nanne mbe ndete ndoowu mugati' na nnumba yi'mo ya nsi' yeni'yo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34",
            "verseOrgIds": [
              "LEV.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "hohene musav'a nnumba yeni'yo yi'lamudime ku'ya ku' muhozya na ku'kamuwi'la ati', ‘Nawonaga ki'ntu' ki'mo ku' nnumba yanne kikolile ki'ti' ndoowu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.35",
            "verseOrgIds": [
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhozya alalagi'li'zye ku'v'a vifumiwe vintu' vyose mu nnumba yeni'yo, aho akaali' ku'ya ku'kayikomya ndoowu yeni'yo, ki'gele vintu' i'vyo vili' mu nnumba ku'du' vitangaziwe ku'v'a vili' na zoma. Haho muhozya alaingi'le na ku'yikomya nnumba yeni'yo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe alayikomye ndoowu yeni'yo ku' nnumba. U'lu' yingi'lile ku' magelele, nago gali' na madu'lu'lu' madu'lu'lu' ga langi ya lu'du'tu' ninga yazaa na gingi'lile mugati' na magelele, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "hohene muhozya alafume ha ibala na nnumba yeni'yo, na ku'gu'lugala muzigo gwayo ku' itungo lya nsiku' mupungati'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lu'siku' lwa mupungati', muhozya alasu'v'e hangi' na ku'yikomya nnumba yeni'yo. U'lu' yi'v'e ndoowu yeni'yo yakalandala ku' magelele ga nnumba yeni'yo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "haho muhozya alalagi'li'zye v'agafumye mawe gose ago gali' na ndoowu, na ku'gatagi'la ha lwandi' lu'zomalu'ku ha ibala na kaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magelele gose ga mugati' ga nnumba yeni'yo gize gapalangu'lwe ki'la lwandi', na matuntu gose ga malongo genago v'alagazyolele ha ibala na kaya ha lwandi' lu'zomalu'ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' v'alasole mawe gangi' na ku'zyenga aho habomolilwe, na ku'yi'si'li'v'a nnumba yeni'yo ku' wu'pya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ali'vi aho galav'e gafumiwa mawe genago, na nnumba yeni'yo ku'palangu'lwa na ku'si'li'v'wa wu'pya, na u'lu' ndoowu yeni'yo yigele hangi' mugati' na nnumba yeni'yo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "haho muhozya alaingi'le na ku'yikomya. U'lu' ndoowu yeni'yo yalandalaga mu nnumba yeni'yo, sanga yi'li' ndoowu mbi i'yo yi'kali' ku'hangwa. Nnumba yeni'yo yi'li' na zoma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi'lamudime muntu' mwenu'yo ayi'bomole nnumba yeni'yo. Mawe gayo, miti' na malongo gayo, vyose alavizyole na ku'vitagi'la ha ibala na kaya ha lwandi' lu'zomalu'ku.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hangi' ki'la muntu' u'yo alaingi'le mu nnumba yeni'yo ha itungo i'lo yi'lav'e yi'lugalilwe, alav'e na zoma mpaka mpi'ndi'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ki'la muntu' u'yo alalale ninga ku'lyi'la mu nnumba yeni'yo, yi'lamudime avikanze vizwalo vyakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ali'vi u'lu' muhozya ize ayikomye na ku'wona ku'v'a ndoowu yi'kalandalile ku' nnumba yeni'yo, ku'fuma aho ndi' yasi'li'v'wa, haho muhozya alayi'tangazye ku'v'a nnumba yeni'yo yi'li' nsoso, ku'nguno ndoowu yakamala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musav'a nnumba yeni'yo alalete nnoni iv'i'li', ki'pande cha muti' gwa mwelezi, wu'zi wa langi yazaa na itambi' lya hisopo, viv'e ku'nguno ya ku'yi'sosohya nnumba yeni'yo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnoni yi'mo alayi'si'nzi'le ha igu'lya na nnungu' i'yo yi'li' na minzi' masoga ga kasela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangi' alasole ki'pande cha mwelezi, itambi' lya hisopo, wu'zi wa langi yazaa na i'yo nnoni mpanga, na ku'vidobya mu magazi ga i'yo nnoni ya wu'si'nzwe, na ku' minzi' ago ga kasela, na ku'yi'nyanyagi'la nnumba yeni'yo kali' mupungati'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "I'vi hu' vyene alayi'sosohye nnumba yeni'yo ku' magazi ga nnoni, minzi' ga kasela, nnoni mpanga ki'pande cha mwelezi, itambi' lya hisopo, na ku' wu'zi wa langi yazaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
