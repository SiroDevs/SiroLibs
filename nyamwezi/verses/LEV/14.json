              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho alayi'leku'li'le i'yo nnoni mpanga yiyagalu'le. Ku' nzi'la yeni'yo alav'e wav'ezya wu'swanano ku'nguno ya nnumba yeni'yo, nayo yi'lav'e yasosoka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
