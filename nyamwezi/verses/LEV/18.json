          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' u'lale na muku'lu'ye ninga muzunaye na nnoko. Mwenu'yo ali' mudu'gu' wa bi'hi' ku'mwa nnoko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
              "LEV.18.13"
            ]
          }
        }
      ]
    },
    {
