            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' u'lale na mukwelayo, muki' wa muku'lu'yo ninga muzunayo. U'lamuv'i'nzi'le isima mudu'gu'yo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' u'lale na muki'ma haki'mo na mwana wakwe, ninga mwizu'ku'lu' wakwe wa ku'v'yalwa na mwana wakwe. V'enav'o v'ali' v'adu'gu' v'akwe v'a bi'hi'. Lyeni'lo li'li' ihu'v'yo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
