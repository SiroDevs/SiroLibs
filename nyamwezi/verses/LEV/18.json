          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'du' u'muv'i'nzi'le isima so muhanya ninga mudo ku' ku'lala na muki' wakwe. Mwenu'yo ali' nnoko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
              "LEV.18.14"
            ]
          }
        }
