          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe Mose wav'atangazi'zyaga V'aizilaeli myanya zyamwa Gu'ku' Mulungu i'vyo zitu'u'lilwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
