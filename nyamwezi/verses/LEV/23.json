            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.21",
            "verseOrgIds": [
              "LEV.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Aho mulav'e muli'wi'mbu'la viliwa mu migu'nda, ku'du' mwize muv'e muli'wi'mbu'la mpaka ku' lu'v'i'mbi', ninga ku'du' mwize musu'v'e ku'salala nsalazyo. Zyeni'zyo mulazilekele ku'nguno ya v'api'na na v'ageni v'izi'li'zi. Ene hu' ni' Gu'ku' Mulungu, Mulungu winywe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
    },
