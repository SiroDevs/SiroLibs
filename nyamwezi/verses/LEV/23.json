            }
          ]
        },
        {
          "text": "Hangi' Gu'ku' Mulungu wamuwi'laga Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.23",
            "verseOrgIds": [
              "LEV.23.23"
            ]
