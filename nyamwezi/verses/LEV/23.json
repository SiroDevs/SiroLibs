          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gu'ku' Mulungu wamuwi'laga Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.33",
            "verseOrgIds": [
              "LEV.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“U'v'awi'le V'aizilaeli ati', ‘Lu'siku' lwa iku'mi na itano lwa mwezi gwenu'go gwa mupungati', lu'lav'e lwa ku'lamula ku'muv'ezezya Gu'ku' Mulungu Mwanya gwa Mahema gwa nsiku' mupungati'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lu'siku' lwa kwandya mulav'ezye nkuti'la nsondo. Ku'du' mwize mutu'mame mili'mo zya nsiku' zyose. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku' nsiku' mupungati' mulamufumi'zye Gu'ku' Mulungu kalu'mbi'lo ka ku'zigya. Lu'siku' lwa munane mulav'ezye nkuti'la nsondo na ku'mufumi'zya Gu'ku' Mulungu kalu'mbi'lo ka ku'zigya. Nkuti'la yeni'yo yi'li' nsondo. Ku'du' mwize mutu'mame mili'mo zya nsiku' zyose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Zyeni'zyo hu' myanya zyamwa Gu'ku' Mulungu i'zyo zitu'u'lilwe i'zyo mulatangazye ku'v'a nkuti'la nsondo zya ku'mufumi'zya Gu'ku' Mulungu kalu'mbi'lo ka ku'zigya, vitaambo vya ku'zigya, kalu'mbi'lo ka mbutoo na ki'neneko, haki'mo na vitaambo vingi', ki'la kalu'mbi'lo ku' lu'siku' lwako. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.37",
            "verseOrgIds": [
              "LEV.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myanya zyeni'zyo zili' haki'mo na lu'siku' lwa ki'suuho chamwa Gu'ku' Mulungu ya nsiku' zyose ya ki'la yuma, hangi' na vipanwa vinywe, na kalu'mbi'lo kinywe ka milahi' zyose, na kalu'mbi'lo kinywe ka ku'togwa, i'vyo muli'nfumi'zyaga ene Gu'ku' Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ku'lamuli'la lu'siku' lwa iku'mi na itano lwa mwezi gwa mupungati', aho mulav'e mwamala lyi'mbu'la mu migu'nda zinywe mulamuv'ezezye Gu'ku' Mulungu Mwanya u'go gwa Mahema ku' nsiku' mupungati'. Lu'siku' lwa kwandya na lu'siku' lwa munane zili' nsiku' zya ku'lenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.39",
            "verseOrgIds": [
              "LEV.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lu'siku' lwa kwandya mulasole matambi' ga miti' zinywe misoga, yaani matambi' ga mitende, matambi' ga madu'tu' mingi na matambi' ga miti' i'zyo zili'melaga mu ngiligili na myongo, na inywe mulagiye ha mbele yamwa Gu'ku' Mulungu, Mulungu winywe, ku' nsiku' mupungati'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulav'ezye mwanya gwenu'gu' ku' itungo lya nsiku' mupungati' ku' ki'la mwaka ku'mwa Gu'ku' Mulungu. Yeni'yi' yi'li' nhama ya nhananhana ku' wu'v'yalwa winywe u'wo wu'lalonde, na inywe mulav'e muli'v'ezya ku' ki'la mwezi gwa mupungati'. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku' itungo lya nsiku' mupungati' mulikale mu mahema. V'av'anda v'ose v'a mu Izilaeli v'alikale mu mahema, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ki'gele wu'v'yalwa winywe wize wu'manye ku'v'a aho ndi' nav'afumya V'aizilaeli ku' nsi' ya Misili ndi' nav'av'ezya v'ikale mu mahema. Ene hu' ni' Gu'ku' Mulungu, Mulungu winywe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        }
      ]
    },
