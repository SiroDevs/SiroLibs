            }
          ]
        },
        {
          "text": "“U'lu' kalu'mbi'lo kakwe kav'e ka mbu'li, alakafumye ha mbele yamwa Gu'ku' Mulungu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
