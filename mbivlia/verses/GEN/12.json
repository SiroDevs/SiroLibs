          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yeova aumĩlĩla Avalamu, na asya, Nganenga ũsyao waku nthĩ ĩno: na vau aakĩa Yeova, ũla wamumĩlĩle, kĩthembeo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.7",
            "verseOrgIds": [
              "GEN.12.7"
            ]
          }
        },
        {
