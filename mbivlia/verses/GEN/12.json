            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalamu oosa Salai mũka wake, na Loto mwana wa mwana‐a‐inyia, na syĩndũ syoo syonthe ila moombanĩtye, na andũ ala masyaĩwe Aalani; na mauma nĩ kana maende nthĩ ya Kanaani; na mavota nthĩ ya Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        },
        {
          "name": "note",
