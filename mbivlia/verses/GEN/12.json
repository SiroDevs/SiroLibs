          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalamu athi kyalo, aendeea elekele ngalĩ ya Ĩtheo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        }
