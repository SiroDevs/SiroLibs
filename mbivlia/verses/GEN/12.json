          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalamu avĩtĩla ĩ nthĩ avika vandũ vetawa Sekemu, kũvika mũtĩ wa mwaloni wĩ Mole. Na ĩvinda yĩu Mũkanaani atũaa nthĩ ĩsu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.6",
            "verseOrgIds": [
              "GEN.12.6"
            ]
          }
        },
        {
