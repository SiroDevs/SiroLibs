                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yoana, e kolokolonĩ eew’a ũvoo wa meko ma Klĩsto, atũma amanyĩw’a make, makamũkũlye, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
              "MAT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.1"
              },
              "items": [
                {
                  "text": "Mal 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.26"
              },
              "items": [
                {
                  "text": "Nda 9.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "We nue ũla wĩũka, kana tũmweteele ũngĩ? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.3",
            "verseOrgIds": [
              "MAT.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yesũ asũngĩa, amea, Endai mũkamũtavye Yoana maũndũ ala mwĩw’ĩte na kũmona: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.5"
              },
              "items": [
                {
                  "text": "Isa 35.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.1"
              },
              "items": [
                {
                  "text": "61.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ililinda nikwona, na ala mathuaa nĩmeũthi, na ala mawaĩte mangũ nĩmeũthew’a, na ala au matũ nĩmekwĩw’a, na ala akw’ũ nĩmeũthayũũkw’a, na ala ngya nĩmeũtavw’a ũvoo museo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.5",
            "verseOrgIds": [
              "MAT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.57"
              },
              "items": [
                {
                  "text": "Mt 13.57",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.31"
              },
              "items": [
                {
                  "text": "26.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nĩ mũathime o ũla ũtakona ũndũ wa ũlulutĩkw’a nthĩnĩ wakwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.6",
            "verseOrgIds": [
              "MAT.11.6"
            ]
          }
        }
      ]
    },
