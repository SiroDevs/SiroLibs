          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũkatwie mĩsoa ĩlĩ, thanthatũ kĩla mũsoa, mesanĩ ntheu mbee wa Yeova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
