          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩw’o Mwĩaĩi, Yeova wa nguthu, ũnũkwasya, Thi kwa mũsũvĩi ũsu wa ũthwii, o Sevina, ũla ũsũvĩaa nyũmba, noimũkũlya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.15",
            "verseOrgIds": [
              "ISA.22.15"
            ]
          }
        },
        {
