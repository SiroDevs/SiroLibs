              },
              "items": [
                {
                  "text": "2 Asu 18.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.20",
            "verseOrgIds": [
              "ISA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngamũvw’ĩka ngũa yaku ndasa, na ngamwĩkĩa vinya ũndũ wa kũmwova mũsivi waku, na ngeekĩa ũsumbĩko waku kw’okonĩ kwake; nake akeethĩwa ĩthe kwa ala matwĩe Yelusaleme, na kwa nyũmba ya Yuta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.21",
            "verseOrgIds": [
              "ISA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũvũngũo wa nyũmba ya Ndaviti ngatũlya kĩtuonĩ kyake; nake akavingũa na vai wĩvinga; na akavinga, na vai wĩvingũa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.22",
            "verseOrgIds": [
              "ISA.22.22"
            ]
          }
        },
        {
