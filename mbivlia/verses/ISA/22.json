          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wĩĩka ata vaa? Na wĩ naũ vaa, ũndũ ũkwĩyasĩa ngunga ya mathiko vaa? Ta ũla wĩyasĩe ngunga ĩũlũ, akĩyasĩa wĩkalo ĩvianĩ! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.16",
            "verseOrgIds": [
              "ISA.22.16"
            ]
          }
        },
        {
