              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakua kũthilĩka kwa Yeova, nũndũ nĩnĩmũvĩtanĩsye, kũvika andetea, na kũsilĩla ũndũ wakwa: akanumĩlya kyeninĩ, na ngoona ũlũngalu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
