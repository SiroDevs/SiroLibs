          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũkĩi wa Ngai nĩwaĩte kũũ nthĩ, na kũti ũmwe mũlũngalu katĩ wa andũ: onthe moveesyaa metĩkye nthakame; nĩmasyĩmaa kĩla mũndũ mwana‐a‐ĩthe na kĩtei. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        },
        {
