          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũkatane ĩũlũ wakwa, we mũmaitha wakwa: yĩla ngũvalũka, ngookĩla; yĩla ngwĩkala kĩvindunĩ, Yeova akeethĩwa kyeni kwakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        },
        {
