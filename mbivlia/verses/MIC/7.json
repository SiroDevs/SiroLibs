              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikaĩkĩĩe mũtũi; mũtikekwatye mũnyanya; sũvĩa ilomo sya kanyw’a waku kwa mũndũ mũka ũla ũkomaa kĩthũinĩ kyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        },
        {
