              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũlaĩka wa Yeova amumĩlĩla ũlĩlĩnzĩnĩ wa mwaki ũla wakanĩte kakuthunĩ katĩ: na oona, na, sisya, kakuthu nĩkakanĩte mwaki, na kakuthu katyavĩsaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
