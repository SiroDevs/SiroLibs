              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mose asya, Nĩngwathũka yu none ũndũ ũũ ũnene, na kĩla kĩũtuma kakuthu katavya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.3",
            "verseOrgIds": [
              "EXO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yĩla Yeova wonie kana nĩwathũka ũtee one, Ngai amwĩta kuma kakuthunĩ katĩ, na amwĩa, Mose, Mose. Nake eetĩka, Ninyioo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.4",
            "verseOrgIds": [
              "EXO.3.4"
            ]
          }
        },
