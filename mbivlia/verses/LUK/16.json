                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩla mĩao na athani maĩ kw’o kũvika Yoana: na kuma ĩvinda yĩu ũvoo mũseo wa ũsumbĩ wa Ngai nũtavanaw’a, na kĩla mũndũ nũvotaa na vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.8"
              },
              "items": [
                {
                  "text": "Mt 15.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ nĩ ũvũthũ ĩtu na nthĩ kũvĩta, kwĩ kaũkenyũsyo kamwe ka ĩla mĩao kũvalũka mana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
      ]
