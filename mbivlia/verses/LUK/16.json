            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Avalisi, ala mendaa mbesa, meew’a maũndũ asu onthe; na mamũvũthya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
