                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwa nĩngũmwĩa, Ĩmanthĩei anyanya na ũthwii ũla ũte wa ũlũngalu; nĩ kana yĩla wĩthela, mamwose inyw’ĩ mawĩkalonĩ ma tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.9",
            "verseOrgIds": [
              "LUK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.17"
              },
              "items": [
                {
                  "text": "Lk 19.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla wĩ na kĩthito ũndũnĩ ũnini mũno, e kĩthito maũndũnĩ manene: na ũla ũte mũlũngalu ũndũnĩ ũnini, nake ti mũlũngalu maũndũnĩ manene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.10",
            "verseOrgIds": [
              "LUK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu ethĩwa mũtyaaĩthĩwa na kĩthito na ũthwii ũla ũte wa ũlũngalu, nũũ ũla ũkamũĩkĩĩa na ũthwii ũla wa w’o? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.11",
            "verseOrgIds": [
              "LUK.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa mũtyaĩ na kĩthito na syĩndũ sya mũndũ ũngĩ, nũũ ũla ũkamũnenga syĩndũ syenyu ene? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.12",
            "verseOrgIds": [
              "LUK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.24"
              },
              "items": [
                {
                  "text": "Mt 6.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vai mũthũkũmi ũtonya kũthũkũma mavwana elĩ; nũndũ akamena ũmwe, na akĩmwenda ũla ũngĩ; kana akalũman’ya na ũmwe, na akĩmũvũthya ũla ũngĩ. Mũtitonya kũmũthũkũma Ngai na ũthwii.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        }
      ]
    },
