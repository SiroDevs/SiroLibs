                "loc": "MRK.6.7"
              },
              "items": [
                {
                  "text": "Mko 6.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩtina wa maũndũ asu Mwĩaĩi anyuva angĩ mĩongo mũonza, na amatũma elĩ na elĩ, mathi mbee wake kĩla ndũa na vandũ, vala wakilĩlye kũthi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.1",
            "verseOrgIds": [
              "LUK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.37"
              },
              "items": [
                {
                  "text": "Mt 9.37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.35"
              },
              "items": [
                {
                  "text": "Yoa 4.35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na amea atĩĩ, Nĩw’o ngetha nĩ mbingĩ, ĩndĩ akethi nĩ avũthũ: kwondũ wa ũu voyai Mwĩaĩi wa ngetha, atũme akethi ngethanĩ yake. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.2",
            "verseOrgIds": [
              "LUK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endai; na lĩlĩi, nĩngũmũtũma ta tũtena twa malondu katĩ wa nzũi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.3",
            "verseOrgIds": [
              "LUK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.3+LUK.9.4+LUK.9.5"
              },
              "items": [
                {
                  "text": "Lk 9.3–5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.29"
              },
              "items": [
                {
                  "text": "2 Asu 4.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manyai ũkua ngusu ya mbesa, kana mũvuko, kana iatũ; na manyai ũkethya mũndũ nzĩanĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.4",
            "verseOrgIds": [
              "LUK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na o nyũmba ĩĩa mwĩlikaa, ambaai kwasya, Mũuo wĩthĩwe nyũmbanĩ ĩno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.5",
            "verseOrgIds": [
              "LUK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa vo ve mwana wa mũuo, mũuo wenyu ũkekala nake: ĩndĩ ethĩwa nde vo, ũkamũsyokea. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.6",
            "verseOrgIds": [
              "LUK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.18"
              },
              "items": [
                {
                  "text": "1 Tim 5.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.5+1CO.9.6+1CO.9.7+1CO.9.8+1CO.9.9+1CO.9.10+1CO.9.11+1CO.9.12+1CO.9.13+1CO.9.14"
              },
              "items": [
                {
                  "text": "1 Ako 9.5–14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩkalai nyũmbanĩ ĩsu, mũkĩya na mũkĩnyw’a o kĩla memũnengae: nũndũ mũtethya wa wĩa nĩwaĩlwe nĩ ĩtuvi yake. Manyai kumaalanga mũkĩvotanga nyũmba ĩno na ĩno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.7",
            "verseOrgIds": [
              "LUK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.27"
              },
              "items": [
                {
                  "text": "1 Ako 10.27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ndũa o na yĩva ĩla mwĩvotaa, na mamũthokya, ĩsaai syĩndũ ila syĩetawe mbee wenyu: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.8",
            "verseOrgIds": [
              "LUK.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "vosyai awau ala me vo, mũkĩmatavya, Nĩmũthengeewe nĩ ũsumbĩ wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.9",
            "verseOrgIds": [
              "LUK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ ndũa o na yĩva ĩla mwĩvotaa, na malea kũmũthokya, endai nzĩanĩ syayo, mũkyasya, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.10",
            "verseOrgIds": [
              "LUK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.11",
            "verseOrgIds": [
              "LUK.10.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.6"
              },
              "items": [
                {
                  "text": "Meko 18.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kĩtoo kya ndũa yenyu, kĩla kĩkwatĩte nyaĩĩ sitũ, nĩtũũmũvangũlĩla: ĩndĩ manyai ũũ, ũsumbĩ wa Ngai nũmũthengee. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.11",
            "verseOrgIds": [
              "LUK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ nĩngũmũtavya, Sotomo ĩkethĩwa yĩ kavaa mũthenya ũsu, kwĩ ndũa ĩsu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.12",
            "verseOrgIds": [
              "LUK.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.12",
            "verseOrgIds": [
              "LUK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.21+MAT.11.22+MAT.11.23"
              },
              "items": [
                {
                  "text": "Mt 11.21–23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woo nĩ waku, Kolasini! Woo nĩ waku, Vethisaita! Nũndũ kethĩwa mavinya ala mekĩtwe kwenyu, meekiwe Tile na Sitoni, andũ ma kw’o methĩwa maalyũlile ngoo tene, makĩkala nthĩ mekĩĩte makunia na kwĩyũmba mũu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩndĩ Tile na Sitoni kũkethĩwa kwĩ kavaa ũsilĩlonĩ, kũte inyw’ĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13"
              },
              "items": [
                {
                  "text": "Isa 14.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naku Kavelinaumi, ũkookĩlw’a kũvika ĩutnĩ? Ũkatheew’a kũvika vala maveva ma akw’ũ mekalaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.40"
              },
              "items": [
                {
                  "text": "Mt 10.40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.23"
              },
              "items": [
                {
                  "text": "Yoa 5.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.23"
              },
              "items": [
                {
                  "text": "15.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũla ũmwĩw’aa inyw’ĩ, nũmbĩw’aa nyie; na ũla ũmũleaa inyw’ĩ, nũndeaa nyie; na ũla ũndeaa nyie, nũmũleaa ũla wandũmie.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ala mĩongo mũonza masyoka me atanu, makyasya, Mwĩaĩi, o na ndaimoni niũtwĩnyivĩsya syĩtwanĩ yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.17",
            "verseOrgIds": [
              "LUK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.31"
              },
              "items": [
                {
                  "text": "Yoa 12.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.8"
              },
              "items": [
                {
                  "text": "Ũvu 12.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake amea, Nĩnoonaa Satani avalũka kuma ĩtunĩ ta ũtisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.18",
            "verseOrgIds": [
              "LUK.10.18"
            ]
