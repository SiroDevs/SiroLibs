              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.20",
            "verseOrgIds": [
              "LUK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na saa ũsu Yesũ atana nthĩnĩ wa Veva Mũtheu, na asya, Nĩngũũkatha, Asa, Mwĩaĩi wa ĩtu na nthĩ, nũndũ maũndũ asu nĩwamavithie andũ oĩ na ala me na ũmanyi, na wavuanĩsye twana tũnini: ĩĩ, Asa; nĩkwĩthĩwa nĩw’o wendeesye kwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.21",
            "verseOrgIds": [
              "LUK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩnĩnengetwe maũndũ onthe nĩ Asa wakwa: na vai mũndũ wĩsĩ Mwana nũũ, ate o Asa; kana Asa nũũ, ate o Mwana, na mũndũ o na wĩva ũla Mwana ũkwenda ũmũvuanĩsya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.22",
            "verseOrgIds": [
              "LUK.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.16"
              },
              "items": [
                {
                  "text": "Mt 13.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na eethyũũĩa amanyĩw’a, na amea me nzama, Nĩ maathime metho ala mekwona maũndũ ala mũkwona: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.23",
            "verseOrgIds": [
              "LUK.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.10"
              },
              "items": [
                {
                  "text": "1 Vet 1.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nũndũ nĩngũmũtavya, athani na asumbĩ aingĩ mendie kwona maũndũ ala mũkwona, na maiaamona; na kwĩw’a maũndũ ala mũkwĩw’a, na maiaamew’a.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.24",
            "verseOrgIds": [
              "LUK.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
