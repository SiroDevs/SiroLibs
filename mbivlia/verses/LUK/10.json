                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmwenei, nĩnamũnenga ũkũmũ wa ũkinya ĩũlũ wa nzoka na ing’auũ, na ĩũlũ wa vinya w’onthe wa mũmaitha: na mũtikona ũndũ ũthũku nongi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.19",
            "verseOrgIds": [
              "LUK.10.19"
            ]
          }
        },
        {
