              "items": [
                {
                  "text": "Kũt 28.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.4",
            "verseOrgIds": [
              "JOS.7.4"
            ]
