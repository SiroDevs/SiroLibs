        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na andũ ma Ai mooaa ta andũ mĩongo ĩtatũ na thanthatũ katĩ woo; na mamalũngya kuma mbingĩlonĩ o na kũvika Sevalimu, na mamoaĩa kĩtheeonĩ: na ngoo sya andũ syatweka, na syeethĩwa ta manzĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.5",
            "verseOrgIds": [
              "JOS.7.5"
            ]
          }
        }
      ]
    },
