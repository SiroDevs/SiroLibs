          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yĩla nĩnoonie mũtavonĩ suka mũseo wa Mbaviloni, na sekeli maana elĩ ma vetha, na kĩlungu kya thaavu kya sekeli mĩongo ĩtano, nĩvo ĩndĩ nĩnasyĩw’ĩe ĩtomo, na nĩnasyosa; na, sisya, nivithĩtwe nthĩ ĩeemanĩ yakwa katĩ, na ũla vetha ungu wasyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
            "verseOrgIds": [
              "JOS.7.21"
            ]
          }
        }
