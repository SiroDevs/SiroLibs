                {
                  "text": "Mot 14.45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.12",
            "verseOrgIds": [
              "JOS.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũkĩla, ũvathan’ye andũ methĩwe atheu, na ũimea, Ĩvathan’yei kwondũ wa ũnĩ: nũndũ ũũ nĩw’o Yeova, Ngai wa Isilaeli, ũnũkwasya, Ve kĩndũ kĩvathĩtwe katĩ waku, we Isilaeli; ndũtonya kũũngama mbee wa amaitha maku, kũvika yĩla mwĩveta kĩla kĩndũ kĩvathĩtwe kyume katĩ wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.13",
            "verseOrgIds": [
              "JOS.7.13"
            ]
          }
        },
        {
