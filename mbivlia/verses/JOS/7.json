          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosua asya, Ĩiaa! Ame Mwĩaĩi Yeova, waingisye andũ aa Yolotani ũndũ wa kĩ we, ũtũnengane kw’okonĩ kwa Aamoli, ũtwanange? Nenda kethĩwa tweanĩwe nĩ kwĩkala mũingo wa Yolotani! ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.7",
            "verseOrgIds": [
              "JOS.7.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
