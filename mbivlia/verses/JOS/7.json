            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwondũ wa ũu kĩoko mũkathengeew’a mbaĩ na mbaĩ: na kũkeethĩwa, mbaĩ ĩla Yeova wĩosa ĩkathengeea mũvĩa na mũvĩa; na mũvĩa ũla Yeova wĩosa ũkathengeea nyũmba na nyũmba; na nyũmba ĩla Yeova wĩosa ĩkathengeea mũndũ na mũndũ. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
