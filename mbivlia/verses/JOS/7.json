            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Yosua atembũa ngũa syake, na avalũka nthĩ na ũthyũ wake mbee wa yĩla ĩsandũkũ ya Yeova kũvika wĩoo, we na atumĩa ma Isilaeli; na meekĩa kĩtoo mĩtwenĩ yoo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.6",
            "verseOrgIds": [
              "JOS.7.6"
            ]
          }
        },
