              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ĩndĩ Yosua atũma atũmwa, na masemba ĩeemanĩ; na, sisya, syaĩ mbithe ĩeemanĩ yake, na ũla vetha ungu wasyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.22",
            "verseOrgIds": [
              "JOS.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
