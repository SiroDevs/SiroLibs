          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ethĩwa nzĩa nĩ ndasa mũno kwaku, ũndũ ũtatonya kwikua, nĩkwĩthĩwa vandũ vau nĩ vaasa mũno na kwaku, vala Yeova Ngai waku wĩnyuva, ekĩe syĩtwa yake vo, yĩla Yeova Ngai waku ũkakũathima; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
