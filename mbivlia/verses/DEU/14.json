              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩvo ĩndĩ wĩikũan’ya itw’ĩke mbesa, noyoveea i mbesa kw’okonĩ kwaku, na enda vala Yeova Ngai waku wĩnyuva: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mbesa isu ia kwondũ wa o kĩla ngoo yaku ĩnĩkwenda, kwondũ wa ng’ombe, kana malondu, kana mbinyu, kana kĩla kĩtoonasya, kana o kĩla ngoo yaku yĩkwĩtya; na ũkaĩa vau mbee wa Yeova Ngai waku, na ũkatana, we na ala ma nyũmba yaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Mũlivai ũla wĩ kwaku, ndakaakũle; nũndũ nde na kĩanda kana ũtiĩwa vamwe naku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        },
