              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.20",
            "verseOrgIds": [
              "DEU.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũikaaye kĩndũ o na kĩva kya kũkw’a: nũtonya ũkĩnenga mwĩkali wa ũeninĩ wĩ kwaku, akaya; kana nũtonya ũkĩthooesya mũndũ wa nthĩ ĩngĩ: nũndũ wĩ mbaĩ ntheu kwa Yeova Ngai waku. Ndũkaaue katena ka mbũi na ĩia ya inyia wako. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        },
        {
