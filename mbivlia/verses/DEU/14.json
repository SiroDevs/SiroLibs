          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũndũ wĩ mbaĩ ntheu kwa Yeova Ngai waku, na Yeova nũkũnyuvĩte wĩthĩwe mbaĩ yake mwene, kuma ngonĩ syonthe sya andũ ila syĩ ĩũlũ wa nthĩ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
