        },
        {
          "text": "Mala basangaasiisie ese, lukali busa nga bamusangaasia enywe. Babaandu nga bano bakhoyeele khukhebulilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
