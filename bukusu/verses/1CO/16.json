          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi ne busangaafu khuloondekhana ne liliicha lia Sitefano, Fochunetasi, ne Akika, baliio nga abeele enywe ne muliio.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
