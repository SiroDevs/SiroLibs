              },
              "items": [
                {
                  "text": "Bikh. 19.8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khabe mu Efeso muno khukhwola endaalo eya Pendekositi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.8",
            "verseOrgIds": [
              "1CO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bubweyaangu bwe khukhola kimilimo kimiboofu buli eno, akhaba babemelekhana nase ne baliio bakali.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        }
      ]
    },
