          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basuubili boosi ano baruma kimileembe kiabwe. Khesiana buli sia mulala ne mwikwayilana mu ngila endakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
