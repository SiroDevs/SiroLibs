              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Timoteo aaba bali abirira ebweeneyo, mukhole eulile ali mwa mwakaanile mwinywe, sikila alikho akholela Omwami kimilimo busa nga seesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.10",
            "verseOrgIds": [
              "1CO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi yesi akhamulekelesia tawe, ne kakhali khukhwola mu muyeete achiililile ne lukeendo lwewe mu muleembe, nio aangalukhiile lundi, sikila namwirekekheele akalukhe ne bawandaayefwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
