              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mumanyile ka Sitefano nende be nju yewe, nibo bali bakristo ba baonisibwa be khunyoa mu Akaya mala beaana mu bukhalabani khu baandu ba Wele. Ese mwikoonjelela enywe, bawandaayase, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloonde burangirisi bwe babaandu nga bano, nende bwo kundi yesi okholanga kimilimo nabo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        }
      ]
    },
