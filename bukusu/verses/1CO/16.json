              "items": [
                {
                  "text": "Bikh. 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kheche niio muli ne malile khubira mu Masedonia, sikila khabirire Masedonia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyala nabakho nanywe khu siise, wakana kumunaane kwoosi, mala aba munyala mwanjeeta khuchiililila ne lukeendo lwase, osi osi niio khakeleo nje lundi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenya khumubonela elala busa khaba se khuli khumubonakho akeekhe busa ne ndikho mbira tawe. Niyikina khuba nanywe khu siise sileeyi, kaaba bali Omwami afukiilila.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        }
      ]
    },
