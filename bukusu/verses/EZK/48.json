        },
        {
          "text": "bilibwa bitaru. Bino bili silibwa sia Rubeni, silibwa sia Yuda, ne silibwa sia Lawi. Bilibwa bino biaalaangwa kamasina ke chikholo cha Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
