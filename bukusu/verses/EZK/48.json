    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko kamasina ke chikholo: Khurakikhira khu lwakha lwe ebunaswa khu muyila kwa Hetiloni, khukhwama Lebo-hamati, khukhwola e Hasari-enoni (lukoba luuli khu lwakha lwa Damasika ne Hamati ebunaswa). Lubeka olwo lulaba lwe kholo eya Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Dani, ebukwe khukhwola mumbo. Lubeka olwo lulaba lwe kholo eya Asheri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Asheri, ebukwe khukhwola mumbo. Lubeka olwo lulaba lwe kholo eya Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Nafutali, ebukwe khukhwola mumbo. Lubeka olwo lulaba lwe kholo eya Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Manase, ebukwe khukhwola mumbo. Lubeka olwo lulaba lwe kholo eya Efuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Efuraimu, ebukwe khukhwola mumbo. Lubeka olwo lulaba lwe kholo eya Rubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamilila khu lukoongo lwe kholo eya Rubeni, ebukwe khukhwola mumbo. Lubeka luno lulaba lwe kholo eya Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Yuda, ebukwe khukhwola mumbo. Lubeka luno lulabaandwa; bukhiikha chimita chielefu ekhumi na chibili ne chimia chiraano, ne buleeyi butekanilile ne buleeyi bwe kamaloba ke kholo ndalakho, ebukwe khukhwola mumbo. Abuundu atakatifu alaba akari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukoongo nilwo mulabaanda khulwo Mwami Wele lulaba chimita chielefu ekhumi na chibili ne chimia chiraano buleeyi ne chimita chielefu ekhumi bukhiikha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukoongo lutakatifu lulakabwamo luri: Basaayi balanyoola abuundu wabwe chimita ekhumi na chibili ne chimia chiraano lubeka lwe bunaswa, bukhiikha chimita chielefu chiraano lubeka lwe mumbo, bukhiikha chimita chielefu chiraano lubeka lwe bukwe, ne buleeyi chimita chielefu ekhumi na chibili ne chimia chiraano lubeka lwe siafubo. Abuundu atakatifu wo Mwami Wele alaba akari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukoongo luno lulaba lwe basaayi babarwa alubeka khulwe khukholela Omwami Wele, be lisaaye lia Satoki. Abo babakholela Ese mu busuubilifu enyuma we Baisiraeli khu khuundurakho nga Balawi bosi baakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuundu ano alaba kamaloba kabwe bong'ene khukhwama khu maloba kamatakatifu ke lukoongo olwo. Abuundu atakatifu lukali khukhwama khu lukoongo lwe Balawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu lukoongo lwe basaayi, Balawi balanyoola abuundu wabwe chimita chielefu ekhumi na chibili ne chimia chiraano buleeyi, ne bukhiikha chielefu chiraano. Buleeyi bwoosi bulaba chimita chielefu ekhumi na chibili ne chimia chiraano ne bukhiikha chimita chimita chielefu chiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se bakhakusiekho namwe bakhole bukulaani khu sitonyi siosi siosi sia abuundu ao tawe. Bakhakabakho omundu yesi yesi kamaloba ke abuundu aarobore ano tawe, sikila ali abuundu wa Wele atakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubeka lusikaale chimita chielefu chibili ne chimia chiraano bukhiikha nende chimita chielefu ekhumi na chibili ne chimia chiraano buleeyi, akhabe abuundu we khukholelao bibiindu bie mulukoba, abuundu niio babaandu bamenyile nende e mikuunda. Lukoba lulaba akari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buboofu bwe lukoba lulaba luri: Chimita chielefu chibili ne chimia chibili ne kamakhumi karaano ebunaswa, chimita chielefu chibili ne chimia chibili ne kamakhumi karaano siafubo, chimita chielefu chibili ne chimia chibili ne kamakhumi karaano ebukwe, nende chimita chielefu chibili ne chimia chibili ne kamakhumi karaano mumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukoba lulaba ne siwanja: chimita emia ndala ne kamakhumi kabili na chiraano ebunaswa, chimita emia ndala ne kamakhumi kabili na chiraano siabubo, chimita emia ndala ne kamakhumi kabili na chiraano ebukwe, nende chimita chimia chibili ne kamakhumi kabili na chiraano mumbo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubeka lusikaale khuloonda kamaloba kamatakatifu alaba chimita chielefu chiraano ebukwe, nende chimita chielefu chiraano mumbo. Alaba ario khuloonda kamaloba kamatakatifu. Ano alaba abuundu we bulimi bwe biakhulia khu bakholi be mu lukoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakholi be mu lukoba abo, khukhwama mu kholo choosi cha Isiraeli, bakhalimemo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamaloba niko mukhabaande koosi kakhabe chimita chielefu ekhumi na chibili ne kamakhumi karaano buli lubeka khutekaniilila. Ano aba khwareere alala lubeka lwe kamaloba kamatakatifu ne lubeka lwe lukoba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamaloba kasikala chimbeka chombi che kamaloba kamatakatifu ne abuundu we lukoba kalaba ko muruki. Khukhwamila niio chimita chielefu ekhumi na chibili ne chimia chiraano che kamaloba kamatakatifu chiweela khukhwola khu lwakha lwe bukwe; ne khulola mumbo khukhwamila niio chimita chielefu chibili ne chimia chiraano chiweela khu lwakha lwe mumbo, khuloondekhana ne kamaloba ke chikholo. Abuundu ano alaba wo muruki. Kamaloba kamatakatifu nende abuundu atakatifu akari wako, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende abuundu we Balawi ne lukoba bilaba akari we kamaloba ko muruki. Kamaloba ko muruki kalaba akari we lukoongo lwa Yuda ne lukoongo lwa Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikholo chichiindi: Khukhwamila ebukwe khukhwola mumbo; lubeka olwo lulaba lwe kholo eya Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Benjamini, khukhwama ebukwe khukhwola mumbo; lubeka luno lulaba lwe kholo eya Simioni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Simioni, khukhwama ebukwe khukhwola mumbo; lubeka luno lulaba lwe kholo eya Isakari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Isakari, khukhwama ebukwe khukhwola mumbo; lubeka luno lulaba lwe kholo eya Sebuluni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
