          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Sebuluni, khukhwama ebukwe khukhwola mumbo; lubeka luno lulaba lwe kholo eya Kati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamila khu lukoongo lwe kholo eya Kati siafubo, lulwakha lukhabire khukhwama Tamari khukhwola abuundu we kameechi ka Meriba-kateshi; ne khubira ebukwe wa Misiri lwoole khu nyanja eya Mediterenia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        },
        {
