          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubeka lwe bukwe, luulaba buleeyi chimita chielefu chibili ne chimia chibili ne kamakhumi karaano, bilibwa bitaru. Bino bili silibwa sia Yosefu, silibwa sia Benjamini, ne silibwa sia Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
