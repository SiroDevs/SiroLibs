          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubeka lwe siafubo, luulaba buleeyi chimita chielefu chibili ne chimia chibili ne kamakhumi karaano, bilibwa bitaru. Bino bili silibwa sia Simioni, silibwa sia Isakari, ne silibwa sia Sebuluni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
