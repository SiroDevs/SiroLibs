              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.11"
              },
              "items": [
                {
                  "text": "Lif. 19.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Khu ndaalo eya kharaano eye kumwesi kwe khane kwe kumwiiko kwe kamakhumi kataru",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.1",
            "verseOrgIds": [
              "EZK.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.1",
              "type": "text"
            },
            {
              "text": "kamakhumi kataru:",
              "type": "text"
            },
            {
              "text": "kumwiiko kwe kamakhumi kataru se limanyikhane mwiiko sina nikwo balomakho tawe.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ese Esekieli omusaayi okhwa Busi naba mulala khu baboe be mbaambe eye Bayaudi, naba ndi a luuchi lwa Kebari, mu Babiloni. Nio likulu liekukha mala nabona kamalola ka Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.1",
            "verseOrgIds": [
              "EZK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15+2KI.24.16"
              },
              "items": [
                {
                  "text": "2 Bab. 24.10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.9+2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 36.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khu ndaalo eya kharaano eye kumwesi (kwaba kumwiiko kwa kharaano kwe siboe sie mbaambe sio mwami Yehoyakini) ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.2",
            "verseOrgIds": [
              "EZK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga naba mu Babiloni ambi ne luluuchi lwa Kebari, naulila Wele Omunyali Owa Bioosi ne andomalomakho mala andaakho kumukhono kwewe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ne nalola, nabona embembeesi yama ebunaswa. Lueni lwaburukha khukhwama mwifuumbi liboofu, lwakhosia mu ngaaki ne luchiililila. Nga lueni lwabonekhanga, chinjaso che kumulilo chakhosia mala sisiindu nga kumukasa siabonekhana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.4",
            "verseOrgIds": [
              "EZK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.6"
              },
              "items": [
                {
                  "text": "Lif. 4.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne akari we mbembeesi sisiindu siamamo sifwaana nga bibuumbe bine bie bulamu. Mala biaba bifwaana biri: Biafwaana babaandu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli silala siaba ne bubweeni bune, buli silala siaba ne chindaa chine. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikele biabio bikololofu, ne bikhandakilo biabio biaba nga bikhakayu bie khaafu, mala biang'enang'ena nga kumukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi we chindaa chabio chimbeka chine, biaba ne kamakhono nga ko mundu. Bioosi bine biaba birio, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "chindaa chabio chaba chetilanakho, chapurukhanga bukololofu ne bibuumbe ebio se biayuukhangakho tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "Esek. 10.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Lif. 4.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu moni mwabio, buli silala siaba ne bubweeni nga bwo mundu, Bioosi bine biaba ne lubeka luseecha lwe mu moni mwabio nga mwe talang'i, ne lubeka lukhasi lwafwaana nga mwe uunwa, lundi biafwaana mu moni nga mwe furuusi lubeka lwe nyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu moni mwabio mwaba murio. Biabambula chindaa chabio mu ngaaki, buli sibuumbe siaba ne chindaa chibili, buli lutaa lwetiila khu lutaa lwe sibuumbe sisiindi ne chindaa chibili chafuuma kimibili kiabio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli silala siapurukha bukololofu ebweeni, biachichanga osi osi niye roho eenyanga ne se biekhebukhakho tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akari we bibuumbe bie bulamu siabao sisiindu sifwaana nga kumulilo kwe kamaanda, nga chinjaso ne chiicha eyi ne eyi akari we bibuumbe bilamu. Kumulilo kwaba kwesing'eeng'ile lukali lundi kwarusia chimbeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bibuumbe bilamu ebio bioosi biatima ne bicha eyi ne eyi khangu nga lueni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
