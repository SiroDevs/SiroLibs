              "EZK.1.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.9+EZK.10.10+EZK.10.11+EZK.10.12+EZK.10.13"
              },
              "items": [
                {
                  "text": "Esek. 10.9-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nono nga ne naloleelela bibuumbe bilamu bino, nabona chingara chine siimbi nende buli sibuumbe silamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chingara chine echo chafwaanana, chang'enang'ena nga libaale lie bukusi lilaangwa Sabarachati, chaba chombakhwa nga engara mu kiindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio nga chingara echo ne chatima chacha chimbeka choosi chine ne chikhayuukhakho tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Lif. 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Chingara chine echo chaba ne chingarangarani, ne chingarangarani chaba ne chiwaya, mala chingarangarani echo chaba chechulamo chimoni chimbeka choosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nga bibuumbe bie bulamu biarekukha, chingara echo charekukhila khulala nabio. Ne nga bibuumbe bie bulamu biarura khu sibala bianiina angaaki, aakhaba chingara chosi chaniina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osi osi niio roho eenya khucha biacha, ne chingara charekukhila khulala nabio, sikila roho owe bibuumbe ebio aaba mu ngara echo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli nga bibuumbe ne biarekukhanga, chingara chosi charekukha, buli nga ne biemanga, chosi chema, ne nga bianiina khukhwama khu sibala chingara chosi chaniina alala nabio, sikila roho owe bibuumbe bilamu ebio aaba mu ngara echo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        }
      ]
    },
