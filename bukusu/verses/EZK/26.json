                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khu ndaalo eye khunyoa eye kumwesi, kumwiiko kwe ekhumi na ndala eye khuyilwa khwefwe mu mbaambe; Wele Omunyali owa Bioosi amboolela ali, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana wo mundu sikila Tiro luchekheelela Yerusalemu ne luloma luli,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
