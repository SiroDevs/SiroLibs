              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Omwami WELE aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.3",
            "verseOrgIds": [
              "EZK.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila Omwami WELE aloma ali, “Lola, ese ndareera khu Tiro Nebukadinesa omwami owa Babiloni khukhwama ebunaswa, nende chifarasi nende kamakaari ke liie, nende banamae be khu farasi nende kiminjolooli kie banamae.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako, Omwami WELE aloma khu Tiro ali, “Bibala bie sia nyanja se bilaterema nga ne bilaulila likwa liowo, nga baumiie ne balila, lundi nga khufwa ne khulibao tawe ku? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.15",
            "verseOrgIds": [
              "EZK.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.9+REV.18.10"
              },
              "items": [
                {
                  "text": "Lif. 18.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nono babemeelesi bakhulu be sia nyanja balarura khu ndebe chabwe che bubwami, mala befuule chingubo chabwe che bubwami, ne khukhwifuula chingubo chabwe chichanabwa mu ngila eye lukoosi lukali lwe khuchisaa. Bakhabe mu literema likali, bakhekhale asi mu maloba mala batereme buli siise ne khuuka lukali sikila kakekholeekhe khwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.16",
            "verseOrgIds": [
              "EZK.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhasute kumumilo bakhwimbile kumwenya kwe lisooma bali,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila kamene ako Omwami WELE aloma ali, “Ne khukhola ewe khuuba lukoba luboofu lwanjuukhwe nga lukoba lukhamenywamo tawe, nga khakhusiikhe mu lusiba lwe nyanja, mala kameechi kamakali kakhusiikhe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.19",
            "verseOrgIds": [
              "EZK.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "abwenao khakhumwaate asi emakoombe alala nende abo babeekhayo khale, khakhukhole oche omenye ne nabo mindali mu sibala sie asi mu makubili kakatechukha. Nono omundu se alakhumenyamo tawe, lundi se olaba ne bumenyo mu bibala bie balamu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.20",
            "verseOrgIds": [
              "EZK.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.21"
              },
              "items": [
                {
                  "text": "Lif. 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ese Omwami WELE ndoma ndi, ‘Ndakhureera khu siakamo siriisia mala olafwa, wakhaenjwa se olinyoolwa lundi tawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.21",
            "verseOrgIds": [
              "EZK.26.21"
            ]
          }
        }
      ]
    }
