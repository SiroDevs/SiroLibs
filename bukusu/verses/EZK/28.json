          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi Omwami Wele amboolela ali, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.11",
            "verseOrgIds": [
              "EZK.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana wo mundu lilila butinyu bubwiicha khu mwami owa Tiro, mala omuboolele kano: Omwami WELE aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
      ]
    },
