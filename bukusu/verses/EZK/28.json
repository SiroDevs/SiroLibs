        },
        {
          "text": " Wele Omunyali Owa Bioosi amboolela ali, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.20",
            "verseOrgIds": [
              "EZK.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana wo mundu, suta chimoni chowo olole khu Sidoni mala ong'oole kamabi khu nibo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
            "verseOrgIds": [
              "EZK.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala oboole kano: Omwami WELE aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.22",
            "verseOrgIds": [
              "EZK.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isiraeli ekhabiitwe chikhabi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami WELE aloma ali, “Mbao ekholo mu kholo chichabotookhelela Isiraeli, chichabachekheelelanga chiili nga kamawa ne mbululwe ekhabachuunisie lundi tawe. Mala balimanya bali Ese ndi Omwami WELE.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami WELE aloma ali, “Nga ne khabuusie be nju eya Isiraeli khukhwama mu kholo nicho Ese nabasalanisiamo ne khukhwekesia butakatifu bwase mu nibo ebweeni we chikholo, nono bakhamenye mu sibala siabwe nisio naelesia Yakobo omukholi wase. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakhamenye mu muleembe, mala bombakhe chinju ne khubiaala kimisabibu. Bakhamenye mu muleembe nga ese ne khabe ne ndikho mbisia bukhalaki khwabo boosi ba babachekheelelanga mala Baisiraeli bakhamanye bali Ese ndi Wele Omunyali owa Bioosi, Wele wabwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
      ]
    }
