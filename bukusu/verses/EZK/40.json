            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omundu oyo aandeera mu silibwa sie bunaswa aasipiima buleeyi; siaba busa nga bibiindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
