          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisiro che lubeka, chisiro che buliindi ne chisiro che mukari, chaba busa nga chichiindi, chabaakho kamatirisia buli lubeka ne khu lusiro lwe mukari; buleeyi bwaba chimita kamakhumi kabili na chiraano ne bukhiikha chimita ekhumi na chibili ne nusu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.33",
            "verseOrgIds": [
              "EZK.40.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
