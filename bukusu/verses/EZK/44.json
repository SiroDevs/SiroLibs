                "loc": "NUM.18.20"
              },
              "items": [
                {
                  "text": "Khub. 18.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Basaayi balaba busa ne busaayi nga kumukabwa kwabwe nikwo mbaele mu Isiraeli, khukhwama khu selukho yino khucha khu kiindi. Se balaba ne kumukabwa kwe kimiaandu tawe ese nise kumukabwa kwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balalia biianwa bie biakhulia, biianwa bie bumayaanu, nende bie khukhweyama kamabi na buli siindu siianwa khuuba sitakatifu siikhabe sisiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
              "EZK.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.8+NUM.18.9+NUM.18.10+NUM.18.11+NUM.18.12+NUM.18.13+NUM.18.14+NUM.18.15+NUM.18.16+NUM.18.17+NUM.18.18+NUM.18.19"
              },
              "items": [
                {
                  "text": "Khub. 18.8-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabuli likesa lia buli siindu lie khunyoa, na buli siianwa sia buli siindu, khukhwama mwinywe, bikhabe bie basaayi. Lundi mukhae basaayi siakhulia sie khunyoa nio chikhabi chibe ne nju yenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.30",
            "verseOrgIds": [
              "EZK.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.8"
              },
              "items": [
                {
                  "text": "Bal. 22.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basaayi se bakhalie sisiindu siosi siosi sifwiile ebeele enyuni namwe esaang'i efwiile eng'ene namwe nisio esaang'i yirire tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.31",
            "verseOrgIds": [
              "EZK.44.31"
            ]
          }
        }
      ]
