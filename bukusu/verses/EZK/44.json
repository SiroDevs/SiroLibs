                {
                  "text": "Bal. 10.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Basaayi balasomia babaandu base bubwabukhani bwe sitakatifu ne siikhali tawe. Lundi silayi ne siibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga kamayiingamo kang'ali ne kabao basaayi bakhakhalake khuloondekhana ne kamalaka. Balaloonda naikara eye dini khuloondekhana ne kamalaka mala balaria esabato endakatifu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        }
      ]
    },
