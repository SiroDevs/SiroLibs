          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Burumikhi bwe silibwa sie bukwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omundu oyo aambila khu silibwa sie nje, siaba lubeka lwe bukwe lwe Lukaangu. Silibwa esio siaba sisiikale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.1",
            "verseOrgIds": [
              "EZK.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamboolela ali, “Silibwa sino silarama sisiikale, se silekulibwa tawe, se aliio olabiriramo tawe. Sikila Wele Omunyali Owa Bioosi, Wele owa Isiraeli abiriiremo; khwako silarama sisiikale. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.2",
            "verseOrgIds": [
              "EZK.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami yeng'ene niye oonyala ekhalamo mala aliilamo siakhulia ebweeni wa Wele Omunyali Owa Bioosi. Alengilamo ne khurura mu silibwa siicha mukari.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.3",
            "verseOrgIds": [
              "EZK.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamalaka ke khukhwingila mu Lukaangu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.3",
            "verseOrgIds": [
              "EZK.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omundu oyo ambisilia mu silibwa sie bunaswa ebweeni we Lukaangu; nalola mala nabona luyali lwa Wele Omunyali Owa Bioosi lwechuule Lukaangu lwa Wele Omunyali Owa Bioosi; mala nakwa mafumala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.4",
            "verseOrgIds": [
              "EZK.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele Omunyali Owa Bioosi amboolela ali, “Mwana wo mundu, lola bulayi, bona ne chimoni chowo wamwene, ulila ne kamaru kowo koosi niko nja khu khuboolela khuloondekhana ne bulayi bwabo banyala bafukiililwa mu Lukaangu nende abo bakhafukiililwamo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.5",
            "verseOrgIds": [
              "EZK.44.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.5",
            "verseOrgIds": [
              "EZK.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Boolela babaandu ba Isiraeli be sileka oli, Ese Omwami WELE Omunyali Owa Bioosi, se ndekhaliilikha bibiindu biibi nibio bakholanga ebio tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.6",
            "verseOrgIds": [
              "EZK.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banyaalutiisie Lukaangu lwase khulwe khufukiilila bakeni, babaandu bakhafukiilila Ese tawe, khukhwingila abuundu wase atakatifu; siise nisio balikho baaana khwise siakhulia siase, kiminawa ne kamalasile. Babaandu base, bafunake endakaano yase khulwe khukhola bibiindu biibi bino. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.7",
            "verseOrgIds": [
              "EZK.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se bemeleele kimilimo kimitakatifu kino mu Lukaangu lwase tawe, ne kakhali bafukiliile bakeni khukhwimeelela mu bweyaangu bwabwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.8",
            "verseOrgIds": [
              "EZK.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.8",
            "verseOrgIds": [
              "EZK.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami WELE aloma ali, “Se aliio omundu owe sikeni, osiili khukhebwa namwe okhafukiilila Ese, oolacha mu Lukaangu lwase akhaba ne ali omukeni owamenya mu Baisiraeli tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.9",
            "verseOrgIds": [
              "EZK.44.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Balawi balekhesibwa khuuba mu busaayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.9",
            "verseOrgIds": [
              "EZK.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi amboolela ali, “Ndikho mbaana siuukuumo khu Balawi abo, alala ne babaandu ba Isiraeli ba banjanjukha baacha khukhwinamila bifwaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.10",
            "verseOrgIds": [
              "EZK.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banyala bandumikhira busa mu Lukaangu, khulwe khuliinda bilibwa ne khukhola kimilimo kikiindi kie mu Lukaangu. Banyala beera chisaang'i nicho babaandu bareerire nga chimbosio che khukhwosia, mala khukhwola babe khu milimo khuyeeta babaandu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.11",
            "verseOrgIds": [
              "EZK.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne sikila bemeelela babaandu ba Isiraeli mu khwinamila bifwaani, mala mu ngila yino bayila babaandu mu bumayaanu; Ese Omwami WELE nechuba ndi ndabaelesia siuukuumo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.12",
            "verseOrgIds": [
              "EZK.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se bandumikhira nga basaayi namwe bache embi ne sisiindu siosi siosi siili sitakatifu khwise namwe bache abuundu atakatifu lukali tawe. Sino nisio siuukuumo nisio balanyoola khuloondekhana nende niko bakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.13",
            "verseOrgIds": [
              "EZK.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikho mbaelesia kimilimo mitiiti kino bakholenge mu Lukaangu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.14",
            "verseOrgIds": [
              "EZK.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Basaayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.14",
            "verseOrgIds": [
              "EZK.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami WELE aloma ali, “Ne kakhali basaayi balawi, ba okhwa Satoki, ba baaba babemeelesi mu Lukaangu lwase, siise nisio babaandu ba Isiraeli baba ne banjauukhekho, babenabo balecha mala bandumikhire, mala balaambanila kamafura ne kamalasile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.15",
            "verseOrgIds": [
              "EZK.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balengila mu Lukaangu lwase, mala besende khu mesa yase khukhundumikhira mala balaba babemeelesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.16",
            "verseOrgIds": [
              "EZK.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.39+EXO.28.40+EXO.28.41+EXO.28.42+EXO.28.43"
              },
              "items": [
                {
                  "text": "Khur. 28.39-43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.4"
              },
              "items": [
                {
                  "text": "Bal. 16.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nga bengila mu bilibwa bie khucha mu nja che mukari, bakhafware chingubo cha katani, se bakhabekho ne chingubo che bufuumbo tawe, siise nisio bakhabe ne bakhola kumulimo kuno mu bilibwa bie mu luya lwe mukari nende chili siimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.17",
            "verseOrgIds": [
              "EZK.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhabe ne bilemba bia katani khu mirwe kiabwe ne chisirwari mu bibuno biabwe. Sebaleboa sisiindu siosi siosi sinyala siareera lukesi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.18",
            "verseOrgIds": [
              "EZK.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.23"
              },
              "items": [
                {
                  "text": "Bal. 16.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne bacha enje we luuya niio babaandu bali balafwarura chingubo nicho babele nacho, mala bachire mu siro chindakatifu, mala bafware chingubo chabwe bakhakhola bario barera butinyu khu baandu khubirira khu ngubo chabwe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.19",
            "verseOrgIds": [
              "EZK.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.5"
              },
              "items": [
                {
                  "text": "Bal. 21.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ‘Basaayi se bakhabeke lichuune namwe balekhe lilee tawe. Khukhwola babe ne lichuune likhali lileeyi namwe liliimbi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.9"
              },
              "items": [
                {
                  "text": "Bal. 10.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Basaayi bakhanywakho endali yosi yosi nakhacha mu luuya lwe mukari tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.7"
              },
              "items": [
                {
                  "text": "Bal. 21.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.13+LEV.21.14"
              },
              "items": [
                {
                  "text": "13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omusaayi yesi yesi akhayila omukhasi owalekhana no museecha tawe. Khukhwola ayile omukhaana owe yabwana owe kholo eya Isiraeli namwe namulekhwa wo musaayi.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
            "verseOrgIds": [
              "EZK.44.22"
            ]
          }
        }
