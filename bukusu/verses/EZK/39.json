              "EZK.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.17+REV.19.18"
              },
              "items": [
                {
                  "text": "Lif. 19.17-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Omwami WELE aloma kano: Ne khwiwe mwana wo mundu: Lomaloma khu nyuni chingano choosi ne khu solo che mundaa oli, “Khe mwibuusie alala mala mwiche, khe mwibuusie khukhwama chimbeka choosi khu naikara eye mbosio niyo Ese ndikho murekekhera enywe naikara eye mbosio emboofu khu bikulu bia Isiraeli, mala mulie chinyama ne khunywa kamafuki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balalia chinyama che baafu be bunyali mala munywe kamafuki ke babaami be sibala, boosi bali nga kamamiiku, kamameeme ne chimbusi. Nga chikhaafu boosi bali banefu be Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulalia kiminawa khukhwola nga mwikura; lundi mulanywa kamafuki khukhwola nga mulameelela a naikara eye mbosio niyo Ese ndikho murekekhera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne a sialwa wase mulekura chifarasi ne babaandu bachitimianga, mulekura banaitiriani be kamaani ne banamae chingano choosi. Ese Omwami WELE nalomile”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isiraeli ekhakoboleo nga yaba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami Wele aloma ali, “Ese khare luyali lwase mu kholo choosi, mala chikholo choosi chikhabone likhalaka liase nilio Ese khalake ne busiro bwe kumukhono kwase nikwo mbareerekho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.21",
            "verseOrgIds": [
              "EZK.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baisiraeli balamanya bali Ese ndi Omwami Wele, Wele wabwe khukhwama endaalo eyo ne khuchiililila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.22",
            "verseOrgIds": [
              "EZK.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne chikholo chilamanya chili Baisiraeli bacha mu mbaambe sikila bubwoni bwabwe, sikila baba baabacha khwise nio nekisa bakhambona tawe, mala nabara mu makhono ke basiku babwe mala boosi beerwa ne mbalu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.23",
            "verseOrgIds": [
              "EZK.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabakhola khuloondekhana ne sifwabi siabwe ne bubwoni bwabwe mala nekisa bakhambona tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
