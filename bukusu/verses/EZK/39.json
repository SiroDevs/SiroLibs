              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami WELE aloma ali, “Luno ndakobosia lisaaye lia Yakobo ne khukholela siisa Baisiraeli mala ndaba ne siikhalikhali sikila lisina liase litakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.25",
            "verseOrgIds": [
              "EZK.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhebilile chisoni chabwe ne bubacha bwabwe bwoosi nibwo bakholela Ese nga ne baliba ne bamenyile mu muleembe mu sibala siabwe ne bakhali no mundu yesi yesi oobariikhirisia tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.26",
            "verseOrgIds": [
              "EZK.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Ese ne ndiba ne mbakoboosie khukhwama mu kholo choosi ne khubabuusia khukhwama mu bibala bie basiku babwe; ne khubirira mu nibo, nekesie butakatifu bwase ebweeni we chikholo chingali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.27",
            "verseOrgIds": [
              "EZK.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio babaandu base balamanya bali Ese ndi Omwami Wele, Wele wabwe, sikila nabayila mu mbaambe mu chikholo, lundi nababuusia mu sibala siabwe babeene. Se khalekhe yesi yesi khu nibo arame mu kholo echo lundi tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.28",
            "verseOrgIds": [
              "EZK.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami WELE aloma ali, “Ne se khekise lundi khukhwama khu nibo tawe, nga ne khachukhe roho wase khu Baisiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.29",
            "verseOrgIds": [
              "EZK.39.29"
            ]
          }
        }
      ]
