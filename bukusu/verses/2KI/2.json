          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha akobosia ali, “Ee namanyile. Ne kakhali khukhakalomalomakho tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
