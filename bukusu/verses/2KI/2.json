          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sipupu sie bang'oosi ba baamenya e Yeriko bacha khu Elisha mala siamureeba sili, “Ewe wamanyile oli luno Wele Omunyali Owa Bioosi alakhubukula omwami wowo?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
