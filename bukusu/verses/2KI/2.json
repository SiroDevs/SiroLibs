          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha ama ao achiililila ola khu sikulu sia Karimeli, mala akobola e Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
