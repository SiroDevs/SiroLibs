        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi omwami aruma omunamae okundi omukhulu ne banamae kamakhumi karaano. Acha mala aboolela Elicha ali, Mundu wa Wele, omwami aloma ali, “Yiikha asi khangu.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
