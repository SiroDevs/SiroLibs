          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali Elicha akobosia ali, “Ese naaba ne endi omundu owa Wele, lekha kumulilo kwikhe asi khukhwama mwikulu mala kukhwosie ewe ne babaandu bowo.” Nio kumulilo kwekha asi khukhwama mwikulu mala kwosia omunamae omukhulu oyo ne banamae bewe kamakhumi karaano.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 1:12"
          },
          "items": [
