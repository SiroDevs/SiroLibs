            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami abareeba ali, “Omundu owichile amwakaanana enywe oyo mala amuboolela bibiindu bino abeele omundu owa lukano siina?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        }
      ]
    },
