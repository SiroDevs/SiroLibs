            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.8",
              "type": "text"
            },
            {
              "text": "efwarire:",
              "type": "text"
            },
            {
              "text": "abeele efwarire . . . namwe aba omundu we kamaswa mala aaba efwarire.",
              "type": "text"
            }
          ]
        },
        {
          "text": " engubo eye bufuumbo, mala eboele kumusiipi munda.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
