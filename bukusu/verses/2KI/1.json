              "2KI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi omwami aruma omunamae omukhulu owe khataru ne banamae kamakhumi karaano. Aniina khu lukulu, mala acha asikama asi ebweeni wa Elicha ne amwikoonjelela ali, “Ee mundu wa Wele, ekhusaba ndi lekha bulamu bwase ne bulamu bwe bakholi bowo kamakhumi karaano bano bube ne bukhala ebweeni wowo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.13",
            "verseOrgIds": [
              "2KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumulilo kwamile mwikulu kwosia banamae bakhulu babili bataayi be babaandu kamakhumi karaano ne babaandu babwe boosi. Ne kakhali luno kholele siisa.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.14",
            "verseOrgIds": [
              "2KI.1.14"
            ]
          }
        }
      ]
    },
    {
