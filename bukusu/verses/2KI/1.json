              "type": "text"
            }
          ]
        },
        {
          "text": " Bamukobosia bali, “Abeele efwarire",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
