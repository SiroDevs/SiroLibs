                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Liie liliindi ne Bafilisiti liabao. Mala Elihanani okhwa Yairi eera Lahimi wandaaye owa Koliati khukhwama Katihi. Kumusaala kwe lifumo liewe kwaba nga kumusaala kwo muruki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
