                "loc": "2SA.11.1"
              },
              "items": [
                {
                  "text": "2 Sam. 11.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mukhurakikha khwe kumwiiko mu biise nibio babaami buli lwosi bachilangakho mwiie, Yoabu aarangirira banamae mala ebwaakala sibala sia Amoni. Babotookhelela lukoba lwa Raba, balwibwaakala, mala balubunia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.1",
            "verseOrgIds": [
              "1CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi arusia ekutwa eye bubwami khumurwe kwo mwami wabwe mala akiefwara. Yaba busiro bwe chikiilo embi kamakhumi kataru na chine. Ekuutwa eyo yaba yakholwa khu sahabu ne mukari mwayo abeele baramo kamabaale ke bukusi bwe angaaki. Daudi lundi ayaya bibiindu bikali khukhwama mu lukoba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.2",
            "verseOrgIds": [
              "1CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi abukula babaandu be mu lukoba mala abara khu milimo kie khukholela kimisiameno ne chiaywa ne chiuma che bichuuma. Daudi akholela ario babaandu be chingoba chichiindi choosi cha Amoni. Nono niye ne babaandu bewe bakobola e Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamae khu Bafilisiti baboofu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma wa kano, liie liarakikha lundi ne Bafilisiti e Keseri. Nio Sibekayi Omuhushati eera Sipayi. Aaba mulala khu lisaaye lie babaandu baboofu. Ne bafilisiti bakhilwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
