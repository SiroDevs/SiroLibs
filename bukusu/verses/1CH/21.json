            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami Daudi aakobosia Onani ali, “Tawe, ndabikula bioosi khu bukusi bubwenyekhana. Se nyala naana sisiindu siosi siosi khu Wele Omunyali Owa Bioosi nga siianwa siili sisiowo tawe, lundi se enyala nabukula sisiindu nisio ese kharuungire siosi siosi tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.24",
            "verseOrgIds": [
              "1CH.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Daudi aruunga Onani bitonyi chimia sita che esahabu khulwe abuundu ao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Daudi ombakhila Wele Omunyali Owa Bioosi alutare mala aana biianwa bie khukhwosia ne biianwa bie kumuleembe. Asaba Wele Omunyali Owa Bioosi, mala Wele Omunyali Owa Bioosi amukobosia khulwe khuruma kumulilo khukhwama mwikulu khu alutare eye biianwa bie khukhwosia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
