                  "text": "28.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Saulo aafwa sikila se aaba omusuubilwa tawe. Se aaba omusuubilwa khu Wele Omunyali Owa Bioosi tawe, sikila se aaria lilaka lia Wele Omunyali Owa Bioosi tawe. Ne lundi acha bulakusi anyoole likhuwa limuyeeta, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne se ayima buyeeti khukhwama khu Wele Omunyali Owa Bioosi tawe. Khwako Wele Omunyali Owa Bioosi amwiira mala aelesia Daudi okhwa Chesi bubwami.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
