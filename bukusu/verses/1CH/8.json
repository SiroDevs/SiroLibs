          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beria ne Shema baba babemeelesi be babaandu babengisia mu lukoba lwa Aiyaloni mala baoona babamenyanga mu lukoba lwa Katihi baruramo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.13",
            "verseOrgIds": [
              "1CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaana ba Beria baba Ahio, Shashaki, Yeremoti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.14",
            "verseOrgIds": [
              "1CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sebatia, Arati, Eteri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.15",
            "verseOrgIds": [
              "1CH.8.15"
            ]
          }
        },
