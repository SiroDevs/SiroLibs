          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khutasa khwako Daudi afwara engubo eya efodi. Bareera endakaano eya Wele Omunyali Owa Bioosi ne luyoka lukali lwe liliekhoya, ne chikhoombi, ne bibiindu bie khu khuupania alala mu mienya, ne kimienya kie kamatuungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        }
