                }
              ]
            }
          ]
        },
        {
          "text": " Ekanisa yasenywe eli mu Babiloni, yosi eyaroborwa ne Wele, yamurumiire enywe kimileembe, ne akhaba omwana wase Mariko yesi amukhesiisie. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khesiana buli sia mulala ne khukhwekhoyanila mu busiime bwe bukristo. Kumuleembe kukhoyeele kube ne nanywe muli ba Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
