                "loc": "ACT.15.40"
              },
              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Namuandikiile enywe ebarwa enyiimbi yino ne buyeeti bwa Sila, niye mbukula nga wandaayase omukristo omusuubilwa. Nenya mutase enywe kumwoyo mala mbane buloli bwase ndi kuno kuli kumwalaalo kwa Wele kwa ng'ali, khe mweandalasie alala.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        }
