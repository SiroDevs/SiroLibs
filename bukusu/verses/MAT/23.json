                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Bal. 27.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Muli ne silaamo baandiki ne Bafarisayo, enywe babacha! Sikila muaana khu Wele sikelo silala khwi khumi sie bibiindu nga chinyenyi ne biiunya bulayi, ne binjari ne tania ne kakhali mulekelesia kamakhuwa ke lilaka kamasiro khukhilakho nga bung'ali ne siisa ne busuubilwa; mukhoya mukhole bino, ne mukhalekelesia kakaandi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakeleki babofu enywe! Muli nga babaandu batiing'a eesi ne mala bamila engamia!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muli ne silaamo enywe baandiki ne Bafarisayo, enywe babacha! Sikila musiinga sikoombe ne sahani enje, ne mukari biechulemo bunuuli ne bukhalukha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enywe bafarisayo babofu! Nyoa musiinge sikoombe ne sahani bimiliie mukari, nio enje yosi ebe emiliiu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        },
        {
