              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusoleeli chana amukobosia ali, “Kamalaka kano koosi naloonda, siina nisio mbombelelwa?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        }
