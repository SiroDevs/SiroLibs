          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu asuta chimoni abalola mala ababoolela ali, “Khu baandu kano se kali kanyalikha tawe, ne kakhali khu Wele bibiindu bioosi bili binyalikha.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        }
