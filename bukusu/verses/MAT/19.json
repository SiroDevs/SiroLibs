          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amuboolela ali, “Ne wenya khuba owolaana, cha okusie bioosi nibio oli nabio mala oeleesie bataambi chirupia, mala wiche unondekho ne olanyoola buiinda mwikulu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        }
      ]
