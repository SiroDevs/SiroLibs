              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Petero aakobosia ali, “Lola khwalekha bibiindu bioosi, mala khwakhuloondakho. Khukhanyoole siina?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
