                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Yn. 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lundi yesi yesi owenya khuonia bulamu bwewe alibutibia, ne yesi yesi otibia bulamu bwewe sikila ese alibunyoola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu anyoola bukhala siina, aaba bali anyoola sibala sioosi mala atibie bulamu bwewe? Se anyoolamo siindu tawe! Se siliio nisio anyala aana khunyoola bulamu bwewe lundi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.31"
              },
              "items": [
                {
                  "text": "Mat. 25.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.62.12"
              },
              "items": [
                {
                  "text": "Chiny. 62.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.6"
              },
              "items": [
                {
                  "text": "Bar. 2.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omwana wo Mundu akheeche ne malaika bewe mu luyali lwa Raraawe, mala aruunge buli mundu khuloondekhana ne bikholwa biewe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ali ese muboolela enywe ndi, bali ano balala se bakhachanjamekho lifwa ne bakhaabona Omwana wo Mundu ne echa mu Bwami bwewe tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.28",
            "verseOrgIds": [
              "MAT.16.28"
            ]
          }
        }
