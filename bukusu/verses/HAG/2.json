          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.19",
            "verseOrgIds": [
              "HAG.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HAG 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu ndaalo ng'ene eyo, kumwesi okwo ne kuli kamakhumi kabili na chine, Wele Omunyali Owa Bioosi aboolela Hagai burume bwe khabili, ",
          "type": "text",
