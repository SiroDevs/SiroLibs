              "GAL.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Likh. 21.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mu khuba silaamo khwifwe, Kristo akhusikula efwe khukhwama khu silaamo nisio Lilaka lireranga; sikila liiandiko liloma lili, “Yesi yesi osuungwa khu murongooro ali ne silaamo khukhwama khu Wele.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristo akhola kano nio chikhabi nicho Wele asuubisia khu Aburahamu chiaanwe khu Be Chikholo khubirira mu Kristo Yesu, nio khubirira mu lisuubila khwole khunyoola Roho niye Wele asuubisia khuruma.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lilaka ne lisuubisia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawandaayase enywe, ndikho nja khurumikhira silolelo sia buli ndaalo. Babaandu babili ne bafukiilisiana khwikhuwa mala baandikisiana, se aliio onyala alifunaka namwe atasakho siindu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.15",
            "verseOrgIds": [
              "GAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.7"
              },
              "items": [
                {
                  "text": "Lir. 12.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nono, Wele asuubisia Aburahamu nende owe lisaaye liewe. Liiandiko se lirumikhira mu bukali lili, “Be lisaaye,” tawe, ne kakhali lili mu bulala lili, “Oyo owe lisaaye liewe,” khukhwekesia khuli ali omundu mulala yeng'ene, olaangwa Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.16",
            "verseOrgIds": [
              "GAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Khur. 12.40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nilio ndikho ndoma lili liri, Wele aakhola endakaano ne Aburahamu mala aasuubisia khukikhola. Lilaka liliaanwa enyuma we kimiiko chimia chine ne kamakhumi kataru se linyala liafunaka endakaano eyo ne khurusiao lisuubisia lia Wele tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.17",
            "verseOrgIds": [
              "GAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.14"
              },
              "items": [
                {
                  "text": "Bar. 4.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kaaba bali siianwa sia Wele siamanana ne Lilaka, aba se siamanana ne lisuubisia lia Wele tawe. Kakhaba kario, khulwe lisuubisia liewe, Wele aelesia Aburahamu siianwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        }
      ]
    },
