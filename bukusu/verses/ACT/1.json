              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako bebaasia khu baandu babili: Yosefu, niye balanganga bali Barisaba (lundi amanyikhana bali Yusito), ne Matiasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala basaba Omwami bali, “Omwami, ewe omanyile kamebaasio ka buli mundu, nono, khwekesie mulala khu babili bano niye ewe oroboore ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
