            }
          ]
        },
        {
          "text": " Khu mukoosi Teofilo:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.1",
            "verseOrgIds": [
              "ACT.1.1"
            ]
          }
        }
      ]
