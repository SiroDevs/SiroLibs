          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala baapa chikura, khu babili, nio Matiasi aroborwa atasibwa khu barumwa ekhumi na mulala.",
          "type": "text",
          "attrs": {
