          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu boosi ba bamenya mu Yerusalemu baulila kakekholekha, nio kumukuunda okwo mu lulimi lwabwe bakulanga bali Akelitama, liboola lili, “Kumukuunda kwe sifuki.”)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
