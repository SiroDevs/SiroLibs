                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.2"
              },
              "items": [
                {
                  "text": "Sak. 3.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.7"
              },
              "items": [
                {
                  "text": "Lif. 21.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akhaba malaika omukhulu Mikaili se akhola kano tawe. Mukhulomaloma khwewe ne Sietani, nga bayinganilanga khu mubili kwa Musa, Mikaili se aakhalakila Sietani khu mukhoma tawe, ne kakhali aloma ali, “Wele omwene akhurafwire!” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JUD 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali babaandu bano beela mu khukhoma sisiindu siosi siosi nisio bakhamanyile tawe; ne bibiindu nibio bamanyile mu ngila eye kumwiima, nga eye chisaang'i che mundaa, bino nibio bibiindu bibieene bibabunia. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JUD 1:11"
