        },
        {
          "text": " Enoka owaba owe selukho ekhola saba khukhwama khu Adamu, ang'oola khaale kano khu nibo ali, “Rekeeresia! Omwami akheeche ne malaika bewe batakatifu chielefu, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.14",
            "verseOrgIds": [
              "JUD.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JUD 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "khukhalakila babaandu boosi, ne khuukuuma boosi khulwe bikholwa biikhali bie buwele nibio bakhola lundi khulwe kamakhuwa kamabi koosi niko babaandu bakhamanyile Wele tawe balomaloma khuloondekhana naye!”",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.15",
            "verseOrgIds": [
              "JUD.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
