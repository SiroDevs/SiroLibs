          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "yulakho balala, mubaonie khukhwama mu mulilo; ne khu baandi bakhoolele siisa ne buuri, ne kakhali biila chingubo chabwe chilikho kamarokondo ke liliekoomba liabwe lie bubwoni.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.23",
