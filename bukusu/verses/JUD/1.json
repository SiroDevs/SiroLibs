            "number": "16",
            "style": "v",
            "sid": "JUD 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu bano busiele belung'unya ne khubiiya babaandi. Baloonda liliekoomba liabwe libi embakha yabwe eye khukhwebonia ne khukhwalisia lulimi khu baandi, nio banyoole nisio benya.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likaambila ne kamekisio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
