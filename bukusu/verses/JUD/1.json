          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali enywe, basaale base khebulila niko mwaboolelwa khaale ne barumwa bo Mwami wefwe Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JUD 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
