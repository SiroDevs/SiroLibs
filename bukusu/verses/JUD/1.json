        },
        {
          "text": "Khuyo onyala khumuliinda enywe nio mukhakwa tawe ne khumureera enywe mu buluungi ne khukhwikhoyela ebweeni we khubao khwewe khwe luyali ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.24",
