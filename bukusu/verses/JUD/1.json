                "loc": "2PE.3.3"
              },
              "items": [
                {
                  "text": "2 Pet. 3.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bamuboolela enywe bali, “Nga chindaalo chimaliilisi ne chiliola, babaandu baliicha bali mukholela enywe sienya meno, babaandu baloonda liliekoomba liabwe likhali lie buwele tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
              "JUD.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JUD 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo babaandu bareera liliabukhana, baloonda busa liliekoomba lie kimibili kiabwe, bakhali ne Roho tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.19",
            "verseOrgIds": [
              "JUD.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JUD 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali enywe, basaale base, khemuchiililile khukhwiyombakha mu lisuubila litakatifu lukali. Khemusabile mu bunyali bwa Roho Omutakatifu, ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.20",
            "verseOrgIds": [
              "JUD.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JUD 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "lundi mwebikhe mu busiime bwa Wele, nga ne mu silindiilila Omwami wefwe Yesu Kristo mu siisa siewe amuelesie enywe bulamu bwa mindali.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.21",
            "verseOrgIds": [
              "JUD.1.21"
            ]
          }
        }
