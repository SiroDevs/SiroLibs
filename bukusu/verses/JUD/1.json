          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwaabo nibo Wele aalanga, bamenyile mu busiime bwa Paapa Wele ne mu buliindi bwa Yesu Kristo:",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
            "verseOrgIds": [
              "JUD.1.1"
            ]
          }
        }
      ]
