            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet. 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omwene eaana sikila efwe, khu khuonia efwe khukhwama mu mabi koosi ne khu khukhola efwe khube bakwalaafu, babaandu baali babewe yeng'ene, lundi bali ne silukuluku sie khukhola kamalayi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
      ]
    },
