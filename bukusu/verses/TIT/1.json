                "loc": "2CO.8.23"
              },
              "items": [
                {
                  "text": "2 Bakor. 8.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.3"
              },
              "items": [
                {
                  "text": "Bakal. 2.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.10"
              },
              "items": [
                {
                  "text": "2 Tim. 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndikho mbandika ebarwa yino khu Tito omwana wase ng'ali mu lisuubila nilio khulimo naye.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Paapa ne Yesu Kristo Omuonia wefwe bakhoya bakhuelesie kumwalaalo ne kumuleembe.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kimilimo kia Tito mu Kurete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhulekha mu Kurete, nio ong'oone bibiindu bibienyekha khung'oonwa, ne khurobora babemeelesi be kanisa mu buli lukoba. Khebulila niko nakhuboolela. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.5",
            "verseOrgIds": [
              "TIT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.2+1TI.3.3+1TI.3.4+1TI.3.5+1TI.3.6+1TI.3.7"
              },
              "items": [
                {
                  "text": "1 Tim. 3.2-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omwimeelesi akhaba omundu obiiywakho khu liosi liosi tawe, akhoya abe no mukhasi mulala yeng'ene ne babaana babasuubila mu Wele ne bakhaba ne fuma eye siyubuyubu namwe babe be sileka tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.6",
            "verseOrgIds": [
              "TIT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila omwimeelesi owe kanisa ali omuliindi owe kimilimo kia Wele, se akhoyela aabiiywakho khu siindu siosi siosi tawe, akhaba omiinyakilisia babaandi namwe oambwa lirima bwangu, namwe omumeesi, namwe owe sisiayuumba, namwe owe kumuluungo kwe chirupia tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwola abe owakaanila bakeni lundi osiima lili lilayi. Akhoya abe omundu owifwiilisia, omuluungi, omutakatifu, lundi owe kimiima kimilayi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhoya atiile lukali elomo enyala khusuubilwa lundi efukiilisiana ne kamekisio. Mu ngila yino akhanyale khura kumwoyo mu baandu babaandi khubirira mu mekisio ka ng'ali ne khukhwekesia kamakhiikha kaabo bakhakafukiilila tawe.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila baliio bakali, ne lukali abo babaamile mu dini eye Bayaudi, balalobanga kamekisio ne babea babaandi mu makhuwa kabwe ka busa. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.10",
            "verseOrgIds": [
              "TIT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwenyekha khwimikhe chilomo chabwe, sikila balikho bonaka chingoba khubirira mu khwekisia niko bakhakhoyela bekisie tawe, mala kano koosi khulwe sifuno sie chisoni sie khukhwenya khunyoola chirupia. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
            "verseOrgIds": [
              "TIT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aabao Omukurete omwene, mulala khu bang'oosi babwe, owaloma ka ng'ali ali, “Bakurete buli lwoosi bali babeeyi, bali chisolo chimayaanu, lundi bali bakara lundi be kumuliuliu.” ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.12",
            "verseOrgIds": [
              "TIT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila sifuno sino ewe okhoya obarafwire lukali, nio babe ne lisuubila lia nabalamu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.13",
            "verseOrgIds": [
              "TIT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.13",
            "verseOrgIds": [
              "TIT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakhachiililila khuloonda chingano che Siyuda ne kamalaka ke babaandu kakaama khu baandu ba baloba bung'ali tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.14",
            "verseOrgIds": [
              "TIT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli siindu sili sikwalaafu khwaabo baali bakwalaafu; ne kakhali sikwalaafu se siliio khwaabo bali banyaalu lundi bakhasuubila tawe. Sikila kamebaasio ne liiba liabwe bianyaalutiikhe. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.15",
            "verseOrgIds": [
              "TIT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "TIT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baloma bali bamanyile Wele, ne kakhali bikholwa biabwe bikaania. Bali be sikhoonde lundi be sileka, se bolaana khukhola sisiindu siosi siosi silayi tawe.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.16",
            "verseOrgIds": [
              "TIT.1.16"
            ]
          }
        }
      ]
    }
  ],
