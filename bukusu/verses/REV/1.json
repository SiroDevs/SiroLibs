              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lola, alikho echela mu maleesi! Buli mundu alamubona, bakhaba abo ba bamuunanga. Babaandu boosi khu sibala bakhalile ne khukhwiunamila. Mala kaliba kario.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
