                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bikele biewe biang'enang'ena nga kumukasa nikwo boselia mu mulilo baapilila ne khumiuusia, ne kumumilo kwewe kwauliilikha nga kameechi ke mwikhupo ne kaoloola. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asuta angaaki ching'enieesi saba mu mukhono kwewe kumuseecha, ne mbalu enjoki chimbeka chombi yama mukhanwa mwewe. Bubweeni bwewe bwakhosia nga enyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
