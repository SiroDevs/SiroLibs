                  "text": "Lif. 4.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kimileembe khukhwama khu Yoana kicha khu chikanisa saba mu sibala sia Esia:",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
