          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakhusiima efwe, ne khulwe lifwa lie khukhwerusia aakhuonia efwe khukhwama mu bwoni bwefwe; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
