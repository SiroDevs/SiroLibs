              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekhebukha mbone olikho oolomaloma khwise, mala nabona biteetwe bie chitaa saba bie sahabu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan. 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.5"
              },
              "items": [
                {
                  "text": "10.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ne akari wabio aabao mulala ofwaana nga Omwana wo mundu afwarire ekaanjo endeeyi eyoola aasi khu bikhandakilo biewe, lundi aaba eboyile kumusiipi kwe sahabu khu sifuba siewe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
              "items": [
                {
                  "text": "Dan. 7.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.6"
              },
              "items": [
                {
                  "text": "10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lichuune liewe liaba liwaanga chwe nga bufuumbo buwaanga, ne chimoni chewe chaba nga chinjaso che kumulilo; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
