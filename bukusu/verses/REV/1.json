                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Lif. 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mala aakhukhola efwe khuba basaayi khukhalabanila Wele wewe ooli Paapa wewe. Luyali ne bunyali bibe khu Yesu Kristo mindali na mindali! Amina.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
