                  "text": "Lif. 22.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omwami Wele Omunyali Owa Bioosi, aloma ali, “Ese we khunyoa lundi omumaliilisi,” oliio, owabaao lundi okheeche.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
