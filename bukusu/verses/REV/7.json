                "loc": "MAT.24.21"
              },
              "items": [
                {
                  "text": "Mat. 24.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.19"
              },
              "items": [
                {
                  "text": "Mk. 13.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Namukobosia ndi, “Omwami, se manya tawe. Ewe niwe omanyile.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amboolela ali, “Bano bali babaandu baonile khubirira mu khupisibwa siibi. Basiinga chingubo chabwe mu malasile ke Limeeme. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kakila ne bema ebweeni we Ndebe eya Wele ne khumukholela niye siilo ne kumuusi mu Lukaangu lwewe. Khubao khwoyo owikhalanga khu Ndebe eye bubwami khulabaliinda. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.10"
              },
              "items": [
                {
                  "text": "Isa. 49.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Se baliiulilakho enjala namwe bulesia namwe enyanga namwe bukhafu bwosi bwosi se bulibosia tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 7:17"
          },
          "items": [
