              "items": [
                {
                  "text": "Isa. 49.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "25.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " sikila Limeeme liili akari we Ndebe eye bubwami, lilaba omwaayi wabwe, ne alabarangirira abayile a sebele che kameechi kaananga bulamu. Mala Wele alabeeya kamasika mumoni mwabwe.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.17",
