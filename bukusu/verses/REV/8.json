              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio malaika saba be chikhoombi saba berekekha khuchipa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
