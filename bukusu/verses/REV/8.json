              "items": [
                {
                  "text": "16.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio malaika chana abukula sibuumba sie khukhwoseliakho biiunya kumuuya kumulayi, echusiakho kamaanda ke kumulilo khukhwama khu alutare, mala akachukha khu sibala. Likukuma, libalukha, chimbeni ne literema lie sibala biabao.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
