            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nio, malaika okhola khataru apa ekhoombi yewe. Eng'enieesi emboofu, eyaburukha nga enjaso, yakwa khukhwama mu ngaaki mala yakwa khu sitonyi silala khu bitaru sie chinjichi ne chisebele che kameechi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.14"
              },
              "items": [
                {
                  "text": "Yer. 9.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (Lisina lie eng'enieesi chana bali, “Bululu”) sitonyi silala khu bitaru sie kameechi siakaluukhana siekela silulu, mala babaandu bakali bafwa sikila banywa kameechi, kakalukhaane kekela kamalulu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
