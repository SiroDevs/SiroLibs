                  "text": "Esek. 38.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Malaika owe khunyoa apa ekhoombi yewe. Kamaarara, ne kumulilo, bitubanisiibwe ne kamafuki, biachukhwa khu sibala. Sitonyi silala khu bitaru sie sibala siosibwa, sitonyi silala khu bitaru sie kimirongooro siosibwa ne buli lunyaasi lwaya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
