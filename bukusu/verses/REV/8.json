          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika okhola khabili apa ekhoombi yewe. Sisiindu sisiafwaana nga sikulu siboofu silikho ne siyia siamwaatwa mu nyanja. Sitonyi silala khu bitaru sie nyanja siakaluukhana siekela kamafuki, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "sitonyi silala khu bitaru sie bibuumbe bilamu bie mu nyanja biafwa, ne sitonyi silala khu bitaru sie chimeeli chonakwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
