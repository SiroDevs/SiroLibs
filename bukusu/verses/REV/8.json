          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio, nalola, mala naulila efuruusi eyaba ne purukha mu ngaaki tibotibo, yaloma mu mumilo kumuboofu eli, “Engunyi! Engunyi! Engunyi khwaabo abo boosi bamenyile khu sibala nga bakhaulile khu khupwa khwe chikhoombi nicho malaika babaandi bataru khukhwola bape!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
