              "items": [
                {
                  "text": "Lif. 3.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Rekeeresia! Ndikho nicha nga omwifwi! Oyo orama meso naliinda chingubo chewe, nio akhakhola ario aakeenda sichula ne khuambwa chisoni mu baandu tawe aabiitwa chikhabi!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
