              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.4"
              },
              "items": [
                {
                  "text": "Isa. 11.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio nabona likulu liekuukhe, mwikulu omwo yabamo efarasi ewaanga. Okitimia lisina liewe bali omusuubilwa lundi owa Ng'ali, mu buluungi akhalaka lundi apana liie liewe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.6"
              },
              "items": [
                {
                  "text": "Dan. 10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Chimoni chewe chaba nga lumemu lwe kumulilo, mala aafwara chikuutwa chingali khu murwe kwewe. Aandikwakho lisina, ne se aliio omanyile sifuno sialio tawe, nakhali omwene yeng'ene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.12",
            "verseOrgIds": [
              "REV.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaanjo niyo efwara yaba yenikhwa mu mafuki. Lisina liewe bali, “Elomo eya Wele.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.13",
            "verseOrgIds": [
              "REV.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banamae be liie be mwikulu bamuloondakho, ne batimia chifarasi chiwaanga, baba befwarire chingubo cha katani chiwaanga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.14",
            "verseOrgIds": [
              "REV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.9"
              },
              "items": [
                {
                  "text": "Chiny. 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.3"
              },
              "items": [
                {
                  "text": "Isa. 63.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yoe. 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.20"
              },
              "items": [
                {
                  "text": "Lif. 14.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Embalu enjoki niyo akhaulile chikholo yaba mukhanwa mwewe. Alibarukira esiimbo eye sichuuma, lundi aliswalakilila endali mu sisuuriro sie lirima lirafu lia Wele Owe Bunyali Bwoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu ngubo yewe, ne khwiraango khwewe lisina liaandikwakho: “Omwami owe babaami lundi Omuruki we baruki.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
