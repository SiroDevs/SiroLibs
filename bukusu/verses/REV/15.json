              "items": [
                {
                  "text": "2 Ke Ch. 5.13-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.4"
              },
              "items": [
                {
                  "text": "Isa. 6.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lukaangu lwechula liliisi khukhwama khu luyali ne bunyali bwa Wele, ne se aliio owanyala khukhwingila mu lukaangu chana olwo tawe khukhwola nga lufu saba lulwareerwa ne malaika saba olwo lwawa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
            "verseOrgIds": [
              "REV.15.8"
            ]
          }
        }
