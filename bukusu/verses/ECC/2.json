        },
        {
          "text": " Mbao sisiindu silayi siikhila omundu khulia ne khunywa, ne khukhwikhoyela kumulimo kwewe tawe. Lino liosi, nalibona ndi liama khu Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.24",
            "verseOrgIds": [
              "ECC.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
