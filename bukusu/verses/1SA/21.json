                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.2.25+MRK.2.26"
              },
              "items": [
                {
                  "text": "Mk. 2.25-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.3"
              },
              "items": [
                {
                  "text": "Lk. 6.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi acha khu musaayi Ahimeleki mu Nobu. Ahimeleki acha khukhwakaanana ne Daudi ne alikho areenga. Ahimeleki areeba Daudi ali, “Siina sikila ne oli weng'ene?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akobosia Ahimeleki omusaayi ali, “Omwami andumire ne likhuwa. Amboleele ali, ‘Omundu akhamanyakho nisio ekhuruma khukhola namwe nisio ekhuboleele tawe.’ Nalakile basoleeli baele niio khwakaananila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.2",
            "verseOrgIds": [
              "1SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono, ewe oli ne siina? Mbelesie kimikaati kiraano namwe sisiindu siosi siosi nisio oli ne nasio.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.3",
            "verseOrgIds": [
              "1SA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.3",
            "verseOrgIds": [
              "1SA.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Omusaayi aboolela Daudi ali, “Ese se ndi ne kimikaati kia buli lwoosi busa tawe, ne kakhali ndi ne kimikaati kimitakatifu. Munyala mwalia kaaba bali basoleeli bowo baele se babelekho ne bakhasi tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.4",
            "verseOrgIds": [
              "1SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.4",
            "verseOrgIds": [
              "1SA.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi akobosia ali, “Ng'ali bakhasi se babeele siimbi ne nafwe nga buli lwosi tawe. Bibiindu bie babaandu base bibechanga bitakatifu, akhaba ne khucha lukeendo lwosi lwosi. Ne luno bili bitakatifu khukhila sikila khuli khu lukeendo lutakatifu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.5",
            "verseOrgIds": [
              "1SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5+LEV.24.6+LEV.24.7+LEV.24.8+LEV.24.9"
              },
              "items": [
                {
                  "text": "Bal. 24.5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio omusaayi aelesia Daudi kimikaati kimitakatifu sikila kimikaati kikiindi se kiabao tawe ne kikhali kimikaati kie khubao. Buli lwosi nga kimikaati kimitakatifu kiarusibwangao, kimikaati kimitakatifu kiili kimibile kiakalusibwangao.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono mulalakho khu bakholi ba Saulo abao endaalo ng'ene eyo. Aba ali mu siboe sia Wele Omunyali Owa Bioosi. Lisina liewe liaba bali Doegi Omuedomu. Aba omwaayi omukhulu owa Saulo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
            "verseOrgIds": [
              "1SA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
            "verseOrgIds": [
              "1SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi areeba Ahimeleki ali, “Ewe oli ano ne lifumo namwe embalu? Kimilimo kio mwami kibeele kia khangu mala kiakila ese khubukula embalu namwe bulwaani tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.8",
            "verseOrgIds": [
              "1SA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.8",
            "verseOrgIds": [
              "1SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.51"
              },
              "items": [
                {
                  "text": "1 Sam. 17.51",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne omusaayi Ahimeleki akobosia Daudi ali, “Embalu eya Koliati omufilisiti, niye ewe werera mu Litooma lia Ela niiyo eliio. Eli enyuma wa efodi. Waaba ne onyala wakibukula, bukula. Sikila sisiindu sisiindi mbao ne ekhali eng'ene eyo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi amuboolela ali, “Se alikhoo ekiindi nga eyo tawe. Mbelesie.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi arekukha, elukha Saulo, mala acha khu Akishi omwami owa Katihi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.7"
              },
              "items": [
                {
                  "text": "1 Sam. 18.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.29.5"
              },
              "items": [
                {
                  "text": "29.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne bakholi ba Akishi bareeba bali, “Oyuno se ali Daudi omwami we sibala? Se ali Daudi niye bembela ne bakhina ne baloma bali,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
            "verseOrgIds": [
              "1SA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
            "verseOrgIds": [
              "1SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.12",
            "verseOrgIds": [
              "1SA.21.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.56.1"
              },
              "items": [
                {
                  "text": "Chiny. 56.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne Daudi akanakana khu makhuwa kano mala aria omwami Akishi owa Katihi lukali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.12",
            "verseOrgIds": [
              "1SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.1"
              },
              "items": [
                {
                  "text": "Chiny. 34.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nono Daudi akaluukhasia kimiima kiewe ebweeni wabwe ekhola nga owe kamalalu. Arakikha khubwara bwara khu miliango kie silibwa alekha lulekhe ne luchululukhila khu bunwanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.13",
            "verseOrgIds": [
              "1SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Akishi aboolela bakholi bewe ali, Lola! Omundu yuno ali omukwamalalu niye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.14",
            "verseOrgIds": [
              "1SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese endambile bakwamalalu nio munderere omukwamalalu yuno? Omundu yuno anyala echa munju mwase ku?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.15",
            "verseOrgIds": [
              "1SA.21.15"
            ]
          }
        }
      ]
    }
  ],
