                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.142.1"
              },
              "items": [
                {
                  "text": "142.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daudi arura Katihi mala elukhila mu libina lia Adulamu. Nga bawandaaye ne be enju eya raraawe boosi baulila bali aliyo, bacha niio aba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.1",
            "verseOrgIds": [
              "1SA.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mundu owaba mu butinyu ne buli mundu owaba ne likobi namwe bakhasiimisibwa tawe boosi bebuusia niio Daudi aba. Ne aba omwimeelesi wabwe. Babaandu ba baaba ne naye baba chimia chine.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ama abwenao acha e Misipa mu Moabu. Aboolela omwami owa Moabu ali, “Nosiima lekha paapa wase ne maayi wase beche bamenye ne nawe khukhwola nga ne manya nisio Wele alikho acha khukhukholela.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.3",
            "verseOrgIds": [
              "1SA.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi alekhela omwami owa Moabu raraawe ne maayi wewe. Mala bamenyayo siise sioosi nisio Daudi aba ne ekisile mu libina.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.4",
            "verseOrgIds": [
              "1SA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.4",
            "verseOrgIds": [
              "1SA.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omung'oosi Kati aboolela Daudi ali, “Okhamenya mu libina tawe. Rekukha mala oche mu sibala sia Yuda.” Nono Daudi arekukha mala acha mu musiru kwa Hereti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono Saulo aulila ali Daudi ne babaandu bewe ba baaba ne naye banyoolekhe. Saulo aba ekhaale e Kibea a murongooro kumutamarisiki ne bakholi bewe baba bamwimileo siimbi. Aba atilile lifumo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.6",
            "verseOrgIds": [
              "1SA.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Saulo areeba bakholi bewe ali, “Ulila babaandu ba Benjamini, mwibaasia muli okhwa Chesi akhamuelesie enywe mweesi kimikuunda ne kamaruuti ke kimisabibu? Mwibaasia muli Daudi akhamukhole enywe khuba banamae babemeelesi be babaandu bewe chielefu namwe chimia? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.7",
            "verseOrgIds": [
              "1SA.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enywe mweesi se munjenyela bulayi tawe. Mbao oumboolela omwana wase ne akhola endakaano ne okhwa Chesi tawe. Se aliio oukholela siisa namwe amboolela ali omwana wase achongele omukholi wase anjibuulile endaalo yino tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.8",
            "verseOrgIds": [
              "1SA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.8",
            "verseOrgIds": [
              "1SA.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.52"
              },
              "items": [
                {
                  "text": "Chiny. 52",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne Toeki Omuedomu aba emile siimbi ne bakholi ba Saulo. Mala akobosia Saulo ali, “Naboone okhwa Saulo ne acha Nobu khu Ahimeleki okhwa Ahitubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimeleki areeba Wele Omunyali Owa Bioosi khulwa Daudi. Ne aelesia Daudi biakhulia ne embalu yaba eya Koliati Omufilisiti.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omwami Saulo arumania bareere omusaayi Ahimeleki nende be enju yewe boosi ba baaba bosi basaayi mu Nobu mala becha khu Saulo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.11",
            "verseOrgIds": [
              "1SA.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo aboolela Ahimeleki ali, “Rekeeresia nono okhwa Ahitubu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimeleki amukobosia ali, “Omwami narekereesie.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Saulo amureeba ali, “Siina sikila ewe ne okhwa Chesi ne mukhanjenyela bulayi tawe? Siina sikila ne omuelesie biakhulia ne embalu mala wamusabila khu Wele? Luno angalukhanekho mala anjibuulile?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.13",
            "verseOrgIds": [
              "1SA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.13",
            "verseOrgIds": [
              "1SA.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimeleki akobosia omwami ali, “Naanu mu bakholi bowo boosi oli omweyikinwa nga Daudi? Naanu niye musaani owo mwami ne omunamae omwimeelesi owe banamae bowo? Naanu oli ne lukoosi munju yowo? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.14",
            "verseOrgIds": [
              "1SA.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luno luli lwe khunyoa ese khureebera Daudi khu Wele ku? Tawe! Omwami akhebaasia kamabi kosi kosi khu mukholi wewe namwe khu nju yoosi eya Paapa wase tawe. Sikila omukholi wowo se amanyilekho siosi siosi khu kekholekhe tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.15",
            "verseOrgIds": [
              "1SA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.15",
            "verseOrgIds": [
              "1SA.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami aboolela Ahimeleki ali, “Ahimeleki! Ewe ne be enju eya raraao ng'ali mulafwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.16",
            "verseOrgIds": [
              "1SA.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami aboolela omunamae omuliindi owaba ne amwimileo ali, “Cha mala wire basaayi ba Wele Omunyali Owa Bioosi. Sikila bauliilisiana ne Daudi. Lundi bamanya bali Daudi elukha mala se bamboolela tawe.” Ne kakhali bakholi bo mwami baloba khukhwira basaayi ba Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami aboolela Toeki ali, “Ewe cha mala wire basaayi.” Ne Toeki Omuedomu acha mala eera basaayi. Endaalo eyo eera babaandu kamakhumi munane ne baraano ba baaba ne befwarire efodi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.18",
            "verseOrgIds": [
              "1SA.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi akhaba mu lukoba lwe basaayi lwa Nobu, eramo babaandu. Era baseecha ne bakhasi, babaana ne banuuna. Era akhaba chikhaafu ne chipunda ne kamakheese khulwe khurumikhira embalu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiatari mulala khu baana ba Ahimeleki elukha aona. Acha mala aambana ne Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.20",
            "verseOrgIds": [
              "1SA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiatari aboolela Daudi ali, “Saulo eriire basaayi ba Wele Omunyali Owa Bioosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
              "1SA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi aboolela Abiatari ali, “Nga ne nabona Toeki e Nobu endaalo eyo namanya ndi ng'ali alaboolela Saulo. Ese niye okilile nio babaandu be enju eya raraao boosi bafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.22",
            "verseOrgIds": [
              "1SA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menya ne nase mala okharia tawe. Sikila oyo oyima bulamu bwase ayima ne bubwowo. Ne oli ne nase, olaona.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.23",
            "verseOrgIds": [
              "1SA.22.23"
            ]
          }
        }
