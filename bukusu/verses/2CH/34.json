            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.6"
              },
              "items": [
                {
                  "text": "Yer. 3.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yosia aaba ne bukhulu bwe kimiiko munaane nga ne aarakikha khukhwamiia. Amiia kimiiko kamakhumi kataru na mulala mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhola kaali kamalayi ebweeni wa Wele Omunyali Owa Bioosi. Akhola nga kukaawe Daudi akhola mala se alekha khukhola kamalayi tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosia alaama khusaaya bifwaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwiiko kwewe kukhola munaane nga omwami, Yosia ne asili omwana omusoleeli, aarakikha khusaaya Wele owa kukaawe Daudi. Mu mwiiko kwewe kwe khumi na kibili nga Omwami, aarakikha khurusia mu Yuda ne mu Yerusalemu abuundu aesuta, wele Asiera, ne bifwaani bie khubeecha nende bie bibia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.3"
              },
              "items": [
                {
                  "text": "2 Bab. 21.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 33.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Babaandu batechula chi alutare cha Baali, nga Yosia ne abalaka. Yosia atechula chialutare che bibiindu biiunya bulayi bibiaba angaaki we chialutare. Afunaka mu bitonyi bifwaani bia wele Ashera ne bifwaani bibiabeechwa nende bie bibia biaba nga lipukhuulu. Aanyaka lipukhuulu elio khu biliindwa bie babaandu ba baana chimbosio khu wele benabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1 Bab. 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lundi osia kamakuumba ke basaayi be ba wele abo khu alutare chabwe. Nono Yosia arusia lisaaya lie bifwani liarura mu Yuda ne Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mungoba cha Manase, Efuraimu, ne Simioni, khukhwola khu Nafutali ne khukhwola siimbi mungoba chabwe chichatechulwa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia atechula chialutare ne bifwaani bia wele Ashera. Akhola bifwaani bino biaba nga lipukhuulu. Atechula chialutare choosi che bibiindu biiunya kumuya kumulayi mu sibala sia Isiraeli sioosi. Nio akobola e Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sitabu sie Lilaka sinyolekha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio mu mwiiko kukhola ekhumi na munaane Yosia ne ali omwami, atakaasa Yuda nende Lukaangu. Yosia aruma Shafani okhwa Asalia, Maaseya omwimeelesi owe lukoba, ne Yoa okhwa Yoahasi omuandiki, khung'oona Lukaangu lwa Wele Omunyali Owa Bioosi, Wele owa Yosia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu bano bacha khu Hilikia Omusaayi Omukhulu Lukali mala bamuelesia chirupia nicho babaandu bareera munju eya Wele. Balawi baliindi be silibwa baba bachibuusia khukhwama khu baandu ba Manase, Efuraimu ne Baisiraeli boosi babarama balamu ne akhaba khukhwama mu baandu boosi ba Yuda, Benjamini ne Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana chirupia echo khu bemeelesi babaroborwa khukhwimeelela kimilimo khu Lukaangu lwa Wele Omunyali Owa Bioosi. Babemeelesi bano baruunga bakholi babakholanga kimilimo kie khung'oona Lukaangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana chirupia khu baakhola chimbao ne khu bombakhi bakule kamabaale kamabeeche ne kimirongooro. Chimbao charumikhwa khukhola biaambaania enju ne biteechi bie enju, nibio babaami ba Yuda balekha busa bionekha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu bakhola kimilimo mu busuubilwa. Babemeelesi babwe baba Balawi Yahati ne Obadia, ba baaba babaana ba Merari, ne Balawi Sakaria ne Meshulamu, ba baaba be lisaaye lia Kohati. Ne Balawi boosi baba ne bukesi bukali bwe khukhuupa bibiindu bie kimienya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bemeelela bakholi babasutanga bisutwa. Lundi bekesianga boosi babakholanga kimilimo kiosi kiosi. Ne Balawi balala baba baandiki, babemeelesi, ne baliindi be bilibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga yaba ne barusia chirupia chichaba chareerwa mu Lukaangu lwa Wele Omunyali Owa Bioosi, omusaayi Hilikia anyoola sitabu sie Lilaka lia Wele Omunyali Owa Bioosi sisiianwa khubirira khu Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Hilikia aboolela Shafani omuandiki ali, “Nanyoolile Sitabu sie Lilaka mu Lukaangu lwa Wele Omunyali Owa Bioosi” Nio asiakaanisia Shafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shafani abukula sitabu asiyilila omwami Yosia, mala amuboolela ali, “Koosi niko wara khu bakholi bowo, balikho bakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babukule chirupia choosi chichabeele mu Lukaangu lwa Wele Omunyali Owa Bioosi mala bachielesie babemeelesi ne bakholi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Shafani omuandiki owe mu bwami aboolela omwami ali, “Omusaayi Hilikia ambeleesie sitabu sino.” Nio Shafani aasomela omwami sitabu esio.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga omwami Yosia ne aaulila kamakhuwa ke Lilaka, atabula chingubo chewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami aarusia lilaka khu Hilikia, Ahikamu okhwa Shafani, Abutoni okhwa Mikaya, Shefani omuandiki ne Asaya omukholi owo mwami. Aboola ali, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cha mala mundebere Wele Omunyali Owa Bioosi ne mureebere abo babarama mu Yerusalemu ne Yuda, khuloondekhana ne kamakhuwa ke mu sitabu sisianyoolekhe. Wele Omunyali Owa Bioosi akhuambile efwe lirima lirafu, sikila bapaapa befwe se baria likhuwa lia Wele Omunyali Owa Bioosi tawe. Se bakhola khuloondekhana nende kakaandikwa mu sitabu sino tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Hilikia ne nabo nibo omwami aaruma bacha khu mung'oosi owe siikhasi bali Huluda. Aaba omukhasi owa Shalumu okhwa Tokhati, omwichukhulu owa Hasira owaliindanga chingubo cho mwami. Huluda aba amenya mu Yerusalemu sitonyi sie khabili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huluda ababoolela ali, “lino nilio Wele Omunyali Owa Bioosi, Wele owa Isiraeli aloma: ‘Boolela omundu omurumire khwise oyo muli, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "lino nilio Wele Omunyali Owa Bioosi aboola: Ndareera kiminaanio abuundu ano ne khu baandu bamenyile ano. Ndareera bilaamo bioosi bibiaandikwa mu sitabu nisio omwami owa Yuda asomelwe esio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu ba Yuda bandekhile mala bosiisie bibiindu biiunya bulayi khu bawele babaandi. Bambambia lirima khulwe bibiindu bioosi bimayaanu nibio bakhola. Khwako ndabaambila lirima likhawa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela omwami owa Yuda omurumire enywe khu khundeeba muli, lino nilio Wele Omunyali Owa Bioosi, Wele owa Isiraeli aboola, khuloondekhana ne kamakhuwa niko ewe ouliile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumwoyo kwowo kwebiiya mala ewe weboombia ebweeni wa Wele nga waulila kamakhuwa kewe khuloondekhana ne abuundu ano ne bamenyileo. Ne lundi weboombisie wamwene ebweeni wase mala watabuule chingubo chowo ne khulila ebweeni wase. Khwako sesi nakhuulile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono ndikhulekha ofwe mu muleembe. Ewe se okhabonekho butinyu nibwo ese khareere abuundu ano, ne khu baandu bamenyileo tawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio babarumwa abo bakoboseela omwami burume.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosia akhola endakaano eye khuria Wele Omunyali Owa Bioosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omwami Yosia arumania alaanga alala basaakhulu boosi ba Yuda ne Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami aniina acha mu Lukaangu lwa Wele Omunyali Owa Bioosi, ne babaandu boosi khukhwama Yuda ne khukhwama e Yerusalemu bacha ne naye. Basaayi, Balawi ne babaandu boosi, bakhulu ne bakeekhe bacha ne naye. Omwami abasomela kamakhuwa koosi ke mu sitabu sie ndakaano sisianyoolekha mu Lukaangu lwa Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami Yosia enyokha eema abuundu wewe mala akhola endakaano ebweeni wa Wele Omunyali Owa Bioosi. Akhalaka khuloonda Wele Omunyali Owa Bioosi ne khuria kamalaka kewe, ne kumwoyo kwewe kwoosi ne liiba liewe lioosi. Akhalaka khukhola nga kamakhuwa ke endakaano kakaandikwa mu sitabu sino. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yosia akhola babaandu be mu Yerusalemu ne Benjamini khufukiilila endakaano. Ne babaandu ba Yerusalemu bakhola khuloondekhana ne endakaano eya Wele, Wele owe bakuuka baabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yosia arusia bibiindu bisinya Wele bioosi biarura mu sibala sioosi sisiaba sie Baisiraeli. Akhola buli omundu mu Isiraeli akholele Wele Omunyali Owa Bioosi, Wele wabwe. Mu bulamu bwa Yosia bwoosi babaandu baria Wele Omunyali Owa Bioosi, Wele owe bakuuka babwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
    }
