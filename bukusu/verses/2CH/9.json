          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikholwa bibiindi bioosi bia Solomoni khukhwama khu sie khunyoa khukhwola khu simaliilisi, biaandikwa mu Lukano lwo mung'oosi Nasani ne mu bung'oosi bwa Ahiya Omushilo. Ne lundi biaandikwa mu buloli bwa Ito, owaba ne buloli khuloondekhana ne bubwami bwa Yeroboamu okhwa Nebati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni amiia khukhwama mu Yerusalemu khu Isiraeli yoosi khulwe kimiiko kamakhumi kane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Solomoni afwa, asiikhwa mu Lukoba lwa Daudi raraawe. Ne Rehoboamu omusoleeli wewe amiia mu bweyaangu bwewe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
      ]
