        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasia okhwa Yoashi omwami owa Yuda, amenya kimiiko ekhumi ne kiraano; enyuma we lifwa lia Yoashi okhwa Yehoahasi; omwami owa Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono bibiindu bibiindi nibio Amasia akhola bioosi biaandikwa mu sitabu sie chingano che babaami ba Yuda ne Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama khu siise nisio alekha Wele Omunyali Owa Bioosi babaandu bamukwangwaanila mu Yerusalemu. Nio elukha acha mu lukoba lwa Lakishi, ne kakhali baruma babaandu bamuloondakho e Lakishi mala bamwiira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara kumubili kwewe khu farasi bakukobosia engo, mala asiikhwa mu biliindwa bie bakuuka bewe mu Yerusalemu, lukoba lwa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
