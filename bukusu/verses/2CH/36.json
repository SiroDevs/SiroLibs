              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono Wele eenya khukhwichusia elomo yewe nga aaloma khubirira khu mung'oosi Yeremia. Mu mwiiko kwe khunyoa kwe khukhwamiia khwo mwami Sairasi owa Pasha, Wele Omunyali Owa Bioosi akhola omwami Sairasi arusia kumulaango. Kumulaango kuno aakurusia mu bwami bwewe bwoosi lundi akura mu buandiki ali, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.28"
              },
              "items": [
                {
                  "text": "Isa. 44.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Omwami Sairasi owa Pasha aloma ali, ‘Wele Omunyali Owa Bioosi, Wele owe mwikulu ambelesie ese bubwami bwoosi bwe khu sibala. Ne anderekho mwombakhile enju e Yerusalemu, mu Yuda. Nono Wele Omunyali Owa Bioosi, Wele wenywe akhoya aaba ne nanywe mweesi muuli babaandu bewe. Muli balekhuule khucha e Yerusalemu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        }
      ]
    }
