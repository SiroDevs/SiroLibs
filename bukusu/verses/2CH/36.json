            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.1+JER.21.2+JER.21.3+JER.21.4+JER.21.5+JER.21.6+JER.21.7+JER.21.8+JER.21.9+JER.21.10"
              },
              "items": [
                {
                  "text": "Yer. 21.1-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.1+JER.34.2+JER.34.3+JER.34.4+JER.34.5"
              },
              "items": [
                {
                  "text": "34.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nono Wele areera omwami owa Babiloni khubebwaakala. Omwami oyo eera basoleeli ba baba mu Lukaangu. Se akholelakho basoleeli siisa namwe bakhaana be eyabwaana, basaakhulu namwe abo ba baaba balwale tawe. Wele aabalekha boosi mu bunyali bwa Nebukadinesa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinesa asuuta bibiindu bioosi khukhwama mu Lukaangu, biboofu ne bitiiti ne bibiindu bioosi bie mumabiikhilo ka Wele Omunyali Owa Bioosi ne bibiindu bie mumabiikhilo ko mwami, nende bie babemeelesi bewe. Ayila bibiindu bino bioosi e Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.8"
              },
              "items": [
                {
                  "text": "1 Bab. 9.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nebukadinesa osia enju eya Wele Omunyali Owa Bioosi, mala atechula lisiisi lie lukoba lwa Yerusalemu. Lundi bonaka bibiindu bie bukusi bwe angaaki bioosi lundi osia kamachipi koosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinesa abukula babaandu nga baboe, abo ba baba ne baramire balamu, mala baba nasioobi bewe nende be lisaaye liewe. Baramayo nabwila bubwami bwe Bapasha ne bwemisibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer. 25.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "29.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kano kekholekha khukhwichusia elomo eya Wele Omunyali Owa Bioosi khubirira khu mung'oosi Yeremia. Sibala sianjukhwa khulwe kimiiko kamakhumi saba khukhwola nga kimiiko kie Sabato nikio babaandu bakhaliindanga tawe kiechusibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sairasi aelesia Bayaudi bulekhuule",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
