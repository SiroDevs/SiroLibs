        {
          "text": " Omwami Nebukadinesa owa Babiloni ebwaakala Yuda mala aamba Yehoyakimu, amuboa kiminyololo mala amubukula amuyila e Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinesa abukula bibiindu bilala khukhwama mu nju ya Wele Omunyali Owa Bioosi, abiyila e Babiloni mala abira mwichipi liewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono bibiindu bibiindi nibio Yehoyakimu akhola, ne bibiindi bisinyisia nibio akhola nende buli siindu nisio akhola anyolelakho kumusaango, biaandikwa mu sitabu sie babaami ba Isiraeli ne Yuda. Omwana wewe Yehoyakini amiia mu bweyaangu bwewe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
    },
