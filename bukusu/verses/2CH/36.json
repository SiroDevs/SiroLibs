              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekia aakhola kaali kamamayaanu ebweeni wa Wele Omunyali Owa Bioosi, Wele wewe. Se eboombia ebweeni wo omung'oosi Yeremia owamuboolela kamakhuwa ka Wele tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
