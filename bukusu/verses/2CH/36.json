            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu ba Yuda barobora Yoahasi okhwa Yosia, bamukhola aaba omwami mu Yerusalemu mu bweyaangu bwa raraawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoahasi aaba ne bukhulu bwe kimiiko kamakhumi kabili na kitaru nga aarakikha khukhwamiia. Amiia khulwe kimieesi kitaru mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omwami owa Misiri arusia Yoahasi mu bwami mu Yerusalemu. Ne omwami owa Misiri aruungia babaandu ba Yuda busuuru bubwola bitonyi emia ndala bie efwesa ne sitonyi sie esahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11+JER.22.12"
              },
              "items": [
                {
                  "text": "Yer. 22.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omwami owa Misiri akhola Eliakimu wandaaye owa Yoahasi aaba omwami owa Yuda ne Yerusalemu ne khukaluukhasia lisina liewe lia Eliakimu liaba Yehoyakimu mala abukula Yehoahasi wandaaye owa Yehoyakimu amuyila e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
