              "items": [
                {
                  "text": "Khur. 26.33-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ombakha Abuundu Atakatifu Lukali. Abwenao aaba ne buleeyi ne bukhiikha bulekhaana. Buleeyi bwaba bikele kamakhumi kabili ne bukhiikha bwosi bikele kamakhumi kabili. Bubalaayi bwe Abuundu Atakatifu ao bwaba bulekhaana ne bubalaayi bwe nju eya Wele Omunyali Owa Bioosi. Aafuunikha lisiisi ne esahabu endayi eye busiro bwe bitonyi chimia sita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busiro bwe kimisumari bwaba bitonyi kamakhumi karaano bie esahabu. Lundi aafuunikha esahabu musiro che khu korofa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
