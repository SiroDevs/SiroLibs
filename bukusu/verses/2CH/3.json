            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anaba eneti eye buusi bubuusi, bunapeenda ne bubesemu, alala ne katani, mala achorakho bifwaani bie chikerubi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
