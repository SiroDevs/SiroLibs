        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoshafati aba omwami",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati okhwa Asa amiia mu bweyaangu bwa raraawe mala aaba ne kamaani khu khuupana ne Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.1",
            "verseOrgIds": [
              "2CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ara banamae mu ngoba choosi chisire cha Yuda. Ne ombakha niio banamae bamenya, mu sibala sia Yuda ne mu chingoba cha Efuraimu nicho raraawe Asa aaba ne aamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.2",
            "verseOrgIds": [
              "2CH.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aba ne Yehoshafati, sikila akeenda mu ngila chindaayi che khunyoa cha raraawe, se asaaya Baali tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali esaaya Wele owa raraawe mala akeenda mu malaka ka Wele ne se akeenda khuloondekhana ne chingila che Baisiraeli tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
              "2CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Wele Omunyali Owa Bioosi aandalasia bubwami mu bunyali bwewe. Ne Yuda yoosi yareera biianwa khu Yehoshafati mala aaba ne kimiaandu kimikali lukali ne lukoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumwoyo kwewe kwaba ne kamaani mungila cha Wele Omunyali Owa Bioosi. Ne khutasa khwako, arusiao abuundu aesuta ne wele ba Ashera mu Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwiiko kukhola khataru kwe khukhwamiia khwewe, arumania babemeelesi bewe: Beni-haili, Obadia, Sakaria, Netaneli, ne Mikaya, khukhwekisia babaandu mu ngoba cha Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaruma ne Balawi: Shemaya, Netania; Sebatia, Asaeli, Shemura-moti, Yehonatani, Atonicha, Tobiya ne Tobatoniya. Balawi bano baba ne basaayi Elishama ne Yehoramu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balawi ne basaayi bano bekisia mu Yuda, sitabu sie Lilaka lia Wele Omunyali Owa Bioosi. Bacha buli abuundu mu ngoba cha Yuda choosi mala bekisia babaandu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Efuma eya Yehoshafati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Wele Omunyali Owa Bioosi akhola bubwami bwoosi bwe bibala bibiabotookhelela Yuda bwaambwa buuri. Ne se bakholakho liie khu Yehoshafati tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.10",
            "verseOrgIds": [
              "2CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafilisiti balala bareerera Yehoshafati biianwa ne efwesa eye busuuru. Ne Baarabu bosi bamureerera kamamiiku chielefu saba ne chimia saba ne chindurume chielefu saba ne chimia saba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.11",
            "verseOrgIds": [
              "2CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yehoshafati akaliya kalaa nio aba omukali lukali. Ombakha mu Yuda chingoba chisire ne chingoba che kamabiikhilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.12",
            "verseOrgIds": [
              "2CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aaba ne kamabiikhilo kamaboofu lukali mu ngoba cha Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaba ne banamae, ne bakhupani barana, mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba bano khuloondekhana ne chinju chabwe: Be nju eya Yuda, ne banamae bakhulu babemeelelanga chielefu baba: Adina komanda owemeelelanga banamae chielefu chimia chitaru baba babaandu be kamaani barana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komanda owamulondela aba Yehohanani, ne banamae chielefu chimia chibili ne kamakhumi munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.15",
            "verseOrgIds": [
              "2CH.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owaloondela Yehonani aba Amasia okhwa Sikiri owerusia busa khu milimo kia Wele Omunyali Owa Bioosi. Aba ne banamae be kamaani barana chielefu chimia chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.16",
            "verseOrgIds": [
              "2CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be nju eya Benjamini baba: Eliata, omunamae owe kamaani omurana, ne banamae chielefu chimia chibili be buyiingo ne chingabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne owamuloondela aba Yehosabadi, ne banamae chielefu emia ndala ne kamakhumi munaane be bulwaani bwe liie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.18",
            "verseOrgIds": [
              "2CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano baba mu milimo kio mwami Yehoshafati alala ne babaandi nibo aaba ne ara mu ngoba chisire mu Yuda mwoosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.19",
            "verseOrgIds": [
              "2CH.17.19"
            ]
          }
        }
      ]
    }
  ],
