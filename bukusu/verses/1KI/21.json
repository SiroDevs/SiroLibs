          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Se abao omundu yesi yesi owekusia khukhola kamamayaanu ebweeni wa Wele Omunyali Owa Bioosi nga Ahabu tawe, niye omukhasi wewe Yesebeli aachilisia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhola kasinyisia lukali mu khwisaaya bifwaani, nga Baamori ne baba ne bakhola, nibo Wele Omunyali Owa Bioosi atimania mu sibala nisio Baisiraeli baba ne bengisia.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
    },
