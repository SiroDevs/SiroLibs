              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami Solomoni ombakha lituuli lie chimeeli e Esioni-geberi, embi ne Eloti khu sikiingi sie Nyanja eya Shamu, mu sibala sie Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
