          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwami Hiramu aruma bakholi bewe, babaandereba be chimeeli, bamanyile kimilimo kie khu nyanja bache alala ne bakholi ba Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
              "1KI.9.27"
            ]
          }
        },
