              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio baboolela Solomoni bali, “Atonicha akhuriire, sikila akhamaare chinjika cha alutare.” Alikho aloma ali, “Lekha omwami Solomoni anyoe anjechubile ali se acha khunjira tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.51",
            "verseOrgIds": [
              "1KI.1.51"
            ]
          }
        }
