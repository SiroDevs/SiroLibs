                  "text": "1 Bab. 4.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Solomoni abuusia alala kamakaari ke liie ne chifarasi. Aba ne kamakaari ke liie eelefu ndala ne chimia chine ne chifarasi chielefu ekhumi ne chibili kamakaari kano ne chifarasi chino achira mu ngoba che kamakaari ke liie ne Yerusalemu niio aba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.17"
              },
              "items": [
                {
                  "text": "Likh. 17.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio omwami akhola efwesa yaba esala busa buli abuundu mu Yerusalemu nga kamabaale. Ne chimbao che kumutarakwa chaba chingali busa nga kimikhuyu kie Shefela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Likh. 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Solomoni akulaanga chifarasi khukhwama e Misiri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10.28",
              "type": "text"
            },
            {
              "text": "Misiri:",
              "type": "text"
            },
            {
              "text": "namwe Musri, Lueburania luli Misiri.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ne e Silisia",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10.28",
              "type": "text"
            },
            {
              "text": "Misiri ne e Silisia:",
              "type": "text"
            },
            {
              "text": "bibala bibili bikhale bino bili niio balaanga luno bali akari we ebunaswa ne ebukwe we sibala sia Turuki. Bibala ebio biaba nibio basasiliangamo chifarasi mu siise sia Solomoni.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Baboofuli bo mwami bachikulaanga khukhwama e Silisia khu bukusi bubwabaao.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        }
      ]
