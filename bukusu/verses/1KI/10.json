          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likaari lie liie liakulibwaanga khukhwama e Misiri khu bukusi bwe efwesa chikiilo embi saba, ne efarasi yakulibwaanga efwesa chikiilo chibili. Nio khubirira khu boofuli bo mwami, kamakaari ke liie ne chifarasi biakusibwa khu baami be Bahiti ne Bashamu boosi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
