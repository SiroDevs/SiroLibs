        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
