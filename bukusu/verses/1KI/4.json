          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biakhulia nibio Solomoni enyanga khu ndaalo ndala biaba, chindubi emia ndala ne kamakhumi karaano che bufu, siakhulia chindubi chimia chitaru, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.22",
            "verseOrgIds": [
              "1KI.4.22"
            ]
          }
        },
        {
