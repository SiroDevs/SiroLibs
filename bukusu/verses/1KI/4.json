        {
          "text": "Keberi okhwa Uri owe lukoongo lwa Kileati nilwo omwami Sihoni owe Baamori no mwami Oku owe Bashani bamiia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.19",
