          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.12",
            "verseOrgIds": [
              "1KI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangeberi owe Ramoti-kileati, aba ne birekere bia Yairi, okhwa Manase biili mu Kileati lundi aaba ne lukoongo lwa Arikobu mu Bashani. Chabamo chingoba kamakhumi sita chimboofu chisire ne bilibwa bie kumukasa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.13",
            "verseOrgIds": [
              "1KI.4.13"
            ]
          }
        }
      ]
    },
    {
