              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ombakha lisiisi lie luuya lwe mukari ne kamabaale, ne kimitarakwa khu buli chilaini chitaru che kamabaale arao elaini ndala eye lupao lwe kumutarakwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwiiko kukhola khane kwe mu bwami bwa Solomoni kumusiingi kwe enju eya Wele Omunyali Owa Bioosi kwombakhwa. Kwaba kumwesi kwa Sifu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mu mwesi kwa munane, kulaangwa kwa Buli, mu mwiiko kukhola ekhumi na mulala kwe mu bwami bwa Solomoni, kimilimo kie khukhwombakha lukaangu kiawela elala. Lwombakhwa khuloondekhana nga lwenyekhana. Lwabukula Solomoni kimiiko saba khulwombakha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
      ]
    }
