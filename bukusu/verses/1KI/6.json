                "loc": "EXO.25.18+EXO.25.19+EXO.25.20"
              },
              "items": [
                {
                  "text": "Khur. 25.18-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mukari mwe Abuundu Atakatifu Lukali, Solomoni akholamo chikerubi khukhwama khu mbao che kumuseituni. Buli ekerubi yaba buniina bwe bifuba ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lutaa lwe ekerubi lwaba bikele biraano buleeyi. Ne buleeyi bwe khukhwama emusia we lutaa lulala khukhwola emusia we lutaa luluundi, bwaba bikele ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikerubi chibili echo chaba chalekhaana, lundi chafwaanana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli ebira yaba bifuba, ekhumi, buniina. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikerubi echo chabiikhwa mu lukaangu mukari lukali. Lutaa lwe ekerubi ndala lwetiila khwisiisi lubeka lulala ne lwe ekerubi ekiindi lwetiila khu lisiisi liliindi. Chindaa chacho chichiindi chetilanakho akari we enju. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni afuunikha chikerubi echo ne esahabu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeecha khu masiisi ke Lukaangu ne bifwaani bie chikerubi ne chikheendu ne bimuli mu siro che mukari ne enje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi we enju afuunikha ne esahabu mu siro che mukari ne enje.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhola chinjiki che kimiliango kicha Abuundu Atakatifu Lukali khukhwama khu museituni. Chinjiki chino chaba ne bisiindi bibiaba ne chimbeka chiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeecha khu miliango kibili kie chikheendu ekio bifwaani bie chikerubi, chikheendu ne bimuli. Abifuunikha bioosi khungaaki ne esahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumuliango kwe lusiro luboofu, Solomoni akukholela kimitalaachi kikiama khu lupao lwe kumuseituni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinjiki chabamo chibili chimbambaane che khufuumba chichakhomwa khukhwama khu lupao lwa Saipurasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khu njiki echo abeecha bifwaani bie chikerubi ne chikheendu ne bimuli. Afuunikha bioosi ne esahabu alekhaasia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        }
      ]
    },
    {
