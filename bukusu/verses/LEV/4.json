              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.27+NUM.15.28"
              },
              "items": [
                {
                  "text": "Khub. 15.27-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Omundu yesi yesi nakholile bubwoni nibwo Wele Omunyali Owa Bioosi akaania nakhetekile tawe, aba ali ne kumusaango. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali nga omundu ne amanya bubwoni bwewe nibwo akholile akhoya areere siianwa sie mbusi ekhasi ekhalimo bubi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne akhoya are kumukhono kwewe khu murwe khwe siianwa sirusiao bubwoni mala asiirire abuundu niio bereranga biianwa bie khukhwosia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusaayi alaroonga lulwala lwewe mu malasile mala akaakhe khu njika cha alutare eye biianwa bie khukhwosia, mala achukhe karamire asibale sia alutare. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio omusaayi, alakhalaka kiminaawa kiayo kioosi nga kiminaawa ne kikhalakangwa khukhwama khu biianwa bie kumuleembe. Omusaayi oyo alakioselia khu alutare khulwe kumuuya kumulayi kusiimisia Wele Omunyali Owa Bioosi. Ne alaana embosio khulwe bubwoni bwewe mala alabeelwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
          }
        }
      ]
