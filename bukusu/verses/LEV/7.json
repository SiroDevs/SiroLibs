                  "text": "15.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Litasa khwilio, mu limenya lienywe liosi se mulia kamalasile kosi kosi tawe, akhaba ne kali ke nyuni namwe ke saang'i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi yesi olia kamalasile alarusibwa mu baandu bewe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aboolela Musa ali, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.28",
            "verseOrgIds": [
              "LEV.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Boolela babaandu ba Isiraeli oli, omundu yesi yesi oreera siianwa siewe sie kumuleembe khu Wele Omunyali Owa Bioosi, alareera nga embosio khu Wele Omunyali Owa Bioosi khukhwama khu siianwa siewe sie kumuleembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhoya omwene areere ne kumukhono kwewe biianwa bibiosibwe khu Wele Omunyali Owa Bioosi. Akhoya areere kiminaawa ne sitindimilo mala abiiane nga siiaanwa siboofu khu Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaayi alosia kiminaawa khu alutare ne sitindimilo silaba sia Aruni ne babaana bewe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne sie lubeka luseecha alaelesia omusaayi nga siianwa khukhwama khu mbosio yewe eye siianwa siewe sie khuosia sie kumuleembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oyo mu ba okhwa Aruni orusia kamalasile ke siianwa sie kumuleembe ne kiminaawa, abukula sietakho sie lubeka luseecha sibe nga kumukabwa kwewe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukula sitindimilo ne sinama sietakho khukhwama mu baandu ba Isiraeli, nga siianwa siabwe sie kumuleembe mala abielesie omusaayi Aruni ne babaana bewe nga sikelo siabwe sia buli lwosi khukhwama khu baandu ba Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sino sili sikelo sia Aruni ne babaana bewe khukhwama khu biianwa khu Wele Omunyali Owa Bioosi bibiosibwa. Baelesibwa kumukabwa kuno khukhwamila khu ndaalo niyo bareerwakho kumukhono babe basaayi ba Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi alaka Baisiraeli babaelesie sikelo sino, khukhwamila khu ndaalo niyo bareerwakho kumukhono. Sino sili sikelo sie siakhulia khu selukho chabwe choosi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
