          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kano kali kamalaka khu mundu ocha kamayila, kamafuki, kameechi namwe orura kamaani ko museecha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
