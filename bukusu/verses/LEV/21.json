          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono kano niko Musa aboolela Aruni, ne babaana bewe be seecha ne Baisiraeli boosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.24",
            "verseOrgIds": [
              "LEV.21.24"
            ]
          }
        }
      ]
    }
  ],
