        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
