          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kali kamalaka niko Wele Omunyali Owa Bioosi akhola akari wewe ne Baisiraeli khu sikulu sia Sinai khubirira khu Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
