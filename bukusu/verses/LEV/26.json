                  "text": "Likh. 11.13-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.1+DEU.28.2+DEU.28.3+DEU.28.4+DEU.28.5+DEU.28.6+DEU.28.7+DEU.28.8+DEU.28.9+DEU.28.10+DEU.28.11+DEU.28.12+DEU.28.13+DEU.28.14"
              },
              "items": [
                {
                  "text": "28.1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mwaaba ne mulamenya khuloondekhana ne kamalaka kase ne khukaria, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndamureerera efula mu siise sisienyekha. Ne kamaloba kalarusia bibiaamo bikali ne kimirongooro kilaama kamatuunda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.4",
            "verseOrgIds": [
              "LEV.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuula khwenywe khwe biakhulia khukhachiililile, khukhwola likesa lie kimisabibu, ne likesa lie kimisabibu khukhwola biise bie khumiicha. Mukhabe ne buli siindu nisio mwenya khulia, mala mukhamenye mu muleembe mu sibala sienywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Khamuelesie kumuleembe mu sibala sienywe, mala mukone busa ne mukheendekhelele omundu yesi yesi tawe. Ndarusiao mu sibala sienywe chisaang'i che mundaa chindafu, ne liie se likhabemo lundi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.6",
            "verseOrgIds": [
              "LEV.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhatimianie basiku benywe, ne khubeerera mwiie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.7",
            "verseOrgIds": [
              "LEV.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu baraano benywe bakhatimanie basiku emia ndala, ne babaandu benywe emia ndala bakhatimanie basiku chielefu ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.8",
            "verseOrgIds": [
              "LEV.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mukhaule basiku benywe ne khuberera mwiie. Khamubiite chikhabi mala muelesie babaana bakali, mala ndinde endakaano niyo nakhola nanywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.9",
            "verseOrgIds": [
              "LEV.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhabe musilia biakhulia bienywe nibio mwabuunga, mukhabuungulule nio mubuunge biiyaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.10",
            "verseOrgIds": [
              "LEV.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhamenye ne nanywe ne se khamubiile tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.11",
            "verseOrgIds": [
              "LEV.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Bakor. 6.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khabe ne nanywe, ne lundi ese khabe Wele wenywe ne enywe mukhabe babaandu base. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese ndi, Wele Omunyali Owa Bioosi, Wele wenywe, owamurusia mu sibala sia Misiri, nio mulekhe khuba lundi nasioobi babwe tawe. Namurusiisiekho bunyali bubwamubaakho mala namukholile mukeende ne muli balekhuule.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumunaanio sikila sileka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Ne kakhali mwaba ne mu khandekeresia ne khuloonda kamalaka kano tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.14",
            "verseOrgIds": [
              "LEV.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwaba ne muloba khuria kamalaka kase ne khukalekelesia, aba mwafunaake endakaano yase ne nanywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.15",
            "verseOrgIds": [
              "LEV.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khamuelesie kumunaanio kuno: Ndamusiindusia ne literema ne bulwaale bukhaona tawe. Ndamureerera kumurengo kuulamubofusia ne khusasia bulamu bwenywe. Mukhamiiche, ne kakhali se mulanyoolamo sisiindu tawe. Sikila basiku benywe bakhamukhile mala balie nibio mwamiicha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.16",
            "verseOrgIds": [
              "LEV.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamufutarira nio mukhilwe ne basiku benywe. Ne abo babamubiila balamwamiia, ne mulaba bari lukali, mala mulatima busa omundu nakhamutimaanie tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne enyuma wa kano koosi mwaba ne musili khukhundia tawe, ndatasa kumunaanio kwenywe khukhwola kamakhabi saba sikila bubwoni bwenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.18",
            "verseOrgIds": [
              "LEV.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndarusiao sileka sienywe siboofu sie khukhwelola, ne ndakhola likulu libe liliomu para nga sichuuma ne sibala sienywe siloma mala siaandalale nga siibia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.19",
            "verseOrgIds": [
              "LEV.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimilimo kienywe kioosi se kilamukholelakho sioosi tawe. Sikila kamaloba kenywe kalaba ka busa, yakhaba kimirongooro kienywe kie kamatuunda se kilaama tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne mwaba ne muchiililila khukhumbingania ne khuloba khukhundia, lundi aba ndatasa kumunaanio kwenywe khukhwola saba khuloondekhana ne bubwoni bwenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.21",
            "verseOrgIds": [
              "LEV.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalekhuula chisaang'i che mundaa chindafu khwinywe mala chilera babaana benywe, ne chikhaafu chenywe. Chilamuramia batiiti busa bari nio kimiila kienywe kilaba busa mundu kho tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne mwaba bali, enyuma we siiukuumo sino sioosi, musichiililila khukhundekelesia, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.23",
            "verseOrgIds": [
              "LEV.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba sesi ndamuloba mala muelesie kumunaanio khukhwola saba khulwe bubwoni bwenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.24",
            "verseOrgIds": [
              "LEV.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khamureerere liie, khulwe khufunaka endakaano yefwe. Ne mwaba ne mwebuusia mu chingoba chenywe khulwe khukhwekhiinga busiku, ndaruma bulwaale bukhaona tawe akari wenywe mala khukhwola mweane khu basiku benywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.25",
            "verseOrgIds": [
              "LEV.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khakhole siakhulia sitambeo. Ne bakhasi ekhumi bakhamutekhelenge biakhulia khwiika lilala. Ne bakhamue biakhulia bienywe mu bikelo. Mukhalie ne se mukheekure tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne mwaba ne mumbiingania ne khulekha khukhumbulila akhaba kano ne kali kario, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.27",
            "verseOrgIds": [
              "LEV.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba mu lirima liase sesi ndamuloba. Ne samwene ndamua kumunaanio kumukali khukhwola kamakhabi saba, khulwe bubwoni bwenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.28",
            "verseOrgIds": [
              "LEV.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhalie babaana benywe basoleeli ne bakhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.29",
            "verseOrgIds": [
              "LEV.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndasambula abuundu enywe e khusaaya ne khutechula alutare chenywe che biiunya bulayi ne khumwaata kimilaambo kienywe khu bifwaani bienywe bibiafwa khale ebio, lundi ndamubiila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.30",
            "verseOrgIds": [
              "LEV.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khakaluukhasie chingoba chenywe chibe kamakubili, mala sambuule abuundu enywe e khusaaya. Ne lundi ndaloba khung'ayilisia biiunya bulayi bienywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.31",
            "verseOrgIds": [
              "LEV.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khonakile elala sibala sienywe, mala basiku bakhasingisie bakhauke khusibona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.32",
            "verseOrgIds": [
              "LEV.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khamusalanisie mu bibala bikeni, mala muloondiekho liie. Chingoba chenywe chiicha khutechulwa ne kamaloba kenywe kalaba busa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne muli mu sibala sie basiku, sibala sienywe siikhekhale busa siikharie chindaalo che khukonela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34",
            "verseOrgIds": [
              "LEV.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ne silaba ne sikonela sirio, silakonela khukonela nisio siikhaanyoolangakho mu sabato chenywe nga mwamenyangamo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne khwinywe ba barama, khabakhole babe bari lukali, ne baulila embeo neucha kamasaafu ne belukha. Bakhelukhe nga nibo balikho batimania mwiie. Ne bakhakwe busa akhaba omusiku ne akhabatimania tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.36",
            "verseOrgIds": [
              "LEV.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhetuyanekho oli ne belukha liie, akhaba omundu nakhaliio obatimania tawe. Se mukhabekho ne kamaani ke khukhwima ebweeni we basiku benywe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.37",
            "verseOrgIds": [
              "LEV.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhafwiile mu sibala sie basiku benywe mala musiikhwe ebweeneyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.38",
            "verseOrgIds": [
              "LEV.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batiiti khwinywe baakhabe balamu mu sibala sie basiku benywe, mukhanaanisibweyo busa sikila bubwoni bwenywe mwabene ne bubwoni bwe bakuuka benywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 26:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne kakhali baba ne beyama bubwoni bwabwe, ne bubwoni bwe bakuuka babwe, ne sileka nisio baakholela, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "bubwakila nababiila mala nabayila mu sibala sie basiku babwe, ne aaba babaandu be sileka bano ne beboombia mala bafukiilila kumunaanio sikila bubwoni bwabwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.41",
            "verseOrgIds": [
              "LEV.26.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.7+GEN.17.8"
              },
              "items": [
                {
                  "text": "Lir. 17.7-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.3+GEN.26.4"
              },
              "items": [
                {
                  "text": "26.3-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13+GEN.28.14"
              },
              "items": [
                {
                  "text": "28.13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " aba khakhebulile endakaano yase ne Yakobo, ne Isaaka ne Aburahamu, ne lundi kha khebulile sibala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali bakhaanjukhe kamaloba mala kabe busa mundu mo tawe. Ne khukhwola banyoole kumunaanio sikila bubwoni khulwe khulekelesia kamalaka kase. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhaba kario, nga ne basiili bario mu sibala sie basiku babwe, se ndabalekha namwe se ndababiila namwe mbabunisilie elala namwe funake endakaano yase ne nabo tawe. Sikila Ese ndi Wele Omunyali Owa Bioosi, Wele wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali khulwabwe, ndakhebulila endakaano niyo nakhola ne bakuuka babwe nibo narusia mu sibala sia Misiri ebweeni we chikholo chichiindi nio mbe Wele wabwe. Ese ndi Wele Omunyali Owa Bioosi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
    },
