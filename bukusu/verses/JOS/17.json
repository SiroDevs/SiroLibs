          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enusu eye kholo eya Manase ba baaba lubeka lwe mumbo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidoni sisiindi sie kamaloba ka kaaba mumbo mwe luluuchi lwa Yoritani kakabwa khu lisaaye liliindi lia Manase owaba omubele owa Yosefu. Makiri, raraawe owa Kileati, owaba omubele owa Manase owaulanga kamae, akabwa Kileati ne Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.1",
            "verseOrgIds": [
              "JOS.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamaloba elubeka lwe mumbo mwa Yoritani kakabwa khu lisaaye liliarama lia Manase: Abieseri, Heleki, Asirieli, shekemu, Heferi, ne Shemita. Bano baba babechukhulu be siseecha ba Manase okhwa Yosefu, ne ba baaba babemeelesi be chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salofehati, okhwa Heferi, okhwa Kileati, okhwa Makiri, okhwa Manase, se abakho ne babaana be siseecha tawe, ne bakhali be siikhaana bong'ene. Kamasina kabwe kaba Mahila, Noa, Hokila, Milika, ne Tirisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.1+NUM.27.2+NUM.27.3+NUM.27.4+NUM.27.5+NUM.27.6+NUM.27.7"
              },
              "items": [
                {
                  "text": "Khub. 27.1-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bacha khu musaayi Eliesa ne khu Yoshua okhwa Nuni ne khu bemeelesi, mala baloma bali, “Wele Omunyali Owa Bioosi aalaka Musa khukhuelesia efwe ne balebe befwe, sitonyi sie kumukabo kwe kumukuunda.” Nono nga Wele Omunyali Owa Bioosi ne aalaka, babaelesia kamaloba alala ne balebe babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elio liakila Manase anyoola kimikabo likhumi khutubakho khu Kileati ne Bashani lubeka lwe bukwe owa Yoritani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhaana be lisaaye lia Manase boosi banyoolela kamaloba alala ne basoleeli. Kamaloba ka Kileati kakabwa khu be lisaaye lia Manase ba barama.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamaloba ka Manase kama Asheri khukhwola Mikimetati, e bukwe owa Shekemu. Nio lulwakha lwacha siafubo lwola khu babaandu ba Endapua. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.7",
            "verseOrgIds": [
              "JOS.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamaloba kakaba siimbi Tapua kaba ka Manase, ne lukoba lwa Tapua, khu lwakha, luli lwe babaana ba Efuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.8",
            "verseOrgIds": [
              "JOS.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Lulwakha lwekha emwaalo khu luuchi lwa Kana. Chingoba che mwaalo siafubo we luluuchi chaba cha Efuraimu, chakhaba ne chaba mu sibala sia Manase. Lulwakha lwa Manase lwaloonda lubeka lwe bunaswa we luluuchi ne khumaliilikha mu nyanja eya Mediterenia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.9",
            "verseOrgIds": [
              "JOS.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuraimu aba e ebunafubo, ne Manase aba e bunaswa, ne nyanja eya Mediterenia yaba lulwakha lwabwe lwe mumbo. Asheri siaba e bunaswa, ne Isakari siaba e bukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.10",
            "verseOrgIds": [
              "JOS.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bibala bia Isakari ne Asheri, Manase aaba ne Beti-sheani ne Ibuleamu, alala ne chingoba chabwe chichaba siimbi, akhaba ne Tori (lulala luli khu lukuku lwe nyanja), Endori, Taanachi, Mekido, ne chingoba chabwe chichaba siimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.27+JDG.1.28"
              },
              "items": [
                {
                  "text": "Bakh. 1.27-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Babaandu ba Manase, kakhaba kario, se banyala khutimania babaandu khumenya mu chingoba echo tawe, ne kakhali Bakanaani bachiililila khumenyamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhaba Baisiraeli bakelao banyoola kamaani, se batimania Bakanaani tawe, ne kakhali babaingiilila khubakholela kimilimo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikholo cha Efuraimu ne Manase che mumbo chisaba kumukuunda kukuundi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be lisaaye lia Yosefu baboolela Yoshua bali, “Sikila siina ne okhuele sitonyi kumukuunda mulala kwong'ene khuba nga kumukabwa kwefwe? Se obona khuli bakali lukali sikila Wele Omunyali Owa Bioosi akhubiitile chikhabi?”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua abakobosia ali, “Mwaba ne muli bakali ne sibala sie sikulu sia Efuraimu sili sitiiti lukali khwinywe, khe muche mu sichiimi sie Baperisi ne Barefaimu mala mubere mwabeene.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamukobosia bali, “Sibala sie sikulu se siikhwola efwe tawe, ne bona Bakanaani bamenyile mu maayo bali ne kamakaari ke bichuuma, bakhaba abo bamenyile mu Beti-sheani ne chingoba chayo ne nabo bamenyile mwitooma lia Yesireeli.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua aboolela chikholo cha Efuraimu ne Manase ali, “Ng'ali muli bakali lukali, lundi muli ne kamaani kamakali. Se mukhoya mwanyoola kumukabwa mulala kwong'ene tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.17",
            "verseOrgIds": [
              "JOS.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibala sie sikulu Sicha khuba sisienywe. Siakhaba ne sili sichiimi, mu sibere mala sibe sisienywe khukhwama khu ndulo eyi ne neyi. Ne Bakanaani, mucha khubatimania barure, bakhaba ne bali ne kamakaari ke bichuuma lundi ne bali ne kamaani.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.18",
            "verseOrgIds": [
              "JOS.17.18"
            ]
          }
        }
      ]
    }
  ],
