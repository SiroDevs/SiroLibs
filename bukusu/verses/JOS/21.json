          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono Wele Omunyali Owa Bioosi owe Baisiraeli abaa kamaloba koosi niko aba alaka bakuuka baabwe. Ne nga bamala khukaamba, bakamenyamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele Omunyali Owa Bioosi abaelesia kumuleembe mu mbeka choosi, nga aalaka bakuuka baabwe. Mbao omusiku wabwe akhaba mulala owanyala khubaula tawe sikila Wele Omunyali Owa Bioosi aa Baisiraeli bukhili khu basiku baabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aakhola koosi niko aasuubisia Isiraeli. Sesiabakhoo siosi siosi silayi nisio aasuubisia mala alekha khusikhola tawe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
