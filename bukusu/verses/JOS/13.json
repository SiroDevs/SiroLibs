              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.28",
            "verseOrgIds": [
              "JOS.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aaba aakaba kamaloba malala nga kumukabwa khu lisaaye lilala lia Manase khuloondekhana ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamaloba kabwe kamalatana khukhwama Mahanaimu mala kabamo Bashani ne bubwami bwoosi bwa Oku, omwami owa Bashani, akhaba ne chingoba kamakhumi sita choosi cha Yairi mu Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamaloba kano kabamo e nusu khu maloba ka Kileati akhaba Asitaroti ne Etirei, chingoba chimboofu che bubwami bwa Oku mu Bashani. Chino chosi chaebwa khu balala khu lisaaye liliama khu Makiri okhwa Manase, khuloondekhana ne kimiliango kiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
      ]
    },
