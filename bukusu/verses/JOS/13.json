          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimikabwa ekio nikio Musa akabania ebukwe owa Yeriko ne Yoritani mu mweyeywe kwa Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
