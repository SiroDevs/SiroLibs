            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baisiraeli bakholeela Wele Omunyali Owa Bioosi biise bioosi nibio Yoshua aba omulamu. Akhaba enyuma we lifwa liewe, bachiililila khukhola bario nga babemeelesi bababona niko Wele Omunyali Owa Bioosi aakholela Isiraeli baba ne basiili balamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
