              "type": "text"
            }
          ]
        },
        {
          "text": "Nono lino nilio Yoshua akhola: abaliinda ne se aalekha Baisiraeli babeera tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
