              "attrs": {
                "loc": "NUM.11.3"
              },
              "items": [
                {
                  "text": "Khub. 11.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.7"
              },
              "items": [
                {
                  "text": "Khur. 17.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Lundi enywe, mwaambia Wele Omunyali Owa Bioosi, Wele wenywe lirima nga mwaba Tabera, Masa, ne Kiburoti-Hataaba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
