                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1+1KI.11.2+1KI.11.3+1KI.11.4+1KI.11.5+1KI.11.6+1KI.11.7+1KI.11.8"
              },
              "items": [
                {
                  "text": "11.1-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.15"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 1.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.27"
              },
              "items": [
                {
                  "text": "9.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omwami akhaba ne bakhasi bakali tawe, sikila lino lilamukhola aaukhe khukhwama khu Wele Omunyali Owa Bioosi. Lundi akhaba ne efwesa ne esahabu engali tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ne alaba omwami mu bwami bwewe, niye omwene alaandika mu sitabu kamalaka malalakho khukhwama khu basaayi ne Balawi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaba ne sitabu sino mala asisome mu bulamu bwewe bwoosi, nio eyike khuria Wele Omunyali Owa Bioosi, Wele wewe ne khuuria kamalaka kewe koosi ne khukhola nga kaboola. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino lilamuliinda nio akhebaasia ali niye ali omulayi khukhila Baisiraeli basie tawe, lundi nio akhaba omureengu khu malaka ka Wele Omunyali Owa Bioosi tawe. Akhola ario nio niye ne lisaaye liewe bamiie Isiraeli mindali na mindali.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.20",
            "verseOrgIds": [
              "DEU.17.20"
            ]
          }
        }
      ]
    }
