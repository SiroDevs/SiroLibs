            "sid": "DEU 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakholela bawele babaandi ne khubasaaya, bawele nibo yaba bakhamanya namwe basaayanga tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Wele Omunyali Owa Bioosi aambila babaandu be sibala sino lirima mala areera khu sibala siabwe bilaamo bioosi bibiaandikwa mu sitabu sino. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aabarusia mu sibala siabwe mu lirima liewe likali mala abamwaata mu sibala sikeni, khukhwola endaalo yino bali ebweeneyo.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        }
      ]
    },
