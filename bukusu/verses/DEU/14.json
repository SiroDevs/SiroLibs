                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Enywe muli babaana ba Wele Omunyali Owa Bioosi, Wele wenywe. Mukhesala namwe mwekina, khulwe bafu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
            "verseOrgIds": [
              "DEU.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
