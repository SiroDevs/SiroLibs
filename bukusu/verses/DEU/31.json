          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono, Musa aaloma kamakhuwa ke kumwenya kwoosi khukhwola nga ne aamala babaandu ba Isiraeli boosi ne barekeeresie:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
            "verseOrgIds": [
              "DEU.31.30"
            ]
          }
