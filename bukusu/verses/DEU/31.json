              },
              "items": [
                {
                  "text": "Yosh. 1.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio Wele Omunyali Owa Bioosi aelesia Yoshua okhwa Nuni kamalaka ne amuboolela ali, “Ba ne kamaani ne bunyindaafu. Olaraangirira babaandu ba Isiraeli bengile mu sibala nisio nabasuubisia. Ndaba ne nawe.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        }
