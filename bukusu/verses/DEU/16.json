            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26+NUM.28.27+NUM.28.28+NUM.28.29+NUM.28.30+NUM.28.31"
              },
              "items": [
                {
                  "text": "Khub. 28.26-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bala kamachuuma saba khukhwamila khu siise nisio mwarakikhirakho khukesa biakhulia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio mukhole Naikara eye Likesa khulwa Wele Omunyali Owa Bioosi, Wele wenywe. Mureerere siianwa sie khukhwerusia khuloondekhana ne chikhabi nicho akhuelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli mundu ekhoye ebweeni wa Wele Omunyali Owa Bioosi, Wele wenywe, alala ne babaana bowo basoleeli ne bakhaana, banasioobi bowo be siseecha nende be siikhasi ne Balawi ne bakeni ne bafuubi ne banamulekhwa bamenyile mu ngoba chenywe. Khola murio abuundu alala e khusaaya Wele Omunyali Owa Bioosi, Wele wenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khebulila muli mwaba banasioobi mu Misiri khwako ba barekerefu khuria kamalaka kano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
