                {
                  "text": "Likh. 32.48-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Nio nasaba Wele Omunyali Owa Bioosi ne mwekoonjelela ndi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Ee Omwami WELE, ewe niwe orakikhe khukhunjekesia ese omukholi wowo bukali bwowo ne kamaani kowo, se aliio wele okundi mwikulu namwe khu sibala, onyala wakhola bibiindu bie khuukia nga bibiowo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nosiima, khusaba ndekhuule nje mbone kamaloba kamalayi engelekha we luluuchi lwa Yoritani, sibala silayi sie bikulu bia Lebanoni.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
