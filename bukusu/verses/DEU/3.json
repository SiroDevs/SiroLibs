          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhabaria tawe sikila Wele Omunyali Owa Bioosi, Wele wenywe alamupanila.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa se afukiililwa khukhwingila mu Kanaani tawe",
          "type": "text"
        }
      ]
    },
