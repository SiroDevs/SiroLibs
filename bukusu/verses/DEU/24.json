              "DEU.24.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.31"
              },
              "items": [
                {
                  "text": "Mat. 5.31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.7"
              },
              "items": [
                {
                  "text": "19.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.4"
              },
              "items": [
                {
                  "text": "Mk. 10.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Omundu anyala aakhwa omukhasi mala enyuma eulila ali se amwenya tawe, sikila amuboonemo kumwiima nikwo akhasiima tawe. Akhoya aandike chibarwa che khumulekha, amuelesie mala amuoone arure mungo mwewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne arurire mungo omwo, anyala aacha khuteekha khu museecha okundi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuseecha owe khabili oyo yesi anyala alekhe khusiimisibwa ne omukhasi oyo. Yesi aandike chibarwa che khumulekha, amuelesie mala amuoone arure mungo mwewe. Namwe omuseecha wewe owa khabili anyala aafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuseecha wewe owe khunyoa se amukobosia lundi tawe, sikila omukhasi oyo abeele omunyaalu. Aaba ne amwiilakho lundi bulaba bumayaanu khu Wele Omunyali Owa Bioosi. Mukhareera bumayaanu buno mu sibala nisio Wele Omunyali Owa Bioosi, Wele wenywe alikho amuelesia khuuba sisienywe tawe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kamalaka kakaukhaane",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omundu ne ali no mukhasi omwea, akhacha mwiie, namwe akhole kimilimo kikiindi kiosi kiosi tawe alabeelwa, akhakhola kimilimo tawe, khulwe kumwiiko mulala, nio amenye engo asangaasie omukhasi wewe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ne wikopia omundu sisiindu, okhabukula lususi lwewe nilwo arumikhirangakho khusia tawe, sikila aba alikho aruunga bulamu bwewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.16"
              },
              "items": [
                {
                  "text": "Khur. 21.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omundu aanyoolekha ne eeba Omuisiraeli wasie eelukha naye mala aamukhola nasioobi wewe namwe aamukusia mu bunasioobi, omundu oyo akhoya eerwe. Mu ngila yino mularusiao bumayaanu akari wenywe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Bal. 13.1—14.54\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Omundu ne alwala bulwaale bwe kamakele, akhoya abe omurekeerefu khukhola bulayi bwene nga basaayi balawi ne balimwekesia. Balimwekesia nga ese ne nabalaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.10"
              },
              "items": [
                {
                  "text": "Khub. 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khebulila niko Wele Omunyali Owa Bioosi, Wele wenywe akhola Miriamu nga ne mwaba ne mwama e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
              "DEU.24.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.26+EXO.22.27"
              },
              "items": [
                {
                  "text": "Khur. 22.26-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ne wikopia owasio sisiindu, okhacha munju mwewe wabukula sisiindu sie khuambiilila likobi liewe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
              "DEU.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lindila enje mala olekhe omwene akhureerere sie khuambiilila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.11",
            "verseOrgIds": [
              "DEU.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaba ne ali omutaambi okhasibiikha siilo sioosi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.12",
            "verseOrgIds": [
              "DEU.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukoboselie buli ekolooba nio ebiimbe akone liilo mala alakhubiita chikhabi. Ne niko okholile ako kalaba kamaluungi ebweeni wa Wele Omunyali Owa Bioosi, Wele wowo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
