                "loc": "EZK.18.20"
              },
              "items": [
                {
                  "text": "Esek. 18.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bapaapa se beerwa khulwe bumayaanu bwe babaana babwe tawe, ne babaana nabo se beerwa khulwe bumayaanu bwe bapaapa tawe. Buli mundu aleerwa khulwe bumayaanu bwewe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.16",
