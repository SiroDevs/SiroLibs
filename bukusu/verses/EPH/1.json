              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.1"
              },
              "items": [
                {
                  "text": "19.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ebarwa khukhwama khu Paulo, oli omurumwa owa Yesu Kristo, khulwe lilienya lia Wele, khu baandu ba Wele, mu Efeso bali basuubilwa mu bulamu bwabwe mu bulala ne Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
            "verseOrgIds": [
              "EPH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekha Paapa Wele ne Omwami Yesu Kristo bamuelesie enywe kumwalaalo ne kumuleembe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikhabi cha Roho mu Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.2",
            "verseOrgIds": [
              "EPH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekha khuupe orio khu Wele lundi Paapa owo Mwami wefwe Yesu Kristo! Sikila mu buambaani bwefwe ne Kristo akhubiita chikhabi khulwe khukhuelesia buli ekhabi eya Roho mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.3",
            "verseOrgIds": [
              "EPH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibala ne sikhabuumbwa tawe Wele yaba akhurobora efwe khaale khuba babewe khubirira mu buambaani bwefwe ne Kristo, nio khwole khuuba batakatifu, lundi bakhali ne kamabi ebweeni wewe tawe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.4",
            "verseOrgIds": [
              "EPH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila busiime bwewe ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.4",
            "verseOrgIds": [
              "EPH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele aba abisia khaale ali khubirira mu Yesu Kristo alakhukhola efwe khube babaana bewe, kano kaaba busangaafu ne sifuno siewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.5",
            "verseOrgIds": [
              "EPH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khekhufumie Wele khulwe kumwalaalo kwewe kwe luyali, khulwe siianwa sia busa nisio akhuelesia efwe mu Mwana wewe Omukoosi! ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.6",
            "verseOrgIds": [
              "EPH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.14"
              },
              "items": [
                {
                  "text": "Bakol. 1.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sikila khulwe kamafuki ka Kristo khuli balekhuule, bubwoni bwefwe bwabeelwa. Kumwalaalo kwa Wele kuli kumuboofu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.7",
            "verseOrgIds": [
              "EPH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akhuelesia efwe mu sikelo siboofu!",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.8",
            "verseOrgIds": [
              "EPH.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu limanya liewe lioosi ne limanyilisia lie mukari ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.8",
            "verseOrgIds": [
              "EPH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele akhola nisio afunaana, mala akhubuulila efwe khwamanya lirekekha lie abwikisi nilio aba abisia khaale khulimalila, khulwa Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.9",
            "verseOrgIds": [
              "EPH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lirekekha lino nilio, Wele alimalila nga siise sisiolaana ne siliola, khuli khureera bibiindu bioosi alala, buli siindu siosi siosi mwikulu ne khu sibala, ne Kristo nga kumurwe kwabio.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.10",
            "verseOrgIds": [
              "EPH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.10",
            "verseOrgIds": [
              "EPH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bibiindu bioosi bikholwa khuloondekhana ne lirekekha lia Wele, ne Wele akhurobora efwe khuba babaandu bewe mu buambaani ne Kristo, sikila lilienya liewe omwene, khuloondekhana khu niko aba ne abisia khukhwama mu khurakikha khukhwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.11",
            "verseOrgIds": [
              "EPH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekha nono efwe, khukhwaba be khunyoa khu khweyikina mu Kristo, khufumie luyali lwa Wele!",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.12",
            "verseOrgIds": [
              "EPH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.12",
            "verseOrgIds": [
              "EPH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne akhaba enywe mwesi mwekela babaandu ba Wele nga mwaulila elomo eya ng'ali. Elomo Endayi eyamureerera buonia mu Kristo, mala Wele amurakho simanyisio sisiokesia sili enywe muli babewe khulwe khumuelesia Roho Omutakatifu niye amusuubisia. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.13",
            "verseOrgIds": [
              "EPH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho ali rubuni eyekesia bali khukhanyoole niko Wele asuubisia babaandu bewe, ne lino likhusuubisia efwe lili Wele alaana bulekhuule mu bwichufu khwaabo bali babewe. Lekha khufumie luyali lwewe!",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.14",
            "verseOrgIds": [
              "EPH.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisaba lia Paulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.14",
            "verseOrgIds": [
              "EPH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwe sifuno sino, khukhwama nga ne naulila ke lisuubila lienywe mu Mwami Yesu ne busiime bwenywe khulwe babaandu ba Wele boosi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.15",
            "verseOrgIds": [
              "EPH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "se nalekha khukhupa orio khu Wele sikila enywe tawe. Mukhebulilanga mu lisaaya liase, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.16",
            "verseOrgIds": [
              "EPH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala ndeeba Wele wo Mwami wefwe Yesu Kristo, Paapa we luyali, amuelesie enywe Roho, olamukhola mukesiie, mala amufunulile Wele, nio mumumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.17",
            "verseOrgIds": [
              "EPH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saba ndi kamebaasio kenywe koole khukhwikulwa mubone buwaanga bwewe, nio mulamanya lilieyikina nilio amulangila lili siina, chikhabi nicho asuubisia babaandu bewe chili che buiinda bwe khuukia, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.18",
            "verseOrgIds": [
              "EPH.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bunyali buno buli bukali lukali khu milimo mwifwe khu suubila. Bunyali bukhola kimilimo mwifwe buno, buli busa bulala nga kamaani kamakali ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.19",
            "verseOrgIds": [
              "EPH.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Chiny. 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " niko arumikhira khulamusia Kristo khukhwama mu lifwa mala amwikhasia kumukhono kwewe kumuseecha mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.20",
            "verseOrgIds": [
              "EPH.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristo aruka ebweeneyo khukhila baruki be mwikulu boosi, be bunyali, be kamaani, ne babaami, ali ne lisina likhila kamasina koosi ke bunyali mu sibala sino ne sisiicha. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.21",
            "verseOrgIds": [
              "EPH.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.8.6"
              },
              "items": [
                {
                  "text": "Chiny. 8.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wele ara bibiindu bioosi aasi mu bikele bia Kristo mala amuana khu kanisa nga Omwami omukali khu biindu bioosi. ",
          "type": "text",
          "attrs": {
