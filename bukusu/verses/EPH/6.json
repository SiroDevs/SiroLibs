              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paapa Wele ne Omwami Yesu Kristo bakhoya baelesie bawandaayefwe bakristo kumuleembe ne busiime ne lisuubila. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
