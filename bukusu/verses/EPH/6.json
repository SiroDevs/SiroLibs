          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumwalaalo kwa Wele kube nabo boosi babasiima Omwami wefwe Yesu Kristo ne busiime bukhaliwa tawe.",
          "type": "text",
