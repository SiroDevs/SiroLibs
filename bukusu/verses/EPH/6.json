              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko kakila ne muruma niye khwinywe, khumuboolela nga efwe fweesi ne khulikho khuchiililila ne khumuramo enywe kumwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
