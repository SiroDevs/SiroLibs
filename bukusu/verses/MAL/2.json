      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aboolela basaayi ali, “Enywe basaayi, lino lili lilaka khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.1",
            "verseOrgIds": [
              "MAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwola mumbe luyali mu bikholwa bienywe. Mwaba ne mukharekeeresia elomo niyo muboolela tawe, aba ndamulaama enywe ne bibiindu nibio munyoolanga khulwe buyeeti. Ne ng'ali nabilaamile khale sikila enywe se muli ne sinani khuria lilaka liase tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.2",
            "verseOrgIds": [
              "MAL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaukuuma babaana benywe mala maale mumoni mwenywe buuse bwe bibiaayo nibio muaananga ne embosio mala murusie enywe ebweeni wase. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.3",
            "verseOrgIds": [
              "MAL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.11+NUM.3.12+NUM.3.13"
              },
              "items": [
                {
                  "text": "Khub. 3.11-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio mulimanya muli ese namuelesia enywe kamalaka kano nio endakaano yase ne basaayi be lisaaye lia Lawi elekhe khufunikha tawe.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.4",
            "verseOrgIds": [
              "MAL.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
