        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Bar. 9.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Babaandu ba Isiraeli baliba nga kumuyekhe kwe mu nyanja, bakhabalikha namwe khukelwa tawe. Ne abuundu niio baboolelwa bali, “Enywe se muli babaandu base tawe,” ao baliboolelwa bali, “Enywe Muli Babaana Ba Wele omenyile mindali!” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono babaandu ba Yuda ne babaandu ba Isiraeli balibuusiana alala. Balirobora omwimeelesi mulala mala baliindiala mu sibala siabwe. Ng'ali eliba endaalo emboofu eya Yesireeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
