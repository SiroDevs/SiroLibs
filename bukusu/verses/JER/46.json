            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi, Wele owa Isiraeli aloma ali, “Lola ese ndikho ndeera siiukuumo khu Amoni wele owa Tebesi ne khu Farao ne sibala siewe sia Misiri, ne khu bawele basio, ne babaami ne nabo babamusuubila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabaana khwaabo bayiima khubeera, ndabakaanisia Nebukadinesa, omwami owa Babiloni ne khu bemeelesi bewe. Enyuma wako, babaandu balamenya lundi mu sibala sia Misiri nga bamenyanga khale.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
        }
      ]
