        },
        {
          "text": "Wele Omunyali Owa Bioosi aboolela Yeremia ali, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
