          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Wele Omunyali Owa Bioosi aloma ali, “Naaba ne khakhola endakaano yase eye kumuusi ne siilo, ne kamalaka ke mwikulu ne sibala tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
