          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wele Omunyali Owa Bioosi aboolela Yeremia ali, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwaba ne munyala khufunaka endakaano yase eye kumuusi nende eye siilo nio kumuusi ne siilo bikhabao mu siise siabio sisiaroborwa tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nono aba akhaba endakaano yase ne Daudi omukholi wase yosi enyala khufunakwa nio akhabao omwana khu be lisaaye liewe oliikhala khu ndebe yewe eye bubwami amiie tawe. Akhaba lundi se munyala khufunaka endakaano yase eye basaayi be nju eya Lawi bakholi base tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
