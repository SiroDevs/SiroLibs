          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Babaandu balikho baloma bali abuundu ano ali nga sichiimi, bali se aliio omundu namwe esaang'i emenyile ano tawe mala baloma ng'ali, chingoba cha Yuda ne chingila cha Yerusalemu omundu namwe esaang'i selikho tawe. Ne kakhali mukhaulile lundi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
