            "number": "24",
            "style": "v",
            "sid": "JER 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ewe se warekeeresie niko babaandu bano balikho baloma bali, ‘Wele Omunyali Owa Bioosi alobile chinju chibili cha Isiraeli ne Yuda nicho arobora tawe?’ Khwako balekeleesie babaandu base ne luno se bali ekholo ebweeni wabwe lundi tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
