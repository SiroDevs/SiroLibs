          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Basoleeli ba Yuda bakholile kamamayaanu mu moni chase. Bengisie bisinyisia munju eyalangilwa khu lisina liase khukinyaalutia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
