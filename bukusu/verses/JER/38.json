              "items": [
                {
                  "text": "Esek. 33.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne Yeremia amenya khu luuya lwe lichipi lio mwami khukhwola khu ndaalo niyo baambilakho Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
