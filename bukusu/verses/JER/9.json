          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Lola chindaalo chilikho chiicha nicho khaukuumilemo babaandu babakhebwa busa kimibili kiabwe kiong'ene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaukuuma babaandu ba Misiri, Yuda, Edomu, Baamoni, Moabu, ne naabo boosi bamenyile mu siangalaamwe babekanga lichuune liabwe. Babaandu bano boosi bali babaandu ne kakhali se batiila kumwiima kwe busaani tawe. Se aliio owatiila likhuwa liase tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
