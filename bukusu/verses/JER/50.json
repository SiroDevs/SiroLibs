              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.2",
            "verseOrgIds": [
              "JER.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sikila ekholo khukhwama ebunaswa yechile khukhwibwaakala Babiloni. Elakhola sibala sibe sichiimi, ne se siliio silasimenyamo tawe. Babaandu ne chisaang'i bilelukha.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.3",
            "verseOrgIds": [
              "JER.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likobola lie Baisiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.3",
            "verseOrgIds": [
              "JER.50.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wele Omunyali Owa Bioosi aloma ali, mu ndaalo echo ne mu biise ebio, babaandu ba Isiraeli ne babaandu ba Yuda, bakhebuusie alala mala beche ne balila. Balimbenja ese Wele Omunyali Owa Bioosi, Wele wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.4",
            "verseOrgIds": [
              "JER.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balireeba engila echa Sayuni mala bachile khu ngila ng'eneyo baliloma bali, ‘yiicha khuambaane ne Wele Omunyali Owa Bioosi mu ndakaano eya mindali ekhaliibililwa tawe.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.5",
            "verseOrgIds": [
              "JER.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.5",
            "verseOrgIds": [
              "JER.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Babaandu base babeele nga kamakheese niko babaayi batibisiilie mu bikulu. Batibile oli kamakheese kakama khu sikulu silala ne kacha khu siindi, mala bebiliile litaala engo wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.6",
            "verseOrgIds": [
              "JER.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boosi ba banyoola babebwaakala. Basiku babwe baloma bali, ‘Efwe se khuli ne kumusaango tawe, sikila babene bakholela Wele Omunyali Owa Bioosi bubwoni. Bakuuka babwe beyikina Wele Omunyali Owa Bioosi andi bosi bara lilieyikina liabwe mu niye.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.7",
            "verseOrgIds": [
              "JER.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
