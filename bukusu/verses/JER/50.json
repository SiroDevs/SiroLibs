                "loc": "REV.18.4"
              },
              "items": [
                {
                  "text": "Lif. 18.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Wele Omunyali Owa Bioosi aloma ali, ‘Baandu ba Isiraeli, yilukha mu lukoba lwa Babiloni! Ruura mu sibala sie Bakalitayo. Ba be khunyoa, khururamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.8",
            "verseOrgIds": [
              "JER.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila ese nja khusokosia mala ndeere khu Babiloni sipupu sie chikholo chimboofu khukhwama mu sibala sie bunaswa mala balebwaakala Babiloni. Balalwibwaka mulala sia mulala mala baluule. Bali banamae barana bakhaloota busa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.9",
            "verseOrgIds": [
              "JER.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babiloni lulanuulwa ne boosi balunuula balibukula bioosi nibio benya. Ese Wele Omunyali Owa Bioosi nalomile.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.10",
            "verseOrgIds": [
              "JER.50.10"
            ]
          }
        }
      ]
    },
