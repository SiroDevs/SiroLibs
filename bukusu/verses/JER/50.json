                {
                  "text": "Lif. 18.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Laanga balasi be buembo ne nabo boosi bamanyile khukhwesa luyiingo bebwaakale Babiloni. Lubotookhelele. Omundu yesi yesi akhebachakho tawe. Rungia Babiloni khuloondekhana ne bikholwa bialwo. Sikila mu khwebonia lwafwochoole Wele Omunyali Owa Bioosi Omutakatifu owa Isiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.29",
            "verseOrgIds": [
              "JER.50.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Khwako baele ba Babiloni balererwa khu ngila che mu lukoba, ne banamae balwo boosi balabuna khu ndaalo eyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
