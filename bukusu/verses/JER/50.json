            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.27",
            "verseOrgIds": [
              "JER.50.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 50:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bamula khukhwama mu sibala sia Babiloni ne becha Yerusalemu, mala baboola nga Wele Omunyali Owa Bioosi, Wele wefwe ne eacha khu niko Babiloni siakhola khu Lukaangu lwewe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.28",
            "verseOrgIds": [
              "JER.50.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 50:28"
          },
          "items": [
