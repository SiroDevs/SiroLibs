          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24+GEN.19.25"
              },
              "items": [
                {
                  "text": "Lir. 19.24-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nga Wele Omunyali Owa Bioosi onakaka Sodomu ne Komora ne chingoba chichaba siimbi, nio se aliio omundu yesi yesi olimenya mu Babiloni tawe, ne mbao omundu olibiramo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.40",
            "verseOrgIds": [
              "JER.50.40"
            ]
          }
        }
