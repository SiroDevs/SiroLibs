          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.11",
            "verseOrgIds": [
              "JER.50.11"
            ]
          }
        }
