          "items": [
            {
              "text": "\n        Isa. 13.1—14.23",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.1+ISA.47.2+ISA.47.3+ISA.47.4+ISA.47.5+ISA.47.6+ISA.47.7+ISA.47.8+ISA.47.9+ISA.47.10+ISA.47.11+ISA.47.12+ISA.47.13+ISA.47.14+ISA.47.15"
              },
              "items": [
                {
                  "text": "47.1-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kano niko kamakhuwa niko Wele Omunyali Owa Bioosi alomaloma khuloondekhana ne Babiloni, sibala sie Bakalitayo khubirira khu mung'oosi Yeremia:",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.1",
            "verseOrgIds": [
              "JER.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 50:2"
          },
          "items": [
            {
