                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Khwako chisaang'i che mundaa chilamenya ne namuunyu mu Babiloni, akhaba chinyefwe chilamenyamo. Babaandu se balibamo namwe bamenyemo lundi mindali na mindali tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.39",
            "verseOrgIds": [
