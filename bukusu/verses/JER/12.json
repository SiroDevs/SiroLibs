          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremia areeba Wele Omunyali Owa Bioosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bubeeleli bwa Wele Omunyali Owa Bioosi sikila babaandu bewe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisuubisia lia Wele Omunyali Owa Bioosi khu baandu baali embi ne Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali ndi nende nilio ndoma khu baandu bamenyile embi ne Isiraeli baboonake sibala nisio naelesia babaandu base ba Isiraeli, “Kharusie babaandu bamayaanu bano nga okhula kumurongooro mala mbonie Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne enyuma we khubarusiao khabakholele siisa lundi mala khabakobosie lundi buli mundu khu mukabwa kwewe ne buli mundu mu maloba kewe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhabe kari baaba ne bakhamenieelesie beyike chingila che babaandu base, bechubila mu lisina liase bali, ‘Nga Wele Omunyali Owa Bioosi ne amenyile mindali,’ bulayi bwene nga boosi ne beyikia babaandu base khukhwechuba mu lisina lia Baali, ne baliba babaandu base. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali kaaba bali ekholo yosi yosi se eulila tawe, aba ndakibunia mala ngionake.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        }
      ]
    }
  ],
