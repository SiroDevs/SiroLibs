              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.6.19"
              },
              "items": [
                {
                  "text": "Baeb. 6.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.3+HEB.9.4+HEB.9.5"
              },
              "items": [
                {
                  "text": "9.3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne suunga epasia eyo mungakia chayo. Reere Lisanduku lie ndakaano eye kamalaka mala olire enyuma we epasia. Epasia eyo elakabukhasia Abuundu Atakatifu khukhwama Abuundu Atakatifu Lukali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ra sifuunikho khu Lisanduku lie Ndakaano liili Abuundu Atakatifu Lukali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yimisia emesa enje we epasia lubeka lwe ebunaswa, ne siteetwe sie etaa lubeka lwe ebunafubo we liiema, siloleelelane ne emesa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
      ]
