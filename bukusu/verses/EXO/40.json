              "type": "text"
            }
          ]
        },
        {
          "text": "Basaabanga nio ne bengila mu liiema lie kumuse namwe ne bembiiya alutare nga Wele Omunyali Owa Bioosi ne alaka Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
            "verseOrgIds": [
              "EXO.40.32"
            ]
          }
        },
