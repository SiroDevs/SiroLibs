        {
          "text": " Nio lifuumbi liafuuma liiema lie kumuse mala luyali lwa Wele Omunyali Owa Bioosi lwechusia liiema litakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
