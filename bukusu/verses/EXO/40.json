          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ombakha lumako lwabotookhelesia liiema ne alutare mala ara khu silibwa sie lumako olwo epasia. Nono Musa amala kimilimo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
          }
        }
