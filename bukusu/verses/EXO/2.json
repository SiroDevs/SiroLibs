                  "text": "Lir. 15.13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wele aulila khulila khwabwe mala aakhebulila endakaano yewe ne Aburahamu, Isaaka ne Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.24",
