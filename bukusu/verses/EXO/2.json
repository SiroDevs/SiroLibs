          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetiro areeba bakhaana bewe ali, “Ali waena? Siina sikila ne mu mulekhile? Mulaange, eche khulie siakhulia naye.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.20",
            "verseOrgIds": [
              "EXO.2.20"
            ]
          }
        }
