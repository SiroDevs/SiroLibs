            "sid": "EXO 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Musa afukiilila khumenya eyo, mala Yetiro aamuelesia omukhaana wewe Sipora aaba omukhasi wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
            "verseOrgIds": [
              "EXO.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sipora asaala omwana owe sisoleeli mala Musa aaloma ali, “Ese ndi omukwa mu sibala sino, khwako ndamutiuukha lisina ndi, Kerishomu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.22",
            "verseOrgIds": [
              "EXO.2.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.22",
              "type": "text"
            },
            {
              "text": "Kerishomu:",
              "type": "text"
            },
            {
              "text": "lisina lino lilomekha nga lie Lueburania lilomekha lili “Omukeni.”",
              "type": "text"
            }
          ]
        }
      ]
    },
