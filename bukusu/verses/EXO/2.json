          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele aabona Baisiraeli mala aamanya niko babaamo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.25",
            "verseOrgIds": [
              "EXO.2.25"
