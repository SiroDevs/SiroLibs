              "items": [
                {
                  "text": "27.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Okhanaania omukwa tawe, omanyile nga kumwoyo kwo omukwa ne kuli. Sikila mwesi mwaba baakwa mu Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        }
      ]
