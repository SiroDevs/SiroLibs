              "items": [
                {
                  "text": "Likh. 16.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Okhonaka bung'ali bwe kumusaango kwo omutaambi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okharakho omundu kumusaango kwe bubeeyi tawe. Lundi okheera omundu okhali ne bubi namwe omuluungi tawe, sikila se nja khubeela omundu okhola bumayaanu nga obwo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhafukiilila asoya tawe. Sikila asoya ebofusia babemeelesi ne khurusia babaandu khu bung'ali.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
    },
    {
