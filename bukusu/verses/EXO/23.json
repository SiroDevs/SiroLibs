                  "text": "Likh. 5.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Okhalomaloma kamakhuwa niko oulilekho busa tawe. Lundi okhayeeta omundu okholile kamabi khulwe khuaana buloli bwe bubeeyi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhaloonda bakali mu khukhola kamabi tawe. Ne okharusia buloli mu makhuwa kosi kosi mu khuloonda busa ke bakali tawe. Wakhola orio aba ocha khwonaka bung'ali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Bal. 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne okhakholela omutaambi siisa mu musaango kwewe sikila ali omutaambi tawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
      ]
    },
    {
