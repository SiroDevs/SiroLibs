              },
              "items": [
                {
                  "text": "26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Reera munju ya Wele Omunyali Owa Bioosi, Wele wowo likesa lie khunyoa khukhwama mu mukuunda kwowo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
