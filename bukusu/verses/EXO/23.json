            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ocha khumiicha mu mukuunda mwowo khu miiko sita ne khukesa biakhulia biamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kulekhe kukonele mu mwiiko kukhola saba, okhakulima tawe. Bataambi banyala balia sibuukhamo, ne chisolo che mundaa nacho chinyala chalia nibio bataambi balekhamo. Khola orio ne khu mikuunda kiowo kie kimisabibu nende kie kimiseituni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
