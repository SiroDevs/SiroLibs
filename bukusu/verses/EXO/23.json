              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ba barekeerefu khukhola koosi niko muboolele. Okhalomaloma khu masina ke bawele babaandi tawe, kamasina kano kakhaamakho mu khanwa mwowo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
