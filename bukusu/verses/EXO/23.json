            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Waaba ne wakaanana ne khaafu namwe epunda yo musiku wowo ne etibile, kikoboselie omweeneyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obona epunda yo mundu owakhubiila ne ekonile asi khulwe bisutwa bisiro okhalekha khumuyeeta tawe. Muyeete enyosie epunda yewe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
    {
