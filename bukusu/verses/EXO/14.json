              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Wele Omunyali Owa Bioosi aaonia Baisiraeli khukhwama khu Bamisiri endaalo ng'eneyo. Baisiraeli babona Bamisiri bafwiile, bali khu sikingiki sie nyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Baisiraeli ne babona kumulimo kumuboofu nikwo Wele Omunyali Owa Bioosi aakhola khu Bamisiri, bamuria mala bamusuubila niye ne omukholi wewe Musa.",
          "type": "text",
