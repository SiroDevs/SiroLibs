          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "liliosia liruunga liliosia, bukhupe buruunga bukhupe, ling'uukha liruunga ling'uukha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
            ]
