            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Babaandu babili ne balomana mala omundu mulala aapa owasie libaale namwe sifuusi, mala alekha khumwiira tawe, ne kakhali omundu niye apile alwaale. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma wako aba ne enyokha mala akeendela khu siimbo yewe, omundu owamupa akhoya amuruunge khulwe biise nibio omulwale atibia, mala amusilikhe khukhwola nga ne aliona. Ne kakhali owamupa oyo akheerwa tawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        }
