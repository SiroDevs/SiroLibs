            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Babaandu babili ne bapana mala baumisia omukhasi owaesia enda yarura. Ne kakhali omukhasi oyo ne akhaumiiakho osi osi tawe, omundu omuumisie akhoya aruunge kumuruungo. Ne akharuunge kumuruungo nikwo omuseecha owo mukhasi enya khuloondekhana ne likhalaka lie bakhalaki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhasi omwene aaba ne aumiia, siiukuumo sicha khuba bulamu buruunga bulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
