        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kaaba bali omundu afuunula liloo namwe ayaba liloo mala alekhe khu lifuunikha tawe, mala eeyi namwe epunda yo mundu okundi ekwemo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "akhoya aruunge chirupia khu mweeneyo, mala efwiile echa khuba yewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
            "verseOrgIds": [
              "EXO.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne euunwa yo mundu yaaba ne yiira euunwa yo wasie, babaandu abo boombi bacha khukusia enamu mala bakabane chirupia, lundi bacha khukabana enyama eye uunwa efwiile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
              "EXO.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne liaba ne limanyikhana lili euunwa abeele eli ne kumwiima kwe khuuna ne owakibaya se akiliinda tawe, akhoyeele aane euunwa khuruunga euunwa efwiile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.36",
            "verseOrgIds": [
              "EXO.21.36"
            ]
          }
        }
      ]
