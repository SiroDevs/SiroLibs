              "items": [
                {
                  "text": "Mat. 5.38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Emoni eruunga moni, liliino liruunga liliino, kumukhono kuruunga kumukhono, sikele siruunga sikele, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
              "EXO.21.24"
            ]
          }
        },
        {
          "name": "verse",
