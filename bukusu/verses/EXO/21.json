                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne kakhali aaba ne amwiira ne akhamwiluungikhe tawe, anyala amulila abuundu niio nja khumuroborera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Omundu aaba ne eera owasie ne amwiluungikhe, mucha khumurusia khu alutare yase mala akhoya eerwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
