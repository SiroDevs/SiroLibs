        },
        {
          "text": " Okhabinamila namwe obikholele tawe. Sikila Ese Wele Omunyali Owa Bioosi, Wele wowo ndi owe likhendekha. Ndeera siiukuumo khu bapaapa khu baana babwe khukhwola khu selukho eya khataru ne eye khaane eye abo babambiila Ese. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali nekesia busiime buchiililila khu baandu bakali ba basiima ne khuria kamalaka kase.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
