        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banaba epasia eye buusi bubuusi, bunapeenda, bubesemu ne engubo eya katani eyanabwa bulayi. Lundi balunabilakho chikerubi mu ngila eye busicha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakholela epasia eyo chinjeko chine che kimirongooro kiminyaali, mala bakifuunikha ne esahabu. Chingaki che chinjeko chaba che esahabu. Nio bakhola bibale bine bie efwesa bie khurakho chinjeko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi bakholela kumuliango kwe liiema epasia. Epasia eyo yanabwa ne buusi bubuusi, bunapeenda ne bubesemu ne engubo endayi eya katani mu bunabi bwe busicha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhola chinjeko chiraano khulwe epasia yino ne chingaki chacho. Bafuunikha bimuli ne chimbete chabio ne esahabu. Ne kakhali bibale biacho biraano biaba bie kumukasa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
            "verseOrgIds": [
              "EXO.36.38"
            ]
          }
        }
