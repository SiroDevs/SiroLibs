              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Farao alaanga Musa ne Aruni mala aloma ali, “Khemuche muaane chimbosio khu Wele wenywe mu sibala sino.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
