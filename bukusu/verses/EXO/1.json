        "style": "s1"
      },
      "items": [
        {
          "text": "Baisiraeli bapisibwa siibi mu Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
