              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloma ali, “Nondekho! Wele Omunyali Owa Bioosi amueele buuli khu basiku benywe, Bamoabu.” Nio, baloonda khu Ehudi bekha mala baamba kamafubukho niko Bamoabu baba bacha khwambukhilamo Yoritani. Se bafukiilila omundu akhaba mulala yeng'ene ambukhe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.28",
            "verseOrgIds": [
              "JDG.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endaalo eyo beera ambi chielefu ekhumi che banamae balayi lukali be Bamoabu. Se aliio owelukha aona tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endaalo eyo Baisiraeli baula Bamoabu mala kumuleembe kwaba mu sibala khulwe kimiiko kamakhumi munaane.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
        }
      ]
