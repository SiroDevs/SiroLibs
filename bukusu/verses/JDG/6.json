              "JDG.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi amuboolela ali, “kumuleembe kube ne nawe. Okharia tawe. Se olafwa tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidioni ombakhila Wele Omunyali Owa Bioosi alutare mala akitiuukha ali, “Wele Omunyali Owa Bioosi ali kumuleembe.” (Khukhwola luno alutare yino esiima busa e Ofira lukoba lwe kumuliango kwa Abieseri.)",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siilo esio Wele Omunyali Owa Bioosi aboolela Gidioni ali, “Bukula euunwa eya raraao ne euunwa ekiindi eye bukhulu bwe kimiiko saba. Techula alutare eya raraao eya Baali mala rema okwisie asi sifwani sia Asiera, sili siimbi a alutare. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yombakha alutare endaayi khu Wele Omunyali Owa Bioosi, Wele wowo khu ngaaki khwe sisiili sino. Mala bukula euunwa eya khabili, mala okiosie nga siianwa khulwe khurumikhira chiikhu che sifwani sia Asiera nisio oremiremo wakwiisia.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Gidioni abukula bakholi bewe ekhumi mala akhola niko Wele Omunyali Owa Bioosi aba ne amubooleele. Gidioni aba omuri lukali khu baandu be enju yewe, ne khu baandu be mu lukoba khukhwombakha alutare kumuusi, nio akhola ario silo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga babaandu be lukoba ne benyokha makhelebeende endaalo eloondakho, banyoola alutare eya Baali ne sifwani sia Asiera biaremirwe biakwile, mala euunwa eya khabili yaba yoseebwe khu alutare eyaba ne yombakhweo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.28",
            "verseOrgIds": [
              "JDG.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bareebana bali, “Naanu okholile kano?” Bareeberesia mala banyoola bali, Gidioni okhwa Yoashi niye owaba ne alikholile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.29",
            "verseOrgIds": [
              "JDG.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio baboolela Yoashi bali, “Reera omusoleeli wowo ano khumwire! Sikila atechuule alutare eya Baali mala aremire akwisiisie asi sifwaani sia Asiera siili a alutare.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoashi aboolela boosi ba baaba ne bamwichilekho ali, “Enywe mwemile ano khulwa Baali? Mulikho mu mupanila? Yesi yesi olamupanila aleerwa ne bukhaasia tawe. Kaaba bali Baali ali wele, lekha omwene ekhupanile khulwa Alutare yewe yatechulwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.31",
            "verseOrgIds": [
              "JDG.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono khukhwamila ao Gidioni alaangwa Yerubaali",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.32",
              "type": "text"
            },
            {
              "text": "Yerubaali:",
              "type": "text"
            },
            {
              "text": "sifuno sie lisina lino mu Lueburania sili “Lekha baali ekhupanile omwene.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ", lisina liili ne sifuno lili, “Lekha Baali ekhupanile omwene,” Sikila Gidioni akwiisia alutare eya Baali.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Bamidiani boosi, Baamaleki ne chikholo che mu sichiimi chebuusia alala, chambukha luluuchi lwa Yoritani mala bebuusia mu litooma lia Yesireeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.33",
            "verseOrgIds": [
              "JDG.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidioni echusibwa ne Roho owa Wele Omunyali Owa Bioosi mala apa ekhoombi khulaanga babaandu be Babieseri bamuloondekho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aruma barume mu sibala sia Manase yoosi khubalanga bamuloondekho. Aruma barume khu kholo cha Asieri, Sebuluni ne Nafutali, mala akhaba boosi becha baambaana ne naye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Gidioni aboolela Wele ali, “Waloma oli ocha khureesia Isiraeli khubirira khwise. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.36",
            "verseOrgIds": [
              "JDG.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikho nda bufuumbo bwe kamakheese asi khu liloba niio khuulilaanga engaanu. Yaaba kumutikhinyi luume ne lulaba khu bufuumbo bwong'ene, ne se lulaba ne asi tawe, aba ndamanya ndi olikho ocha khukhundumikhira ese khuonia Baisiraeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.37",
            "verseOrgIds": [
              "JDG.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio kaba kario. Nga Gidioni ne enyokha makhelebeende endaalo eloondakho akhamulula bufuumbo arusiamo luume lwechula sibuumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.38",
            "verseOrgIds": [
              "JDG.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi Gidioni aboolela Wele ali, “Khakhuaambia lirima tawe, lekha ndomalomekho lundi lulala lwong'ene. Nosiima lekha khole likela liliindi ne bufuumbo. Siise sino lekha bufuumbo bube bubalakafu ne asi abe anyifu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.39",
            "verseOrgIds": [
              "JDG.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Silo esio Wele akhola ario. Endaalo eloondakho makhelebeende, bufuumbo bwaba bubalakafu, ne asi khwiloba aaba luume lwanyisisieo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.40",
            "verseOrgIds": [
              "JDG.6.40"
            ]
          }
        }
      ]
    }
  ],
