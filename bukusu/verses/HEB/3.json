                "loc": "PSA.95.7+PSA.95.8"
              },
              "items": [
                {
                  "text": "Chiny. 95.7-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kamaandiko kaboola kali, “Ne muulila kumumilo kwa Wele luno, mukhaba ne sileka nga bakuuka benywe ne baba nga nilwo bariina khukhwama khu Wele tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.15",
            "verseOrgIds": [
              "HEB.3.15"
            ]
          }
        }
      ]
    },
    {
