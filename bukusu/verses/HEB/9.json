              "type": "text"
            }
          ]
        },
        {
          "text": "Endakaano eye khunyoa yaba ne kamalaka khulwe khusaaya lundi yaba ne abuundu niio babaandu bang'oona khulwe khusaayilao. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
