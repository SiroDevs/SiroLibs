                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.3+DEU.10.4+DEU.10.5"
              },
              "items": [
                {
                  "text": "Likh. 10.3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Alutare eye sahabu eye khukhwoseliakho bupaani, alala ne Lisanduku lie Ndakaano nilio basaa esahabu, ne kumwendo kwe sahabu kukwabamo mana, ne siimbo eya Aruni eyaba ne sisiinekho kamasaafu, ne bipande bibili bie kamabaale bibiaandikwakho kamalaka biabaamo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.18+EXO.25.19+EXO.25.20+EXO.25.21+EXO.25.22"
              },
              "items": [
                {
                  "text": "Khur. 25.18-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bibuumbe bie chindaa bibiekesia khubao khwa Wele, biaba angaaki we Lisanduku lundi biabambula chindaa chabwe choola abuundu niio babeelangao baandu bubwoni. Ne kakhali luno se sili siise sie khukhwinoosia buli siindu mu bwichufu tawe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
      ]
    },
