              "attrs": {
                "loc": "EXO.25.23+EXO.25.24+EXO.25.25+EXO.25.26+EXO.25.27+EXO.25.28+EXO.25.29+EXO.25.30+EXO.25.31+EXO.25.32+EXO.25.33+EXO.25.34+EXO.25.35+EXO.25.36+EXO.25.37+EXO.25.38+EXO.25.39+EXO.25.40"
              },
              "items": [
                {
                  "text": "25.23-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Liiema liombakhwa, ne lusiro lwalio lwe bweeni lwalaangwa Abuundu Atakatifu we Butakatifu. Siteetwe sie khurakho etaa ne mesa eyabakho kumukaati kukwaanwa khu Wele biabamo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Khur. 26.31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Liiema lilialaangwa Abuundu Atakatifu Lukali liaba enyuma we pasia eya khabili. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
