              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mu ngila ne ng'ene, Kristo se ebukulila lukoosi lwe khuba Omusaayi Omukhulu Lukali tawe. Ne kakhali, Wele amuboolela ali,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
