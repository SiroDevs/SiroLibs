      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli Omusaayi Omukhulu Lukali aroborwanga khukhwama mu baandu basie mala akhalabanila Wele mu bwangu bwabwe, khuaana embosio ne biaanwa khulwe bubwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila niye omwene ali omutekhele mu ngila chingali, anyala khuba omuolu khwaabo bakhamanyile siindu tawe lundi bakhola kamakhiikha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.7"
              },
              "items": [
                {
                  "text": "Bal. 9.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne sikila niye omwene ali omutekhele, khukhwola aane embosio ne se khuli khulwe bubwoni bwe babaandu busa tawe ne kakhali akhaba khulwe bubwoni bwewe omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1"
              },
              "items": [
                {
                  "text": "Khur. 28.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Se aliio owiroboreranga omwene lukoosi lwe khuba Omusaayi Omukhulu Lukali tawe. Lili busa khubirira mu mulaango kwa Wele, nio omundu abe Omusaayi Omukhulu Lukali, bulayi bwene nga Aruni ne aaba.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        }
      ]
    },
