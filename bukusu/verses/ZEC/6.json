          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu bamenyile aleeyi baliicha bayeete khukhwombakha lundi Lukaangu lwa Wele Omunyali Owa Bioosi. Ne kano ne kekholekha, mulimanya muli Omwami Owe Banamae anduma ese khwinywe. Bino bioosi biliekholekha mwaba ne muria endakaano eya Wele Omunyali Owa Bioosi, Wele wenywe mu bwichufu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        }
      ]
    }
