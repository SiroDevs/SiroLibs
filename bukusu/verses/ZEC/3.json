              "items": [
                {
                  "text": "Lif. 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu malola kakaandi Wele Omunyali Owa Bioosi anjekesia Omusaayi Omukhulu Lukali Yoshua emile ebweeni wa malaika owa Wele Omunyali Owa Bioosi. Ne alubeka owa Yoshua Sietani aba emileo enya khumusitaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.9"
              },
              "items": [
                {
                  "text": "Yudi 9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio Malaika owa Wele Omunyali Owa Bioosi aboolela Sietani ali, “Wele Omunyali Owa Bioosi akhoya akhwikiiche ewe Sietani! Wele Omunyali Owa Bioosi owasiima Yerusalemu, akhoya akhwikiiche! Omundu yuno ali nga lukhu nilwo bayuula khukhwama mu mulilo.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
