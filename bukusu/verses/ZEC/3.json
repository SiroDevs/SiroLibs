              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua aba emile ebweeni wa malaika afwarire chingubo chinjaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika aboolela bakholi bewe be mwikulu ali, “Mufuule chingubo chinjaafu nicho afwarire.” Nio malaika aboolela Yoshua ali, “Lola nakhurusiisiekho bubwoni bwowo mala ndakhufwara chingubo chimbia.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio malaika arusia lilaka bakholi bewe bafware Yoshua sileemba similiiu khu murwe kwewe. Bakhola bario, mala lundi bamufwara chingubo chimbia malaika owa Wele Omunyali Owa Bioosi ne emileo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
