              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.1"
              },
              "items": [
                {
                  "text": "Esek. 47.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.38"
              },
              "items": [
                {
                  "text": "Yn. 7.38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Lif. 22.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu biise ebio kameechi ke bulamu kakhaame Yerusalemu. Enusu kakhache mu nyanja niyo balaanga bali eya chumbe ne kakaandi mu nyanja eya Mediterenia kalibisia biise bioosi mu siimiyu ne mu munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siise esio, Wele Omunyali Owa Bioosi akhabe omwami we sibala sioosi, ne buli mundu akhamusaaye niye nga Wele mala amumanye khu lisina lieneli.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lukoongo lwoosi khukhwama Keba ebunaswa khukhwola Rimoni ebunafubo owa Yerusalemu lukheekele kumweyeywe. Ne kakhali Yerusalemu lulibonekha angaaki khukhwama khu silibwa sie Babenjamini khukhwola abuundu we silibwa sikhale, khukhwola khu silibwa sie mukoona, lundi lulibonekha angaaki khukhwama khu ndeleelwa eya Hananeli khukhwola niio basurira endali yo mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.10",
            "verseOrgIds": [
              "ZEC.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.3"
              },
              "items": [
                {
                  "text": "Lif. 22.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne babaandu bakhamenye mu Yerusalemu mu muleembe ne se bakharikhirisibwe lundi tawe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi akhareere bulwaale bubi khu baandu boosi babebwaakala Yerusalemu. Balibola ne bakeenda. Chimoni chabwe chilibola ne chisili mu bikhookho, ne chinimi chabwe chilibola ne chisiili mukhanwa mwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.12",
            "verseOrgIds": [
              "ZEC.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.12",
            "verseOrgIds": [
              "ZEC.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mu siise esio Wele Omunyali Owa Bioosi akhabareerere likoyaana nio buli mundu akhakaluukhane khu wasie oli siimbi amwibwaakale. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.13",
            "verseOrgIds": [
              "ZEC.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu ba Yuda bakhapane khuliinda lukoba lwa Yerusalemu. Bakhayaaye kimiaandu kie chikholo choosi biindu nga esahabu, efwesa ne chingubo chingali po.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulwaale bubi bulikwa akhaba khu farasi, chinyumbu, chingamia, chipunda ne chisaang'i chosi chosi nicho basiku baliba nacho mu biabuusi biabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 14:16"
          },
          "items": [
            {
              "text": "16",
