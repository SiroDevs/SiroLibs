              "ZEC.14.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.39+LEV.23.40+LEV.23.41+LEV.23.42+LEV.23.43"
              },
              "items": [
                {
                  "text": "Bal. 23.39-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nio boosi bakhaone khukhwama mu kholo chichebwaakala Yerusalemu. Balicha ebweeneyo buli kumwiiko khusaaya Omwami, Omwami Owe Banamae ne khukhola Naikara eye Bisali. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.16",
            "verseOrgIds": [
              "ZEC.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaaba bali chikholo chiili khu sibala se chiicha Yerusalemu khusaaya Omwami, Omwami Owe Banamae tawe, aba efula se ekhakwe mu sibala siabwe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.17",
            "verseOrgIds": [
              "ZEC.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaba bali Bamisiri baloba khukhola Naikara eye Bisali, aba bakhanyoole bulwaale nibwo Wele Omunyali Owa Bioosi alikho akwiisia khu Be Chikholo bakhaliindanga Naikara eyo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.18",
            "verseOrgIds": [
              "ZEC.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sino siliba siiukuumo khu Misiri nende Be Chikholo chichiindi boosi babaaba bakhaliinda Naikara eye Bisali tawe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu siise siene esio akhaba kimisiipi kie chifarasi kiliaandikwakho kamakhuwa kano, “Kino kia Wele Omunyali Owa Bioosi.” Chindeekhelo che mu Lukaangu chiliba chindakatifu nga bibuumba bie khu alutare. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.20",
            "verseOrgIds": [
              "ZEC.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
