                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Lif. 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ne ndielesia be lisaaye lia Daudi ne bamenywa ba Yerusalemu kumwoyo kwe siisa ne lisaba. Ne balilola khuyo niye baunaake, balimulila oli omundu ne alila omwana wewe omuteelwa. Balilila lukali oli omundu ne alila omwana wewe omubele. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu siise esio bililo mu Yerusalemu biliba bikali nga bibiaba khu Hatarimoni mu mweyeywe kwa Mekido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli nju mu sibala elilila. Lisaaye lia Daudi, lisaaye lia Nasani, lisaaye lia Lawi ne Simei ne babaandi boosi. Buli nju elilila babaandu bayo, ne baseecha ne bakhasi se bakhalilile alala babaandu babwe tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12+ZEC.12.13+ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.12",
              "ZEC.12.13",
              "ZEC.12.14"
            ]
          }
        }
      ]
