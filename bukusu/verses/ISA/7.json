              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu balibanula buyiingo ne buembo bache baayeyo, sikila sibala sioosi silifunikhwa ne mbululwe ne kamawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
