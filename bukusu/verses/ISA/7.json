            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.5+2CH.28.6"
              },
              "items": [
                {
                  "text": "2 Ke Ch. 28.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu ndaalo nicho omwami Ahasi okhwa Yosamu omwichukhulu Usia amiilamo Yuda, Reseni omwami owa Siria ne Peka, okhwa Ramalia omwami owa Isiraeli, baseelusia liie bapane ne lukoba lwa Yerusalemu, ne se banyala khu luupa tawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Ahasi omwami owa Yuda ne baulila bali Siria baambaanile ne Efuraimu besiindukha kimiooyo, baba ne buuri bukali alala ne babaandu babwe besisiikha busa nga kimirongooro kie mu musiru nikio ekhuungu euucha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele Omunyali Owa Bioosi aboolela Isaya ali, “Ewe cha, no mwana wowo Sheari-yashubu mwakaanane no mwami Ahasi. Mulamunyoola khu miila ambi niio baasonanga chingubo bekhalanga khundulo khwe kumutaaro kuureeranga kameechi khukhwama mu litiisi lie ngaaki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.3",
            "verseOrgIds": [
              "ISA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala omuboolele oli yerekekha, otiile kumwoyo, okharia tawe, lundi okhafwa kumwoyo sikila lirima lio mwami Reseni ne Basiria bewe nende lio mwami Peka se lili lundi lie basiku khukhila liliisi liliama khu bichikhi bibili bibising'eeng'ela mu mulilo kalaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.4",
            "verseOrgIds": [
              "ISA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila Siria ne Efuraimu ne okhwa Ramalia bekhochochile bakholile ekwangwaani embi khwiwe ne khuloma bali, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.5",
            "verseOrgIds": [
              "ISA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "lekha khuche khwibwaakale Yuda khulurikhirisie, lekha khuluule lube lulwefwe mala khwamiie omwana owa Tabeeli abe omwami akari walwo.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami WELE aboola ali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.7",
            "verseOrgIds": [
              "ISA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Simanyisio sia Emanueli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.9",
            "verseOrgIds": [
              "ISA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi Wele Omunyali Owa Bioosi aruma burume bubuundi khu mwami Ahasi naboola ali, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.10",
            "verseOrgIds": [
              "ISA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Reeba Wele Omunyali Owa Bioosi, Wele wowo, simanyisio siakhaba ne sili asi nga emakoombe namwe angaaki nga mwikulu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Ahasi akobosia ali, “Ese sendareeba simanyisio tawe, mala se ndakhaka Wele Omunyali Owa Bioosi tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwilio Isaya akobosia ali, “Ee enju eya Daudi rekeeresia! Mwakholile busa sisiindu sitiiti khunaania babaandu lundi mwenya khunaania ne Wele wase yesi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.13",
            "verseOrgIds": [
              "ISA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.23"
              },
              "items": [
                {
                  "text": "Mat. 1.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khwako Omwami omwene alakhuelesia simanyisio. Lola omukhaana owe yabwana alaesia mala asaale omwana omusoleeli ne olimutiuukha oli, ‘Emanueli’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga naliba nachoile oole khumanya bumayaanu ne bulayi, alilia libonda ne bubuukhi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.15",
            "verseOrgIds": [
              "ISA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila ebweeni omwana chana oyo ne akhamanya nga naloba bumayaanu ne khurobora bulayi tawe, bibala bia Isiraeli ne Siria nibio ewe oriire bilianjukhwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.16",
            "verseOrgIds": [
              "ISA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.16",
            "verseOrgIds": [
              "ISA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wele Omunyali Owa Bioosi alikho acha khukhureerera ewe ne khu baandu bowo ne be nju eye bubwami yoosi chindaalo che butinyu bukhabaakhoo khukhwama mu ndaalo nicho bubwami bwa Isiraeli bwaukhila khukhwama khu Yuda tawe. Alikho acha khureera omwami owa Ashuru khu baapa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ndaalo eyo Wele Omunyali Owa Bioosi alipa kumulusi asakule Bamisiri beche nga chiisi khukhwama aleeyi niio luluuchi lwa Naili lwakabukhanilamo chisakia ne lundi alisakula Baashuru beche khukhwama mu sibala siabwe nga enjukhi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala boosi baliicha bamaasie mu matooma, mu mabina ke chinyaanda ne mu bichakha bie kamawa ne khu mayilwe koosi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ndaalo eyo Wele Omunyali Owa Bioosi aliamisia omubeki khukhwama engelekha we luluuchi lwa Efurati omwami owe Baashuru eche ne lubeko amubeke enywe lichuune, kamaswa ke khu bikele akhaba ne bunwanwa bwosi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ndaalo eyo omubayi alirama ne khaafu ndala ne kamakheese kabili, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
