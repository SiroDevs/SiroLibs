          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se balieyikina chi alutare nicho bombakha babeene tawe, namwe basuubile mu nikio kamakhono kabwe kakhola, mu bifwaani bia wele omukhasi Ashera ne chi alutare che khukhwoseliakho biiunya kumuuya kumulayi tawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
