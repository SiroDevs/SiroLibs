          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga endaalo eyo ne liola chingoba chimboofu chilianjukhwa mala chilekhwe ne chitechulwe ne chili mu maumbu nga chingoba che Bahibi ne Baamori, nga baliba ne belukha babaandu ba Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
