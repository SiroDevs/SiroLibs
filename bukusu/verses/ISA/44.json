        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wele Omunyali Owa Bioosi ali niye Wele yeng'ene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bifwaani bichekheelelwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.8",
            "verseOrgIds": [
              "ISA.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boosi bang'oonanga bifwaani bali busa bukhalamo tawe, ne bawele nibo bakusia bukusi bwe angaaki se bali ne buyeeti tawe. Abo basaayanga bawele bano bali babofu ne se bamanyile siindu tawe, mala baliambwa chisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.9",
            "verseOrgIds": [
              "ISA.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se buli bulayi khung'oona sifwaani sie sibia ne khusisaaya nga wele tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.10",
            "verseOrgIds": [
              "ISA.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mundu osisaayanga aliambwa chisoni. Babaandu bang'oonanga bifwaani bali babaandu busa, se balikho ne sisiindu sisiindi tawe. Khebeche babaoche mu siina, balaba bari lukali mala baambwe chisoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.11",
            "verseOrgIds": [
              "ISA.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubasi abukulanga sitonyi sie sichuuma mala asiiuchila mu mulilo ne kumukuba, asiiranya ne kumukhono kwewe kwe kamaani kusuta enyundo khubasa bichuuma nga ne enya. Nga nabasa aulila enjala, bulesia ne siiluo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.12",
            "verseOrgIds": [
              "ISA.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubeechi akela kumurongooro, akela sifwaani ne lilianda mala abeecha ne mbechelo yewe mala asikhola sifwaani sio mundu, sifwaani sio mundu sie lukoondo lulayi, sie khura munju yewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.13",
            "verseOrgIds": [
              "ISA.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arema kimitarakwa, kimikhoonge namwe sayipurasi khukhwama mu musiru. Abiaala kumukhoonge ne khuliinda efula ekhusie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.14",
            "verseOrgIds": [
              "ISA.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu arumikhirakho kumurongooro lubeka nga chiikhu ne lubeka khulwe khung'oonamo sifwaani. Ne sisiinja sisiindi abwana kumulilo ora mala apa kimikaati, ne lubeka luluundi ang'oonamo wele mala amusaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.15",
            "verseOrgIds": [
              "ISA.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwana kumulilo ne chiikhu osia chinyama alia mala ekura, ora kumulilo mala aboola ali, kuli kumulilo kumulayi lundi kwe luluuya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.16",
            "verseOrgIds": [
              "ISA.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lukhu luramire abechakho sifwaani, mala asisikamila ne khusisaaya. Asisabanga naboola ali, “Ewe oli wele wase mbonie!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.17",
            "verseOrgIds": [
              "ISA.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu nga abo bario bali basilu lukali khumanya nisio bakhola tawe. Bafunyikhililanga chimoni ne kamebaasio kabwe khu bung'ali. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.18",
            "verseOrgIds": [
              "ISA.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukholi we bifwaani se ali ne limanya namwe bukesi bwe khuboola ali, “Chiikhu chindala nosiisie, nakhupila kimikaati khu manda, nosielakho enyama nalia. Ne lukhu lulwarama nabechakho sifwaani. Ese niyooyu ano ninamila sitonyi sie lukhu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.19",
            "verseOrgIds": [
              "ISA.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.19",
            "verseOrgIds": [
              "ISA.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhomba likokhe, chinganakani chisilu chimutiimia, se anyala eonia namwe aloma ali nisio ndilile kumukhono kumuseecha kuno se buli bubeeyi tawe ku?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wele Omunyali Owa Bioosi, Omubumbi lundi omuonia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.20",
            "verseOrgIds": [
              "ISA.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aboola ali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.21",
            "verseOrgIds": [
              "ISA.44.21"
            ]
          }
        }
      ]
    }
