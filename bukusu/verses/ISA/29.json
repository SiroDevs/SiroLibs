              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kamalola kano koosi khwinywe kaliba nga burume nibwo baandiike mu sitabu nisio bafuuniikhe khulwe khusirakho kumuuri. Mwaba ne mu siyilila omundu yesi yesi onyala asooma ne mumuboolela muli “Soma kano,” alaloma ali, “Senyala khusisoma tawe, sikila siafuuniikhwe khulwe kumuuri.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne baelesia omundu okhamanyile khusoma tawe, ne baloma bali, “Soma kano,” alaloma ali, “Senyala khusoma tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lilieyikina lie chindaalo chichiicha",
          "type": "text"
        }
      ]
