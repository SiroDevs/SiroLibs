              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aboola ali:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.16",
            "verseOrgIds": [
              "ISA.3.16"
            ]
          }
        }
      ]
