        "style": "s1"
      },
      "items": [
        {
          "text": "Likoyaana mu Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wele Omunyali Owa Bioosi akhalakila babaandu bewe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Engaani khu bakhasi ba Yerusalemu",
          "type": "text"
        }
      ]
    },
