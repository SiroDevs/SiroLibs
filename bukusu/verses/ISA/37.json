          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika owa Wele Omunyali Owa Bioosi acha mu kambi eya Baashuru mala eera banamae chielefu emia ndala samaniini na tano oli mabwibwi, endaalo eloondakho baba balambalile bafwiile! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.36",
            "verseOrgIds": [
              "ISA.37.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ISA 37:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio, Senakeribu omwami owa Ashuru arekukha, akobola e Ninefe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
