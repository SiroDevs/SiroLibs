              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.25.1"
              },
              "items": [
                {
                  "text": "1 Ke Ch. 25.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne nga babombakhi ne baala kumusiingi kwe Lukaangu lwa Wele Omunyali Owa Bioosi, basaayi beele befwarire chingubo che busaayi, becha ne chikhoombi mukhono mwabwe, ne Balawi be lisaaye lia Asafu bema eyo ne bali ne bibiindu bie khu khuupania alala mu mienya. Bafumia Wele Omunyali Owa Bioosi khuloondekhana nga omwami Daudi owa Isiraeli abekesia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala bemba ne baakanila, ne baelesia Wele Omunyali Owa Bioosi efuma ne khumusiima bali:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    }
