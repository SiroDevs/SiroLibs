                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Pet. 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Enywe Bakhasi, ria baseecha benywe sikila liliene elio lisiimisia Omwami.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
            "verseOrgIds": [
              "COL.3.18"
            ]
          }
        }
