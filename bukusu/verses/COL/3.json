              },
              "items": [
                {
                  "text": "1 Pet. 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanywe baseecha, siima bakhasi benywe, ne mukhaba barafu khu nibo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.19",
            "verseOrgIds": [
              "COL.3.19"
            ]
          }
        },
