              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lioosi lioosi nilio mukhola, likhole ne kumwoyo kwenywe kwoosi, oli mulikho mukholela Omwami ne se bali babaandu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
        {
          "name": "verse",
