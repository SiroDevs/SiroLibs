          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manya muli Omwami akhamue enywe kumuruuru nikwo aabiikhila babaandu bewe. Sikila Kristo ali Omwami owa ng'ali niye mukholelanga. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
