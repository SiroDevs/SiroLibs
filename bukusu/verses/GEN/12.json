        "style": "s1"
      },
      "items": [
        {
          "text": "Wele alaanga Aburamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
