            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau abiyila Yakobo sikila chikhabi nicho raraawe aaba ne abiitile Yakobo, mala Esau elomela ali, “Chindaalo che khulila paapa chilikho chimbiia mala khere Yakobo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.41",
            "verseOrgIds": [
              "GEN.27.41"
            ]
