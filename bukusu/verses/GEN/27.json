          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaka aamuboolela ali, “Wandaayo echile aambea mala aabukuule ekhabi yowo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
