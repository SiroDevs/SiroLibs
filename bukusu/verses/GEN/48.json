          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.21"
              },
              "items": [
                {
                  "text": "Baeb. 11.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nio ababiita chikhabi endaalo eyo ne aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli aboolela Yosefu ali, “Lola ese ndi siimbi khufwa, ne Wele aliba alala ne nanywe. Alimukobosia lundi mu sibala sie bapaapa benywe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.21",
            "verseOrgIds": [
              "GEN.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khutuba khwako nakhuele ewe, ne se bali bawandaayo tawe, lubeka lulala lwe Sikulu, nilwo napana nanuula khukhwama khu Baamori ne embalu yase ne buyiingo bwase.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.22",
            "verseOrgIds": [
              "GEN.48.22"
            ]
          }
        }
      ]
    }
