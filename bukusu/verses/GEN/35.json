              "type": "text"
            }
          ]
        },
        {
          "text": " Nga Isiraeli amenya mu sibala esio, Rubeni acha akona ne Bilia mulalakho khu bakhasi nibo raraawe amenyia busa nga omusaale, mala Isiraeli akaulila",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "35.22",
              "type": "text"
            },
            {
              "text": "mala Isiraeli akaulila:",
              "type": "text"
            },
            {
              "text": "likaluukhasia lilala lie khaale liatasao lili mala abeelela, Lueburania se luli ne kamakhuwa kano tawe.",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        }
      ]
