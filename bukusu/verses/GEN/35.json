          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba okhwa Yakobo baba ekhumi ne babili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaana ba Lea baba Rubeni (omubele owa Yakobo), Simioni, Lawi, Yuda, Isakari ne Sebuluni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaana ba Raeli baba, Yosefu ne Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaana ba Biliia, omukholi owa Raeli baba Dani ne Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaana ba Silipa, omukholi owa Lea baba Kati ne Asieri. Bano nibo babaana ba Yakobo nibo asaalila mu Padani-aramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        }
      ]
    },
