              "type": "text"
            }
          ]
        },
        {
          "text": " Mala Yakobo acha khu Isaaka raraawe e Mamure, namwe Kiriati-Ariba (olwo nilwo lukoba lwa Heburoni) niio Aburahamu ne Isaaka bamenya nga baakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
              "GEN.35.27"
            ]
          }
        },
        {
          "name": "verse",
