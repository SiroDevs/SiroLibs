          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Isaaka akwiisia kumwoyo, acha khu baandu bewe. Aaba akofuule mala babaana bewe, Esau ne Yakobo, bamusiikha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.29",
