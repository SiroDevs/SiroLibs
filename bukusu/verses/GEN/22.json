                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Bikh. 3.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Bikh. 3.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mala khubirira mu lisaaye liowo ndabiita bibala bie khu sibala sioosi chikhabi, sikila wariire kumumilo kwase.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 22:19"
          },
          "items": [
            {
