          },
          "items": [
            {
              "text": "3.20",
              "type": "text"
            },
            {
              "text": "Hawa:",
              "type": "text"
            },
            {
              "text": "sifuno sie lisina lino mu Lueburania sili “bulamu” ne mu lunyilili luno Hawa lilangibwa lili babaandu.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", sikila niye aaba maayi owe babaandu boosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
