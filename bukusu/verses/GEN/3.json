              "text": "3.20",
              "type": "text"
            },
            {
              "text": "Adamu:",
              "type": "text"
            },
            {
              "text": "sifuno sie lisina lino mu Lueburania sili lukano lwe babaandu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " atiuukha omukhasi wewe ali Hawa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
