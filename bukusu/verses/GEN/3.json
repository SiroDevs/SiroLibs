              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nio, Wele Omunyali Owa Bioosi aloma ali, “Nono omundu abeele nga mulala khwifwe, amanyile bulayi ne bumayaanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.22",
              "type": "text"
            },
            {
              "text": "bulayi ne bumayaanu:",
              "type": "text"
            },
            {
              "text": "lola 2.9.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Se enyekhana abutakho kamatuunda ke kumurongooro kwe bulamu kwosi mala alia amenya mindali na mindali tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako Wele Omunyali Owa Bioosi aamuoona arura mu mukuunda kwa Edeni, alime liloba nilio arusibwakho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele aoona omundu khukhwama mu mukuunda kwa Edeni, mala e bukwe we kumukuunda okwo araayo chikerubi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.24",
              "type": "text"
            },
            {
              "text": "chikerubi:",
              "type": "text"
            },
            {
              "text": "lili lisina liliakukha khu lisina lie Lueburania “chikerubi.” Chikerubi chili bilala khu bibuumbe bie mwikulu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ne mbalu eye bumemu eyabotookhelelanga chimbeka choosi khuliinda engila eecha khu murongooro kwe bulamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
