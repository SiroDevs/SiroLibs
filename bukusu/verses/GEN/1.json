              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nio Wele aloma ali, “Lekha khukhole omundu mu fwaani yefwe, ne lukoondo lwefwe, ne lekha bamiie khu ng'eeni, khu nyuni, ne khu saang'i choosi, chimbaywa nende che mundaa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
