            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.26",
              "type": "text"
            },
            {
              "text": "khu ng'eeni, khu nyuni, ne khu saang'i choosi, chimbaywa nende che mundaa:",
              "type": "text"
            },
            {
              "text": "likaluukhasia lilala lie khaale liakaluukhasibwa lili chisaang'i ne chisolo chimbaywa nende che mundaa, ne Lueburania luli chisaang'i ne chimbaywa ne liloba lioosi ne khu buli sindu simoola khu liloba.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ", chimboofu ne chindiiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        },
