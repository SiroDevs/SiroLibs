        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wele Omunyali Owa Bioosi alaka Aburahamu omwana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi abonekhela Aburahamu a mikhoonge kia Mamure, nga aaba ne ekhaale a muliango kwe liiema liewe kumuumu ne kurafue. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.1",
            "verseOrgIds": [
              "GEN.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.2"
              },
              "items": [
                {
                  "text": "Baeb. 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Asuta chimoni abona babaandu bataru bemile ebweeni wewe. Nga ababona arura muliango mwe liiema atima acha khubakaanila. Enama bubweeni bwetiila asi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.2",
            "verseOrgIds": [
              "GEN.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala ababoolela ali, “Baami base, naaba nefukiililwe mumoni chenywe, nemusiima mukhabira busa khu mukholi wenywe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.3",
            "verseOrgIds": [
              "GEN.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kameechi matiiti kari kareerwekho musaabe bikele bienywe mala muolelekho a murongooro ano, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.4",
            "verseOrgIds": [
              "GEN.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nja khureera kumukaati, muliekho nio mubire, sikila mwechile wo mukholi wenywe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.5",
            "verseOrgIds": [
              "GEN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio bamuboolela bali, “Khola nga olomile.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.5",
            "verseOrgIds": [
              "GEN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.5",
            "verseOrgIds": [
              "GEN.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu acha khangu mu liiema khu Sara mala amuboolela ali, “Khola khangu bufu bunosie bikelo bitaru, okaande mala upe kimikaati.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.6",
            "verseOrgIds": [
              "GEN.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala Aburahamu atima khangu sie tuuli abukula emoosi ekhomefu lundi endayi akiia omukholi wewe akhola khangu khukibaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.7",
            "verseOrgIds": [
              "GEN.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu abukula kamafura ke kamabeele ne kamabeele ne chinyama aelesia bakeni bewe mala abemao mu murongooro nga baaba ne balia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.8",
            "verseOrgIds": [
              "GEN.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.8",
            "verseOrgIds": [
              "GEN.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamureeba bali, “Omukhasi wowo Sara ali waena?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
              "GEN.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakobosia ali, “Ali mu liiema.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
              "GEN.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
              "GEN.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.9"
              },
              "items": [
                {
                  "text": "Bar. 9.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne mulala khu nibo aloma ali, “Ekhakobole kumwiiko kukwiicha siise nga sino siri mala Sara omukhasi wowo akhanyoole omwana owe sisoleeli.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sara aaba enyuma wewe, amuliango kwe liiema arekereesie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono Aburahamu ne Sara baba bakofuule lukali, ne Sara aaba ayakama khukhwikhebukha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.11",
            "verseOrgIds": [
              "GEN.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.6"
              },
              "items": [
                {
                  "text": "1 Pet. 3.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio Sara achekha mala aloma busa yeng'ene ali, “Ese nakofuule, ne omuseecha wase yesi akofuule nyala neulila khuba no museecha ku?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi areeba Aburahamu ali, “Siina sikila Sara ne achekha ne khuloma ali, ‘Ese ng'ali nyala khusaala omwana nga ne ngofuule ndi ku?’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.13",
            "verseOrgIds": [
              "GEN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.37"
              },
              "items": [
                {
                  "text": "Lk. 1.37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Siindu siliio sili siaandalafu khu Wele Omunyali Owa Bioosi ku? Kumwiiko kukwiicha siise nga sino siri ekhakobole mala Sara akhasaale omwana owe sisoleeli.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.14",
            "verseOrgIds": [
              "GEN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.14",
            "verseOrgIds": [
              "GEN.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Sara ekaana ali, “Se njekhile tawe.” Sikila buuri bwamuaamba. Wele Omunyali Owa Bioosi amukobosia ali, “Tawe ochekhile.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aburahamu asabila Sodomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio babaandu abo barekukha bacha lubeka lwa Sodomu, Aburahamu acha ne nabo khubaroongia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.16",
            "verseOrgIds": [
              "GEN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Nyala nakisa Aburahamu nisio ndi siimbi khukhola ku? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.17",
            "verseOrgIds": [
              "GEN.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lisaaye liewe licha khuba ekholo emboofu lundi eye kamaani, ne khubirira mu niye bibala bioosi bie khu sibala bilibiitwa chikhabi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.18",
            "verseOrgIds": [
              "GEN.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tawe, sikila namuroboore niye alakiliisie babaana bewe, nende be nju yewe enyuma wewe, barie Wele Omunyali Owa Bioosi ne khukhola buluungi ne bung'ali nio Wele Omunyali Owa Bioosi akholele Aburahamu nga ne amusuubiisie.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aloma ali, “Sikila bililo khu Sodomu ne Komora biabeele bikali ne bubwoni bwabwe buli bubi lukali, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndikho nikhayo mbone, ne kali bali niko bakholile kali bulayi bwene nga bililo nibio ndereerwe namwe ne kakhali kario tawe, ndamanya.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio bayuukha khukhwama ao barakikha khucha Sodomu, ne kakhali Aburahamu aaba asiili ebweeni wa Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.22",
            "verseOrgIds": [
              "GEN.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu eseenda siimbi mala areeba ali, “Olikho ng'ali ocha khubunia omuluungi no mumayaanu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.23",
            "verseOrgIds": [
              "GEN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaaba bali baliyo baluungi kamakhumi karaano mu lukoba, se olalekha khubunia lukoba sikila baluungi kamakhumi karaano balimo abo ta ku? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.24",
            "verseOrgIds": [
              "GEN.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa lie khukhwira omuluungi no mumayaanu likhakhubamo tawe! Omuluungi akhaba busa nga omumayaanu tawe. Lilieneli likhakhubamo tawe. Omukhalaki owe sibala se akhoyela khukhola kali ng'ali ta ku?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.25",
            "verseOrgIds": [
              "GEN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.25",
            "verseOrgIds": [
              "GEN.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele Omunyali Owa Bioosi akobosia ali, “Nanyoola mu Sodomu baluungi kamakhumi karaano ndalekha lukoba lwoosi sikila nibo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu akobosia ali, “Sikila nabeele omunyindaafu lukali khulomaloma khu Wele Omunyali Owa Bioosi, akhaba ne ndi busa lipukhuulu lundi likokhe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono baaba ne bakhali kamakhumi karaano tawe, ne kakhali bali kamakhumi kane na baraano? Olabunia lukoba sikila baramiirekho baraano nio boole kamakhumi karaano?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi amuboolela ali, “Se mbunia lukoba baaba ne balimo baluungi kamakhumi kane na baraano tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu aloma lundi ali, “Nosiima Wele Omunyali Owa Bioosi okhaambwa lirima tawe, ndakhureebakho lundi, ne kaaba bali banyoolekhanamo kamakhumi kataru bong'ene?” Akobosia ali, “Nanyoolamo kamakhumi kataru se mbunia lukoba tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu aloma ali, “Nosiima umbeele khuchiililila khulomaloma khu Wele Omunyali Owa Bioosi. Ne banyoolekhanamo kamakhumi kabili?” Akobosia ali, “Sikila kamakhumi kabili, se endabunia lukoba tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
              "GEN.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
              "GEN.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu aloma ali, “Nosiima Wele Omunyali Owa Bioosi okhaambwa lirima tawe, ndalomaloma busa luno lulala lwong'ene. Banyoolekhanamo ekhumi bong'ene?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akobosia ali, “Sikila ekhumi, se ndalubunia tawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Wele Omunyali Owa Bioosi ne amala khulomaloma ne Aburahamu, arekukha, mala Aburahamu akobola engo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.33",
            "verseOrgIds": [
              "GEN.18.33"
            ]
          }
        }
      ]
