          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau aloma ali, “Ese ndi siimbi khufwa, kumukabwa kwe khuba omubele kuli na bukhala siina khwise?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.32",
            "verseOrgIds": [
              "GEN.25.32"
            ]
          }
        }
