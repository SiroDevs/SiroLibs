        },
        {
          "text": "Mala abona babaana ba Efuraimu be eselukho ekhola khataru, akhaba babaana ba Makiri okhwa Manase bosi balelwa ne Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.23",
            "verseOrgIds": [
              "GEN.50.23"
            ]
          }
        },
        {
