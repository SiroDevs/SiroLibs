          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yosefu aboolela bawandaaye ali, “Ese ndi siimbi khufwa, ne Wele alimukhebulila mala amurusie mu sibala sino, amuyile mu sibala nisio echubila Aburahamu, Isaaka ne Yakobo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.24",
            "verseOrgIds": [
              "GEN.50.24"
            ]
          }
        },
        {
