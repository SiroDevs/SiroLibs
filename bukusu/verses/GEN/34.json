              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babukula kiminyele ne kamatuuli kabwe chipunda ne buli sisiindu siosi siosi sisiaba mu lukoba ne mu lukoongo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
