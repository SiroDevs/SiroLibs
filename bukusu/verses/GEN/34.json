              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babukula kimiaandu kiabwe kioosi ne bakhasi babwe ne babaana, ne buli sisiindu sisiaba mu chinju.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
