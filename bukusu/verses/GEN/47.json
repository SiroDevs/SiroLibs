              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu akobosia ali, “Ndikhola nga ne olomile.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
