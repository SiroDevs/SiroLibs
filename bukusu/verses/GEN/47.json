          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baisiraeli bamenya mu sibala sia Misiri, mu lukoongo lwa Kosieni mala banyoolamo kimiaandu lundi basaalana baba bakali lukali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Yakobo amenya mu sibala sia Misiri kimiiko ekhumi ne saba, nio kimiiko kie bulamu bwa Yakobo kiaba emia ndala ne kamakhumi kane ne kimiiko saba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
              "GEN.47.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 47:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
