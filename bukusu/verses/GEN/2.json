        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.6",
            "verseOrgIds": [
              "GEN.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.45"
              },
              "items": [
                {
                  "text": "1 Bakor. 15.45",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wele Omunyali Owa Bioosi abuumba omundu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.7",
              "type": "text"
            },
            {
              "text": "omundu:",
              "type": "text"
            },
            {
              "text": "lie liloba mu Lueburania kamasina “Omundu” ne “Liloba” kafwaanana mukhulomekha.",
              "type": "text"
            }
          ]
        },
        {
          "text": " owe siseecha khukhwama khu lipukhuulu lie liloba, amufua mu moolu kumuuya kwe bulamu mala omundu aba owe bulamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi ara kumukuunda mu Edeni e Bukwe, mala aramo omundu niye aba ne abuumbile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.8",
            "verseOrgIds": [
              "GEN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.7"
              },
              "items": [
                {
                  "text": "Lif. 2.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "22.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne khukhwama mwiloba Wele Omunyali Owa Bioosi akhola buli murongooro kusiimisia chimoni, lundi kumulayi khu siakhulia, khuchoa. Ne akari we kumukuunda, kwabao kumurongooro kwe bulamu, ne lundi kumurongooro kwe bukesi bwe khumanya kamalayi ne kamamayaanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.9",
            "verseOrgIds": [
              "GEN.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.9",
              "type": "text"
            },
            {
              "text": "kamalayi ne kamamayaanu:",
              "type": "text"
            },
            {
              "text": "khumanya kamalayi ne kamamayaanu namwe khumanya buli siindu.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.9",
            "verseOrgIds": [
              "GEN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luluuchi lwama mu Edeni lulwachukhilisianga kumukuunda, mala ebweeni wa Edeni, lwakabukhanamo lwabamo chinjichi chine. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.10",
            "verseOrgIds": [
              "GEN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwe khunyoa lwaba Pisioni, nilwo lubirira mu sibala sia Habila sioosi niio esahabu eli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.11",
            "verseOrgIds": [
              "GEN.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ne esahabu eye sibala esio eli endayi. Kamabaale kalaangwa kali budeliumu ne kamafura kaunya kumuuya kumulayi kakalaangwa bali Onikisi kosi kaliyo.) ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.12",
            "verseOrgIds": [
              "GEN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lisina lie luluuchi lwa khabili lili Kihoni. Nilwo lulwabotookha sibala sia Kushi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.13",
            "verseOrgIds": [
              "GEN.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.13",
              "type": "text"
            },
            {
              "text": "Kushi:",
              "type": "text"
            },
            {
              "text": "(sia Mesopotamia) namwe sia Esopia namwe sia Sudani.",
              "type": "text"
            }
          ]
        },
        {
          "text": " sioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.13",
            "verseOrgIds": [
              "GEN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lisina lie luluuchi lwa khataru bali Tikiri. Nilwo lubirira e bukwe wa Ashuru. Ne luluuchi lwa khane luli Efurati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi abukula omundu owe siseecha mala amura mu mukuunda kwa Edeni, alime ne khukuliinda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.15",
            "verseOrgIds": [
              "GEN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Wele Omunyali Owa Bioosi alaka omundu ali, “Oli omulekhuule khulia bibiaamo bia buli murongooro kuuli mu mukuunda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.16",
            "verseOrgIds": [
              "GEN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kakhali, bibiaamo bie kumurongooro kwe bukesi bwe khumanya kamalayi ne kamamayaanu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.17",
              "type": "text"
            },
            {
              "text": "kamalayi ne kamamayaanu:",
              "type": "text"
            },
            {
              "text": "lola kumuliango kwa 2.9.",
              "type": "text"
            }
          ]
        },
        {
          "text": " okhalia tawe, sikila mu ndaalo niyo oliliakho, olifwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.17",
            "verseOrgIds": [
              "GEN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
