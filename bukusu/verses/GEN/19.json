              },
              "items": [
                {
                  "text": "Yudi 7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wele Omunyali Owa Bioosi aanya khu Sodomu ne Komora kumulilo kumubuusi khukhwama mwikulu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mala abunia chingoba echo, ne Litooma lioosi ne babamenya mungoba boosi nende buli simelwa sioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
