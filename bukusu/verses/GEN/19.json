          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.32"
              },
              "items": [
                {
                  "text": "Lk. 17.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mukha Luti, owaba enyuma wa Luti ekhebukha mala ekela libaale lia chumbe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        }
