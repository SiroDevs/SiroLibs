          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.20",
            "verseOrgIds": [
              "GEN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukobosia ali, “Bulayi nakhufukiiliile, se ndabunia lukoba nilwo olomile tawe ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khangu! Yilukhila ebweeneyo! Sikila se ndakhola sisiindu siosi siosi ne okholayo tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
    },
    {
