              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.1",
            "verseOrgIds": [
              "ROM.14.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.16"
              },
              "items": [
                {
                  "text": "Bakol. 2.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yakaanila oyo oli omutekhele mu lisuubila, ne okhayingana ne naye khulwe kamebaasio kewe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.1",
            "verseOrgIds": [
              "ROM.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisuubila lio mundu mulala limufukiilila khulia siindu siosi siosi, ne omundu oli omutekhele mu lisuubila alia chinyenyi chong'ene. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.2",
            "verseOrgIds": [
              "ROM.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu olichanga buli siindu akhalekelesia okhalia tawe, ne olichanga chinyenyi chong'ene akhakhalakila olia buli siindu tawe, sikila Wele amufukiilila. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.3",
            "verseOrgIds": [
              "ROM.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe niwe naanu okhalakila omukholi wo mundu okundi? Omwami wewe omwene niye olibisia, omukholi wewe oyo nalibira namwe nalikwa. Ne alibira, sikila Omwami anyala khumukhola abire.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.4",
            "verseOrgIds": [
              "ROM.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.4",
            "verseOrgIds": [
              "ROM.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu mulala ebaasianga ali endaalo nabulebe eyo eli emboofu khukhila chindaalo chichiindi, ne okundi naye ebaasia ali chindaalo choosi chili chifwaanane. Buli mundu akhoyela khukhola bukhalaki bwewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.5",
            "verseOrgIds": [
              "ROM.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo owibaasilia endaalo na bulebe khuba emboofu akholanga ario mu khuria Omwami, yesi yesi olia sisiindu siosi siosi akholanga ario mu lukoosi lwo Mwami, sikila aanilanga Wele orio khulwe siakhulia. Yesi yesi olobanga khulia bibiindu nabulebe, akholanga ario khuria Omwami, mala aanila Wele orio. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.6",
            "verseOrgIds": [
              "ROM.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se aliio omundu khwifwe omenyanga khu lienya liewe liong'ene tawe, namwe se aliio omundu khwifwe ofwa khu lienya liewe omwene yeng'ene tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.7",
            "verseOrgIds": [
              "ROM.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila ne khumenya, aba khumenya sikila Omwami ne khufwa, aba khufwa khulwo Mwami. Nono khwakhamenya namwe khwakhafwa khuli bo Mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.8",
            "verseOrgIds": [
              "ROM.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila Kristo afwa mala alamukha, nio abe Omwami we balamu ne bafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.9",
            "verseOrgIds": [
              "ROM.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.10"
              },
              "items": [
                {
                  "text": "2 Bakor. 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nono ewe, olichanga chinyenyi chong'ene siina sikila nobisia likhalaka khu wandaayo? Ne ewe olichanga sisiindu siosi siosi, siina sikila nolekelesia wandaayo? Fweesi khuliima ebweeni wa Wele akhukhalakile. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.10",
            "verseOrgIds": [
              "ROM.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.23"
              },
              "items": [
                {
                  "text": "Isa. 45.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sikila liiandiko liboolanga lili,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.11",
            "verseOrgIds": [
              "ROM.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhakila wandaayo akhola bubwoni tawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.12",
            "verseOrgIds": [
              "ROM.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono, khekhulekhe khukhalakanila. Ne kakhali, mwolaane khukhalaka khulekha, khukholakho sisiindu siosi siosi sinyala siakhola wandaayefwe etuya namwe akhola bubwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.13",
            "verseOrgIds": [
              "ROM.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buambaani bwase no Mwami Yesu bukholanga mba ne ng'ali ndi siakhulia se siliio siosi siosi sili sinyaalu khu siene busa tawe omundu aba nasuubilanga ali siakhulia silala sili sinyaalu, nono aba siikela sinyaalu khu niye. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.14",
            "verseOrgIds": [
              "ROM.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaba nonyaala wandaayo sikila siakhulia nisio olichanga, aba solakholanga khulwe busiime tawe. Okhalekha siakhulia nisio olia sionaka omundu niye Kristo afwila tawe! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.15",
            "verseOrgIds": [
              "ROM.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhalekha nisio obukulanga khuba silayi siaba ne lisina libi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.16",
            "verseOrgIds": [
              "ROM.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sikila bubwami bwa Wele se buli sisiindu sie khulia ne khunywa busa tawe, ne kakhali buli bwe buluungi, kumuleembe, ne kumwikhoyo nikwo Roho Omutakatifu aananga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.17",
            "verseOrgIds": [
              "ROM.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babaandu ne bakhalabanila Kristo mu ngila yino, basiimisia Wele ne khufukiililwa ne babaandi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.18",
            "verseOrgIds": [
              "ROM.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.18",
            "verseOrgIds": [
              "ROM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono, khukhwola buli lwoosi khwiluungikhe bibiindu bireera kumuleembe ne biyeeta khukhola omundu okundi aba ne kamaani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.19",
            "verseOrgIds": [
              "ROM.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhonaka nisio Wele akholile sikila siakhulia tawe. Biakhulia bioosi binyala bialiibwa, ne kakhali lili likhiika khulia sisiindu siosi siosi sinyala siakhola omundu okundi akhola bubwoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.20",
            "verseOrgIds": [
              "ROM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisiindu silayi sili khulekha khulia enyama, khunywa endali, namwe khukhola sisiindu siosi siosi sinyala siakwiisia wandaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.21",
            "verseOrgIds": [
              "ROM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono siosi siosi nisio wasuubila mu makhuwa kano lekha sibe akari wowo ne Wele. Omundu okheulilanga ali ali ne kumusaango tawe ali ne khabi, ne alikho akhola sisiindu siosi siosi nisio akhalakanga ali sili siluungi! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.22",
            "verseOrgIds": [
              "ROM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aba ne aayaayanga khu nisio alichanga, aba Wele amubiiyanga nga nasilia sikila sikholwa siewe se sili khuloondekhana ne lisuubila tawe. Ne sisiindu siosi siosi sikhali khuloondekhana ne lisuubila tawe, sili bubwoni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.23",
            "verseOrgIds": [
              "ROM.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Siimisia babaandi mukhesiimisia mwabeene tawe",
          "type": "text"
        }
      ]
    }
  ],
