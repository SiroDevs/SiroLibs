              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaandikwa akhaba khulwe babaandu nga efwe, khulafukiililwa nga baluungi, basuubila mu niye owalamusia Yesu Omwami wefwe khukhwama mu lifwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.24",
            "verseOrgIds": [
