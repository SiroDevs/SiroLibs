        },
        {
          "text": "Kamakhuwa, “Afukiililwa nga omuluungi” se kaandikwa khulwa niye yeng'ene tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.23",
            "verseOrgIds": [
              "ROM.4.23"
            ]
          }
        },
        {
