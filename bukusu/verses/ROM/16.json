            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.1"
              },
              "items": [
                {
                  "text": "Bikh. 16.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Timoteo, omukholi wasiaase, amurumiire kimileembe kiewe, ne akhaba Lusia, Chasoni ne Sosipateri Bayaudi basiaase bosi bamukheesia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese, Taritio, omuandiki we barwa yino, namurumiire kimileembe kia Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.22",
            "verseOrgIds": [
              "ROM.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.29"
              },
              "items": [
                {
                  "text": "Bikh. 19.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.14"
              },
              "items": [
                {
                  "text": "1 Bakor. 1.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.20"
              },
              "items": [
                {
                  "text": "2 Tim. 4.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kayo owanjakanila omwenenju niyo e kanisa yakaananilangamo, amurumira kimileembe kiewe. Rasito, omubiikhi we chirupia che Lukoba luno, ne wandaayefwe Kwarito bamurumira kimileembe kiabwe. [ ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.23",
            "verseOrgIds": [
              "ROM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumwalaalo kwo Omwami wefwe Kristo kube nanywe mwesi. Amina.]",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.24",
            "verseOrgIds": [
              "ROM.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisaaya limaliilisi lie fuma",
          "type": "text"
        }
      ]
    },
