      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 3:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aaboolela Musa ali, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.44",
            "verseOrgIds": [
              "NUM.3.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 3:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bukula Balawi mu bweyaangu bwe babele mu Baisiraeli ne chikhaafu chabwe mu bweyaangu bwe che Baisiraeli. Balawi bali babaase: Ese ndi Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
            "verseOrgIds": [
              "NUM.3.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 3:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu Isiraeli balimo babaana babele chimia chibili ne kamakhumi saba na bataru khukhila Balawi. Khusikula bano, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 3:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "bukula bitonyi biraano bie e Shekeli khu buli mulala. Loonda sikelo sie Abuundu Atakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 3:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elesia Aruni ne babaana bewe chirupia che khusikula Baisiraeli chimia chibili ne kamakhumi saba na bataru bano.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
            "verseOrgIds": [
              "NUM.3.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 3:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa abukula chirupia che khusikula Baisiraeli nibo Balawi bakhanyala khubukula bubweyaangu bwabwe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
            "verseOrgIds": [
              "NUM.3.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 3:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama khu buli omubele owa Isiraeli, Musa aabukula chishekeli eelefu ndala ne chimia chitaru ne kamakhumi sita na chiraano. Chakelwa khuloondekhana ne sikelo sie Abuundu Atakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 3:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aelesia chirupia che khusikula khu Aruni ne babaana bewe khuloondekhana nga Wele Omunyali Owa Bioosi ne amulaka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
            "verseOrgIds": [
              "NUM.3.51"
            ]
          }
        }
