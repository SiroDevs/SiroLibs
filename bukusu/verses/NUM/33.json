          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bama Esioni-geberi, baapa ekambi mu sichiimi sia Sini (eyo niyo e Kadeshi.) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.36",
            "verseOrgIds": [
              "NUM.33.36"
            ]
