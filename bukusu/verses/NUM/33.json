              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Aruni aaba ne bukhulu bwe kimiiko emia ndala ne kamakhumi kabili na kitaru nga ne afwa khu lukulu lwa Hori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
