          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bama Kadeshi, baapa ekambi khu sikulu sia Hori, khu lwakha lwe sibala sia Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.37",
