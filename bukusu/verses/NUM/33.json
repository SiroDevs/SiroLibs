          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bama e Aburona, baapa ekambi e Esioni-geberi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.35",
            "verseOrgIds": [
              "NUM.33.35"
