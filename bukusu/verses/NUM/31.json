          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono sitonyi sie babaandu busa siaba: kamakheese chielefu mia tatu salasini na saba ne chimia chiraano, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
            "verseOrgIds": [
              "NUM.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
