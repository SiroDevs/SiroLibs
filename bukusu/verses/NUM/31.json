          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "chikhaafu chielefu salasini na sita, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.44",
            "verseOrgIds": [
              "NUM.31.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
