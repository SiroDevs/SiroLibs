              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono bino bili bibiindu bibiarama khu biindu nibio banamae babukula mwiie: kamakheese chielefu chimia sita ne chielefu kamakhumi saba na chiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
            "verseOrgIds": [
              "NUM.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chielefu kamakhumi saba ne chibili che chikhaafu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.33",
            "verseOrgIds": [
              "NUM.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "chipunda chielefu sitini na moja, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.34",
            "verseOrgIds": [
              "NUM.31.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bakhasi boosi baba chielefu salasini na mbili basiili ne yabwana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
              "NUM.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne sitonyi sie abo babacha mwiie siaba kamakheese chielefu mia tatu salasini na saba ne chimia chiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
            "verseOrgIds": [
              "NUM.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne busuuru bwa Wele Omunyali Owa Bioosi bwaba kamakheese chimia sita ne kamakhumi saba na karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
            "verseOrgIds": [
              "NUM.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikhaafu chaba chielefu salasini na sita ne chikhaafu kamakhumi saba na chibili baruunga busuuru khu Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
              "NUM.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipunda chaba chielefu kamakhumi kataru, ne chimia chiraano ne busuuru bwa Wele Omunyali Owa Bioosi bwaba chipunda kamakhumi sita na ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babaandu baba chielefu likhumi na sita ne kamakhumi kataru na babili baba busuuru bwa Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
              "NUM.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Musa aelesia omusaayi Eliesa busuuru bubwaba siianwa khu Wele Omunyali Owa Bioosi nga Wele Omunyali Owa Bioosi ne alaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
        }
      ]
