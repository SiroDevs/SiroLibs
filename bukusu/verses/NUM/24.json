            "sid": "NUM 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu akobosia Balaki ali, “Se naboolela barume nibo waruma khwise ndi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakhamba enju yowo eyichuulemo efwesa ne esahabu, se enyala nakhola niko Wele Omunyali Owa Bioosi akhenya tawe. Se enyala nakhola libi namwe lilayi mu lienya liase samwene tawe. Nilio Wele Omunyali Owa Bioosi aloma nilio ese ndomaloma.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bung'oosi bwa Balamu bumaliilisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
