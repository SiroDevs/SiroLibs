          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nono ndikho ngobolayo khu baandu base. Nono nenya khukhumanyisia niko babaandu ba Isiraeli bacha khukhola khu baandu bowo mu biise bibiicha.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
