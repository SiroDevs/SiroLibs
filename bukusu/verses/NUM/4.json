          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boosi baba chielefu chibili ne chimia sita ne kamakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.40",
            "verseOrgIds": [
              "NUM.4.40"
            ]
          }
        },
        {
          "name": "verse",
