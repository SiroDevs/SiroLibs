          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu be luuya lwa Merari babalwa khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.42",
            "verseOrgIds": [
              "NUM.4.42"
            ]
          }
        },
        {
