          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babala babaandu khukhwamila khu kimiiko kamakhumi kataru khukhwola karaano buli mundu owanyala khukhola kimilimo mwiiema lie kumuse ne khusuta bibiindu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.47",
            "verseOrgIds": [
              "NUM.4.47"
            ]
          }
        },
        {
