          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ba babalwa boosi baba chielefu munaane ne chimia chiraano ne kamakhumi munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.48",
            "verseOrgIds": [
              "NUM.4.48"
            ]
          }
        },
        {
