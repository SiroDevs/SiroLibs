          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luya lwa Kerishoni lwabalwa, khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.38",
            "verseOrgIds": [
              "NUM.4.38"
