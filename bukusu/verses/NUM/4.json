          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalwa khukhwamila bukhulu bwe kimiiko kamakhumi kataru khukhwola khu miiko kamakhumi karaano, buli mundu owanyala khukhola kimilimo mwiiema lie kumuse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.43",
            "verseOrgIds": [
              "NUM.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
