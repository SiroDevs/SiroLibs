          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo ba baaba be luuya lwa Kerishoni, ba bakhola kimilimo mwiiema lie kumuse. Musa ne Aruni ba babala khuloondekhana ne lilaka lia Wele Omunyali Owa Bioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.41",
            "verseOrgIds": [
              "NUM.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
