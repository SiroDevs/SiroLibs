          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalwa khukhwamila bukhulu bwe kimiiko kamakhumi kataru khukhwola karaano; buli mundu owanyala khukhola kimilimo mwiiema lie kumuse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.39",
            "verseOrgIds": [
              "NUM.4.39"
            ]
          }
