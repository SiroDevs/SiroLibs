              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bala luuya lwa Merari khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
          }
        },
        {
          "name": "verse",
