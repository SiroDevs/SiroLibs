          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukali bwabwe bwaba babaandu chielefu chitaru ne chimia chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.44",
            "verseOrgIds": [
              "NUM.4.44"
            ]
