          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ne Aruni ne babemeelesi be libuusiana babala luuya lwa Koati. Ba babala khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.34",
            "verseOrgIds": [
              "NUM.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babala abo ba baaba ne bukhulu khukhwamila kimiiko kamakhumi kataru khukhwola kamakhumi karaano babanyala khukhola kimilimo mwiiema lie kumuse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.35",
            "verseOrgIds": [
              "NUM.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne boosi ba babalwa boola chielefu chibili ne chimia saba ne kamakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.36",
            "verseOrgIds": [
              "NUM.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nibo ba babalwa mu luuya lwa Koati. Boosi bakhola kimilimo mwiiema lie kumuse. Musa ne Aruni ba babala khuloondekhana ne lilaka lia Wele Omunyali Owa Bioosi khubirira khu Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.37",
            "verseOrgIds": [
              "NUM.4.37"
            ]
          }
        }
