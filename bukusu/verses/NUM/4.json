              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ne Aruni ne babemeelesi ba Isiraeli babala Balawi boosi khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.46",
            "verseOrgIds": [
              "NUM.4.46"
