              "NUM.34.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.1+JOS.14.2+JOS.14.3+JOS.14.4+JOS.14.5"
              },
              "items": [
                {
                  "text": "Yosh. 14.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nio Musa alaka Baisiraeli ali, “Esino sili sibala nisio mucha khunyoola khulwe khukhupa chikura. Sibala sino sili nisio Wele Omunyali Owa Bioosi aelesia chikholo tisa nende balala khu kholo eya Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikholo cha Rubeni ne Kati banyoola kumukabwa kwabwe alala nende balala khu kholo eya Manase. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikholo chibili ne balala khu kholo eya Manase bali ne kumukabwa kwabwe engelekha owa Yoritani, e Yeriko khucha ebukwe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babemeelesi ba baelesibwa kumulimo kwe khukaba kamaloba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele Omunyali Owa Bioosi aboolela Musa ali, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omusaayi Eliesa ne Yoshua okhwa Nuni nibo bacha khukabania babaandu kamaloba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi bukula omwimeelesi mulala khukhwama mu buli ekholo abayeete khukabania.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko kamasina ke babemeelesi: khukhwama mu kholo eya Yuda, Kalebu okhwa Yefune. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama mu kholo eya Simioni, Shemweli okhwa Amihudi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.20",
            "verseOrgIds": [
              "NUM.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama mu kholo eya Benjamini, Elidadi okhwa Kisiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.21",
            "verseOrgIds": [
              "NUM.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama mu kholo eya Dani, Buki okhwa Yokili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.22",
            "verseOrgIds": [
              "NUM.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama mu lisaaye lia Yosefu: mu kholo eye Manase, Hanieli okhwa Efodi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.23",
            "verseOrgIds": [
              "NUM.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mu kholo eya Efuraimu, Kemueli okhwa Sifutani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.24",
            "verseOrgIds": [
              "NUM.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mu kholo eya Sebuluni, Elisafani okhwa Parinaki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.25",
            "verseOrgIds": [
              "NUM.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwamamu kholo eya Isakari, Palitieli okhwa Asani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.26",
            "verseOrgIds": [
              "NUM.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama mu kholo eya Asieri, Ahihudi okhwa Shelomi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.27",
            "verseOrgIds": [
              "NUM.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama mu kholo eya Nafutali, Petaeli okhwa Amihudi. ",
          "type": "text",
          "attrs": {
