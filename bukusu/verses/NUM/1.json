              "NUM.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Asiera baba babaandu chielefu arubaine namocha ne chimia chiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.41",
            "verseOrgIds": [
              "NUM.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu be ekholo eya Nafutali babalwa. Babalwa boosi be siseecha ba baaba ne bukhulu bwe kimiiko kamakhumi kabili ne khukhilakhoo lundi ba baaba banyala khucha mwiie. Babalwa khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.42",
            "verseOrgIds": [
              "NUM.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Nafutali baba babaandu chielefu khamusini natatu ne chimia chine. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.43",
            "verseOrgIds": [
              "NUM.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo ba babalwa ne Musa ne Aruni ne bayeetwa ne babemeelesi be Baisiraeli ekhumi na babili, buli mulala khukhwama mu kholo yewe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.44",
            "verseOrgIds": [
              "NUM.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu boosi babalwa. Babalwa boosi be siseecha ba baba ne bukhulu bwe kimiiko kamakhumi kabili ne khukhilakhoo lundi ba baaba ne banyala khucha mwiie mu Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boosi baba chielefu chimia sita na chitaru, ne chimia chiraano ne kamakhumi karaano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.46",
            "verseOrgIds": [
              "NUM.1.46"
            ]
          }
        }
      ]
