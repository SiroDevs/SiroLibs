          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu be kholo eya Sebuluni baba chielefu khamusini na saba ne chimia chine. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.31",
            "verseOrgIds": [
              "NUM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Yosefu, be luuya lwa Efuraimu, babalwa. Babalwa be siseecha boosi ba baaba be bukhulu bwe kimiiko kamakhumi kabili ne khukhilakhoo, ba baaba banyala khucha mwiie. Babalwa khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.32",
            "verseOrgIds": [
              "NUM.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Efuraimu baba babaandu chielefu arubaine ne chimia chiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.33",
            "verseOrgIds": [
              "NUM.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Manase babalwa. Babalwa be siseecha boosi ba baaba ne bukhulu bwe kimiiko kamakhumi kabili ne khukhilakhoo lundi ba baaba banyala khucha mwiie. Babalwa khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.34",
            "verseOrgIds": [
              "NUM.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Manase baba babaandu chielefu salasini na mbili ne chimia chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.35",
            "verseOrgIds": [
              "NUM.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Benjamini babalwa. Babalwa be siseecha boosi ba baaba ne bukhulu bwe kimiiko kamakhumi kabili ne khukhilakhoo lundi ba baaba banyala khucha mwiie. Babalwa khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.36",
            "verseOrgIds": [
              "NUM.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Benjamini baba babaandu chielefu salasini natano ne chimia chine. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.37",
            "verseOrgIds": [
              "NUM.1.37"
            ]
          }
        },
        {
