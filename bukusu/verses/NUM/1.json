          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Dani baba babaandu chielefu sitini nambili ne chimia saba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.39",
            "verseOrgIds": [
              "NUM.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekholo eya Asieri babalwa. Babalwa be siseecha boosi ba baaba ne bukhulu bwe kimiiko kamakhumi kabili ne khukhilakho, lundi ba baaba banyala khucha mwiie. Babalwa khuloondekhana ne luuya ne chinju chabwe. ",
          "type": "text",
          "attrs": {
