              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu barura khu sikulu sia Wele Omunyali Owa Bioosi bacha lukeendo lwe chindaalo chitaru. Lisanduku lie ndakaano eya Wele Omunyali Owa Bioosi liarangira ebweeni wabwe khu ndaalo chitaru echo khuyiima abuundu niio banyala bombakha ekambi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lifuumbi lia Wele Omunyali Owa Bioosi liaba angaaki wabwe kumuusi buli lwoosi nga barekukhanga khukhwama mu kambi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
