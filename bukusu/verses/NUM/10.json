          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne waaba bali ocha nafwe, kamalayi niko Wele Omunyali Owa Bioosi akhakhukholele efwe, fwesi khukhakhukholele ewe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
        }
      ]
    },
    {
