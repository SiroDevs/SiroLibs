              "items": [
                {
                  "text": "Chiny. 68.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Buli lwosi nga Lisanduku lie ndakaano ne liarekukhanga Musa alomalomanga ali, “Yinyokha, Ee Wele Omunyali Owa Bioosi, mala basiku bowo basalanikhe. Lekha abo ba bakhubiila bakhwilukhe.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli lwosi nga Lisanduku lie ndakaano ne liemanga, alomanga ali, “Kobola, Ee Wele Omunyali Owa Bioosi, khu baandu bowo ba Isiraeli bali bakali, bakhabalikha tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
        }
