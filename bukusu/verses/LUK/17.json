              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babeeka bamureeba bali, “Waena, Omwami?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
