                "loc": "MRK.13.15+MRK.13.16"
              },
              "items": [
                {
                  "text": "Mk. 13.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Khu ndaalo eyo omundu oli khu nju khu ngaaki sakhekhe engile munju yewe abukule bibiewe tawe; ne akhaba oli e mukuunda se alikobola engo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
            "verseOrgIds": [
              "LUK.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
