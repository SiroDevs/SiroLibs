              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.26"
              },
              "items": [
                {
                  "text": "Lir. 19.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Khebulila mukha Luti! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.32",
            "verseOrgIds": [
              "LUK.17.32"
            ]
          }
        },
        {
