              },
              "items": [
                {
                  "text": "Yn. 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omundu yesi yesi okhaka khuonia bulamu bwewe akhabutibie; ne oyo otibia bulamu bwewe akhabuonie! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ali ese muboolela enywe ndi, siilo esio babaandu babili baliba bakonile khu sitanda, mulala alibukulwa nokundi arame. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhasi babili baliba basiela alala, mulala alibukulwa ne okundi arame. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
              "LUK.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Babaandu be siseecha babili baliba ne bakhola mu mukuunda, mulala alibukulwa, ne okundi alilekhwa enyuma.]”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.36",
            "verseOrgIds": [
              "LUK.17.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17.36",
              "type": "text"
            },
            {
              "text": "Chibibilia chindala se chili ne lunyilili luno tawe.",
              "type": "text"
            }
          ]
        }
      ]
    },
