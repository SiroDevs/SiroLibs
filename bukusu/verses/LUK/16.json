              "LUK.16.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.24"
              },
              "items": [
                {
                  "text": "Mat. 6.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Se aliio omukholi onyala akholela bakhoongo babili tawe, sikila anyala abiila mulala mala asiima okundi, namwe anyala aria mulala mala alekelesia okundi. Sonyala wakholela Wele ne kimiaandu tawe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chingano cha Yesu chichiindi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Bafarisayo ne baulila kano balekelesia Yesu sikila basiima chirupia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababoolela ali, “Enywe mwekhola khuba baluungi ebweeni we babaandu ne kakhali Wele amanyile kimiooyo kienywe. Sikila bibiindu bie bukhala bukali khu baandu bili bie lisinye mu moni cha Wele.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
