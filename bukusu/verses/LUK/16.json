        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.12+MAT.11.13"
              },
              "items": [
                {
                  "text": "Mat. 11.12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Lilaka lia Musa ne kamaandiko ke bang'oosi kaba ne kimilimo khukhwola khu Yoana Omubatiisi, khukhwama ao babaandu baboolelwa Elomo Endayi eye Bubwami bwa Wele mala buli mundu arumikhira kamaani khukhwingila mu bwami obwo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.18"
              },
              "items": [
                {
                  "text": "Mat. 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lili liliangu likulu ne liloba khuwao khukhila enyukuta ndala eye Lilaka khurusibwao.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
