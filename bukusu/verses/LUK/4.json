                {
                  "text": "Likh. 6.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu akobosia ali, “Liiandiko liboola lili, ‘Saaya Omwami Wele wowo, ne khumukhalaabanila niye yeng'ene!’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.8",
            "verseOrgIds": [
              "LUK.4.8"
            ]
          }
        }
