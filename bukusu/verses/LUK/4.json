            "style": "v",
            "sid": "LUK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.3",
            "verseOrgIds": [
              "LUK.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.4",
            "verseOrgIds": [
              "LUK.4.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.3"
              },
              "items": [
                {
                  "text": "Likh. 8.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nio Yesu amukobosia ali, “Liiandiko liboola lili, ‘Omundu sanyala khumenya sikila siakhulia siong'ene tawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.4",
            "verseOrgIds": [
              "LUK.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.4",
            "verseOrgIds": [
              "LUK.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio Sietani amuniinia khu sikulu mala amwekesia khangu bubwami bwe sibala sioosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.5",
            "verseOrgIds": [
              "LUK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sietani amuboolela ali, “Ndakhuelesia ewe bunyali buno ne buiinda buno bwoosi. Naebwa bioosi, mala ese nyala naelesia omundu yesi yesi niye samwene nenya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.6",
            "verseOrgIds": [
              "LUK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono, bino bioosi bilaba bibiowo waba ne usaaya ese.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.7",
            "verseOrgIds": [
              "LUK.4.7"
            ]
          }
        }
      ]
    },
    {
