                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne Yesu akobosia ali, “Liiandiko liboola lili, ‘Okhakhaka Omwami Wele wowo tawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.12",
