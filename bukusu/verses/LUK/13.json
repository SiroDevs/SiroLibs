              "items": [
                {
                  "text": "Mk. 10.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Be khunyoa baliba bamaliilisi, ne bamaliilisi baliba be khunyoa.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        }
