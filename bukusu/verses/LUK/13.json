              "LUK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omwenenju ne enyokha mala ekalao, mukharakikhe khukhwima enje ne khukhong'oonda khu lwiki ne muloma muli, ‘Omwami khwikulileo.’ Ne alimukobosia ali, ‘Se manya niio mwama tawe.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.25",
            "verseOrgIds": [
              "LUK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nanywe mulirakikha khu muboolela muli, ‘Khwalia ne khunywa nawe, lundi wekisia mu lukoba lwefwe.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.26",
            "verseOrgIds": [
              "LUK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.6.8"
              },
              "items": [
                {
                  "text": "Chiny. 6.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne alikobosia ali, ‘Ese muboolela enywe ndi se manya niio mwama tawe, ndureo mweesi mukholanga kamamayaanu!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.27",
            "verseOrgIds": [
              "LUK.13.27"
            ]
          }
        },
        {
