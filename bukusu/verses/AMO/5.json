              "type": "text"
            }
          ]
        },
        {
          "text": "Baandu ba Isiraeli, rekeeresia kumwenya kwe kamasika nikwo nja khu mwimbila kuno:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
