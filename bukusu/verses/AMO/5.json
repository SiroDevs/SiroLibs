          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami Owe Banamae aloma ali, “Baandu ba Isiraeli, mu miiko kamakhumi kane kino mwandererakho chimbosio ne biianwa mu sichiimi? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.25",
            "verseOrgIds": [
              "AMO.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "AMO 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne luno, sikila mwasikamiile bifwaani bia Sakusi wele omwami wenywe, ne bia Kaiwani, eng'enieesi wele wenywe, nibio mwekholele mwabene ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
              "AMO.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "AMO 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "khwako ndamuyila mu mbaambe mu sibala siili embotookho wa Damasika.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.27",
            "verseOrgIds": [
              "AMO.5.27"
            ]
          }
