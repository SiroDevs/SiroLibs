        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omunamae omusuubilwa owa Yesu Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ewe, mwana wase, yiiandalasia khubirira mu mwalaalo kuuli kukwefwe mu bulala ne Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.1",
            "verseOrgIds": [
              "2TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekisia babaandu basuubilifu banyala khukhwikisia babaandi bosi kamekisio niko waulila ne nikisia ebweeni we baloli bakali.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wesi khe upwe siibi nga omunamae omusuubilwa owa Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.3",
            "verseOrgIds": [
              "2TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunamae ooli khu milimo enyanga khusiimisia omukhongo wewe, khwako se aba mu makhuwa kakaandi busa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.4",
            "verseOrgIds": [
              "2TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu otima chimbilo se anyala anyoola kumuruuru ne akhaloondile kamalaka ke chimbilo echo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.5",
            "verseOrgIds": [
              "2TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulimi okholile kimilimo ne kamaani akhoyeele anyoola sikelo sie khunyoa mu likesa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.6",
            "verseOrgIds": [
              "2TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yibaasia khu niko ndikho ndoma, sikila Omwami alakhukhola ewe okamanye koosi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khebulila Yesu Kristo, owalamusibwa, owe lisaaye lia Daudi, nga liekisibwa mu Lomo Endayi niyo nilwacha. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ese khupwa siibi lundi bamboyile kiminyololo nga ofunile lilaka sikila nilwachanga Elomo Endayi. Ne kakhali Elomo eya Wele seli mu minyololo tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.9",
            "verseOrgIds": [
              "2TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "khwako nikhaliilikhila buli siindu khulwe babaandu barobore ba Wele, nio bosi banyoole buonia bubwiichanga khubirira mu Yesu Kristo ne khureera luyali lwa mindali. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino lili likhuwa lia ng'ali:",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
              "2TI.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukholi owafukiililwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khebusia babaandu bowo kano, mala obakaambile lukali ebweeni wa Wele balekhe khukhangarana ne kamakhuwa. Se kalikho ne bulayi tawe, ne kakhali khutiimia busa babaandu bakarekeeresia. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.14",
            "verseOrgIds": [
              "2TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khaka nga onyala ofukiililwe mu moni cha Wele, nga omukholi okhaambwa chisoni khu milimo kiewe tawe, oyo owikisianga Elomo eye bung'ali eya Wele nga eli. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.15",
            "verseOrgIds": [
              "2TI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhapa chimbakha che sifwaabi ne busilu tawe, chirusianga busa babaandu khu Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.16",
            "verseOrgIds": [
              "2TI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liliekisia lirio, lili nga likoonjo liboofu lichiililila khubalaa. Babaandu babili babekisia bibiindu nga bino biri bali Himenea ne Fileto. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.17",
            "verseOrgIds": [
              "2TI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balekhile engila eye bung'ali mala balikho bonaka lisuubila liili mu baandu balala mu khuloma bali lilamukha liefwe liakholekha khale. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.18",
            "verseOrgIds": [
              "2TI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.5"
              },
              "items": [
                {
                  "text": "Khub. 16.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ne kakhali siboofu nisio Wele ombakha se sinyala siasiisiikhwa tawe; lundi siaandikwakho kamakhuwa kano: “Omwami amanyile abo bali babewe” ne “Boosi balomanga bali bali bo Mwami khukhwola balekhe khukhola kamabi.”",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munju embalaayi bitelu ne bibuumba bia buli lukano bilimo. Bilala bie efwesa ne bibiindi bie sahabu, bibiindi bie chimbao ne liloba. Bilala birumikha mu siise sirobore, ne bibiindi birumikha siise siosi siosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.20",
            "verseOrgIds": [
              "2TI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi yesi aaba ne emiliyisia khukhwama khu biindu bimayaanu ebio bioosi, aba akharumikhirwe khu sifuno sisiaroborwa, sikila aba eerusia lundi ali owe bukhala khu Mukhulu wewe. Eerekekha khurumikhirwa khu buli sikholwa silayi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.21",
            "verseOrgIds": [
              "2TI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhaba ne liliekoomba lie buele tawe, ne kakhali khola kamaani obe omuluungi, obe ne lisuubila, busiime, ne kumuleembe, alala ne nabo basaba Wele buyeeti ne kumwoyo kumukwalaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.22",
            "verseOrgIds": [
              "2TI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2TI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhaba mu mayiingano ke busilu ne bulendaafu tawe, omanyile oli kamaliilikhilanga mu bulomani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.23",
            "verseOrgIds": [
              "2TI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2TI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukholi owo Mwami khukhwola abe okharangana tawe, khukhwola abe omwekisia omulayi lundi owefwiilisia, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.24",
            "verseOrgIds": [
              "2TI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2TI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuolu mu khuluungisia bayingana naye, sikila wakana Wele anyala aabaelesia bubweyaangu bwe khukhwekanila ne khumanya bung'ali. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.25",
            "verseOrgIds": [
              "2TI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2TI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khwako bakhakesiie mala belukhe khukhwama mu mireko kia Sietani owabaamba ne khubakhola baloonde lilienya liewe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.26",
            "verseOrgIds": [
              "2TI.2.26"
            ]
          }
        }
      ]
    }
  ],
