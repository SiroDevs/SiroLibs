                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Omubasi Alekisanda aanaania lukali; Omwami akhamuruungie khuloondekhana nende niko aakholile. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba meeso, yeliinda khukhwama khu niye, sikila ali ne sisiayuumba mu khwimelekhana khu lomo yefwe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        }
      ]
