          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nga ne oola e Mahanaimu, akaanilwa ne Siobi okhwa Nahasi, khukhwama mu lukoba lwa Raba lwe Baamoni. Lundi akaanana ne Makiri okhwa Amieli khukhwama Lotebari, ne Barisilai omukileati khukhwama Rokelimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.27",
            "verseOrgIds": [
              "2SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaandu bataru bano bareera bitaanda, bibuumba ne chinyuungu. Lundi bareera engaanu, eshayiri, bufu, biakhulia bibioosie, kamakaanda ne chibalaayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.28",
            "verseOrgIds": [
              "2SA.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lundi bareera bubuukhi, esiaki, liboonda ne kamakheese. Bamanya bali Daudi ne babaandu bewe baba ne njala ne bulesia, lundi baluwa ne bali mu sichiimi. Nio babareerera biakhulia balie.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.29",
            "verseOrgIds": [
              "2SA.17.29"
            ]
          }
