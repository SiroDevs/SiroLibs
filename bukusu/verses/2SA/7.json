        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nono Omwami WELE, ewe oli Wele, ne kamakhuwa kowo kali ka ng'ali. Ewe wasuubisia ese omukholi wowo bibiindu bilayi bino. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khureeba ewe umbiitile chikhabi lisaaye liase nio lichiililile khuba ne chikhabi chowo. Ee Omwami WELE, ewe wasuubisie oli, olabiita chikhabi lisaaye liase buli lwosi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        }
