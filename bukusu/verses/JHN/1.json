    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elomo eekhola aaba Omundu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu khurakikha, Elomo aabao, mala Elomo aaba ne Wele, lundi Elomo aaba Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.1",
            "verseOrgIds": [
              "JHN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhwama mu khurakikha, Elomo aaba ne Wele. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.2",
            "verseOrgIds": [
              "JHN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wele abuumba bibiindu bioosi khubirira mu niye, se siliio sisiindu na silala mu bibuumbe bioosi sisiakholwa niye ne akhaliio tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.3",
            "verseOrgIds": [
              "JHN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elomo aaba sinoko sie bulamu ne bulamu buno bwareera buwaanga mu baandu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.4",
            "verseOrgIds": [
              "JHN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buwaanga bukhosianga mu siilima ne sisiilima se siabuminyile tawe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.5",
            "verseOrgIds": [
              "JHN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.1.5",
            "verseOrgIds": [
              "JHN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 1:6"
          },
          "items": [
            {
              "text": "6",
