              "items": [
                {
                  "text": "Esek. 37.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.14"
              },
              "items": [
                {
                  "text": "Dan. 7.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Babaandu bamukobosia bali, “Lilaka liefwe likhuboolela efwe lili Kristo alimenya mindali na mindali: Nono ewe onyala khuboola oriena oli khukhwola Omwana wo Mundu asutwe angaaki? Omwana wo Mundu yuno niye naanu?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.34",
            "verseOrgIds": [
              "JHN.12.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.34",
            "verseOrgIds": [
              "JHN.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abakobosia ali, “Buwaanga busiilikho nanywe khulwe siise sitiiti. Chiililila mu lukeendo lwenywe ne musiili ne buwaanga nio sisiilima sikhamufuunikha tawe, sikila oyo okeenda mu siilima se amanya niio alikho acha tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.35",
            "verseOrgIds": [
              "JHN.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nono suubila mu buwaanga ne musiili nabwo, nio mube babaandu be buwaanga.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.36",
            "verseOrgIds": [
              "JHN.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babaandu khutaamba lisuubila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyuma Yesu naboolile kano arekukha acha ekisa khukhwama khu baandu chana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.36",
            "verseOrgIds": [
              "JHN.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akhaba ne aba nakholile kamayia kano koosi mu moni chabwe se bamusuubila tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.37",
            "verseOrgIds": [
              "JHN.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.1"
              },
              "items": [
                {
                  "text": "Isa. 53.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nio nilio Omung'oosi Isaya aboola liole khuba ng'ali:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.38",
            "verseOrgIds": [
              "JHN.12.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.38",
            "verseOrgIds": [
              "JHN.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nio se benya khusuubila tawe, sikila akhaba lundi Isaya aloma ali,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.39",
            "verseOrgIds": [
              "JHN.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.40",
            "verseOrgIds": [
              "JHN.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya aloma kano sikila abona luyali lwa Yesu mala alomaloma khu kewe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.41",
            "verseOrgIds": [
              "JHN.12.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.41",
            "verseOrgIds": [
              "JHN.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakhaba kario, Bayaudi bakali be bunyali basuubila mu Yesu, ne Bafarisayo bakila se bakalomalomakho abuwaanga tawe, nio bakhabatimania mu sinakooki tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.42",
            "verseOrgIds": [
              "JHN.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basiima khufukiililwa ne babaandu khukhila khufukiililwa ne Wele.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.43",
            "verseOrgIds": [
              "JHN.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Likhalaka lie kamakhuwa ka Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.43",
            "verseOrgIds": [
              "JHN.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aloma mu mumilo kwe angaaki ali, “Yesi yesi osuubila mwise sasuubila mwise seng'ene tawe, ne kakhali aba asuubila akhaba mu wanduma yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.44",
            "verseOrgIds": [
              "JHN.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesi yesi oumbona ese abona akhaba oyo owanduma yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.45",
            "verseOrgIds": [
              "JHN.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nechile mu sibala nga buwaanga, nio buli mundu osuubila mwise akharama mu siilima tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.46",
            "verseOrgIds": [
              "JHN.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaba bali omundu yesi yesi aulila burume bwase mala saburia tawe, se ndimukhalakila tawe, se necha khukhalakila sibala tawe, ne kakhali necha khusiionia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.47",
            "verseOrgIds": [
              "JHN.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boosi babandoba ese ne khulekha khufukiilila burume bwase bali no mundu olibakhalakila. Kamakhuwa niko muboolele niko kaliba bukhalaki khu ndaalo emaliilisi! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.48",
            "verseOrgIds": [
              "JHN.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kali ng'ali sikila ese se nalomaloome khu bunyali bwase samwene tawe, ne kakhali Paapa wanduma niye owandaka nisio khoyela ndome. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.49",
            "verseOrgIds": [
              "JHN.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mala manyile ndi Lilaka liewe lireeranga bulamu bwa mindali. Niko ndoma nono kali niko Paapa ambooleele khuloma.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.50",
