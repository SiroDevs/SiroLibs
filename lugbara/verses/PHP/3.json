                  "text": "Rum 2:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba agele liza adaru beri ama’i, ama ’ba Mungu inzipi Orindisi, ama enyapi Kristo Yesusi, ovupi afu be rua ma e’yosi ku ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.3",
            "verseOrgIds": [
              "PHP.3.3"
            ]
          }
        },
        {
