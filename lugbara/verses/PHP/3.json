        {
          "text": "e’yo asi vezanisi, ma inza ndra ’ba kanisani ’diyi; te e’yo kililiru azitasirisi ma ovu e’yo kokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.6",
