                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo dria ndra ovupi ma dri ’ orodriru ’diyi, ma la yi ekile afa avipi tokorurile Kristo ma e’yosi ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.7",
            "verseOrgIds": [
              "PHP.3.7"
            ]
          }
        },
        {
          "name": "verse",
