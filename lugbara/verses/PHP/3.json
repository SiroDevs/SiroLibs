          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada, ma la afa dria ekile afa avipi tokorurile, nita mani Kristo Yesu Opi mani nizurini agale tu onyisi rarisi. Afa mani dria avi eri ma e’yosi, te ma la afa ’diyi ekile afa ngupi onzirile, eco mani ani Kristo isuzaru orodri maniru beni, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.8",
            "verseOrgIds": [
              "PHP.3.8"
            ]
          }
        },
        {
          "name": "verse",
