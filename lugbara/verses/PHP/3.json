              "items": [
                {
                  "text": "1 Kor 9:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma nzu drile baka vu, afa azile fezaruri isuzu, ’di omveta Munguni ama omvezu uru Kristo Yesu ma aliari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.14",
