                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ovuni kini ma isu ’bo, kani ma fu dri ’bo, ’dini ku; te ma nzu drile okposi ’dani, ma ma isu e’yo nde Kristo Yesuni ma bizu aniri beni. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.12",
            "verseOrgIds": [
              "PHP.3.12"
            ]
          }
        },
        {
