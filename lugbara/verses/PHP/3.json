                  "text": "Eceza 22:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ovu mile be ocesi, emi ma ovu mile be ’ba azi onzi ’yepi ’diyisi, emi ma ovu vini mile be ’ba ’ba rua olipi ’diyisi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.2",
            "verseOrgIds": [
              "PHP.3.2"
            ]
          }
        },
        {
