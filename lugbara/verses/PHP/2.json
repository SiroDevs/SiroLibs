        },
        {
          "text": "Asi omiza ka ovu Kristo ma alia ci, kani asi omiza letani, kani ti ecita Orindini, kani asi ndriza ale beri, kani yikini, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.1",
            "verseOrgIds": [
