                  "text": "Rum 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ’ye e’yo awatasi ku, kani afu onzisi ku indi, te asisile afu kokorusi emi dria alu alu ma inzi emi agyi aga emini emi ngulupi inzilerile. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.3",
            "verseOrgIds": [
              "PHP.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
