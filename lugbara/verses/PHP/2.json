                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba dria yi e’yo yi ma ngulupini ndru, yi ndruni e’yo Yesu Kristoni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.21",
