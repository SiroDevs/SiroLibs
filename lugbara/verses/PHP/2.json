        },
        {
          "text": "E’yo ’disi emi ma a’i eri Opi ma alia ayiko driasi; te emi ma inzi ’ba ’dinile ’diyi inzi, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.29",
            "verseOrgIds": [
