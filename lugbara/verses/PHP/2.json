            "number": "5",
            "style": "v",
            "sid": "PHP 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ovu asisile ndra ovupi Kristo Yesu me aliari be emi ma alia, ",
          "type": "text",
