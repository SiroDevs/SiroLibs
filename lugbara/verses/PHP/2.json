              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi alu alu ma ega e’yo emi ngulupini a’dule ku, te emi dria alu alu ma ega e’yo ’ba azinini indi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
