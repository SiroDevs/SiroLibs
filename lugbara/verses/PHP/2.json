              "type": "text"
            }
          ]
        },
        {
          "text": "te eri ovu avasi tu lezu emi dria ndrezu, azini eri ovu candisi tu emini erile kini eri ovu azorurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.26",
