              "EZK.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi nga larini a’i ’ba o’yu erini su ’diyi pi ma dria, tini kalaniari ma pari ti ecipi agyi be su ’diyi pie, kalani ageiniari be dria; ’dini mi nga eri ’ba alaru, mi nga e’yo onzi erini ede ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
              "EZK.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
