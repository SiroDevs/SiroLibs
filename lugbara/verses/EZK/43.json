              "items": [
                {
                  "text": "Lev 9:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.8"
              },
              "items": [
                {
                  "text": "Yob 42:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi ka nga o’duniri de dria ’bo, eri nga ovu ’dini, kini, engazu o’du arorisi azini drile, ’ba edeta edepi ’diyi nga edeta emini vezaru ’diyi pi ove pari edeta edezuri ma dria, edeta emmi asi anzuruni ’diyi be; te ma nga emi a’i ra, Opi Yehova ’yo ra.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.27",
