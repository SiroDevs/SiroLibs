          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "pari edeta edezuri ma esele uruleruri nga ovu wuale su; engazu pari edeta edezuri ma pari aci eduzu­ria o’yu su indi uruleru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pari edeta edezuri ma pari ad eduzuri, oconi wuale mudri drini iri, walani vini mudri drini iri, kala su ’diyi yi trotro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        }
