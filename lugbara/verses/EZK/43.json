              "items": [
                {
                  "text": "Efu 29:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.11"
              },
              "items": [
                {
                  "text": "Ebra 13:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi nga monio edeta e’yo onziniriruri ’du indi, eri nga eri ve pari azile e’yo ndesi; nde ma angua pari alatara­ruri ma kala amveriari ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.21",
            "verseOrgIds": [
              "EZK.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te o’du iririsi, mi nga ndriago nyibile kokoruri ede edeta e’yo onzi­siriru; ’dini yi nga pari edeta edezuri ’ba alaru yini eri ’bale alaru moniosi­rile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.22",
            "verseOrgIds": [
              "EZK.43.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ka nga de eri ’bazu alaru ’bo, mi nga monio aluduru nyibile kokoruri pi ede kabiloago kabilo o’biru ’diyi ma eseliari be. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
            "verseOrgIds": [
              "EZK.43.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.2.13"
              },
              "items": [
                {
                  "text": "Lev 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi nga yi eji ogogo Yehova ma milia, ’ba edeta edepi ’diyi nga a’i o’be yi ma dria, yi nga yi ede edeta vezaruriru Yehova dri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.35"
              },
              "items": [
                {
                  "text": "Efu 29:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du aziri ma alia dria mi ma ede ndri edeta e’yo onzisiriru o’du alu alu vusi, yi nga vini monio aludururi pi ede kabiloago kabilo o’biru ’diyi ma eseliari be, dria nyibileko kokoru ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga pari edeta edezu nderi ma e’yo onzi ede 0’du aziri, yi nga eri ’ba alaru ani, ’dini yi nga eri ’ba ndu afa fele Mungu dririru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
            "verseOrgIds": [
              "EZK.43.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
