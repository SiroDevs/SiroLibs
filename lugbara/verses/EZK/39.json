                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.17+REV.19.18"
              },
              "items": [
                {
                  "text": "Eceza 19:17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi, mvi ’bani la, Opi Yeho­va ’yo ’dini: Mi olu aria esele be ndu ndu ’diyi pi ma tia dria, anyapa dria asea ’diyi be ’dini, Emi oku di emi, emi emu; emi oku emi engazu kala dria vu edeta mani edele emi dri ’diri vu, eri edeta amboru oni Israe­lini ma driari, emi ma nya za, emi ma mvu ari indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.4"
              },
              "items": [
                {
                  "text": "Eze 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.14"
              },
              "items": [
                {
                  "text": "Azi 32:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.12"
              },
              "items": [
                {
                  "text": "Zab 22:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga ’ba okporu ’diyi ma za nya ra, emi nga ’ba opiru nyakua ’diyi ma ari mvu ra, kabiloago piyi kabiloanzi pie, ndri pie, ti pie, yi dria anyapa nguza Basania’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi nga oso nya de nga emi trani ku, emi nga ari mvu de nga emi atini ku, emini edeta mani edele emi driri nyaria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
