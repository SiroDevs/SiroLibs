          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te kabilo mani yi iribi emini otule emi pasiri nya, yi yi emini ezale emi pasiri mvu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.19",
            "verseOrgIds": [
              "EZK.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Opi Yehova ’yo yi ma tia ’dini: Emi ndre, ma’i, adani ma ngulupini nga e’yo li anyapa nguza ’diyi pi ma eselia anyapa oyiza ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.20",
            "verseOrgIds": [
              "EZK.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emini yi zele eje pisi wudri berisi, emini anyapa azoru ’diyi dria osile emi o’yusi de nga emi ereni yi pari dri dria kurisi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.21",
            "verseOrgIds": [
              "EZK.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
