          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "e’yo ’disi ma nga kabilo mani o’biru ’diyi opa ra, yi ngani ovu afa opazale dika: ku; ma nga vini e’yo li anyapa piyi! ma eselia anyapa azini be. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.22",
            "verseOrgIds": [
