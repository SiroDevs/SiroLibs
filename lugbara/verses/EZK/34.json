                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ngani ovu afa opazale juru dri dika ku, nguru asea ’diyi ngani vini yi oci ku; te yi nga adri e’yo ’yaasi, ’ba aluni ngani uri fe yi dri ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.28",
            "verseOrgIds": [
