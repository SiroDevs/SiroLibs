              "items": [
                {
                  "text": "Mat 23:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emini iribi bulu nyazu ’bori eri emi milia e’yo wereni ya? te emi nga iribi nde ma joloko otu pasi indi ya? Emini yi alaruri mvuzu ’bori e’yo wereni ya? emini yi nde ma joloko ezazu emi pasiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.18",
            "verseOrgIds": [
              "EZK.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
