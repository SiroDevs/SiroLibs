              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ma ngulupini nga nyaka fe kabilo mani drini, ma nga fe yi ma la va, Opi Yehova ’yo ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.15",
            "verseOrgIds": [
