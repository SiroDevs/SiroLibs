                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi nde yi edemararu asi mbaza be indi; ma pe mi ti yi vu ’di, te mi nga ’yo yi tia, Opi Yehova ’yo ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
