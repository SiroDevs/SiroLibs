          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di jo ovupi pari awale nduri ma miliari ma kala vileriari ma oconi o’bi, jobileko adrozaru erini ’diyi pie, kala alusi azini kala azinisi wuale turu alu. Hekalu alialeruri pi, riidri kalitile ma jobileko pie, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
