                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ma cii hekalu vu, nga patini o’bi, walani wuale azia kala alurisi, walani wuale azia kala azinisi, wala nde wala bereniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.1",
            "verseOrgIds": [
              "EZK.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pari fizuri ma walani wuale mudri; pari fizuri ma kala ’diyi ’dini, kala aluria wuale towi, kala azinia wuale towi; eri nga oconi o’bi wuale kali su, walani be, wuale kali iri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia eri fi alenia, nga pati pari fizuria ’diyi o’bi yi alu alu, wuale iri; pari fizu nderi wuale azia; pari fizuri ma walani wuale aziri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.20"
              },
              "items": [
                {
                  "text": "1 Opi 6:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
