          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ede kerubi pi itu pati be engazu nyakua cazu kpere jotile ma drilia uru; ede hekalu ma abi ’dini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
