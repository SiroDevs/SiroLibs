              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini ’ba ada ma andreti lu itu pati vu kala alusi, kamimva ma andreti lu itu pati vu kala azinisi. Ede eri ’dini jo ma alesi dria ageinia kuru; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.19",
            "verseOrgIds": [
              "EZK.41.19"
            ]
          }
        },
        {
