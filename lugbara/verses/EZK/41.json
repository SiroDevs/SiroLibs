              "items": [
                {
                  "text": "1 Kor 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "pari fizu ’diyi pie, derisa opizaru ’diyi pie, jobileko adrole uru ageia jo adrole na ’diyi ma tia ’diyi pie dria; jobileko ’diyi oti yi pari ’bani fizu ’diyi be, opi yi ma dri pati osizasi ageinia kuru, a’bu yi ruaa pati osizasi engazu nyakua uru derisa vu (isu de derisa yi opizaru), ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "o’bi angu mgboru jotile ma drilia ururi vu kpere jo alialeruri ma alia, amveri pie, abi ma ruaa aleniari pie, amveri pie dria o’bizasi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
            "verseOrgIds": [
              "EZK.41.17"
            ]
          }
        },
