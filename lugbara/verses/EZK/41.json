              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "jotile nde ’diyi ovu tiko be iri iri, tiko yi ojapi ’diyi; tiko iri jotile aluni, tiko iri jotile azinirini, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
            "verseOrgIds": [
              "EZK.41.24"
            ]
          }
        },
        {
