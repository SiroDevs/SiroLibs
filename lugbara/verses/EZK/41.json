            "number": "25",
            "style": "v",
            "sid": "EZK 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ede yi ma ruaa, ada jotile heka­luni ma ruaa, kerubi pi ma wura itu pati be, ekile edele abi ma ruaarile; jotile ma jobileko ma tia amve pati osiza oseru indio ",
          "type": "text",
          "attrs": {
