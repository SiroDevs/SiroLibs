              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga ni indi ma Yehova’i; ma ’yoni ndra toko ku kini ma nga e’yo onzi ’diri ’ye yi ruaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
