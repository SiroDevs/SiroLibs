                "loc": "MAT.25.10"
              },
              "items": [
                {
                  "text": "Mat 25:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opini nga fi engazu amve geri kalitile ma jobileko vurisi, eri nga pa so kalitile ma pari kalaari tia. ’Ba edeta edepi ’diyi yi nga edeta erini vezaruri pi ede edeta erini asi anzuruniri be, eri nga di Mungu inzi pari ’bani fizu kalitilearia. Vutinia eri nga fu ra, te yi ngani kalitile opi ku de nga etu ’deni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
