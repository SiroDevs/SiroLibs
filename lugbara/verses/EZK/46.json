              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "eci riidri azini riidri nde ma oji su ’diyi ma alia, yi ma oconi wuale kali su, walani kali na; riidri su ovupi oji vusi ’diyi ma o’biza alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
