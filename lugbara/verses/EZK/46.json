            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.24"
              },
              "items": [
                {
                  "text": "Eze 45:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "edeta anyafurasiri nga ovu abaka alu kabiloagoni, te edeta anyafurasi kabiloanziniri nga ovu erini ecole felerile, odu ma ovu lubu alu abaka vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te o’du mba sini i e’dazu­risi edeta erini nga ovu monio aludu nyibileko kokoruri alu, kabiloanzi azia, kabiloago be; yi dria ma ovu nyibileko kokoru; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.6",
            "verseOrgIds": [
              "EZK.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ma ede edeta anyafurasi ngonde indi, abaka alu monioniri, abaka alu kabiloago­niri, te kabiloanziniri erini ecolerile, te odu lubu alu abaka alu vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.7",
            "verseOrgIds": [
              "EZK.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi ka fi ra, eri ma fi geri kalitile ma jobileko vurisi, eri ma fu vini geri ndesi indi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        }
