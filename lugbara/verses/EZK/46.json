        {
          "text": "Edeta vezaru opini ngale fele Yehova dri sabatosiri nga ovu kabiloanzi azia nyibileko kokoru ’diyi pi kabiloago nyibileko kokoruri be; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
