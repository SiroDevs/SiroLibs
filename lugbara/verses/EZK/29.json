              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Opi Yehova ’yo ’dini: Mi ndre, ma nga Isei eji mi dria, ma nga ’ba piyi ofu anyapa be mi vusi ra; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
