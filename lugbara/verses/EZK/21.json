          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi opi Yehova ’yo ’dini: Emini fele e’yo onzi emini ma ovu egazaru, yini ezata emini isuzu ani, e’yo onzi eminini e’dale ’yeta emini ma alia driarisi; vini ani e’yo emini egalerisi, yi nga emi obi drisi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        },
        {
          "name": "verse",
