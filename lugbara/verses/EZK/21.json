                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mvi ’bani, mi ’ba mi mile Yerusalemu vu, mi fe e’yo mini ma ti pari alatararu ’diyi vu ti ti, mi ondri e’yo angu Israelini ma dria, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.2",
