                  "text": "E’do 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi’i, opi onzi Israelini, ebi drani isupi ’bori la, o’du mini eca ’bo, ewu e’yo onzi ngapi ecapi vilerinisi; ",
          "type": "text",
          "attrs": {
