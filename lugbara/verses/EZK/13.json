                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ma nga di jo abi emini e’burale odri agagarisiri asu va, ma nga eri gu va nyakua, ’dini yi nga jo eti ndre ani ra; eri nga i asu va ra, te emi nga dri ja alenia; emi nga ni ani ma Yehova’i. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.14",
            "verseOrgIds": [
              "EZK.13.14"
            ]
          }
        },
        {
          "name": "verse",
