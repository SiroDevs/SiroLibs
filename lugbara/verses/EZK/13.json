            "number": "3",
            "style": "v",
            "sid": "EZK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi Yehova ’yo ’dini, Candi nabi ondua kokoru, yi ma ngulupi ma orindi ma vuti bipi de yi ndreni afa aluni ku ’diyi dri! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.3",
            "verseOrgIds": [
              "EZK.13.3"
            ]
          }
        },
