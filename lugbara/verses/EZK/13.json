                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mvi ’bani, mi ma ondri e’yo nabi Israelini e’yo ondripi ’diyi ma ruaa, mi ’yo ’ba e’yo efupi yi ma ngulupi ma asiari ondripi ’diyi ma tia, kini: Emi eri e’yo Yehovani! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.2",
            "verseOrgIds": [
              "EZK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
