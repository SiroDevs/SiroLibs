            }
          ]
        },
        {
          "text": "’Ba ’yopi kini, Yehova ’yoni, de isu Yehova peni yi ma ti ku ’diyi, yi ndre afa tokoni, azini e’yo ondriza inzoru; azini indi yi fe vini ’ba ma ovu asi teza be kini e’yo nderi nga ovu ’yezaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.6",
            "verseOrgIds": [
              "EZK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
