            "number": "8",
            "style": "v",
            "sid": "EZK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Opi Yehova ’yo ’dini: Emini e’yo toko toko ’diyi ’yolerisi, emini e’yo inzoru ndrelerisi, e’yo ’disi emi ndre, ma emi dri aru ma’i, Opi Yehova ’yo ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.8",
            "verseOrgIds": [
              "EZK.13.8"
            ]
          }
        },
