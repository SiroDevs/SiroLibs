                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ’yo ’ba abi e’burapi odri agagarisi ’diyi ma tia kini eri nga i asu ra! Ozooni nga ’di amboru; emi’i, emi si ombaza ambo ambo ’diyi la, emi nga ’de ra; akulukuni nga eri asi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.11",
            "verseOrgIds": [
              "EZK.13.11"
            ]
          }
        },
        {
          "name": "verse",
