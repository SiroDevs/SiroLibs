            "number": "7",
            "style": "v",
            "sid": "EZK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ndreni afa tokoru ku ya, emi ondrini e’yo ondriza inzoru ku ya, emini ’yoria, Yehova ’yoni; de isu ma ’yoni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.7",
            "verseOrgIds": [
              "EZK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
