        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
