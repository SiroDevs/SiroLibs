            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abi walaru riidri etuni efuzu­rialerurini ma alia jo aliza indi, pari awale nduri pi ma drilia jo nde be. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geri yi ma driliari e’da i geri jo aliza kala andraleruria ’diyinirile, oco yini ovu oco jo aliza ’dayinirile, wala yini wala ’dayinirile, fuza yini ’diyi ovu trotro wura ’dayini vusi, lotile yini trotro indio ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo aliza kala uruleruria ’diyi ma jotile vusi jotile azini indi geri ma drilia, geri nde oti i a bi ma drilia kilili kala etuni efuzurialeruria, ’bani firia yi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        },
