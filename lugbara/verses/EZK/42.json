                "loc": "REV.11.2"
              },
              "items": [
                {
                  "text": "Eceza 11:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vutinia eri nga ma eji amve fizu riidri amveleruri ma alia, geri woke andralerurisi, eri nga ma ofi jo ovupi otizaru pari awale nduri pi be jo kala andraleruriari beria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oconi wuale turu alu drilenia kali­tile andraleruri’i, walani wuale kali towi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobileko adrole jobileko ma dria paleko na ’diyi indi,oti yi angu wuale be kali iri riidri alialeruriniri pi be angu oni otiza be riidri amvele­ruriniri be. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo alile ’diyi ma drilia geri ’bani acizuri indi, wala aleniari wuale mudri, gerini wuale alu; jotile yini fe ti kala andraleruria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te jo aliza ovupi uru ’diyi ma walani were, a’disiku jo ’diri ma alia jobileko adrole uru ’diyi pa jo nde ’diyi ma angu, aga angu jo eleri vileri kani jo adrole agaduari vileri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku adro yi drinia drinia pale na, te yi ovuni pati i’diza be riidri ma pati i’diza ’diyile ku, e’yo ’disi jo aliza adrole uru turi emvi vile aga ele nyakuari kani agaduari ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6",
            "verseOrgIds": [
              "EZK.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abi amve jo aliza ma kalaa ti fepi riidri amve1eru jo aliza ma driliari vuleruri, oconi wuale kali towi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.7",
            "verseOrgIds": [
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku jo aliza riidri amveleruri ma alia ’diyi ma oconi wuale towi, te mi ndre, hekalu ma drilia ’diyi wuale turu alu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pari ’bani fizu kala etuni efuzurialeruri e’do jo aliza ’diyi ma etia, ’ba ka fi yi vu engazu riidri amveleruria.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
