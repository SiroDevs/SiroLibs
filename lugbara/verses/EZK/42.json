              },
              "items": [
                {
                  "text": "45:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’bi di eri kala susi. Eri abi be eri ma ageia kuru, oconi turu towi, walani turu towi, pari alatararu pi ma esele cozu pari ’ba drianiri be beni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
