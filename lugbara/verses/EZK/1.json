                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa idriru ’diyi nzu ’dale, emvi ’dole, ekile ovini galerile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        },
