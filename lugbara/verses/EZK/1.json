                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ovu dri be ’ba ma drile opile yini ma etia, yi ma eje su ’diyia. Afa ’diyi su ovu mileti yini be opile be indi ’dini: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi ma opile eci yi tualu; yi ojani yi ku yini muria, yi alu alu mu drile kililiru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        },
        {
