              "items": [
                {
                  "text": "Eceza 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mileti yini ma wura ’dini, yi ovu mijeti be ’ba ma miletile; yi sutro ovu mileti kaminirileri be eje dri ndirialeroria, yi sutro ovu mileti monionirileri be ele dri ejialeruria, yi sutro ovu mileti ajinirileri be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
