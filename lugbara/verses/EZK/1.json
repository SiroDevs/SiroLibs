              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yini muria yi mu eje yini su ’diyi ma dria, yi ojani yi ku yini muria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
