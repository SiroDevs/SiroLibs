              "items": [
                {
                  "text": "Isa 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mileti yini ’diyi co yi ma esele opile be ndu ndu geri urulerurisi; yi alu alu ma opile eci yi iri iri, opile iri azinisi yi a’bu yi ma rua. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi alu alu mu drile kililiru; geri orindini lezu muzuria yi mu ra, yi ojani yi yini muria ko, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
