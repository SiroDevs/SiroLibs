          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pari dria orindini lezu muzuria, yi mu ra; azini orindini lele mule ’dalerisi, pa omberu ’diyi ovu ’duzaru uru indi yi ma ejelea; a’disiku afa idriru ma orindini ovule pa omberu ’diyi ma aliarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
