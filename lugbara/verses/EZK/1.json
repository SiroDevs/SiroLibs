        },
        {
          "text": "Afa idriru ’diyi ka mu ra, pa omberu ’diyi mu yi ma ejelea indi; azini afa idriru ’diyi ka ovu ’duzaru uru nyaku ma dria, pa omberu ’diyi ovu ’duzaru uru alu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
