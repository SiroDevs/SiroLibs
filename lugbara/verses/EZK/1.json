              "items": [
                {
                  "text": "Eceza 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pa yini pa kililiro ’diyi, pa agele yini ekile kojamva ma pa agelele; yi di lele ekile mola ruani i trile tririle. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
