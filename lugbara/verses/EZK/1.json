                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ma alia wura afa idriru su ’diyini efu ra. E’daza yini ’dini: yi ovu wura be ’bale, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "te yi alu alu ovu mileti be su su, yi alu alu ovu opi’e be su su. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
