                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga ma mile ’ba yi vu ombasi; yi nga efu aci ma aliarisi, te ti, acini nga yi ve ra; azini yi nga di ni ma Yehova’i, ma ka nga ma mile ’ba yi vu ombasiria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.7",
            "verseOrgIds": [
              "EZK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma nga angu ’ba ovuzu andruru yini ezata ezalerisi, Opi Yehova ’yoni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.8",
            "verseOrgIds": [
              "EZK.15.8"
            ]
          }
        }
