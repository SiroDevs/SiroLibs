          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ’ba esupi ’ inzosi ’diyi ovu mi ma alia ari ’bani adazu, mi alia ’ba nyaka nyapi oni ma dria ’diyi ci; mi alia yi ’ye e’yo, drinzaru tu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.9",
            "verseOrgIds": [
              "EZK.22.9"
            ]
          }
        },
        {
