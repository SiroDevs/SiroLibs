              "items": [
                {
                  "text": "Zef 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nabi erini eci yi ma ti e’yo otuzu eri ma alia, ekile kami onopi za ciriarile; yi nya orindi ’bani ’bo; yi bi lonyi pi afa aje ambosi ’diyi be; yi fe oku kakau ma ovu awuziru eri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.25",
            "verseOrgIds": [
              "EZK.22.25"
            ]
          }
        },
