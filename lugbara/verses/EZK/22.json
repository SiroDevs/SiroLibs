              ]
            }
          ]
        },
        {
          "text": "Te mi nga ovu ezazaru mi ma ngulupisi suru ’diyi ma milia; mi di nga ni ma Yehova’i ani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.16",
