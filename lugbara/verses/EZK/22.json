                  "text": "Azi 4:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga mi ere suru eselia, ma nga mi ’ba ndu ndu angu ndu ndu ma eselia; ma nga fe ondi minini i dezu mi aliasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.15",
            "verseOrgIds": [
              "EZK.22.15"
            ]
          }
        },
