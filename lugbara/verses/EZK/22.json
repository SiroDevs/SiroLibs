                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.23"
              },
              "items": [
                {
                  "text": "E’do 18:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nda ’ba azini yi ma eselia, ngazu kali edezu, ngazu pa sozu ma milia pari i asupi vari ma alia, angu nde ma e’yosi, ma ma ja angu nde ma dri ku beni; te ma isuni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.30",
            "verseOrgIds": [
              "EZK.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi ma osu asi veza mani yi ma dria ’bo; ma ja yi ma dri teketeke adra mani ma acisi; ma omvi geri yiniri be yi ma ngulupi ma dria ’bo, Opi Yehova ’yoni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.31",
            "verseOrgIds": [
              "EZK.22.31"
            ]
          }
        }
