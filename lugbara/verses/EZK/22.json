              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.22"
              },
              "items": [
                {
                  "text": "Isa 1:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mvi ’bani, suru Israelini ofu ma dri ayazele; yi dria ovu molaru, kani aya emveriru, kani ayaru, kani aya nzizaru turiru okalemvu ma alia; yi ovu dahabu zeru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.18",
            "verseOrgIds": [
              "EZK.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Opi Yehova ’yo;dini: Emi driani ofule ayazerurisi, e’yo ’disi, emi ne, ma nga emi oku Yerusalemu ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.19",
            "verseOrgIds": [
              "EZK.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ekile yini dahabu pi, mola pie, aya pie, aya nzizaru pie, ayai emveru pie dria, okule okalemvu ma alia aci vuzu drinia erini akazurile ’dinile indi ma nga emi oku adra mani pi ma alia aoko mani be, ma nga emi o’ba ’daa, ma nga emi aka ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.20",
            "verseOrgIds": [
              "EZK.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ada ma nga emi oku ra, ma nga aoko mani ma aci vu emi dria, emi nga ani aka yiru aci nde ma alia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.21",
            "verseOrgIds": [
              "EZK.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekile dahabuni akale okalemvu ma aliarile, ’dinile indi emi nga aka yiru eri ma alia ra; te emi nga ni ani kini ma Yehova, ma osu aoko mani emi dria ma’i. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.22",
            "verseOrgIds": [
              "EZK.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Yehovani eca ma vu ’yozu kini: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.23",
            "verseOrgIds": [
              "EZK.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvi ’bani, mi ’yo eri tia, Mi angu ojile alaru kuri’i; ozoo ’dini vini mi dria o’du asi vezanirisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.24",
            "verseOrgIds": [
              "EZK.22.24"
            ]
          }
        },
        {
          "name": "verse",
