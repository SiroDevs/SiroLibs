        },
        {
          "text": "E’yo Yehovani eca ma vu dika kini, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.1",
            "verseOrgIds": [
              "EZK.22.1"
            ]
          }
        },
        {
          "name": "verse",
