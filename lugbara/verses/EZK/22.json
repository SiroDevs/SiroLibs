                  "text": "1 Kor 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi alia yi tru atapi ma bongo yi ma rua pililiri nezu; mi ma alia yi fe drinza oku ovupi alata kokoru i ma esele copi nduri vu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
            "verseOrgIds": [
