              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Yehovani eca ma vu, kini: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.17",
            "verseOrgIds": [
              "EZK.22.17"
            ]
          }
        },
        {
