                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi onzo afa mani alatararu ’diyi ’bo, mi eza sabato mani ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.8",
            "verseOrgIds": [
