          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi ace eri kuru ombasi, mi si jo okporu ’bani ani omba ’bazu ’diyi eri ma ageia, mi oku nyaku nguluru eri ma ageia; mi ’ba pari ari’bani hema asozu eri ma ruaa ’diyi, mi ’ba pati ombani yini abi sizu va ’diyi eri ma ageia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.2",
            "verseOrgIds": [
              "EZK.4.2"
            ]
          }
        },
