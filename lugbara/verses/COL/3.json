              "items": [
                {
                  "text": "Gal 2:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Kristo ovupi idri amaniri kali nga i e’da ra, emi nga di e’da tualu eri be diza ma alia indi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
            "verseOrgIds": [
              "COL.3.4"
            ]
          }
        }
