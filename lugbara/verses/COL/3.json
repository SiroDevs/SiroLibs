        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.6"
              },
              "items": [
                {
                  "text": "Efe 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’diyisi adra Mu­nguni emu anzi e’yo eripi ku ’diyi ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.6",
            "verseOrgIds": [
              "COL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi aci ndra e’yo ’diyi ma alia, emini de ndra adriria e’yo ’diyi ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.7",
            "verseOrgIds": [
              "COL.3.7"
            ]
          }
        },
        {
