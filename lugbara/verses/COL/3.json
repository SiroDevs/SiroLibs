              },
              "items": [
                {
                  "text": "Rum 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi odra ’bo, te idri emini ovu zizaru Kristo be tualu Mungu ma alia ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.3",
            "verseOrgIds": [
              "COL.3.3"
            ]
          }
        },
