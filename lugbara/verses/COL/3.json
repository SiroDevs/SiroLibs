        },
        {
          "text": "Emi ma fu ani ma emini ma esele ovupi nyakuniru ’diyi: ali ’bazu pi, e’yo saaru onzikanyaruri pie, ava ruani pie, li onziri pie, li ’ba afasiri pie, ’di ekile Mungu andini inzizurile. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.5",
            "verseOrgIds": [
              "COL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 3:6"
          },
          "items": [
