              "items": [
                {
                  "text": "Efe 4:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini emi su ’ba o’diru, ovupi ’bazaru o’diru zozu ani e’yo vazasi ovozu tro tro ’ba eri ’bapiri ma wurani ovulerileri ’bo indi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.10",
            "verseOrgIds": [
              "COL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
