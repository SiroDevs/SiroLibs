        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.22"
              },
              "items": [
                {
                  "text": "Efe 4:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma li inzo emi eselia ku, a’disiku emi tru ’ba okuri emi ruaa ’yeta erini be ’bo, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.9",
            "verseOrgIds": [
              "COL.3.9"
            ]
          }
        },
        {
