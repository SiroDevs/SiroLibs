                  "text": "Kol 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dini emi ka-ovu engazaru ’ba draza ma eselia tualu Kristo be ’bo, emi ma nda e’yo ovupi uruleru, pari Kristoni ovuzu erini rizu Mungu ma dri ndiaria ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.1",
            "verseOrgIds": [
              "COL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.33"
              },
              "items": [
                {
                  "text": "Mat 6:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma dro asisile emini e’yo ovupi uruleru ’diyi ma dria, e’yo ovupi nyakua ’diyi ma dria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.2",
            "verseOrgIds": [
              "COL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
