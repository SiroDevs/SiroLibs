              ]
            }
          ]
        },
        {
          "text": "te eri ma alia emi ga tre e’yo ndesi ’bo indi, eri ovu opi nyaza pi ma driru okpo be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
