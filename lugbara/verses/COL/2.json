                  "text": "Efe 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ekile emini Kristo Yesu Opini a’ilerile, emi ma aci eri ma alia ’dinile, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.6",
            "verseOrgIds": [
              "COL.2.6"
            ]
