                  "text": "Rum 2:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ma alia yi fe emi dri agele liza ’bani lile drisi kuri, eri agele liza Kristoni e’yo ruani truzuri’i; ",
          "type": "text",
          "attrs": {
