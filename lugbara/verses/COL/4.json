        },
        {
          "text": "Arisitariko ovupi arujoa ma beri pi zi emi ci ci, Marako Baranaba ma amvipi ma mvi pie (yi azi e’yo erini emi dri ’bo-eri ka eca emi vu ra emi a’i eri), ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
