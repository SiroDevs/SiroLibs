              "items": [
                {
                  "text": "File 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ma ’yo Arikipo ma ria kini, Mi ndre mi ma ’ye azi Opini fele mi driri de dria kililiru.",
          "type": "text",
          "attrs": {
