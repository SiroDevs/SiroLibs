                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri eve zani pi acisi enyiriko be pari ’bani hema asozuri ma tia amve.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.11",
            "verseOrgIds": [
