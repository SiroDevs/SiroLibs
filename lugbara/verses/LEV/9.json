                }
              ]
            }
          ]
        },
        {
          "text": "Aroni anzi­pi nga arini fe eri dri, eri nga ani i ma drileju su ari nde ma alia, nga eri o’ba pari edeta edezuri ma o’yu ma dria, nga di ari nderi osu pari edeta ’edezuri ma ndua; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.9",
            "verseOrgIds": [
              "LEV.9.9"
            ]
          }
        },
        {
