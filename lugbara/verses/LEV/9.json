        },
        {
          "text": "Eri nga edeta vezaruri li;Aroni anzipi nga di arini fe, eri nga eri oya pari edeta edezuri ma dria i ageiniasi kuru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
