                  "text": "4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te eri eve edeta e’yo onzi edezuri ma oso pi pari edeta edezuri ma dria, orofi pie, aridria’bure ogu ruaari pie, ekile Yehovani azile Musa tiarile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
