          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Aroni nga di esi pari edeta edezuri vu ogogo, nga kojamva edeta e’yo onzi edezurini li, ovupi eri ngulupi ma e’yosiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.8",
            "verseOrgIds": [
              "LEV.9.8"
            ]
          }
        },
