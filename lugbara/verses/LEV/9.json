              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di edeta vezaruri fe, nga eri ede ’ekile azitani ’yolerile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.16",
            "verseOrgIds": [
