              "type": "text"
            }
          ]
        },
        {
          "text": "yi nga osoni ’ba agati ma dria, nga di osoni eve pari edeta edezuri ma dria, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
