          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ma ti i ma dri edeta ini ma dria, ma li eri hema ti ecizaniri ma drilia; te Aroni anzipi ’diyi ma oya arini pari edeta edezuri ma dria ageiniasi kuruni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
