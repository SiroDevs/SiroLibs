          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edeta asi anzu­runiri ma eseliasi, ma fe oso raururi pi oso dria otile fi ma ruaari be, vezu edetaru Yehova dri, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
