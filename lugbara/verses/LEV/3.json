          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edeta asi anzuruniri ma eseliasi, ma fe osoni edeta vezaruriru Yehova dri, sobi osoru lile pi kote vu ogogori pie, oso raururi pie, oso dria otile fi ma ruaari pie, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "orofi iri ’diyi pie, oso ruania gualeruri pie, aridria’bure ogu ruaari pie, ma nze yi orofi be tualu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
