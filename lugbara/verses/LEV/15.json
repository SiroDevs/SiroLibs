          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo dria, kani enyi dria, agupi yini rale ruania ’diyi, ma oji yi yisi, yi ma ovu alatara kokoru cazu kpere ondresi. ",
          "type": "text",
          "attrs": {
