              "items": [
                {
                  "text": "Ebra 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria alu alu gboloni felopiri ma oji bongo ini, ma oji i rua yisi, ma ovu alatara kokoru cazu kpere ondresi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.5",
            "verseOrgIds": [
              "LEV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba dria alu alu ripi afa ’ba afa viruni razu ruaniarini rizu drinia ’diyi ma driari ma oji bongo ini, ma oji i rua yisi, ma ovu alatara kokoru cazu kpere ondresi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.6",
            "verseOrgIds": [
              "LEV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba dria alu alu ’ba afa viruni razu ruaniari ma rua elopiri ma oji bongo ini, ma oji i rua yisi, ma ovu alatara kokoru cazu kpere ondresi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.7",
            "verseOrgIds": [
              "LEV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
