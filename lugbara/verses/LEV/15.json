              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Diri azita ’ba afa viruni razu ruaniari pini ’ba agupi yini efuzu eri ma ruaasi erini ovuzu ani alatara kokoruri pie; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
