            }
          ]
        },
        {
          "text": "’Ba azini ka agupi yi da i ruaa, eri ma oji i rua yisi pi, ma ovu alatara kokoru cazu kpere ondresi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
            "verseOrgIds": [
              "LEV.15.16"
            ]
          }
        },
        {
