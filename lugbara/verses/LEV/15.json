            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.22"
              },
              "items": [
                {
                  "text": "Ebra 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba afa ngoni ngori ti erini rizu driniari elopiri dria alu alu ma oji bongo ini, ma oji i rua yisi, ma ovu alatara kokoru cazu kpere ondresi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
            "verseOrgIds": [
              "LEV.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ovu gboloni, kani afa azini erini rizu driniari, ’ba ka eri elo ra, eri ma ovu ’ani alatara kokoru cazu kpere ondresi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.23",
            "verseOrgIds": [
              "LEV.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
