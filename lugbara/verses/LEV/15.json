              "items": [
                {
                  "text": "2 Kor 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba afa viruni razu ruaniari ka cucu wu ’ba alaru ma ruaa, ’ba nderi ma oji bongo ini, ma oji i rua yisi, ma ovu alatara kokoru cazu kpere ondresi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.8",
            "verseOrgIds": [
              "LEV.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyi ’bale anyapa ngukua rizu driniari ’ba afa viruni razu ruaniarini rizu drinia ’diyi dria alu alu ovu ani alatara kokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.9",
            "verseOrgIds": [
              "LEV.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba dria alu alu afa te erini rizu driniari elopiri ma ovu alatara kokoru cazu kpere ondre­si; azini ’ba afa ’dinile ’diyi ’dupi jipiri ma oji bongo ini, ma oji i rua yisi, ma ovu alatara kokoru cazu kpere ondresi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.10",
            "verseOrgIds": [
              "LEV.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
