                "loc": "LEV.15.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kani ’ba dria alu alu afa acipi aci valesi ’bani ani ecozu ovuzu alatara ’kokoru ’diyi ma azi elopiri, kani ’ba ’ba ’bani ecole ani alatara aka isuzu vuniari elopiri, alatara ako erini ka ovu suruti ngoni ngori ti- ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
