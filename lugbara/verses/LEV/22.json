              },
              "items": [
                {
                  "text": "Lev 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.15.7"
              },
              "items": [
                {
                  "text": "15:7",
