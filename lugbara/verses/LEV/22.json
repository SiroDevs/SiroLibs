              "attrs": {
                "loc": "HEB.10.22"
              },
              "items": [
                {
                  "text": "Ebra 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba e’yo ’dinile ’diyi ma azi elopiri ma ovu ala tara kokoru cazu kpere ondresi, eri ma nya afa alatararu ’diyi ma azi aluni ku, de nga eri Ojini i rua yisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
