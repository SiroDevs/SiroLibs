              ]
            }
          ]
        },
        {
          "text": "Mi ’yo Aroni pi ma tia anzipi be kini yi ma co yi esele afa alatararu anzi Israelini ’diyini, yini ’bale ndu alatararu ma dri ’diyi be, ’dini yi ma eza ru mani alatararuri ku; ma Yehova’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
