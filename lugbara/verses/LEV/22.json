                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.31"
              },
              "items": [
                {
                  "text": "Eze 44:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma nya afa drapi ceniri, kani afa nguruni cileniri, i ezazu afa nderisi ku: ma Yehova’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.43"
              },
              "items": [
                {
                  "text": "Efu 28:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.22"
              },
              "items": [
                {
                  "text": "Kal 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi yi ma mba e’yo mani azileri ma ta, yi kazu ani e’yo onzi isuzu yi ma dria, odrazu ani yini eri ezalerisi ku: ma Yehova yi ’bapi alatararuri’i.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
