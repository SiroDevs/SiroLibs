              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.20"
              },
              "items": [
                {
                  "text": "Lev 7:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ’yo yi tia kini, Ori emini ma eselia, a’bianzi emini vusi dria, ’ba esipi ogogo afa alatararu anzi Israelinini o’bale ndu alatararu Yehova dri ’diyi vu, erini ovuria alatara kokoruri, eri ka ovu a’di’i ti, yi nga ’ba nderi ma idri dri ja ma miliasi ra: ma Yehova’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
