          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.11"
              },
              "items": [
                {
                  "text": "Kal 18:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te etu ka di ’de ’bo, eri nga ovu alatararu; ’di ma vutia eri nga afa alatararu ’diyi ma azi nya ra, erini ovule eri ma nyakarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
