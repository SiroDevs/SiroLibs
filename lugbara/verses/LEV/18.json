                }
              ]
            },
            {
              "text": "Efu 23:34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ’ye ekile ’ba angu Misiria emini ndra ovuzu yi ma eselia ’diyini ’yelerile ku, azini vini emi ma ’ye ekile ’ba angu Kanania mani ngazu emi jizu yi vu ’diyini ’yelerile ku indio Emi ma aci azita ’yini ’diyi vusi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.3",
            "verseOrgIds": [
              "LEV.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ’ye e’yo liza mani ’diyi, emi ma mba azita mani ’diyi ma ta, acizu yi alia. Ma Yehova Mungu eminiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.4",
            "verseOrgIds": [
