        {
          "text": "Mi ma otru mi ati ma amvi ma rua pililiru ku; eri mi ati ma ori’ba ogogori’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
