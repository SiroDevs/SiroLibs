              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te emi ma mba azita mani piyi ma ta, e’yo liza mani ’diyi be, emi ma ’ye e’yo ngule onzi ’diyi ma azi aluni ku, kani kari’bani kani ani’bo ovupi emi eseliari ti ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26",
            "verseOrgIds": [
              "LEV.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
