                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ’yo anzi Israelini ma tia ’yozu kini, Ma Yehova Mungu eminiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.2",
            "verseOrgIds": [
              "LEV.18.2"
            ]
          }
        },
        {
