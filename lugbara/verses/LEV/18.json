          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "(a’disiku ’ba angu e’ipiru emi drilia oko ’diyi ’ye ndra e’yo ngule onzi ’diyi dria ri, angu ovu ezazaru ala tara kokoru ani); ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "angu kazu emi ogbezu indi ewu emini eri ezazurisi ekile erini suru emi drilia okori ogbelerile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku ’ba dria alu alu e’yo ngule onzi ’diyi ma azi ’yepiri, yi nga ’ba nde ’yepi ’diyi ma dri ja o’dipi eseliasi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi emi mba e’yo mani azileri ma ta, ma ’ye e’yo ngule onzi adrile ’yele emi drilia aka ’diyi ma azi aluni ku, emi eza emi alatara kokoru e’ya ’diyisi aluni ku: ma Yehova Mungu eminiri’i.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
