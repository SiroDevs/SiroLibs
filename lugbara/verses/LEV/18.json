          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma otru mi andri ma amvi ma rua pililiru ku; a’disiku eri mi andri ma ori’ba ogogori’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
              "LEV.18.13"
            ]
          }
