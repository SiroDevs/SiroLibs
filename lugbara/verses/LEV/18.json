              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma otru rua pililiru mi ati ma adripi vileri ku, adani mi ma esi oku erini vu ogogo i ku; eri ovu mi andriani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
