            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te alio ka oga erini kabilomva fe kosini, eri ma eji a’balau angara­karu iri kani a’balau o’buru ma anzi iri edeta ezata edezuriru Yehova vu, aluri edeta e’yo onzi edezurini,aziniri edeta vezaruni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ma eji yi kuhani vu, eri nga aria edeta e’yo onzi edezurini ede oko; eri nga drini vi ombeleasi, te ngani ruani ma ale ali ku, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga ari edeta e’yo onzi edezurini ma azi oya pari edeta edezuri ma ruaa ejelealeru, te ari ma joloko acepiri ma ondra dria dria pari edeta edezuri ma ndua; eri edeta e ’yo onzi edezuri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
