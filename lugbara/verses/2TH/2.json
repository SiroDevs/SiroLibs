            }
          ]
        },
        {
          "text": "Te Opi amani Yesu Kristo ma ngulupi, azini Mungu Ata amani, ama lepi, asi omiza ’daniri pi fepi ama dri asi teza onyiru ’yeta anzutirisiri beri ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.16",
            "verseOrgIds": [
              "2TH.2.16"
            ]
          }
        },
        {
