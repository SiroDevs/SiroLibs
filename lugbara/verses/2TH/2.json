          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma omi emi asi, emi ’bazu okporu e’yo ’yeza onyiru pi ma alia e’yo ’yoza pie dria.",
          "type": "text",
          "attrs": {
