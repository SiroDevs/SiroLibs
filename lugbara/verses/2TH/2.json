                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te le ama ma fe awa’difo ’Mungu dri emisi etuzu ’dani, adripi Opini lele ’diyi, a’disiku Munguni lemi opele ndra okokele pata isuzu,Orindini emi ’bale alatararu azini lemini e’yo adaruri a’ilerisirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.13",
            "verseOrgIds": [
              "2TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.7"
              },
              "items": [
                {
                  "text": "1 Tes 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.9"
              },
              "items": [
                {
                  "text": "5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri omve vini emi e’yo ’dirisi e’yo baru amanirisi indi, emi ma isu ani diza Opi amani Yesu Kristoniri beni. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.14",
            "verseOrgIds": [
              "2TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’dirisi, adripi, emi ma so di pa okporu, emi ma bi e’yo idrile emi vu emi imbazu, kani e’yo oluzasi kani waraga amanisi ’diyi ci.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.15",
            "verseOrgIds": [
              "2TH.2.15"
            ]
          }
        }
      ]
