                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.3"
              },
              "items": [
                {
                  "text": "4:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba aluni ma ici emi geri azinisi ku; a’disiku o’du nderi ngani ’nga eca ku, de nga ewu ’bani asizu vile a’ita kuzuri ecani nga okorisi raka ku, azini de nga agu e’yo ezapi onzi, dri jaza mviruri, e’dani nga i ku., ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.3",
            "verseOrgIds": [
              "2TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.36"
              },
              "items": [
                {
                  "text": "Dan 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Eze 28:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agu nderi ipi i uru aga afa dria ’omvele Munguru, kani inzile inzi ’diyi ogazu, kpere eri ma ngulupini rizu hekalu Munguni ma alia i e’dazu ceni, kini i Mungu’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.4",
            "verseOrgIds": [
              "2TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi egani e’yo ndra mani adrile ’yole emi be de ma indi ’diyi kuru? ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.5",
            "verseOrgIds": [
              "2TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te di, emi ni e’yo eri ogapi curu’dori ra, ’dini eri ma ece i ani ewu inisi beni. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.6",
            "verseOrgIds": [
              "2TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.29"
              },
              "items": [
                {
                  "text": "’Yeta 20:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini e’yo vale ku zizaru e’yo onziniri e’do i ’ye ’bo; te ’ba eri ogapiri eri curu’do oga ’dani, cazu kpere yini eri nzeriaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.7",
            "verseOrgIds": [
              "2TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
