                  "text": "83:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi mileni nga ndre ra, emi nga ’yo ani kini, Yehova ovu amboru kalati Israelini ’aa’dasiria!",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
