            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.21"
              },
              "items": [
                {
                  "text": "Azi 15:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emini anyapa mile koko ’diyi feria edetaru, ’di ovuni onzi ku! Emini vini anyapa acoza ’diyi feria azo be ’diyi be, edetaru, ’di ovuni onzi ku! Mi o’bi afa nde ’diyi fe ’ba angu mini dri cepiri dri; eri nga ovu mi vu ayikosi ra ya ? Kani eri nga mi a’i ra ya? Yehova asikari ongulumuruniri ’yoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
