            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.17+LUK.15.18+LUK.15.19"
              },
              "items": [
                {
                  "text": "Luk 15:17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ka ’yo, Ama nga fi akua, abiri amboru tu ovu akua ’dale indi, ama nga odra ’daa; te vuni ama ka ri ’doa ’dani, ama nga odra indio Ka’dini ama mu, ama ma fe ama asikari ongulumuru Suriaa ’diyi dri; yi ka nga ama ku ra ama nga ovu idriru, te yi ka nga ama ofu ra ama nga odra ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.4",
            "verseOrgIds": [
              "2KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga enga angu trasi muzu pari ’ba Suriaa ’diyini hema asozuria; te yi ka ca pari ’ba Suriaa ’diyini hema asozuri ma tia, mi ne, ’ba aluni ’daa yo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.5",
            "verseOrgIds": [
              "2KI.7.5"
            ]
          }
        },
