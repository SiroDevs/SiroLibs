            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.54"
              },
              "items": [
                {
                  "text": "Luk 9:54",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Eliya omvi ambo asikari kali towi ma drilia nderi ma tia kini, Ma ka ovu ’ba Munguni, aci ma efu ’bua esizu va emi evezu kieikiei ’ba kali towi mini ’diyi be. Aci nga di enga ’bua esizu va yi evezu kieikiei ’ba kali towi erini ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
