            "sid": "2KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo eri tia kini, Yehova ’yo ’dini, Mini ojio ’diyi ma ti pele Baali-zebubu adrou Ekiro­niari zizu,- eri ovu a’disiku Mungu ovuni aluni Israeli ma eselia zizu e’yo erinisi ku ya?-e’yo ’disi mi ngani si va gbolo mini lazu driniaria ku, te mi nga dra adaru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.16",
            "verseOrgIds": [
              "2KI.1.16"
            ]
          }
        }
