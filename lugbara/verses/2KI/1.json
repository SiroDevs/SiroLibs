              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojio ’diyi mvi opi vu, te eri ’yo yi tia, Emi emvi a’di e’yosi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.5",
            "verseOrgIds": [
              "2KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.14.32"
              },
              "items": [
                {
                  "text": "O’be 14:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi omvi eri tia, Agu alu emu uru dri fuzu ama be, ’yo ama tia, Emi mvi opi emi ti pepiri vu, emi ’yo eri tia, Yehova ’yo ’dini, Mi pe ’ba ti Baali-zebubu adrou Ekironiari zizu, Munguni ovule aluni Israeli ma eselia kurisi ya? E’yo ’disi mi ngani si va gbolo mini lazu driniaria ku, te mi nga dra adaru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.6",
            "verseOrgIds": [
              "2KI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo yi tia, Agu nde emupi dri fupi emi be, ’yopi emi tiari, eri agu ngonile ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
