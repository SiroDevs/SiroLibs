        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.4"
              },
              "items": [
                {
                  "text": "Zek 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.4"
              },
              "items": [
                {
                  "text": "Mat 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi omvi eri tia kini, Afa suza erini ovu edezaru anyapa ’bikosi, azini eri su enyiriko opilia. Eri ’yo ra, Eri Eliya ’ba Tisibiniri’i.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
