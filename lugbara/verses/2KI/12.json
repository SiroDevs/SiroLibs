            "number": "2",
            "style": "v",
            "sid": "2KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehoasi ’ye e’yo ovupi Yehova ma milia ’yekeri ewu erinisi dria, kuhani Yehoyadani eri imbaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
