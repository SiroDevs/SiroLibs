        },
        {
          "text": "Yehoasi e’do vini opi nyazu eli aziri Yehuni opi nyazurisi, eri nya opi eli kali su Yerusalemua. Andri erini ma ru Zibia Beerisebaari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.1",
            "verseOrgIds": [
              "2KI.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
