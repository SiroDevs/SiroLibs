              "items": [
                {
                  "text": "2 Opi 14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te pari uruleru ’diyi, nzeni yi ku; ’ba yi ede edeta azini yi ve obiese pari uruleru nde ’diyia ’dani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        }
