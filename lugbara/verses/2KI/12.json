              },
              "items": [
                {
                  "text": "1 Sur 29:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehoasi ’yo kuhani tia kini, Silingi dria afa alatararu ’diyi vile ’bani ejile jo Yehovani ma aliari, silingi lale agupi alu alu vusi ewu nderisi ’diyi pie, silingi lale ’ba dria vusi ’diyi pie, silingi dria ’ba ma asini lele fele jile jo Yehovani alia ’diyi pie, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuhani ma ’du ’ba alu alu yini nile ’diyi ma driasi; yi ma ede pari jo ruaa depi de ’diyi ani pari dria e’dapi dezaru ’diyi edezu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.5"
              },
              "items": [
                {
                  "text": "2 Sur 24:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri eca ’dini, eli kali iri drini na Yehoasini opi nyazurisi, isu kuhani edeni nga jo nde deza ’diyi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia Yehoasi omve kuhani Yehoyada, kuhani azini ’diyi be, ’yo yi tia kini, A’di e’yosi emi edeni jo deza ’diyiku ya?’Dini curu’doemi mao’du silingi ’ba emini nile ’diyi ma driasi ku, te ma fe silingi nde ’diyi azi nde deza jo nde ma ruaa ’diyi edezu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani yi a’i yini silingi ’duzu dika ’ba vu ku, a’i vini deza jo ma ruaa ’diyi edezu ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.1"
              },
              "items": [
                {
                  "text": "Luk 21:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te kuhani Yehoyada nga sandu ku ’du, nga sanduku nde ma tala lu drinia, ’ba eri pari edeta edezuri ma ageia, dri ndi ’bani fizu jo Yehova­nirialeruria; te kuhani pari ’bani fizuri ma agei tepi ’diyi yi nga silingi dria ’bani ejile jo Yehovania ’diyi ’ba alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ovu ’dini, yi ka ne silingi ovu tre sanduku nde alia, ’ba waraga opini sipiri pi nga etu kuhani amboruri be, yi nga silingi yini isule Yehovaniri ma alia ’diyi la, nga yi o’ba jurua alia jurua alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga silingi ’bani yi ma nziza o’bile ’bo ’diyi ofe ’ba mbau onduouru ’diyi pi dri ’ba jo onduouru ’diyi be, yi’i azi jo Yehovani ngapi ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga fe indi ’ba biriki ’bapi ’diyi pi dri, ’ba oni gapi ’diyi be, yi fe vini mbau pi jezu oni galeri be, pari jo Yehovani ma ruaa depi de ’diyi edezu, azi dria jo nderi ma ruaari edezurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te silingi ’bani ejile jo Yehovani ma aliarisi yi edeni jo Yehovani dri okelea dahaburu pi ku, akpaa acini ’diyi pie, imvu ’diyi pie, guka pie, kani afazu azini ngoni ngori meleni kani dahabuni ’diyi pie ku, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "a’disiku yi fe silingi nde ’diyi ’ba azi ngapi ’diyi dri, pari jo Yehovani ma ruaa depi de ’diyi edezu ani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
