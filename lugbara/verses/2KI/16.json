              "items": [
                {
                  "text": "Yer 17:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede vini edeta, eri ve obiese pari uruleru ’diyia, azini oni dria, azini pati dria ibiru ’diyi etia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
