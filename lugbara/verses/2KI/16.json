              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geri sabatoniri yini ndra edele jo aliari, azini pari amve opini fizuri, eri oja yi jo Yehovani vu, opi Asuriaari ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
