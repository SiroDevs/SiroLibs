              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te kuhani Uriya ’ye ’dini, ekile e’yo dria opi Ahazini azilerile.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
