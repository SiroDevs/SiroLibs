              "items": [
                {
                  "text": "1 Opi 14:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.5+ISA.57.6+ISA.57.7"
              },
              "items": [
                {
                  "text": "Isa 57:5-7",
