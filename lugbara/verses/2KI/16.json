                "loc": "2KI.12.18"
              },
              "items": [
                {
                  "text": "2 Opi 12:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aha­zi ’du dahabu pi mele be ovupi jo Yehovani ma alia, ovupi vini lonyi aje be ambo jo opini ma aliari ma eselia ’diyi, eri pe yi ti fetaru opi Asuriaari dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.5"
