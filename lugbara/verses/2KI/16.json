        },
        {
          "text": "Ahazi Yotamu mvi opi Yudaari e’do opi nyazu eli mudri drini aziri Peka Remalia mvini opi nyazurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
