              "items": [
                {
                  "text": "Amo 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.6"
              },
              "items": [
                {
                  "text": "Isa 22:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Asuriaari eri e’yo erini; te opi Asuriaa nderi mu uru a’di ’dizu Damasikiaa, ’du eri, o’du vini ’ba alenia ’diyi ati’baru, ji yi Kiria, fu Rezinini ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi Ahazi nga mu Damasi­kia dri fuzu T’igilati-pileseri opi Asuriaari be, eri nga pari edeta edezu Damasikiari ndre. Opi Ahazi pe wura pari edeta edezu nderiniri ma ti ji kuhani Uriya vu, o’biza erini be, trotro azi dria yini ’yele eri ma ruaarile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te kuhani Uriya nga pari edeta edezuri si ani, dria ekile e’yo nde Ahazini tini epele engazu Damasikiasirile, kuhani Uriya ede eri ’dini de nga opi emvini Damasikiasi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.1"
              },
              "items": [
                {
                  "text": "1 Opi 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.16"
              },
              "items": [
                {
                  "text": "2 Sur 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opini emviria Damasikiasi, opi ne pari edeta edezu nderi. Eri mu ogogo pari edeta edezu nderi vu, eri ede edeta drinia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ve edeta vezaru eriniri pi edeta edele anyafurasiri pie, eri osu edeta mvuzaru eriniri, eri oya vini ari edeta asi anzuruni eriniri pari edeta edezu nderi ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
