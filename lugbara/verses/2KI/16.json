            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli Ahazini ovu kali iri erini e’dozu opi nyazurisi, eri nya opi eli mudri drini azia Yerusalemua. Eri ’yeni e’yo ovupi onyiru Yehova Mungu eriniri ma miliari ekile ati Daudini ’yele ndrarile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
