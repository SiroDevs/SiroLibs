                  "text": "2 Sur 28:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Ahazi nga ojio ma ti pe Tigilati-pileseri opi Asuriaari vu, ’yozu kini, Ma ovu ati’bo mini, mvi mini indio Mi emu uru ma pazu opi Suriaari pi ma driasi opi Israeliniri be, yi a’di ’dipi ma be ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
