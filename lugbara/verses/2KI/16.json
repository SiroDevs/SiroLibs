                  "text": "2 Sur 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pari edeta edezu edele molasi ovupi Yehova ma driliari, eri ’du eri engazu jo drilia pari agaduariasi, engazu pari edeta edezu eriniri pi ma eselia jo Yeho­vaniri beriasi, eri ’ba eri pari edeta edezu eriniri ma kalaa andraleruria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
