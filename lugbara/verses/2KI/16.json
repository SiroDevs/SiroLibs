              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Yeta azini dria Ahazini ’yele ’diyi, yi sini yi buku opi Yudaa ’diyi ma e’yo ecezuri ma alia ku ya? ",
          "type": "text",
          "attrs": {
