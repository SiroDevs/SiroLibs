        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.1"
              },
              "items": [
                {
                  "text": "Isa 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Rezini opi Suriaari pi nga emu a’di ’dizu Yerusalemua, Peka Remalia mvi be; yi ’di a’di Ahazi be, i te yi econi eri agazaru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.22"
              },
              "items": [
                {
                  "text": "2 Opi 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ewu nderisi Rezini opi Suriaari omvi Elatini Suria vu, eri dro ’ba Yahudini Elatiasi, te ’ba Suriaa ’diyi nga fi Elatia,ovuzu ’dale ecazu andru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
