              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi emvi eri vu erini teria Yerikoa, te eri nga ’yo yi tia kini, Ma ’yoni ndra emi tia, Emi ma mu ku, ’dini ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        },
