                "loc": "ACT.1.10"
              },
              "items": [
                {
                  "text": "’Yeta 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo ra, Mi zi e’yo ewaru; mi ka ma ne mani ovuria nzezaru mi vusiria, eri nga ovu mi dri ’dini; te ka yo, eri ngani ovu ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
