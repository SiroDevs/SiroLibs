                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.3.16"
              },
              "items": [
                {
                  "text": "Yos 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Eliya nga bongo ’beza erini ’du, nga eri tra tualu, nga yi co ani, te yi nga esele co ra, ’dini yi aga yi eseliasi angu angaza driasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.17+NUM.11.18+NUM.11.19+NUM.11.20+NUM.11.21+NUM.11.22+NUM.11.23+NUM.11.24+NUM.11.25"
              },
              "items": [
                {
                  "text": "Kal 11:17-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, yi ka zo ’bo, Eliya nga ’yo Elisa tia kini, Mi zi ma tia e’yo mini lele ma ma ’ye mi driri oko de nga nzeni ma mi vusi ku. Te Elisa ’yo ra, Mi fe orindi mini ma esele ma dri paleko iri fo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
