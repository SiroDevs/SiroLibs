          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo ra, Emi eji ma dri imvu o’diru, emi ’ba a’i alenia. Yi eji di eri vu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
