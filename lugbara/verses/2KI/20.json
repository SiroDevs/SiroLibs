                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.38.8"
              },
              "items": [
                {
                  "text": "Isa 38:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te nabi Isaya wu Yehova vu; eri omvi endrilendri esipi va etusi ’bo pati Ahazini etu o’bizuri ma driari vile pa ’baza mudri ani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        }
      ]
