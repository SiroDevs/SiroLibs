              "items": [
                {
                  "text": "Dan 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi mini efupi mi ruaa ’diyi, mini ngale tile ’diyi ma eselia, yi nga azini ’diyi wu ji ’dale; yi nga ovu ’ba nzele ranyaru ’diyi opi Babuloniari vile jo alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.18",
            "verseOrgIds": [
              "2KI.20.18"
            ]
