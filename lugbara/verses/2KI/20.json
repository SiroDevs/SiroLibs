            "number": "2",
            "style": "v",
            "sid": "2KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nga di mile erini oja abi ruaaleru, eri zi Yehova tia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.2",
            "verseOrgIds": [
              "2KI.20.2"
