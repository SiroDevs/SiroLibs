              "items": [
                {
                  "text": "52:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ne, o’duni nga eca, afa dria jo mini ma alia ’diyi, azini afa dria mi a’bipini tani mbale ecazu andru ’diyi, yi nga yi wu ji Babulonia; afa aluni ngani ace ku, Yehova ’yoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.17",
            "verseOrgIds": [
              "2KI.20.17"
            ]
          }
        },
