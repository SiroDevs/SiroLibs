        },
        {
          "text": "Te kuhani fe ambo asikari turu alu drilia ’diyi dri aju piyi gombere pie ovupi jo Yehovania ’diyi, yi ovu ndra afa opi Daudini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba agei tepi ’diyi, dria alu alu afa ombani ’diyi be yi ma dria, nga pa so engazu jo kalaa dri ndiaria cazu jo kalaa dri ejiaria, pari edeta edezuri pi ma ageia jo be, opi ma ageiasi kuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
