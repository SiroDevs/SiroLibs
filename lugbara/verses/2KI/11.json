                  "text": "O’be 11:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ’ba dria angu ndea ’diyi ovu ayikosi; te yini Ataliani fuzu seisi jo opiniriari ma vutia aku nde ovu ciri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.20",
            "verseOrgIds": [
              "2KI.11.20"
            ]
          }
        },
