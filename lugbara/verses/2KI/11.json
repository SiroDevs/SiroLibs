        },
        {
          "text": "Atalia Ahazia andri ka mva erini dra ’bo, eri ori’ba opini ma dri jazu ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehoseba opi Yoramu zi, Ahazia amvi’i, eri ’du Ahazia mvi Yoasini, ogu eri opianzi ngapi dri japi ’diyi ma eseliasi, ’ba eri endria erini be jo lazuri alia. Eri zi eri Atalia ma e’yosi, ’dini eri kazu eri fuzu ku; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
