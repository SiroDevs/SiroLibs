                "loc": "PSA.12.8"
              },
              "items": [
                {
                  "text": "Zab 12:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ovu eri be zizaru jo Yehovani ma alia eli azia. Te Atalia nya opi angu nderiani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.23.1"
              },
              "items": [
                {
                  "text": "2 Sur 23:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eli azirisi Yehoyada pe ’ba ti ’ ambo asikari turu alu ’diyi drilia, ’ba suru Karini azini ’ba agei tepi ’diyini ’diyi omvezu, eri ji yi jo Yehovani ma alia; eri azi aziza yi be, eri fe yini oyo so jo Yehovani ma alia, eri e’da opi mvini yi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.25"
              },
              "items": [
                {
                  "text": "1 Sur 9:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri fe azita yi dri kini, ’Diri e’yo emini ngale ’yeleri: Emi ’ba na ma esele aluri efipi sabatosi ’diyi yi nga opi ma jo agei teni; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.5",
            "verseOrgIds": [
              "2KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "emi ’ba na ma esele aluri nga ovu kalitile omvele Suriruria; azini emi ’ba na ma esele aluri nga ovu kalitile ’ba ageini tepi ’diyi ma ngukuaria; ’dini emi nga jo agei te, nga ovu afa geri asepiriru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.6",
            "verseOrgIds": [
              "2KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi­kari ongulumuru ongulumuru emini iri efupi sabatosi ’diyi nga jo Yeho­vani ma agei te opi ma ageia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.7",
            "verseOrgIds": [
              "2KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi nga opini ace kuru, emi dria alu alu afa ombani be emi dria; te ’ba ’yepi fipi emi eseliasiri emi ma fu eri ra. Emi ma ovu opi be ’dani, erini furia azini firia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.23.8"
              },
              "items": [
                {
                  "text": "2 Sur 23:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ambo asikari turu alu drilia ’diyi, yi ’ye dria ekile kuhani Yehoyadani azilerile, yi dria alu alu eji ’ba yini efipi sabatosi ’diyi pi ’ba efupi sabatosi ’diyi be, yi mu kuhani Yehoyada vu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
