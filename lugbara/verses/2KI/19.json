              "items": [
                {
                  "text": "Yer 51:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ne, ma nga orindi ’ba eri alia, eri nga e’yo kuza eri, eri nga mvi angu eri ngulupinia; te ma nga fe erini ’dezu drazu seisi angu eri ngulupini ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.7",
            "verseOrgIds": [
              "2KI.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
