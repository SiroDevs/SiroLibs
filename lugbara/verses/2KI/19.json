                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba acepi ’diyi nga fu Yeru­salemuasi, ’ba apapi ’diyi nga fu Zioniasi. Asi aciru Yehovani nga e’yo ’di ’yeni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.31",
            "verseOrgIds": [
              "2KI.19.31"
            ]
          }
        },
