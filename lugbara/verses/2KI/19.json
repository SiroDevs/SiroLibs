                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.24"
              },
              "items": [
                {
                  "text": "17:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Hamatiniri pi, opi Aripadiniri pie, opi aku Sefarivai­muari pie, opi Henaniri pie, opi vaniri pie, yi ngoa ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.13",
            "verseOrgIds": [
              "2KI.19.13"
            ]
          }
        },
        {
