              },
              "items": [
                {
                  "text": "2 Opi 18:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Rabisake mvi ra, eri isu opi Asuriaari a’di ’diria Libinaa; te eri eri ndra kini eri ku Lakisini ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.8",
            "verseOrgIds": [
              "2KI.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.27"
              },
              "items": [
                {
                  "text": "1 Sam 23:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.9"
              },
              "items": [
                {
                  "text": "Isa 37:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ka eri e’yo Tirihaka opi Etiopiaarini, kini, Eri pe ’ba ti a’di ’dizu mi be ’bo, eri pe ojio ti dika Hezikia vu ’yozu kini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.9",
            "verseOrgIds": [
              "2KI.19.9"
            ]
          }
        },
        {
