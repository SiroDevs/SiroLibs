              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba jolokoru acepi yi papi suru Yudani ma eselia ’diyi, yi nga ola yini so va dika, yi nga vini efi ’ya uru indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.30",
            "verseOrgIds": [
              "2KI.19.30"
            ]
          }
        },
