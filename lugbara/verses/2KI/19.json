          ]
        },
        {
          "text": "Isaya nga ’yo yi tia kini, Emi ma ’yo opi emini tia, Yehova ’yo ’dini kini, Mi ru ku e’yo mini erile ’diyisi, e’yo nde ati’ba opi Asuriaarini ’diyini ma o’dazu ’diyisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.6",
            "verseOrgIds": [
              "2KI.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
