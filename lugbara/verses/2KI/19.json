            "number": "32",
            "style": "v",
            "sid": "2KI 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi Yehova ’yo ’dini opi Asuriaari ma e’yosi, kini, Eri ngani si va aku ’doria ku, eri ngani vini ’ye gbi ’daa ku, ngani vini ca vunia gombere be ku, ngani nyaku oku apiferu ageinia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga mvi geri nde erini muzurisi indi, te eri ngani fi aku ’dori ma alia ku, Yehova ’yo ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.33",
            "verseOrgIds": [
              "2KI.19.33"
            ]
          }
