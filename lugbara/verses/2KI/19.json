              "attrs": {
                "loc": "EZK.27.23"
              },
              "items": [
                {
                  "text": "Eze 27:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Adrou suru ndu nduni, ma a’bipini yi dri jale, yi Gozani pi, Harani pie, Reze­fu pie, anzi Edeni ovupi ndra Tela­saria ’diyi pie ’diyi, yi opa yi ndra ra ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.12",
            "verseOrgIds": [
              "2KI.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
