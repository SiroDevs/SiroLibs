              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kani Yehova Mungu miniri nga e’yo dria Rabisake, opi erini opi Asuriaarini tini epele Mungu idriru o’dazurini ’yole ’diyi eri ra, kani eri nga e’yo okporu omvi e’yo nde Yeho­va Mungu minirini erile ’diyi ma e’yosi; e’yo ’disi mi zi ’ba joloko acepi ’diyi ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.4",
            "verseOrgIds": [
              "2KI.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati’ba opi Hezekiani ’diyi ka eca Isaya vu, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.5",
            "verseOrgIds": [
              "2KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
