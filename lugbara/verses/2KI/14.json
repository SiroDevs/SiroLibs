                  "text": "Yos 21:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Amazia leni e’yo eri ku. ’Dini Yehoasi opi Israeliniri tu uru, yi one yi milia milia Amazia opi Yudaari be Beti-semesi aku Yudaa­ria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.11",
            "verseOrgIds": [
              "2KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Israeli aga Yuda ra, yi dria alu alu nzu hema yinia ani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.12",
            "verseOrgIds": [
              "2KI.14.12"
            ]
          }
        },
