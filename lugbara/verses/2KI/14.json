              "items": [
                {
                  "text": "2 Opi 24:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri wu mele pi, dahabu pie, afazu dria jo Yehovaniri ma alia ’diyi pi, azini ovupi lonyi aje be ambo opi ma jo aliari ma eselia ’diyi pie, ’ba obile aruru ’diyi pie, yi mvi Samariaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
