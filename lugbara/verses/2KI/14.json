        },
        {
          "text": "Adaru mi co Edomuni ’bo, asi mini ovu afusi ani. Mi enya mi e’yo nderisi, mi te angu minia; te mi le fi e’yo ’diri ma alia aka apadriru, candi isuzu, mini ngazu e’dezu Yuda be tualu a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
