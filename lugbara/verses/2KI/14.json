        },
        {
          "text": "Amazia Yoasimvi,opi Yudaari, ovu idriru eli mudri drini towi Yehoasi Yehoahazi mvini drazuri ma vutia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.17",
