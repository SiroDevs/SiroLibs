              },
              "items": [
                {
                  "text": "2 Opi 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Yeta azini dria Yehoasini ’yele ’diyi, okpo erini pie, e’yo erini a’di ’dizu Amazia opi Yudaari beri pie, yi sini yi buku opi Israelini ’diyi ma e’yo ecezuri ma alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
