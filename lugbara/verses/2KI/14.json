            }
          ]
        },
        {
          "text": "Te Yehova ’yoni ndra ku i nga ru Israelini ini ’bu etiasi; te eri pa yi Yeroboamu Yoasi mvi ma drisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
