        },
        {
          "text": "Vutinia Amazia nga ojio ma ti pe Yehoasi, Yehoahazi Yehu mvi ma mvi opi Israeliari vu ’yozu kini, Mi emu, ama one ama milia milia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.8",
            "verseOrgIds": [
              "2KI.14.8"
            ]
          }
        },
