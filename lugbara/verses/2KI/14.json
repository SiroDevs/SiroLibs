                }
              ]
            }
          ]
        },
        {
          "text": "Te Amazia Yoasi mvi, opi Yudaari, e’do opi nyazu eli iri Yoasi Yehoahazi mvi opi Israelini opi nyazurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
            "verseOrgIds": [
              "2KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli erini ovu kali iri ’drini towi erini e’dozu opi nyazurisi, eri nya opi eli kali iri drini oro­mi Yerusalemua. Andri erini ma ru Yehoadini Yerusalemuari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.2",
            "verseOrgIds": [
              "2KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’ye e’yo ovupi onyiru Yehova ma miliari, te trotro i a’bi Daudini ’yelerile ku; eri ’ye dria i ati Yoasini ’yelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
