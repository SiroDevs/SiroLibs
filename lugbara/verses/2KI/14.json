              },
              "items": [
                {
                  "text": "22:43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te nzeni pari uruleru ’diyi ku; ’be yi ede edeta azini yi ve obiese pari uruleru ’diyia nga ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        },
        {
