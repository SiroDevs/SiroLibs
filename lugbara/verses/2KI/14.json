              "items": [
                {
                  "text": "2 Opi 12:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri eca ’dini, eri ka ne i isu okpo opiniri i dria ’bo, mbele eri ofu ati’ba ini i atini fupi ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.5",
            "verseOrgIds": [
              "2KI.14.5"
            ]
          }
        },
