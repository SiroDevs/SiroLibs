        },
        {
          "text": "Mi tu uru kuhani ambo Hilikia vu, ’dini eri ma la silingi ’bani jile jo Yehovania, ’ba pari ’bani fizuri agei tepi ’diyini okule ’ba nde ’diyi vuri; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.4",
            "verseOrgIds": [
              "2KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
