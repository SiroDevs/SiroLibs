              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, ’ba ka ace mudri jo alu ma alia, yi nga odra ra. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
