          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia nga vini ’yo Amosi ma tia, Mi ’ba e’yo ndreza ndrepiriru mi’i, mi mu, mi nzu angu Yudaa ’dale, mi nya nyaka ’dale, mi ondri e’yo’dale; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
