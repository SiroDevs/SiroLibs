              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.12"
              },
              "items": [
                {
                  "text": "Amo 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te mi ma ondri e’yo azini Betelia dika ku, erini ovule pari alatararu opini, azini erini ovule jo opinirisi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
