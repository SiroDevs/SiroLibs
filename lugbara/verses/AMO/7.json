                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova nga asi omvi e’yo ’dirisi; E’yo ’diri ngani ovu ku indi, Yehova ’yo ra.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
