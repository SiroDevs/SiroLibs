              "items": [
                {
                  "text": "2 Opi 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etu ’dasi Amazia kuhani Beteliari nga ’ba ti pe Yeroboamu opi Israeliniri vu kini, Amosi otu e’yo ’diri omba ’bazu mi be suru ’ba Israelini ma eselia; angu ’dori econi e’yo dria erini ’yole ’diyi a’izaru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku Amosi ’yo ’dini kini, Yeroboamuni nga dra seisi ra, azini yi nga Israelini bi ati’baru ofuzu angu yiniarisi ra adaru.;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
