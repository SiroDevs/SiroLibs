        },
        {
          "text": "Yehova nga asi omvi e’yo ’dirisi; Eri ngani ovu ’dini ku, Yehova ’yo ra.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
