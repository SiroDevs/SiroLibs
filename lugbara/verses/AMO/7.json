              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.13"
              },
              "items": [
                {
                  "text": "2 Opi 21:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.17"
              },
              "items": [
                {
                  "text": "Isa 28:17",
                  "type": "text"
                }
