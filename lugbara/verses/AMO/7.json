                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amosi nga e’yo omvi, nga ’yo Amazia tia kini, Ma ovuni ndra nabini ku, ma ovuni vini nabi ma ’mva ku indi; te ma ovu ndra ’ba kabilo ocepiri, ’ba elio pati ma rua edepiri indi; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
