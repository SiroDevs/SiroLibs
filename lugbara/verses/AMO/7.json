              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga afa ece ma dri ’dini te mi ndre, Opi so pa abi sile baka afa ma kilili o’bizurisiri ma ageia’i baka nde afa o’bizuri eri ma dria indi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
