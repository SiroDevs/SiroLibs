            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.16+ISA.1.17+ISA.1.18+ISA.1.19"
              },
              "items": [
                {
                  "text": "Isa 1:16-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi curu’do mi ma ’yo ’ba Yudani ma tia ’ba ovupi Yerusalemua ’diyi be kini: Yehova ’yo ’dini, Emi ne, ma e’yo onzi ede emi ruaa, ma e’yo onzi ma geri ndru emi ruaa. Emi emvi curu’do emi alu alu, geri onzikanyaru emini kuzu, emi ede geri emini onyiru ’yeta emini be.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        }
