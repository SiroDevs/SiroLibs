        },
        {
          "text": "suru nde mani e’yoni ’yole aniri, ka i oja, ka e’yo onzi iniri ku ra, ka’dini ma’i indi, ma nga ma oja e’yo onzi te mani egale ma nga ’ye yi vuri ku ja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te etu mani e’yo ’yozu suru azini ma e’yosi, kani opi nyaza azini ma e’yosi, eri edrezu uru, azini eri isizu nyakua­nsi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ka azi onzi ’ye ma milia, ka ma o’duko eri ku, ka’dini ma nga ma oja e’yo onyiru te mani ’yole ma nga ’ye yi vuri ku ja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        },
