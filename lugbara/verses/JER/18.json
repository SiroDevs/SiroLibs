                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etu mani e’yo ’yozu suru azini ma e’yosi, kani opi nyaza azini ma e’yosi, eri onzezu, eri onyozu va, azini eri ma dri jazurisi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
