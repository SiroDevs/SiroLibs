              "items": [
                {
                  "text": "Zab 119:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma riga asi fe yi dri ma nizu, kini ma Yehova’i; te yi nga ovu suru mani, ma nga ovu Mungu yini, yini ngale emvile ma vu dika yi ma asisi driarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 24:8"
          },
          "items": [
