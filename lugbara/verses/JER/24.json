              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.17"
              },
              "items": [
                {
                  "text": "Yer 29:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.1"
              },
              "items": [
                {
                  "text": "43:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ekile elio efi mazaru ’bani ecole nyale ku yini ovule onzika­nyaru turisi ’diyile, Yehova ’yo ’dini ada, Ma nga Zedekia opi Yudaari fe ’dinile, opianzi erini pie, ’ba acepi Yerusalemua angu ’dorima alia ’diyi pie, ’ba adripi angu Misirinia ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.13"
              },
              "items": [
                {
                  "text": "Zab 44:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga fe yi co panyile ’dole, ’dale, suru dria angu wudrikuruni ma eselia drileonzisi, yini ovuzu afa onzozaru, e’yo o’bezale, o’datale, otriaru pari dri dria mani ngale yi drozuria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma nga sei pi ma ti pe liki pie, mua azo pie yi ma eselia, de nga yi jani dri angu mani fele yi dri yi ma a’bipi pieriasi ku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.10",
            "verseOrgIds": [
              "JER.24.10"
            ]
          }
        }
