          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.9"
              },
              "items": [
                {
                  "text": "Zek 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.11"
              },
              "items": [
                {
                  "text": "Ebra 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova Mungu Israeliniri ’yo ’dini kini: Ekile elio efi onyiru ’diyile, ’dini ma nga ’ba Yudaa ovupi ati’baru, mani ofule pari ’diasi yi ti pele angu Kalideyania ’diyi ma e’yo ’lega yi ’yezu onyiru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
