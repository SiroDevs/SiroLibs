                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova eri ’yepiri ’yo ’dinile, Yehova eri edepi fepi erini pa sozuri -runi Yehova’i: ",
          "type": "text",
          "attrs": {
