              },
              "items": [
                {
                  "text": "Isa 65:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruniri ’yo ’dini: ’Ba kabilo ocepi, fepi kabilo yini ma ola yi va ’diyi, nga yi ma ’boroko si pari ’do ovupi andruru ’ba kokoru azini anyapa kokoruri ma alia dika, nga vini ’boroko si aku amboru erini vusi dria indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
