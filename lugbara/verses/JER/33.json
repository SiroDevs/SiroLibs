        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Yer 21:44",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.26"
              },
              "items": [
                {
                  "text": "Isa 1:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga ’ba Yuda pini Israeli be, ndra bile ati’baru ’diyi omvi vile, yi sizu uru ekile ndra okorile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.7",
