                "loc": "LAM.3.15"
              },
              "items": [
                {
                  "text": "Imv 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi Yehova asikari ongulumuruni, Mungu Israeliniri ’yo ’dini: Mi ndre, ma nga suru ’diri dri enyata okaru fe nya, ma nga aro drapi ojileri fe mvu yi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        },
