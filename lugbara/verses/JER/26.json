              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba edeta edepi ’diyi, nabi pie, ’ba dria be, yi nga Yeremiani eri erini e’yo ’diyi ’yoria Yehova vile joa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
