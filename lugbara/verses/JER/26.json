              "items": [
                {
                  "text": "Mat 27:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, Yeremia ka e’yo dria Yehovani azile eri tia oluzu ’ba dria ma tiari olu de ’bo, ’ba edeta edepi ’diyi pi, nabi pie, ’ba dria pie, nga eri bi ra, kini, Mi nga dra ada! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ondri e’yo Yehova ma rusi ’yozu kini, ’diri nga ovu Silole, azini aku amboru ’dori nga ovu andruru ’ba kokoru, ’dini a’disi ya? Te ’ba nga yi oku dria Yeremia vu Yehova vile joa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
