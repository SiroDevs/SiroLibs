                  "text": "’Yeta 5:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’wara azini angu ndea ’diyi nga di enga e’yo ’yo ’ba ongulumuru yi okupi tualu ’diyi ma tia kini, ",
          "type": "text",
          "attrs": {
