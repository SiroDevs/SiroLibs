                  "text": "18:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kani yi nga eri ra yani, nga yi oja ’ba dria alu alu geri ini onziri kuzu; ’dini ma eco ani ma asi omvizu e’yo onzi nde mani egale ma asia ma nga ’ye yi ma ruaa ’yeta yini onzikanyaru ’diyi ma e’yosiri kuzu indi beni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
