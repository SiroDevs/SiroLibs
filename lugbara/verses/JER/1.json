              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’yoza Hilikia mvi, Yeremia, ’ba edeta edepi Anatoti angu Benyamininiari ma alia ’diyi ma, azi aluni ’yole ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
