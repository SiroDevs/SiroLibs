                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.3+REV.11.4+REV.11.5+REV.11.6"
              },
              "items": [
                {
                  "text": "Eceza 11:3-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.4"
              },
              "items": [
                {
                  "text": "2 Kor 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ne, ma ’ba mi andru suru ndu ndu ma drilia opi nyaza be,onzezu azini onyozu, dri jazu azini o’bezu va, sizu uru azini afa sazu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
          }
        }
      ]
