                  "text": "51:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etu ’dasi Yehova nga i ma dri eju, nga ma ti do ani; azini Yehova nga, ’yo ma tia, Mi ndre, ma ’ba e’yo ’yoza mani mi tia ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
