              },
              "items": [
                {
                  "text": "2 Opi 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "2 Opi 23:36–24:7; 24:18–25:21",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7+2CH.36.8"
              },
              "items": [
                {
                  "text": "2 Sur 36:5-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13+2CH.36.14+2CH.36.15+2CH.36.16+2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "11-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri eca indi ewu Yehoyakimu Yosia mvi opi Yudaarinisi, cazu kpere eli mudri drini alu Zedekia Yosia mvi opi Yudaarinia, kpere mba towi yini ’ba Yerusalemuni ’duzu ati’baruria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
