                "loc": "2PE.1.21"
              },
              "items": [
                {
                  "text": "2 Pet 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.3"
              },
              "items": [
                {
                  "text": "Yer 25:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "2 Opi 22:3–23:27; 2 Sur 34:8–35:19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Yehovani eca eri vu ewu Yosia Amo li mvi opi Yudaarinisi, eli mudri drini na emu opi nyazurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
