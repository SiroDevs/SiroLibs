                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga fe ’ba ma o’be yi ’dile azini ’dole suru nyaku dri dria ’diyi ma eselia, Manase, Hezekia mvi opi Yudaari ma e’yosi, e’yo erini ’yele Yerusalemuarisi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
