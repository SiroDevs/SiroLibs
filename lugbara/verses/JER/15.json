                "loc": "DEU.28.26"
              },
              "items": [
                {
                  "text": "Azi 28:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga suruti ope su yi dria, Yehova ’yo ra: sei ’ba olizu, oce ’ba ocizu, aria ’bua ’diyi pi nguru nyakua ’diyi pie, yi ocizu azini yi ma dri jazu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
