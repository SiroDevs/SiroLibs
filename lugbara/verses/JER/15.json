                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Eceza 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, yi ka ’yo mi tia, Ama fu muzu ngoa ya? mi nga di olu yi ma tia, Yehova ’yo ’dini: ’Ba opele drani ’diyi ma mu draa, seini ’diyi ma mu sei sia; opele likini ’diyi ma mu liki vu, opele ati’baru ’diyi ma mu ovu ati’baru. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
