        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.16"
              },
              "items": [
                {
                  "text": "Lev 26:16",
                  "type": "text"
                }
