            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.1+2CH.33.2+2CH.33.3+2CH.33.4+2CH.33.5+2CH.33.6+2CH.33.7+2CH.33.8+2CH.33.9"
              },
              "items": [
                {
