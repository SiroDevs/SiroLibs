              "items": [
                {
                  "text": "Isa 52:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.3"
              },
              "items": [
                {
                  "text": "Yer 17:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga afa mini ovuzu yi be ’diyi pi fe afa opazale aje kokoru, lonyi mini be; ma nga ’ye ’dini kala mini dria ma alia, e’yo onzi mini dria ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.22"
              },
              "items": [
                {
                  "text": "Azi 32:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ma nga fe yi ma aga ari’ba mini be tualu angu mini nile kuria; adra mani ngapi dipi mi driari ma acini ti kole ’borisi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
