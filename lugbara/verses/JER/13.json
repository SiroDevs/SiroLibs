              "items": [
                {
                  "text": "Azi 32:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma eri, emi co bile; emi ma ovu asi afuru be ku, a’disiku Yehova ’yo e’yo ’bo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
