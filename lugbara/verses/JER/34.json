        },
        {
          "text": "E’yo ecapi Yeremia vu engapi Yehova vu, etu Nebukadineza opi Babuloniari pi, asikari ongulumuru erini ’diyi pie dria, suru angu: wudrikuru drisi aria ovupi eri ma palaa ’diyi pie, ’be dria pie, yini omba ’bazu Yerusalemu be, aku amboru erini ’diyi be driarisiri, eri ’dini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.1",
            "verseOrgIds": [
              "JER.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 34:2"
          },
          "items": [
