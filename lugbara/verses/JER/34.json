                {
                  "text": "Neh 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.39"
              },
              "items": [
                {
                  "text": "Lev 25:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba dria alu alu ma otru ati’ba yini agupiru ’diyi, ’ba dria alu alu ma tru ati’ba yini ezoanziru ’diyi, yi ka ovu Ebraniou kani Ebra­niou zaŋaru; ’ba aluni ma ayu yi ati’baru ku, ’ba Ebraniani azi ngazu ati’boru adripi dri ’dini aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.9",
            "verseOrgIds": [
              "JER.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba opiru dria yi a’i e’yo ’diri ra, ’ba ’diyi be dria, yi a’i aziza nde kini yi dria alu alu ma tru ati’bo agupi­ruri, yi dria alu alu ma tru ati’ba zanaruri, te ’ba aluni ma ayu yi ati­’boru dika ku; yi a’i ra, truyi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.10",
            "verseOrgIds": [
              "JER.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.5"
              },
              "items": [
                {
                  "text": "Yer 37:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.6.4"
              },
              "items": [
                {
                  "text": "Hos 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te vilerisi yi oja yi ra, yi fe ati’ba agupiru ’diyi pi ati’ba ezoanziru be, yini trule ’bo ’diyi ma emvi be yi vu yi ombezu yi ma ati’ba agupiru azini ati’ba ezoanziru ’diyiru dika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.11",
            "verseOrgIds": [
              "JER.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi e’yo Yehovani nga di eca Yeremia vu engazu Yehova vu kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.12",
            "verseOrgIds": [
              "JER.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mungu Israeliniri ’yo ’dini: Ma azi ndra aziza emi a’bipi be, o’du ndra mani yi ofuzu angu Misiriniarisi, engazu jo ati’baniarisi, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.13",
            "verseOrgIds": [
              "JER.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 34:14"
          },
          "items": [
