        },
        {
          "text": "E’yo ecapi Yeremia vu engapi Yehova vu ’dini, o’du opi Zedekiani aziza azizu ’ba dria ovupi Yerusale­mua ’diyi tia, e’yo trutani azizu yi tia ’borisi, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.8",
            "verseOrgIds": [
              "JER.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 34:9"
          },
          "items": [
