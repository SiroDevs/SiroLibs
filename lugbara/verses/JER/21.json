              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Sur 36:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi zie’yo Yehova tia ama dri, ma matu ’ba mi vu, Nebukadreza opi Babu­loniarini omba ’bale ama berisi; kani Yehovani nga ama ’ye ’yeta erini osutaru ’diyi dria vusi yani, fezu eri ma ku ama ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia nga di ’yo yi tia: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.4"
              },
              "items": [
                {
                  "text": "Isa 13:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ’yo Zedekia tia ’dini kini, ’Yehova Mungu Israeliniri ’yo ’dini: Emi ndre, ma nga afa ombani emini dria, emini omba ’bazu opi Babu­loniari pi be ’ba Kalideyani emi acepi kuru ovupi abi kaliru ma ageia amveleru ’diyi be ’diyi oja vile; azini ma nga ’ba ’diyi oku aku amboru ’dori ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.6"
              },
              "items": [
                {
                  "text": "Efu 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ma pini nga a’di ’di emi be ma’i, dri ejuzasi azini wu okporusi, aokosi, asi vezasi, azini adra okarurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma nga ’ba ovupi aku amboru ’dori ma alia ’diyi oco ra, ’ba piyi anyapa pie; yi nga odra dra amboru muarurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
