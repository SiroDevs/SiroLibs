              },
              "items": [
                {
                  "text": "37:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ma ’ba ma mile aku amboru ’dori vu eri ’yezu onzi, te eri ’yezu onyiru ku, Yehova ’yo ra: eri nga ovu fezaru opi Babuloniari ma dria, azini eri nga eri eve acisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ori’ba opi Yudaarini ma e’yosi, emi ma eri e’yo Yehovani,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
