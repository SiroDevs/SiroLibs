              "items": [
                {
                  "text": "Isa 1:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi nga ’yo ’dini suru ’diri tia: Yehova ’yo ’dini kini: Emi ndre, ma ’ba emi drilia geri idriniri pi geri drataniri be. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
