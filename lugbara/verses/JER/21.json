              },
              "items": [
                {
                  "text": "2 Sur 36:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ye-hova ’yo ra, Te vutinia ma nga Zedekia opi Yudaari pi, ati’ba erini pie, ’ba erini pie, adaru ’ba acepi aku amboru ’dori ma alia azo muaruri pini kule sei pie, tiki pie ’diyi fe Nebukadreza opi Babuloniari pi ma dria, ari’ba yini pie, ’ba ndrupi yi fupi ’diyi pie. Eri nga yi oli sei sisi; eri ngani yi ku ku, ngani ovu yikisi ku, ngani vini ovu asi ndrizasi yi vu ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
