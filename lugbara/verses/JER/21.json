              "attrs": {
                "loc": "JER.39.18"
              },
              "items": [
                {
                  "text": "39:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ovupi aku amboru ’doriari nga dra seisi, azini likisi, azini azo muarurisi; te ’ba fupi amve fipi ’ba Kalideyani emi acepi kuru ’diyiruri nga ovu idriru, idri eriniri nga ovu eri vu ekile afa erini opale omba aliarile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
