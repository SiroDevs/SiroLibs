            {
              "text": "12:39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te di, mi ma eri curu’do e’yo mani ’yole mi bilia azini ’ba dria ma bilia ’diri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.7",
            "verseOrgIds": [
              "JER.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabi andra ma drilia azini mi drilia oko ’diyi, yi ondri e’yo angu kakau ma dria, azini suru ambo ambo ’diyi ma dria, e’yo omba pinisi e’yo onzi pie, azo muani pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.8",
            "verseOrgIds": [
              "JER.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
