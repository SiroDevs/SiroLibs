                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "emi ma si vini jo ku, ma ri ori ku, emi ma sa zabibuni amvua ku, emi ma ovu afa nde be ku; te o’du eminia dria emi ma adri hema ma alia, ’dini emi ma ovu ani eli kakau angu emini ovuzu alenia ani’boruri ma alia beni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.8"
              },
              "items": [
                {
                  "text": "O’be 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.20"
              },
              "items": [
                {
                  "text": "Kol 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama eri o’duko Yonadabu Rekabu mvi ama atini, e’yo dria erini azile ama tiari ma alia ra, ama ma mvu patiefi su ku o’du amanisi dria, ama’i, oku amani pie, agupianzi amani pie, ezoanzi amani pie; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ama ma si vini jo amani ovuzuri ku. Amvu zabibuni amani vini yo, amvu azini yo, ori yo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ama ovu hema ma alia ra, te ama eri ’bo, ama ’ye e’yo dria ekile Yonadabu ama atini azile ama tiarile ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.1"
              },
              "items": [
                {
                  "text": "2 Opi 24:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri eca ndra ’dini Nebuka­dreza opi Babuloniarini eturia efiria angu ’diria, ama ’yo ra, Ama emu, ama tu Yerusalemua amani asikari ongulumuru ’ba Kalideyani ’diyi pi rule asikari ongulumuru ’ba Suriaa ’diyini berisi. Ama ovu di Yerusa­lemua ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi e’yo Yehovani nga eca Yeremia vu kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.33"
              },
              "items": [
                {
                  "text": "Yer 32:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruni Mungu Israe­liniri ’yo ’dini: Mi mu, mi ’yo ’ba Yudaa ’diyi pi ma tia ’ba ovupi Yerusalemua ’diyi be, Emi ngani imbata a’i, e’yo mani erizu ku ya? Yehova ’yo ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.15"
              },
              "items": [
                {
                  "text": "2 Sur 36:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.13"
              },
              "items": [
                {
                  "text": "Yer 7:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo Yonadabu Rekabu mvini azile anzi ini tia, kini yi ma mvu patiefi su kuri, yi ’ye ra; ecazu kpere andru yi mvuni ku, yini azita yi ma atini erile rarisi. Te ma’i, ma ’yo e’yo emi tia ra, mani engaria o’biti drio drio e’yo ’yoria, te emi erini e’yo mani ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
