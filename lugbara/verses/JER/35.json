        },
        {
          "text": "E’yo ecapi Yeremia vu engapi Yehova vu o’du Yehoyakimu Yosia mvi opi Yudaarinisiri eri ’dini, kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
