                "loc": "ACT.26.20"
              },
              "items": [
                {
                  "text": "’Yeta 26:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma pe ati’ba mani nabiru ’diyi ma ti dria emi vu ’bo, mani engaria o’biti drio drio yi ti peria, kini, Emi emvi curu’do, emi dria alu alu geri emini onziri kuzu, emi ede ’yeta emini, emi bi Mungu andini ma vuti azi ngazu yi dri ku, te emi nga di ovu ani angu mani fele emi dri emi a’bipi beri ma alia ra. Te emi coni emi bile ma vu ku, emi erini e’yo mani ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku Yonadabu Rekabu mvi ma anzipi eri azita yi ma atini azile yi tiari ra, te suru ’dori erini e’yo mani ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        },
