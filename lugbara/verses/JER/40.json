        },
        {
          "text": "’Dini Yeremia nga di mu ani Gedalia Ahikamu mvi vu Mizipaa, nga ovu eri be ’ba ecepi angu nde ma alia ’diyi ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.6",
            "verseOrgIds": [
              "JER.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 40:7"
          },
          "items": [
