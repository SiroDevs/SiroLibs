              "items": [
                {
                  "text": "Imv 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dinile indi ’ba Yahudini ovupi Moabua ’diyi pi, ’ba ovupi Amoni anziyi ma eselia ’diyi pie, ’ba Edo­mua ’diyi pie, ’ba ovupi angu dria ma eselia ’diyi pie, ka eri kini opi Babuloniari ku ’ba Yudaa azini ’diyi jolokoru ’bo, azini kini eri ’ba Geda­lia Ahikamu Safani mvi ma mvini yi ma drilia ’bo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "etu nderisi ’ba Yahudini dria nga enga pari dria ’bani yi odrozu ’diarisi, yi nga emu angu Yudaaria Mizipaa Gedalia vu, yi oku patiefi su, patiefi kapi elisi ’diyi be tre. E’yo Isimaelini otule Gedalia ma ruaari ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini vini Yohanani Karea mvi pi, ’ba asikari ovupi asea ’diyi ma dri cepi ’diyi be dria, yi nga eca Gedalia vu Mizipaa, ",
          "type": "text",
          "attrs": {
