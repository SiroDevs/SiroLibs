              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda pi aku erini amboru ’diyi be dria nga adri alenia tualu, ’ba amvu ’api ’diyi pi ’ba acipi kabilo yini ocezu ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.24",
            "verseOrgIds": [
              "JER.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku ma fe ’ba andepiri ma ale tra ra, ma fe nyaka ’ba dria ovupi candisi ’diyi dri ’bo",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.25",
            "verseOrgIds": [
              "JER.31.25"
            ]
          }
        }
