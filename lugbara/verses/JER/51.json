              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ’yo ’dini: Emi ndre, ma nga oli ’ba dri japiri eji Babuloni pi ma ruaa, ’ba ovupi Lebi-kamaia ’diyi",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.1",
            "verseOrgIds": [
              "JER.51.1"
            ]
          }
        }
      ]
    },
    {
