                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri’i, ati’ba erini pie, ’ba ovupi angu ndea ’diyi pie, yi erini e’yo Yehovani ’yole nabi Yeremia ma tisiri ku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
