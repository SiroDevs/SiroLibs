                }
              ]
            }
          ]
        },
        {
          "text": "Opi Zedekia nga Yehukali Selemia mvi pi ma ti pe Zefania Maaseya ’ba edeta edepiri ma mvi be nabi Yeremia vu, kini, Mi zi Yehova Mungu amaniri ama dri fo! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu de Yeremiani adri efi azini fu ’ba ma eselia, a’disiku yi ’bani nga eri arujoa ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.7"
              },
              "items": [
                {
                  "text": "2 Opi 24:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.21"
              },
              "items": [
                {
                  "text": "Yer 34:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini isu asikari ongulumuru Farauni ’diyi efu Misi­riarisi ’bo; te ’ba Kalideyaa Yerusa­lemuni acepi ombasi ’diyi ka e’yo kuza yini eri ra, yi ku omba ’bazu Yerusalemu be ja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi e’yo Yehovani nga eca nabi Yeremia vu kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.2"
              },
              "items": [
                {
                  "text": "Yer 21:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Mik 6:20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mungu Israeliniri ’yo ’dini: Emi ma ’yo ’dini opi Yudani emi ti pepi e’yo zizu ma tiari ma tia, kini, Mi ndre, asikari ongulumuru Farauni, efupi emi aza kopi ’diyi, nga mvi Misiria yi vile angua. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.10"
              },
              "items": [
                {
                  "text": "Zab 33:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.30"
              },
              "items": [
                {
                  "text": "O’be 21:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.1+ISA.30.2+ISA.30.3+ISA.30.4+ISA.30.5+ISA.30.6+ISA.30.7"
              },
              "items": [
                {
                  "text": "Isa 30:1-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.22"
              },
              "items": [
                {
                  "text": "Yer 34:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ’ba Kalideyaa ’diyi nga emu dika omba ’bazu aku amboru ’dori be; yi nga eri bi, evezu acisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ’yo ’dini, Emi ici emi ngulupi, ’yozu kini, ’Ba Kalideyaa ’diyi nga nga ama vurisi ra-’dinini ku, a’disiku yi nga ni nga emivurisiku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.36+LEV.26.37+LEV.26.38"
              },
              "items": [
                {
                  "text": "Lev 26:36-38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.17"
              },
              "items": [
                {
                  "text": "Isa 30:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.4"
              },
              "items": [
                {
                  "text": "Yer 21:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.21.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’di­siku emi ka tro asikari ongulumuru ’ba Kalideyaa ’diyini omba ’bapi emi be ’diyi oco dria ra, ka ace yi ma eselia kiri ’ba osole ebiru ’diyi a’dule ti, yi te enga dria alu alu hema Yini ma alia, aku amboru ’dori evezu acisi ra.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
