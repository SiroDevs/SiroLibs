          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ’yo yi tia, Yehova Mungu Israelini emini ma ti pezu vunia matu ’baza emini jizu eri ma driliari ’yo ’dini kini: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
