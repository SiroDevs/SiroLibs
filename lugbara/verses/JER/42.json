          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di Yohanani Karea mvini omve i vu, ’ba asikari ma drilia ovupi eri be ’diyi pie, ’ba nde ’diyi pie dria, engazu ’ba nyirisi cazu ’ba ’wara vu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
              "JER.42.8"
            ]
          }
        },
        {
