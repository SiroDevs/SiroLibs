                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zedekia ovu eli be kali iri drini alu, erini e’dozu opi nyazurisi; nya opi eli mudri drini alu Yerusale­mua. Andri erini ma ru ndra Hamutali, Yeremia Libinaari ma zi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’ye ndra e’yo ovupi onzi Yehova ma milia, ekile dria Yehoya­kimuni ndra ’yele rarile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.12+EZK.17.13+EZK.17.14+EZK.17.15+EZK.17.16"
              },
              "items": [
                {
                  "text": "Eze 17:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku adra Yehovanisi eri nga eca ’dini Yerusalemu pia Yuda be, de nga eri ’beni yi i ma miliarisi dria ku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
