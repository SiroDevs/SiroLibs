        },
        {
          "text": "Eri nga eca ’dini eli oromi erini opi nyazurisi, mba mudriri ma mba o’du mudrisi, Nebukadreza opi Babuloniari nga emu a’di ’dizu Yerusalemu be, eri’i asikari ongulumuru erini ’diyi be dria, yi nga hema aso eri ma ageia, yi nga pari okporu ede eri ageia dria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini yi nga di aku amboru nderi ace kuru cazu eli mudri drini alu Zedekianiria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.5",
            "verseOrgIds": [
              "JER.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
