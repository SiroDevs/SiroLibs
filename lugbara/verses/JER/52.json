              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Zedekia mbu opi Babuloniari ma ruaansi amve. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
