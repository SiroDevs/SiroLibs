              "items": [
                {
                  "text": "Yer 27:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te afa i’dile pa sopi piriru: molaru ovupi Yehova vile joa ’diyi pi, afa etini ’bazu ’diyi pie, otaka molaru miriniri ovupi Yehova vile joa ’diyi pie, ’ba Kalideyaa ’diyi onyo yi nyingiriki, omvu mola dria afa ndeni, ji Babulonia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.3"
              },
              "items": [
                {
                  "text": "Efu 27:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi onze vini imvu pi, pau pie, akpaa pie, awala pie, kabile pie, afazu molaru azi ngazu dria ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambo asikari opi ma agei tepi ’diyi ma driliari onze okelea pi, ajikoa pie, awala pie, imvu pie, tala pie, kabile pie, otekua pie-ovupi meleru ’diyi yi ji meleru, ovupi dahaburu ’diyi yi ii dahaburu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mola ovupi afa iri i’dile pa sopi piriru ’diyi pi ma ruaari, miri alu nderi pie, ti molaru mudri drini iri etinia ’diyi pie, Sulemanini edele jo Yehovani dri ’diyi--econi nziza mola nderini o’bizaru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
