              "items": [
                {
                  "text": "2 Opi 24:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.20"
              },
              "items": [
                {
                  "text": "2 Sur 36:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Nebukadrezani o’dule jile ati’baru ’diyi yi ’di: eli azirisi, ’ba Yahudini alifu na drini kali iri drini na; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.9"
              },
              "items": [
                {
                  "text": "Yer 39:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te eli Nebukadrezani mudri drini arorisi eri o’du ’ba turu aro drini kali na drini iri, ji ati’baru Yerusalemuasi; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "eli Nebukadrezani kali iri drini narisi, Nebuzara­dani ambo asikari opi agei tepi ’diyi ma driliari o’du ’ba Yahudini turu aziri kali su drini towi, ji yi ati’baru; ’ba dria ma kalafe ovu di alifu su drini turu azia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
