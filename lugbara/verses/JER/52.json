              "items": [
                {
                  "text": "Yer 21:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambo asikari ma agei tepi ’diyi ma driliari nga Seraya kuhani amboruri pi bi Zefania kuhani iriri pie, ’ba na jotile agei tepi ’diyi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "te aku eseliasi eri bi ambo ’ba ombaru ’diyi ma driliari piyi, ’ba opi ma mileti ndrepi, yini isule aku ma alia ’diyi ma azi aziri ’diyi pie; ambo asikari ongulumuru driliari ma waraga sipi ’ba angu ndea ’diyi okupiri pie; azini ’ba angu e’ipi ma azi kali azia yini isule aku amboru ma alia ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Nebuzara­dani ambo asikari opi ma agei tepi ’diyi ma driliari nga yi obi ji opi Babuloniari vu Ribilaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.33"
              },
              "items": [
                {
                  "text": "Lev 26:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Babuloniari co yi ra, ofu yi Ribilaa angu Hamatiaria. ’Dini yi ji Yudani ati’baru angu eriniasi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        },
        {
