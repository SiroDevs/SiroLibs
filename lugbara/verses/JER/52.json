            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.40.13+GEN.40.14+GEN.40.15+GEN.40.16+GEN.40.17+GEN.40.18+GEN.40.19+GEN.40.20"
              },
              "items": [
                {
                  "text": "E’do 40:13-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga cea ’dini Yehoyakini opi Yudaarini ovuzu ati’baru eli kali na drini azirisi, mba mudri drini iriri ma o’du kali iri drini towisi, Evili-merodaki opi Babuloniari, eli erini oko opi nyazurisi, nga Yehoya­kini opi Yudaari ma dri enga uru, nga eri ofu arujoarisi ra ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga e’yo ’yo eri ma tia yikisi, nga eri ma oguna opiniri ’ba uru opi ovupi eri be Babulonia ’diyi ma oguna ma drilia, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.9.13"
              },
              "items": [
                {
                  "text": "2 Sam 9:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri oja bongo erini aru­joniri ra. Eri nga nyaka nya eri ma drilia o’du erini ovuzu idrirurisi dria; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "te nyaka awaza erini ma e’yo ovu ’dini, Opi Babuloniari awa nyaka eriniri ’dani, fe nyaka esele eriniri eri dri angu owu vusi, o’du erini ovuzu idrirurisi dria, cazu erini drazuria.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
