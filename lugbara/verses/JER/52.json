              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.20"
              },
              "items": [
                {
                  "text": "1 Opi 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.3.16"
              },
              "items": [
                {
                  "text": "2 Sur 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kalatinia dria pati efi pomegranati ovu kali oromi drini azia; te pomegranati ovupi emba onyiafaruri ma dria ’diyima kalafe driari ovuturualu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        },
