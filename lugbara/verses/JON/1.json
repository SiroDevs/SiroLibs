            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "De Yehova ede e’bi amboru ku ngonde Yonani kizu ’bo; Yona nga ovu di e’bi nde ma alia o’du pale na etu zu, ini rra.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
