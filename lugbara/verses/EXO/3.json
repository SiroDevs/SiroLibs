              "items": [
                {
                  "text": "Azi 33:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova ka ndre eri oja i kalaa nezu, Mungu omve eri o’dukosi engazu pati nderi alia kini, Musa, Musa! Eri kini, Ma ’do’i. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.4",
