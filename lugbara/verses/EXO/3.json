                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika Yehovani efu eri ma milia aci dipi pati ali ma ruaari ma alia. Te Musa ndre ra, te mi ne, aci di pati nde ma ruaa, te veni eri aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
