                  "text": "Zab 111:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa ngaa ’yo ra, Ma nga ma oja eceta amboru ’diri vu, e’yo pati alini vezu kuri nezu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.3",
            "verseOrgIds": [
