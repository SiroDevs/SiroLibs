              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.1"
              },
              "items": [
                {
                  "text": "10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Farau ngani e’yo mini eri ku; ma nga dri mani ’ba angu Misirini dria, ma nga ’ba ongulumu mani suru Israeliniriru ’diyi ofu angu Misirini aliasi e’yo liza, amboru ’diyisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.4",
            "verseOrgIds": [
              "EXO.7.4"
            ]
          }
        },
        {
