                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga asi Farauni ’ba mbaza­ru, ma nga fe eceta mani ezu kakau tali osutaru mani ’diyi be angu Misirinia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.3",
            "verseOrgIds": [
              "EXO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
