                  "text": "O’be 29:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Farau oja i fi i vile joa,la ’bani asi e’yo ’di dria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
