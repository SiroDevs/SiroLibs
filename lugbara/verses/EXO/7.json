        },
        {
          "text": "’Di ma vutia Farau nga ’ba onduaru ’diyi omve ’ba ojeru, ’diyi be; ’ba nde, ’ba ojouru Misiria ’diyi nga ’ye ’dini indi ondua yini olenirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.11",
            "verseOrgIds": [
              "EXO.7.11"
            ]
          }
        },
