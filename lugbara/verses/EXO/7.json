          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba Misiria ’diyi dria ga ’bile yi ara amboru nde ria yi mvuza ndazu, yini ecole yi yi ara ndeni mvule kurisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
