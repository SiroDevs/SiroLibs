        },
        {
          "text": "Te Yehova ’yo Musa tia, Mi ne, ma ’ba mi,Mungule Farau dri; te Aroni mi adrini nga ovu nabi mini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi nga e’yo dria mani azile mi tiari ’yo; azini Aroni mi adrini nga ’yo Farau tia eri ma ku anzi Israelini ma fu angu eriniasi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
