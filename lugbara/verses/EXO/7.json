        },
        {
          "text": "Ma ka dri mani eju angu Misirini dria, anzi Israelini ofuzu ’ba Misirini ma eseliasi ra, yi nga ni ma ovu Yehova’i. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa pi Aroni be yi ’ye ’dini; ekile Yeho­vani azile yi tiarile, yi ’ye ’dini ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
            "verseOrgIds": [
              "EXO.7.6"
            ]
          }
