          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ’diyi dria alu alu nga kali yini o’be va, kali nde nga yi oja uriru indio Te kali Aroniniri nga kali yini oki dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
              "EXO.7.12"
            ]
          }
        },
