              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ewu yini yi ecandizu aga rarisi yi ezu tre aga ra, yi ere yi aga ra indio Te asi yini oti oti anzi Israelini ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.12",
            "verseOrgIds": [
