            "number": "2",
            "style": "v",
            "sid": "EXO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rubeni, Simeoni pie, Levi pie, Yuda pie, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.2",
            "verseOrgIds": [
              "EXO.1.2"
            ]
          }
        },
        {
