              "items": [
                {
                  "text": "Azi 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi dria efupi Yakobo ma ruaa ’diyi ovu kali aziri; te Yusufu eca ndra angu Misirini ma alia oko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.5",
            "verseOrgIds": [
              "EXO.1.5"
            ]
          }
        },
