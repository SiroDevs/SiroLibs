                "loc": "1CO.10.9"
              },
              "items": [
                {
                  "text": "1 Kor 10:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ’ba nde ’ba omba Musa be kini, Mi fe ama dri yi mvuza. Te Musa ’yo yi be, Emi omba ’ba ma be a’di e’yosi ya? Emi Yehovani o’bi a’di e’yosi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.2"
              },
              "items": [
                {
                  "text": "Efu 16:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ongulu­muru ovu yi avijosi ’dale, yi ono Musa dria kini, Mi ofu ama angu Misiriniasi, ama ofuzu yi avijosi anzi amani be, azini anyapa amani be a’die’yosiya? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.3",
            "verseOrgIds": [
              "EXO.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
