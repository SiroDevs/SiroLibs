                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.8"
              },
              "items": [
                {
                  "text": "Kal 20:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova ’yo Musa tia, Mi aga ’ba nde ’diyi ma drilia, mi ’du ’ba ’wara Israelini mi be tualu; mi ’du kali mini mi dria, mini ndra yi mirini cozuri, mi mu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.41"
              },
              "items": [
                {
                  "text": "Zab 105:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.114.8"
              },
              "items": [
                {
                  "text": "114:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.4"
              },
              "items": [
                {
                  "text": "1 Kor 10:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ne, ma nga pa so mi drilia ’dale oni dria Horebua; mi nga oni nderi co, te yini nga efu ani, ’dini ’ba nde ’diyi nga mvu ani beni. Te Musa ’ye ’ba ’wara Israelini ma milia ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
          },
          "items": [
            {
              "text": "7",
