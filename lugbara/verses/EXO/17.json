        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.95.8"
              },
              "items": [
                {
                  "text": "Zab 95:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
