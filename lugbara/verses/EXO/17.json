              "items": [
                {
                  "text": "Ebra 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri omve angu nderi ma ru Masa2 azini Meriba3, a’disiku anzi Israelini yini agata galerisi, yini Yehovani o’bilerisi kini, Yehovani ama eselia ci, kani yo ya?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        }
