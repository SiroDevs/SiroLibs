        },
        {
          "text": "’Di ma vutia ’ba Amalekini emu omba ’bazu Israeli be Refidimua. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
