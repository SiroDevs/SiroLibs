              },
              "items": [
                {
                  "text": "10:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa owu Yehova vu kini, Ma nga ’ye sini ’ba nde ’diyi ma e’yosi ya? Ace were yi ’ye ma o’be onisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
