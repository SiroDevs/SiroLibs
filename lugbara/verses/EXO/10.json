              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Musa ’yo ra, Mi ma fe ama dri anyapa edeta edezu azini vezu Mungu dri ’diyi, ’dini ama ma ede edeta Yehova Mungu amani dri beni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
