                }
              ]
            }
          ]
        },
        {
          "text": "Te Farau omve Musani kini, Emi mu azi nga Yehova emini dri; te anyapa nyiri ti emini be dria ma ovu ’doa; anzi emini yi nga mu emi beni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
