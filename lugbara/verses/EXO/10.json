          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.25"
              },
              "items": [
                {
                  "text": "Yoe 2:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te yi nga nyaku ma mile a’bu teke teke, ’ba ngani eco nyaku ma dri nezu ani ku; te yi nga afa jolokoru odrapi anga ku sini kule ’diyi mbe, yi nga pati dria ovupi emi vile angua ’diyi mbe ra, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.5",
            "verseOrgIds": [
              "EXO.10.5"
            ]
          }
        },
        {
