              "items": [
                {
                  "text": "O’be 30:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.3"
              },
              "items": [
                {
                  "text": "Eceza 9:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ka ga i geriko feko yi dri si, mi ne, dru ma i nga ombi eji angu mini eselia kpere kalatia, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.4",
            "verseOrgIds": [
              "EXO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
