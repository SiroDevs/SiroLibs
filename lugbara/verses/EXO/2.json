                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te agupi alu suruti Leviniri eri je zamva Levinirini okuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 2:2"
          },
          "items": [
            {
              "text": "2",
