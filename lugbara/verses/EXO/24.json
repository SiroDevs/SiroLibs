        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Musa eca e’yo dria Yehovani ’yoleri ecezu ’ba ongulumuru dri, e’yo liza be dria; ’ba ongulumuru omvi e’yo o’duko alusi kini, Ama nga e’yo dria Yehovani ’yole ’bori ’ye ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.3",
            "verseOrgIds": [
              "EXO.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 24:4"
          },
          "items": [
