                  "text": "Kal 11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo Musa tia, Mi’i, mi etu uru Yehova vu, Aroni pie, Nadabu pie, Abihu pie, ’ba ’wara Israelini kali aziri ’diyi be, emi so pa ma inzizu re. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.1",
            "verseOrgIds": [
              "EXO.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te kiri Musa a’dule ma emu Yehova vu ogogoni; te yi ma emu ogogo ku, azini ’ba ongulumuru ma etu eri be ku indi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        }
      ]
    },
