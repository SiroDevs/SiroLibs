              "items": [
                {
                  "text": "Kal 3:46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma onze akanya ganari mva tipi okori kabilomvasi; mi ka eri onze ku mi nyo ombeleni ra. Azini anzi mini ma eselia mi ma onze anzi osipi oko ’diyi dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
