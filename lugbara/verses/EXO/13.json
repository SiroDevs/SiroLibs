        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini eri nga ovu ’dinile, mi mamba azi ’diri ma ta mba ’dori vusi, Yehova ka nga mi ofi angu ’ba Kananini pini, Hitini pie, Amorani pie, Hivini pie, Yebusini pieri ma alia ra, angu nde erini oyo sole a’bi mini tia fezu mi dri, angu gapi tre lesu pisi anyu beria. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.5",
            "verseOrgIds": [
              "EXO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 13:6"
