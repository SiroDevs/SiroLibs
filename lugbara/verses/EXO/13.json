              "items": [
                {
                  "text": "Azi 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi fu andru ’dorisi mba Abibu­nisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.4",
            "verseOrgIds": [
              "EXO.13.4"
            ]
          }
