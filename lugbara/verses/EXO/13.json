        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.1"
              },
              "items": [
                {
                  "text": "Zab 44:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du nderisi mi ma olu mva mini ma tia kini, E’yo ’diri ’dini a’disiku e’yo Yehovani ’yele ma vu mani efuria Misiriasirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.8",
            "verseOrgIds": [
              "EXO.13.8"
            ]
          }
        },
