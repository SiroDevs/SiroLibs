                  "text": "Azi 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ovu ecetaru mi dri agelia, azini afa a’diza mi andretiariru; Yehovani ama ofule Misiria dri okpo inisirisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
