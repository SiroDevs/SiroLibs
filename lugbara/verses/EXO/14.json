              "attrs": {
                "loc": "PSA.71.11"
              },
              "items": [
                {
                  "text": "71:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Farauni nga ’yo anzi Israelini ma ’eyosi, Angu ekila yi ci; angu rokoru ase yi ci. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.3",
            "verseOrgIds": [
              "EXO.14.3"
            ]
          }
        },
        {
