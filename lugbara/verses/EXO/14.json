          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.13+JAS.1.14+JAS.1.15+JAS.1.16+JAS.1.17"
              },
              "items": [
                {
                  "text": "Yak 1:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.16"
              },
              "items": [
                {
                  "text": "Efu 9:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.17+ROM.9.18+ROM.9.19+ROM.9.20+ROM.9.21+ROM.9.22+ROM.9.23"
              },
              "items": [
                {
                  "text": "Rum 9:17-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma nga Farau ma asi ’ba mbazaru, eri nga yi vuti dro, te ma nga mani inzita isu Farau vu ani, ’ba erini ongulumuru ’diyi vu dria indi; ’ba Misiria ’diyi nga ni ma Yehova’i. Te yi ’ye ’dini.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.4",
            "verseOrgIds": [
              "EXO.14.4"
            ]
          }
        }
      ]
    },
    {
