              "items": [
                {
                  "text": "13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.3"
              },
              "items": [
                {
                  "text": "Kal 33:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova ’ba Farau opi Misiriari ma asi mbazaru, eri bi anzi Israelini ma vuti, anzi Israelini yini fule Misiriasi arumadrisirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.8",
            "verseOrgIds": [
              "EXO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.9"
              },
              "items": [
                {
                  "text": "Efu 15:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.6"
              },
              "items": [
                {
                  "text": "Yos 24:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Misirini ’diyi dro yi ma vuti, akanya dria pie, gari ombani Farau vile dria ’diyi pie, ’ba nzupi akanya dria ’diyi pie, ’ba ongulumuru ’diyi be, yi isu ’ba Israelini yi aso hema yini ’bo, yi tia Pihahiroti ma kalaa, Baali-zefoni ma drilia.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.9",
            "verseOrgIds": [
              "EXO.14.9"
            ]
          }
        }
