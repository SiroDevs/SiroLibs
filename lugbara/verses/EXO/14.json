                "loc": "PSA.107.6"
              },
              "items": [
                {
                  "text": "107:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Farau ka eca ogogo, anzi Israelini enga yi mile uru, te mi ne, ’ba Misirini ’diyi ad yi ma vutia; yi ovu di urisi tu ani. Anzi Israelini nga di owu okposi Yehova vu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.10",
            "verseOrgIds": [
              "EXO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.7"
              },
              "items": [
                {
                  "text": "Zab 106:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini yi ’yo Musa tia kini, Mi eji ama odrazu roko dria, ’bile ’ba sazu ’diyini ovule Misiri ma alia yorisi ya? Mi ’ye ama ’dini a’di e’yosi ama ofuzu angu Misiriniarisi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.11",
            "verseOrgIds": [
              "EXO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.9"
              },
              "items": [
                {
                  "text": "Efu 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ’yoni ndra e’yo ’diri mi be Misiria ’da ku ya, ’yozu, Mi ku ama, ama ma nga azi ’ba Misirini dri ani? A’disiku azi ngazu ’ba Misiria ’diyi driri eri onyiru aga amani odrazu roko driari ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.12",
            "verseOrgIds": [
              "EXO.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
