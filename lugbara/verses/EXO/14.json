              },
              "items": [
                {
                  "text": "31:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehovani nga a’di’di emi drini,emi nga ovuciri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.14",
            "verseOrgIds": [
              "EXO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yehova ’yo Musa tia, Mi owu ma vua’die’yosi ya? Mi ’yo anzi Israelini tia yi ma mu drile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.19"
              },
              "items": [
                {
                  "text": "Efu 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi su kali mini uru, mi eju mi dri miri dria, mi co eseleni; anzi Israelini nga mu miri ma eselesi nyaku angaza ma driasi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.16",
            "verseOrgIds": [
              "EXO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
