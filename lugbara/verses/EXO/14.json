              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.10+ISA.41.11+ISA.41.12+ISA.41.13+ISA.41.14"
              },
              "items": [
                {
                  "text": "Isa 41:10-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Musa ’yo ’ba: ongulumuru tia, Emi ru ku, emi so pa ci, emi ne pata Yehovani erini e’dio ngale ’yele emi dri andruri; a’disiku ’ba Misirini emini ne andru ’diyi, emi ngani asi yi ne dika ewule ewule ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.13",
            "verseOrgIds": [
              "EXO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 14:14"
          },
          "items": [
