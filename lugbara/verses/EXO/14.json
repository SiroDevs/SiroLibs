              "items": [
                {
                  "text": "Yer 44:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ’yo anzi Israelini tia yi ma oja yi vile hema asozu Pihahiroti ovupi Migedoli pi ma eselia miri beri ma drilia, Baali-zefoni ma drilia; emi nga hema aso eri drilia miri kalaa ’aa­’dosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.2",
            "verseOrgIds": [
              "EXO.14.2"
            ]
          }
        },
        {
