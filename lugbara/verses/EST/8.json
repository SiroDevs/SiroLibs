              },
              "items": [
                {
                  "text": "1 Opi 21:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri si waraga opi Ahasueru ma rusi, eri bi tini oderisi anziriku opi ma driamvaarisi, eri pe waraga ’diri ti ojio tupi akanya dria ’diyi ma dria, akanya yini tuzu drinia ’diyi ovu akanya ongu be ’bani ani opi ma azi ngazu, akanya opini opele i dri anzi tizu ’diyini tile ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.10",
            "verseOrgIds": [
              "EST.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 8:11"
          },
          "items": [
