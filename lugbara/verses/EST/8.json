                "loc": "EST.1.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba omve ani ’ba waraga sipi opi vile ’diyi mba na omvele Sivaniri ma o’du kali iri drini narisi; yi si dria ekile Moridekaini azile ’ba Yahu­dini ma e’yosirile, ’ba opiru angu nyapi ’diyi pi dri, ’ba ambo ’diyi pie, ’ba ambo angu awaza dria ’diyi ma drilia ’diyi pie, engazu Indiaa cazu kpere Etiopiaa, angu turu alu drini kali iri drini aziri, ’ba si angu alu alu vu ekile yini ti yini silerile, azini suru alu alu vu yini ti yini ’yolerile, si vini indi ’ba Yahudini dri ekile yini ti yini silerile, yini ti yini ’yolerile indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.9",
            "verseOrgIds": [
              "EST.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
