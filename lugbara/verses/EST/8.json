                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.29"
              },
              "items": [
                {
                  "text": "Dan 5:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.22"
              },
              "items": [
                {
                  "text": "Luk 15:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te opi tru anziriku eri ma driamvaa erini trole Hamani ma driari, fe Moridekai dri. Te Esiteri ’ba Moridekaini Hamani vile jo ma drilia.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.2",
            "verseOrgIds": [
              "EST.8.2"
            ]
          }
        }
      ]
