                  "text": "Dan 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ati’ba opini ’diyi dria, ’ba azini angu awaza opini ma alia ’diyi dria yi ni e’yo ’diri ra, kini, ’ba alu, ka ovu agupini kani okuni ti, fipi opi vu jo opini alialeruria ka eri omve ku, azita ovu alu a’dule ’ba nde dri, kini ma fu eri ra, pe lu ’ba opini kali meleruri ejule vunia eri ma ovu idriru aniri’i a’dule. Te ma’i, yi omveni ma fizu opi vu o’du kali na ’dipi ’diyi ma alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.11",
            "verseOrgIds": [
              "EST.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi e’yo Esiterini ’yole ’diyi olu Moridekai ma tia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
