              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezoanzi Esiterini azini ati’ba eri ma joa ’diyi yini emuria e’yo ’diri oluria eri tia, oku opini ovu candisi asi otiza be tu; eri pe bongo suza ma ti Moridekai dri, ’dini eri ma tru koliba eri ruaari, te eri ga bongo si. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.4",
            "verseOrgIds": [
              "EST.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esiteri nga di Hatakini omve, eri ati’bo alu opini, opini pele oku dri eri aza kozuri’i, pe tini muzu e’yo ’diri ma efi ngoni yari zizu Moridekai ma tia, kani enga geri ngosi ya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.5",
            "verseOrgIds": [
              "EST.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Hataki fu amve, isu Moridekaini iriia aku ambori ma alia, opi ma kalitile ma drilia, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.6",
            "verseOrgIds": [
              "EST.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.9"
              },
              "items": [
                {
                  "text": "Esi 3:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te Moridekai nga di e’yo dria yi ’yepi eri vu ’diyi olu eri tia, azini nga ece kalafe dahabuni Hamanini azile fezaru ’bazu pari opini lonyi ta mbazuria, yini ’ba Yahudini ma dri jalerisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
          },
          "items": [
