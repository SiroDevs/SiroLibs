              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esiteri nga di azi e’yo omvizu Moridekai tia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
