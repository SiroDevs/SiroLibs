              ]
            }
          ]
        },
        {
          "text": "Opi Ahasueru li musoro angu nde ma dria kpere angu miri tia ’diyia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
