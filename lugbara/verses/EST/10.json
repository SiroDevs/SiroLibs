            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Yeta erini ’yele okpo inisi azini ambo inisi, azini inzita ambo tu Moridekaini isule opini eri ’bale ururisi ’diyi, yi sini yi buku opi Mediaa ’diyi pi ma e’yo sizu opi Perisiaa ’diyi beri ma alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
