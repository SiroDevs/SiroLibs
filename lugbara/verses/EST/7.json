                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini yi ’i di Hamanini pati erini edele Moridekaini tizuri ma sia. Adra opini nga di i de ani ndo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.10",
            "verseOrgIds": [
