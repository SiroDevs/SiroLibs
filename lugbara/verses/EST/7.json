                  "text": "Esi 2:21-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Yob 2:20-23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haribona ati’bo alu ati’ba opini ’diyi ma eseliari ’yo ra kini, Mi ne, pati Hama­nini edele Moridekai e’yo onyiru ’yopi opini pazuri ’izuri, pati nde so pa Hamani vile joa ’da, oconiri wuale o’buko’bu kali towi. Opi nga di ’yo ra, Mi ’i eri sinia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        },
        {
          "name": "verse",
