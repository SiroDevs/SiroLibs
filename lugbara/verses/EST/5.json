              "items": [
                {
                  "text": "6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini o’du nasi Esiteri su afa suza erini opiniri eri mu pa sozu irii ovupi opi ma jo alialeruri ma tilia. De isu opi ri oguna opini jo alia otizaru jotile beri ma dria; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.1",
            "verseOrgIds": [
              "EST.5.1"
            ]
          }
        },
        {
