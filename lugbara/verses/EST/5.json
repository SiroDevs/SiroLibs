        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.30"
              },
              "items": [
                {
                  "text": "E’do 43:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te di Hamani oga i ceni, mvi i vile akua; eri pe ’ba ti ’ba eri ma agyiru ’diyi omvezu oku erini Zeresi be. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        },
