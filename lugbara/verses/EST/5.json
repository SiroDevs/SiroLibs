                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.8.4"
              },
              "items": [
                {
                  "text": "Esi 8:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ovu ’dini, opi ka Esiteri oku opiruri mire erini pa soria iriia amve, eri isu asi ndriza eri ma milia, azini opi nga di kali meleru nderi eju Esiteri vu. ’Dini Esiteri esi ogogo kali ’diri ma drile elozu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.2",
            "verseOrgIds": [
              "EST.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.23"
              },
              "items": [
                {
                  "text": "Mar 6:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi zi eri tia kini, Mi le a’dini ya, Esiteri oku opiniri E’yo mini lele a’ileri ngoni ya? Ka tro ovu angu opini nyaleri ma ali ti, mi nga eri isu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.3",
            "verseOrgIds": [
              "EST.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esiteri nga e’yo omvi eri tia kini, Ka ovu onyiru opi ma milia, opi ma emu andre tualu Hamani be, omu mani edele opi driri nyazu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.4",
            "verseOrgIds": [
              "EST.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi nga di azi kini, Emi ma omve Hamanini, ma emu mbele, ama ma ’ye ekile Esiterini ’yolerile. ’Dini opi pi Hamani be yi emu omu Esiterini edeleria. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.5",
            "verseOrgIds": [
              "EST.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.7.2"
              },
              "items": [
                {
                  "text": "Esi 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.9.12"
              },
              "items": [
                {
                  "text": "9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yini patiefi ma su mvuria, opi ’yo Esiteri ma tia, Mi le a’dini ya? Mi nga isu ra. E’yo mini lele a’ileri ngoni ya? Ka tro ovu angu opini nyaleri ma ali ti, yi nga fe ra. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.6",
            "verseOrgIds": [
              "EST.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esiteri omvi e’yo, ’yo kini, E’yo mani lele a’ileri eri ’di: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.7",
            "verseOrgIds": [
              "EST.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ka asi ndriza isu opi ma milia ra, ka ovu onyiru eri milia e’yo mani leleri fezu, e’yo mani a’ileri ’yezu indi, opi ma emu Hamani be, omu mani ngale edele yi driri nyazu, te ma nga ’ye drusi ekile opini ’yolerile.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.8",
            "verseOrgIds": [
              "EST.5.8"
            ]
          }
        }
      ]
