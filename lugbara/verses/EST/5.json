                  "text": "Mat 10:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etu ’dasi Hamani eri fu ogutasi, asi ayikoru be. Te Hamani ka Moridekaini ndre kalitile opiniria, azini eri soni pa ku, ruani yani eri drilia ku, adra ga Hamani ma asia tre Moridekai vu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.9",
            "verseOrgIds": [
              "EST.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
