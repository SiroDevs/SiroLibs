              "items": [
                {
                  "text": "3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hamani eri olu e’yo yi tia lonyi dizaru ini pi ma dria, anzi o’biru ini ’diyi pie, e’yo dria opini eri ’bazu drile inzitaru ani ’diyi, eri ’bazu amboru aga ’ba amboru ra azini ati’ba opini ’diyi rari pie. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.11",
            "verseOrgIds": [
              "EST.5.11"
            ]
          }
        },
        {
