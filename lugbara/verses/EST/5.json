              "items": [
                {
                  "text": "Yob 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te di, e’yo ’diyi dria koni ma aza ku, ma ka Moridekai ’ba Yahudini ndre erini riria kalitile opiniria. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
