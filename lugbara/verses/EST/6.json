          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "De yini e’yo ’di ’yoria ’dini eri be, isu ati’ba opi vile joa ’diyi eca Hamanini jizu mbele omu Esiterini edeleria.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
      ]
