          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.19"
              },
              "items": [
                {
                  "text": "Esi 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.131.1"
              },
              "items": [
                {
                  "text": "Zab 131:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.30"
              },
              "items": [
                {
                  "text": "2 Sam 15:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Moridekai nga emvi kalitile opiniria dika. Te Hamani nga nzu i vile joa candisi, a’bu i dri ci. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani nga di e’yo dria yi ’yepi i vu ’diyi olu oku ini pi ma tia agyi ini be. Agyi erini onduaru ’diyi pi nga di e’yo ’yo eri tia oku erini Zeresi be kini, Moridekai mini e’dozu e’dezu eri ma driliari ka ovu ori’ba Yahu­dini, mi ngani eri aga ku, te adaru mi nga e’de eri ma drilia ra.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        }
      ]
    },
