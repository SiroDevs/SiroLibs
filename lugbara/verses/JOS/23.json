                }
              ]
            }
          ]
        },
        {
          "text": "kiri emi ma ekpa emi Yehova Mungu eminiri be, emini ’yele kpere o’du andru ’dorisirile. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
