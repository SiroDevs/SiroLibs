          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi emi te emi agei asi driasi tu, emi ma le Yehova Mungu eminiri avasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        },
