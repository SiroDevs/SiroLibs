                }
              ]
            }
          ]
        },
        {
          "text": "Yehova nga di ani ’yo Yosua ma tia, O’du ’disi ma ogu drinza Misiri­niri emi dria ’bo. E’yo ’disi nga pari nderi omve ani, Giligali kpere curu’do.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
