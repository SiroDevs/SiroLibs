              "attrs": {
                "loc": "DEU.2.16"
              },
              "items": [
                {
                  "text": "Azi 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Diri bani e’yo Yo­suani yi ma agele olizuri’i: ’ba dria efupi ndra Misiriasi agupiru ’diyi, ’ba dria ombani ’diyi, yi odra dria geria roko dria yini efuzu Misiria ’boriari ma vutia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba dria efupi ’diyi a’i ndra agele liza ’bo, te ’ba dria yini osile roko dria yini efuzu Misiria ’boriari ma vutia ’diyi a’ini nga agele liza ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
