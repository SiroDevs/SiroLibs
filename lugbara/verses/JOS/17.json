              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.10"
              },
              "items": [
                {
                  "text": "Yos 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri eca ’dini, ’ba Israelini yini okpo isuzu ’borisi, yi nga fe ’ba Kananini azi ngazu yi dri ati’baru, te drozaruni, droni yi teke tekeku.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
