              },
              "items": [
                {
                  "text": "36:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Zelofehadi Heferi mvi, mvi Gileadini, mvi Makirini, mvi Mana­seni ovu ndra agupianzi kokoru, te ezoanzi a’dule; ezoanzi erini ’diyi ma ru ’dini: Mala pi, Noa pi, Hogila pi, Milika pi, Tiriza pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
