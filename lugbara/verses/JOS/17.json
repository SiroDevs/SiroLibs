                "loc": "JOS.14.1"
              },
              "items": [
                {
                  "text": "Yos 14:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi si inyia atalau Eleazari pi ma drilia, Yosua Nuni mvi pie, opianzi ’diyi pie, ’yozu kini, Yehova azi ndra Musa ma tia angu fezu awurusoru ama dri adripi amani ma eselia indio E’yo ’disi ekile aziza Yehovani azilerile, eri fe yi dri awuruso yi ati ma adripi ma eselia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ere esele azini mudri Manase dri, angu Gileadi pini Basani be Yoridania ’aa’dasiri ma aziru; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.29"
              },
              "items": [
                {
                  "text": "Kal 26:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.39"
              },
              "items": [
                {
                  "text": "32:39",
                  "type": "text"
                }
