              "items": [
                {
                  "text": "1 Sur 7:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te angu anzi Manaseni ma joloko driri ovu enyati yini vusi: Abiezeri anzipi piyi, Heleki anzipi pie, Asirieli anzipi pie, Sekemu anzipi pie, Heferi anzipi pie, Semida anzipi pie; ’diyi dria anzi agupiru Manase Yusufu mvini enyati yini vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
