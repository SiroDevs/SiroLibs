                "loc": "NUM.32.41"
              },
              "items": [
                {
                  "text": "41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Manase ma ezoanzini awuruso a’ile agupianzi erini ’diyi ma eselia indirisi. Te angu Gileadini ovu ani anzi Manaseni ma joloko dri esele yiniru.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        }
      ]
