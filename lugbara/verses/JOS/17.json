              "items": [
                {
                  "text": "Kal 33:52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Manase anzipi yi econi ndra angu e’ipi aku ’diyini drozaru ku; te ’ba Kananini le ndra ovu angu nde ma alia ’daa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
