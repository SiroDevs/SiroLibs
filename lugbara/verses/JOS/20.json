              "items": [
                {
                  "text": "Kal 35:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba avu ’di ma arioti ofepiri ka eri vuti dro, yi ma ofu ’ba ’ba fupi ’dari fezu eri dria ku; erini i agyini ’dile aniakosi­risi, kani erini agu nde ngule i asia drio kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
