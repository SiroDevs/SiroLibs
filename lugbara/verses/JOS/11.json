                "loc": "EXO.34.11"
              },
              "items": [
                {
                  "text": "Efu 34:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.2"
