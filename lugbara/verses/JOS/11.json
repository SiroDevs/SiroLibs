                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.7"
              },
              "items": [
                {
                  "text": "Yos 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ekile Yehovani azile Musa ati’bo erini ma tiarile, ’dinile indi Musa azi Yosua ma tia, Yosua ’ye ’dinile indi; eri kuni afa aluni Yehovani azile Musa ma tiari ’yekokoru ku.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        }
      ]
