                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.33"
              },
              "items": [
                {
                  "text": "23:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.36"
              },
              "items": [
                {
                  "text": "Yoh 3:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo ’ba ongulumuru tia ani, yini muria baputizi biria eri vu, Emi anzi uriohuluni! A’di ece emi dri apazu adra emupirisini ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.33"
              },
              "items": [
                {
                  "text": "Yoh 8:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi emi ma ’ya ani efi yi sipi asi ojaza be ’diyi, azini emi ma ’ba ’yo emi asia kini, A’bi amani eri Iburahimu’i, ’dini ku; te ma ’yo emi tia kini, Mungu eco oniefi ’diyi engazaru Iburahimu dri anziru ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.19"
              },
              "items": [
                {
                  "text": "Mat 7:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do ogara ’ba i pati oja vu i ogogo ’bo; te ’ba yi adri pati dria efi ’yapi onyiru ku ’diyi ga va, ’bezu acia,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ongulumuru zi eri tia kini, Ka’dini ama nga a’di ’ye ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri omvi e’yo yi tia, ’Ba ovupi koti iri beri ma fe aluri ’ba koti kokoruri dri; ’ba ovupi nyaka beri ma ’ye ’dinile indi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.29"
              },
              "items": [
                {
                  "text": "Luk 7:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba musoro okupi ’diyi nga di eca eri vu baputizi bizu, nga ’yo eri tia kini, ’Ba ’ba Imbapiri, ama nga a’di ’ye ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo yi tia, Emi ma oku musoro aga yini azile emi tiarile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asikari nga zi eri tia alu indi, ikini, Te ama’i, ama di nga a’di ’ye ya? Eri ’yo yi tia, Emi ma opa afa ’bani okposi ku, emi ma su asu ’ba ’ruaa inzosi ku, oya emini ma fu dri emi Ina milia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
