                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Bani e’yo teria azini ’ba driani e’yo egaria yi asia e’yo Yohananisi kini, kani eri Kristo’i ’yani, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.25"
              },
              "items": [
                {
                  "text": "’Yeta 13:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yohana nga e’yo omvi ’yo vi tia dria, Ma’iruni, ma baputizi fe emi dri yisi; te ’ba ma agapi Okposiri eri emu ’ai, mani dri fuzu enyiriko eri ma paari ma baka ayuzu kuri’i; eri nga emi dri baputizi fe i Orindi Alatararu pisi aci beni, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri kobi erini be eri dria, akuma erini ’bazu alaru, anyani okuzu ero erini alia; te eri nga anya drileko ve aci i inyupi kurisi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
