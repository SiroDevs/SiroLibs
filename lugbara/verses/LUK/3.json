              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.1+MAT.3.2+MAT.3.3+MAT.3.4+MAT.3.5+MAT.3.6+MAT.3.7+MAT.3.8+MAT.3.9+MAT.3.10+MAT.3.11+MAT.3.12"
              },
              "items": [
                {
                  "text": "Mat 3:1-12",
                  "type": "text"
