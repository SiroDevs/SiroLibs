          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli mudri drini towi Tiberio Kaisarini suru nyazurisi, de isu Pontio Pilatoni gavenaru Yudia ma drilia, de Herodeni opiru Galilia, eri ma adri Filiponi de opiru angu Ituriari pi ma drilia Trakoniti be, de Lusaniani opiru Abilenea, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.1",
            "verseOrgIds": [
              "LUK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "de Anasi pi Kaifa be yini kuhani amboru ma azi ngaria, e’yo Mu­nguni eca Yohana Zakaria mvi vu roko dria; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.2",
            "verseOrgIds": [
              "LUK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
