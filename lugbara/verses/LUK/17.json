                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ekile ovini galerile, ka ga ’bu ma kala aluria eri nga di kpere ’bu ma kala aziniria indi, Mvi ’banini nga ovu ’dinile o’du erinisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.24",
