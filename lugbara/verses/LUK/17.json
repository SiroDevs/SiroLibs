                  "text": "Luk 9:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te okorisi eri ma nya candi inzata kakausi, azini a’bianzi ewu ’dosi ’diyi ma ga eri si. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.25",
