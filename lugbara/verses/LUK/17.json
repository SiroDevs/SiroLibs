                "loc": "MRK.9.24"
              },
              "items": [
                {
                  "text": "Mar 9:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba erini opele ’diyi nga ’yo Opi ma tia, Mi fe a’ita amani ma ezu! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.5",
            "verseOrgIds": [
              "LUK.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
              },
              "items": [
                {
                  "text": "Mat 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.21"
              },
              "items": [
                {
                  "text": "21:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi ’yo ra, Emi ka ovu a’ita be ekile haradali efile, emi eco te ’yo elio ’diri ma tia, Mi nze mi ola be pi, mi mu mi sa miri ma alia; eri te nga e’yo emini inzi ra.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.6",
            "verseOrgIds": [
              "LUK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.6",
            "verseOrgIds": [
              "LUK.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba emi eselia ovupi ati’bo be nga ’yaria kani kabilo oceria ’yopi tinia, erini efiria engazu ngaarisi, Mi emu mbele mbele, mi ri nyaka nya-ri a’di’i ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.7",
            "verseOrgIds": [
              "LUK.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ngani ’yo tinia kini, Mi mu afa mani,nyaleri ede, mi anzu mi opile ayua ’yezu ma dri, kpere mani nyaria azini mvuria ’boria; vilerisi mi nga mi vileri nya azini mvu ndo--’dini ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.8",
            "verseOrgIds": [
              "LUK.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri adri awa’difo fe ati’bo ini dri erini afa te ini azile eri dri ’diyi ’yelerisi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.9",
            "verseOrgIds": [
              "LUK.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kile ’dinile emi alu indi, emi ka afa dria yini azile emi dri ’diyi ’ye de ’bo, emi ma ’yo, Ama ati’ba orodri fepi ku ’diyi, ama ’ye kiri azi fele ama ma ’yeri’i a’dule.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.10",
            "verseOrgIds": [
              "LUK.17.10"
            ]
          }
        }
      ]
    },
