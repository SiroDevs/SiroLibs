          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia, ini ’dasi agupi iri yi nga la gbolo alu ma dria; aluri nga ovu ’duzaru, te aziniri nga ace ’de. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
