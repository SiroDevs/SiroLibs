                }
              ]
            }
          ]
        },
        {
          "text": "te o’du Lotini efuzu Sodo­muarisi, aci pi ’di yi dria ozoole baruti be ’bua, ja yi dri dria ra- ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
