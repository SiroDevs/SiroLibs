                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du ’darisi ’ba ovupi jo karina dria, eri ma afani ovuzu joari, ma si va yi o’duzu ku; ’dinile indi ’ba ovupi ngaari ma da dri vile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
