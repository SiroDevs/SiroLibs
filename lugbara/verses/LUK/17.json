                  "text": "Luk 21:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga ’yo emi tia, Mi ndre, ’daa! Mi ndre, ’doa! Emi ma fu mu yi vuti bizu ku. ",
          "type": "text",
          "attrs": {
