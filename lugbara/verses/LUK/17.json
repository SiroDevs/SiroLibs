                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oku iri nga ovu anya ’iria tualu; aluri nga ovu ’duzaru, te aziniri nga ace ’de. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
