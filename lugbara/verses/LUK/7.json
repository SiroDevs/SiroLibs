                "loc": "LUK.1.15"
              },
              "items": [
                {
                  "text": "Luk 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia, ’ba dria okuni josile ’diyi ma eselia, ’ba Yohanani agapini yo; te ’ba werearu tu suru Munguniari aga eri ambosi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.28",
            "verseOrgIds": [
              "LUK.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.32"
              },
              "items": [
                {
                  "text": "Mat 21:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.7"
              },
              "items": [
                {
                  "text": "Luk 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ongulumuru dria ka eri ’bo, ’ba musoro okupi ’diyi be,yi a’i kini Mungu eri kililiru ra, yini baputizi Yohanani feleri bilerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.29",
            "verseOrgIds": [
              "LUK.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.46"
              },
              "items": [
                {
                  "text": "’Yeta 13:46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Farisaini piyi ’ba azita imbapi ’diyi be, yi ga yi ma ngulupisi e’yo amaza Munguni a’ikokoru si, yini baputizi Yohanani bile kurisi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.30",
            "verseOrgIds": [
              "LUK.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.30",
            "verseOrgIds": [
              "LUK.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga ’ba a’bianziru ’diyi o’bi eceta ngonilesi ya? Yi ovu a’di afale ya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.31",
            "verseOrgIds": [
              "LUK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ovu kile anzi ripi pari afa ozizuria yi agyi omvepi ’diyile, yi ’yo kini,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.32",
            "verseOrgIds": [
              "LUK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.35",
            "verseOrgIds": [
              "LUK.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 7:36"
          },
          "items": [
