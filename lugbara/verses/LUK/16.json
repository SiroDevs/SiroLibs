            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azita pi nabi be yi indi kpere ewu Yohanania; engazu ewu nde ’dasi yi e’yo bari suru Mungunini olu, ’ba dria kinakina yi fi alenia okposi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
