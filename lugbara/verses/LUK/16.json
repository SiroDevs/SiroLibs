            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.18"
              },
              "items": [
                {
                  "text": "Mat 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Bu pi nyaku be eco yi dezaru ewa kokoru, te e’yo alu gakandiaru azitani dule nyuri econi i dezaru ku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
