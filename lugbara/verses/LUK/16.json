            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Farisaini, ’ba silingi lepi to ’diyi, yi eri e’yo ’diyi ra, yi nga eri onzi onzi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
