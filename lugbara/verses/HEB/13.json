        {
          "text": "Emi ma ega ’ba arujoa ’diyi ma e’yo, ekile ’ba ovupi arujoa yi be tualu ’diyile emi ma ega vini ’ba ovupi inzaza ’diyi ma e’yo, ekile emi ngulupini ovule rua berile. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.3",
            "verseOrgIds": [
              "HEB.13.3"
            ]
          }
        },
