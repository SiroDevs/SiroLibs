              "items": [
                {
                  "text": "12:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ama ma fu eri vu pari hema asozuri ma tia amve, drinza nyazu eri be. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.13",
            "verseOrgIds": [
              "HEB.13.13"
            ]
          }
        },
