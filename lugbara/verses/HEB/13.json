          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi zi ’ba emi dri cepi ’diyi dria ci ci, ’ba alatararu ’diyi be dria. ’Ba engapi ’’Italiaa ’diyi zi emi ci ci. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.24",
            "verseOrgIds": [
              "HEB.13.24"
            ]
          }
        },
