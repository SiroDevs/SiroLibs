                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi Yesu indi ovu ecandizaru aku tilia amve, eri ma ’ba ani ’ba alatararu i ma ngulupi ma arisi beni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.12",
            "verseOrgIds": [
              "HEB.13.12"
            ]
