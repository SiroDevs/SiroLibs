          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ni, tru adripi amani ’Timoteoni ’bo; eri ka eca mbele, ma nga emi ndre eri be tualu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
            "verseOrgIds": [
              "HEB.13.23"
            ]
          }
