        },
        {
          "text": "Te Kristo, ewu erini ovuzu rua beria, fe ndra zita pi, matu ’baza pie, wuta okporuri pie, mindre pie, ’ba ecopi eri papi dra ma aliari vu, ovu erizaru ani erini Mungu rulerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
