                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ka e’yo ’diri de ofuzu kililiru ’bo, eri eca ovuzu ’ba pata ’dani ’daniri fepiriru ’ba dria eri eripi inzitasi ’diyi dri; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        },
        {
          "name": "verse",
