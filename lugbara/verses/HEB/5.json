              "items": [
                {
                  "text": "Efe 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’dini ’ba dria alu alu lesu ndrupiri vani nga e’yo oluza e’yo kililiruri ma driari ku, erini ovule odekuarurisi. ",
          "type": "text",
          "attrs": {
