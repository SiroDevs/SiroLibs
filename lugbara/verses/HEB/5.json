          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ’ba Mu­nguni e’dale ovuzu atalau edeta edepi agapi rariru ekile peza Melekizede­kini pezurileri’i.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
