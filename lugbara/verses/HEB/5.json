        {
          "text": "Ama ovu e’yo be kakau ’yozu eri ma dria, te yi ewaru ecezu, emini ovule ondua kokoru e’yoni fizu emi bilia mbele kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
