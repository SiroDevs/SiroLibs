              "items": [
                {
                  "text": "Fil 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ka tro ovu Mvi’i ti, eri oni ndra erita erizu e’yo eri ecandipi ’diyisi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
