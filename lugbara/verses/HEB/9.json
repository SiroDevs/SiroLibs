                }
              ]
            }
          ]
        },
        {
          "text": "Te Kristo ecea ’bo, eri atalau edeta edepi agapi ra e’yo onyiru ngapi ecapi ’diyiniri, eri fi pale alu iriti Pari Alatararuri ma alia, agazu bere ovupi amboru azini dri fupi ci agapi tu, ’bani edele drisi kuri ma aliasi (efini, ovuni bere nyaku ’doriari ku) ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
