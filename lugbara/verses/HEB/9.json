              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri fini ndri ma arisi ku, kani koanzi ma arisi ku, te i ma ngulupi ma arisi, erini onzeza ’ba otruzu kpere ’dani ’dani isuria ’boo ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
