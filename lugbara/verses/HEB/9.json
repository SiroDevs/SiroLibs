          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te aziza afa awazuri ka ovu indi, ma ni ’ba afa azipiri ma drata oko. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
