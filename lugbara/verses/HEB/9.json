              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku aziza afa awazuri ovu okpo be kiri ’ba nderini drale ’borisi, te eri ovu okpo kokoru de nga ’ba eri azipirini ovuria idriru. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
