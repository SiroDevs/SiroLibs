                  "text": "Ebra 10:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Orindi Alatara­rurini e’yo ’diri eceria ’dini, kini geri fizu pari alatararu ma aliari ovuni nga ecezaru ku, de bere okorini nga pa soria ’dani ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
