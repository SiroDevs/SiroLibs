        },
        {
          "text": "azini eri ma drilia uruleru kerubi dizani indi, endri fezu oguna yikiniri ma dria. Te afa ’diyi ma e’yo ama econi ’yozaru curu’do alu alu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        },
        {
          "name": "verse",
