                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa ’diyi ovu edezaru ’dinile ’bo, atalau edeta edepi ’diyi adri fi bere okori ma alia o’du dria, azi inzitani ’yezu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
