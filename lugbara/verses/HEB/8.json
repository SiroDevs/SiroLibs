              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.17"
              },
              "items": [
                {
                  "text": "Kol 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diyi yi eceta azini endrilendri pari ’buariniri ma azi nga; ekile Munguni Musani imbalerile, Musani ’yeria bere ederia ’dini, eri ’yo kini, Mi ndre onyiru mi ma ede afa dria ekile eceta ecele mi dri oni ma dria­rile. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
