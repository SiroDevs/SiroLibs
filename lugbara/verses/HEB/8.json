                "loc": "2CO.3.6"
              },
              "items": [
                {
                  "text": "2 Kor 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do Kristo isu azi onyiru agapi rari ’bo, erini ovule ’ba ’ba ecipi Mungu be e’yo eciza onyiru agapi ra, azile aziza agapi ra ’diyi berisirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini aziza okori ka ovu ezata kokoru, yi ngani ndra pari azini ndru aziza iriri ofizu ku",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
