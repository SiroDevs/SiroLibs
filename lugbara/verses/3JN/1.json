        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "3JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma si e’yo azini kanisa vu ’bo; te Diotrefe, lepi i ’bapi ’ba ’diyi ma driliari, a’ini ama ku. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.9",
            "verseOrgIds": [
              "3JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "3JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’dirisi, ma ka nga mu ra, ma nga azi erini ’yeleri ma e’yo ega, erini ama aji diria toko e’yo ’yoza onzikanyaru ’diyisi. Te e’yo ’diri funi dri eri dri a’dule ku, te eri ma ngulupi a’ini adripi ’diyi ku, eri vini ’ba lepi yi a’ipi ’diyi oga indi, yi odrozu kanisa ma aliasi amve.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.10",
            "verseOrgIds": [
              "3JN.1.10"
            ]
          }
        }
      ]
    },
