          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi anzuru ma ovu mi be. Mi agyi ’diyi zi mi ci ci. Mi ma zi ma agyi ’dayi ci ci rusi rusi.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.15",
            "verseOrgIds": [
              "3JN.1.15"
