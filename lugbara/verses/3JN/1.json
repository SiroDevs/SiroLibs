              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba mani leleri, mi bi e’yo ovupi onziruri ma vuti ku, te e’yo onyiruri’i. ’Ba ’yepi onyiruri eri ’ba Munguni, te ’ba ’yepi onziri ndreni nga Mungu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.11",
            "verseOrgIds": [
              "3JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "3JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.35"
              },
              "items": [
                {
                  "text": "Yoh 19:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.24"
              },
              "items": [
                {
                  "text": "21:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria nze Demeterio ma e’yo eti ’bo, e’yo adaru ma ngulupi ece vini e’yo erini; ama e’yo erini ma eti nze ama’i indi, azini mi ni ra e’yo eti nzeza amani ovu adaru.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        }
      ]
