              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ovu e’yo be kakau sizu mi vu, te ma leni yi sizu mi vu vino pisi kalamu be ku; ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.13",
            "verseOrgIds": [
              "3JN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ma le avasi mi ndrezu mbele, azini ama nga e’yo ’yo milia milia.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        }
      ]
    },
