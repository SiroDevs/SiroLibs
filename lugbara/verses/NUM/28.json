                  "text": "Eze 46:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "di edeta veza sabato vusiri’i, ovupi fezaru edeta veza i depi kuri pi be, tualu edeta erini afa mvuzasiri be. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.10",
            "verseOrgIds": [
