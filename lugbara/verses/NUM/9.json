              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga ’yo Musa tia, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
