                  "text": "Efu 12:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ani’bo ka ri emi eselia ci, ka le agaza ’ba drile­siri ma ta mba Yehova dri ra, ma ’ye ekile azita agaza ’ba drilesirinirile, ekile e’yo azile eri ma e’yosirile trotro; emi ma ovu azita be alu ani’bo pi dri kari’ba be trotro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
