        },
        {
          "text": "Musa nga ’yo yi tia, Emi ku nga, ma ma eri nga e’yo Yehovani ngale azile e’yo eminisiri raka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
