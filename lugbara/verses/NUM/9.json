                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Israelini ma mba vini omu agaza ’ba drilesirini ma ta ewuni pelerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2",
            "verseOrgIds": [
              "NUM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ’ba omu nde mba ’dori ma o’du mudri drini suri ma ondresi ewuni peleri ma alia; emi ma mba tani e’yo dria azile eri ma e’yosi ’diyini azilerile, azita erini ’diyi vusi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.3",
            "verseOrgIds": [
              "NUM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa ’yo di anzi Israelini ma ria, ma mba agaza ’ba drilesiri ma ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.4",
            "verseOrgIds": [
              "NUM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
