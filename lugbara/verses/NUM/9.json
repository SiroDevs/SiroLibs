              "items": [
                {
                  "text": "Yos 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di agaza ’ba drilesiri ma ta mba, mba okori ma o’du mudri drini suri ma ondresi roko Sinaiaria; ekile e’yo dria Yehovani azile Musa ma tiarile, anzi Israelini ’ye ’dinile trotro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
