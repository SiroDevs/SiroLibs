                  "text": "Neh 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Balaki nga ’yo Balamu ma tia, E’yo mini ’yele ma vu ’diniri a’di e’yoni ya? Ma eji mi ’dia ari’ba mani otrizu, te mi ndre, mi awu asi Indriza fe yi dri teketeke’i. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri omvi e’yo, eri ’yo ra, Ma ma ’ba ma asi e’yo Yehovani ’bale ma tiliari ’yozu’i ku ya?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
