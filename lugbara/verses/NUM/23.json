                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga e’yo olu e’yo o’bezasi kini,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
