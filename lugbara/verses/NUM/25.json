                "loc": "1CO.10.8"
              },
              "items": [
                {
                  "text": "1 Kor 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba odrapi muasi ’diyi ma kalafe ca alifu kali iri drini suo ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.9",
            "verseOrgIds": [
              "NUM.25.9"
            ]
          }
        },
        {
