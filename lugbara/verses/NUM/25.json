                  "text": "Zab 106:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Israeli nga ani yi eci Baali-peori be; adra Yehovani nga di ani Israeli ma ruaa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        },
        {
