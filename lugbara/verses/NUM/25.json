                "loc": "EXO.6.25"
              },
              "items": [
                {
                  "text": "Efu 6:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te kuhani Aroni mvi Eleazari ma mvi Finehasi ka e’yo ’diri ndre ra, eri enga ’ba ongulumuru ma eseliasi, aju ’duzu i ma dria, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.7",
            "verseOrgIds": [
              "NUM.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga agu Israelini ’dari ma vuti bi fizu kpere jo aliza ma alia, nga yi so iri tro agupi Israeliruri pi oku nderi be ajusi, gazu kpere oku ma alia lekeke. ’Dini azo muaru nga lani i de anzi Israelini ma eseliasi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.8",
            "verseOrgIds": [
              "NUM.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
