              "items": [
                {
                  "text": "1 Opi 18:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa nga ’yo ’ba e’yo lipi Israelini ’diyi ma tia, Emi alu alu ma ofu ’ba emini yi ecipi Baali-peori be ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.5",
            "verseOrgIds": [
