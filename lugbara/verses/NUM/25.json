              "items": [
                {
                  "text": "Mal 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi mi ma ’yo kini, Mi ndre, ma aziza ani asi anzuruniri fe eri dri ra; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.12",
