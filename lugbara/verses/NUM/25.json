                "loc": "DEU.13.17"
              },
              "items": [
                {
                  "text": "Azi 13:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova nga ’yo Musa ma tia, Mi o’du ’ba opiru ’ba drilia ’diyi dria, mi o’i yi uru Yehova dri etu milia, adra okporu Yehovani ma oja i ani Israeli vurisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
