          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nga ’yo Musa ma tia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.10",
            "verseOrgIds": [
              "NUM.25.10"
