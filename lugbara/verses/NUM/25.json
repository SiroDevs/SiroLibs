              "items": [
                {
                  "text": "’Yeta 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aziza nderi nga ovu eri dri ori eri ma vutia ’diyi be, aziza yini ngazu ovuzu kuhaniru ’dani ’daniri’i, erini ovule a’yaru Mungu ini ma e’yosi, erini vini anzi Israelini ma e’yo onzi edelerisi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
            ]
