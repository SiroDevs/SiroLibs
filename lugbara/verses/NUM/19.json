                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afazu dria ti be mgboru, ’bani tini opile afa ti opizurisi kuri ovu alatara kokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
