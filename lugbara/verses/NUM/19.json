          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba dria ovupi asea amve, ’ba fule seisiri ma avu elopiri, kani avu azini, kani ’ba ma falako, kani nyadri, eri nga ovu alatara kokoru o’du aziri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        },
