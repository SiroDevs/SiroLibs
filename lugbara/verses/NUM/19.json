          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba tikari ma ofuta omvupiri nga i bongo oji, nga ovu alatara kokoru kpere ondresi. E’yo ’diri nga ovu anzi Israelini piyi dri azitaru ani’bo ovupi yi ma eseliari be ’dani ’dani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
