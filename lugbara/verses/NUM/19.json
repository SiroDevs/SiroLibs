              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba eri evepiri nga i ma bongo oji yisi, nga vini i ma rua oji yisi, nga ovu alatara kokoru kpere ondresi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
