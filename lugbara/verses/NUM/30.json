                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.11"
              },
              "items": [
                {
                  "text": "1 Tim 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te agupi erini ka ga si, o’du erini e’yo nde erizurisi, ka’dini eri nga oyo ovupi eri ma driari pi ’ba toko, e’yo efupi eri ma tilia egata kokoru erini ani i orindi ombezuri be; Yehovani nga eri ma e’yo onzi ku ra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.7"
              },
              "items": [
                {
                  "text": "Lev 21:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te oyo awuzini, kani oku drole ’borini, ada e’yo dria erini ani i orindi ombezu ’diyi yi nga pa so eri ma dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ka ndra e’yo azi oyo sozasi i agupi vile akua, kani eri ka ndra i orindi ombe e’yo ombeza oyonirisi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.10",
            "verseOrgIds": [
              "NUM.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "te agupi erini ka ndra eri ra, te eri adri erini ciri, ogani ndra eri ku; ka’dini e’yo erini azile oyo sozasiri nga pa so dria ra, azini e’yo ombeza erini ani i orindi ombezuri nga pa so dria ra indi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te agupi ka e’yo nde ga si, ka ’ba toko o’du erini e’yo nde erizurisi, ka’dini e’yo efupi eri ma tilea oyo sozasi, kani e’yo ombeza erini i orindi ombezurisiri ngani pa so ku; agupi erini ’ba yi tokoru ’bo, Yehovani nga e’yo onzi erini ku ra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo dria azile oyo sozasi ’diyi pi, oyo okporu ’bani ani yi ma orindi ecandizu ’diyi be, agupi eco yi ’ba pa sozuni, agupi eco vini yi ’bazaru tokoni indio ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te agupi erini ka adri erini ciri etuzu, ka’dini eri e’yo erini azile oyo sozasi ’diyi pi fe pa sozu, e’yo ombeza ovupi eri ma dria ’diyi pie dria; eri fe yini pa sozu ra ,erini ovule erini ciri o’du erini ’yo nde erizurisirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ka e’yo nde ’diyi ga si ’bazu toko, erini e’yo nde erizu ’bori ma vutia, ka’dini eri nga oku erini ma e’yo onzi ’du i dria.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        }
      ]
    },
