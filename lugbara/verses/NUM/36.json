                "loc": "NUM.27.7"
              },
              "items": [
                {
                  "text": "Kal 27:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nga di e’yo azi anzi Israe­lini ma tia ekile e’yo Yehovani ’yolerile kini, Suru Yusufu anzipiniri ’yo ’yeke. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.5",
            "verseOrgIds": [
              "NUM.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Yehovani azile ezoanzi Zelofehadini ma e’yosiri ’di, yi eco mu agupi yini leleria; te ma mu lu agupi ori’ba suru yi ma atapini ’diyia a’dule. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.6",
            "verseOrgIds": [
              "NUM.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.3"
              },
              "items": [
                {
                  "text": "1 Opi 21:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini anzi Israelini ma awuruso aluni ngani fu suru ’diasi cazu suru ’daria ku; te anzi Israelini alu alu ma bi suru i a’bipini ma awuruso ci. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.7",
            "verseOrgIds": [
              "NUM.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.22"
              },
              "items": [
                {
                  "text": "1 Sur 23:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ezoanzi dria alu alu awuruso nyapi suru Israeli anzipini ma azi ma eselia ’diyi ma mu okuru agupi ori’ba suru yi ma atapini ma eseliari dri, ’dini anzi Israelini alu alu ma nya ani yi ma a’bipi ma awuruso ’dani beni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.8",
            "verseOrgIds": [
              "NUM.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini awuruso aluni ngani fu suru ’diasi cazu suru ’daria ku, a’disiku suru Israeli anzipini alu alu ma bi awuruso yiniri ci.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        }
      ]
    },
