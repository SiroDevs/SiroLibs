        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezoanzi Zelofehadini nga di ’ye trotro Yehovani azile Musa dririle; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.10",
            "verseOrgIds": [
              "NUM.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.1"
              },
              "items": [
                {
                  "text": "Kal 27:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te Zelofehadi ezopi Ma­la pi, Tiriza pie, Hogila pie, Milika pie, Noa pie, mu yini okuru anzi yi atapi ma adripini dri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.11",
            "verseOrgIds": [
              "NUM.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi mu okuru anzi suru Manase Yusufu mvini ma ori’baru ’diyi dri, azini awuruso yini awi ku ’dani suru yi ma atapini ma ori’ba ma eselia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        }
      ]
