        },
        {
          "text": "Yi ca e’bu Esiko­liaria, nga arakala zabibu efi kapi ngulungulu ’diyi beri ga va, ’ba iri ’i eri pati ruaa yi ma eselia ejizu; yi nga pati pomegranate ma efi eji indi, elio efi be. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.23",
            "verseOrgIds": [
              "NUM.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Da pari nde ma ru E’bu Esikoliari’i, efi kapi ngulungulu anzi Israelini gale ’dale ’diyi ma e’yosi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        }
