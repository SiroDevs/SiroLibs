        },
        {
          "text": "Yehova nga ’yo Musa tia kini, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
