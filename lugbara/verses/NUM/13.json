          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Gadini ma eselia, Geueli Maki mvi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.15",
            "verseOrgIds": [
              "NUM.13.15"
            ]
          }
