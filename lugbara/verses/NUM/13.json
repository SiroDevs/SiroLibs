              "type": "tag",
              "attrs": {
                "loc": "DEU.9.23"
              },
              "items": [
                {
                  "text": "9:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi pe ’ba ti muzu angu Kanani mani fele anzi Israelini driri ma orile gazu; suru yi ma a’bipini vusi dria emi pe ’ba ma ti alu alu, ’ba nde alu alu ma ovu ’ba opiru yi ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa pe di yi ma ti, engazu roko Paraniariasi, Yehovani e’yoni azilerile, yi dria yi ’ba anzi Israelini ma drilia ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3",
            "verseOrgIds": [
              "NUM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ma ru ’di: Suru Rubenini ma eselia, Samua Zakuri mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.4",
            "verseOrgIds": [
              "NUM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Si­meonini ma eselia, Safati Hori mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.5",
            "verseOrgIds": [
              "NUM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 13:6"
