                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "suru Yudani ma eselia, Kalebu Yefune mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.6",
            "verseOrgIds": [
              "NUM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Isakarini ma eselia, Igali Yusufu mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.7",
            "verseOrgIds": [
              "NUM.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Efiraimuni ma eselia, Hosea Nuni mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.8",
            "verseOrgIds": [
              "NUM.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Benyaminini ma ese­lia, Paliti Rafu mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.9",
            "verseOrgIds": [
              "NUM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Zebulunini ma eselia, Gadieli Sodi mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.10",
            "verseOrgIds": [
              "NUM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Yusufuni, efini suru Manaseni ma eselia, Gadi Susi mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.11",
            "verseOrgIds": [
              "NUM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Danini ma eselia, Amieli Gemali mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.12",
            "verseOrgIds": [
              "NUM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Aserini ma eselia, Seturi Mikaeli mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.13",
            "verseOrgIds": [
              "NUM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "suru Nafutalini ma ese­lia, Nabi Vofisi mvi’i; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.14",
            "verseOrgIds": [
              "NUM.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
