                  "text": "Ebra 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Serafi alu nga di esa ma vu, eri ma dria aciolu indi, erini e’dule akpasi engazu pari edeta edezuria. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri elo ma tile aciolu ndesi, nga di ’yo ma tia kini, Mi ndre, afa ’diri elo mi tile ’bo; te e’yo onzi mini ovu nzezaru ’bo, ezata mini ovu wuzaru indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
