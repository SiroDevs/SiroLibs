            "sid": "ISA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo eceza e’bu afa ndrezari­runi. A’di ’ye mi curu’do mini rule dria jo dria ururisini ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ’dasi mi lu afa ombani ovupi jo angu oceruriari vu, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.20"
              },
              "items": [
                {
                  "text": "2 Opi 20:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.4"
              },
              "items": [
                {
                  "text": "2 Sur 32:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.4.4"
              },
              "items": [
                {
                  "text": "Ong 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "emi ndre pari ’bani asule va aku Daudini ma alia ’diyi indi, kini yi ovu kakau, azini emi bi yi a’di andraleruri ma geri ci, ma oku i tualu ani, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "emi ola jo Yerusalemua ’diyi ma kalafe ra, emi anzu jo ’bani ra, muzu ani kali Yerusalemuni ’bazu okporu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.16"
              },
              "items": [
                {
                  "text": "Neh 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ede vini ’bile yi engapi pari yi a’di okuriari ma ta mbazu abi iri nde ma eselia. Te emi egani ’ba ndra afa ’diri ’yepiri ku, emi inzini ’ba ndra afa ’diri edepi ’dinile andra driori ku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
