                  "text": "Eceza 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te afa ndreza dria ovu emi dri ekile e’yo ovupi sizaru buku ’bani tini opile ciri ma aliarile, buku nde ’bani fele ’ba nipi buku lapiri driri, ’yozu kini, Mi la buku ’diri fo. Te eri ’yo ra, kini, Ma econi ku, erini ovule opizaru cirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
