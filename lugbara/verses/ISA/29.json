            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba nga di buku nde fe ’ba nipi buku lapi kuri dri, kini, Mi la buku ’diri fo. Te eri omvi e’yo kini, Ma nini buku lazu ku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
