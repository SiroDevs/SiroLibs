              },
              "items": [
                {
                  "text": "2 Tim 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Drileonzi anzi ombupi amve ’diyi dri, Yehova ’yo ra, egata ndrupi, te ma vu ku ’diyi; yi a’bu yi, afa ti a’buzurisi, te afa nde engani orindi mani vu ku, yi ma ere ezata ezata ma dria ani;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.1",
            "verseOrgIds": [
              "ISA.30.1"
            ]
