                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.27"
              },
              "items": [
                {
                  "text": "O’be 4:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mini ’yeria mi oj aria kani dri ndia, kani dri ejia, mi bileni nga o’duko eri mi vutia, ’yozu kini, Geri eri ’do’i, mi aci alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.21",
            "verseOrgIds": [
              "ISA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.31.1"
              },
              "items": [
                {
                  "text": "2 Sur 31:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.20"
              },
              "items": [
                {
                  "text": "Isa 2:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini mi di nga dahabu ’bani o’bale wura ’bani inzile inzi ’diyi ma ruaari eza, mele ’bani o’bale wura edele aya akapi aka acisi ’diyi ma driari be. Mi nga yi ’be amve afa ondirule; mi nga ’yo tinia, Mi da mi ’dale ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.22",
            "verseOrgIds": [
              "ISA.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.33"
              },
              "items": [
                {
                  "text": "Mat 6:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.8"
              },
              "items": [
                {
                  "text": "1 Tim 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga ozoo fe ori mini dri, mi nga ori ri nyakua ani, eri nga vini nyaka fe afa nyakuni ka’diyisi, eri nga ka tu anzuzaru. O’du ’dasi ti mini nga iribi nya nyamuko walaru ma alia; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.23",
            "verseOrgIds": [
              "ISA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti monioru ’diyi azini akanya kariceru e’bu sepi ’diyi be indi, nga nyaka a’i be aluzaruri nya ra, mileni ndrile peu pisi koi beri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.24",
            "verseOrgIds": [
              "ISA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te oni izuro ma dria dria, azini oni were ma dria dria, yi raza amboru nga ovu indi yi were ’diyi be, o’du ’bani ’ba ofuzu turisi, o’du jo izuro ombanirini e’dezu varisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.25",
            "verseOrgIds": [
              "ISA.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.19"
              },
              "items": [
                {
                  "text": "Isa 60:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.5"
              },
              "items": [
                {
                  "text": "Zek 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.23"
              },
              "items": [
                {
                  "text": "Eceza 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini vini, diza mbaniri nga ovu diza etu­nile, diza etuniri nga di okpo be paleko aziri, ekile diza o’du azirinile, o’du Yehovani i ma suru ma bele ombezu, azini ceta azoru yi ma ruaari atizurisi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.28",
            "verseOrgIds": [
              "ISA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi nga di ovu ongo be ekile ini ’bani omu alatararu nyazuri ma aliarile; emi nga ovu emi asia ayikosi indi, ekile o’du ’bani muzu efizu ejeleko be oni Yehovani ma alia, Kata Israeliniri vurisirile. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini Yehovani nga fe ’ba ma eri ma o’duko dizaruri, azini eri nga i ma dri erini dile vari ece ’ba dri, asi veza i ma adraniri be, aci diza aci vepi okposirini pi wuta noza amboruniri pie, oliriko pie, ozoo ’dipi si be ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.30",
            "verseOrgIds": [
              "ISA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku o’duko Yehovanisi ’ba Asuriaa ’diyi nga yi onyo nyi­ngiriki, eri ka co kalisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini cota kali dri jatani Yehovani ngale ’bale eri ma ruaari, nga ovu arimva pisi o’di be; te eri nga omba ’ba yi be omba rua yazaniri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.32",
            "verseOrgIds": [
              "ISA.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Yer 7:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’di­siku ’ba ede Tofeti drio; ede eri opi dri, ede eri aliru walaru indi, otrozaniri ovu aciru eja be tu; ava Yehovani ekile oni rapi mene­meneru acisirileri fe eri ma ko ti ani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.33",
            "verseOrgIds": [
              "ISA.30.33"
            ]
          }
        }
      ]
