            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku suruni nga adri Zioni ma alia Yerusalemua; mi ngani owu mindresi dika ku. Mini wuria o’dukosi eri nga ovu mi vu asi ndrizasi ada; eri ka wuta nde eri ra, eri nga e’yoni omvi mi tia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.19",
            "verseOrgIds": [
              "ISA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka tro Opini enya e’yo ewaruniri pi fe mi dri yi mvuza inzataniri be ti, ’ba mi imbapi ’diyi ngani ovu zizaru dika ku, te mi mileni nga ’ba mi imbapi ’diyi ndre ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.20",
            "verseOrgIds": [
              "ISA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
