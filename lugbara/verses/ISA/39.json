              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya nga di ’yo Hezekia tia, Mi eri e’yo Yehova asikari ongulumu­runi ’yole ’diyi: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
