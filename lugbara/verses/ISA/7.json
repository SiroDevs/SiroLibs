            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du ’dasi Opini nga ’ba fa idrisi, idri erini omvele oyasi angu Yi Raza tia ’aa’dasirisi-ada opi Asuriaari’i-nga ’biko driari fa ’biko paari be, eri nga vini ti’bi fa dria indi ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini o’du ’dasi, ’ba alu nga tikari ma agei te alu, azini kabilo iri be; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri nga eca dini, yini lesu fele turisi eri nga lesu kuza mbe’i; te ’ba acepi jolokoru Imanueli ma eli Munguni ama be indio angu ma eselia ’diyi nga lesu kuza mbe anyuoso be, yi dria alu alu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
            "verseOrgIds": [
              "ISA.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
