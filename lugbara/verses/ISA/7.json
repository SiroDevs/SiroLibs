            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.16"
              },
              "items": [
                {
                  "text": "1 Opi 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehovani nga o’du nga ecapi ku engazu o’du Efiraimuni efuzu Yu­daarisi ’diyi ji mi dria, suru mini ma dria, mi ati ma ori’ba ma dria indi­adani opi Asuriaari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca o’du ’dasi ’dini, Yehovani nga onyukonyu ovupi yi raza Misiria ’diyi ma kalaa vile ’dale­riari omve, anyuefi angu Asuriaari be o’duko ali cerenisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi nga emu ra, yi nga ri dria e’bu ’ba kokoru ’diyi ma alia, azini oni ma ojia, oci dria ma dria, nyamuko ma driasi dria indi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        }
      ]
    },
