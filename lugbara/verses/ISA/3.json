                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ndre, Opi, Yehova asikari ongulumuruni, Enze Yerusalemu pi ma aliasi Yuda be aza koza yini lote be, adani eri nze aza koza enyaniri pi aza koza yi mvuzaniri be dria;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
