            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ace were, emi ngani ma ndre ku; ace were dika, emi nga ma ndre ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.16",
            "verseOrgIds": [
              "JHN.16.16"
