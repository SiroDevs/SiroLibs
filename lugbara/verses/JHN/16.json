                "loc": "JHN.9.22"
              },
              "items": [
                {
                  "text": "Yoh 9:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.11"
              },
              "items": [
                {
                  "text": "Mat 5:11",
