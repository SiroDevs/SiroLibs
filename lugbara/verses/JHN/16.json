              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ndesi emi nga e’yo zi ma rusi; te ma ’yoni emi tia kini ma nga Atani zi e’yo eminisi zi zi ’dini ku; ",
          "type": "text",
          "attrs": {
