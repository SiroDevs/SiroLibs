              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.30"
              },
              "items": [
                {
                  "text": "14:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e’yo lizasi yini opi nyaku ’dirini ma e’yo lile ’borisi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        }
