                  "text": "Yoh 14:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’disiku Ata ma ngulupi le emi ra, emini ma lele ’bo, azini emini a’ile ’bo kini ma ibi enga Ata vurisi. ",
          "type": "text",
          "attrs": {
