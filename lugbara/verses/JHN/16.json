            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.1"
              },
              "items": [
                {
                  "text": "1 Kor 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ovu nga e’yo be kakau ’yozaru emi tia, te econi emini yi a’izaru curu’do ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.26"
              },
              "items": [
                {
                  "text": "Yoh 14:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.27"
              },
              "items": [
                {
                  "text": "1 Yoh 2:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri’i Orindi e’yo adaruniri ka nga emu ra’i eri nga emi dri ce e’yo adaru ma alia dria; te eri ngani e’yo ’yo eri drisi ku, te eri nga e’yo dria erini erile ’diyi ’yo’i, eri nga vini emi dri e’yo ngapi emupi ’diyi olu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’ba ma ma ovu dizaru, erini i ngale afa mani ma azi e’dule olule, emi tiarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.14",
            "verseOrgIds": [
              "JHN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.10"
              },
              "items": [
                {
                  "text": "Yoh 17:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa dria Atani ovuzu yi be ’diyi yi mani; e’yo ’disi ma ’yo te eri afa mani ma azi e’du olu emi tia.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.15",
            "verseOrgIds": [
              "JHN.16.15"
            ]
          }
        }
      ]
    },
