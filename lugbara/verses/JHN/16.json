                  "text": "Yoh 2:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Curu’do ama ni ra mi ni e’yo dria, leni ’ba azini ma zi e’yo mi ria ku; e’yo ’disi ama a’i ra mi ibi enga Mungu vu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
