              "items": [
                {
                  "text": "Yoh 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.16"
              },
              "items": [
                {
                  "text": "1 Yoh 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba aluni ovupi leta be ’diri agazuni yo, leta nde ’bani ani idri ini kuzu va i ma agyisiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
