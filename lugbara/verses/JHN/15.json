              },
              "items": [
                {
                  "text": "28:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ka e’yo mani azile emi tia ’diyi ’ye ra, de emi ma agyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.14",
            "verseOrgIds": [
              "JHN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma omveni emi ati’baru dika ku, ati’boni e’yo opi i vilerini ’yeleri nile kurisi; ma omve te emi agyiru ’bo, a’disiku e’yo dria mani erile ma Ati vu ’diyi, ma ece yi emi dri nizu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.15",
            "verseOrgIds": [
              "JHN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.70"
              },
              "items": [
                {
                  "text": "Yoh 6:70",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.18"
              },
              "items": [
                {
                  "text": "13:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi peni ma emi’i ku, te ma ope emi ma’i, ma ’ba emi emi ma mu ani efi ’yazu, efi emini ma ovu ’dani beni; ’dini e’yo ngoni ngo emini zile Ata vu ma rusiri, eri ma fe ani emi dri, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma azi e’yo emi tia ’di, emi le emi le le,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        }
