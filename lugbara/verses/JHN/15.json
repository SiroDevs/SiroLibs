                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azita mani eri ’di, emi ma le emi emi eselia, ekile mani emi lelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
