                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma pati raza zabiburu adaru­ri’i, ma Atini ’ba eri edepiri, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.1",
            "verseOrgIds": [
              "JHN.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.13"
              },
              "items": [
                {
                  "text": "Mat 15:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri adri pati arakala dria alu alu ovupi ma alia efi ’yapi kuri opi va; te eri adri pati arakala dria alu alu efi ’yapi rari ma rua ede alaru, eri ma ’ya ani efi azini aga ra beni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.2",
            "verseOrgIds": [
              "JHN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Curu’do emi eca di alaru e’yo mani ’yole emi tia ’borisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.3",
            "verseOrgIds": [
              "JHN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ovu ma alia ’dani, ma’i ma ovu emi alia indi. Ekile pati arakalani ecole efi ’yazaru eri drisi ku, eri ka ovu pati raza zabibururi ma alia kurile, awa’dini emi econi vini ku indi, emi ka ovu ma alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.4",
            "verseOrgIds": [
              "JHN.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.12"
              },
              "items": [
                {
                  "text": "1 Kor 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.5"
              },
              "items": [
                {
                  "text": "2 Kor 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma zabibu patini, emi arakalani, ’Ba ovupi ma alia ’dani, mani ovuzu eri ma alia indiri, ’ba ’diri eri efi ’ya tu, a’disiku emi ka esele co ma be econi emini e’yo ’yezaru aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.5",
            "verseOrgIds": [
              "JHN.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.10"
              },
              "items": [
                {
                  "text": "Mat 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.40"
              },
              "items": [
                {
                  "text": "13:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ka ovu ma alia ’dani ku, yi ’be eri ekile pati arakale, eri nga ’wi ra; yi arakala nde ’diyi oku o’bezu acia, yi nga ve ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.6",
            "verseOrgIds": [
              "JHN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.24"
              },
              "items": [
                {
                  "text": "Mar 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ka ovu ma alia ’dani, azini e’yo mani ’yole ’diyi ka ovu emi alia ’dani, emi zi e’yo ngoni ngo emini leleri, eri nga i ’ye emi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.7",
            "verseOrgIds": [
              "JHN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.16"
              },
              "items": [
                {
                  "text": "Mat 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma Ati isu diza e’yo ’disi, emini efi ’yale kakaurisi; te ’dini emi nga ovu ’ba mani imbale ’diyiru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.8",
            "verseOrgIds": [
              "JHN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekile Atani ma lelerile, ma le vini emi ’dini indi; emi ma ovu ’dani ale mani ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.9",
            "verseOrgIds": [
              "JHN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.29"
              },
              "items": [
                {
                  "text": "Yoh 8:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.15"
              },
              "items": [
                {
                  "text": "14:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.4"
              },
              "items": [
                {
                  "text": "1 Yoh 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ka azita mani ’diyi ma ta mba ra, emi nga ovu ’dani leta mani ma alia; ekile mani azita ma Atini ’diyi ma ta mbale ’bo, mani ovuzu ’dani leta erini ma aliarile. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.10",
            "verseOrgIds": [
              "JHN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.13"
              },
              "items": [
                {
                  "text": "Yoh 17:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’yo e’yo ’diyi emi tia ’bo, ’dini ayiko mani ma ovu emi alia ani, ayiko emini ma ga tre indi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.11",
            "verseOrgIds": [
              "JHN.15.11"
            ]
          }
        }
