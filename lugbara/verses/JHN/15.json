          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.31"
              },
              "items": [
                {
                  "text": "Yoh 8:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.50"
              },
              "items": [
                {
                  "text": "Mat 12:50",
                  "type": "text"
                }
