              "items": [
                {
                  "text": "Mat 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ovuni nyakua dika ku, te yi ovu nyakua, azini ma mu mi vu. Ata Alatararu, mi mba, yi ma ta mi ru mini fele ma dririsi, yi ma ovu ani alu, ekile amani ovule, alurile. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 17:12"
