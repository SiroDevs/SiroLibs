                }
              ]
            }
          ]
        },
        {
          "text": "Ma zi yi ma e’yosi; ma zini nyaku ma e’yosi ku, te ’ba mini fele ma dri ’diyi ma e’yosi, a’disiku yi ’ba mini; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
