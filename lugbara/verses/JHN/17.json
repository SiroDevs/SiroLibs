                "loc": "JHN.15.11"
              },
              "items": [
                {
                  "text": "Yoh 15:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do ma mu mi vu ’di; ma ’yo e’yo ’diyi nyakua, ’dini ayiko mani ma ga ani yi asia tre beni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
