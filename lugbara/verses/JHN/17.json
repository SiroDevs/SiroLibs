                {
                  "text": "Mat 11:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mini okpo fele eri dri ovuzu ’ba rua ari be ’diyi ma drilia driarisi, eri ma fe idri ’dani ’dani ’ba dria mini fele eri dri ’diyi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
