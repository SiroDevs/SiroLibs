              "items": [
                {
                  "text": "Luk 15:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "afa di la mani ’diyi yi mini, mini ’diyi yi mani, ma isu diza yi ma alia ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        },
