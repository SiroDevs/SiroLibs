              "items": [
                {
                  "text": "Yoh 15:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma fe yi dri e’yo mini ’bo; nyaku ngu ani yi onzi, yini ovule ’ba nyakuni kurisi, ekile mani ovule ’ba nyakuni kurile. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
