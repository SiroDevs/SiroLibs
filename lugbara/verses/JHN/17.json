              "items": [
                {
                  "text": "1 Tes 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Idri ’dani ’daniri eri ’di’i, yi ma ni mi Mungu ale a’dule adaruri’i, azini ’ba mini tini epeleri Yesu Kristo’i. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
