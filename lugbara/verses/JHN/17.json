                  "text": "Mat 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ece mi ru ’ba mini fele ma dri engazu nyakua ’diyi dri ra; yi ovu mini, mi fe yi ma dri ra, yi mba e’yo mini ma ta ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
