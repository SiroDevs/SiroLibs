              "items": [
                {
                  "text": "Yoh 4:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma fe diza mi dri nyakua ra, mani azi mini fele ma dri ’yezaruri dele ’borisi; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
