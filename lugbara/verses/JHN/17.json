          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Curu’do yi ni ra afa dria mini fele ma dri ’bo ’diyi ibi enga mi vu; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "name": "verse",
