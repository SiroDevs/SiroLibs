              "items": [
                {
                  "text": "Luk 22:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma zini mi ma nze yi nyakuasi ra ’dini ku, te bani mi ma mba yi ma ta agu onzirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        },
