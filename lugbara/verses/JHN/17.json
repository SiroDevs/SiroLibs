                  "text": "Fil 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te curu’do, Ata, mi fe diza ma dri mi ngulupi be tualu, diza nde mani mani ndra ovuria mi be tualu de nga nyaku ’bani i ku ’darisi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
