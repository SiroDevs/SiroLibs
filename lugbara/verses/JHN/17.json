              },
              "items": [
                {
                  "text": "Yoh 16:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’disiku ma fe yi dri e’yo ’yoza mini fele ma dri ’diyi ’bo, yi a’i e’yo nde ’diyi ra, yi ni ra ada ma ibi enga mi vu; yi a’i vini mi epe ma ti mi’iri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
