                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "De ma ovu yi be ci, ma adri yi ma ta mba mi ru mini fele ma dririsi; ma te yi ma agei ra, ’ba aluni jani dri yi ma eselia ku, pe lu kiri mva dri jazaniri a’dule’i, ’dini e’yo siza ma ’ye i beni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
