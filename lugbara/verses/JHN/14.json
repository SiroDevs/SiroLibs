              },
              "items": [
                {
                  "text": "1 Yoh 5:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ngoni ngori emini zile ma rusiri, ma nga ’ye ra, ’dini Ata ma isu ani diza Mvi ma alia beni; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.13",
            "verseOrgIds": [
              "JHN.14.13"
            ]
          }
        },
        {
