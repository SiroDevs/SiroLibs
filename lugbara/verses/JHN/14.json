            "sid": "JHN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo ’yo eri tia, Opi, mi ece ama dri Atani, ’diri nga dri fu ama dri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.8",
            "verseOrgIds": [
              "JHN.14.8"
            ]
          }
        },
