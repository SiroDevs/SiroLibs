                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.22"
              },
              "items": [
                {
                  "text": "Mar 11:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi asi ma oti ku; emi Mungu a’i ra, emi a’i ma indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.1",
            "verseOrgIds": [
              "JHN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pari ’bani ovuzu ’diyi ovu ma Ati ma loa kakau; ka’dini yo, ma ndra olu emi tia ra, ma mu pari edezu emi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.2",
            "verseOrgIds": [
              "JHN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.26"
              },
              "items": [
                {
                  "text": "Yoh 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.24"
              },
              "items": [
                {
                  "text": "17:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ka mu, ka pari ede emi dri, ma nga emu dika, ma nga emi a’i ma vu, ’dini emi ma ovu pari mani ovuzuria alu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.3",
            "verseOrgIds": [
              "JHN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ni: angu mani muzuri ma geri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.4",
            "verseOrgIds": [
              "JHN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toma nga ’yo tinia, Opi, ama nini mi mu ngoari ku; ama di geriniri ni ngoni ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.5",
            "verseOrgIds": [
              "JHN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.20"
              },
              "items": [
                {
                  "text": "Ebra 10:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.27"
              },
              "items": [
                {
                  "text": "Mat 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.25"
              },
              "items": [
                {
                  "text": "Yoh 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.1"
              },
              "items": [
                {
                  "text": "Rum 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu nga ’yo tinia, Ma gerini ma’i, ma e’yo adaruni ma’i, ma idrini ma’i ’ba aluni cani Ata vu ku, pe lu kiri ma vurisi ka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ka ndra ma ni ra, te’do emi ni ma Atini alu indi; te engazu curu’do emi ni eri ra, emi ndre vini eri ’bo indi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.7",
            "verseOrgIds": [
              "JHN.14.7"
            ]
          }
        }
      ]
    },
    {
