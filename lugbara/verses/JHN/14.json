                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia ndi ndi, ’ba ma a’ipiri nga ’yeta mani ’yele ’diyi ’ye indi; eri nga vini ’yeta ’diyi agapi ra ’diyi ’ye, mani mule Ata vurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.12",
            "verseOrgIds": [
              "JHN.14.12"
            ]
          }
        },
        {
