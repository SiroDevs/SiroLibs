              "type": "text"
            }
          ]
        },
        {
          "text": "Omu agaza ’ba drilesi ’ba Yahudiniri eca ogogo; Yesu nga tu mu Yerusalemua ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.13",
            "verseOrgIds": [
              "JHN.2.13"
            ]
