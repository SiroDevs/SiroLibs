                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri isu hekalua ’ba yini ti piyi oziria kabilo pie, a’balau pie, isu vini ’ba silingi ofupi ’diyi yini riria ’daa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.14",
            "verseOrgIds": [
              "JHN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga baka ekila ekila, nga yi odro dria hekaluarisi amve, kabilo piyi, ti pie; eri oda silingi ’ba silingi ofupi ’diyini va, ogu vini mesa yini indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.15",
            "verseOrgIds": [
              "JHN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.49"
              },
              "items": [
                {
                  "text": "Luk 2:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo ’ba a’balau ozipi ’diyi ma tia, Emi ji afa ’diyi amve; emi ’ba ma Ati ma jo jo afa jezuriru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.16",
            "verseOrgIds": [
              "JHN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
