              "items": [
                {
                  "text": "Yoh 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Yahu­dini nga e’yo omvi, ’yo eri tia ani, Mi ece ama dri eceta ngoni ngori mini afa ’diyi ’yezurisi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        },
