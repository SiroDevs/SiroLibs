                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Zab 69:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba erini imbale ’diyi nga a kini e’yo ovu sizaru ’dini, jo mini ma avani ma fu fu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
            "verseOrgIds": [
              "JHN.2.17"
            ]
          }
        },
