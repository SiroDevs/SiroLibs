                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.26+LUK.23.27+LUK.23.28+LUK.23.29+LUK.23.30+LUK.23.31+LUK.23.32+LUK.23.33+LUK.23.34+LUK.23.35+LUK.23.36+LUK.23.37+LUK.23.38+LUK.23.39+LUK.23.40+LUK.23.41+LUK.23.42+LUK.23.43+LUK.23.44+LUK.23.45+LUK.23.46"
              },
              "items": [
                {
                  "text": "Luk 23:26-46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga di eri fe yi dri ani dizu pati ruaa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ji Yesu ani, erini pati alaza i ngulupini jiria, eri fu mu pari ’bani omvele ’Ba dri fala’iria, yini omvele Ebrania tisi Gologota’iri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.17",
            "verseOrgIds": [
              "JHN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi di eri pati ruaa ’daa, yi di ’ba azini iri eri be tualu, alu kala aluria, alu kala aziniria, Yesuni yi eselia agadua, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.18",
            "verseOrgIds": [
              "JHN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato si e’yo eri ma e’yo e’dazuri, ’ba eri pati alaza ma dria; e’yo siza ovu ’dini, YESU ’BA NAZA­RETIA, OPI YAHUDINIRI’I. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.19",
            "verseOrgIds": [
              "JHN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Yahudini kakau nga e’yo e’daza ’diri la, a’elisiku pari yini Yesuni dizu pati ruaari ovu ogogo aku amboru ma ageia; yi si e’yo siza nde Ebrania tisi, Rumi tisi, Giriki usi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.20",
            "verseOrgIds": [
              "JHN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhani amboru ’ba Yahudini ma drilia ’diyi nga ’yo Pilato ma tia ani, Mi si, Opi Yahudiniri’i ’dini ku, te mi si, Eri ’yo ra kini, Ma Opi Yahudiniri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.21",
            "verseOrgIds": [
              "JHN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato nga e’yo omvi, E’yo mani sile ’bori ma si te de ’bo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        }
      ]
    },
