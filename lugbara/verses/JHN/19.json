          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Zab 69:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu yi ’ba te patiefi su drazaru imvu ma alia tre ’daa; yi nga afa ezekezeru su patiefi su takari ma alia, nga eri su pati sia, ’ba tilenia ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ka patiefi su drazari a’i ’bo, eri ’yo ra, De i ’bo; eri nga i dri elu, ku orindi ini fuzu ra.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
