              },
              "items": [
                {
                  "text": "18:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’diri ma vutia, Yesuni niria kini e’yo dria ’ye yi de ’bo, e’yo siza ma ’ye i ani, nga ’yo ra, Yi avijo fu ma ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
