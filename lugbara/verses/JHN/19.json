          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te andri erini pi oso pa pati alaza Yesuni ma ageia, andri ma amvi pie, Mariamu oku Kileopa vileri pie, Mariamu Magadaleni pie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.25",
            "verseOrgIds": [
              "JHN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.23"
              },
              "items": [
                {
                  "text": "Yoh 13:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu ka i andrini ndre, ’ba erini imbale erini leleri be erini pa soria ogogo, eri ’yo i andri tia, Oku la, mi ndre, mi mvini ’eli! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eli ’yo ’ba erini imbaleri ma tia, Mi ndre, mi andrini ’di! Engazu etu ’dasi ’ba erini imbale nderi ’du eri ji i vile joa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        }
      ]
