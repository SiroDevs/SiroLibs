                "loc": "1SA.13.5"
              },
              "items": [
                {
                  "text": "13:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.1"
              },
              "items": [
                {
                  "text": "31:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Filisitiaa ’diyi ’di a’di ’ba Israelini be; ’ba Israelini apa ’ba Filisitiaa ’diyi dri ra, o’de odra oni Giliboaa ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Filisi­tiaa ’diyi dro Saulo pi ma vuti anzipi be okposi; ’ba Filisitia ’diyi ofu Yonatani pi, Abinadabu pie, Maliki­sua pie, anzi Saulo vile ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omba nderi eca Saulo ma ruaa onzikanyaru tu, ’ba osu gbipi ’diyi isu eri ra; eri ma asi oti ’ba osu gbipi ’diyi ma e’yosi tu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.16.21"
              },
              "items": [
                {
                  "text": "Lip 16:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Saulo nga di ’yo ’ba gombere ombani eriniri ’dupiri ma tia kini, Mi enze sei mini, mi ma so ma ani, ’ba agele liza kokoru ’diyi kazu emuzu ma inzazu ku. Te ’ba gombere ombani erini ’dupiri leni ku, erini ovule uri be turisi. Ka’dini Saulo nze di i ma sei ra, ’be sinia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba gombere ombani Saulo vileri ’dupiri ka ndre Saulo dra ’bo, nze vini sei i vileri ’dinile, ’be i sinia, dra ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Saulo pi odra, anzi be na tro; ’ba eri vile joa ’diyi odra dria eri be tualu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba Israelini dria ovupi e’bu alia ’diyi ka ndre yi apa ra ’dini, azini Saulo pi anzi erini be odra ’bo, yi ku aku amboru yiniri ra, apa ra; ’ba Filisi­tiaa ’diyi emu di adri ’ba nde ’diyi ma pariani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dru ’dini, ’ba Filisitiaa ’diyiru emuria ’ba yini ofule ’diyi ma bongo otruria, yi isu Saulo pi ma avu o’de anzipi be oni Giliboa ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi otru afa suza erini, yi ’du eri ma dri, afa ombani erini be, yi pe ’ba ma ti angu Filisitiaria kala vusi dria, e’yoni ojizu wura inzile inzi yini edele ’diyi vu, azini ’ba ’dale ’diyi vu, le’yoni ekuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.10"
              },
              "items": [
                {
                  "text": "1 Sam 31:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.48.5"
              },
              "items": [
                {
                  "text": "Isa 48:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di afa eri vile ombani ’diyi o’ba adrou yini ’diyi ma joa, epa eri ma dri Dagoni vile joa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba dria Yabesi-gileadia diyi ka e’yo dria ’ba Filisitiaa ’diyini ’yele Saulo ma ruaa ’diyi ma e’yo eri ’bo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.11",
            "verseOrgIds": [
              "1CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba asi teza be ’diyi enga dria ra, yi o’du Saulo pi ma avu anzipi be, cii yi Yabesia, sa fala yini kumara pati Yabesiari ma etia, nyani nyaka o’du aziri ku.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        }
      ]
    },
