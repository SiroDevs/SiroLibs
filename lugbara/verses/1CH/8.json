          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azeli ovu agianzi be azia, yi ru ’dini: Azirikamu pi, Bokeru pi, Isimaeli pi, Searia pi, Obadia pi, Hanani pie. Anzi ’eliyi dria Azelini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
