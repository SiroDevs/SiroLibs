          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi ti Yehoa­dani; Yehoada ti Alemeti pi, Azi­maveti pi, Zimiri pie; Zimiri ti Mozani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
