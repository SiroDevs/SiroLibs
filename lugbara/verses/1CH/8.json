                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mika anzipi: Pitoni pi, Meleki pi, Tarea pi, Ahazi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
