                  "text": "Azi 28:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dini Yoabu pi ’ba ovupi eri be ’diyi be, yi esi ogogo ’ba Suriaa ’diyi ma drilia omba ’bazu; te ’ba nde apa eri ma driliarisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni anziyi ka vini ndre kini ’ba Suriaa ’diyi apa ’bo, ’dinile indi yi apa Abisai eri adri ma driliarisi ra, yi mu fi aku amborua. Yoabu nga di emu Yeru­salemua ndo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
