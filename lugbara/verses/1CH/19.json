              "items": [
                {
                  "text": "1 Opi 16:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba azini nga mu e’yo ’yele ’ba nde ma ruaari olu Daudi ma tia. Eri nga ’ba ti pe muzu dri fuzu yi be ani; ’ba ’diyini ovule drinza be turisi. Te opi ’yo yi ma tia, Emi te Yerikoa kpere emi ti’bini duria, emi emvi ndo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        }
      ]
    },
