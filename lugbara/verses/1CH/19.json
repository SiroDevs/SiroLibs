            }
          ]
        },
        {
          "text": "Emi ma ovu asi tezasi onyiru, ama ma ’ye amani asi agupinisi ’ba amani dri azini aku ambo ambo Mungu amanirini dri indi; Yehova ma ’ye e’yo ovupi onyiru eri miliari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        },
