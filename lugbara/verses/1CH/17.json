                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova la, ’ba azi mileni yo, kani Mungu andini yo pe lu kiri mi’i, ekile e’yo dria amani erile ama bilesi ’diyile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
