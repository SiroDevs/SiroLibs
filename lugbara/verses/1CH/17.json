        },
        {
          "text": "te ma nga fe eri ma ri ma vile joa azini suru ma vileria ’dani ’dani, azini oguna erini opiniri nga pa so kirikiri ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’diyi vusi dria azini ndreta ’diri vusi dria indi, Natani ’yo di e’yo Daudi ma tia ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        },
