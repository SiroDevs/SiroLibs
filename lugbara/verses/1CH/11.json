          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.70"
              },
              "items": [
                {
                  "text": "Zab 78:70",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.71"
              },
              "items": [
                {
                  "text": "71",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Andra Sauloni ovuzu opi­rurisi, eri ndra bani mi’i ’ba Israelini ofupi azini yi ofipiri; Yehova Mungu miniri ’yo ndra mi tia kini, Mi nga nyaka fe ’ba mani Israelini ’diyi dri, mi nga adri ’ba mani Israelini ma drilia opiru mi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.2",
            "verseOrgIds": [
              "1CH.11.2"
            ]
          }
        },
        {
