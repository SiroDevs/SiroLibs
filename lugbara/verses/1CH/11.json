        },
        {
          "text": "Etu ’dasi ’ba Israelini oku yi dria Daudi vu Hebironia, kini, Mi ne, ama fala mini za mi ruaari be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.1",
            "verseOrgIds": [
