                "loc": "1CH.2.53"
              },
              "items": [
                {
                  "text": "53",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ira ’ba Itirini pi, Garebu ’ba Itirini pi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.40",
            "verseOrgIds": [
              "1CH.11.40"
            ]
          }
        },
        {
