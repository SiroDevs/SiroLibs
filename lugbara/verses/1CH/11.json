                "loc": "2SA.23.8"
              },
              "items": [
                {
                  "text": "2 Sam 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.1"
              },
              "items": [
                {
                  "text": "1 Sam 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diyi ’ba ’wara ’ba okporu Daudini ovuzu yi be ’diyi ma drilia, yi e’da yi okporu eri be opi nyaza erini ma alia eri ’bazu opiru, yi’i ’ba Israelini be dria, e’yo Yehovani ’yole Israeli ma e’yosirile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba okporu Daudini ovuzu yi be ’diyi ma kalafe ’di: Yasobeamu ’ba Hakimonini ma mvi, opi ’ba kali na ’diyini; eri enga ndra aju ini a’di ’dizu ’ba turu na ’diyi be, ofu yi dria etu alu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia Eleazari Dodo mvi ’ba Ahohini, eri ’ba alu ’ba okporu na ’diyi ma eseliari. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.12",
            "verseOrgIds": [
              "1CH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.1"
              },
              "items": [
                {
                  "text": "1 Sam 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ovu ndra Daudi be Pasi-damimua ra, ’ba Filisitiaa ’diyini yi okuria a’di ’diria ’dale. Isu de amvu indi ’daa anyani kazu alenia turi; ’ba nde yi apa ’ba Filisitiaa ’diyi dri apa apa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.13",
            "verseOrgIds": [
              "1CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.21.31"
              },
              "items": [
                {
                  "text": "O’be 21:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi oso pa amvu nde ’diri ma alia agadua eri arizu, yi ofu ’ba Filisitiaa ’diyi ra, te Yehova opa yi pata amborusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.12.15"
              },
              "items": [
                {
                  "text": "Yos 12:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.13"
              },
              "items": [
                {
                  "text": "2 Sam 23:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.14.9"
              },
              "items": [
                {
                  "text": "1 Sur 14:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.17.5"
              },
              "items": [
                {
                  "text": "Isa 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba na ’ba kali na amboru ’diyi ma eselia si Daudi vu kata etia, oni oji Adulamuaria; isu de ’ba Filisitiaa ongulumuru ’diyi aso hema yini e’bu Refaimuaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.15",
            "verseOrgIds": [
              "1CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ovu yi be pari okporu ma alia nga ’dani, azini asikari ’ba Filisitiaa angu tepi ’diyi de Betelehemua. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.16",
            "verseOrgIds": [
              "1CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi avijo fu Daudini ra, kini, ’Ba ’diyi la! a’di ka mani yi a’di kalitile Betelehemuari ebe fe mani mvuni ya! ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.17",
            "verseOrgIds": [
              "1CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba na ’diyi efu asikari ongulumuru ’ba Filisitiaa ’diyini ma eseliasi, mu yi a’di kalitile Betelehemuari ebe, eji Daudi dri. Te Daudi leni eri mvu ku; osu eri va Yehovani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.18",
            "verseOrgIds": [
              "1CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "’yo ra kini, Mungu mani ma oga mani e’yo ’diri ’yeko ’dini si. Ma nga ’ba idri yini adipi dra dri ’diyi ma ari mvu ra ya? A’disiku yini idri yini adile dra dri eri ejizurisi. E’yo ’disi leni ndra ani yi nde mvuzu ku. E’yo ’diyi ’ba okporu na ’diyi ’yeni. ",
          "type": "text",
