                "loc": "1SA.16.1"
              },
              "items": [
                {
                  "text": "1 Sam 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ’ba ’wara Israelini yi emu dria opi vu Hebironia; Daudi nga aziza azi yi be Hebironia Yehova ma milia ani, yi osu odu Daudi ma dria ovuzu opiru ’ba Israelini ma drilia, ekile e’yo Yehovani ’yole Samueli ma tisirile.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        }
      ]
