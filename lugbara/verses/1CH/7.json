                  "text": "1 Sur 8:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Benyamini anzipi: Bela pi, Bekeri pi, Yediaeli pie, yi na. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be­la anzipi: Eziboni pi, Uzi pi, Uzieli pi, Yerimoti pi, Iri pie, yi towi; ’ba ori’ba yi atapini ma dri cepi ’diyi, ’ba ombaru ’diyi, la yi a’bianzi yini vusi alifu kali iri drini iri, drini kali na drini su. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bekeri anzipi: Zemira pi, Yoasi pi, Eliezeri pi, Elioenai pi, Omiri pi, Yeremoti pi, Abiya pi, Anatoti pi, Alemeti pie. ’Diyi dria Bekeri ma anzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "La yi a’bi olaza vusi, a’bianzi yini vusi, yi ’ba yi atapi ma ori’ba ma dri cepi ’diyi, ’ba ombaru alifu kali iri, drini turu iri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yediaeli anzipi: Bilani piyi. Bilani anzipi: Yeusi pi, Benyamini pi, Ehudi pi, Kenaana pi, Zetani pi, Tarisisi pi, Ahisahari pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Diyi dria Yediaeli ma anzi, la yi ’ba yi atapi ma ori’ba dri cepi ’diyi vusi, ’ba ombaru ’diyi alifu mudri drini aziri drini turu iri, ndra ecopi mupi ’ba ongulumuru ma eselia ombaa ra ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.38"
              },
              "items": [
                {
                  "text": "Kal 26:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.39"
              },
              "items": [
                {
                  "text": "39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Supimu pi Hupimu be yi anzi Irini, Husimu piyi yi anzi Aherini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
