        {
          "text": "Efiraimu anzipi: Sutela pi, mvi Beredi pi, mvi Tahati pi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        },
        {
