              "type": "text"
            }
          ]
        },
        {
          "text": "Manase anzipi: Asirieli pi, oku eri vilerini tileri’i, te oku erini ati’boru Arami ziruri ti Makiri Gileadi ma atini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.1+NUM.27.2+NUM.27.3+NUM.27.4+NUM.27.5+NUM.27.6+NUM.27.7+NUM.27.8+NUM.27.9+NUM.27.10+NUM.27.11"
              },
              "items": [
                {
                  "text": "Kal 27:1-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Makiri je oku Hupimu piri Supimu be. Amvi ma ru Maaka’i. Mva iriri ma ru Zelofehadi’i; te Zelofehadi ti ini ezoanzini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaka Makiri vile oku nderi ti mva agupia, ’da runi Peresi’i; adri ma ru Seresi’i; anzi erini Ulamu pi Rakemu be oku nderi ti mva agupia, ’da runi Peresi’i; adri ma ru Seresi’i; anzi erini Ulamu pi Rakemu be. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.16",
            "verseOrgIds": [
              "1CH.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.11"
              },
              "items": [
                {
                  "text": "1 Sam 12:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Ulamuni: Bedani piyi. ’Diyi Gileadi, Manase mvi Makiri ma mvi ma anzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amvi Hamoleketi ti Isihodi pi, Abiezeri pie, Mala pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.18",
            "verseOrgIds": [
              "1CH.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Semida anzipi yi Ahiani pi, Sekemu pi, Liki pi, Aniamu pie.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
