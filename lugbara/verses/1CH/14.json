                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.1+PSA.2.2+PSA.2.3+PSA.2.4+PSA.2.5"
              },
              "items": [
                {
                  "text": "Zab 2:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Filisitiaa ’diyi ka eri kini ’ba osu odu Daudi ma dria eri ’bazu opiru ’ba Israelini dria ma drilia ’bo, ’ba Filisitiaa ’diyi dria tu uru Dau­dini ndruzu; Daudi eri e’yo ’di ra, fu a’di ’dizu yi be ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.8",
            "verseOrgIds": [
              "1CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.11.15"
              },
              "items": [
                {
                  "text": "1 Sur 11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "De isu ’ba Filisitiaa ’diyi yi emu fi a’di ’dizu e’bu Refaimunia ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.9",
            "verseOrgIds": [
              "1CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nga zi Mungu tia, kini, Ma nga tu uru muzu omba ’bazu ’ba Filisitiaa ’diyi be ra ya? Mi nga yi fe ma dria ra ya? Yehova ’yo eri ma tia kini, Mi tu uu; te ma nga yi fe mi dri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dinile yi etu uru Baali-perazimua, Daudi nga yi o’di ’daa; Daudi nga di ’yo ani kini, Mungu onyo ari’ba mani ma drisi ekile yi razani angu anyolerile ’bo. E’yo ’disi yi omve di ani angu ’da ma ru Baali-perazimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi ku adrou yini ’diyi ’daa; Daudi azi e’yoni ani, yi eve yi acisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.22"
              },
              "items": [
                {
                  "text": "2 Sam 5:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Filisitiaa ’diyi fi vini a’di ’dizu e’bu alia dika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.13",
            "verseOrgIds": [
              "1CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.6"
              },
              "items": [
                {
                  "text": "Yos 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.23"
              },
              "items": [
                {
                  "text": "2 Sam 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi zi Mungu tia dika; Mungu ’yo eri ma tia, Mi ngani tu yi ma vusi uru ’dale ku; mi ja mi yi ma kalaasi, mi mu yi vu isisi pati ma drilialeru. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga ovu ’dini, mi ka ididi acizuri eri isisi pati sia ra, mi ma fu di a’di ’dizu yi be; Munguni mule mi drilia asikari ongulumuru Filisitiaa ’diyi ofuzurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.25"
              },
              "items": [
                {
                  "text": "2 Sam 5:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi ’ye ekile Mu­nguni azile eri ma tiarile; yi o’di asikari ongulumuru ’ba Filisitiaa ’diyini engazu Gibeonia kpere Geze­ria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
