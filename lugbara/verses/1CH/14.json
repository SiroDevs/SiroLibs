                "loc": "JOS.6.27"
              },
              "items": [
                {
                  "text": "Yos 6:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.8"
              },
              "items": [
                {
                  "text": "2 Sur 26:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.25"
              },
              "items": [
                {
                  "text": "Azi 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.25"
              },
              "items": [
                {
                  "text": "11:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi ma ru nga di ku ani angu dria ma alia, azini Yehova fe eri ma uri fi suru dria ma dria.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        }
