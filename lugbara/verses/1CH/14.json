                "loc": "1KI.5.1+1KI.5.2+1KI.5.3+1KI.5.4+1KI.5.5+1KI.5.6+1KI.5.7+1KI.5.8+1KI.5.9+1KI.5.10+1KI.5.11+1KI.5.12"
              },
              "items": [
                {
                  "text": "1 Opi 5:1-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hiramu opi Turoari pe ojio ma ti Daudi vu, mario pati pie, onduou jo sipi ’diyi pie, onduou mbau edepi ’diyi pie, jo sizu erini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ni di kini Yehova ’ba i ovuzu opiru Israeli ma driliani, a’disiku suru erinirini ovule ’bazaru amboru uru ’ba erini Israelini ’diyi ma e’yosirisi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
