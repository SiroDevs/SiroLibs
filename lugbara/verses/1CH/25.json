              "type": "text"
            }
          ]
        },
        {
          "text": "mudri drini aluri Azareli dria, anzi erini pie, adripi erini be, yi mudri drini iri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.18",
