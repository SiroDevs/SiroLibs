          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mudriri Simei dria, anzi erini pie, adripi erini be, yi mudri drini iri ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.17",
            "verseOrgIds": [
              "1CH.25.17"
            ]
