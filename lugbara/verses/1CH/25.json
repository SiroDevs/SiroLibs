              "type": "text"
            }
          ]
        },
        {
          "text": "mu­dri drini iriri Hasabia dria, anzi erini pie, adripi erini be, yi mudri drini iri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.19",
            "verseOrgIds": [
