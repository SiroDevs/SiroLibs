            }
          ]
        },
        {
          "text": "Kalafe yini, adripi yini pie ovupi imbazaru ongo ngozu Yehova dri ’diyi, adani ’ba dria ongo nde ngopi onduasi ’diyi, yi ovu dria turu iri kali aro drini aro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
