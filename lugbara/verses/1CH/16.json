                }
              ]
            }
          ]
        },
        {
          "text": "Ku vini Zadoki atalau edeta edepiri pi adripi erini atalau edeta edepiru ’diyi be hema Yehovani ma drilia, pari uruleru Gibeoniaria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
