              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini eri ku Asafu pi adripi be sanduku aziza Yehovanirini ma drilia, azi ngazu sanduku nde ma drilia ’dani ’dani ekile o’du alu alu ma azini ovulerile; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
