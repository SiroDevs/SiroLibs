              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ope ’ba Levini ma azi azi ngazu sanduku Yehovani ma drilia, e’yo erini egazu, awa’difo fezu, Yehova ma ru inzizu indi, eri Mungu Israeliniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambo yi ma driliari Asafu’i, vutinia Zekaria’i, Yeyeli pi, Semiramoti pi, Yehieli pi, Matitia pi, Eliabu pi, Benaya pi, Obedi-edomu pi, Yeyeli pie dria, ongo ngozu afa zaburi ngozuri pisi o’di be; Asafuni indi aya co o’duko urusi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya pi Yahazieli be, atalau edeta edepi ’diyi, yi ovu guka be ’dani ’dani sanduku aziza Mungu­nirini ma drilia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        }
      ]
    },
    {
