          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku vini i Obedi-edomu pi adripi be kali azia drini aro; vini Obedi-edomu Yedu-: tuni mvi pi Hosa be ovuzu ’ba jotile agei tepi ’diyiru. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        },
