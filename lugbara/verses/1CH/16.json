        },
        {
          "text": "Ka’dini o’du ’dasi Daudi e’do oko inzita ’bani awa’difo fezu Yehova driri azizu, Asafu pi dri adripi be.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
