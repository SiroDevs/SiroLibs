              "items": [
                {
                  "text": "2 Sam 6:17-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi eji di sanduku Munguni ra, ’ba eri hema Daudini asole eriniri ma alia agadua; fe edeta veza­ru azini edeta asi anzuruni Mungu ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ka edeta vezaru azini asi anzuruni ’diyi fe de ’bo, eri fe asi ndriza ’ba nde ma dria Yehova ma rusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fe vini ’ba Israelini alu alu dri, agupi piyi dri okuyi be, enya olemi alu alu, za be za be, zabibu ’wiza ombale ngulu ngulu ’diyi alu alu indi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
