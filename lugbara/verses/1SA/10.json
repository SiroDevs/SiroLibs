                "loc": "MAT.7.21+MAT.7.22+MAT.7.23"
              },
              "items": [
                {
                  "text": "Mat 7:21-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yini ecazu oni ndea ’boria, mi lu, nabi nguluru acipi tualu ’diyi fu dri eri be; azini Orindi Munguni esi eri ma dria okporu, eri ondri e’yo yi ma eselia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.10",
            "verseOrgIds": [
              "1SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 10:11"
          },
          "items": [
