                "loc": "ACT.4.13"
              },
              "items": [
                {
                  "text": "’Yeta 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, ’ba dria eri nipi ndra drio ra ’diyi ka ndre eri ondri e’yo nabi ma eselia ra, ’ba nde ’diyi nga di ’yo yi agyi ma tia alu alu, A’du eca Kisi mvi ve ’dinini ya? Sauloni vini alu nabi ma eselia indi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.11",
            "verseOrgIds": [
              "1SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 10:12"
          },
          "items": [
