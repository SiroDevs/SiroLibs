                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agu alu pari nderiari omvi kini, A’dini ata yinini ya? E’yo ’disi e’yo ’di eca e’yo o’bezaru, kini, Sauloni vini alu nabi ma eselia indi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.12",
            "verseOrgIds": [
              "1SA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ka de e’yo ondrizu ’bo, eri eca pari uruleruria. ",
          "type": "text",
          "attrs": {
