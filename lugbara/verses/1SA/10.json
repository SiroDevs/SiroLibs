              ]
            }
          ]
        },
        {
          "text": "’Dini Samueli eji suruti Israe­lini dria ogogo, te pe suru Benya­mininiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.20",
            "verseOrgIds": [
              "1SA.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri eji vini suruti Benyaminini ogogo ori’ba vusi ori’ba vusi, te pe ori’ba Matri vileri’i; eri eji vini ori’ba Matri vileri ogogo, te pe Saulo Kisi mvi’i. Te yi ka eri nda ra, econi eri isuzaru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.21",
            "verseOrgIds": [
              "1SA.10.21"
            ]
          }
        },
