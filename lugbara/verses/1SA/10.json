                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.13.8"
              },
              "items": [
                {
                  "text": "13:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ma si va ma drilia Giligalia; te mine, ma nga esi va mi vu afa feza vele edetaruri azini edeta asi anzuruni edezu. Mi ma te o’du aziri, kpere mani emuria mi vu afa mini ngale ’yeleri eceria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.8",
            "verseOrgIds": [
              "1SA.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, erini i ma Inguku ojazu Samueli vuleru muzu ’boria, Mungu fe eri dri asi ndu; eceta nde ’diyi dria nga eca ’dini o’du ndesi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.9",
            "verseOrgIds": [
              "1SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 10:10"
