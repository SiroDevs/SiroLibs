              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Saulo ma ati oguri kini, Ma zi mi tia, mi olu mani e’yo Samuelini ’yole mi tiari fo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.15",
            "verseOrgIds": [
              "1SA.10.15"
            ]
          }
        },
