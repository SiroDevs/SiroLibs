                  "text": "Lip 18:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi nga mi zi ci ci, yi nga mi dri enya olemi iri ’diyi fe; mi nga yi a’i yi ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.4",
            "verseOrgIds": [
              "1SA.10.4"
            ]
