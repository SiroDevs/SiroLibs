          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.4"
              },
              "items": [
                {
                  "text": "1 Tes 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.26"
              },
              "items": [
                {
                  "text": "Lev 8:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi omvi e’yo atalau edeta edepiri ma tia, ’yo eri tia kini, Adaru, oku yi ovuni ama be o’du na ’diyi ma alia ku, afazu karile nde ’diyini yi adri ovu alaru acita amani toko ’diyisi; ka’dini andru afazu yini yi ngani ovu alatararu aga ra ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.5",
            "verseOrgIds": [
              "1SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
