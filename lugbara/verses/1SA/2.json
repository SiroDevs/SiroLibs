              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Eli ovu de mbazauru, azini eri eri e’yo dria i anzipini ’yele ’ba Israelini dria vu ’diyi ra, azini e’yo yini adrizu olazu oku azi ngapi hema ti ecizaniri ma tilia ’diyisiri indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ’yo yi ma tia, Emi e’yo,’dilile ’diyi ’ye a’disi ya? Ma eri ’ba ’diyi vu dria e’yo onzi emini ’yele ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
            "verseOrgIds": [
              "1SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo, anzi mani; te e’yo kuza mani erileri ovuni onyiruni ku; emi fe ’ba Yehovani ’diyini azi onzi i ’yezu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
