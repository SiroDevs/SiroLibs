              "items": [
                {
                  "text": "Rum 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini azi onzi karile nde ’diyini ovu ndra Yehova ma milia amboru tu; ’ba nde ’diyini afa feza fele Yehova driri ’bale aparaka­rurisi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
