                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ne, ewuni emu ’di mani ngazu mi wu lizu, azini suru mi a’bini ma wu indi, ’dini mbazau aluni ngani adri mi vile suru alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
