                }
              ]
            }
          ]
        },
        {
          "text": "Te Samueli mva nderi zo ’dani e’yo erini ovu onyiru Yehova ma milia, ’ba ma milia indio ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        },
