          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati’bo omvi e’yo Saulo ma tia dika, kini, Mi lu, ma dria ’do sekeli dahabuni ma esele alu suniri indi, ma nga ’di fe ’ba Munguniri dri erini ngazu ama dri geri ecezurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.8",
            "verseOrgIds": [
              "1SA.9.8"
            ]
          }
