          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nga di ’yo i ati’bo ma tia, Mi ’yo ’yeke, mi emu, ama mu. ’Dini yi fi aku amboru ’ba Mungunini ovuzu aleniaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.10",
            "verseOrgIds": [
              "1SA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
