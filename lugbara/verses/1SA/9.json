              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te akanya Saulo ati Kisini ’diyi avi ra. Te Kisi’yo i mvi Saulo ma tia, Mi ’du ati’bo alu mi be, mi nga, mi mu akanya ’diyi ndruzu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.3",
            "verseOrgIds": [
              "1SA.9.3"
            ]
          }
        },
        {
