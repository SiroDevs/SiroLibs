              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.16"
              },
              "items": [
                {
                  "text": "Efu 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yini turia uru aku amboru nderia, yi isu ezoanzi yini muria yi koria, yi ’yo yi ma tia, ’Ba e’yo; ndreza ndrepiri ’doa ci ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.11",
            "verseOrgIds": [
              "1SA.9.11"
            ]
          }
        },
