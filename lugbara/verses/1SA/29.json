                {
                  "text": "1 Sam 28:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opi ’ba Filisitiaa ’diyini ’diyi yi aga turu vusi turu vusi, azini alifu vusi alifu vusi, te Daudi pi ’ba erini ’diyi be yi aga vilerisi Akisi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
