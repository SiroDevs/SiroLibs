                "loc": "1PE.3.16"
              },
              "items": [
                {
                  "text": "1 Pet 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi­’anzi ’ba Filisitiaa ’diyini ’diyi yi nga di ’yo, ’Ba Ebrania ’diyi ’dia a’di ’ye ya? Te Akisi ’yo opianzi ’ba Fili­sitiaa ’diyini ’diyi ma tia, ’Di ovuni.Daudi ati’bo Saulo opi Israelinirini, o’api ma be o’du ’diyisi, kani eli ’diyisi,mnani onzi isuzu eri ma alia ku engazu erini emuzu ma vurisiri’i ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
