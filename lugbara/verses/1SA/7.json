              "items": [
                {
                  "text": "Yer 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Samueli nga kabilomva nga lesu ndrupi ndruri ’du fe pi vezaru Yehova dri, azini Samueli wu Yehova vu Israeli ma e’yosi, te Yehova eri eri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
