                  "text": "2 Opi 25:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Samueli ’yo ra, emi oku ’ba Israelini dria Mizipaa, ma nga zi Yehova tia emi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
