                }
              ]
            }
          ]
        },
        {
          "text": "Samuelini edeta vezaru feria, ’ba Filisitiaa ’diyi yi esi ogogo omba ’bazu Israeli be; te etu ndesi Yehova no o’duko ambosi ’ba Filisitiaa ’diyi ma dria, fe uri yi asia tre; yi ovu ofuzaru Israeli ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba Israelini fu Mizipaarisi, yi dro ’ba Filisitiaa ’diyi ma voti, yi ofu yi kpere yini caria Beti-kari ma etia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
