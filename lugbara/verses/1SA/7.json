                "loc": "ISA.37.4"
              },
              "items": [
                {
                  "text": "Isa 37:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Isra­elini ’yo Samueli tia, Mi ma ku wuzu amasi Yehova Mungu amaniri vu ku, ’dini eri ma opa ama ’ba Filisitiaa ’diyi ma dria beni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
