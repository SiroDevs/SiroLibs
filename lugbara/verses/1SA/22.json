        },
        {
          "text": "Te Ahimeleki Ahitubu mvi ma mvi alu, runi Abiatari’i, pa ira, eri ape Daudi ma vutisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.20",
