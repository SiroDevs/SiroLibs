              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Abia­tari ece Daudi dri kini Saulo ofu atalau Yehovani edeta edepi ’diyi ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
