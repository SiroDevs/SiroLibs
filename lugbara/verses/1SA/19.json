                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Mikali osi Daudini va derisasi; eri mu ra, nzu ra, pa ira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.12",
            "verseOrgIds": [
              "1SA.19.12"
            ]
          }
        },
        {
