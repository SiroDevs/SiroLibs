              "items": [
                {
                  "text": "18:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te isu orindi onzi engapi Yehova vuri esi Saulo ma dria, erini riria aju be i ma dria joaria; te Daudi ovu o’di cozu i ma drisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.9",
            "verseOrgIds": [
              "1SA.19.9"
            ]
