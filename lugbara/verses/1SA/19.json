              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi ka e’yo nderi olu Saulo tia, eri pe ojio azini ’diyi ma ti, te yi ondri e’yo indio Dika Saulo pe ojio ti pale narisi, te yi ondri e’yo indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
              "1SA.19.21"
            ]
          }
        },
