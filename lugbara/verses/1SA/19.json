                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yonatani olu Daudi tia kini, Ma ati Sauloni geri nda mi fuzu; e’yo ’disi ma matu ’ba mi vu, mi te mi agei onyiru o’bitisi, mi adri pari zizaruri ma alia, mi ma zi mi zi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.2",
            "verseOrgIds": [
              "1SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ma nga fu amve, mu pa sozu ma ari ageia, pari mini adrizu asearia, ma nga o’yo ma ati be ’yo minisi; ma ka e’yo isu ra ma nga olu mi dri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
