                "loc": "JDG.17.5"
              },
              "items": [
                {
                  "text": "Lip 17:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Mikali ’du wura inzile inziri, eri la eri gbolo dria’i eri ’ba afa dri atizu ede le ndri ’bikosiri erini dri atizu’i, eri ’be drini bongosi ci. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.13",
            "verseOrgIds": [
              "1SA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Sauloni ’ba ti peria muzu Daudini ejizu, oku ’yo ra kini, Eri azoru. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.14",
            "verseOrgIds": [
              "1SA.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Saulo pe ’ba ti dika Daudini ndrezu kini, Emi eji eri gbolo dria ma vu ’doa, ma ma fu eri ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.15",
            "verseOrgIds": [
              "1SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba tini epele ’diyi ka efi ra, mi ne, dere wura toko ’baleri gbolo driani, afa dri atizu edele ndri ’bikosiri ati drini ani. ",
