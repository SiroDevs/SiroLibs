              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’di ’diza e’do dika; azini Daudi efu ra, eri ’di a’di ’ba Filisi­tiaa ’diyi be, eri ofu yi azavuru, yi apa Daudisi apa apa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.8",
            "verseOrgIds": [
              "1SA.19.8"
            ]
          }
        },
