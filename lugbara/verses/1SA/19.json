                  "text": "29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Saulo o’bi Dau­dini ’dizu ajusi kpere abi ruaa; te eri ona i Saulo ma driliasi, ’dini aju so i abi ruaa toko. Daudi apa ra, nga i pa ini ’ dasi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.10",
            "verseOrgIds": [
              "1SA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
