        },
        {
          "text": "Te Nahasi ’ba Amoniari omvi e’yo yi tia kini, Ma nga aziza azi emi be kiri ma ka emi mileefi dri ndiari ope dria, ’dini drinza fezu Israeli dria dri beni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.11.2",
            "verseOrgIds": [
              "1SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
