                  "text": "Isa 19:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Orindi Yehovani ku Saulo­ni ra, azini orindi onzi engapi Yehova vuri ecandi erini. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ati’ba Saulo vile ’diyi ’yo eri ma tia, Mi ndre nga curu’do, orindi onzi engapi Mungu vuri mi ecandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Curu’do opi amani ma azi ati’ba ini ovupi i ma drilia ’diyi, yi ma nda ’ba ecopi o’di copi onduasiri; te eri nga eca ’dini, orindi onzi engapi Mungu vuri ka nga eca mi dria ra, ’ba nderi nga o’di co i ma drisi, mi nga ovu onyiru ani beni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Saulo ’yo ati’ba erini ma tia, Emi nda curu’do ma dri ’ba o’di copi onduasiri, emi eji eri ma vu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati’bo alu nga di e’yo omvi kini, Mi ne, ma ndre Yese ’ba Betelehemuari ma mvini, ’ba o’di copi onduasiri’i, ’ba okporu asi teza beri’i, azini ’ba ombaouni uri kokoruri, ’ba e’yo ’yopi efisiri, azini eri ’ba ndrizaru; azini Yehova ovu eri be. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Saulo pe di ’ba ti Yese vu, kini, Mi epe mani mi mvi Daudi kabilo ocepiri ma ti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yese nga di akanya ’du, enya pie, patiefi ma su kerea alu pie, ndrimva alu pie, pe yi ma ti Saulo dri Daudi be. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
