            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, yi ka emu ’bo, eri ’ba mile Eliabu vu, eri ’yo ra, Ada ’ba Yehovani odu driniari ovu i ma drilia ’do. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
