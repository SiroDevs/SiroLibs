                "loc": "GEN.41.46"
              },
              "items": [
                {
                  "text": "E’do 41:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.8"
              },
              "items": [
                {
                  "text": "1 Opi 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.29"
              },
              "items": [
                {
                  "text": "O’be 22:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi nga emu Saulo vu ra, so pa eri ma drilia; te Saulo le eri avasi tu, azini eri oja i ’ba afa suza ayaru ombani eriru ojipiriru. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dika Saulo pe ’ba ti Yese vu kini, Ma zi mi tia, mi ku Daudi ma so pa ma milia ani, a’disiku eri isu asi ndriza ma milia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.22",
            "verseOrgIds": [
              "1SA.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, orindi onzi engapi Mungu vuri ka eca Saulo ma dria ra, Daudi ’du o’di, co i ma drisi; ’dini Saulo ma asi emvi ra, eri eca onyiru, azini orindi onzi ku eri ra.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.23",
            "verseOrgIds": [
              "1SA.16.23"
            ]
          }
        }
