                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ovu asisile be onyiru Mungu vu, dini ’bani emi ru ’yoria onzi, drinza ma bi ani ’ba adriza emini onyiru Kristo ma aliari o’dapiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
