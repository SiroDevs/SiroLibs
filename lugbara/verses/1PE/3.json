          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri ovu agu emi asia e’dapi ku, i edepi onyiafa ecopi mapi kurisiri’i, onyiafa nderi eri orindi afu kokoru e’yere, ovupi Mungu ma milia afa aje be amboruri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te oku alatararu asi ’bapi Mungu dria asi tezasi ’diyi adri ndra yi ede ’dinile, agupi yi ma ngulupini ma e’yo inzizu, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
