        },
        {
          "text": "Edeza emini ma ovu edeza rua amvelerurini, kani dribi cazu, kani onyiafa meleru ’dini ’diyi osuzu, kani bongo suzu afusi, ’dini ku; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
