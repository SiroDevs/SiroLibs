              "items": [
                {
                  "text": "1 Pet 2:20-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi­ni candi isuzu e’yo onyiru emini ’yelerisiri, Mungu ka le ra, ovu onyiru aga emini candi isuzu e’yo onzi emini ’yelerisiri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
