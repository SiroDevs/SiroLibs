                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.3.17"
              },
              "items": [
                {
                  "text": "1 Sur 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.15"
              },
              "items": [
                {
                  "text": "6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eli iriri opi Darioni suru nya­zurisi, mba azia ma o’du okorisi, e’yo Yehovani nga eca geri nabi Hagai ma tiarisi Zerubabeli Sealitieli mvi, ambo ’ba dri cepi Yudaari mvu, eca indi Yosua Yehozadaki mvi, kuhani amboruri vu, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova asikari ongulumuruniri ’yo ’dini kini; ’Ba nde ’diyi ’yo ra kini, O’du amani ngazu emuzu, o’du nde amani Yehova ma jo sizuri ecani nga ’yeke ku. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.1"
              },
              "items": [
                {
                  "text": "Ezr 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Di ma vutia e’yo Yehovani nga di eca geri nabi Hagai ma tiarisi, ’yozu kini, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.3",
            "verseOrgIds": [
              "HAG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te o’du ’diri ovu ’yeke emi ma ngulu­pini adrizu jo emini mileni bile uru ci ’diyi ma alia, de jo ’diri ovu toko sikokoru ya? ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.4",
            "verseOrgIds": [
              "HAG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi curu’do Yehova asikari ongulumuruni ’yo ’dini: Emi dro asisile emini adriza emini ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.5",
            "verseOrgIds": [
              "HAG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ri ori amboru, te emi lo were; emi nya ra, te emi trani ku; emi mvu ra, te cani emi alia ku; emi bongo su ra, te rua emini drini aluni ku; ’ba oya a’ipiri eri oya a’i kiri suzu jurua eti lupi rari ma alia a’dule.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
