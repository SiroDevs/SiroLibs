              "type": "tag",
              "attrs": {
                "loc": "HAG.2.17"
              },
              "items": [
                {
                  "text": "Hag 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma omve vini etuka angu ezazu, oni pi ma dria, anya pie, patiefi ma su pie, odu pie, afa engapi nyakua ’diyi pie, ’ba pie, anyapa akua ’diyi pie, azi ’bani ngale yi drisiri pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        },
        {
