            }
          ]
        },
        {
          "text": "Hagai ojio Yehovani nga di e’yo Yehovani olu ’ba nde ma tia, kini, Ma ovu emi be ra, Yehova ’yo ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
