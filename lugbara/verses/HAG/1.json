            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dini e’yo emi­nisi ma oga ’buni andrali feko si, ma oga nyakuni efi ’yako si indi. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
