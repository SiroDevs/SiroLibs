          "items": [
            {
              "text": "\n        Ezr 4:24–5:2",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.14"
              },
              "items": [
                {
                  "text": "6:14",
