          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi olu curu’do Zerubabeli Sealitieli mvi, ambo ’ba dri cepi Yudaari pi ma tia, Yosua Yehozadaki mvi kuhani amboruri pie, ’ba acepi jolokoru ’diyi pie, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.2",
            "verseOrgIds": [
