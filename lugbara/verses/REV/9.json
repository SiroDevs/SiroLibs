                }
              ]
            }
          ]
        },
        {
          "text": "Malaika towiri vu guka ra, ma ndre ’bi’bio engapi ’bua e’depi va nyakuari ra, yi fe eri dri fungua ’bile asikokoru drataniri ma tileniri; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
