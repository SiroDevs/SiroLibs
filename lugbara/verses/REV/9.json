                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika aziari vu guka ra, te ma eri o’duko alu engazu pari edeta edezu meleru ovupi Mungu ma driliari ma o’yu su ’diyi ma eselia, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.13",
