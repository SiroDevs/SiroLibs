              "items": [
                {
                  "text": "Eceza 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’yozu malaika aziariru ovupi guka beri ma tia kini, Mi otru malaika su ovupi ombezaru yi ara amboru Ufira­ te ma tia ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.14",
            "verseOrgIds": [
              "REV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.7+REV.8.8+REV.8.9+REV.8.10+REV.8.11+REV.8.12"
              },
              "items": [
                {
                  "text": "Eceza 8:7-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi otru di malaika su edele ngonde etuni pi tezu, o’duni pie, mbani pie, elini pie dria ’diyi ra, yi ma ofu ani ’ba ma ese­le na ma azi aluri ra beni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.15",
            "verseOrgIds": [
              "REV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kala­fe ’ba ombani nzupi akanya dria ’diyini ovu alifu kali iri pale alifu mudri; ma eri kalafe yini ra. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.16",
            "verseOrgIds": [
              "REV.9.16"
            ]
          }
        },
        {
          "name": "verse",
