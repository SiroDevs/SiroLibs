            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wura ombini ovu ekile akanya edezaru ngonde ombasirile; afa ekile ekilaza meleru ’diyile ovu yi ma dria; andreti yini si yi ekile ’ba ma andre- ’tile, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.7",
            "verseOrgIds": [
              "REV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
