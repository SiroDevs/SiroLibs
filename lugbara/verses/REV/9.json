                "loc": "JOB.3.21"
              },
              "items": [
                {
                  "text": "Yob 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.3"
