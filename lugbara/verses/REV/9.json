        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.5"
              },
              "items": [
                {
                  "text": "Yoe 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ovu gombere pauru agatia ’diyi be ekile gombere pauru agatia ayaru ’diyile, yi ma opile ma awu ovu ekile gari ombani ma awule, akanya kakau­ni nzuria ombaarile; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.9",
            "verseOrgIds": [
              "REV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "sobi yini ovu ekile otunukua ma sobile, iri ’ba duzuri be, sobi yini ma alia yi ovu okpo be ’ba ezazu mba towi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.10",
            "verseOrgIds": [
              "REV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ovu malaika ’bile asikokoruniri be yi ma opiru; runi Ebrania tisi Abado­ni, te Giriki tisi Apolioni’i.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        }
      ]
    },
