                {
                  "text": "Yoe 1:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "dribi yini ovu ekile oku dribile, si yini ekile kami sile; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.8",
            "verseOrgIds": [
              "REV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
