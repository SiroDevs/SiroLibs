              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.30"
              },
              "items": [
                {
                  "text": "Luk 23:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du ’dayisi ’ba yi nga dra nda, te yi ngani eri isu aluni ku; yi nga dra le avasi, te drani nga apa yisi ra.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.6",
            "verseOrgIds": [
              "REV.9.6"
            ]
          }
        }
