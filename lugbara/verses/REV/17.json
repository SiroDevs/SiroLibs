              },
              "items": [
                {
                  "text": "Dan 7:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ’du ma Orindi alia jizu roko dria, ma ne Okuni riria nguru ekaru ma dria, nguru nderi ma rua ga tre ru Mungu o’dazu ’diyisi, eri dri be aziri, o’yu be mudri. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "verse",
