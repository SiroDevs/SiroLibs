                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "si ru eri andretia e’yo zizaru ’dini: BABULONI AMBO­RU, OKU AWUOURU ALI O’BAPI ’DIYI PI MA ANDRI E’YO NGULE ONZI NYAKUA ’DIYI BERI’I. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.24"
              },
              "items": [
                {
                  "text": "Eceza 18:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ne oku nderi ovu atizaru ’ba alatararu ’diyi ma arisi, azini ’ba Yesu ma e’yo eti nzepi ’diyi ma arisi indi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        }
      ]
