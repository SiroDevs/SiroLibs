                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri’i opi amboru nyakua ’diyini ndra ali o’bazu eri beri, ’ba ovupi nyakua ’diyini atizu patiefi ma su eri ma ali o’bazanirisiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        },
        {
