        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Eceza 13:1",
                  "type": "text"
                }
