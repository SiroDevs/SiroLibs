                  "text": "Eceza 6:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri’i eri nze e’yo Munguni pi ma eti, e’yo nzeza Yesu Kristoni be, ada afa dria erini ndrele ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
