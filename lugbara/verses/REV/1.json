        },
        {
          "text": "E’yo eceza Yesu Kristoni, Mu-nguni fele eri dri e’yo ngapi yi ’yepi mbele ndo ’diyi ecezu ati’ba erini ma tiari; eri pe tini malaika erini vurisi, e’yo nde ecezu ati’bo erini Yohana ma tia; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
