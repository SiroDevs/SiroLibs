          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ’wara ma azi alu omvi e’yo ma tia, kini, ’Ba osule afa suza izuru emverusi ’diyi a’di piyi ya, yi ibi enga ngole ya? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        },
