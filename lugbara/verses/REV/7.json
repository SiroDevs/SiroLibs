        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
