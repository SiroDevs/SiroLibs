                "loc": "REV.6.11"
              },
              "items": [
                {
                  "text": "Eceza 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’diyi ma vutia ma ndre ra, te mi ne, ’ba ongulumuru amboru ’ba alunini ecole lale ku, engapi suruti, dria pi ma eselia, suru dria pie, ’ba pie, ti ’yoza pie dria ’diyini pa soria oguna ma drilia azini Kabilomva ma drilia, suzaru afa suza izuru emvero­si, azini ndende be yi dria; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Eceza 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi oyu uru o’duko urusi kini, Pata eri Mungu amani ripi oguna driarini azini Kabilomvani! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.11"
              },
              "items": [
                {
                  "text": "Eceza 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.16"
              },
              "items": [
                {
                  "text": "11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika dria oso pa kuru oguna ma ageia, ’ba wara pie, anyapa idriru su ’diyi pie; nga di yi eco o’bukuru va oguna ma drilia Mungu inzizu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.11",
            "verseOrgIds": [
              "REV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kini, Amena! Asi ndriza pi, diza pie, ondua pie, awa’difo pie, inzita pie, okpo pie, okpo e’yo ’yezuri pie, ma ovu Mungu amani vu kpere ’dani ’dani! Amena.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
