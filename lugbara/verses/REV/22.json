            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma’i, Yohana, ma ’ba e’yo ’diyi eripiri azini ndrepiri. Mani eriria, mani ndreria, ma eco ma va malaika e’yo ’diyi ecepi ma driri ma palaa eri inzizu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.8",
            "verseOrgIds": [
              "REV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
