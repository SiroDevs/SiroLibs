                "loc": "ZEC.14.11"
              },
              "items": [
                {
                  "text": "Zek 14:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Otrita ngani ovu dika ’de: ku, te oguna Mungu pini Kabilomva beri nga ovu alenia; ati’ba erini yi nga azi nga eri inzizu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
