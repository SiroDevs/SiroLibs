            "number": "9",
            "style": "v",
            "sid": "REV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "te eri ’yo ma tia, Mi ’ye ’dini ku! Ma ovu ati’boni mile trotro azini adripi mini nabiru ’diyile, azini ’ba e’yo buku ’diri ma aliari ta mbapi ’diyile. Mi inzi Mungu’i.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
