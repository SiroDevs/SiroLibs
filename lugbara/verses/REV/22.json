                  "text": "12:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo ma tia, Mi ’ba eceta e’yo ondriza buku ’diri ma alia ’diyi ma dria tini ecizu ci ku, a’disiku ewuniri myia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
