                {
                  "text": "Eceza 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi nga mile erini ndre, eri ma runi nga ovu yi ma andretia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
