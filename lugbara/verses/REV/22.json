              "items": [
                {
                  "text": "1 Kor 14:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yo ma tia, E’yo ’diyi yi e’yo ’yole asi adasi, azini adaru ’diyi. Opi, Mungu nabi ma orindiniri, epe malaika erini ma ti e’yo ngapi yi ’yepi mbele ’diyi ecezu ati’ba erini ma tia.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
