                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ece ma dri yi ara idrini, mile be alatararu glasile, efupi oguna Mungu pini ma alia Kabilo­mva beria, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
