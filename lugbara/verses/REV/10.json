            "number": "2",
            "style": "v",
            "sid": "REV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ma dria buku gaaru ovu zizaru. Eri ’ba i pa dri ndiari miri dria, dri ejiari nyaku dria, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.2",
            "verseOrgIds": [
              "REV.10.2"
            ]
          }
        },
