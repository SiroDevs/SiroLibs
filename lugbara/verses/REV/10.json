                  "text": "Eze 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.1+EZK.3.2+EZK.3.3"
              },
              "items": [
                {
                  "text": "3:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma mu di malaika vu ani, ma ’yo eri tia eri ma fe ma dri buku gaaru nderi, Eri ’yo ma tia, Mi ’du eri, nya; eri nga asi mini ’ba drazaru, te mi tilia eri nga ovu aluzaru anyule. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga di buku gaaru nderi ’du malaika ma dria, ma nya eri ra; eri ovu ma tilia aluzaru anyule, te ma ka eri nya ’bo, eri ’ba ma asi drazaru, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
