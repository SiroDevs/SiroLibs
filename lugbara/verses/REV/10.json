            }
          ]
        },
        {
          "text": "eri tre o’duko urusi ekile kamini onolerile; ka tre ’bo, angu liza aziri ’diyi oli yi ma o’dukosi oli oli. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
