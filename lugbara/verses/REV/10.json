          "items": [
            {
              "text": "\n        Eze 2:8–3:3\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eri o’duko teka mani erile ’buarini e’yo ’yoria ma be dika kini, Mi mu, mi ’du buku ovupi zizaruri malaika pa sopi miri ma dria nyaku beri ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
