                }
              ]
            }
          ]
        },
        {
          "text": "Ma ndre malaika azini okpo berini esiria ’buarisi va, su iriti i ma ruaa bongole, gari ago i eri ma dria uruleru, andretini etule, pani ekile ad pa sopi piriru ’diyile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.1",
            "verseOrgIds": [
              "REV.10.1"
            ]
          }
        },
        {
          "name": "verse",
