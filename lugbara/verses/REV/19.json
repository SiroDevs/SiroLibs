                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Si ru bongo erini ma ruaa, azini eri ma opilia ’dini, MELEKI MELEKINI AZINI OPI OPINI. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
