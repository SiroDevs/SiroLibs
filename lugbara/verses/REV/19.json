                "loc": "REV.16.16"
              },
              "items": [
                {
                  "text": "Eceza 16:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ndre nguru nderi, opi nyakua ’diyi pie, asikari ongulumuru yini be, oku yi tualu a’di ’dizu ’ba ripi akanya driari be, asikari ongulumuru erini pie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.19",
            "verseOrgIds": [
              "REV.19.19"
            ]
          }
        },
