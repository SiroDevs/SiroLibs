                "loc": "REV.17.14"
              },
              "items": [
                {
                  "text": "Eceza 17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Asikari ongulumu­ru ’bua, ripi akanya emveru ma dria, bongo mile be nyiriari emveru azini alaru supi yi ruaa ’diyi bi vutini. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.14",
