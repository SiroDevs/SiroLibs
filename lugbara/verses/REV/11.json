              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga okpo fe ’ba mani e’yo eti nzepi iri ’diyi dri, yi nga e’yo ondri o’du alifu alu drini turu iri drini kali azia, koliba be yi ma ruaa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
