                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ami Benyaminini nga ’ye ’dinile, yi o’du yi yi ma okuru, kalafe yini vusi, ’ba ongo tupi ’diyi ma eselia; yi mu ra, mvi awuruso yinia, si aku ambo ambo ’diyi ra, ovu yi ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.23",
            "verseOrgIds": [
              "JDG.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
