                }
              ]
            }
          ]
        },
        {
          "text": "’Ba nde nga di emu Betelia, ri ’dale kpere ondresi Mungu ma milia, yi enga yi ma o’duko uru wuzu okposi tu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.2",
            "verseOrgIds": [
              "JDG.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ’yo ra, Yehova la, Mungu Israeliniri, e’yo ’di eca Israelia ngoni ngoni ya, kini andru suru alu Israeli ma eselia avi ra? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.3",
            "verseOrgIds": [
              "JDG.21.3"
            ]
          }
        },
