                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ongulumuru nga ’ba okporu tu ’diyi ma azi alifu mudri drini iri ma ti pe ’dale, azi yi tia kini, Emi mu, emi ofu ’ba ovupi angu Yabesi­gileadia ’diyi sei ma sisi; oku yini pie, anzi nyiri nyiri ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.10",
            "verseOrgIds": [
              "JDG.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 21:11"
          },
          "items": [
