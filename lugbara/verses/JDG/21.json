                }
              ]
            }
          ]
        },
        {
          "text": "Te yi isu ’ba ovupi Yabesi-gileadia ’diyi ma eselia ezoanzi aliriaru nga agupi nipi ku, lapi nga agupi be ku ’diyi turu su; yi nga yi eji pari yini hema asozuria kpere Silo angu Kananinia­ria. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.12",
            "verseOrgIds": [
              "JDG.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
