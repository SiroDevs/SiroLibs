                  "text": "Kal 31:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga afa ’diri ’ye’i; emi nga agupi piyi dri ja teketeke, oku dria mupi agupia ’bo ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.11",
            "verseOrgIds": [
              "JDG.21.11"
            ]
          }
        },
