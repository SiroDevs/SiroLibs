                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.13"
              },
              "items": [
                {
                  "text": "Yer 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te kiri emi ku ma ra, emi nga azi Mungu andini ’diyi dri; e’yo ’disi ma ngani emi opa dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.13",
            "verseOrgIds": [
              "JDG.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.3.13"
              },
              "items": [
                {
                  "text": "2 Opi 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi mu wu adrou emini pele emi dri ’bo ’diyi vu; yi ma opa emi etu candi emini ma aliani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.14",
            "verseOrgIds": [
              "JDG.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.18"
              },
              "items": [
                {
                  "text": "1 Sam 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te anzi Israelini yi ’yo di Yehova nde ma tia, Ama ’ye onzi; mi ’ye di ama be ekile e’yo dria ovupi onyiru mi ma miliarile; te kiri mi opa ama o’du ’disi fo, ama zi mi tia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
              "JDG.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.7.14"
              },
              "items": [
                {
                  "text": "2 Sur 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.44"
              },
              "items": [
                {
                  "text": "Zab 106:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga adrou ndu ndu ’diyi onze yi ma eseliarisi amve ra, yi nga azi Yehova dri; te asi erini nga ndra ota candi Israelinisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
