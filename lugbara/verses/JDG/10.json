        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.10"
              },
              "items": [
                {
                  "text": "Lip 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.14"
              },
              "items": [
                {
                  "text": "Azi 3:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu de eri ovu ndra anzi be kali na, nzupi akanya kariaru kali na ’diyi ma dria ’diyi; yi ovu ndra aku ambo ambo be kali na, yini omvele Havoti-yairi kpere o’du ’disi ’diyi, yi angu Gileadinia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.4",
            "verseOrgIds": [
              "JDG.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yairi dra di ra, sa eri Kamonia.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        }
