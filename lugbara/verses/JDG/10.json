              "items": [
                {
                  "text": "Azi 32:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.12"
              },
              "items": [
                {
                  "text": "Lip 2:12",
