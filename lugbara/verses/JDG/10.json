                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Zidonini piyi inza ndra emi, ’ba Amalekini pie, ’ba Maonini pie ra; te emi owu ndra ani ma vu, ma opa ndra ani emi yi ma dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.12",
            "verseOrgIds": [
              "JDG.10.12"
            ]
          }
        },
        {
