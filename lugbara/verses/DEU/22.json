                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ka’dini emi ma eji yi iri tro aku nde ma kalitilea, emi ma o’be yi onisi kai ra, aliria nderi de vini eri aku amboru ma alia ti, erini lulu gale kurisi, azini agupi nderi erini drinza fele i agyi ma oku dririsi; mi ma nze e’yo onzi emi eseliarisi ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        },
        {
