                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ka zamva aliriaru aguni e’dole jele ’bori isu aku amboru alia, ka la erisi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
