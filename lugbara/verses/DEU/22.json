                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agu azini ka zamva nga i isupi agupi be ku, ’bani e’dole nga jele kuri isu, ka eri bi ra, ka la erisi, ’ba azini ka yi isu ra, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
