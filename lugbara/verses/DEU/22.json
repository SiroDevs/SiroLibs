        {
          "text": "Mi ka aria jorovu isu mi drilia geria, patisia kani nyakua, anzi be kani gbe be alenia, azini andri avu anzi dria kani gbe ma dria, mi ma omvu andri pi tualu anzi be ku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.6",
            "verseOrgIds": [
              "DEU.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 22:7"
          },
          "items": [
            {
              "text": "7",
