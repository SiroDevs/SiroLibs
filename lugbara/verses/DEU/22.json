                  "text": "11:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ri ori suruti iri amvu zabibuni miniri ma alia ku, ’ba kazu afa kapi ’diyi opazu dria ku, ori mini rileri pi efi kaza zabibuni be iri tro. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 22:10"
          },
          "items": [
