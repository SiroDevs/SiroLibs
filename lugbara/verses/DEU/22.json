        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.14+2CO.6.15+2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Kor 6:14-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma fe ti pi akanya be ma se e’bu amvu ’yazu tualu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.10",
            "verseOrgIds": [
              "DEU.22.10"
            ]
          }
        },
        {
