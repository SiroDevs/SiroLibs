                  "text": "Lev 19:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma su bongo cale osazaru kabilo ’biko pisi pamba beri ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
