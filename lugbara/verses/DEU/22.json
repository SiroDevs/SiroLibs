              "items": [
                {
                  "text": "Mat 23:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ede bongo mini mi rua a’buzuri ma kalati su ’diyi ma ti ma ovu yaliyaliru.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        }
