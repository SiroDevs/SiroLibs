            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi mi ma le Yehova Mungu miniri avasi, ma mba e’yo erini azileri ma ta, e’yo aziza erini ’diyi pie, e’yo liza erini ’diyi pie, azita erini ’diyi pie ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andru emi ma ni ’di: a’disiku ma ’yoni di emi ma anzi e’yo nde nipi ku ’diyi ma tia ku, anzi nde ’diyi ndreni imbata acoasi Yehova Mungu emini­riniri pi ma e’yo ku, ambo eriniri pie, dri okporu eriniri pie, wu emi ejuzaruri pie, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Efu 7:8–12:13",
              "type": "text"
            }
          ]
        },
        {
          "text": "eceta erini ’diyi pie, ’yeta erini erini ndra ’yele Misiria Farau opi Misiriari pi ma ruaa angu erini be dria ’diyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.3",
            "verseOrgIds": [
              "DEU.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 11:4"
          },
          "items": [
