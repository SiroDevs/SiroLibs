              "items": [
                {
                  "text": "Zek 14:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te angu mini ’yezu fizu alenia eri ’duzu miniruri ovuni ekile angu Misiri eminiibizu efuzueri ma aliarile ku, pari ndra mini ori mini rizu, fezu yini i dazu drinia mi pasi, ekile amvu tibinirile; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.10",
            "verseOrgIds": [
              "DEU.11.10"
