        },
        {
          "text": "ndreni vini e’yo erini ’yele ndra Eliabu Rubeni mvi ma anzipi Datani pi ma ruaa Abiramu beri ku, nyakuni i tile azizu yi okizu pi pi, ori’ba yini ’diyi pie, hema yini ’diyi pie, afa idriru yi ma vuti bipi ’diyi pie dria, Israeli dria ma eselia; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.6",
            "verseOrgIds": [
              "DEU.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "te emi’i, emi ndre ’yeta amboru Yehovani ’yele ndrari dria emi milesi ra.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        }
