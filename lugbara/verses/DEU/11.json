              },
              "items": [
                {
                  "text": "Efu 14:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ndreni e’yo erini ’yele ndra asikari ongulumuru Misiria ’diyi ma ruaa, akanya yini pie, gari yini ombani ’diyi pieri ku; erini ndra fezu yi Miri Ekarurini yi a’buzu yini emi vuti droria, erini yi dri jazu ecazu kpere: o’du andru ’dorisi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndreni e’yo erini ’yele ndra emi dri roko dria, cazu emini firia pari ’dori ma aliari ku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.5",
            "verseOrgIds": [
              "DEU.11.5"
            ]
          }
        },
