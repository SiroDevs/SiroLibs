              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te emi ’ye Yoridanini zo, muzu fizu angu Yehova Mungu eminirini fele emi driri ma alia, eri ’duzu eminiru; emi nga eri ’du ra, nga ri alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
