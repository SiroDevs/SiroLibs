              "items": [
                {
                  "text": "O’be 22:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.10"
              },
              "items": [
                {
                  "text": "Hos 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awuruso mini ngale isule angu Yehova Mungu minirini fele mi dri ovuzu miniru ma aliaria, mi ma nze ’ba mi aku ejeleari ma alo angu awazu ’ba oku ’diyini dileri aluni ku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
