                "loc": "1KI.21.13"
              },
              "items": [
                {
                  "text": "1 Opi 21:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba e’yo eti nzepi inzosiri ka enga asu suzu ’ba azini ma ruaa e’yo onzi ma e’yosi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka­’dini ’ba e’yo be yi eselia ’diyi ma so pa iri tro Yehova ma drilia, kuhani pi ma milia ’ba e’yo lipi ewu nderisi ’diyi be; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba e’yo lipi ’diyi ma nda e’yoni asi driasi, te mi ndre, ’ba e’yo eti nzepiri ka ovu ’ba e’yo eti nzepi inzosiri, ka e’yo eti nze inzoru i adri ma ruaa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
