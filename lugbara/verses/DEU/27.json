            "number": "7",
            "style": "v",
            "sid": "DEU 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mi ma ede vini edeta asi anzuruni ’diyi, nyazu ’daa; mi ma ovu ayikosi Yehova Mungu miniri ma drilia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.7",
            "verseOrgIds": [
              "DEU.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.2"
              },
              "items": [
                {
                  "text": "Hab 2:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma si azita ’dori ma e’yo dria oni nde ’diyi ma ruaa kililiru, ma e’da ce. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa pi ’ba Levini kuhaniru ’diyi be nga ’yo Israeli dria ma tia kini, Emi ovu ciri, emi eri fo, emi Israeli la: o’du andru ’dorisi mi ofu Yehova Mungu miniri ma ’baru ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.9",
            "verseOrgIds": [
              "DEU.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi mi ma eri Yehova Mungu miniri ma ti, azita erini piyi ’yezu e’yo aziza erini ’diyi be, mani azile mi dri o’du andru ’dorisi ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        }
      ]
    },
