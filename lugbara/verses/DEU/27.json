                  "text": "Lip 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diyi nga pa oso oni Gerizimu ma dria asi ndriza fezu ’ba dri, emini Yoridanini zozu ’boria: Simeoni pi, Levi pi, Yuda pi, Isakari pi, Yusufu pi, Benyamini pie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’doyi nga pa oso oni Ebali ma dria ’ba otrizu: Rubeni pi, Gadi pi, Aseri pi, Zebu­luni pi, Dani pi, Nafutali pie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
