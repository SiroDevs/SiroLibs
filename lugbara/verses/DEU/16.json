        {
          "text": "’Ba ma ndre akufi mi vu angu mini ma eselia dria o’du aziri ku; azini edeta mini edele o’du okori ma ondresiri ma za ma joloko ma la rra cazu o’bitisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        },
