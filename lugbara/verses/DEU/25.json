              "items": [
                {
                  "text": "Mat 10:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ovu ’dini, ’ba onzi ma e’yo ka i si eri cozu ra, ’ba e’yo lipiri ma fe eri ma la va, ma co eri eri ma milia ’de, kalafe eri cozuri ma ovu e’yo onzi erini vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
