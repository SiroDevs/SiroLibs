          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agupi ka yi ofu yi eselia, te aluri ma oku ka esi agupi ini pazu ’ba eri copiri ma dria, ka i dri eju ari’ba ma elo bizu sezu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
