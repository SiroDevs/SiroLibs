                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eco eri cozaru kali su, te ma aga ’diri ku; mi adri kazu ovuzu afa tokole mi milia ku, eri ka eri co kakau aga ’diyi raria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        },
