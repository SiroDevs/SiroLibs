                  "text": "Mik 6:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ovu ratili ndu ndu be jurua mini ma alia, aluri amboru, aziniri ganaru, ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
