              "items": [
                {
                  "text": "1 Tim 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga eri ma ru omve Israeli ma eselia, Jo ’ba yini katala truzuriniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        },
        {
