          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ma ovu afazu afa o’bizu ndu ndu be mi ma joa, aluri amboru, aziniri ganaro, ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
