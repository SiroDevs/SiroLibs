              "items": [
                {
                  "text": "Rut 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.20.2"
              },
              "items": [
                {
                  "text": "Isa 20:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ka’dini adri ma oku ma mu vunia ’ba ’wara ma milia, ma tru katala eri ma paari, ma wu cucu eri ma andretia; ma omvi e’yo, ma ’yo kini, Ma ’ye ’ba i adri ma jo sipi kuri dri ’dini, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
