              "items": [
                {
                  "text": "Yos 1:12-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ewu nderisi ma azi ndra emi tia kini, Yehova Mungu emini fe emi dri angu ’diri nyazu eminiru ’bo; emi nga zo, afa ombani be emi ruaa, adri­pi emini anzi Israelini ’diyi ma drilia, emi ’ba ombani ’diyi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
