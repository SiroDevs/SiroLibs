              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te oku emini piyi nga awu nga aku ambo ambo emini mani fele emi dri ’bo ’diyi ma alia ’de, anzi emini pie, anyapa emini pie (ma ni emi anyapa be tre), ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
