                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova la, mi wu ’ba mini Israelini mini onzele ’bo ’diyi ma e’yo onzi fo, mi ku ’ba e’yo kokoruri ma ari ma ri ovu Israeli ma eselia ’dani ku. Te ari nderi nga ovu wuzaru ani yi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.8",
            "verseOrgIds": [
              "DEU.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.13"
              },
              "items": [
                {
                  "text": "Azi 19:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma nze ’ba e’yo kokoruri ma ari mi ma eseliasi ’dini, mi ka e’yo ovupi onyiru Yehova ma miliari ’ye ra.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.9",
            "verseOrgIds": [
              "DEU.21.9"
            ]
          }
        }
      ]
