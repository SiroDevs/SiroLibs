                {
                  "text": "E’do 34:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.19.24"
              },
              "items": [
                {
                  "text": "Lip 19:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ovu ’dini, ka mi dri ayiko fe ku, mi ku eri ma mu ini lelerile; te mi ma fe eri je silingisi aluni ku, mi ma ’ye eri vu ekile ati’bole ku, mini drinza fele eri dririsi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.14",
            "verseOrgIds": [
              "DEU.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
