                {
                  "text": "2 Sam 3:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi ma omvi e’yo kini, Dri amani adani ari ’dirini ku, ama ndre­ni vini eri ama milesi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.7",
