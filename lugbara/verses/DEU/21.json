              "items": [
                {
                  "text": "E’do 29:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azini ka ovu oku be iri, aluri erini leleri’i, aziniri erini nguleri’i, te leleri azini nguleri iri tro oti anzi eri dri ra; te mva osipi oko ka ovu ngule rarini, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.15",
            "verseOrgIds": [
              "DEU.21.15"
            ]
          }
        },
        {
