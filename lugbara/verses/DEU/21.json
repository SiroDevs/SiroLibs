                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ka fu mu a’di ’dizu ari’ba mini be, Yehova Mungu miniri ka nga yi fe mi dria, mi ka nga yi o’i ji ati’baru, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.10",
            "verseOrgIds": [
              "DEU.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
