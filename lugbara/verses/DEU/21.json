                "loc": "PSA.45.10"
              },
              "items": [
                {
                  "text": "Zab 45:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma tru bongo ati’boni eri ruaari ra, ma wu i ati pi ma imvosi andri be mba alu pi; ’di ma vutia mi eco fizaru eri vu, ovuzu agupi erini, eri ma ovu oku miniru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.21.13",
            "verseOrgIds": [
              "DEU.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
