        {
          "text": "Yehova Mungu miniri nga mi adripi ma azi alu fe engazu nabiru mi dri mi eselia ekile male--emi ma co bile eri vu- ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
