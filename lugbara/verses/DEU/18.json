                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.29"
              },
              "items": [
                {
                  "text": "Azi 12:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ka nga fi angu Yehova ’Mungu minirini fele mi driri ma alia ’bo, e’yo ngule onzi suru ’dayini adrile ’yele ’diyi, mi ma oni yi ’yezu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.26"
              },
              "items": [
                {
                  "text": "Lev 19:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.18"
              },
              "items": [
                {
                  "text": "Efu 22:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ma isu emi eselia ’ba i mvini kani i zini fepi agazu aci alesiri pi aluni ku, ’ba acife ndripiri pie, ’ba andri ndripiri pie, ’ba ’ba enapi enatasiri pie, oleou pie, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.10",
            "verseOrgIds": [
              "DEU.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.31"
              },
              "items": [
                {
                  "text": "Lev 19:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba ori owipiri pie, ojoou adrou ma o’duko zipiri pie, ojoou pie, ojoou e’yo zipi ’ba draza ma tiari pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.11",
            "verseOrgIds": [
              "DEU.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.24"
              },
              "items": [
                {
                  "text": "Lev 18:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ’ba dria alu alu e’yo ’diyi ’yepi ’diyi ovu afa ngule onziriru Yehova dri; azini e’yo ngule onzi ’diyi ma e’yosi Yehovani yi odro emi driliasi ’di. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.48"
              },
              "items": [
                {
                  "text": "Mat 5:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.1"
              },
              "items": [
                {
                  "text": "E’do 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ovu ezata kokoru Mungu miniri ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.13",
            "verseOrgIds": [
              "DEU.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.6"
              },
              "items": [
                {
                  "text": "2 Opi 21:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te suru mini ngale yi ma angu nyale ’diyi adri yi bile co ’ba andri ndripi ’diyi pi vu ’ba acife ndripi ’diyi be; te mi’i, Yehova Mungu miniri a’ini mini ’yezu ’dinini ku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.14",
            "verseOrgIds": [
              "DEU.18.14"
            ]
          }
        }
      ]
