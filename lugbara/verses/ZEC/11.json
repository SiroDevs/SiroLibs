              "type": "text"
            }
          ]
        },
        {
          "text": "Mi zi jotile mini, Lebanoni la, ’dini aci ma nya mario pati mini ’diyi beni!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
