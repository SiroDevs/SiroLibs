              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mungu mani ’yo ’dini: Mi fe nyaka kabilo o’biru yini ngale olile oli ’diyi dri; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
        },
