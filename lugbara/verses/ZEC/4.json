                "loc": "DAN.8.18"
              },
              "items": [
                {
                  "text": "Dan 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika nde e’yo ’yopi ma beri nga emu dika, nga ma oro, kile ’ba ’bani orule o’duasirile. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.1",
            "verseOrgIds": [
              "ZEC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31"
              },
              "items": [
                {
                  "text": "Efu 25:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "Eceza 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo ma tia, Mi ndre a’di afani ya? Ma ’yo, Ma ndre ra, mi ne, eri tala pati ruani dria meleru, kopo erini pie drinia, tala erini aziri ’diyi be; tala nde ’diyi ma baka ale be huru ’diyi aziri indi tala alu alu ovupi drinia ’diyi vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.2",
            "verseOrgIds": [
              "ZEC.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.4"
              },
              "items": [
                {
                  "text": "Eceza 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini mizeitu pati iri ageinia, alu kopo ma dri ndiria, aziniri eri ma dri ejiria. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.3",
            "verseOrgIds": [
              "ZEC.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nga e’yo omvi ’yo malaika e’yo ’yopi ma beri ma tia kini, Opi mani la! afa ’diyi a’di afani ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.4",
            "verseOrgIds": [
              "ZEC.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika nde e’yo ’yopi ma beri nga di e’yo omvi ’yo ma tia kini, Mi nini afa ’diyi a’di afani yari ku? Ma ’yo ra, Yo, opi mani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.2"
              },
              "items": [
                {
                  "text": "Ezr 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eci nga di e’yo omvi ’yo ma tia kini, ’Diri e’yo Yehovani ’yole Zerubabeli ma tiari, kini: Asikari ma okposi ku, kani okpo ruanisi ku, te Orindi manisi, Yehova asikari ongulumuruniri ’yoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.6",
            "verseOrgIds": [
              "ZEC.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.3"
              },
              "items": [
                {
                  "text": "Isa 40:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.21"
              },
              "items": [
                {
                  "text": "Mat 21:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.22"
              },
              "items": [
                {
                  "text": "Zab 118:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.11"
              },
              "items": [
                {
                  "text": "Ezr 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi a’di’i ya, oni amboruri la? Mi nga mi oja angu senderu Zerubabeli ma drilia; azini eri nga oni drini ecipi tualuri eji oyuzu kini, Asi anzuru, asi anzuru eri vu! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.7",
            "verseOrgIds": [
              "ZEC.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dinile vini indi e’yo Yehovani eca ma vu kini, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.8",
            "verseOrgIds": [
              "ZEC.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.15"
              },
              "items": [
                {
                  "text": "Ezr 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.4"
              },
              "items": [
                {
                  "text": "1 Kor 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zeru­babeli ma dri ’ba jo ’diri ma eti ’bo; eri ma drini nga eri denio Mi nga di ni ani kini Yehova asikari ongulumuruni epe ma ti mi vuni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.9",
            "verseOrgIds": [
              "ZEC.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.3"
              },
              "items": [
                {
                  "text": "Hag 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.9"
              },
              "items": [
                {
                  "text": "2 Sur 16:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.6"
              },
              "items": [
                {
                  "text": "Eceza 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’di onzo ani o’du afa were ’diyinini ya? te yi nga ovu ayikosi, yi nga baka jo abi o’bizuri ndre Zerubabeli ma dria ra. Te afa teka aziri ’diyi yi mile Yehovani, onzupi ’dole ’dale wudri­kuru dria ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.4"
              },
              "items": [
                {
                  "text": "Eceza 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga di e’yo omvi, ’yo tinia kini, Mizeitu pati iri tala pati ma kala dri ndiria azini dri ejiria ’diyi a’di afani ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma omvi e’yo tinia pale iririsi kini, Mizeitu pati arakala iri ovupi tala ma ti meleru ’diyi ma kalaa, odu meleru yi ma aliari osupi ’diyi a’di afani ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga di e’yo omvi ma tia kini, Mi nini afa ’diyi a’di afani yari ku ya? Ma kini, Opimanila,maninikufo! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga di ’yo ani, ’Diyi ’ba iri odu osuzu yi ma dria pa sopi Opi wudrikuruniri ma ageia ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.14",
            "verseOrgIds": [
              "ZEC.4.14"
            ]
          }
        }
      ]
    }
  ],
