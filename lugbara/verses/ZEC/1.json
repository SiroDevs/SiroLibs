              "type": "tag",
              "attrs": {
                "loc": "ZEC.7.5"
              },
              "items": [
                {
                  "text": "Zek 7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika Yehovani nga di e’yo omvi kini, Yehova asikari ongulumuruni la! mi ngani ovu yikisi Yerusalemu pi vu aku ambo ambo Yudaa ’diyi be ku ewu ngopi ya, mini ovuzu yi be adrasi eli kali aziri ’dipi ’dini? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.1"
              },
              "items": [
                {
                  "text": "Isa 40:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.2"
              },
              "items": [
                {
                  "text": "2",
