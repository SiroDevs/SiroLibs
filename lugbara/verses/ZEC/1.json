              "type": "text"
            }
          ]
        },
        {
          "text": "Mba mudri drini aluri ma mbao’du kali iri drini susi, eri mba Sebati’i, eli iri Darioni opi nyazuri ma alia, e’yo Yehovani eca nabi Zekaria Berekia Ido mvi ma mvi vu, kini, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 1:8"
          },
          "items": [
