            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "Yer 29:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova nga malaika e’yo ’yopi ma beri ma tia e’yo omvi onyiru, ada e’yo ’ba asi omipi ra ’dini ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.18"
              },
              "items": [
                {
                  "text": "Yoe 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.2"
              },
              "items": [
                {
                  "text": "Zek 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dinile malaika nde e’yo ’yopi ma beci ’yo ma tia, Mi oyu uru kini, Yehova asikari ongulumuruni ’yo ’dini: Ma ovu a’yasi Yerusalemu pi ma e’yosi Zioni be, a’ya amborusi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.6"
              },
              "items": [
                {
                  "text": "Isa 47:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ovu aokosi tu suru ava lipi ’diyi be; a’disiku ma ka ndra ovu aokosi were te yi ere candi nde drile ’drile. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
            "verseOrgIds": [
              "ZEC.1.15"
            ]
          }
        },
