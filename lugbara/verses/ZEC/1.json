          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ovu ndra emi a’bipi vu aokosi tu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
