              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Isa 55:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.1.18"
              },
              "items": [
                {
                  "text": "Imv 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo mani suzini azita mani, mani azile ati’ba mani nabiru ’diyi ma tiari, yi isuni ndra emi a’bipi yi ku ya? Te yi oja yi ra, nga ’yo kini, Kile Yehova asikari ongulumuruni egale ’yezu ama vu, geri amani vusi, azini ’yeta amani vusirile, eri ’ye ama be ’dinile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
