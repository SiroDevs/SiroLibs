              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.13"
              },
              "items": [
                {
                  "text": "Yos 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.2"
              },
              "items": [
                {
                  "text": "Zek 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.2+REV.6.3+REV.6.4"
              },
              "items": [
                {
                  "text": "Eceza 6:2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ndre inisi, te mi ne, ’ba alu nzu akanya ekaru ma dria, so pa pati icifi malaru ovupi e’bu etia ’diyi ma eselia; eri ma vutia akanya yi indi, ekaru, warawararu, azini emveru. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.8",
            "verseOrgIds": [
              "ZEC.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’yo di ani, Opi mani la! ’diyi a’dini ya? Te malaika e’yo ’yopi ma beri kini, Ma nga mini yi a’dini yari ece ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.11"
              },
              "items": [
                {
                  "text": "Zab 91:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.1.14"
              },
              "items": [
                {
                  "text": "Ebra 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba pa sopi mala pati ’diyi ma eseliari nga e’yo omvi ani kini, ’Diyi yi ’ba Yehovani ti epele acizu ’dale ’dole nyaku ma eselia ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.102.20"
              },
              "items": [
                {
                  "text": "Zab 102:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga e’yo omvi malaika pa sopi mala pati ’diyi ma eseliari ma tia kini, Ama aci ’dale ’dole nyaku ma eselia dria ’bo, te mi ne, nyaku dria adri ndi, eri ava li. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
