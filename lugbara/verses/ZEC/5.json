              },
              "items": [
                {
                  "text": "Ebra 6:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Yo ma tia ’dini kini, ’Di trita efupi wudrikuru ma dri ’depi piri’i; ’dini enyiriko ma woko alurini ’yolerile ’ba dria alu alu ogu ogupiri nga dri jani, te woko azinirini ’yolerile ’ba dria alu alu oyo sopi nga dri jani. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.3",
            "verseOrgIds": [
              "ZEC.5.3"
            ]
          }
        },
        {
