              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma enga vini ma mile uru dika, ma ndre, mi ne, enyiriko trale trari sa ’bua! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.1",
            "verseOrgIds": [
              "ZEC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo ma tia, Mi a’du ndre ya? ’Dini ma omvi kini, Ma enyiriko trale trari ndre saja ’bua; oconi wuale kali iri, walani wuale mudri. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 5:3"
          },
          "items": [
