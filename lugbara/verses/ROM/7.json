                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka’dini ama a’di ’yo ya? Azita eri e’yo onzini ya? Yo, aluni yo! Te ma nini ndra e’yo onzi ku, azita ka ndra eri ece ku. Te ma nini ndra li ku, azita ka ’yo kuria, Mi ’ba li ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.13"
              },
              "items": [
                {
                  "text": "Rum 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo onzi isu geri azita alia ma bizu, eri fe ava onzi dria enga ma alia. Azita ka ovu yo, e’yo onzi ovu avuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.8",
            "verseOrgIds": [
              "ROM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andra ma ovu idriro azitani ovuzu yoria, te azita ka eca ra e’yo onzi enga di ra, te ma’i ma dra ra; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.9",
            "verseOrgIds": [
              "ROM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.15"
              },
              "items": [
                {
                  "text": "Yak 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Lev 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te azita nde idri ejipiri, ma vuni eji dratani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.10",
            "verseOrgIds": [
              "ROM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.13"
              },
              "items": [
                {
                  "text": "E’do 3:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo onzi eri isu geri azita nderisi, eri ici ma ra, fu ma ani erisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.11",
            "verseOrgIds": [
              "ROM.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.8"
              },
              "items": [
                {
                  "text": "1 Tim 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awa’dini, azita eri ovu alatararu, dika e’yo dria alu alu azitani ’yole ’diyi yi alaru, azini kililiru, azini onyiru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        }
      ]
    },
