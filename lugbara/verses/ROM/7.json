                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekile ’dirile, ma adripi, emi indi emi dra ndra azita vusi geri rua Kristonisi, ’dini emi eco ovuzu azinini, eri Kristo Munguni engale ’ba draza eseliari’i, ’dini emi eco ori tizaru Mungu dri ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.4",
            "verseOrgIds": [
              "ROM.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.21"
              },
              "items": [
                {
                  "text": "Rum 6:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te amani mira ovuria e’yo ruani ma alia, ava; e’yo onzini ovupi azitasi ’diyi ’ye ndra azi okposi ama rua ma esele ndu ndu ’diyi ma alia, fezu amani ori tizu dratani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.5",
            "verseOrgIds": [
              "ROM.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 7:6"
          },
          "items": [
