            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do onze ama azita ma aliasi ’bo, ama dra e’yo ndra ama ombepiri vusi ’bo, ama ma nga di azi ati’baru e’yo o’diru orindirisi, e’yo oku azita sizarurisi ku.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.6",
            "verseOrgIds": [
              "ROM.7.6"
            ]
          }
        }
      ]
