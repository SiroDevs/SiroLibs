            }
          ]
        },
        {
          "text": "’Dini ma isu azita ’diri, mani leria e’yo onyiru ’yeria, e’yo onzi ovu de ma be ci. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.21",
