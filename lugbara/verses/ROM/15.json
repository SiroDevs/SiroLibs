            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.30"
              },
              "items": [
                {
                  "text": "Rum 11:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini vini indi ’ba suru azini dria ma fe diza Mungu dri yiki erinirisi. Ekile erini ovule sizarurile, E’yo ’disi ma nga inzita fe mi dri suru dria ma eselia, ma nga ongo ngo ru mini inzizu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
