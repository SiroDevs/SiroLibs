                "loc": "2CO.10.15"
              },
              "items": [
                {
                  "text": "2 Kor 10:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ava ovupi ma asiari eri ’di’i, e’yo bari oluzu pari yini ru Kristoni oluzu nga kuria, ’dini ma ma si jo ’ba azini vile jo nduri ma dria ku, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
              "ROM.15.20"
            ]
          }
        },
        {
