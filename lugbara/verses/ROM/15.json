          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ma emu emi vu ayikosi Munguni lelerile, ma isu okpo o’diru ava lizu emi be ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
