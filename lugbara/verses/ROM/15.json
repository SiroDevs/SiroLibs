              "type": "text"
            }
          ]
        },
        {
          "text": "eri ma pa ma ’ba e’yo ’eripi ku ovupi Yudiaa ’diyi dri ani, azini indi ’ba alatararu Yerusalemua ’diyi ma a’i azi mani ngale yi driri onyiru, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
