          ]
        },
        {
          "text": "Te ama’i ovupi okpo be ’diyi ma ko ’ba okpo kokoru ma aza okpoako yinisi, ama ma ’ye amani lelerile ku; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
              "ROM.15.1"
            ]
          }
        },
        {
