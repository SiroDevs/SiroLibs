          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma’i, ma ngulupi indi ega ma asia adam e’yo eminisi, ma adri­pi, kini emi ma ngulupi ga tre e’yo onyirusi, emi ovu vini e’yo niza be dria, emi eco emi imbazaru emi eselia ceni indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.14",
            "verseOrgIds": [
              "ROM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 15:15"
          },
          "items": [
            {
              "text": "15",
