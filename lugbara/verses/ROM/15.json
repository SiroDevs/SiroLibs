        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Zab 69:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku Kristo indi ’yeni ndra ini lelerile ku; te ekile erini ovule sizarurile, O’data ’ba mi o’dapi ’diyini ’de ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 15:4"
          },
          "items": [
