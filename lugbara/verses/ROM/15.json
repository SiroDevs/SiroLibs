          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi emi ma a’i emi emi eselia ekile Kristoni emi a’lerile, diza fezu Mungu dri ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.7",
            "verseOrgIds": [
              "ROM.15.7"
            ]
          }
        },
        {
