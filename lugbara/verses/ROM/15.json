            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.11"
              },
              "items": [
                {
                  "text": "1 Kor 10:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi si e’yo dria ndra yini sile oko ’diyi ama imbazu, ama ma ovu e’yo teza be luzu drile ani, e’yo sizani ama dri asi teza fele asi omiza berisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.4",
            "verseOrgIds": [
              "ROM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.16"
              },
              "items": [
                {
                  "text": "Fil 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Mungu asi tezani asi omiza beri ma fe emi dri ovuzu asisile alu be emi eselia, ekile Kristo Yesu ma aliarile, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.5",
            "verseOrgIds": [
              "ROM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini asi alusi azini ti alusi emi ma fe ani inzita Mungu Opi amani Yesu Kristoni ma Ata vu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        }
      ]
    },
    {
