                "loc": "ROM.4.23"
              },
              "items": [
                {
                  "text": "Rum 4:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.24"
              },
              "items": [
                {
                  "text": "24",
