            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.24"
              },
              "items": [
                {
                  "text": "Mat 15:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "’Yeta 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ’yo emi tia, ’ba ndra Yesu Kristoni ’ba agele liza ’diyi ma aza kozu e’yo adaru Munguniri ma e’yosi, ’dini eri eco aziza ndra azile a’bipi ma tia ’diyi ’bazaru okporu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.8",
            "verseOrgIds": [
              "ROM.15.8"
            ]
          }
        },
        {
