              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.18"
              },
              "items": [
                {
                  "text": "Gal 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba azita ’yepi ’diyi ka nga lonyi Munguni feleri nyani, a’ita eca toko, azini aziza nde oja i tokoru indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
