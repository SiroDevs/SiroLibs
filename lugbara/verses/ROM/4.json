            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi eri geri a’itanirisi, ’dini eri ma ovu ’yeta anzutirisi ani, ’dini aziza nde ma ovu okporu ori erini vu dria-kiri ’ba ovupi azita palaa ’diyi vu a’dule ku te ’ba ovupi a’ita be Iburahimule ’diyi vu indi, te,eri ovu ama dria ma a’bini, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
              "ROM.4.16"
            ]
          }
        },
        {
          "name": "verse",
