                {
                  "text": "2 Kor 12:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ma ovu ’ba lile ra ’diyi ma a’biru indi, yi ka yi li’i a’dule ku, te yi ka aci indi a’ita Iburahimuni a’ile ewu erini ovuzu lizaru kuriari ma pamvusi indi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
