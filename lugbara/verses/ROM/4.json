                  "text": "Gal 3:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te aziza ndra azile Iburahimu pi vu ori erini be, kini wudrikuru dria nga ovu erini ’diniri, ovuni geri azitanirisi ku te Munguni eri lale ’ba baru a’itasirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
