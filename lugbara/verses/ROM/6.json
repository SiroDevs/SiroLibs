                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama ka ama emu tualu eri be eceta drata eriniri ecezuri ma alia, ama nga ama emu tualu eri be engata erini ma alia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.5",
            "verseOrgIds": [
              "ROM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.24"
              },
              "items": [
                {
                  "text": "Gal 5:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ni ’diri, ’di ’ba amani okuri pati ruaa tualu eri be, ’dini rua e’yo onzini ma e’yo ma de i ani, ’dini ama ma ovu e’yo onzi ma ati’baru dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.6",
            "verseOrgIds": [
              "ROM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.1"
              },
              "items": [
                {
                  "text": "1 Pet 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba drapi ini rari, tru eri e’yo onzi vusi ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.7",
            "verseOrgIds": [
              "ROM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama ka ndra dra tualu Kristo be, ama a’i ama asia ama nga ovu idriru tualu eri be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.8",
            "verseOrgIds": [
              "ROM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’di­siku ama ni ra Kristo enga ’ba draza ma eseliarisi ’bo, ngani dra dika ku; dra ngani ovu eri ma opiru dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.9",
            "verseOrgIds": [
              "ROM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.26+HEB.9.27+HEB.9.28"
              },
              "items": [
                {
                  "text": "Ebra 9:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.19"
              },
              "items": [
                {
                  "text": "Gal 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.18"
              },
              "items": [
                {
                  "text": "1 Pet 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ndra erini draria, eri dra ndra e’yo onzisi pale alu fudri ra, te curu­’do erini ovuria idriru eri ovu idri be Mungu vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.10",
            "verseOrgIds": [
              "ROM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.15"
              },
              "items": [
                {
                  "text": "2 Kor 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.24"
              },
              "items": [
                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dinile indi, e’yo onzi vusini emi la emi ’ba avuru, te Mungu vu ovuzu idriru Kristo Yesusi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.11",
            "verseOrgIds": [
              "ROM.6.11"
            ]
          }
        }
      ]
