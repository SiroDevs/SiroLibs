          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini ama ma li ’ba azini ama eseliari ma e’yo dika ku, te agapiri emi ma li e’yo ’diri, kini ’ba aluni ma ’ba kumu i adripi ma geria, kani e’yo erini ani abazu rari ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.13",
            "verseOrgIds": [
              "ROM.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
