              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.18"
              },
              "items": [
                {
                  "text": "Rum 12:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.2"
              },
              "items": [
                {
                  "text": "15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ama ma bi e’yo asi anzuruni ’diyi ma vuti, azini e’yo amani ecozu ani ama edre­zu ama eselia ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.19",
            "verseOrgIds": [
              "ROM.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma fu lazi Munguni nyaka ma e’yosi ku. Adaru afa dria yi alaru ra ’bo, te ’ba ka afa nya obeta fezu ’ba azini dri eri onzi; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.20",
            "verseOrgIds": [
              "ROM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
