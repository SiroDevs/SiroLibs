                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ovupi okpo kokoru a’ita erini ma alia, emi ma a’i eri ra, te agata gazu eri be e’yo toko tokosi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.1",
            "verseOrgIds": [
              "ROM.14.1"
            ]
          }
        },
        {
          "name": "verse",
