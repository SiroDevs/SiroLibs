        },
        {
          "text": "Te suru Munguni ovuni afa nyaza nyazu kani afa mvuza mvuzu, ’dini ku, te eri ovu e’yo onyini, asi anzuru pie, ayiko pie, Orindi Alatararu ma alia; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.17",
            "verseOrgIds": [
              "ROM.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ’ba azi ngapi Kristo dri e’yo ’diri ma aliari, eri ayiko fe Mungu dri, ’ba yi vini eri a’i indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.18",
            "verseOrgIds": [
              "ROM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 14:19"
          },
          "items": [
