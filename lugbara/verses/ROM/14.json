                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.38"
              },
              "items": [
                {
                  "text": "Luk 20:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama ka ovu idri be ama ovu idri be Opisi, te ama ka dra ra ama dra Opisi; ’dini ama ka ovu idri be kani ama ka dra ra ti, ama ovu Opini. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.8",
            "verseOrgIds": [
              "ROM.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo ’disi Kristo eri dra ndra te eri ovu idriru dika, eri ma ovu ani Opiru ’ba drapi ’bo ’diyi pi ma drilia ’ba idriru ’diyi be.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.9",
            "verseOrgIds": [
              "ROM.14.9"
            ]
          }
        }
      ]
