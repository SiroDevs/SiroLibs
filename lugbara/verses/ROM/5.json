              },
              "items": [
                {
                  "text": "Isa 53:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amani ovuria lazaru ’ba baru amani a’ilerisi, ama ma ovu asi anzuru be Mungu vu Opi amani Yesu Kristosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.1",
            "verseOrgIds": [
              "ROM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
