              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.3.12"
              },
              "items": [
                {
                  "text": "Efe 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.23"
              },
              "items": [
                {
                  "text": "Rum 3:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma e’yosi indi ama fi a’itasi ’yeta anzutiri amani pa sozu aleniari ma alia, vini indi ama ma ovu ayikosi diza Munguni tezu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.2"
              },
              "items": [
                {
                  "text": "Yak 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.5+1PE.1.6+1PE.1.7"
              },
              "items": [
                {
                  "text": "1 Pet 1:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kiri ’diri a’dule ku, te ama ovu ayikosi inzata ma alia, a’disiku ama ni ra inzatani asi teza fe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.3",
            "verseOrgIds": [
              "ROM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "te asi tezani eri ama dri adriza onyiru e’yoni ’ba sizuri fe, adriza onyiruri fe amani asi ’bazu e’yo drileri ma dria, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.4",
            "verseOrgIds": [
              "ROM.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.5"
              },
              "items": [
                {
                  "text": "Zab 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.25.20"
              },
              "items": [
                {
                  "text": "25:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.6.18"
              },
              "items": [
                {
                  "text": "Ebra 6:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.6.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te asi ’bazu e’yo drileri ma driari feni drinza ku, ale Mungunirini i dale asi amani ma alia Orindi Alatararu erini fele ama dri ’borisirisi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
            ]
          }
        }
      ]
