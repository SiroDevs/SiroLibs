                "loc": "1CO.15.55"
              },
              "items": [
                {
                  "text": "55",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’dozu ndra Adamusi cazu Musasi dra ovu ndra opiru ’ba dria ma driliani, eri obi ’ba dria yi ka e’yo onzi ’ye Adamuni ’yelerile ku ti, te Adamuni ecetaru ’ba ngapi emupi vileri ecezu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        }
      ]
    },
    {
