      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te afa Munguni fele avasiri ovuni ekile ezata nderile ku. Te dra ka ’ba bi kakau ezata ’ba alunisi, agapi turi ’Yeta anzutiri Munguni azini afa erini fele ’Yeta anzutiri ’ba alu Yesu Kristonisiri aga tu ’ba kakau vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.15",
            "verseOrgIds": [
              "ROM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te afa feza nderi ovuni ekile e’yo ecapi ezata ’ba aluni ezalerisirile ku. Te e’yo liza eca ndra ezata alusi ’ba ndezu, te afa feza avasiri eca ezata kakau ma e’yosi ’ba lazu ’ba baru. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.16",
            "verseOrgIds": [
              "ROM.5.16"
            ]
          }
        },
        {
