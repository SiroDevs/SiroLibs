              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.15"
              },
              "items": [
                {
                  "text": "Rum 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ndra oko de azita ecani ku e’yo onzi ovu nyakua, te azitani ovuria yoria, ajini e’yo onzi ma ru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.13",
            "verseOrgIds": [
              "ROM.5.13"
            ]
          }
        },
        {
