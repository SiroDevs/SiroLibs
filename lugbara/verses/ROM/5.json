                  "text": "Rum 6:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ekile e’yo onzini efile ndra nyakua ’ba alu ma e’yosirile, te indi e’yo onzi ndesi dra efini, e’yo ’disi dra obi ’ba dria yini dria ’yele onzirisi- ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.12",
            "verseOrgIds": [
              "ROM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
