                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Lev 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.12"
              },
              "items": [
                {
                  "text": "Gal 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Musa si kini ’ba onyi azita ndeni ’yepiri eri nga ovu idriru erini ’yelerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.12+DEU.30.13+DEU.30.14"
              },
              "items": [
                {
                  "text": "Azi 30:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te onyi ’bani isule a’itasiri ’yo ’dini, Mi ’yo mi asia ku, A’dini nga tu ’buani ya? (Kristoni ejizu va ’doa) ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.6",
            "verseOrgIds": [
              "ROM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kani, A’dini nga si va ’bile aliru aliani ya? (Kristoni engazu dra ma alia). ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.7",
            "verseOrgIds": [
              "ROM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.14"
              },
              "items": [
                {
                  "text": "Azi 30:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ’yo ngoni ya? E’yo nde ovu mi vu inyia, azini mi tilia, mi asia indi (’di e’yo a’itani amani oluleri’i); ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.8",
            "verseOrgIds": [
              "ROM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.5"
              },
              "items": [
                {
                  "text": "2 Kor 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kini mi ka Yesuni e’da Opi’i mi tisi, azini mi ka a’i mi asia indi kini Mungu enga eri ’ba draza eselia ’bo, mi nga mi pa ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.9",
            "verseOrgIds": [
              "ROM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te asisi ’ba yi a’i ra e’yo ’ba lazu baruri isuzu, te tisi ’ba yi e’yo e’da pata Isuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.10",
            "verseOrgIds": [
              "ROM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.16"
              },
              "items": [
                {
                  "text": "Isa 28:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo siza ’yo ra, ’Ba dria eri a’ipiri ngani ovu drinzasi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.11",
            "verseOrgIds": [
              "ROM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.34"
              },
              "items": [
                {
                  "text": "’Yeta 10:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.9"
              },
              "items": [
                {
                  "text": "15:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba Yahu­dini ’ba Giriki be yi ovuni ndu ndu ku; Opi eri alu ’ba driani, eri ovu lonyi be fezu ’ba dria eri omvepi ’diyi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.12",
            "verseOrgIds": [
              "ROM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.32"
              },
              "items": [
                {
                  "text": "Yoe 2:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te, ’Ba dria alu alu Opi ma ru omvepi ’diyi nga yi pa ra.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi nga ’ba yini a’ile nga kuri omve ngoni ngoni ya? Te yi nga ’ba yini e’yoni erile nga kuri a’i ngoni ngoni ya? Te yi nga e’yo eri, ’ba e’yo olupiri kokoru ngoni ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.14",
            "verseOrgIds": [
              "ROM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.7"
              },
              "items": [
                {
                  "text": "Isa 52:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi nga e’yo olu ngoni ngoni ya, ka yi ti pe ku? Ekile erini ovule sizarurile, Adaru ’ba emupi e’yo bari olupi e’vo onyiru ejipi ’diyi ma pa ndri tu ’uoni ya! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.15",
            "verseOrgIds": [
              "ROM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.1"
              },
              "items": [
                {
                  "text": "Isa 43:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi dria inzini e’yo bari su; te Isaya eri ’yo ra, Opi, a’di a’i e’yo yini erile ama vurini ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.20"
              },
              "items": [
                {
                  "text": "Yoh 17:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini a’ita eca ’bani e’yo erilerisi, te eriza eca ’bani e’yo Kristoni olulerisi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        }
      ]
    },
