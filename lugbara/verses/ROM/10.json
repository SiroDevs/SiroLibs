            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma ’yo, yi erini ndra ku ya? Adadaru yi eri ndra ra; ’dini",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
