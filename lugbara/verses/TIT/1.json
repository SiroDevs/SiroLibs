            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo, ati’bo Munguni, ’ba Yesu Kristoni tini peleri, a’ita ’ba Munguni opele ’diyiniri ma e’yosi, azini nita ’bani e’yo adaru nizu dri fupi adriza ’bani ani Mungu inzizu­rini lelerileri ma e’yosi indi, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.1",
            "verseOrgIds": [
              "TIT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi teza idri ’dani ’dani Mungu ecopi inzo lizaru kurini azile ewu ndra driorisiri tezu; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.2",
            "verseOrgIds": [
              "TIT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
