                "loc": "1TI.1.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri e’da e’yo erini ewuni dri furia ’yekeria, e’yo oluza fele kule ma dri azita Mungu ama Papirinirisiri ma alia;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.3",
            "verseOrgIds": [
              "TIT.1.3"
            ]
          }
        }
      ]
    },
    {
