                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ovu ndra afa onyiru nyakuni ’diyi be tre tre, emi ’ye ndra e’yo dria ava emi ruaarini lelerile; emi fe emi asini trazu o’du afa lizurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.5",
            "verseOrgIds": [
              "JAS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi li ’ba kililiruri ma e’yo eri ndezu, emi fu eri ’bo; eri ogani emi ku.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.6",
            "verseOrgIds": [
              "JAS.5.6"
            ]
          }
        }
