          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.1"
              },
              "items": [
                {
                  "text": "Mar 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.1"
              },
              "items": [
                {
                  "text": "Rum 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.4"
              },
              "items": [
                {
                  "text": "14:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azita fepiri azini ’ba e’yo lipiri eri alu, ecopi ’ba papi azini ’ba dri japiri’i. Te mi’i, mi agyi mini ma e’yo lipiri, mi a’di’i ya?",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.12",
            "verseOrgIds": [
              "JAS.4.12"
            ]
          }
        }
      ]
