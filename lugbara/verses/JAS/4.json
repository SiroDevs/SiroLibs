                "loc": "EPH.6.12"
              },
              "items": [
                {
                  "text": "Efe 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.8"
