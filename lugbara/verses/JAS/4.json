              "items": [
                {
                  "text": "1 Pet 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri fe ’yeta anzutiri ’lama dri aga ra; e’yo ’disi e’yo siza kini, Munguni ’ba ovupi asi afu be ’diyi ma dri aru, te eri adri ’yeta anzutiri fe ’ba ovupi asi e’yeresi ’diyi ’dri. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.6",
            "verseOrgIds": [
              "JAS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
