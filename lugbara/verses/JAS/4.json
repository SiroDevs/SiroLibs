            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi eri curu’do, emi ’ba e’yo ’yopi ’dini ’diyi, kini, Andru kani drusi ama nga mu aku amborua ’dale, ama nga ovu ’dale eli alu afa oziria orodri isuzu; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.13",
            "verseOrgIds": [
              "JAS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
