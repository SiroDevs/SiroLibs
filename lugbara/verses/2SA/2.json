                "loc": "ISA.28.21"
              },
              "items": [
                {
                  "text": "Isa 28:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abineri, Neri mvi pi ati’ba Isibosetini ’diyi be, yi fu Mahanai­muasi muzu Gibeonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.12"
              },
              "items": [
                {
                  "text": "Yer 41:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yo­abu Zeruiya mvi pi ati’ba Daudini ’diyi be, yi fu mu dri fuzu yi be yi alio Gibeoniari ma tia; yi ori va, alu yi ti ega aluria, azini yi ti ega aziniria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.23"
              },
              "items": [
                {
                  "text": "O’be 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.13.10"
              },
              "items": [
                {
                  "text": "13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Abineri ’yo Yoabu ma tia, Ma zi mi tia, mi fe karile ma enga uru a’di o’bizu avitasi ama drilia. Te Yoabu kini, Yi ma enga uru. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi nga di enga uru, yi nga zo kalafe yini vusi, mudri drini iri Benya­mini pi dri Isiboseti Saulo mvi be, azini ati’ba Daudini mudri drini iri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba dria alu alu yi bi yi dri yi agupi be, yi so yi ejea seisi yi agupi be; ’dini yi o’de va tualu. E’yo ’disi yi e’da pari nderi ma ru Helikati­hazurimu’i, eri ovu Gibeonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
            "verseOrgIds": [
              "2SA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.20.11"
              },
              "items": [
                {
                  "text": "1 Opi 20:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’di ovu okporu tu etu nderisi; te ati’ba Daudini yi aga Abineri pi ’ba Israelini ’diyi be ra.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.17",
            "verseOrgIds": [
              "2SA.2.17"
            ]
          }
        }
      ]
    },
