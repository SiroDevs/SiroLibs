        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Sam 25:42-43",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Daudi tu ’dale, oku erini irii ’diyi be, Ahinoamu Yezireeli ezoruri pi Abigaili Nabali ’ba Karimeliari ma awuzi be. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 2:3"
          },
          "items": [
