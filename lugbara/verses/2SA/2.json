              ]
            }
          ]
        },
        {
          "text": "Te Zeruiya ma anzipi na ovu ’dale indi, yi Yoabu pi, Abisai pi, Asaheli pi. Te Asaheli ma pa ovu perepere onguru ekile eba ma pale; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.18",
            "verseOrgIds": [
              "2SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
