                  "text": "2 Sam 17:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu Abineri Neri mvi, ambo asikari Sauloni ’diyi ma driliari, ’du Isiboseti Saulo mvini, ji eri Maha­naimua; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.8",
            "verseOrgIds": [
              "2SA.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba eri opiru Gileadi pi ma drilia, ’ba Asuriaa ’diyi pie, Yezireeli pie, Efiraimu pie, Benya­mini pie, Israeli pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.9",
            "verseOrgIds": [
              "2SA.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiboseti Saulo mvi ovu eli be kali su erini e’dozu opi nyazu Israeli ma driliarisi, te eri nya opi eli iri. Te suru Yudani bi Daudi ma vuti. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.10",
            "verseOrgIds": [
              "2SA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli Daudini opi nyazu Hebi­ronia suru Yudani ma drilia ’diyi ovu eli aziri drinia mba azia.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.11",
            "verseOrgIds": [
              "2SA.2.11"
            ]
          }
        }
      ]
    },
