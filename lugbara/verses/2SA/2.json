        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.27.2"
              },
              "items": [
                {
                  "text": "1 Sam 27:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi eji vini ’ba ovupi i be ’diyi, yi alu alu tualu ’ba ovupi yi ma joa ’diyi be; te yi ove i aku Hebironia ’diyi ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.3",
            "verseOrgIds": [
              "2SA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
