                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Abineri pi ’ba erini ’diyi be aci ini nderisi rra Araba ma eselia; yi zo Yoridanini ra, yi aga Bitironi ma eseliasi dria, ca Mahanaimua. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.29",
            "verseOrgIds": [
              "2SA.2.29"
            ]
          }
        },
        {
