        },
        {
          "text": "Te Daudi nga karilau alu omve, ’yozu, Mi mu ogogo, mi ’de eri dria. Eri co eri, ’dini eri dra kai, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.15",
            "verseOrgIds": [
              "2SA.1.15"
            ]
          }
        },
