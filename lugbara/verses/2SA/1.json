            }
          ]
        },
        {
          "text": "Te Daudi ’yo eri tia, Mi ovuni lurisi ku dri mini ejuzu ’ba Yehovani odu osule driniari fuzu ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.14",
