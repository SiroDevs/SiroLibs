              "items": [
                {
                  "text": "2 Sam 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Azi 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Rizipa Aya zi ’du koliba, aja eri kata dria i ngulupi dri, engazu o’du yini ’bazu anyalozurisi cazu ozoo ’buarini ’bazu ’dizu yi driarisi; etusi eri kuni aria ’bua ’diyini rizu drinia ku, inisi kuni anyapa rizu drinia ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi olu Daudi tia e’yo Rizipa Aya zi, oku ati’boru Saulonirini ’yele ’bori. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.8+1SA.31.9+1SA.31.10+1SA.31.11+1SA.31.12+1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:8-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi mu fala Saulo pini o’du mvi Yonatani be ’ba Yebesi-gileadia ’diyi ma driasi, yi’i fala nde ’diyi ogupi gboko Beti-saniaria pari ’ba Filisitiaa ’diyini yi o’izu o’du ’ba Filisitiaa ’diyini Sauloni fuzu Gili­boarisi ’diyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dale eri o’du fala Saulo pini mvi Yonatani be; yi oku fala ’ba yini o’ile ’diyini indio ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
