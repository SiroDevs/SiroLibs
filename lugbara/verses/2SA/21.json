            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.7"
              },
              "items": [
                {
                  "text": "2 Sam 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opi o’du agupianzi iri Rizipa Aya ma zi vile, erini tile Saulo dri ’diyi, yi Arimoni pi Mefiboseti be; azini agupianzi towi. Merabu Saulo zi vile, erini tile Adrieli Barizilai mvi ’ba Meholatiari dri ’diyi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
