            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.17"
              },
              "items": [
                {
                  "text": "Zab 132:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Abisai Zeruiya mvi emu eri pazu, eri co ’ba Filisitiaa nderi, fu eri ra. Vutinia ’ba Daudini nga oyo so eri tia kini, Mi ngani mu ama be a’dia dika ku, mi kazu diza Israelini inyuzu ku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        }
