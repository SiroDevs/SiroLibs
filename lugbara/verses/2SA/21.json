              },
              "items": [
                {
                  "text": "2 Sam 6:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri fe yi ’ba Gibeonia ’diyi dri, yi o’i yi oni dria Yehova drilia, yi aziri ’diyi o’de dria tualu. Yi ofu yi o’du oko ’bani ’bazu anya lozu anya aziniri berisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.7"
