        },
        {
          "text": "Te opi ku Mefiboseti, Yonatani Saulo mvi ma mvini, oyo Yehovani yini sole yi eseliarisi, Daudi pi ma eselia Yonatani Saulo mvi be. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
