                "loc": "NUM.35.15"
              },
              "items": [
                {
                  "text": "Kal 35:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te dra ngani ama ku aluni ku, ama ovu ekile yi ’bani dale nyakua ’bani ecole ekole dika kurile; te Mungu ngani idri ’ba ’bele amverini nze ku, ’beni eri i vusi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.14",
            "verseOrgIds": [
              "2SA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi curu’do ma eca e’yo ’dori ’yozu opi mani amboruri be, a’disiku ’bani uri mile ma asiarisi; te ati’bo mini okururi ega kini, Ma nga e’yo ’yo opi tia curu’do; kani opini nga e’yo ati’bo erinirini zile eri tiari ’ye ra yani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.15",
            "verseOrgIds": [
              "2SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opini nga eri ra, nga ati’bo i erini pa agu lepi ma fupi ma mvi pie tualu ama kazu lonyi Munguni isuzu kuri ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.16",
            "verseOrgIds": [
              "2SA.14.16"
            ]
          }
        },
