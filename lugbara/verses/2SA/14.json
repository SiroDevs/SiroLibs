            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.27.34"
              },
              "items": [
                {
                  "text": "’Yeta 27:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te loku nde nga ’yo, Ma matu ’ba mi vu, opi ma ega Yehova Mungu miniri, i’dini ’ba arioti ofepiri ma ja ’ba dri dika ku, ’dini yi ngani mva maniri ma dri ja ku indio Te eri ’yo, Ekile Yehovani ovule idrirurile, dribi efi alu mi mvini ngani ’de nyakua ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te oku nde ’yo eri tia, Ma matu ’ba mi vu, mi fe ati’bo okuru miniri ma ’yo e’yo opi mani ambo­ruri ma tia. Eri ’yo ra, Mi ’yo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.12",
            "verseOrgIds": [
              "2SA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.2"
              },
              "items": [
                {
                  "text": "Lip 20:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.37"
              },
              "items": [
                {
                  "text": "2 Sam 13:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Oku nde nga ’yo, Mi ega e’yo ’yezu ’ba Munguni vu ’dini a’di e’yosi ya? Te opini e’yo ’yozu ’dinirisi, eri ’ba e’yo liza i ngulupi ma dria, a’disiku opini ’ba erini ’bele amveri omvizu dika kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.13",
            "verseOrgIds": [
              "2SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 14:14"
