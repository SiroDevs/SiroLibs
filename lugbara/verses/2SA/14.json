              "items": [
                {
                  "text": "2 Sam 19:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.29.9"
              },
              "items": [
                {
                  "text": "1 Sam 29:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma matu ’ba mi vu, mi fe e’yo ’yoza opini ma omi asi mani; a’disiku opi mani amboruri ovu ekile malaika Munguni e’yo onyiru pi ma esele awapi e’yo onzi berile. Yehova Mungu miniri ma ovu mi be!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di ma vutia, opi nga ’yo oku nderi tia kini, Mi oci e’yo mani ngale zile mi tiari aluni ku, ma matu ’ba mi vu. Oku nde nga ’yo, Opi mani amboruri ma ’yo e’yo curu’do. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi nga ’yo kini, Yoabu ma dri ovu mi be e’yo dria ’diyi ma alia ra ,ya? Te oku omvi kini, Ekile orindi minirini ovuzu idrirurile, opi mani amboruri, ’ba aluni econi e’yo opi mani amboruriniri onazu dri ndia kani dri ejia ku. Ati’bo mini Yoabu azi ma dri, eri ece vini e’yo ’yoza ’diyi dria ati’bo mini vu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.27"
              },
              "items": [
                {
                  "text": "2 Sam 19:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ati’bo mini Yoabu ’ye ’ dini e’yo nde ma mile Ojazu ndu. Opi mani ovu onduaru ekile malaika Mungunile, e’yo dria ovupi nyakuari nizu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi nga ’yo Yoabu tia, Mi ne, curu’do ma li e’yo ’diri ’bo, ’dini mi mu karilau nde Abisalomuni omvizu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.21",
            "verseOrgIds": [
              "2SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yoabu eco iva, su i mile nyakua inzita fezu, eri inzi opini; te Yoabu ’yo, Opi mani inzileri, ati’bo mini ni andru eri isu asi ndriza mi ma milia ’bo, opini e’yo mani matu ’bazuri erile ’borisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.22",
            "verseOrgIds": [
              "2SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
