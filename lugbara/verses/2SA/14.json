        },
        {
          "text": "Te Yoabu nga ’ba ti pe Tekoaa, e’du ’dale oku onduaru, ’yo eri tia, Ma matu ’ba mi vu, mi ’ye ekile ’ba ’ba wepirile, mi su koliba; mi efi mi rua odusi ku, te mi ovu ekile oku wupi izu ’ba drazasirile; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.2",
            "verseOrgIds": [
              "2SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
