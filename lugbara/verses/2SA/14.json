              },
              "items": [
                {
                  "text": "Efu 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te mi fi opi vu, mi ’yo eri tia ’dini. ’Dini Yoabu su oku nderi tia e’yo erini ngale ’yole ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        },
