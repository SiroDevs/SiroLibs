                "loc": "GEN.43.3"
              },
              "items": [
                {
                  "text": "E’do 43:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.13"
              },
              "items": [
                {
                  "text": "2 Sam 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.4"
              },
              "items": [
                {
                  "text": "Eceza 22:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opi ’yo ra kini, Eri ma oja i ngulupiniria, eri ma ne ma mile ku. ’Dini Abisalomu oja i jo i ngulupini­ria, neni opi ma mile ku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
