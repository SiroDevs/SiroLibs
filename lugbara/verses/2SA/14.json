              "type": "tag",
              "attrs": {
                "loc": "GEN.33.4"
              },
              "items": [
                {
                  "text": "E’do 33:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.15"
              },
              "items": [
                {
                  "text": "45:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.20"
              },
              "items": [
                {
                  "text": "Luk 15:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yoabu nga di mu opi vu e’yo ’yozu eri tia; eri ka Abisalomuni omve ’bo, eri eca opi vu, avu va, su i mile: nyakua opi drilia; te opi nga Abisalomuni zi o’bolo ndruzasi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.33",
            "verseOrgIds": [
              "2SA.14.33"
            ]
