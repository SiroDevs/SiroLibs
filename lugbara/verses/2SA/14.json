              "items": [
                {
                  "text": "2 Sam 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.37"
              },
              "items": [
                {
                  "text": "13:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Yoabu enga, mu Gesuria, cii Abisalomuni Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.23",
            "verseOrgIds": [
              "2SA.14.23"
            ]
          }
        },
