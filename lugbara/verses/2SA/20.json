                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi ’yo Abisai tia kini, Curu’do Seba Bikiri mvini nga ama ’ye onzi aga Abisalomuni ndra ’yeleri ra; mi ’du ati’ba opi mini vile ’diyi, emi mu eri vuti drozu, eri kazu aku abi be okporu ’diyi bizu ku, kazu apazu ama miliasi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
