                }
              ]
            }
          ]
        },
        {
          "text": "te Adoramu ovu ’ba okule azia ’diyi ma drilia; Yehosafati Ahiludi mvi ovu ’ba suru ma e’yo sipiri; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
