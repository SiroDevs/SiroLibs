                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri aga suruti Israelini ’diyi ma eseliasi dria cazu Abeli Betimaakaria, azini ’ba Bikiria ’diyi vu dria; te yi oku yi tualu, mu eri vutia indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.19.32"
              },
              "items": [
                {
                  "text": "2 Opi 19:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.24"
              },
              "items": [
                {
                  "text": "Yer 32:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.4"
