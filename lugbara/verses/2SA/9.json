        },
        {
          "text": "Vutinia opi nga Ziba ati’bo Sauloni omve, ’yo eri tia, Afa dria ndra ovupi Sauloni ori’ba erini ’diyi be driari, ma fe eri opi mini ma mvi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
