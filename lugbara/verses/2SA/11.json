                  "text": "19:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Daudi ’yo Uria ma tia, Mi si va jo minia, mi oji mi pa. Te Uria fu opi ma joasi, te opi pe afa feza ma ti eri vutisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.8",
            "verseOrgIds": [
              "2SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.12+JOB.5.13+JOB.5.14"
              },
              "items": [
                {
                  "text": "Yob 5:12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Uria la opi vile jotilia opi eri vileri ma ati’ba ’diyi be dria, eri sini mu jo erinia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.9",
            "verseOrgIds": [
              "2SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi ka olu Daudi tia kini, Uria sini va jo eriniria ku, Daudi nga ’yo Uria tia kini, Mi sini va jo minia ku a’di e’yosi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.10",
            "verseOrgIds": [
              "2SA.11.10"
            ]
          }
        },
