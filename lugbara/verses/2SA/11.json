        {
          "text": "Eri nga eca ’dini, o’bitisi Daudi si waraga Yoabu vu, fezu Uria dri jizu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.14",
            "verseOrgIds": [
