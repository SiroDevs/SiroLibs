              "items": [
                {
                  "text": "Lip 9:53",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.21"
              },
              "items": [
                {
                  "text": "2 Sam 20:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.31.3"
              },
              "items": [
                {
                  "text": "Yob 31:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’di fu ndra Abimeleki Yerubeseti mvinini ya? Oku alu abi kaliru ma driari ’beni oni anya ’izuri eri ma dria, ’dini erini drazu Tebeziani ku ya? A’di e’yosi emi mu ogogo ’dini abi kaliru vu ya? Mi ma nga ’yo kini, Ati’bo mini Uria ’ba Hitiniri dra indi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        }
      ]
