              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.9"
              },
              "items": [
                {
                  "text": "2 Sam 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri si wataga nderi alia kini, Mi ’ba Uriani omba okporu agapi rari ma milia, te emi ma se emi eri vusi ra, ’dini yi ma nga eri gbi, leri ma dra ani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.15",
            "verseOrgIds": [
              "2SA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, Yoabuni teria aku nde ma kalaa, eri ’ba Uriani pari erini nile ’ba ombaru ’diyini ovuzuria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.16",
            "verseOrgIds": [
              "2SA.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba aku ndea ’diyi nga efu a’di ’dizu Yoabu be; asikari azini, adaru ati’ba Daudini ’diyi odra ra; azini Uria ’ba Hitiniri dra indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.17",
            "verseOrgIds": [
              "2SA.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di ma vutia Yoabu pe ’ba ti Daudi vu e’yo omba ndeni ecezu dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.18",
            "verseOrgIds": [
              "2SA.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri fe azita ojio nderi ma tia kini, Mi ka de e’yo omba ndeni ecezu dria opi tia, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.19",
            "verseOrgIds": [
              "2SA.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga eca ’dini, opi ka ovu adrasi, te eri ka ’yo mi tia, Emi mu ogogo ’dini a’di ’dizu aku ndea a’di e’yosi ya? Emi nini ndra ku kini ’ba abi kaliru ma dria ’diyi nga emi gbi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.20",
            "verseOrgIds": [
              "2SA.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
