              },
              "items": [
                {
                  "text": "2 Sam 23:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi nga ’ba ti pe oku nderi ma e’yo zizu. Te ’ba alu ’yo, ’Di ovuni Bati-seba, Eliamu zi, oku Uria ’ba Hitini vileri’i ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.3",
            "verseOrgIds": [
              "2SA.11.3"
            ]
          }
        },
