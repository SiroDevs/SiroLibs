          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia Yoabu vu guka, ’ba nde ’diyi emvi kuzu Israeli ma vuti drozu ja; a’disiku Yoabu oga ’bani muko si. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
