              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ni eli ani,’ba a’ita be ’diyi yi anzi Iburahimuni. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
