              "items": [
                {
                  "text": "Ebra 10:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini e’da i mgboru kini yi ngani ’ba la kililiru azitasi Mungu ma milia aluni ku; a’disiku kini, ’Ba kililiruri nga ovu idriru a’itasi; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.11",
            "verseOrgIds": [
              "GAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
