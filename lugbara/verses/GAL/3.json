        },
        {
          "text": "Te otrita ovu ’ba dria lepi yi papi ’yeta azitanisi ’diyi ma dria, a’disiku e’yo siza kini, ’Ba dria e’yo dria ovupi sizaru buku azitani ma alia ’diyi ’yepi ’dani ku ’diyi ma ovu trizaru. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.10",
            "verseOrgIds": [
              "GAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
