              "items": [
                {
                  "text": "Rum 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te azita nde ovuni a’itasi ku, te ’Ba azita ’yepiri nga ovu idriru azita ndesini. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.12",
            "verseOrgIds": [
              "GAL.3.12"
            ]
