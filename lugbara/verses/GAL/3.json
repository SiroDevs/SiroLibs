                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "’Yeta 3:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo siza ni drio kini Munguni nga ’ba jururu la kililiru a’itasi, eri nga e’yo bari olu Iburahimu ma tia oko ani kini, ’Ba jururu ’diyi dria yi nga drileba isu misi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.8",
            "verseOrgIds": [
              "GAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.16"
              },
              "items": [
                {
                  "text": "Rum 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awa’dini ’ba a’ita be ’diyi ovu drilebaru Iburahimu ’ba a’ita beri be.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
            ]
          }
        }
      ]
