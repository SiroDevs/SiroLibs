                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kristo je ama ama onzezu otrita azita ndeni ma alia, ’ba i otrizaru ama paria-a’disi­ku e’yo siza kini, ’Ba dria alu alu yini dile pati ruaari ma ovu trizaru- ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
