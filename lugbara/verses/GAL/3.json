          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini drileba Iburahimuniri ma ca ’ba Jururu ’diyi vu Kristo Yesu ma alia ani, ama ma bi vini aziza Orindiniri a’itasi indi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
