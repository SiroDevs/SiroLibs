              "type": "text"
            }
          ]
        },
        {
          "text": "Engazu curu’do ’ba aluni ma ecandi ma ku; a’disiku mani acile nyibeleko Yesuni be ma ruaarisi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
