                "loc": "PHP.3.3"
              },
              "items": [
                {
                  "text": "Fil 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria acipi azita ’di vusi ’diyi, asi anzuru pi ma ovu yi vu yiki be, azini ’ba Israelini Mungu vile ’diyi vu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
        }
