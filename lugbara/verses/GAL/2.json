                  "text": "Yoh 1:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yini ’yeta anzutiri fele ma driri niria, Yakobo pi Kefa pie Yohana be, yi ’ba e’daza agoferu ’diyi, yi fe ndra ama dri Baranaba be dri ndi ti ecitaniri, ama ma mu ’ba jururu ’diyi vu, te yi’iruni ’ba agele lile ra ’diyi vu; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
