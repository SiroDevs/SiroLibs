                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ovu ’dini adripi inzoru ofile ndindiru, efipi: ecapi ndindiru truta amani amani ovuzu eri be Yesu Kristo ma aliari ma e’yo mbazu, yi ma oja ama ati’baru beni, ’diyi ma e’yosi- ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.4",
            "verseOrgIds": [
              "GAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 2:5"
          },
          "items": [
