          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(a’disiku ’ba ’yepi okposi Petero vu eri ’bazu ’ba tini peleriru ’ba agele lile ra ’diyi vuri ’ye ma vu okposi indi ’ba jururu ’diyi vu), ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
