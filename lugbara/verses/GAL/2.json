                "loc": "GAL.3.1"
              },
              "items": [
                {
                  "text": "Gal 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te i ama ’bani ama yi ma palaa yi inzizu kani etu alu ’dipi ra ’dinini ku, e’yo bari ma ada ma ta mbazu emi dri ’dani ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
