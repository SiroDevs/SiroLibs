              "items": [
                {
                  "text": "12:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te e’yo alu, yi le ama ma ega ’ba alioru ’diyi ma e’yo, ’di bani e’yo mani lele ’yele avasiri’i ku, ka’dini mi ’ba jururu ’diyi omi okposi adrizu ’ba Yahudiniru ngoni ngoni ya?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
