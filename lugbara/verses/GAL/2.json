              },
              "items": [
                {
                  "text": "’Yeta 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Tito; ovupi ma berini tro ovuzu Girikiou­niri ti, yi omini eri okposi agele liza a’izu aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.3",
            "verseOrgIds": [
              "GAL.2.3"
            ]
          }
        },
        {
