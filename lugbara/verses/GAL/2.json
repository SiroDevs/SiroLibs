                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te drinisi yi ka ndre a’i e’yo bari kuzu ma dri oluzu ’ba agele lile ku ’diyi dri ra ekile kule Petero dri oluzu ’ba agele lile ra ’diyi dririle, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
