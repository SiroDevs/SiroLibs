              "type": "text"
            }
          ]
        },
        {
          "text": "Te Kefani ndra ecaria Antio­kiaa ama aru ama dri eri be milia milia, e’yoni eri ndele rarisi, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
