                }
              ]
            }
          ]
        },
        {
          "text": "Te etu erini ecazu okporu ’borisi, afu enga asinia, ’dini eri ’ye onzikanyaru; eri eza e’yo Yehova Mungu eriniri vu, fi hekalu Yehovani ma alia obiese evezu pari obiese vezuri ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
