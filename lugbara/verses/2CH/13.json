              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Abiya nga eca ovuzu okpo be, oje oku i dri mudri drini su, ti agupianzi kali iri drini iri, ezoanzi mudri drini azia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.21",
