          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Israelini ’diyi nga di apa Yuda ma driliarisi ra, Mungu fe di yi ani yi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiya pi ’ba erini ’diyi be ja di yi ma dri dri jaza amborusi; dini ofu ’ba ombani opele ope Israeli ma eselia ’diyi alifu turu towi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
            "verseOrgIds": [
              "2CH.13.17"
            ]
          }
        },
