                  "text": "2 Sur 11:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nya opi Yerusalemuoua eli na. Andri ma ru Mikaya’i, eri Urieli ’ba Gibeaari ma zi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
