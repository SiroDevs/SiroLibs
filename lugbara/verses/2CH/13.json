        },
        {
          "text": "Te Yeroboamu isuni okpo dika o’du Abiya ngarerisi aluni ku; te vutinia Yehova co eri ra, dra ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
            "verseOrgIds": [
