            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.18"
              },
              "items": [
                {
                  "text": "Efu 30:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.23"
              },
              "items": [
                {
                  "text": "1 Opi 7:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede vini miri ma otaka mola akazaru acisirisi, engazu tini aluria cazu tini aziria ovu wuale mudri, ede eri vururu, oconi edrezari wuale towi, tini o’bile bakasi kurururi wuale kali na. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.24"
              },
              "items": [
                {
                  "text": "1 Opi 7:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etinia endrilendri tiagoni indi eri ma agei acezu wuale mudri, miri nde acezu kuru; tiago ’diyi ovu otizaru esele be iri, ede yi mola akazarusi o’du yini miri nde edezuirisi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri so pa endrilendri tiagoni mudri drini iri ma ngukua, na ’diyi lu andraleru, na azini ’diyi lu pari etuni ’derialeru, na azini ’diyi lu uruleru, na acepi ’diyi lu pari etuni efurialeru; miri nde ri yi ma ngukua uru, osu yi ma oro vutinialeru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.4",
            "verseOrgIds": [
              "2CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.26"
              },
              "items": [
                {
                  "text": "1 Opi 7:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tini ma teza ovu driale alu; tini nyozari imvu tile, ekile ojo funi ayilerile; ka ga tre eco yi okozu alenia obi alifu na. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.38"
              },
              "items": [
                {
                  "text": "1 Opi 7:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.9"
              },
              "items": [
                {
                  "text": "Ebra 9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ede awala afa ojizu ’diyi mudri, ’ba towi kala dri ndiria azini towi kala dri ejiria, ’bani afa ojizu ani. Yi oji alenia afa edeta vezaruni ’diyi ra, te miriruri ovu atalau pini yi ojizu aleniani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.49"
              },
              "items": [
                {
                  "text": "1 Opi 7:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31"
              },
              "items": [
                {
                  "text": "Efu 25:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ede azini talapati ’diyi mudri azita yiniri vusi, o’ba yi hekalu alia, towi kala dri ndiria, azini towi kala dri ejiria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
              "2CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.48"
              },
              "items": [
                {
                  "text": "1 Opi 7:48",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ede vini mesa mudri, o’ba yi hekalu alia, towi kala ndiria, azini towi kala ejiria. Ede okele melesi turu alu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.36"
              },
              "items": [
                {
                  "text": "1 Opi 6:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ede vini azini irii ’ba edeta edepi ’diyini, irii amboruri pie, irii nde ma jotile pie, a’bu di jotile nde ma rua dria molasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
              "2CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.39"
              },
              "items": [
                {
                  "text": "1 Opi 7:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba di miri jo ma kala dri ndiria etuni efurialeru, geri uruleruria,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        }
