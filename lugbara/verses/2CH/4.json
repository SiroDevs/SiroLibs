                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ede alu indi afa eti o’bazu ’diyi, ede vini awala afa ojizu ’diyi eti yini ’diyi ma dria, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
              "2CH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "miri alu pi tiago mudri drini iri ovupi etinia ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
            "verseOrgIds": [
              "2CH.4.15"
            ]
          }
        },
        {
