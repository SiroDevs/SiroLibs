                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede vini pari edeta edezuri molasi, oconi wuale kali iri, walani wuale kali iri indi, oconi edrezari wuale mudri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
