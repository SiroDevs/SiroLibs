              "items": [
                {
                  "text": "1 Opi 7:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "afa in pa sopi piriru ’diyi, afa imvule ’diyi pie, dri iri ovupi afa piriru ’diyi ma dria ’diyi pie; emba iri ovupi afa pa sopi piriru ’diyi ma dri imvule ’diyi a’buzu ’diyi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        },
