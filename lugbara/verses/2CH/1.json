            }
          ]
        },
        {
          "text": "Azini indi isu pari edeta edezu edele molasi, Bezaleli Uri Huri mvi ma mvini edeleri ovu ’daa, bere Yehovaniri ma drilialeru. Te Sulemani pi ’ba ongulumuru be mu e’yo zizu eri vu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
