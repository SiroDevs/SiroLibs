                  "text": "1 Sur 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Te isu Daudi ji sanduku Munguni uru Kiriati­yearimuasi ’bo, cazu pari Daudini ndra edele eri ’bazuria, a’disiku eri aso hema sanduku nde dri Yerusa­lemua ’bo.) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.4",
            "verseOrgIds": [
              "2CH.1.4"
            ]
          }
        },
