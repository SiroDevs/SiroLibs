        },
        {
          "text": "Ini ’dasi Mungu e’da i Sulemani dri, ’yo tinia kini, Mi zi afa mini lele ma ma fe mi driri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
