              "items": [
                {
                  "text": "1 Sur 28:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sulemani ’yo ani Mungu tia, Mi ece ndra asi ndri­za ambo ma ati Daudi dri ra azini mi ’ba ma opi nyazu eri ma paria ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.8",
            "verseOrgIds": [
              "2CH.1.8"
            ]
          }
        },
        {
