                  "text": "1 Opi 3:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sulemani nga di tu uru ’dale pari edeta edezu edele molasi Yehova ma drilia, ovupi hema ti ecitaniriari vu, nga edeta vezaru ’diyi ede drinia alifu alu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        }
