                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sulemani nga e’yo ’yo Israeli dria ma tia, ’ba asikari alifu alu dri cepi ’diyi pi ma tia asikari turu alu dri cepi ’diyi pie, ’ba e’yo lipi ’diyi pie, ’ba ’wara dria Israeli dria ma alia, ovupi ori’ba yi ma a’bipini ma drilia ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
