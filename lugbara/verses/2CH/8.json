            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.18"
              },
              "items": [
                {
                  "text": "2 Sur 2:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diyi dria ’ba amboru ’ba dri cepiriru opi Sulemanini ’diyi, yi ’ba turu iri drini kali towi, ovupi opiru ’ba ma drilia ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        }
