            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Sulemani ’bani anzi Israelini ’diyi ma azi ati’baru azi iniri ngazu aluni ku; te eri ’ba yi ’ba a’di ’dipi ’diyiru, azini opi amboru ’ba a’dini ’diyi dri cepi ’diyiru, azini ’ba gari ombani ma driliariru, azini ’ba nzupi akanya dria ’diyi ma driliariru indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.9",
            "verseOrgIds": [
              "2CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
