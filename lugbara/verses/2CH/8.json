              "items": [
                {
                  "text": "Azi 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini ’ba dria acepi ’ba Hitini ’diyi pi ma eselia, ’ba Amorini pie, ’ba Perizini pie, ’ba Hivini pie, ’ba Yebusini pie, ovupi ndra Israe­liru ku ’diyi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba nde ’diyi ma anzipi, yini kule yi vutia angu nde ma alia, anzi Israelini ofule ku ’diyi, Sulemani oku yi okposi azi ngazu ati’baru, yi nga ovu ’dini ecazu kpere andru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
