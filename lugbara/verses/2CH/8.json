              "items": [
                {
                  "text": "Lev 25:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.28"
              },
              "items": [
                {
                  "text": "Gal 4:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
