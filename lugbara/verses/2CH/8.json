          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini azi dria Sulemanini ovu ’di edezaru engazu o’du erini e’dozu jo Yehovani ma eti sizurisi kpere azi nderini i dezuria, Ka’dini jo Yeho­vaniri de di i ’yeke kilili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
