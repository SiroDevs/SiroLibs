          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia Sulemani fe edeta vezaru Yehova dri, pari edeta edezu Yehovani erini edele jobileko ma drilialeruri ma dria, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
