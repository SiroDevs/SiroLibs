                {
                  "text": "2 Sur 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Israelini ’diyi obi yi ma adripi ati’baru ’ba alifu turu iri, oku piyi, agupianzi pie, ezoanzi pie; opa vini afa opaza yi ma dria karakarau, ji afa nde yini opaleri Samariaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.8",
            "verseOrgIds": [
