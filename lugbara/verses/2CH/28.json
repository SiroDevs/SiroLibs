                {
                  "text": "Yos 22:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’yo yi tia, Emi ngani ati’ba nde ’diyi eji ’doa aluni ku, emini e’yo ngapi ezata Yehova vuri ejipi ama driari egale’irisi, fezu e’yo onzi amani ’diyi pini ezuzu ezata ama­ni be; ezata amanirini ovule ambo­rurisi, azini vini adra amboru ovu suru Israelini ma dria indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.13",
            "verseOrgIds": [
              "2CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
