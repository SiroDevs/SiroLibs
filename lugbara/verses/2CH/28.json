              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ede vini edeta, eri ve obiese pari uruleru ’diyia, azini oni dria, azini pati ibiru ’diyi ma etia dria.",
          "type": "text",
          "attrs": {
