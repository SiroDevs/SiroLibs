                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo erini ’yele ’diyi ma joloko, geri erini dria, oko ’diyi azini vile ’diyi pie, mi ndre, yi ovu sizaru buku opi Yudani ’diyi pi ma e’yo sizuri ma alia opi Israelini ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.26",
            "verseOrgIds": [
              "2CH.28.26"
            ]
          }
        },
