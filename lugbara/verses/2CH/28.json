            }
          ]
        },
        {
          "text": "Ahazi nga vini afazu Mungu vile joa ’diyi oku, nga afazu Mungu vile joa ’diyi olinyirinyiri,nga jotile Yehova vile joa ’diyi opi ci; eri ede i dri pari edeta edezu Yerusale­mu ma kalaa dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini aku ambo ambo Yudani ’diyi ma alia Idria alu alu eri ede pari uruleru ’bani obiese vezu Mungu toko ’diyi dri, Yehova Mungu eri ma a’bipiniri ma asi engazu adraru, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        },
