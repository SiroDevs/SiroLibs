                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tiligati­pilineseri opi Asuriaari emu di eri vu ani, te fe eri dri candi’i, awuni eri dri okpo fe ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
