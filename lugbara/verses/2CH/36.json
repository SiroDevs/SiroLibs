                  "text": "Ezr 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi eri eji opi Kalideyaari yi ma dria, opi nde nga karile yini ofu seisi pari alatararu yiniri ma joa, ’bani vini yiki karilau pi vu zamva be ku, ’ba ’wara pi vu mbazau be ku indi; eri fe yi dria eri ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
