        },
        {
          "text": "’Ba angu ndea ’diyi nga Yehoa­hazi Yosia mvi ’du, nga eri ’ba opiru i ati ma paria Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoahazi ma eli de kali iri drini na ndra erini e’dozu opi nyazurisi; eri nya opi mba na Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi Misiriari nze eri opiasi Yerusalemua ra, li musoro angu nde ma dria dahabu onzi turu alu, mele onzi be alu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.19.3"
              },
              "items": [
                {
                  "text": "Eze 19:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi Misiriari ’ba Eliakimu eri ma adripini ovuzu opiru Yuda pi ma drilia Yerusalemu be, oja runi Yehoyakimu’i; te Neko ’du di Yehoahazi eri ma adripi, ji eri Misiria ra.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
