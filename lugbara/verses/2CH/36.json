            }
          ]
        },
        {
          "text": "Azini indi mbu opi Nebukadine­za ma ruaasi ra, erini ndra fezu erini oyo sozu Mungu ma rusiniri ti; te ombeni mba ’dani, asini mba ani vini kongolokoru asi ojakokoru Yehova Mungu Israeliniri vu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Drinisi ’ba dria atalau ma drilia ’diyi, ’ba nde be dria, eza vini e’yo amboru, ’yezu ekile e’yo onzikanyaru ngule onzi ’ba jururu ’diyini ’yelerile; yi eza jo Yehovani ndra ’bale alatararu Yerusalemuari ra,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        }
      ]
