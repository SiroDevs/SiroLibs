                "loc": "2KI.25.13"
              },
              "items": [
                {
                  "text": "2 Opi 25:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afazu dria Yehova vile joa, ’wara ’diyi be nyiri ’diyi be, lonyi Yehova vile joari pie, lonyi opiniri pie, lonyi ’ba ’wara erini ’diyiniri pie, afa ’diyi dria, ji yi Babulonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi eve jo Yehovaniri ra, onyo abi kaliru Yerusalemuniri va, ove opijo erini acisi dria, yi eza afazu erini onyi be ’diyi dria ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi ’ba yi opapi sei ma sia ra ’diyi, ji yi Babulonia, ’ba nde ofu di eri ma ati’baru anzipi be, ecazu kpere opi Perisiaarini e’dozu opi nyazuria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’ye di i ’dini ekile trotro ndra Yehovani i’yole Yeremia ma tisirile, cazu angu­ni ovuzu ayikosi sabato erini ’diyi ma e’yo inzizu, a’disiku erini de ovuria andrururia yi mba o’du sabatoni ma ta, eli kali aziri dezu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
