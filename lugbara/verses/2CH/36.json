        },
        {
          "text": "Zedekiani de eli be kali iri drini alu erini e’dozu opi nyazurisi; nya opi eli mudri drini alu Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
