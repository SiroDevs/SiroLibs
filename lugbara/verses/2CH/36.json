          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Kuro opi Perisiaari ma eli okori ma alia, e’yo ndra Yehovani Oyole Yeremia ma tisirini ecazu rinia ’yeke ani beni, Yehova enga Kuro opi Perisiaari ma asi e’yo ekuzu suru erini nyaleri ma eseliasi dria, si e’yo nde waraga ma alia indi, kini: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuro opi Perisiaari ’yo ’dini, Yehova Mungu ’buari fe opi nyaza angu wudrikuru drisi dria ’diyi ma dri ’bo, fe vini ma dri azita jo sizu erini Yerusalemu ovupi Yudaaria. ’Ba erini dria ’diyi ma azi ka ovu emi eselia, Yehova Mungu eriniri ma ovu eri be; eri ma tu uru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        }
