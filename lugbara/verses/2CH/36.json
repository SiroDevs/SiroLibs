          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’ye e’yo ovupi onziri Yehova Mungu eriniri ma milia, doni i e’yere nabi Yeremia ma drilia e’yo erini ’yole Yehova ma tisiri erizu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
