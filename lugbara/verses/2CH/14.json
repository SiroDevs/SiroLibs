            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.15"
              },
              "items": [
                {
                  "text": "Mik 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Zera ’ba Etiopiaari efu ndra a’di ’dizu yi be, asikari ongulumuru erini ma kalafe alifu pale alifu, gari ombani ’diyi turu na; eri eca Maresaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.9",
            "verseOrgIds": [
              "2CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Asa nga fu dri fuzu eri be, yi oti yi omba ’ dizu e’bu Zefatani ma alia Maresaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.10",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
