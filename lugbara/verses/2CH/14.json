                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi eza aku ambo ambo dria Gera­ri ma ageia, a’disiku uri Yehovani ruzuri eca yi ma dria ’bo. Opa ani aku ’diyi dria ma afa ra, a’disiku afa opaza ndra aku nde ’diyi ma alia karakarau tu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzu lico tini ’diyi indi, opa kabilo o’biru, ngamia pie, nga di emvi Yerusalemua ndo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.15",
