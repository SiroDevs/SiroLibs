              "items": [
                {
                  "text": "2 Sur 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Yehova ofu ’ba Etiopiaa ’diyi Asa pi ma drilia Yuda be ra; ’ba Etiopiaa ’diyi apa ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
