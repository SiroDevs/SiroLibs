              "items": [
                {
                  "text": "Eceza 17:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ewu erinisi Edomu mbu Yuda ruaasi amve, yi ’ba opi yi ma ngulu­pini ceni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.8",
            "verseOrgIds": [
              "2CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu nga di zo ’aa’dasi ambo erini asikari dri cepi ’diyi be, gari erini ombani be dria; enga inisi ofu ’ba Edomua eri acepi kuru ’diyi ra, ’ba gari ombani dri cepi ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.9",
            "verseOrgIds": [
              "2CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.27.40"
              },
              "items": [
                {
                  "text": "E’do 27:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Edomu mbu Yuda ma ruaasi amve kpere o’du andru’disi. Libina mbu vini eri ma ruaasi amve etu ’dasi indi, a’disiku erini Yehova Mungu i ma a’bipi­niri kule ’borisi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        }
      ]
    },
