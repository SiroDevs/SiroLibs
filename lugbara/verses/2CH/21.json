              },
              "items": [
                {
                  "text": "Neh 13:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga aci geri opi Israelini ’diyini ma alia, ekile suruti Ahabunirini ’yelerile; a’disiku Ahabu zini ovule oku erinirisi. Eri ’ye e’yo ovupi onzi Yehova ma miliari. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
