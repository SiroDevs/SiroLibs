              "items": [
                {
                  "text": "Zab 132:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova leni suru Daudiniri ma dri ja ku, aziza ndra erini azile Daudi beri ma e’yosi, ekile erini azile tala fezu eri dri anzi pie ’danirile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
