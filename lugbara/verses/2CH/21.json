                "loc": "2CH.22.1"
              },
              "items": [
                {
                  "text": "2 Sur 22:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova enga Yehoramu ma dria ’ba Filisitiaa ’diyi pi ma asi ombaru ’ba Arabuni ovupi ’ba Etiopiaa ’diyi ma kalaa ’diyi be; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
            "verseOrgIds": [
              "2CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.7"
              },
              "items": [
                {
                  "text": "2 Sur 24:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yi etu a’di ’dizu Yuda be, yi fi suru nde ma eselia okposi, yi ji afa dria ovupi opi vile joa yini isule ’diyi, agupianzi erini ’diyi piyi, oku erini ’diyi be, ’dini mva aceni eri dri aluni ku pe lu Yehoahazi, anzi erini ma eselia mva vile asizuri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’diyi ma vutia dria, Ye­hova co eri azo eri ma fi alia ecopi atipi kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 21:19"
