              "items": [
                {
                  "text": "1 Opi 11:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.23"
              },
              "items": [
                {
                  "text": "23",
