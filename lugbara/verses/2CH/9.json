          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi dria wudri­kurua ’diyi nda ovuzu Sulemani ma milia ondua Munguni ’bale eri ma asiari erizu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
