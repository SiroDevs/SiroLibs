                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.10"
              },
              "items": [
                {
                  "text": "Zab 72:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.11"
              },
              "items": [
                {
                  "text": "1 Opi 10:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ati’ba Huramuni ’diyi ati’ba Sulemanini ’diyi be, mele ejipi Ofiriasi ’diyi, eji vini sandali pati azini oni aje ambosi ’diyi be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi ede jo Yehovani ma otufe ’bani tuzuri sandali pati nde ’diyisi, azini jo opiniri ma otufe indi, ede vini eri o’diru azini o’di zaburi ngozuriru ’ba ongo ngopi ’diyi dri; afa azini ndra ’bani ndrele ’dinile angu Yudania oku nga drioni yo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi Sulemani fe opi okuru Sebaari dri afa dria erini lele ’diyi, afa dria erini a’ile ’diyi, ka ovu ngoni ti, aga afa erini ejile opi driri ma drilesi tu. ’Dini eri oja i mvi i vile angua, eri’i ati’ba erini be.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
