                }
              ]
            }
          ]
        },
        {
          "text": "Sulemani nya ndra opi Yerusalemua Israeli dria ma drilia eli kali su. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
