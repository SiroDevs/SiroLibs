        {
          "text": "Etu ndesi ’ba ’wara Israelini ’diyi pi opi ambori be do yi ani e’yere afukokoru tu, nga ’yo ani kini, Yehovani kililiru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.6",
            "verseOrgIds": [
              "2CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
