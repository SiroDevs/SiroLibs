                "loc": "2CH.11.2"
              },
              "items": [
                {
                  "text": "2 Sur 11:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.25"
              },
              "items": [
                {
                  "text": "Azi 28:25",
                  "type": "text"
                }
