                "loc": "2CH.15.2"
              },
              "items": [
                {
                  "text": "2 Sur 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te nabi Se­maya nga emu Rehoboamu pi vu, ’ba ’wara Yudaa yi okupi tualu Yerusa­lemua e’yo Sisakinisi ’diyi be, nga ’yo yi tia kini, Yehova ’yo ’dini, Emi ku ma ’bo, e’yo ’disi ma’i indi ma ku i emi Sisaki ma dria ’di. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.5",
            "verseOrgIds": [
              "2CH.12.5"
            ]
          }
        },
