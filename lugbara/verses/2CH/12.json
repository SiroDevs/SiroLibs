            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.24"
              },
              "items": [
                {
                  "text": "1 Opi 14:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
