                "loc": "1KI.14.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, eli towi Rehoboamuni opi nyazurisi, Sisaki opi Misiriari eca a’di ’dizu Yerusalemu be, a’disiku yini e’yo ezale Yehova vurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.2",
            "verseOrgIds": [
              "2CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.8"
              },
              "items": [
                {
                  "text": "2 Sur 16:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri emu gari ombani be alifu alu drini turu iri, azini ’ba ozupi akanya dria ’diyi alifu kali azia. ’Ba emupi eri be engapi Misiria ’diyi ma kalafe lakokoru-’ba Lubi piyi, ’ba Suki pie, ’ba Etiopiaa ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.3",
            "verseOrgIds": [
              "2CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga aku ovupi abi kaliru be Yudaa ’diyi o’du ra, emu kpere Yerusalemua indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.4",
            "verseOrgIds": [
              "2CH.12.4"
            ]
          }
        },
