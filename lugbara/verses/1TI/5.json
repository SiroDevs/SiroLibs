                {
                  "text": "Mat 18:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.1"
              },
              "items": [
                {
                  "text": "2 Kor 13:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma a’i asu sule ’ba ’wara azini ma ruaari ku, pe kiri ’ba e’yo eti nzepi iri kani na ’diyi ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.19",
            "verseOrgIds": [
              "1TI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.14"
              },
              "items": [
                {
                  "text": "Gal 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ega ’ba e’yo ezapi ’diyi ma dria ’ba dria ma milia, ’dini ’ba azini acepi ’diyi ma ovu urisi beni, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
