              "items": [
                {
                  "text": "Luk 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’dini e’yo siza ’yo ra, Mi ma ombe ranya ma ti erini anya turia ku, azini dika, ’Ba azi ngapiri fu dri oya erini a’izu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
