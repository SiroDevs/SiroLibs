                "loc": "ACT.20.28"
              },
              "items": [
                {
                  "text": "’Yeta 20:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’yoza ’diri ovu adaru: ’Ba azini ka azi kanisa andrizuri ndru, eri ’ba i asi azi onyiru ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.6+TIT.1.7+TIT.1.8+TIT.1.9"
              },
              "items": [
                {
                  "text": "Tit 1:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ’ba ’ba andripiri ma ovu ’ba e’yoni ndele ku, ovupi oku be alu, asi e’yere be, asisile anzuru ’Ibe, ’ba acipi kililiru, omu a’ipi avasi wa’diru, ’ba ’ba imbapi onyiru, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba atipi ewasi ku, ’ba ’ba copi Ikuri’i; te eri ma ovu ’ba e’yere, ’ba awapi mbele ku, ’ba ava ’bapi silingi ma dria kuri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.3",
            "verseOrgIds": [
              "1TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.12"
              },
              "items": [
                {
                  "text": "1 Sam 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ma ce ’ba eri vile joa ’diyi dri onyiru, anzi erini ma eri e’yo erini inzita be e’yo driasi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ’ba azini ka ni jo ini ma dri ecezu ku, eri nga kanisa Munguni agei te ngoni ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ma ovu ’ba fipi o’diruri ku, eri kazu ovuzu afusi erini ngazu ani e’dezu e’yo liza ’ba asu supirini ma alia ku; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.6",
            "verseOrgIds": [
              "1TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
