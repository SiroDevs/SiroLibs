        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.20"
              },
              "items": [
                {
                  "text": "2 Tim 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.19+EPH.2.20+EPH.2.21+EPH.2.22"
              },
              "items": [
                {
                  "text": "Efe 2:19-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ma ka ma dri ici ’dani, mi ma ni ani geri ecopi onyiru ’bani ani ovuzu jo Munguni ma aliari beni, ’di kanisa Mungu idrirurini, pati idiaferu azini jo eti e’yo adaruniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
        {
