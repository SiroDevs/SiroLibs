            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini eri ma ovu ’ba ’ba ovupi amveleru ’diyini eri ma e’yo eti nzele onyiru­ri’i, eri kazu e’dezu o’data kani emba ’ba asu supirini ma alia ku.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
