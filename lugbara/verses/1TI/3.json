              "items": [
                {
                  "text": "Mar 16:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba econi agata gazaru e’yo ’dirisi ku, e’yo zizaru vale ku adriza ’bani ani Mungu inzizuriniri ovu amboru ada:",
          "type": "text",
          "attrs": {
