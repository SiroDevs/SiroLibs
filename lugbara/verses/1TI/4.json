                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te, mi ma ga e’yo ’yoza onzi oku dezaru ’diyini o’yolerile ’diyi si.Azini mi ma o’bi mi edezu okporu adriza ’bani i ani Mungu inzizuri ma alia; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.7",
            "verseOrgIds": [
              "1TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
