              "items": [
                {
                  "text": "’Yeta 10:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te afa dria Munguni o’bale ’diyi ovu onyiru, afa aluni ma ovu gazaru ku, eri ka ovu a’izaru awa’difosi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.4",
            "verseOrgIds": [
              "1TI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "a’disiku eri ovu ’bazaru alaru e’yo Munguni pisi Mungu ziza be.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.5",
            "verseOrgIds": [
              "1TI.4.5"
            ]
          }
        }
