              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.6"
              },
              "items": [
                {
                  "text": "1 Tim 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’di­siku e’yo okpo ruani isuzuri ovu orodriru ewu were, te adriza ’bani ani Mungu inzizuri ovu orodriru e’yo driasi, te eri azi idri curu’dori pi fezu, ngapi emupi ndori be. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.8",
            "verseOrgIds": [
              "1TI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
