                }
              ]
            }
          ]
        },
        {
          "text": "yi azi ’ba ma bi oku ku, azini ’ba ma ku nyaka azini Munguni ndra ’bale ’ba a’ita be e’yo adaru nipi ra ’diyini nyazu awa’difosiri ja. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.3",
            "verseOrgIds": [
              "1TI.4.3"
            ]
          }
        },
        {
