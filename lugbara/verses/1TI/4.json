                "loc": "TIT.2.15"
              },
              "items": [
                {
                  "text": "Tit 2:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba aluni ma ’ba mi, aparakaru eli minini ovule wererisi ku, te mi ma ovu ecetaru ’ba a’ipi ’diyi dri, ’yota pisi, adriza pie, leta pie, a’ita pie, asi alaruri pie dria, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.12",
            "verseOrgIds": [
              "1TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "De nga ma emuni ku, mi ma ’ba mi asi buku laze, ’ba ma asi omizu, ’ba imbazu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.13",
            "verseOrgIds": [
              "1TI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
