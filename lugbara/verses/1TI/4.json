                "loc": "ACT.8.17"
              },
              "items": [
                {
                  "text": "8:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ku feta ovupi mi alia, ndra fele mi dri e’yo ondrizasi ’ba ’wari ’diyini yi ma dri tiria mi driariari ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.14",
            "verseOrgIds": [
              "1TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ’ba mi asi e’yo ’diyi ma dria, mi ma ovu yi ma alia asi driasi, e’yo mini agazu drileri ma e’da i ’ba dria ma milia; beni, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.15",
            "verseOrgIds": [
              "1TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
