                "loc": "ROM.11.14"
              },
              "items": [
                {
                  "text": "Rum 11:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ndre onyiru mi ngulupi ma agei tezu imbata mini be; mi ma ovu ’dani e’yo ’diyi ma alia, ka’dini mini ’yeria ’dinile mi ilia mi ngulupi pa ’ba mi eripi ’diyi be.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.16",
