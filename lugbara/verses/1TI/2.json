        },
        {
          "text": "E’yo ’dirisi ma azi okorisi, matu, ’baza pi ’yozu ’ba driasi, zi ziza pie, awa’difo feza pie, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.1",
            "verseOrgIds": [
