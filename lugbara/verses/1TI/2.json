                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ’yeta onyiru ’diyisi, a’disiku e’yo ’diyi si oku e’dapi yi ’ba Mungu inzipi ’diyiru ’diyi si si. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.10",
            "verseOrgIds": [
              "1TI.2.10"
            ]
