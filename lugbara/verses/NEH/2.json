                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.10"
              },
              "items": [
                {
                  "text": "Yer 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma fu inisi Kalitile E’buarisi muzu Yi A’di Obalakoniri vuleru cazu kpere Kali­tile Okurunya Ofuzuria, ma one abi kaliru Yerusalemuni i asupi vari, azini kalitile evele acisi ’bo ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.13",
            "verseOrgIds": [
              "NEH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.20"
              },
              "items": [
                {
                  "text": "2 Opi 20:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.30"
              },
              "items": [
                {
                  "text": "2 Sur 32:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.15"
              },
              "items": [
                {
                  "text": "Neh 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vutinia ma aga cazu Kalitile Yi ’A’diniria azini Yi Alio Opiniria indi; te pari ovuni anyapa mani tuzu dri­niari dri agazu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.14",
            "verseOrgIds": [
              "NEH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.23"
              },
              "items": [
                {
                  "text": "2 Sam 15:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.40"
              },
              "items": [
                {
                  "text": "Yer 31:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.1"
              },
              "items": [
                {
                  "text": "Yoh 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga di tu inisi acizu yi tisi, abi kaliru onezu, ma nga di dri da vile fizu Kalitile E’buarisi, emvizu ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
            "verseOrgIds": [
              "NEH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ’wa­-ra nini ma mu ngoa ya, kani ma ’ye a’dini yari ku; isu ma eceni nga e’yoni ’ba Yahudini dri ku, ’ba kuhaniru ’diyi pie, ’ba opiru ’diyi pie, ’ba ’ba dri cepi ’diyi pie, ’ba azini azi ’yepi ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.16",
            "verseOrgIds": [
              "NEH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
