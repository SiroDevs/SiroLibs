              "items": [
                {
                  "text": "Lev 23:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi isu e’yo sizaru azita ma alia kini, Yehova azi ndra azita Musa ma tisi kini, anzi Israelini ma adri boroko ma alia omu amboru mba azirisirisi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.14",
            "verseOrgIds": [
              "NEH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini kini yi ma olu e’yo, ma eku e’yo nderi aku amboru yini vusi dria, azini Yerusalemua indi kini, Emi efu mu oni dria, emi cii pati arakala mizeituni pi, mizeitu asea­rini pie, icifi malaruni pie, ituni pie, pati arakala be treri ma arakala pie, boroko sizu ekile ovupi sizarurile. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.8.15",
            "verseOrgIds": [
              "NEH.8.15"
            ]
          }
