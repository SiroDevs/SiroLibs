            "number": "2",
            "style": "v",
            "sid": "NEH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanani adripi mani ma azi alu nga emu, eri’i ’ba azini engapi Yudaa ’diyi be indi; ma nga di zi tinia oloko ’ba Yahudini yi opapi ’ba uruni jile ati’baru ’diyi ma eselia ’diyi ma e’yosi, Yerusalemu ma e’yosi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        },
