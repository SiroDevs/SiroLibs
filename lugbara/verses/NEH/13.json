                "loc": "NEH.6.14"
              },
              "items": [
                {
                  "text": "Neh 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.4"
              },
              "items": [
                {
                  "text": "Mal 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ega e’yo yini fo, Mungu mani la, yini azi atalau edeta edepirini ezale, aziza ’ba edeta edepiri pini, ’ba Levini be indirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
