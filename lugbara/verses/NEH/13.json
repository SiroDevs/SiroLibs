            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu de Yehoyada ma anzipi ma eselia, kuhani amboru Eliasibu ma anzipi ma eselia mva alu je ndra Sanibalati ’ba Horoniari ma zini okuru; e’yo ’disi ma dro eri ma vurisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
