              "items": [
                {
                  "text": "Neh 10:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.1"
              },
              "items": [
                {
                  "text": "12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Geri ’disi ma ’ba yi alaru e’yo juruni yi eselia ’diyisi dria, ma ope pari ’ba edeta edepi ’diyi pi dri ’ba Levini ’diyi be, ’ba alu alu dria azi yini vusi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ede vini e’yo feta ejani pi, ewu peleri vusi, ori kapi okori pie. Mi ega e’yo mani onyiru fo, Mungu maniri la.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
