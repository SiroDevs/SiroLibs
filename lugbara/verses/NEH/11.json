              "attrs": {
                "loc": "NEH.7.6"
              },
              "items": [
                {
                  "text": "Neh 7:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.43"
              },
              "items": [
                {
                  "text": "Ezr 2:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.2.55"
              },
              "items": [
                {
                  "text": "55",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi angu awaza nde vile adripi Yerusalemua ’diyi yi ’di; te aku Yudaa ’diyi ma alia ’ba dria alu alu adri angu yinia aku yini ma alia: yi’i ’ba Israelini, ’ba edeta edepi ’diyi pi, ’ba Levini ’diyi pie, ’ba Netini ’diyi pie, ati’ba ndra Sulemanini ’diyi ma anziyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.3",
            "verseOrgIds": [
              "NEH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.3"
              },
              "items": [
                {
                  "text": "1 Sur 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.29"
              },
              "items": [
                {
                  "text": "E’do 38:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te anzi Yudani ’diyi pi ma azi anzi Be­nyaminini be, yi adri Yerusalemua. Anzi Yudani ma eselia yi ’di: Ataya’i, Atayani Uzia mvi’i, Uziani Sekaria mvi’i, Sekariani Amaria mvi’i, Amariani Sefatia mvi’i, Sefa­tiani Mahalaleli mvi’i, yi ori’ba Perezini; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "azini vini Maaseya’i, Maaseyani Baruki mvi’i, Barukini Kolihoze mvi’i, Kolihozeni Hazaya mvi’i, Hazayani Adaya mvi’i, Ada­yani Yoyaribu mvi’i, Yoyaribuni Zekaria mvi’i, Zekariani ’ba Siloari mvi’i, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.5",
            "verseOrgIds": [
              "NEH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Perezi anziyi adripi Yeru­salemua ’diyi dria, yi ’ba okporu turu su kali azia drini aro,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        }
      ]
    },
    {
