            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba edeta edepi ’diyi ma eselia yi ’di Yedaya Yoyaribu mvi’i, Yakini pie, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraya’i, Serayani Hilikia mvi’i, Hilikiani Mesulamu mvi’i, Mesulamuni Zadoki mvi’i, Zadokini Merayoti mvi’i, Merayo­ti Ahitubu ’ba jo Munguni ma driliari mvi’i, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.11",
            "verseOrgIds": [
              "NEH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "adripi yini jo ma azi ngapi turu aro kali iri drini iri ’diyi pie; Adaya’i, Adayani Yero­hamu mvi’i, Yerohamuni Pelalia mvi’i, Pelaliani Amizi mvi, Amizini Zekaria mvi’i, Zekariani Pasuri mvi’i, Pasurini Malikiya mvi’i, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "adripi erini ’ba ’wara a’bipi ma ori’bani ’diyi pie, yi turu iri kali su drini iri; azini Amasisai’i, masisaini Azareli mvi’i, Azarelini Azai mvi’i, Azaini Mesilemoti mvi’i, Mesilemo­tini Imeri mvi’i, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "adripi yini ’ba okporu asi mba be turu alu kali iri drini aro ’diyi pie; ’ba yi driliari ovu Zabidieli Hagedolimu mvi’i.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        }
      ]
