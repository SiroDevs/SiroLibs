          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanoa pie, Adulamu pie, aku yini ’diyi pie, Lakisi pi amvu ageinia ’diyi be, Azeka pie aku erini ’diyi pie. ’Dini yi aso hema yini engazu Beeri-sebaa cazu kpere e’buti Hino­muaria. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        },
