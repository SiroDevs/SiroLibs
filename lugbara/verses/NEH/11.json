              "items": [
                {
                  "text": "Mat 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ’wara ’ba ongulumuru dri cepi ’diyi yi adri ovu Yeru­salemua; ’ba joloko acepi ’diyi nga vini odrisi ’be, ’ba alu pezu ’ba mudri ’diyi ma eselia ovuzu aku alatararu Yerusalemu ma alia, te ’ba oromi ’ba mudri ’diyi ma eselia ovuzu aku azini ’diyia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.9"
              },
              "items": [
                {
                  "text": "Lip 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ongulumuru riga asi ndriza fe ’ba a’ipi asi driasi ovuzu Yerusalemua ’diyi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
