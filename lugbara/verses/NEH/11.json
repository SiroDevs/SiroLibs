          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini ’ba Israelini ma joloko acepi ’diyi ’ba edeta edepi ’diyi pie, ’ba Levini ’diyi pie, yi ovu aku dria Yudaa ’diyi ma alia, ’ba dria alu alu awuruso yiniri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.20",
            "verseOrgIds": [
              "NEH.11.20"
            ]
          }
        },
