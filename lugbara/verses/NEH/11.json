        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benyamini anziyi yi ’di: Salu’i, Saluni Mesulamu mvi’i, Mesula­muni Yoedi mvi’i, Yoedini Pedaya mvi’i, Pedayani Kolaya mvi, Kola­yani Maaseya mvi’i, Maaseyani Itieli mvi’i, Itielini Yesaya mvi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.7",
            "verseOrgIds": [
              "NEH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ma vutia Gabai pi Salai be, ’ba turu oromi kali iri drini aro, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.8",
            "verseOrgIds": [
              "NEH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yoeli Zikiri mvi ovu yi ma drilia; te Yuda Hasenua mvi ovu ’ba iriri aku nde ma drilia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.9",
            "verseOrgIds": [
              "NEH.11.9"
            ]
          }
        }
      ]
    },
