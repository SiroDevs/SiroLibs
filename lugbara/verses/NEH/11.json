          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikilagi pie, Mekona pie, aku erini ’diyi be, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
              "NEH.11.28"
            ]
          }
        },
