                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.9"
              },
              "items": [
                {
                  "text": "2 Kor 12:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku yi dria le uri fe ama dri, ’yozu kini, Yi ma drini nga aka ra, ’dini azi nde ma ’ye i ku. Mungu la, mi fe curu’do ma dri ma mba mba fo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
