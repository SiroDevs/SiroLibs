              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.27"
              },
              "items": [
                {
                  "text": "Dan 11:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma pe ’ba ti eri vu kini, ’Yeni i mini ’yolerile aluni ku, te mi li e’yo ’diyi mi asisisi ceni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 6:9"
          },
          "items": [
