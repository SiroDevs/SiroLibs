                "loc": "LUK.8.19+LUK.8.20+LUK.8.21"
              },
              "items": [
                {
                  "text": "Luk 8:19-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Andri erini pi adripi be nga emu ra; yini pa soria amve, yi nga ’ba azini ma ti pe vunia eri omvezu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.31",
            "verseOrgIds": [
              "MRK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ongulumuruni de riria eri ageia, yi nga ’yo tinia kini, Mi lu, mi andri pi mi adripi be yi emu mi ndru amve. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.32",
            "verseOrgIds": [
              "MRK.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga e’yo omvi yi tia kini, Andri mani adripi mani be yi a’di piyi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.33",
            "verseOrgIds": [
              "MRK.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erini ’ba ripi eri ma ageia kuru ’diyi ma dri luria, eri ’yo ra, Emi lu, ma andri ma adripi yi ’doyi! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ka e’yo Munguni leleri ’ye ra, ’ba ’diri eri ma adri’i, eri ma amvi’i, eri ma andri’i.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.35",
            "verseOrgIds": [
              "MRK.3.35"
            ]
          }
        }
