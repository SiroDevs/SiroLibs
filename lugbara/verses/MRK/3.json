              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia ndi ndi, yi nga e’yo onzi wu dria ’ba ma ori dri, ezata piyi o’data yini o’dale ’diyi be dria; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.28",
            "verseOrgIds": [
              "MRK.3.28"
            ]
          }
        },
