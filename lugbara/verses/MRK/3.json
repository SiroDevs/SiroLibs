                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agyi erini ka e’yo eri ra, yi efu eri bizu, yini ’yole kini, Eri aza aza-risi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.21",
