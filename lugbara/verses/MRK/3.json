              "items": [
                {
                  "text": "Luk 12:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ’ba azini ka Orindi Alatararu o’da’i, yi ngani e’yo onzi erini wu ’dani ’dani ’de ku, te ezata ’dani ’daniri nga ovu eri ma dria- ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.29",
            "verseOrgIds": [
              "MRK.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
