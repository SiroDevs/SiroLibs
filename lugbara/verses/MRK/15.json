                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’bitisi coti, kuhani amboru piyi ’ba ’wara pie, karania pie, ’ba e’yo amapi ’diyi pie dria nga yi ti otu tualu, nga Yesuni ’i ji fe Pilato dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.1",
            "verseOrgIds": [
              "MRK.15.1"
            ]
          }
        },
        {
