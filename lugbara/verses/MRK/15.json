              "items": [
                {
                  "text": "Luk 8:2-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "De mira oku azini yi indi, ri eri ndre re; yi ma eselia Mariamu Magadaleni pi, Mariamu Yakobo wereri pi ma andriru Yose beri pie, Salome be; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.40",
            "verseOrgIds": [
              "MRK.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "oku ’diyi eri vuti bipi azi ngapi eri dri erini ovuria Galilia ’dale ’diyi; oku azini be kakau tupi eri be Yerusalemua ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        }
      ]
    },
