              "items": [
                {
                  "text": "Luk 9:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi omvi e’yo eri tia ’yozu kini, Yohana ’ba baputizi fepiri’i; ’ba azini kini Eliya’i; ’ba azini kini ’ba nabiru ’diyi ma azi aluri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
