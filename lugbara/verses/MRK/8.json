                "loc": "JHN.6.68+JHN.6.69"
              },
              "items": [
                {
                  "text": "Yoh 6:68-69",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri zi yi tia kini, Te emi ’yo emini ma a’di’i ya? Petero nga e’yo omvi, ’yo eri tia kini, Mi Kristo’i. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.9"
              },
              "items": [
                {
                  "text": "Mar 9:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga e’yo azi yi tia okposi yi ma olu e’yo erini ’ba azini ma tia ku.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
