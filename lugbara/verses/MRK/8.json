              "items": [
                {
                  "text": "Luk 14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ka ’ba ongulumuru omve i vu ’ba erini imbale ’diyi be ’bo, eri nga ’yo yi tia kini, ’Ba azini ka le mu ma vutia, eri ma ga i ma ngulupi si, ma ’du pati i dizuri, ma emu ma vutia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
