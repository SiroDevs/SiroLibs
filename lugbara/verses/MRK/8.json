              },
              "items": [
                {
                  "text": "Yoh 9:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’ba mile draza beri ma dri bi, nga eri ji akuasi amve; eri ka cucu wu eri mile efia ’bo, eri nga i dri ti drinia, eri zi tinia kini, Mi ndre afa ra ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.23",
            "verseOrgIds": [
              "MRK.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba nde nga i mile enga uru, kini, Ma ndre ’ba ra, te yini aciria yi e’da ma dri patile. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
            "verseOrgIds": [
              "MRK.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga dri ti milenia dika; eri nga angu lu ’dani, eri ovu atizaru, eri nga afa dria ndre ’yeke. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.25",
            "verseOrgIds": [
              "MRK.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.36"
              },
              "items": [
                {
                  "text": "Mar 7:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eri ti pe mvizu eri vile joa, kini, Ka tro aku ’diria ti, mi fi ku.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        }
