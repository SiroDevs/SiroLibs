              "attrs": {
                "loc": "MAT.12.38"
              },
              "items": [
                {
                  "text": "Mat 12:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.16"
              },
              "items": [
                {
                  "text": "Luk 11:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.30"
              },
              "items": [
                {
                  "text": "Yoh 6:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Farisaini nga efu ra, yi ’ba zi tinia, eceta ’buari ndruzu eri dri eri obezu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.39"
              },
              "items": [
                {
                  "text": "Mat 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.29"
              },
              "items": [
                {
                  "text": "Luk 11:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ava se ambo eri asia, kini, Anzi ’diyi yi eceta ndru a’disi ya? Ma ’yo emi tia ndi ndi, yi ngani eceta fe anzi curu’do ’diyi dri aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eci nga yi ku ra, nga fi oguru alia dika, nga zo ’aa’dasi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi dri nga avi nyaka ejizu; yi ovuni nyaka be oguru alia ku, kiri mikate alu ko’diko’di, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.14",
            "verseOrgIds": [
              "MRK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.1"
              },
              "items": [
                {
                  "text": "Luk 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.6"
              },
              "items": [
                {
                  "text": "Mar 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’ba e’yo azi yi tia okposi, ’yozu kini, Emi ndre, emi ma ovu mile be emi agei tezu akufi ’ba Farisaini ’diyinisi, akufi ’ba Herodenirisi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.15",
            "verseOrgIds": [
              "MRK.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga e’yo ’yo yi agyi bilia, kini, Amani ovule nyaka kokorurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.16",
            "verseOrgIds": [
              "MRK.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.52"
              },
              "items": [
                {
                  "text": "Mar 6:52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesuni e’yo nde niria, nga ’yo yi tia kini, Emi e’yo ega emi eselia emini ovule nyaka kokorurisi a’disi ya? Emi ndreni nga ku ya? Emi vani ku indi ya? Emi asi ovu mbazaru ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.21"
              },
              "items": [
                {
                  "text": "Yer 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.2"
              },
              "items": [
                {
                  "text": "Eze 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.12"
              },
              "items": [
                {
                  "text": "Mar 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emini ovuria mile be, emi ndreni afa ku ya? Emini ovuria bile be emi erini e’yo ku ya? Emi egani e’yo emi asia de ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.18",
            "verseOrgIds": [
              "MRK.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.41+MRK.6.42+MRK.6.43+MRK.6.44"
              },
              "items": [
                {
                  "text": "Mar 6:41-44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mani ndra mikate towi ’diyi awaria ’ba alifu towi dri, emi o’du ndra nyaka ma joloko evu tre tre si ya? Yi ’yo ra, Mudri drini iri. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.19",
            "verseOrgIds": [
              "MRK.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.6+MRK.8.7+MRK.8.8+MRK.8.9"
              },
              "items": [
                {
                  "text": "Mar 8:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mikate aziri ’ba alifu su dri, emi o’du ndra nyaka ma joloko abaka tre tre si ya? Yi nga ’yo tinia, Aziri. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.20",
            "verseOrgIds": [
              "MRK.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo yi tia kini, Emi vani di nga e’yo ku ya?",
          "type": "text",
