            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.21+MAT.15.22+MAT.15.23+MAT.15.24+MAT.15.25+MAT.15.26+MAT.15.27+MAT.15.28"
              },
              "items": [
                {
                  "text": "Mat 15:21-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga enga ’dasi, eri nga mu angu Turo pi ma ageia Sidoni beria, Eri nga fi joa, eri leni ’ba aluni ma ni ku; te econi erini i zizaru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.24",
            "verseOrgIds": [
              "MRK.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te coti oku alu, zamva erini ovu orindi onzi be, erini e’yo erini eriria ’boria, eri nga emu i eco va eri palaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.25",
            "verseOrgIds": [
              "MRK.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nde eri Giriki zani, suru yini Suro-Foenikeni. Eri nga zi tinia eri ma dro orineli onzi eri ma zamva ma ruaasi amve. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.26",
            "verseOrgIds": [
              "MRK.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo tinia kini, Mi ku anzi ma tra raka, econi nyaka anzini ’duzaru ’bezaru ocea dri ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.27",
            "verseOrgIds": [
              "MRK.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga e’yo omvi, nga ’yo eri tia kini, Ada Opi; te ocea nyiri mesa etia ’diyi yi di adri nyaka anzini o’depi vari nya’i. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.28",
            "verseOrgIds": [
              "MRK.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo tinia kini, E’yo mini ’yole ’elirisi mi mvi; orindi onzi fu eli zamva mini ma ruaasi ’boo ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.29",
            "verseOrgIds": [
              "MRK.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga mu i vile joa, eri nga isu zamva la pari dria, de orindi onzi fu ruaniasi ’bo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.30",
            "verseOrgIds": [
              "MRK.7.30"
            ]
          }
        }
      ]
    },
