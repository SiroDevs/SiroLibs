              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dika eri nga fu Turo ma tia, eri mu geri Sidoniarisi cazu miri Galilinia, angu Dekapoli ma ageiari agazu agaduasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
