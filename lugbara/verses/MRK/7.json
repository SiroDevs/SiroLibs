                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "erini angu luria ’bua uru eri nga ava se, nga yo tinia kini, Efata, efini kini, Ma zi i mgbo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
