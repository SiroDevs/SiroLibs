          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bileni nga i zi mgbo, leri ndre ma isu nga ovu ayuzaru, eri nga ani e’yo ’yo ti alasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
