                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’ba nde ji a’dule ’ba tre ma eseliasi amve, eri nga drianzi osu bilenia, eri nga cucu wu, nga andreni elo; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
