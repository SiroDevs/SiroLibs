              "items": [
                {
                  "text": "Mar 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga ’ba bile dirinyaru beri eji eri vu indi, eri adri e’yo ombe ombe erini e’yo ’yoria; yi nga zi tinia eri ma ti dri drinia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
            "verseOrgIds": [
