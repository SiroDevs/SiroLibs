              "items": [
                {
                  "text": "Kal 20:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te yi dria mvu ndra afa mvuza alu orindiniri. A’disiku yi mvu yi efupi Oni orindini yi vuti bipiri ma aliasiri ra, te Oni nderi Kristo’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.4",
