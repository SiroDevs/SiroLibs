          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1+NUM.25.2+NUM.25.3+NUM.25.4+NUM.25.5+NUM.25.6+NUM.25.7+NUM.25.8+NUM.25.9+NUM.25.10+NUM.25.11+NUM.25.12+NUM.25.13+NUM.25.14+NUM.25.15+NUM.25.16+NUM.25.17+NUM.25.18"
              },
              "items": [
                {
                  "text": "Kal 25:1-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama ma ’ba ali, ’ba azini yi ma eselia ’diyini o’balerile ku; yi odra ani o’du alu ma alia ’ba alifu kali iri drini na. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.8",
            "verseOrgIds": [
              "1CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.5+NUM.21.6"
              },
              "items": [
                {
                  "text": "Kal 21:5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama ma o’bi vini Opini, ’ba azini yi eselia ’diyini o’bilerile ku; yi ja dri urini yi ogalerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
            "verseOrgIds": [
              "1CO.10.9"
            ]
          }
