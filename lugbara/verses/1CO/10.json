            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dini ’ba mani lele ’diyi, emi ma apa inzita wura toko inzizurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.14",
            "verseOrgIds": [
              "1CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ’yo ekile ’ba onduaru mal tiarile; emi ma ama e’yo mani ’yoleri emi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.15",
            "verseOrgIds": [
              "1CO.10.15"
            ]
          }
        },
        {
