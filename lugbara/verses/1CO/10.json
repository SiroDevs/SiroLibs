              ]
            }
          ]
        },
        {
          "text": "E’yo ’diyi yi ovu ecetaru ama dri, ama kazu li ’bazu e’yo onzisi yini ndra li ’balerile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.6",
            "verseOrgIds": [
              "1CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.6"
              },
              "items": [
                {
                  "text": "Efu 32:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ma ovu ’ba wura toko inzipi ’diyiru, ’ba azini yi eselia ’diyile ku; erini ovule sizarurile kini, ’Ba ri va nyaka nyazu, afa mvuza mvuzu, nga enga vini avita avizu ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.7",
            "verseOrgIds": [
              "1CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
