              "items": [
                {
                  "text": "2 Kor 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba i ecipi Opi beri ofu orindi aluru. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.17",
            "verseOrgIds": [
              "1CO.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi apa ali ’bazasi apa apa. Ezata azini cina ’bani ezale ’diyi ovuni yi ma ruaa ku, yi amveleru; te ’ba ali ’bapiri i ma ngulupi ma rua eza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.18",
            "verseOrgIds": [
              "1CO.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 6:19"
          },
          "items": [
