              },
              "items": [
                {
                  "text": "1 Kor 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Kor 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kani emi nini kini rua emini ovu hekalu Orindi Alatararu ovupi emi alia, emini a’ile Mungu dririni ku ya? Emi ovuni afa emi ngulupiniru ku; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.19",
            "verseOrgIds": [
