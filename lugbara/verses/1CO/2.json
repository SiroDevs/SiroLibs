            "number": "2",
            "style": "v",
            "sid": "1CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.14"
              },
              "items": [
                {
                  "text": "Gal 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ma ede ndra e’yo ma asia kini ma ngani e’yo azini ni emi eselia ku pe Kristo bani yini di pati ruaari’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.2",
            "verseOrgIds": [
              "1CO.2.2"
            ]
          }
        },
