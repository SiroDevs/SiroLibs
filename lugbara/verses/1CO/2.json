              "type": "text"
            }
          ]
        },
        {
          "text": "Te ti, ama adri e’yo onduaru ’yo ba mbapi e’yosi ’bo ’diyi ma eselia, te ovuni ondua ewu ’doriniri’i ku, kani ’ba ’ba dri cepi ewu ’dosi yi ojapi tokoru ’diyiniri’i ku, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.6",
            "verseOrgIds": [
              "1CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
