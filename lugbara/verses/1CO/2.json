              "items": [
                {
                  "text": "Kol 1:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’ba dri cepi ewu ’dosi ’diyi ma azi aluni nini ondua ’diri ku; a’disiku ka ndra ni ra te’do dini ndra Opi dizaniri pati ruaa ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.8",
            "verseOrgIds": [
              "1CO.2.8"
            ]
          }
        },
        {
