                "loc": "2CO.10.1"
              },
              "items": [
                {
                  "text": "2 Kor 10:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ovu ndra emi eselia okpo kokoru, uri be, azini rua yaza be tu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo mani ’yoleri pi e’yo oluza mani be, ovuni e’yo ’yoza ’ba obezu onduasiri be ku, te e’yo eceza Orindinisi azini okpo­nisi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.4",
            "verseOrgIds": [
              "1CO.2.4"
            ]
          }
        },
