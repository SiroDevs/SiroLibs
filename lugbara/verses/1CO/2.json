                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ama adri ondua Munguniri ’yo e’yo zizasi, ondua ovupi ndra zizaru Munguni pele okokele de nga ewu azini ’diyini ovuria yoria diza amani ma e’yosiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.7",
            "verseOrgIds": [
              "1CO.2.7"
            ]
          }
        },
