                {
                  "text": "1 Kor 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma’i, ma adripi, mani emuria emi vu, ma ecani ndra e’yo eti nzeza Munguni oluzu emi tia e’yo ’yoza ndrizaru tu kani ondua agapi turisi, ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
              "1CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
