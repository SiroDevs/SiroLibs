                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba orindiniri adri e’yo dria va ra, te ’ba aluni vani agu nderi ma e’yo ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.15",
