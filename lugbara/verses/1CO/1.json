        {
          "text": "eri’i, eri nga emi ’ba okporu kpere asizaniria asu suza kokoru o’du Opi amani Yesu Kristoniri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
