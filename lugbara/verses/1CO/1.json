                  "text": "Yoh 1:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’yo ’dini, efini emi dria alu alu ’yo kini, Ma’i ma ’ba Pauloni, te Ma’i ma ’ba Apoloni, te Ma’i ma ’ba Kefani, te Ma’i ma ’ba Kristoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa Kristo ma esele ndu ndu ya? Di Pauloni pati ruaa emisi ra ya? Emi bi baputizi Paulo ma rusi ra ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        },
        {
