                }
              ]
            }
          ]
        },
        {
          "text": "Te ma matu ’ba emi vu, ma adripi, ru Opi amani Yesu Kristoni­risi, emi dria ma ’yo e’yo alu, azini emi ma ovu esele coza be emi eselia ku, te emi ma eci emi tualu kilili asisile alusi, egata alusi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
