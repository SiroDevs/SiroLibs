                  "text": "Tit 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’dini emi eceni afa feza azinisi aluni ku, emini e’data Opi amani Yesu Kristoni i e’dazuri teria; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
