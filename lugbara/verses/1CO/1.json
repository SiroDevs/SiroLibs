              "items": [
                {
                  "text": "Rum 16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma awa’difo fe Mungu dri mani baputizi fele ’ba aluni emi eseliari dri kurisi, pe Kirisipo pi dri Gayo be; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba aluni kazu ’yozu emi a’i baputizi ma rusi ’dini ku beni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
