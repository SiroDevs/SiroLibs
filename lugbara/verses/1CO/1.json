                "loc": "1CO.16.15"
              },
              "items": [
                {
                  "text": "1 Kor 16:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Te ma fe baputizi ’ba Setefana vile joa ’diyi dri indi. Te ma nini ku kani ma fe baputizi ’ba azini dri ra yani.) ",
          "type": "text",
          "attrs": {
