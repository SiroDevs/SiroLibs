                "loc": "PHP.3.17"
              },
              "items": [
                {
                  "text": "Fil 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi si emi ’yetasi male,ekile mani ma sile yetasi Kristolerile",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
