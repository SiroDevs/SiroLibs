          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ka nya ra, ka mvu ra, rua ma e’yo vakokoru, eri e’yo liza nya azini mvu i ngulupi ma ruaa ceni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
            "verseOrgIds": [
