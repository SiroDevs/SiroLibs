                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te paleko dria emini mikate ’diri nyaria, azini okele ’diri mvuria, emi drata Opini ece, de nga eri ecani ku.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
