          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.5"
              },
              "items": [
                {
                  "text": "Ebra 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ka e’yo amani li ra de Opini ama co imbataruni, kazu e’yo amani lizu onzi wudrikuru be ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi, adripi mani, emini emi okuria tualu nyaka nyazu, emi te emi azini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.33",
            "verseOrgIds": [
              "1CO.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba azini ka ovu abiri be, eri ma nya i vile joa; emi kazu emi okuzu e’yo liza isuzu’i ku. Te ma nga e’yo acepi ’diyi ede mani ngaria ecaria.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
            "verseOrgIds": [
              "1CO.11.34"
            ]
          }
        }
