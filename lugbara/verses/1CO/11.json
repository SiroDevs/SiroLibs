                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba ma o’bi e’yo i vileri oko, ’dinile ma nya mikate nde ma azi, ma mvu okele nde ma alia ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.28",
            "verseOrgIds": [
              "1CO.11.28"
            ]
          }
        },
