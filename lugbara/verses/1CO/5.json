        },
        {
          "text": "Ma si ndra e’yo emi vu waraga mani ma alia kini emi ma eci emi ovuzu ’ba ali o’bapi ’diyi be ku; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.9",
