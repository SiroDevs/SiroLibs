          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te emi ovu afuru! Emi ovuni candisi, ’ba e’yo ’diri ’yepiri nzezu emi eselia ani ra ’dini ku.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.2",
