            }
          ]
        },
        {
          "text": "’Ba azita kokoru ’diyi vu ma eca ovu ekile ’ba azita koko­ruriru-mani ovuria azita kokoru Mungu vu ku, te azita be Kristo vu -ma ma isu ’ba azita kokoru ’diyi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.21",
            "verseOrgIds": [
              "1CO.9.21"
            ]
          }
        },
