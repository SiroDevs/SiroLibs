                "loc": "ACT.22.17"
              },
              "items": [
                {
                  "text": "22:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ovuni ’ba ti peleriru ku ya? Ma ndreni Yesu Opi amani ma’i ku ya? Emi ovuni azi pamvu mani Opi ma alia ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.1",
            "verseOrgIds": [
              "1CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.2"
              },
              "items": [
                {
                  "text": "2 Kor 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ka tro ovu ’ba ti peleriru ’ba azini vu ku ti, ma ovu ’ba ti peleriru emi vu ra; a’disiku e,yo mani ovuzu ’ba ti pele Opi ma aliariruri, ecetani bani emi’i.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo mani omvile ’ba ma e’yo ozipi ’diyi ma tiari eri ’di. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.3",
            "verseOrgIds": [
              "1CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.8"
              },
              "items": [
                {
                  "text": "Luk 10:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Feni ama dri okpo nyaka nyazu azini afa omvuza mvuzurini ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.4",
            "verseOrgIds": [
              "1CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.42"
              },
              "items": [
                {
                  "text": "Yoh 1:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Feni ama dri okpo acizu oku amani amvipi e’yo a’ipiruri be, ekile ’ba ti opele azini ’diyile, adripi Opini ’diyi pie, Kefa be ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.5",
            "verseOrgIds": [
              "1CO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kani kiri ama’i Baranaba be, feni okpo ama dri azi ngale drisiri kuzu ja ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.6",
            "verseOrgIds": [
              "1CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asikari ngori mu ombaa i ma ngulupi ma afasini ya? ’Ba ngori ka zabibu pati esi amvua, ngani efini nya ku ya? ’Ba ngori ka ndri oce, ngani lesuni mbe ku ya?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.7",
            "verseOrgIds": [
              "1CO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.7",
            "verseOrgIds": [
              "1CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo mani ’yole ’diri eri ’bani ’yoleniri’i ya? Azita ’yoni trotro ’dinile indi ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.8",
            "verseOrgIds": [
              "1CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.4"
              },
              "items": [
                {
                  "text": "Azi 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.18"
              },
              "items": [
                {
                  "text": "1 Tim 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku eri ovu sizaru azita Musani ma alia kini, Mi ma ombe ranya ma ti, erini anya oturia ku. Mungu ega e’yo ranyani ra ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.9",
            "verseOrgIds": [
              "1CO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.6"
              },
              "items": [
                {
                  "text": "2 Tim 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’yoni bani e’yo amanisi ku ya? Ada, si e’yo amanisi, a’disiku onyiru ’ba amvu ’yapiri ma ’ya asi tezasi, azini ’ba anya copiri ma co asi tezasi, kini, i nga efiniri nya ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.10",
            "verseOrgIds": [
              "1CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.27"
              },
              "items": [
                {
                  "text": "Rum 15:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ka afa orindini ri emi vu, ka’dini eri e’yo amboru ama ka afa loza rua ma aza kozuri isu emi vu ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.11",
            "verseOrgIds": [
              "1CO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.34"
              },
              "items": [
                {
                  "text": "’Yeta 20:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.7"
              },
              "items": [
                {
                  "text": "1 Kor 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.9"
              },
              "items": [
                {
                  "text": "2 Kor 11:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azini ka ovu okpo be ’yezu ’dinile emi vu, agapiri ama’i ku ya?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.12",
            "verseOrgIds": [
              "1CO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ti, ama ’yeni okpo ’dirisi ku, te ama a’i candi dria, ama kazu e’yo baru Kristoniri ogazu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.12",
            "verseOrgIds": [
              "1CO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.1+DEU.18.2+DEU.18.3"
              },
              "items": [
                {
                  "text": "Azi 18:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.8"
              },
              "items": [
                {
                  "text": "Kal 18:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nini kini ’ba azi alatararu ngapi hekalua ’diyi, yi adri afa hekaluni nya ra ku ya? ’Ba azi ’yepi pari edeta edezuria ’diyi adrini afa pari iedeta edezuria ’diyi ma azi nya ra ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.13",
            "verseOrgIds": [
              "1CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.10"
              },
              "items": [
                {
                  "text": "Mat 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.7"
              },
              "items": [
                {
                  "text": "Luk 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.6"
              },
              "items": [
                {
                  "text": "Gal 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Opi azi kini ’ba e’yo bari olupi ’diyi ma isu afa yi ma idri ma aza kozuri e’yo barisi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.14",
            "verseOrgIds": [
              "1CO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
