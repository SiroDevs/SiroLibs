              "1CO.9.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.3"
              },
              "items": [
                {
                  "text": "’Yeta 18:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma ’yeni ani afa ’diyi ma azi aluni ku, azini vini ma sini e’yo ’diri eri ma ovu ani ’yezaru ma vu ’dini ku. Te mani drazuri onyiru aga ’bani e’yo mani ma enyazuri ’bazu tokoruri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.15",
            "verseOrgIds": [
              "1CO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.20.9"
              },
              "items": [
                {
                  "text": "Yer 20:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ka e’yo bari olu, ’di ovuni e’yo mani ma enyazuri ku; mi ma mi mi; ada, candi ma dri ma ka e’yo bari olu ku! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.16",
            "verseOrgIds": [
              "1CO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
