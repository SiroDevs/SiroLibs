                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Curu’do, e’yo afa okuzu ’ba alatararu ’diyi ma aza kozuri ma e’yosi ekile mani e’yo azile kanisa Galatiaa ’diyi ma tiarile, emi ma ’ye ’dinile indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 16:2"
          },
          "items": [
