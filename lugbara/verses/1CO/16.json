                "loc": "ACT.20.7"
              },
              "items": [
                {
                  "text": "’Yeta 20:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sabato ma o’du alu vusi dria, emi dria alu alu ma ’ba afa kalaa tani mbazu i vu ci, ekile ini drileba isulerile, ’dini emi ma nga afa azini oku mani ecaria ku beni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma ka eca ra, ma nga ’ba emini opele waragasi ’diyi ma ti pe afa feza emini jizu Yerusalemua. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ka ovu ’yeke mani muzu indi, yi nga mu ama be.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
