                "loc": "JAS.1.5"
              },
              "items": [
                {
                  "text": "Yak 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova fe Sulemani dri ondua ekile erini azile eri tiarile; asi anzuru ovu Hiramu pi ma eselia Sulemani be; te ’ba ’diyi iri tro eci ti yi ma eselia e’yo azizasi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
