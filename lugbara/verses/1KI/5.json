              "items": [
                {
                  "text": "Isa 9:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do Yehova Mungu mani fe ava liza ma dri angu ma kalaasi dria ra; ari’ba yo, e’yo ecapi drileonziruri vini yo. ",
          "type": "text",
          "attrs": {
