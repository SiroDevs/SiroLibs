                  "text": "Azi 31:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Indi vini ima nga adri anzi Israelini ma eselia, ma ngani suru mani Israeliniri ku Itoko ku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
    },
