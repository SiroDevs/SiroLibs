              "items": [
                {
                  "text": "Efu 30:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri a’bu jo nderi dria dria melesi cazu jo ndeni i dezuria dria, Eri a’bu pari edeta edezu pari e’yo ecezaniri ma aliari ma rua melesi indi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        }
