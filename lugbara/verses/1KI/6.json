          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Sulemani si jo nderi, eri de eri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abi alialeru ’diyi eri ede pati osiza marionisi; engazu nyakua cazu abi dria uru eri a’bu eri dria alenia pati osizasi; azini eri a’bu jo ale vari pati osiza masanisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
