          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Yehovani ma ndu ovu ’bazaru eli sunsi mba Zivinisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli mudri drini alurisi, mba aro Bulinirisi, yi de jo nderi eseleni be dria, wurani vusi dria. Eri si jo nderi eli aziri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
