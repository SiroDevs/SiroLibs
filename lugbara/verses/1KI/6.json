            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.6+1KI.8.7+1KI.8.8+1KI.8.9+1KI.8.10"
              },
              "items": [
                {
                  "text": "1 Opi 8:6-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede pari e’yo ecezaniri jo ma alia alialeru, sanduku aziza Yehovaniri ’bazu alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pari e’yo ecezaniri ma oconi wuale kali iri, walani wuale kali iri, oco edrezarini wuale kali iri; eri a’bo eri rua mele alatararurisi. Azini eri ede pari edeta edezuri pati marionisi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Sulemani a’bu jo ale dria dria mele alatararurisi, eri ase anziriku meleru pari e’yo ecezaniri drilia, eri a’bu ruani melesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
