                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pari e’yo ecezaniri ma alia eri ede kerubi iri pati mizeitunisi, yi iri tro ma zoza wuale mudri, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ke­rubi ma opile alu ovu wuale towi, opile azini ovu wuale towi indi; engazu opile drilia cazu opile drile aziniria ovu wuale mudri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ke­ru bi azininiri ma zoza ovu wuale mudri; kerubi iri nde ’diyi ovu o’bizaru tro tro, wura yini si yi si si. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubi aluri ma zoza ovu wuale mudri, te kerubi aziniri ’dini indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.20"
              },
              "items": [
                {
                  "text": "Efu 25:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.37.9"
              },
              "items": [
                {
                  "text": "37:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.5.8"
              },
              "items": [
                {
                  "text": "2 Sur 5:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ’ba kerubi ’diyi jo ’a’alesiria, te kerubi ’diyi ma opile ovu ajazaru, ’dini opidrile kerubi alurini do abi rua, azini opidrile kerubi azinirini elo abi aziniri ma rua; te opidrile yini isu ti jo agaduaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri a’bu kerubi nde ’diyi melesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te jo ma abi rua dria, adaru dria jo alesi azini amvelerulesi eri opa wura kerubi pini, pati ituni pie, fu ayizaru ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri a’bu jo ale vari dria melesi, jo alialeru azini amveleru indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.7"
              },
              "items": [
                {
                  "text": "Yoh 10:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te pari ’bani fizu pari e’yo ecezaniriari, eri ede jotileni pati mizeitunisi; pati i’dile jotile kalaa ’diyi, alale uruleruri be, ovu abi nde ma esele alu towiniri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ede jotile iri pati mizeitunisi, eri opa wura kerubi pini yi ruaa, ituni pie, fu ayipi ’bo ’diyi pie; eri a’bu rua yini melesi, eri a’bu kerubi pi ma rua itu be melesi indi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        }
      ]
    },
