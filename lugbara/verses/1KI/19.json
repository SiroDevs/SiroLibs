        {
          "text": "Eri la va o’du kozu pati ekile urukoleri ma etia; te mi ne, malaika elo eri, ’yo eri tia kini, Mi nga, mi nya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri lu, te mi ne, enya ovuzaru aciolusiri ovu eri ma drilia ogogo, imvu yi be alenia indio Eri nya, eri mvu, la va dika. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.6",
            "verseOrgIds": [
              "1KI.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te malaika Yehovani eca dika pale iri, elo eri, ’yo ra, Mi nga, mi nya, aci kazu mi okpo ndezu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
              "1KI.19.7"
            ]
