              "items": [
                {
                  "text": "2 Sur 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi fe daha­buni ecazu Yerusalemua onile, pati marioni kakau ekile pati elioru zopi angu ’dalaria ’diyile. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
