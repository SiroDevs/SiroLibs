                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini opi ede vini oguna amboru ewasisi indi, eri a’bu ruani mele alatararu agapirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
