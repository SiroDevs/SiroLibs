          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te mele ecapi Sulemani vu eli alusiri ma nziza ovu mele onzi turu azia kali azia drini azia, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
