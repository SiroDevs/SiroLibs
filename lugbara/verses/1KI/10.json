                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opi okuru Sebaari ka e’yo kuza Sulemanini ru Yehovani­siri eri ra, eri emu eri o’bizu zita ewarusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri eca Yerusalemua ’ba kakau be, yi eji afa eri ma vutisi, ngamia afa aji be arikariru ejipi ’diyi be, mele kakau pie, oni ajeambosi ’diyi pie; te eri ka eca Sulemani vu eri nze eri tia e’yo ovupi eri ma asiari dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.5"
              },
              "items": [
                {
                  "text": "O’be 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.50.4"
              },
              "items": [
                {
                  "text": "Isa 50:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Sulemani ece e’yo erini zile ’diyi dria; e’yo aluni opini ndepi ra, erini ecole ecele eri dri kuri yo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.3",
            "verseOrgIds": [
              "1KI.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi okuru Sebaari ka ondua Sulemanini pi ne jo erinisileri pie, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.4",
            "verseOrgIds": [
              "1KI.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.16"
              },
              "items": [
                {
                  "text": "1 Sur 26:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nyaka mesa erini ma driari pie, riza ’ba erinini pie, azi agei teza ’ba azi ngapi eri dri ’diyini pie, bongo yini pie, ati’ba okelea erini fepi mesaa ’diyi pie, geri erini tuzu fizu jo Yehovani ma aliari pie dria, ava erini oti ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri ’yo opi tia, E’yo mani erile angu ma ngulupini ma alia, ’yeta mini pisi ondua mini beri, yi ovu e’yo kuza adaruri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.6",
            "verseOrgIds": [
              "1KI.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ti, ma a’ini ndra e’yo nderi ku, de nga ma emuni nezu ma milesi ku; te mi ne, yi eceni ma dri e’yo nde ma aliniri nga ku; te ondua mini pi lonyi mini be yi aga e’yo kuza mani erile ndrari ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.7",
            "verseOrgIds": [
              "1KI.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.8.34"
              },
              "items": [
                {
                  "text": "O’be 8:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayiko ’ba mini ’diyi dri! Ayiko ati’ba mini pa sopi mi drilia ’dani ondua mini eripi ’diyi dri! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.8",
            "verseOrgIds": [
              "1KI.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
