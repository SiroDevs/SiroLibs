                  "text": "Isa 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Opi ovu oguru ongulumuru Tarisisini be acizu yi mirini dria, tualu oguru ongulumuru Hiramuni be. Pale alu eli vusi, oguru ongulu­muru Tarisisini nde ’diyi adri eca, mele ejizu, dahabu pie, ewasi pie, emgbeleke pie, aria sobi be taya ndrizaru ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
