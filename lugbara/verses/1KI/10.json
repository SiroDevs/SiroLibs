                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.10"
              },
              "items": [
                {
                  "text": "2 Sur 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te indi vini oguru ongulumuru Hiramuni mele ejipi engazu Ofiriasiri, yi eji pati sandalini kakau tu Ofiriasi oni aje ambosi ’diyi be. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.11"
              },
              "items": [
                {
                  "text": "2 Sur 9:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te opi ede pati sandali ’diyi jo Yehovani ma agoferu, opi vile jo ma agoferu indi, ede vini eri o’diru azini o’di zaburi ngozuriru ’ba ongo ngopi ’diyi dri; pati sandalini ’diyile ecani dika ku, ’ba neni nga vini ’dinile ku ecazu kpere andru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te opi Sulemani fe opi okuru Sebaari dri afa dria erini lele ’diyi, afa dria erini a’ile ’diyi, afa Sulema­nini fele lonyi opini ma eseliasi ’diyi ma dria. ’Dini eri oja i, mvi i vile angua, erii ati’ba ini be.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        }
      ]
    },
