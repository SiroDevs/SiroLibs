              "items": [
                {
                  "text": "Gal 4:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini drinia orodri azini ’ba afa ozipi ’diyi pini ejileri, ’ba afa jepi ’diyi pie, opi dria ’ba yi osapi suru azini ma eselia ’diyini pie, ’ba ’ba dri cepi angu ndea diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi Sule­mani ede gombere amboru turu iri mele dile dirisi; mele ovupi gombere alu alu ma aliari ovu sekeli turu azia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.16",
            "verseOrgIds": [
              "1KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.26"
              },
              "items": [
                {
                  "text": "1 Opi 14:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.2"
              },
              "items": [
                {
                  "text": "7:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini eri ede gombere turu na mele dile dirisi; mele ovupi gombere ’diyi alu alu ma aliari ma o’bizani nziza na; te opi o’ba yi jo oce Leba­noniarini ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
