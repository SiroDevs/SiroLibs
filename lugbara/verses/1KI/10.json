                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akanya Sulemanini yi akanya engapi Misi­riasi ’diyi; ’ba afa opini jepi ’diyi a’i yi nguluru nguluru, yi ofe yi ngulu vusi ngulu vusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
