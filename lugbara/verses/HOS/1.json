            {
              "text": "18:1–20:21; 2 Sur 26:1–27:8; 28:1–32:33",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo Yehovani ecapi Hosea Beeri mvi vuri o’du Uzia pinisi, Yotamu pie, Ahazi pie, Hezekia pie, yi opi Yudani, azini o’du Yeroboamu Yoasi mvi, opi Israelinirinisi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
