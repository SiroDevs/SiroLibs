          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga eca ’dini, Yehova ka le’yo ’diyi ’yo Yobu tia ’bo, Yehova nga ’yo Elifazi ’ba Temanini ma tia kini: Emi aoko fu ma mi agyi iri ’diyi be; emini e’yo mani ’yole kililiru, ati’bo mani Yobuni ’yolerile, ’dini kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
