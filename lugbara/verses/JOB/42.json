            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi emi ma obi monio aziri ndriago aziri be emi dri, muzu ati’bo mani Yobu vu, edeta vezaru edezu emi ngulupisi; te ati’bo mani Yobuni nga Mungu zi emi dri, a’disiku ma nga e’yo erini a’i ra, ma kazu emi ’yezu onduaako emini vusi ku; a’disiku emini e’yo mani ’yole kililiru ati’bo mani Yobuni ’yolerile kurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini Elifazi ’ba Temanini pi, Bilidadi ’ba Suhini pie, Zofari ’ba Naamatini be, nga mu ’ye Yehovani azile yi ma tiarile; Yehova nga di Yobuni a’i ra.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
