                "loc": "JOB.42.8"
              },
              "items": [
                {
                  "text": "Yob 42:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.14+JAS.5.15+JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.16"
              },
              "items": [
                {
                  "text": "1 Yoh 5:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te di curu’do, mi omvi oku nde agupi nderi vu; te eri nabini, eri nga Mungu zi misi, mi nga ovu ani idriru. Te mi ka nga eri omvi ku, mi ma ni kini mi nga dra ada, mi’i ’ba dria mini ovuzu yi be ’diyi pie dria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.7",
            "verseOrgIds": [
              "GEN.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.7",
