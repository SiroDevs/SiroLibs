                "loc": "PSA.105.14"
              },
              "items": [
                {
                  "text": "Zab 105:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.12"
