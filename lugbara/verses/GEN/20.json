                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri eca ’dini, Munguni ndra feria mani acizu abazaru engazu ma ati ma joa, ma ’yo ndra eri ma tia ’dini kini, Mi ma ece asi ndriza ma dri ’dini: pari dria amani ngazu fizuria, mi ma ’yo e’yo manisi ’dini kini, Agu ’diri eri ma adripini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.13",
            "verseOrgIds": [
              "GEN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.16"
              },
              "items": [
                {
                  "text": "E’do 12:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abimeleki nga kabilo pi ’du ti be, ati’ba agupiru ’diyi pie, ati’ba okuru ’diyi be, nga yi fe Iburahimu dri, oku erini Sarani omvizu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.14",
            "verseOrgIds": [
              "GEN.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.9"
              },
              "items": [
                {
                  "text": "E’do 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.47.6"
              },
              "items": [
                {
                  "text": "47:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abimeleki nga ’yo, Mi ndre, angu mani ovu mi drilia; mi eco ovu pari mini leleria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.15",
            "verseOrgIds": [
              "GEN.20.15"
            ]
          }
        },
