                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iburahimu nga enga ’darisi, nga mu angu Urulerua, nga ovu Kadesi pi ma eselia Suri be; nga ovu ani’boru angu Geraria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.1",
            "verseOrgIds": [
              "GEN.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
