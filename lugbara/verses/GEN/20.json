              },
              "items": [
                {
                  "text": "26:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iburahimu nga oku ini Sara ma e’yo ’yo ’dini kini, ’Diri ma amvipini. Abimeleki opi Gerariari nga di ’ba ti pe Sarani ejizu i vu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.2",
            "verseOrgIds": [
              "GEN.20.2"
            ]
          }
        },
        {
