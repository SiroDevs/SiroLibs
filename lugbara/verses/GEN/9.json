              "attrs": {
                "loc": "2PE.3.5"
              },
              "items": [
                {
                  "text": "2 Pet 3:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga aziza mani fe pa sozu emi be okporu ’dani; ma ngani afa dria rua be ’diyi ofu yi tizasi dika ku, yi tiza ngani ovu nyaku dri jazu dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 9:12"
          },
          "items": [
