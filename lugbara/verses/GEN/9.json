              },
              "items": [
                {
                  "text": "Mat 26:26-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aziza mani azile ama eselia emi be, afa idriru ovupi emi be Munguni ’bale ’diyi pie driari ma eceta, kpere a’bianzi vu ’dani ’daniri, eri’do: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.12",
            "verseOrgIds": [
              "GEN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gari mani ’ba iritia, eri nga ovu ecetaru aziza ama eselia nyaku beri ecezu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.13",
            "verseOrgIds": [
              "GEN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, ma ka nga iriti eji nyaku a’buzu, garini nga i e’da iriti ma alia, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
              "GEN.9.14"
            ]
          }
        },
