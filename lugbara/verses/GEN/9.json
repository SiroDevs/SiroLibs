              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.1"
              },
              "items": [
                {
                  "text": "E’do 8:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma aziza nde azi afa idriru ovupi emi be ’diyi be dria, aria piyi, anyapa akua ’diyi pie, anyapa asea ovupi emi be ’diyi pie dria, anyapa dria efupi maburuasi ’diyi be kpere anyapa nyakua ’diyi dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
            "verseOrgIds": [
              "GEN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
