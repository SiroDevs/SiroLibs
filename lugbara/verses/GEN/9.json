                  "text": "E’do 1:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi’i, emi ma oti anzi tu, emi ezu kakau, emi ma oti kakau nyakua, emi ere emi tre alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.7",
            "verseOrgIds": [
              "GEN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
