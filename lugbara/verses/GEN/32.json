              },
              "items": [
                {
                  "text": "O’be 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri nga yi azi kini, Emi ma ’yo opi mani Esau ma tia ’dini: Mi ati’bo Yakobo ’yo ’dini, Ma ovu ndra Labani vu ani’boru, tezu ’dale kpere curu’do; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.4",
            "verseOrgIds": [
              "GEN.32.4"
            ]
          }
        },
        {
