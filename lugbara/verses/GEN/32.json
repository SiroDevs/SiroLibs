                  "text": "33:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma ovu ti piyi be, akanya pie, anyapa o’biru pie, ati’ba agupiru ’diyi pie, ezoanziru ’diyi pie; ma pe di ’ba ti e’yoni oluzu opi mani ma tia, mi asi ma ndri ma vu beni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.5"
            ]
