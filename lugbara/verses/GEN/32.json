            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.5"
              },
              "items": [
                {
                  "text": "Isa 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yakobo nga pari nde ma ru ’da Penueli’i, erini ’yole kini, Amani ama nezu Mungu be milia miliari ti, ma idri pa ira, ’dinirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu nga efu eri dria, erini Penuelini zoria, eri ri so so o’dunini acole acorisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo’disi anzi Israelini nyani isu cimbini ovupi o’dufesi ma pari gururu ma driari ku, ecazu kpere andru, erini pari gururu Yakobo ma o’dufesiari ma isu cimbiniri elolerisi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
