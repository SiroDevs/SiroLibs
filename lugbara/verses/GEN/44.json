                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.40"
              },
              "items": [
                {
                  "text": "E’do 41:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuda nga di esi eri vu ogogo, nga ’yo ra, Opi mani la ma zi mi tia, kirikiri mi fe ati’bo mini ma ’yo e’yo alu mi bilea fo! Mi fe aoko ma ve mi asi ati’bo mini ma ruaa ku; mini ovule tro tro Faraulerisi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.18",
            "verseOrgIds": [
              "GEN.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi mani zi ndra ati’ba mini ’diyi ma tia kini, Emi ovu ata be, kani adrizi be indi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.19",
            "verseOrgIds": [
              "GEN.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
