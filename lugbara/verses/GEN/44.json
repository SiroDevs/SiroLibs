              "items": [
                {
                  "text": "1 Kor 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.17"
              },
              "items": [
                {
                  "text": "Gal 2:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga ’yo ra, Ma econi e’yo ’dinileri ’yezu aluni ku Agu yini okelea isuzu eri vuri nga ovu ati’bo manini; te emiruni, emi nga mvi emi ati vu asi anzurusi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.17",
            "verseOrgIds": [
