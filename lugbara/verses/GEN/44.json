              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.3"
              },
              "items": [
                {
                  "text": "E’do 37:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama omvi ndra mi tia ra, opi mani, kini, Ama atini indi, de ’bo, mva erini tile de driari indi, eri werearu; adri dra ra, ace ayianiria a’dule, ati le eri tu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.20",
            "verseOrgIds": [
              "GEN.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.15"
              },
              "items": [
                {
                  "text": "E’do 42:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ’yo ndra ati’ba mini ’diyi ma tia, Emi eji eri ma vu, ma ma ne eri ma milesi indi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.21",
            "verseOrgIds": [
              "GEN.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ’yo ndra opi amani ma tia, Mva nde econi ati erini kuzaru ku, a’disiku eri ka nga i atini ku ra, atini nga dra ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.22",
            "verseOrgIds": [
              "GEN.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.3"
              },
              "items": [
                {
                  "text": "E’do 43:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te mi ’yo ndra ati’ba mini ’diyi ma tia, Emi ngani ma mile ndre dika ku, emi adri wereari ka emu emi be kuria, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.23",
            "verseOrgIds": [
              "GEN.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’dini, ama ka ndra eca ma ati ati’bo miniri vu, ama olu eri tia e’yo nde opi manini ’yoleri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.24",
            "verseOrgIds": [
              "GEN.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.2"
              },
              "items": [
                {
                  "text": "E’do 43:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ati nga ’yo, Emi mu ’bani nyaka je dika were. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.25",
            "verseOrgIds": [
              "GEN.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama ’yo ra, Ama econi sizaru muzaru ’dale ku; ama adri wereri ka ovu ama eselia indi ama nga si ’dale ra; a’disiku ama econi agu nde ma mile ndrezaru ku, ama adri wereari ka ovu ama be kuria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.26",
            "verseOrgIds": [
              "GEN.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.19"
              },
              "items": [
                {
                  "text": "E’do 46:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ati ati’bo miniri nga ’yo ama tia, Emi ni ra oku mani oti ma dri anzi iri; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.27",
            "verseOrgIds": [
              "GEN.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.33"
              },
              "items": [
                {
                  "text": "E’do 37:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "aluri ku ma ra, ma ’yo ra, Oce eri kpi kpi ada; engazu ’dasi ma ndreni eri dika ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.28",
            "verseOrgIds": [
              "GEN.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.36"
              },
              "items": [
                {
                  "text": "E’do 42:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ka vini mva ’diri ’du ma vurisi indi, e’yo onzi ka nga eri ’ye ra, emi nga di ma se ozoforo ma driari be ’bilia candi be emi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.29",
            "verseOrgIds": [
              "GEN.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.1"
              },
              "items": [
                {
                  "text": "1 Sam 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’dirisi ma ka nga di eca ma ati ati’bo miniri vu, te mva ka nga ovu ama be ku, a’disiku eri ma idrini i ecile mvaniri berisi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.30",
            "verseOrgIds": [
              "GEN.44.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 44:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga eca ’dini, eri ka nga ndre mva ovuni ama be ku, eri nga di dra ra, azini ati’ba mini nga ama ati ati’bo miniri se ozoforo eri ma driari be ’bilia candi be ama’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.31",
            "verseOrgIds": [
              "GEN.44.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 44:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.9"
              },
              "items": [
                {
                  "text": "E’do 43:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ati’bo mini ’yo ndra ma ati tia e’yo mva ma ta mbazu ma ovu ini, ’yozu kini, Ma ka nga eri omvi mi vu ku, ma atini ’nga e’yo onziniri ’ba ma dria ’dani ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.32",
            "verseOrgIds": [
              "GEN.44.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 44:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.32"
              },
              "items": [
                {
                  "text": "Efu 32:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te di curu’do, ma zi mi tia, mi ku ati’bo mini ma te ’doa opi mani ma ati’boru mva ma paria, mva ma mu di i adripi be fo! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.33",
            "verseOrgIds": [
              "GEN.44.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 44:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma nga tu mu ma ati vu de mvari ma be yo, ngoni ngoni ya? ma kazu onzi ngapi ecapi ma ati ma ruaari ndrezu indi ku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.34",
            "verseOrgIds": [
              "GEN.44.34"
            ]
          }
        }
      ]
