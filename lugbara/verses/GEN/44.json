              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.11"
              },
              "items": [
                {
                  "text": "2 Sam 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di bongo yi ma ruaa ’diyi osi ani, ’ba dria nga gunia yini o’ba akanya ma dria nga mvi aku amborua.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.13",
            "verseOrgIds": [
              "GEN.44.13"
            ]
          }
        }
      ]
