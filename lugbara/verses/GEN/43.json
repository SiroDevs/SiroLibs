              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga yi osi ’ba Yusufu ma jo ma agei tepiri vu ogogo, nga e’yo ’yo eri be jotilea, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.19",
            "verseOrgIds": [
              "GEN.43.19"
            ]
          }
        },
