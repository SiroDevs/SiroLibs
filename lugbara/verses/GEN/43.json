              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kini, Opi mani la, ama eca ndra okorisi nyaka jezu ada ada; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.20",
            "verseOrgIds": [
              "GEN.43.20"
            ]
