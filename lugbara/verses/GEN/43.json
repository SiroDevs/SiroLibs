                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abiri ovu okporu tu angua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.1",
            "verseOrgIds": [
              "GEN.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini, yi ka nyaka yini ejile Misiriari nya de ’bo yi ati nga ’yo yi tia, Emi mu dika, emi je nyaka were ama dri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.2",
            "verseOrgIds": [
              "GEN.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.20"
              },
              "items": [
                {
                  "text": "E’do 42:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.23"
              },
              "items": [
                {
                  "text": "44:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuda nga ’yo eri tia kini, Agu nde azi ndra e’yo ama tia asi driasi kini, Emi ngani ma mile ndre dika ku, pe lu emi adripi ma ovu emi be ka! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.3",
            "verseOrgIds": [
              "GEN.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ka a’i ama adripi ti pezu ama be, ama nga si ’dale nyaka jezu mi dri; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.4",
            "verseOrgIds": [
              "GEN.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "te mi ka eri ti pe ku, ama ngani si ’dale ku, agu ndeni ’yole ama tia, Emi ngani ma mile ndre dika ku, pe lu emi adripi ma ovu emi be ka, ’dinirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.5",
            "verseOrgIds": [
              "GEN.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli nga ’yo ra, Emi ’ye ma vu onzi ’yozu agu nde ma tia emi adri azini ci, ’diniri a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.6",
            "verseOrgIds": [
              "GEN.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga ’yo ra, Agu nde ozi ama e’yo okposi, ori’ba amani ma e’yo pie, kini, Emi atini nga idriru ya? Emi adri azini indi ya? Ama olu eri ma tia e’yo awa’diyile; ama eco ndra ni eri ndra ’ye ’yo kini, Emi eji emi adrini ’doa, ’diniri ngoni ngoni ya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.7",
            "verseOrgIds": [
              "GEN.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda nga ’yo i ati ma tia, Mi pe mva ma ti ma be, ama di nga dri ko mu ani, ama ma ovu di idriru, ama ma dra ku ama’i, mi pie, anzi nyiri amani ’diyi be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.8",
            "verseOrgIds": [
              "GEN.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.32"
              },
              "items": [
                {
                  "text": "E’do 44:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.18"
              },
              "items": [
                {
                  "text": "File 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga tani mba ma’i; mi nga e’yoni zi ma tia. Ma ka eri eji mi vu idika ku, eri ’bazu mi milia ku, e’yo onziniri ma ovu ma dria ’dani ’dani; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.9",
            "verseOrgIds": [
              "GEN.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "a’disiku ama ka ndra dri ici ku, te’do ama mvi ’dale pale iriria ’bo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.10",
            "verseOrgIds": [
              "GEN.43.10"
            ]
          }
        }
      ]
