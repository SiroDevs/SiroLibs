                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ati Israeli nga ’yo yi tia, Ka adri ’dini, emi ’ye ’dinile: emi ’du patiefi onyiru angu ’doria ’diyi ma azi afazu emini ma alia, emi ji afa feza agu nde dri, odu arikariru pi were, anyuoso were pie, afa arikariru ’diyi pie, ajinguru pie, patiefi pie, patiefi alimondiru ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.11",
            "verseOrgIds": [
              "GEN.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
