                  "text": "E’do 26:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga di eca ’dini, erini ’yeria firia Misiria eri nga ’yo oku erini Sarai ma tia ’dini, Mi ndre nga, ma ni ra mi oku e’dapi ndrizaru turi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
