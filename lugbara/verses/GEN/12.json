              "items": [
                {
                  "text": "Ebra 11:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iburamu nga oku erini Sarai pi ’du ji, adripi ma mvi Loti pie, afa dria yini okule ’diyi pie, ’ba yini isule Harania ’daa ’diyi pie; yi nga fu muzu angu Kananinia; yi nga di ca angu Kananinia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        },
        {
          "name": "verse",
