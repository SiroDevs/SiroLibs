          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.3"
              },
              "items": [
                {
                  "text": "E’do 13:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Ibura­mu aci drile ’dani kala Uruleruria­leru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
