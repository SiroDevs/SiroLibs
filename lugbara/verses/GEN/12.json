                }
              ]
            }
          ]
        },
        {
          "text": "Te liki nga ’de angua ra. Iburamu nga si Misiria ’a’azu ’dale, likini ovule okporu tu anguarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
