                  "text": "Efe 4:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma ’yo, ma zi mi tia, kini mi ma amvini, e’yo mani ma nga ovu onyiru misi beni, yi ma fu ma e’yo minisi ku beni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga ovu ’dini, Iburamuni caria Misiria ’boria, ’ba Misiria ’diyi nga ndre oku nde ovu ndrizaru tu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
              "GEN.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.16"
              },
              "items": [
                {
                  "text": "Esi 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba opiru Farauni ’diyi nga eri ndre ra, nga e’yo erini olu inzizaru Farau tia. Yi nga di oku nde ’du ofi Farau vile joa ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
              "GEN.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ani Iburamuni ’ye onyiru eri ma e’yosi; eri ovu kabilo piyi be, ti pie, akanya agoru ’diyi pie, ati’ba pie, ezoanzi ati’boru ’diyi pie, akanya andriru ’diyi pie, ngamia pie dria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        }
      ]
