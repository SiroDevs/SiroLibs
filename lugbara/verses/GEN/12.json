              "items": [
                {
                  "text": "Lip 7:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iburamu nga aga angu nde ma eselesi cazu pari Sekemua, kpere kumara Morearia. ’Ba Kananini de ndra angu ndea ’indi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.6",
            "verseOrgIds": [
