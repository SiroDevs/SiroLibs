                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga Yehova Mungu ma o’duko eri erini aciria amvu ma alia etusini ambiria ’boria; agu nde pi nga yi ozi okuni be Yehova Mungusi pati amvua ’diyi ma eselia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.9"
              },
              "items": [
                {
                  "text": "E’do 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova Mungu nga agu nde omve, nga ’yo eri tia, Mi ngoa ya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.23.15"
              },
              "items": [
                {
                  "text": "Yob 23:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.20"
              },
              "items": [
                {
                  "text": "1 Yoh 3:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eri nga ’yo ra, Ma eri o’duko mini amvu ma alia, te ma ovu urisi mani ovule pililirurisi; ma zi ma ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.10",
            "verseOrgIds": [
              "GEN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’yo kini, A’di kini mini, mi pililirurini ya ? Mi nya pati efi mani e’yoni azile mi tia ’bo kini ma nya kuri’i ya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.11",
            "verseOrgIds": [
              "GEN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.13"
              },
              "items": [
                {
                  "text": "O’be 28:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.13"
              },
              "items": [
                {
                  "text": "Yak 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agu nga ’yo ra kini, Oku mini fele ma ovu ma beri fe patiefi nde ma drini, ma nya ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.12",
            "verseOrgIds": [
              "GEN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.3"
              },
              "items": [
                {
                  "text": "2 Kor 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.14"
              },
              "items": [
                {
                  "text": "1 Tim 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova Mungu nga ’yo oku tia, E’yo mini ’yele ’dini ’diri a’di e’yoni ya ? Oku nga ’yo ra, Uri ici mani, ma nya ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        },
        {
