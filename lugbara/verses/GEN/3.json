                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu de uri ovu lokiri be aga anyapa asea Yehova Munguni ’bale ’diyi ma azi dria ra. Eri nga ’yo oku ma tia, Mungu ’yo adaru kini, Emi ma nya pati amvu ma alia ’diyi ma azi ma efi ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku nga ’yo uri ma tia kini, Ama eco pati amvu ma alia ’diyi ma efi nya ra; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.2",
            "verseOrgIds": [
              "GEN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
