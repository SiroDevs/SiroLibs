                "loc": "GEN.2.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te e’yo pati amvu ma alia agaduari ma efinisi, Mungu ’yo ndra ra kini, Emi ma nya eri ku, emi ma elo vini eri ma rua ku, emi kazu drazu ku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.3",
            "verseOrgIds": [
              "GEN.3.3"
            ]
