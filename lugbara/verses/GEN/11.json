                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Yehova nga yi ere ndu ndu engazu ’darisi angu wudrikuru dria ma dria, yi nga di aku nde ku siko ja ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.8",
            "verseOrgIds": [
              "GEN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
