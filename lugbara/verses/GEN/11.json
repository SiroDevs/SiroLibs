        },
        {
          "text": "Ama mu, ama ma si va, ama ma osa ti ’yoza yini, yi ma va yi agyi ma e’yo ’yoza ku beni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.7",
