        },
        {
          "text": "A’bianzi Semini yi ’di. Semi ma eli ka ca turu alu ’bo, eri nga Aripakisadini ti de eli iri aga yi tiza ma vutia ’bo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semi ovu idriru erini Aripakisadini tizu ’bori ma vutia eli turu towi, nga agianzi oti lezoanzi be.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
