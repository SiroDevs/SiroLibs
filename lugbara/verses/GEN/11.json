            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.51"
              },
              "items": [
                {
                  "text": "Luk 1:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga ’yo, Ama mu, ama ma si aku amboru pi, jo izuru driniri cazu kpere ’buari be, amani ru kuza isuzu ani, ama kazu ama erezu saaru angu wudrikuru dria ma alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.4",
            "verseOrgIds": [
              "GEN.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 11:5"
          },
          "items": [
