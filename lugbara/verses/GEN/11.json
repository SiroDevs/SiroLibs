          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sela ovu idriru erini Eberini tizu ’bori ma vutia eli ’turu su drini na, nga agianzi oti ezoanzi be.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.15",
