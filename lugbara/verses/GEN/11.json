              },
              "items": [
                {
                  "text": "1 Kor 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ’da di runi Babeli’i, Yehovani ti ’yoza ’ba angu wudrikurua ’diyini osale ’daarisi; te engazu ’dasi Yehova nga yi ere ndu ndu angu wudrikuru dria ma dria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        }
