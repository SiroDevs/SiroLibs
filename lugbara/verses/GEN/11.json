              "items": [
                {
                  "text": "53:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yehova nga esi va aku pi ondrezu jo izururi be, anzi ’banini sile ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.5",
            "verseOrgIds": [
              "GEN.11.5"
            ]
          }
        },
        {
