                {
                  "text": "4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova nga ’yo, Mi ndre, yi suru alu, yi dria ma ti ’yoza vini alu; te e’yo ’diri eri e’yo yini e’dole ’yeleri; te curu’do yi ngani afa azini yini lele ’yeleri ku ’yekokoru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.6",
            "verseOrgIds": [
              "GEN.11.6"
            ]
          }
        },
        {
