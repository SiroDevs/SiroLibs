                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Iburamu nga ’yo Loti ma tia, Agata ma ovu ama eselia mi be ku, ma zi mi tia, azini ’ba ti mani ocepi ’diyi pi ma eselia ’ba ti mini ocepi ’diyi be ku; te ama adripini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.8",
            "verseOrgIds": [
              "GEN.13.8"
            ]
          }
        },
        {
          "name": "verse",
