              },
              "items": [
                {
                  "text": "O’be 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iburamu ndra ’ba afa be turi, ti erini piyi, dahabu pie, mele be kakau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.2",
            "verseOrgIds": [
              "GEN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga aci ’dani acita erini ma alia engazu angu Uruleruria, kpere Beteli pari ndra erini ma hema asozu ndra okorisi, Beteli pi ma eselia Ai beria, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.3",
            "verseOrgIds": [
              "GEN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.7"
              },
              "items": [
                {
                  "text": "E’do 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kpere pari edeta edezu erini ndra edele ’dale okorisiria; Iburamu nga Yehova ma ru omve ’daa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Loti indi, acipi Iburamu beri, ovu vini kabilo be o’biru, ti pie, hema pie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.5",
            "verseOrgIds": [
              "GEN.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.7"
              },
              "items": [
                {
                  "text": "E’do 36:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.17"
              },
              "items": [
                {
                  "text": "Luk 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te angu nde cani yi dri, yini ovuzu tualu ’dinirisi ku; yi ma afani ovule turisi, econi ani yini ovuzu tualu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.6",
            "verseOrgIds": [
              "GEN.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.20"
              },
              "items": [
                {
                  "text": "E’do 26:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agata nga efu ’ba Iburamu ma ti ocepi ’diyi ma eselia ’ba Loti ma ti ocepi ’diyi be, ’Ba Kananini piyi de ndra angu ndea indi, ’ba Perizini be.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        }
      ]
