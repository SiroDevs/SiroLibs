              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburamu nga di fu Misiriarisi ra, eri’i oku erini pie, afa dria erini ovuzu yi be ’diyi pie dria, azini Lotini indi eri be, nga fi angu Uruleruria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        }
      ]
    },
