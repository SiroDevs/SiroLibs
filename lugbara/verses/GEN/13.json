              "items": [
                {
                  "text": "2 Pet 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isu de ’ba Sodomua ’diyi yi ’ba onzini, e’yo ezapi Yehova vu tu ’diyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        }
      ]
