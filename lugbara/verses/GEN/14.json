                "loc": "ISA.41.2"
              },
              "items": [
                {
                  "text": "Isa 41:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iburamu ka eri kini bi i adripini ’bo, eri nga ’ba erini omba nipi, osile eri ma joa, turu na drini mudri drini aro ’diyi ma dri ce ’ba nde ’diyi ma vuti drozu kpere Dania. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga ’ba erini oti eselesi a’di ’dizu yi be inisi, eri’i ati’ba erini be, nga yi ofu ra, nga yi odro kpere Hoba Damasiki ma kala dri ejialeru­ria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
