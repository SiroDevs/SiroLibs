                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga afa omvi dria ra, omvi vini i adripi Lotini, afa erini pie, oku pie, ’ba nde be dria.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
