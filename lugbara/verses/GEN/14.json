              "attrs": {
                "loc": "GEN.19.22"
              },
              "items": [
                {
                  "text": "E’do 19:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "opi nde ’diyi nga la’di ’di Bera opi Sodomuari pi be, Birisa opi Gomoraari pie, Sinabu opi Adimaari pie, Semeberi opi Zeboi­muari pie, opi Belaari (angu nde bani Zoari’i) pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.2",
            "verseOrgIds": [
              "GEN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 14:3"
          },
