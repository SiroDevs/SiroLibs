                "loc": "ROM.4.17"
              },
              "items": [
                {
                  "text": "Rum 4:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ngani mi ru omve Iburamu’i dika ku, te ru mini nga ovu Iburahimu’i; mani mi ’bale suru o’biru ma ataru ’borisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ,nga mi ’ba efi kazu tu; ma nga fe suru ndu ndu ma enga misi, opi ambo ambo ’diyi nga enga mi alia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
