              "items": [
                {
                  "text": "25:12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo Isimaelinisi, ma eri e’yo mini ’bo; mi ndre, ma fe asi ndriza eri dri ’bo, ma nga fe eri ma ka efi tu, ma nga fe eri ma ezu kakau tu; eri nga opianzi oti mudri drini iri, ma nga fe eri ma ofu suru amboru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
