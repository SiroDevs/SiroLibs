                "loc": "JHN.7.22"
              },
              "items": [
                {
                  "text": "Yoh 7:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi o’du be aro emi eselia ’diyi dria ma li yi agele ra; ’ba agupiru dria a’bianzi emini vusi, ’ba osile emi vile joari pi, ’ba jele suru andini dri silingisi ovupi emi ma oriru kuri pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
