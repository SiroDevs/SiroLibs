                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba agupiru agele liza kokoru, yini eri ma agele ma enyi lile kuri, ma ja agu nde ’dari ma dri engazu suru erini ma aliasi; eri nyo aziza mani ’bo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
