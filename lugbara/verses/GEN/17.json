              "items": [
                {
                  "text": "Rum 4:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aziza mani emini ngale tani mbale ovupi ama eselia mi be, ori mini mi vutiari beri eri ’di: ’ba agupiru dria ma li yi agele ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
