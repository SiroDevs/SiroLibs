                  "text": "Efu 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibura­mu nga i eco o’bukuru va; te Mungu nga e’yo ’yo eri ’be kini, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ma’iruni, mi ndre, aziza mani ovu mi be ’bo, mi nga ovu suru o’biru ma ata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
