                  "text": "Gal 6:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga agele emini ma enyi li; eri nga ovu ecetaru aziza ama eselia emi beri ecezu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
