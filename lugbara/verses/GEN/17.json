                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Iburahimuni nga mva ini Isimaeli pi ’du, ’ba dria osile i vile joa ’diyi pie, ’ba dria erini jele i ma silingisi ’diyi pie dria, ada ’ba dria agupiru Iburahimu vile joa ’diyi, nga yi ma agele ma enyi li o’du nde alu ’dasi, Munguni ’yole eri ma tia ’borile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.23",
            "verseOrgIds": [
              "GEN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimu ma eli ca de di kali oromi drini oromi, yini eri ma agele liria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
              "GEN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvi Isimaelini de eli be mudri drini na yini eri ma agele liria, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
              "GEN.17.25"
            ]
          }
        },
        {
