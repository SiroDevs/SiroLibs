              ]
            }
          ]
        },
        {
          "text": "ma milia ovuzu ezatakokoru. Te ma nga aziza mani azi ama eselia mi be,ma nga fe mi ezu tre tu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
