          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimu nga ’yo Mungu ma tia, Isimaeli ka te eco ovu idriru mi milianini, onyiru tu fo! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
