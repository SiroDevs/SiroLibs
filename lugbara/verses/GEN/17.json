          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba osile mi vile joari pi, ’ba mini jele silingi minisiri be, ma li yi agele ecekokoru; aziza mani nga ovu emi ruaa aziza ’dani’daniru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
