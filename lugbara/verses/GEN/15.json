        },
        {
          "text": "Eri nga ’yo eri tia, Ma Yehova ndra mi ofupi angu Uri ’ba Kalide­yaa ’diyinia, angu ’dori fepi mi dri mi ma afaruri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        },
        {
