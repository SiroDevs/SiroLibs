            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.15"
              },
              "items": [
                {
                  "text": "2 Opi 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.18"
              },
              "items": [
                {
                  "text": "Fil 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.23"
              },
              "items": [
                {
                  "text": "2 Opi 5:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi ma a’i, ma zi mi tia, mi a a’i afa feza mani ejile mi vuri fo, Munguni ’yele ma be ’yeta anzutirisirisi, azini afa mani yi fu dri ra. Eri nga eri omi okposi, eri nga a’i beni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
