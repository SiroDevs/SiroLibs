                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.14.24+2SA.14.25+2SA.14.26+2SA.14.27+2SA.14.28+2SA.14.29+2SA.14.30+2SA.14.31+2SA.14.32"
              },
              "items": [
                {
                  "text": "14:24-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.10"
              },
              "items": [
                {
                  "text": "Mat 18:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yakobo nga ’yo ra, ’Dini ku, ma zi mi tia, ma ka asi ndriza isu mi vu ’bo, mi a’i di afa feza mani fele ’diri fo! mani mi mile ndrele ekile ’bani Mungu ma mile ndrelerilerisi, azini vini mini ovule ayikosi masirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.10",
            "verseOrgIds": [
              "GEN.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
