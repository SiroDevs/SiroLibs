          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Bu pi ma ’baza de di yi ra nyaku pie, ongulumu yiniri be dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.1",
            "verseOrgIds": [
              "GEN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.17"
              },
              "items": [
                {
                  "text": "Efu 31:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.4"
              },
              "items": [
                {
                  "text": "Ebra 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du azirisi Mungu de azi erini ’yoleri ra, eri nga di ava li o’du azirisi azi dria erini ’yeleri ma vutia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.2",
            "verseOrgIds": [
              "GEN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.22+EXO.16.23+EXO.16.24+EXO.16.25+EXO.16.26+EXO.16.27+EXO.16.28+EXO.16.29+EXO.16.30"
              },
              "items": [
                {
                  "text": "Efu 16:22-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu nga di asi ndriza fe o’du aziriri dri, nga eri ’ba alatararu, a’disiku o’du ndesi Munguni ava lile azi dria erini ’bale azini ’yeleri ma vutiarisi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.3",
            "verseOrgIds": [
              "GEN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.3",
            "verseOrgIds": [
              "GEN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Baza ’bu pini nyaku beri ma e’yo ndra ’dini, ndra erini yi ’baria, o’du Yehova Munguni ’bu pi edezu nyaku berisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.4",
            "verseOrgIds": [
              "GEN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.14"
              },
              "items": [
                {
                  "text": "Zab 104:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.65.9"
              },
              "items": [
                {
                  "text": "65:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.65.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa idiza amvuari ndra nga nyakua yo, ase nyakaru amvuari engani ndra nga ku, Yehova Munguni ndra nga ozoo fele ’dizu nyaku ma dria kurisi, azini vini indi ’ba ngapi amvu ’yapirini ndra nga ovule yorisi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.5",
            "verseOrgIds": [
              "GEN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "te luru adri ndra tu nyaku driasi, yi fezu angu ma dria dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.6",
            "verseOrgIds": [
              "GEN.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.45"
              },
              "items": [
                {
                  "text": "1 Kor 15:45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova Mungu ede ndra ’ba ma wura irifura nyakuarisi, vu ava idriniri eri ma omvulea ci; ’ba nde ofu di ani ovuzu orindi idri beriru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.7",
            "verseOrgIds": [
              "GEN.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.10"
              },
              "items": [
                {
                  "text": "E’do 13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova Mungu ede ndra amvu, kala etuni efuzurialeruria Edenia; ’ba ndra agu nde erini edeleri alenia ’daa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.8",
            "verseOrgIds": [
              "GEN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.8"
              },
              "items": [
                {
                  "text": "Eze 31:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.22"
              },
              "items": [
                {
                  "text": "E’do 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.7"
              },
              "items": [
                {
                  "text": "Eceza 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehova Mungu fe pati dria ovupi ndrizaru ndrezasiri pi ma enga nyaku ma alia, pati dria onyiru nyakasiri pie, pati idriniri indi amvu ma eselia agadua pati onitani onyi pi ma e’yo nizu onzi beri be.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.9",
            "verseOrgIds": [
              "GEN.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
