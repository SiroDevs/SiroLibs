            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika Yehovani nga Ibura­himuni omve pale iririsi engazu ’bualeru, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
