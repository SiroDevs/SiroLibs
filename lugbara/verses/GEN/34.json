                "loc": "1CH.4.9"
              },
              "items": [
                {
                  "text": "1 Sur 4:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Karilau nde teni e’yo ’diri ’yezu ku, Yakobo zi ma avani eri vale turisi. Isu de eri ’ba inzizani aga ’ba dria ati vile joa ’diyi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.19",
            "verseOrgIds": [
              "GEN.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 34:20"
          },
          "items": [
