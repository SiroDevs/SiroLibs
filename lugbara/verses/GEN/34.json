              "items": [
                {
                  "text": "E’do 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.15"
              },
              "items": [
                {
                  "text": "20:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.34"
              },
              "items": [
                {
                  "text": "42:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.47.27"
              },
              "items": [
                {
                  "text": "47:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga ovu ama be; anguri emi drilia va ’di; emi ma ovu alenia, ama ozi afa alenia, emi ma isu lonyi indi alenia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sekemu nga ’yo zamva nde ma ati pi ma tia adripi be, Emi ma ovu asi ndrizasi ma vu fo, te afa emini a’ile ma driri ma nga fe ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.16"
              },
              "items": [
                {
                  "text": "Efu 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.29"
              },
              "items": [
                {
                  "text": "Azi 22:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.25"
              },
              "items": [
                {
                  "text": "1 Sam 18:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ka tro anyapa zi ma tia afa feza be karakarau ti, ma nga fe ekile emini ’yole ma tiarile; te di emi fe zamva ’diri ma dri okuru fo!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        }
