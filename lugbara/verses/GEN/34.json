                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri nga eca ’dini o’du narisi, yi ma ruani nga ovuria azoruria, anzi Yakoboni iri, Simeoni pi Levi be, yi Dina ma adripi, yi alu alu nga sei yini o’du, nga emu aku ndea oguru ndi, nga ’ba agupiru ofu dria., ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ofu Hamori pi mvi Sekemu be seisi, nga Dinani pa Sekemu ma joarisi, nga fu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Yako­boni nga emu vini ’ba ofule ’bo ’diyi ma avu ma dria, nga aku nde ma afa opa ra, yini yi ma amvini ezalerisi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.27",
            "verseOrgIds": [
              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi nga anyapa yini o’biru ’diyi opara, nyiri ’diyi pi ’wara ’diyi be, akanya pie, afa ovupi akua ’diyi pie, afa ovupi asea ’diyi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "lonyi yini pie dria, yi nga anzi yini nyiri nyiri ’diyi pi obi ati’baru oku yini pie, nga yi ma afa opa ra, ada aja joa ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
