                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Dina, Lea zi erini tile Yakobo driri, fu mu ezoanzi ’ba angu e’ipini ’diyi andrizu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        },
        {
