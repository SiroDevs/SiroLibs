              },
              "items": [
                {
                  "text": "Azi 23:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Yakoboni nga emvi ibizu engazu asearisi, ka e’yo nde eri ’boria; ’ba nde ’diyi ovu di candisi tu erini e’yo azazaru ’yele Israeli ma! eselia, erini lale Yakobo zisirisi; ’di e’yo lele ’ba ma ’ye kuri’i.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        }
      ]
