          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.2.8"
              },
              "items": [
                {
                  "text": "Neh 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te mba okori ma o’du alurisi eri e’do muzu engazu Babulonia, azini mba towi ma o’du alurisi eri ca Yerusalemua, ekile Mungu erini ma drini ovule eri ma dria onyirurile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
