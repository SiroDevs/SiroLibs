              },
              "items": [
                {
                  "text": "2:43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi Israelini azini yi enga eri be indi, atalau edeta edepi ’diyi azini pie, ’ba Levini pie, ’ba ongo ngopi ’diyi pie, ’ba jotile agei tepi ’diyi pie, ’ba Netini pie, yi emu Yerusalemua eli aziri opi Aritaseri­sesini opi nyazurisi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
