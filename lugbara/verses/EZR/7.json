                "loc": "EZK.26.7"
              },
              "items": [
                {
                  "text": "Eze 26:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.37"
