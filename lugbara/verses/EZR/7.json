          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri emu Yerusalemua mba towisi, eli opini aziri nderi ma alia; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
