              "items": [
                {
                  "text": "1 Sur 29:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini mi ma ji vini dahabu pi mele be dria mini ngale isule angu Babuloniari dria, afa ’bani fele ceni avasi ’diyi be, azini ata atalau edeta edepi ’diyini fele avasi ’diyi be indi, yini fele Mungu yini ma jo Yerusalemuari ma e’yosi ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
