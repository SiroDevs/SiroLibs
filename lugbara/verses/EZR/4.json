                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini suru joloko Osinapari opi ambo inzile turini ejile ’bale aku amboru Samariaaria, azini angu ma joloko Yi Raza ma tia ’aa’dasiri ma alia ’diyi, azini ’dini ’dini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        },
