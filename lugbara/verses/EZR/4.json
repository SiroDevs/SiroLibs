              "items": [
                {
                  "text": "O’be 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini Aritaserisesi ma waraga ma siza aziniri ka ovu lazaru Rehumu pi ma milia Simisai karani pie, azini agyi yini pie ’bo, yi mil mbele Yerusalemua ’ba Yahudini vu yi omi yi okposi afa yini ’yeleri kuzi ja, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
