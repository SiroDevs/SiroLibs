          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi omve ’ba ’ba mile imbapi ’diyi geri ndruzu afa yini lele ’yeleri ma dri jazu, o’du Kuro opi Perisiaarinia dria, kpere Dario opi Perisiaarini e’dozu angu nyazuria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahasueruni angu nyaria, erini e’doria angu nyaria, yi si waraga ’ba ovupi angu Yudaa azini Yerusale­mua ’diyi ma ruaa asu suzu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
