              "items": [
                {
                  "text": "Fil 2:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du ’dasi ’ba suru Yudani ma dri cepi suru Benyaminini be ’diyi enga ra, atalau edeta edepi ’diyi pie, suru ’ba Levini pie, ’ba dria Mu­nguni yi ma asi engale tuzu jo Yehovani sizu Yerusalemua ’diyi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ’ba dria ovupi yi ma ageia ’diyii fe yi dri drimbaza, afazu dahaburu piyi fezu yi dri, mele pie, lonyi Pie anyapa pie, afa aje nyapi tu ’diyi pie, drinia afa feza dria ’bani fele avasi ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
