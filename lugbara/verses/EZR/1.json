          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.28"
              },
              "items": [
                {
                  "text": "Isa 44:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuro opi amboru Perisiaari ’yo ’dini: Yehova, Mungu ’buari fe suru dria ovupi nyakua ’diyi ma dri ’bo, azini eri azi ma tia jo sizu i dri Yerusalemu angu Yudaaria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
