              "items": [
                {
                  "text": "1 Kor 8:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria emi eselia ovupi ’ba eriniriruri, Mungu erini ma ovu eri be, azini eri ma tu uru Yerusalemu angu Yudaa­ria, Yehova Mungu Israeliniri ma jo ovupi Yerusalemuari sizu-eri Mu­ngu’i; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba ’bani kule jolokoru, angu erini ovuzu ani’boruri ka ovu ngoari ti, ’ba angu erinia ’diyi ma ko eri ma aza dahabu pisi, mele pie, lonyi pie, anyapa pie, azini afa feza ’bani fele avasi jo Munguni ovupi Yerusalemuari ma aza kozu ’diyi be.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
      ]
