            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Sur 36:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Azini opi Kuro ofu afazu dria Yehova vile joni ’diyi, ndra Nebukadinezani jile engazu Yerusalemua, ’bale ndra adrou i vile ma joa ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.14"
              },
              "items": [
                {
                  "text": "Ezr 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.1"
              },
              "items": [
                {
                  "text": "Hag 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuro opi Perisiaari ofu afa ’diyi Mitiredata ’ba silingi ta mbapiri ma drisi, la yi ma kalafe Sesibazari opimva Yudani dri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi ma kalafe ovu ’di’i: awala meleni kali na, awala dahabuni alifu alu, ni kali iri drini oromi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "imvu meleni kali na, imvu dahabuni esele azini ’diyi turu su drini mudri, afazu azini alifu alu be; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "afazu dria meleni azini dahabuni ’diyi ovu alifu towi drini turu su Sesibazarini eji afazu nde ’diyi dria, o’du ’bani ’ba ndra obile ati’boru ’diyi ofuzu engazu angu Babuloniasi, yi ejizu ecazu Yerusalemuarisi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
