        },
        {
          "text": "Eli oko Kuro opi amboru Perisiaarini angu nyazurisi, e’yo Yehovani ’yole Yeremia ma tisiri ma ’ye i ’dini ani, Yehova nga di Kuro opi amboruri ma asi enga ’dini azita azizu suru erini ma alia dria, azini eri si e’yo nde ci kini: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
