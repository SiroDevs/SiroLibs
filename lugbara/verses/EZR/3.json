                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi edre pari edeta edezuri eti dria, ’ba angu ’da ’diyi ma urini yi bile cirisi; azini yi fe afa veza drinia ’daa Yehova dri, afa veza nde yi ve o’biti be azini ondre be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
