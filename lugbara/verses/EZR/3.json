                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "vutinia yi fe afa feza vele etu vusi etu vusi ’diyi, azini afa feza mba o’diruni pie, azini afa feza omu dria Yehovani azile tani mbazu alatararu o’du peleri vusi ’diyini pie, afa feza ’ba dria alu aluni lele fele avasi Yehova dri ’diyi pie dria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
