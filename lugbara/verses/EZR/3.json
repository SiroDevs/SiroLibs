              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engazu mba aziri ma o’du alurisi yi e’do afa feza vezu Yehova dri. Te de isu yi ’bani ngahekalu Yehovani eti ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
