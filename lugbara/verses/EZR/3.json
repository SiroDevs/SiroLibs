              },
              "items": [
                {
                  "text": "Ezr 2:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yesua pi anzi erini pie, adripi erini pie, azini Kadimieli pi anzi erini pie, anzi Yudani ’diyi, yi so pa ’ba jo Munguni ma azi ngapi ’diyi ndrezu, tualu anzi Henadadini pie, anzi yini pie, azini adripi yini ’ba Levini pie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        },
