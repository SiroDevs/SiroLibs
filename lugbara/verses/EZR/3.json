              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te atalau edeta edepi ’diyi kakau, azini ’ba Levini, azini ’ba suru atapini ma dri cepi ’diyi, yi ’ba mbazaru ndra jo okori ndrepi ’diyi, ka jo ’diri ma eti ’ba yi milia ’bo, yi wu o’duko ambosi, te ’ba kakau oyu ayikosi uru indi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’dini ’ba econi ndra ani iyikiyi ’diri amazaru kani eri o’duko ayikoni kani awuni yani ku, a’disiku ’bani otrele o’duko urusirisi, o’duko nderi ovu ndra erizaru ziri tu.",
          "type": "text",
          "attrs": {
