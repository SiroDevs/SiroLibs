                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini emini e’yo ’diri laria, emi ma eco e’yo vaza mani e’yo vale ku zizaru Kristoniri vazuri amazaru beni. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
