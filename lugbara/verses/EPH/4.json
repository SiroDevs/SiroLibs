                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "o’bizu asi driasi asi alu Orindiniri ma ta mbazu, emini ovule ombezaru tualu asi anzurusirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.3",
            "verseOrgIds": [
