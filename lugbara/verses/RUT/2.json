                {
                  "text": "Fil 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo ra, Mi ma fe ma ma isu asi ndriza mi milia, opi mani, mini ma asi omile rarisi, azini mini e’yoni ’yole yikisi ati’bo mini ma tiarisi, ka tro ma ovuni ekile ezoanzi mini ma azile ku ti.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
