                }
              ]
            }
          ]
        },
        {
          "text": "Isu Naomi ma agupi ma adripi indi, adani eri ori’ba Elimelekini, eri ovu ’ba afa e’iro tu, runi Boazi’i. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
