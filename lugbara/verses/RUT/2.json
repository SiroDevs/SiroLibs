                  "text": "4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naomi nga ’yo i edri ma tia, Yehova ma fe asi ndriza eri dri, erini ovule yiki be ’dani ’ba idriru ’diyi pi vu ’ba drapi ’bo ’diyi berisi. Naomi nga vini ’yo eri tia, Agu nde ovu ori’ba amani ma azi, eri ovu ’ba amani ogogori. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutu Moabu ezoruri nga ’yo ra, Ada eri ’yo ma tia kini, Mi ma te karile mani vu ogogo de nga yi deni anya loza mani dria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.21",
            "verseOrgIds": [
              "RUT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi nga ’yo Rutu i edri ma tia, Eri i onyiru tu, ma zia, mi ma fu ezoanzil erini be, yi ma isu mi ’ba azini ma amvua anya vile lozu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.22",
            "verseOrgIds": [
              "RUT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "RUT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka’dinile eri te ezoanzi Boazini be, ogogo ’dani, anya vile lozu de nga ’ba loni ondu de dria nganu be ku eri nga ovu i edri be ’dani.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.23",
            "verseOrgIds": [
              "RUT.2.23"
            ]
          }
        }
