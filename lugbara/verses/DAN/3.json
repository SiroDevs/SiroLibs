              "items": [
                {
                  "text": "1 Pet 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agupi na ’diyi, Sadaraka, Mesaka, Abedinego pie, nga di 0’de va otizaru ad si ekandrindriruri ma alia ra. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        },
        {
