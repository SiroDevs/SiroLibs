                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ojio e’yo azipiri nga di oyu o’duko urusi kini, Opi azi emi tia, emi ’ba dria, suru pie, emi ’ba ti ndu ndu ’yopi ’diyi pie, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "emi ka guka pi ma awu eri, osegu pie, o’di pie, oringi pie, o’di ndararu pie, oluru pie, afa wupi awu be ndu ndu ’diyi pie dria, emi ma eco emi va wura meleru opi Nebukadinezani i’dileri inzuzu; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
