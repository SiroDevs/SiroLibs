            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini ’ba dria ka awu guka pini eri, osegu pie, o’di pie, oringi pie, o’di ndararu pie, oluru pie, afa wupi awu be ndu ndu ’diyi pie dria, ’ba dria, suru pie, ’ba ti ndu ndu ’yopi ’diyi pie dria, yi ceo yi va wura meleru Nebukadinezani i’dile ’diri inzizu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        },
