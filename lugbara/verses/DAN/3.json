                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri omvi e’yo kini, Emi ndre, ma ndre ’ba su otruzaru, yini aciria ad ma alia, te ad eloni yi ma ruaa aluni ku; azini agu suri ma wura si i ekile adrou ma mvale. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
