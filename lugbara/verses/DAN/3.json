                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi omvi e’yo opi Nebukadineza ma tia kini, Opi la, mi rua ma adri ala ewule ewule! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi la, mi azi ndra azita kini ’ba alu alu ka awu guka pini eri, osegu pie, o’di pie, oringi pie, o’di ndararu pie, oluru pie, afa wupi awu be ndu ndu ’diyi pie, ’ba ma eco yi va, ma inzi wura meleruri; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ’ba ngapi ecepi ra yi ecopi va eri inzipi kuri, yi nga eri ’be aci si ekandrindriruri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.11",
            "verseOrgIds": [
              "DAN.3.11"
            ]
          }
        },
