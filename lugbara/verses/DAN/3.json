              "items": [
                {
                  "text": "Ebra 11:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ka ’dini ku, ti, opi la, mi ma ni ra, ama ngani azi nga adrou mini ’diyi dri aluni ku kani wura meleru mini i’dileri inzi ku indi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        }
