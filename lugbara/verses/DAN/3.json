            "number": "26",
            "style": "v",
            "sid": "DAN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza nga di esi pari ad si ekandrindri drozuri ma tilia ogogo, nga ’yo kini, Sadaraka, Mesaka, Abedinego la emi ati’ba Mungu ovupi Uru Turini, emi efu amve, emi emu ’doa! Sadaraka pi Mesaka pie, Abedinego pie nga di efu aci aliarisi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 3:27"
          },
          "items": [
