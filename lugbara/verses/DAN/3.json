        },
        {
          "text": "Sadaraka pi, Mesaka pie, Abedinego pie, yi omvi e’yo opi dri kini, Nebukadineza la, funi dri ama dri e’yo omvizu mi tia e’yo ’dirisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.16",
            "verseOrgIds": [
              "DAN.3.16"
            ]
          }
        },
        {
