        },
        {
          "text": "’ba ngapi ecepi ra i ecopi va eri inzipi kuri, yi nga eri ’be aci si ekandrindriruri ma alia etu ndesi coti. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
