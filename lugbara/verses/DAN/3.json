          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Di ma vutia opi nga Sadaraka pi, Mesaka pie Abedinego pie idri drile inzitasi angu Babulonini ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.30",
