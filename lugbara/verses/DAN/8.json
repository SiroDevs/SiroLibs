                "loc": "DEU.28.50"
              },
              "items": [
                {
                  "text": "Azi 28:50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ewu opi nyaza yinirini ’yezu asizurisi, ’ba ezata ezapi ’diyi ka eza tre ’bo, opi mile be adraru e’yo zizaru vapi rari nga pa soni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.23",
            "verseOrgIds": [
              "DAN.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
