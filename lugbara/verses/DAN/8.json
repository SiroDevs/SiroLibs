          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.7"
              },
              "items": [
                {
                  "text": "Eceza 13:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Okponiri nga ovu tu nde ra te ovuni okpo eri ma ngulupinisi ku; eri nga ’ba dri ja osutaru, nga drileba isu tu, nga ’ye ini lelerile; eri nga ’ba okpo be ’diyi dri ja ra, suru ’ba alatararu ’diyini be. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.24",
            "verseOrgIds": [
              "DAN.8.24"
            ]
          }
        },
        {
