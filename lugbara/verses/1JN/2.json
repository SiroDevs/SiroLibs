            "number": "3",
            "style": "v",
            "sid": "1JN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ka azita erini ma ta mba ra, e’yo ’disi ama ni kini ama ni eri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.3",
            "verseOrgIds": [
              "1JN.2.3"
            ]
