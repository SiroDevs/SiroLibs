                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria alu alu Mvini gapi siri ovuni Ata be ku. ’Ba Mvini e’dapiri ovu Ata be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.23",
