                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ovu odu osuza ’Ba Alarararurini feleri be, te emi ni e’yo dria. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.20",
