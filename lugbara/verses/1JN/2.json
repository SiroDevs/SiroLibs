              "items": [
                {
                  "text": "1 Yoh 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’yopi kini Ma ni eri ra, te azita erini ma ta mbapi kuri, eri ’ba inzo lipiri, e’yo adaruri eri ma alia yo; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.4",
