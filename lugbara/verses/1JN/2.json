              "items": [
                {
                  "text": "1 Yoh 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma si emi dri, anzi atapi, emini ’ba ovupi okokeleri nilerisi, Ma si emi dri, karile, emini ’ba onzi agale ’borisi. Ma si emi dri ra, anzi, emini Atani nile ’borisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
