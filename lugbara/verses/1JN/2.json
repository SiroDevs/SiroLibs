              "items": [
                {
                  "text": "1 Yoh 4:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’yopi kini i ovu diza ma alia, te i adrini ngupi onziri, eri ovu angu biza ma alia kpere curu’do. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.9",
            "verseOrgIds": [
              "1JN.2.9"
            ]
          }
        },
