              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma sini emi dri emini e’yo adaruri nile kurisi, ’dini ku, te emini eri nile rarisi, azini kini e’yo inzoru aluni ovuni e’yo adaruri ma alia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.21",
