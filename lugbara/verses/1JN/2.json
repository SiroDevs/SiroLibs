                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba i adrini lepiri ovo diza ma alia ’dani, alenia afa kumule fepi ’bani abazuni yo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.10",
            "verseOrgIds": [
