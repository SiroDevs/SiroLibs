                }
              ]
            }
          ]
        },
        {
          "text": "Ma si vini azita o’diru emi dri, e’yo nderi ovu adaru eri ma alia azini emi ma alia indi, a’disiku angu bizani aga aga, diza adaruri e’do dizu curu’do ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.8",
            "verseOrgIds": [
              "1JN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
