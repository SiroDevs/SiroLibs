        },
        {
          "text": "eri ovu edeta e’yo onzi amani ma adi cozuriru, e’yo onzi amanisi a’dule ku te e’yo onzi wudrikuru drianisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.2",
            "verseOrgIds": [
