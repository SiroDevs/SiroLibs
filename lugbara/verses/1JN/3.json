                "loc": "JHN.5.24"
              },
              "items": [
                {
                  "text": "Yoh 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.11"
              },
              "items": [
                {
                  "text": "1 Yoh 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ama ni ra ama efu dra ma aliarisi fizu idri ma alia ’bo, amani ama adripiyi lele avasirisi. ’Ba lepi kuri ovu dra ma alia ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
        {
