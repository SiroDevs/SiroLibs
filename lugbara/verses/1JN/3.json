          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba dria ovupi asi teza ’diri be Yesu ma aliari nga i ’ba alatararu erini ovule alatararurile.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.3",
            "verseOrgIds": [
              "1JN.3.3"
            ]
          }
        }
