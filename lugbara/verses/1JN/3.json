            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.24"
              },
              "items": [
                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ni eri ece ndra i e’yo onzi wuzu, te eri ma alia e’yo onzi yo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.5",
            "verseOrgIds": [
              "1JN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
