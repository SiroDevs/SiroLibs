              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.21"
              },
              "items": [
                {
                  "text": "Mat 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.44"
              },
              "items": [
                {
                  "text": "Yoh 8:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria alu alu i adrini ngupi onziri eri ’ba ’ba fupiri, azini emi ni ra ’ba ’ba fupiri aluni ovuni idri ’dani ’dani be i ma alia ku. ",
          "type": "text",
          "attrs": {
