                "loc": "ROM.6.14"
              },
              "items": [
                {
                  "text": "Rum 6:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ea dria alu alu a ovupi eri ma alia ’daniri ’yeni e’yo onzi ku; ’ba e’yo onzi ’yepiri neni eri ku, nini vini eri ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.6",
            "verseOrgIds": [
              "1JN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.29"
              },
              "items": [
                {
                  "text": "1 Yoh 2:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anzi, nyiri nyiri, ’ba aluni ma ici emi ku. ’Ba e’yo kililiruri ’yepiri eri ’ba kililini, erini ovule ’ba kililirurile. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.7",
            "verseOrgIds": [
              "1JN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.44"
              },
              "items": [
                {
                  "text": "Yoh 8:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba e’yo onzi ’yepiri ibi enga ’ba E asu supiri vu; a’disiku ’ba asu supiri ’ba ndra e’yo onzi ’ye okokeleni. Mvi Munguni e’da ndra i e’yo ’disi, eri ma ja ’yeta ’ba asu supirini ma dri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.8",
            "verseOrgIds": [
              "1JN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.18"
              },
              "items": [
                {
                  "text": "1 Yoh 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria alu alu Munguni tileniri ’yeni e’yo onzi ku; Mungu ma orini ovule eri ma alia ’danirisi, econi erini e’yo onzi ’yezaru ku, Munguni eri tilenirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.9",
            "verseOrgIds": [
              "1JN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anzi Munguni piyi e’da yi e’yo ’disi anzi ’ba asu supirini be: ’ba dria alu alu e’yo kililiru ’yepi kuri ovuni ’ba Munguni ku, ’ba i adrini lepi kuri vini ’dinile indi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.10",
            "verseOrgIds": [
              "1JN.3.10"
            ]
          }
        }
      ]
