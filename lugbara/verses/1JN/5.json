              "items": [
                {
                  "text": "Yoh 20:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma si e’yo ’diyi emi dri, emi ’ba Mvi Munguni ma ru a’ipi ’diyi, emi ma ni ani emi ovu idri ’dani ’daniri be. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.13",
            "verseOrgIds": [
              "1JN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.21"
              },
              "items": [
                {
                  "text": "1 Yoh 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.22"
              },
              "items": [
                {
                  "text": "22",
