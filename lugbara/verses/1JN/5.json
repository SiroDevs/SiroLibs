                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.13"
              },
              "items": [
                {
                  "text": "Yoh 14:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.23"
              },
              "items": [
                {
                  "text": "16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Asi teza uri kokoru amani ovuzu ani eri be eri ma miliari eri ’eli, ama ka afa erini lele feleri zi, eri ama eri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.14",
            "verseOrgIds": [
              "1JN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ka ni ra eri ama eri e’yo dria amani zilerisi ra, ama ni ra ama isu e’yo amani zile eri vu ’diyi ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.15",
            "verseOrgIds": [
              "1JN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.31"
              },
              "items": [
                {
                  "text": "Mat 12:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.6.4+HEB.6.5+HEB.6.6"
              },
              "items": [
                {
                  "text": "Ebra 6:4-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba azini ka i adripi ndre erini e’yo onzi ’bani drazu ani kuri ’yeria, eri nga zi ra, Munguni nga idri fe eri dri ’ba nde e’yo onzi ’bani drazu ani kuri ’yepi ’diyi ma e’yosi. E’yo onzi ’bani drazu ani rari indi; ma ’yoni eri ma zi e’yo nde ’dirisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.16",
            "verseOrgIds": [
              "1JN.5.16"
            ]
          }
        },
        {
          "name": "verse",
