        },
        {
          "text": "’Ba dria Yesuni a’ipi eri Kristo’i­ri, isu Mungu ti erini; ’ba dria ata ’ba tipiri lepi rari le ’ba erini tileri indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.1",
            "verseOrgIds": [
              "1JN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama ni ama le anzi Munguni e’yo ’disi, amani Mungu lele azini azita erini ’yele rarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.2",
            "verseOrgIds": [
              "1JN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.15"
              },
              "items": [
                {
                  "text": "Yoh 14:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
