            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.30"
              },
              "items": [
                {
                  "text": "Mat 11:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Leta amani Mungu lezuri ’di, amani azita erini ma ta mbazuri’i. Te azita erini ovuni nzizaru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.3",
            "verseOrgIds": [
              "1JN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.33"
              },
              "items": [
                {
                  "text": "Yoh 16:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku afa dria Munguni tile ’diyi aga nyaku ra; te agaza nyakuni agazu rari eri ’eli, a’ita amani,; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.4",
            "verseOrgIds": [
              "1JN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.4"
              },
              "items": [
                {
                  "text": "1 Yoh 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba nyakuni agapiri eri a’eli’i ya? Eri ’ba Yesuni a’ipi eri Mungu ma Mvi’iri ku ya?",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.5",
            "verseOrgIds": [
              "1JN.5.5"
            ]
          }
        }
      ]
