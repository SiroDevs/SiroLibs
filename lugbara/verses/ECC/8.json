                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yini e’yo liza lile azi onzi ma driari ’yele mbele kurisi, e’yo ’disi ’ba ma ori ma asi mba mba e’yo onzi ’yezu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.11",
            "verseOrgIds": [
              "ECC.8.11"
            ]
          }
        },
