                  "text": "Mat 25:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba e’yo onzi ’yepiri ka tro e’yo eza pale turu alu i ma o’du erezu drile ti, ma ni ada ada e’yoni nga ovu onyiru ’ba Mungu rupi, ’diyi dri, yini ovule ruta be eri ma miliarisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.12",
            "verseOrgIds": [
              "ECC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo ngani ovu onyiru ’ba e’yo onzi ’yepiri dri ku, eri ngani i ma o’du ovupi endrilendrileri e erezu drile ku, erini ovule ruta be Mungu ma milia kurisi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.13",
            "verseOrgIds": [
              "ECC.8.13"
            ]
          }
        }
      ]
