                  "text": "Rum 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma kini, Mi inzi azita opini, oyo mini sole Mungu rusiri ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.2",
            "verseOrgIds": [
              "ECC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi fu eri ma miliasi amve mbele mbele ku; mi ’ye e’yo onzi ’dani bile kokoru ke, erini e’yo dria ’yele ini lelerilerisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.3",
            "verseOrgIds": [
              "ECC.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.34.18"
              },
              "items": [
                {
                  "text": "Yob 34:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku e’yo opini ovu okpo be, te a’di eco ’yozaru eri ma tia kini, Mi a’di ’ye ya-nini ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.4",
            "verseOrgIds": [
              "ECC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba azita ma ta mbapiri ngani afa onzi ni ku; ’ba onduaru ma asini ewu pi ama e’yo liza beni, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.1"
              },
              "items": [
                {
                  "text": "Ekl 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku e’yo driasi isu e’yo liza be indi; e’yo ovule amboru ’ba ma, driarisi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.22"
              },
              "items": [
                {
                  "text": "O’be 24:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.6.12"
              },
              "items": [
                {
                  "text": "Ekl 6:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "erini e’yo ngapi i ’yepi ndori nile korisi, te a’di eco e’yo ngapi i ’yepiri oluzaru eri ma tiani ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.49.6"
              },
              "items": [
                {
                  "text": "Zab 49:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.14.5"
              },
              "items": [
                {
                  "text": "Yob 14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba aluni ovupi okpo be orindi ma dria orindi ogapi fukokoru sini yo, ovuni vini okpo be o’du drataniri ogazu ku; yi peni ’ba ti mvizu akua omba ’daasi ku, e’yo onzi ngani vini ’ba onzi nde ’yepiri pa ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.12"
              },
              "items": [
                {
                  "text": "1 Sam 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ndre e’yo ’diyi dria ’bo, ma ’ba ma asi azi dria ovupi ’yezaru etu ma etiari ma dria, ewu ’ba aluni ovuzu okpo be ’ba azini ma drilia eri ’yezu onzirisi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.9",
            "verseOrgIds": [
              "ECC.8.9"
            ]
          }
        }
      ]
