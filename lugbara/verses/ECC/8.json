              "items": [
                {
                  "text": "Lev 26:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma nga di ayiko ndruzuri pe’i, a’disiku e’yo azini onyiru ’ba dri agapini yo, pe lu ba ma nya, ma mvu, ma ovu ayikosi, e’yo ndeni ngale ovule eri be ’dani azi okporu erini ma alia idri Munguni fele eri dri etu etiari ma o’du dria ma aliarisi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.15",
            "verseOrgIds": [
              "ECC.8.15"
            ]
          }
        }
