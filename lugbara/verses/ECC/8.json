          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vutinia ma ndre yini ’ba e’yo onzi ’yepi ’diyi osaria, yi eca pari ’ba avu sazuria; te ’ba e’yo onyiru ’yepi ’diyi enga pari alatararuriarisi ra, yi ma tavi avi vini ’ba akua ’diyi dri ra. E’yo ’diri indi eri e’yo tokoni, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.10",
            "verseOrgIds": [
              "ECC.8.10"
            ]
          }
        },
