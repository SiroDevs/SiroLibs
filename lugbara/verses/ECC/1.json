              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma’i, ’Ba e’yo Olupiri, ma ovu ndra opiru Israeli ma drilia Yerusa­lemua. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
