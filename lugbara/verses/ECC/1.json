              "attrs": {
                "loc": "ECC.3.10"
              },
              "items": [
                {
                  "text": "Ekl 3:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma fe ma asi afa dria ovupi ’yezaru ’bu ma etia ’diyi ma e’yo ndazu azini ndruzu onduasi; e’yo nde ’yeze eri azi ocokoru Munguni fele anzi ’bani dri ande-zuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndre azi ndu ndu ovupi ’yezaru etu ma etia ’diyi dria ra; azini emi ndre, e’yo dria eri e’yo tokoni, si kile asi ’bazu oli bizurile.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        }
