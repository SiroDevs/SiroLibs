                "loc": "ECC.1.13"
              },
              "items": [
                {
                  "text": "Ekl 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndre azi ewaru Munguni fele ’ba ma ori dri yini andezu aniri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.10",
            "verseOrgIds": [
              "ECC.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.4"
              },
              "items": [
                {
                  "text": "Azi 32:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.17"
              },
              "items": [
                {
                  "text": "Ekl 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.33"
              },
              "items": [
                {
                  "text": "Rum 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ede afa dria ndrizaru ewu yinisi: eri ’ba egata ewu ’dani ’danirini ’ba ma asia indi, te ti, ’ba econi azi Munguni ’yele ’bori ma e’yo ndazu nizu engazu e’dozania kpere asizaniria ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ni ra kini afa azini yi dri onyiru agapi rani yo, lu yi ma ovu ayikosi, ma ’ye onyiru de nga yi drani ku; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.2.24"
              },
              "items": [
                {
                  "text": "Ekl 2:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini indi Mungu fe ’ba dri afa feza ’dini, yi alu alu ma nya, ma mvu, ma ovu ayikosi azi yini ma alia onyiru. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.17"
              },
              "items": [
                {
                  "text": "Yak 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ni ra kini afa dria, ka ovu ngoni ti, Munguni ’yeleniri nga adri ’dani ’danini; ’ba econi afa azini o’ba ruania ku, ’ba econi vini afa azini onzezaru ruaniasi ku indi; Mungu ’ye ’dini kini ’ba ma ovu urisi eri ma drilia ani beni. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.14",
            "verseOrgIds": [
              "ECC.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.9"
              },
              "items": [
                {
                  "text": "Ekl 1:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Afa ovupi curu’do indiri eri afa ndra ovupi driori’i; te afa ngapi ovupiri eri afa ndra ovupi driori’i; te Munguni afa agapi ’bori nda dika.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        }
      ]
    },
