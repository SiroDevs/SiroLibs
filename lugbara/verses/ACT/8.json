              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ’diyi yini yi ereria, yi mu e’yo bari oluzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.4",
            "verseOrgIds": [
              "ACT.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.5"
              },
              "items": [
                {
                  "text": "’Yeta 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Filipo si aku amboru Samariaaria, eri olu yi dri Kristo’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.5",
            "verseOrgIds": [
              "ACT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ongulumuru yi ka e’yo Filiponi oluleri eri ra, ka tali erini ’yele ’diyi ne ra, yi a’i e’yo erini oluleri asi alusi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.6",
            "verseOrgIds": [
              "ACT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.17"
              },
              "items": [
                {
                  "text": "Mar 16:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku orindi onzi fu ’ba kakau ma aliasi oyuzu o’duko urusi; azini ’ba kakau azo yayaani be ’diyi, azini ’ba acozaru ’diyi be, yi ma rua ati ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.7",
            "verseOrgIds": [
              "ACT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.40+JHN.4.41+JHN.4.42"
              },
              "items": [
                {
                  "text": "Yoh 4:40-42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayiko amboru tu ovu aku nderi ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agu alu runi Simoni, eri oku ’ba andri ndripiri, eri fe ’ba Sama­riaa ’diyini osuzu tu, kini i ojou amboni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.9",
            "verseOrgIds": [
              "ACT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi dria eri e’yo erini, engazu anzisi cazu ’ba ’wara vu, kini. Agu ’diri eri okpo Munguni omvele Ambori’i. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.10",
            "verseOrgIds": [
              "ACT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te yi eri e’yo erini a’disiku ewu kakau eri fe yi osu tu andri ndriza inirisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.11",
            "verseOrgIds": [
              "ACT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.19"
              },
              "items": [
                {
                  "text": "Mat 28:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi ka e’yo bari suru Mungunirini Filiponi olule yi tia ru Yesu Kristonisiri a’i ra, yi bi baputizi, agupi azini oku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.12",
            "verseOrgIds": [
              "ACT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Simoni’i, eri a’i alu indi, azini erini baputizi biria ’bo eri ebi i Filipo be ’dani. Erini eceta luria tali amboru ovupi ’yezaru ’diyi be, eri osu tu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
