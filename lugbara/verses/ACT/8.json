                "loc": "ACT.22.20"
              },
              "items": [
                {
                  "text": "22:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du nderisi inzata amboru eca kanisa ovupi Yerusalemuari vu; yi dria ere yi nzu angu Yudiari pi ma alia, Samaria pie, kiri ’ba ti opele ’diyi aceni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
