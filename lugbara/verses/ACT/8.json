          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.12"
              },
              "items": [
                {
                  "text": "Mat 14:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Mungu rupi ’diyi sa Setefanoni ra, yi owu eri tu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.2",
            "verseOrgIds": [
              "ACT.8.2"
            ]
          }
        },
        {
