          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te agu azini emu ’yo yi tia, Emi lu, ’ba emini ’bale arujoa ’diyi yi ovu hekalua ’daa, pa sozu ’ba imbaria ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.25",
            "verseOrgIds": [
              "ACT.5.25"
            ]
          }
        },
        {
