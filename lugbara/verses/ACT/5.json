          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asikari ambo nga di mu ’ba erini be yi ejizu, te yi ejini yi okposi ku, a’disiku yi ru kani ’ba ongulumuru yi nga yi o’be onisi yani.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.26",
            "verseOrgIds": [
