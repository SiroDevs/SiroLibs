              "items": [
                {
                  "text": "Mat 11:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo nderisi curu’do emi o’bi Mungu a’disi ya, emini kulumgbu ombele ’ba Yesu vuti bipi ’diyi ma ombelearisi? Ama a’bipi azini ama’i indi, ama econi kulumgbu nzizaru nderi ’duzaru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.10",
            "verseOrgIds": [
              "ACT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
