              },
              "items": [
                {
                  "text": "10:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mungu asisile nipiri eri nze e’yo yini ma eti, erini Orindi Alatararu fele yi dri tro tro erini fele ama dririlerisi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.8",
            "verseOrgIds": [
              "ACT.15.8"
            ]
          }
        },
        {
