                "loc": "1TH.3.5"
              },
              "items": [
                {
                  "text": "1 Tes 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du ka aga were ’bo Paulo ’yo Baranaba tia kini,Mi emu, ama mvi aku ambo ambo amani e’yo Opini oluzu ’diyia dria, adripi alenia ’diyi andrizu, kani yi ovu ngoni yani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.12"
              },
              "items": [
                {
                  "text": "’Yeta 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baranaba le Yohana yini omvele Marako’iri ’duzu muzu yi be. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
              "ACT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.13"
              },
              "items": [
                {
                  "text": "’Yeta 13:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.10"
              },
              "items": [
                {
                  "text": "Kol 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Paulo leni eri ’duzu yi be ku, ndra erini yi kule angu Pamfuliaa, erini mule azi ngazu yi be kurisi., ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.4.36"
              },
              "items": [
                {
                  "text": "’Yeta 4:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.4"
              },
              "items": [
                {
                  "text": "13:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo nde fu agatatu yi ma eselia, yi co yi ma esele ani; Baranaba eri ’du Marako muzu eri be, yi fi oguru alia muzu Kuporoa, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "te Paulo pe Sila’i, yi fu muzu, adripi yini yi kuria asi ndriza Opini dri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
            "verseOrgIds": [
              "ACT.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri aga Suriaasi azini Kilikiaasi, kanisa o’bazu okporu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.41",
            "verseOrgIds": [
              "ACT.15.41"
            ]
          }
        }
