                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba azini ’diyi enga Yudiaa emu ra, yi imba adripi kini, Emi ka ovu agele liza Musani azileri kokoru, emi econi emi pazaru ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
