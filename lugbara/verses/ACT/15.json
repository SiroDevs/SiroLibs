              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba ongulumuru dria yi ovu ndi; yi co bile e’yo Baranaba pini olule Paulo beri erizu, yini eceta azini tali osutaru Munguni ’yele ’ba uruni ma eselia dri yinisi ’diyi ma e’yo eceria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.12",
            "verseOrgIds": [
              "ACT.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
