                  "text": "’Yeta 10:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri coni ama esele yi be ku, te eri oji asi yini alaru a’itasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.9",
            "verseOrgIds": [
