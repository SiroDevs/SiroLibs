                  "text": "11:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ka yi ozi yi eselia ozitasi ambo ’bo, Petero nga di enga ’yo yi tia kini, Ma adripi la, emi ni Mungu pe ndra ma drio emi eselia, ’dini ’ba Jururu ’diyi ma eri e’yo bari ma tisi, yi ma a’i ani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.7",
            "verseOrgIds": [
              "ACT.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
