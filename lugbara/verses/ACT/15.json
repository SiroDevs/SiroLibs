              "items": [
                {
                  "text": "Efe 2:4-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama a’i ama nga ovu pazaru ’yeta anzutiri Opi Yesunirisi, ekile ’ba ’diyile ’dini.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.11",
