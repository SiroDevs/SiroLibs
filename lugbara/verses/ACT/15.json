                {
                  "text": "’Yeta 21:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.9"
              },
              "items": [
                {
                  "text": "Gal 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ka de e’yo oluzu ’bo, Yakobo omvi e’yo kini, Ma adripi la, emi eri e’yo mani ’yoleri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.13",
            "verseOrgIds": [
              "ACT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.7+ACT.15.8+ACT.15.9"
              },
              "items": [
                {
                  "text": "’Yeta 15:7-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.68"
              },
              "items": [
                {
                  "text": "Luk 1:68",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Simeoni olu Munguni ’ba Jururu andrizu oko ’ba opezu yi eselia eri ma rusiri ma e’yo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.14",
            "verseOrgIds": [
              "ACT.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.9.11"
              },
              "items": [
                {
                  "text": "Amo 9:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.9.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo nabini ’yole ’diyi yi fu dri e’yo nderi be tro­tro, ekile erini ovule sizarurile,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.15",
            "verseOrgIds": [
              "ACT.15.15"
            ]
          }
        }
      ]
    },
