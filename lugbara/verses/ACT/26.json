              "type": "text"
            }
          ]
        },
        {
          "text": "Opi ambo nderi nga di enga ra, gavena pi, Berinike pie, ’ba dria ripi tualu yi be ’diyi pie; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.30",
            "verseOrgIds": [
              "ACT.26.30"
            ]
          }
        },
