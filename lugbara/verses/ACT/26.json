          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi ka fu ’bo, yi ’yo yi ma eselia kini, ’Ba ’dori ’yeni e’yo erini ecozu drazu, kani eri ’izu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        },
