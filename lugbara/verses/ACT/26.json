              },
              "items": [
                {
                  "text": "Kol 1:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma pe mi ma ti yi ma mile zizu, ’dini yi ma enga ini aliasi ma oja yi diza vu, azini engazu okpo Satanini ma alia cazu Mungu vu, yi ma isu ani e’yo onzi wuza, azini awuafa ma nyaza ’ba ovupi alatararu yini ma a’ilerisi ’diyi ma eselia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        }
      ]
