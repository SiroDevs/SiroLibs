                  "text": "Mat 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ma e’do e’yo eluzu Damasikia, azini Yerusalemua vutinia angu Yudiaaria dria, azini ’ba Jururu ’diyi vu indi, kini, yi ma ku e’yo onzi yi ojazu Mungu vu, ma ’ye ’yeta yi sipi ’ba asi ojapi ’bo ’diyisi ’diyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
