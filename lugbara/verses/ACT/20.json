            "number": "6",
            "style": "v",
            "sid": "ACT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.6",
            "verseOrgIds": [
              "ACT.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 20:7"
          },
          "items": [
