              "ACT.20.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.2"
              },
              "items": [
                {
                  "text": "1 Kor 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.42"
              },
              "items": [
                {
                  "text": "’Yeta 2:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.46"
              },
              "items": [
                {
                  "text": "46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du alu sabato ma vutiarisi, amani ama okuria tualu mikate nyoria, Pauloni leria dri kozu dru, eri ’yo yi be, oluzu izu jizu kuzu iniaayii. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.7",
            "verseOrgIds": [
              "ACT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala kakau ovu jo uru-leru nde amani ama okuzu aleniari ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.8",
            "verseOrgIds": [
              "ACT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karilau alu runi Eutiko eri ri derisaa. De Pauloni e’yo oluria izuru, o’du ’be eri dii; o’du ka eri aga ra, eri e’de va engazu jo na uruleruria, ’ba eri e’dupi ’diyi isu eri dra ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.9",
            "verseOrgIds": [
              "ACT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.21"
              },
              "items": [
                {
                  "text": "1 Opi 17:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Paulo eri esi va eri vu, a’bu i eri dria, amvu eri, ’yozu kini, Emi ga lulu ku, re eri nga idriru, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.10",
            "verseOrgIds": [
              "ACT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ka tu uru eri onyo mikate, nya ra, vutinia eri nze e’yo yi be izu cazu kpere anguni atiria, ’dini eri mu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.11",
            "verseOrgIds": [
              "ACT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi eji karilau nderi idriru, isu asi omiza, amboru tu ani.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama’i, ama mu drile ogurua, ama zo muzu Asoa, pari: amani ngale Paulo ’duzuria; erini e’yo edele ’dinilerisi, kini i ngulupini nga mu pasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.13",
            "verseOrgIds": [
              "ACT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ka dri fu ama be Asoa, ama ofi eri ogurua, ama zo cazu Mitulenea. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.14",
            "verseOrgIds": [
              "ACT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engazu ’dale, drusi ama zo cazu Kio vu ogogo; drozi ama ca Samoa; drozi azi ’dasi ama ca Miletoa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.15",
            "verseOrgIds": [
              "ACT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.21"
              },
              "items": [
                {
                  "text": "’Yeta 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Paulo ega i asia i ma aga Efesoni ra, i kazu ecezu Asiaa ku; a’disiku erini lele cale Yerusalemua mbele eri ka eco ra, ovuzu ’dale o’du Pentekositonisirisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miletoarisi eri pe ’ba ti Efesoa, omve ’ba ’wara kanisani ’diyi i vu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.17",
            "verseOrgIds": [
              "ACT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.19"
              },
              "items": [
                {
                  "text": "’Yeta 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.10"
              },
              "items": [
                {
                  "text": "19:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ka eca eri vu, eri ’yo yi tia kini:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.18",
            "verseOrgIds": [
              "ACT.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ngulupi ni adriza mani ovuzu emi eseliari ma e’yo engazu mani ndra ma pa ’bazu Asiaa o’du dria ecazu kpere curu’do, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.18",
            "verseOrgIds": [
              "ACT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.3"
              },
              "items": [
                {
                  "text": "’Yeta 20:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mani azi Opini ngazu asi e’yere be dria, mindresi, obeta ecapi ma vu e’yo ’ba Yahudini ’diyini otule ma ruaa diyisiri ma alia; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.19",
            "verseOrgIds": [
              "ACT.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "emi ni kini ma runi e’yo ecopi emi aza kopi ’diyi oluzu emi tia aluani ku, emi imbazu ’ba dria ma milia azini jo vusi jo vusi indi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.20",
            "verseOrgIds": [
              "ACT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi ojaza Mungu vuri ma e’yo eti nzezu ’ba Yahudini pi vu, ’ba Girikini be, azini a’ita Opi amani Yesu Kristo a’izuri ma eti nzezu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.21",
            "verseOrgIds": [
              "ACT.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "’Yeta 19:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te curu’do emi ne, ma mu Yerusale­mua, orindi mani ovu ombezaru, ma nini e’yo ngapi ecapi ma vu ’daleri ku; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.22",
            "verseOrgIds": [
              "ACT.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
