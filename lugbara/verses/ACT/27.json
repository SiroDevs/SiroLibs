            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.25"
              },
              "items": [
                {
                  "text": "2 Kor 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.29"
              },
              "items": [
                {
                  "text": "Lev 16:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "O’du kakau ka aga ra, zoza amanini ovule ewaru turisi, o’du nyaka ’dazurini agale ’borisi, Paulo imba yi ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.9",
            "verseOrgIds": [
              "ACT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kini, Ma agupi, acita ogurusi ’dori nga eca onzi tu, oguru pi afa alenia ’diyi pie ezazu toko, ama ngulupi ma idri be. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.10",
            "verseOrgIds": [
              "ACT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba asikari turu alu driliari eri e’yo ’ba oguru ti opipiri pini ’yole oguru e’i beri, aga Pauloni ’yoleri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.11",
            "verseOrgIds": [
              "ACT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti nderini ovule onyiru oguru dri ewu anguni ambizurisi kurisi, tuni ’ba kakau ega yini eri onyiru fuzu ’dia, yi nga te ca ani Foenikia ovuzu ’dale ewu anguni ambizurisi; eri kuti Kireteni, pari oli lipi a bararurini lizu kuri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli engapi alazarurini liria e’yere, yi ega yi eco ’yezu yini lelerile, yi ’du afa oguru otizu, yi aga Kiretea ogogo kutiasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.13",
            "verseOrgIds": [
              "ACT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ace were akuluku amboru engapi amveri li yi ra, runi Eurakulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.14",
            "verseOrgIds": [
              "ACT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli nderi ka oguru bi ’bo, ama econi tini opizu olivuleru ku, ’dini ama ku ma dro ama ceni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.15",
            "verseOrgIds": [
              "ACT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amani agaria angu i lipi miri ma alia were omvele Kauda’iri ma kuti vu ogogo, ama nga di ca o’bo bizu ewasi ka; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.16",
            "verseOrgIds": [
              "ACT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ka eri ese uru ’bo, yi ayu baka azakomaru fezu agazu oguru ma etiasi, ruani ombezu ci; te yini ruria kani yi nga ovu ’bezaru Suritisaa yapi, yi tru bongo olini oguru drezuri va, oli nga di ama dro tokoru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.17",
            "verseOrgIds": [
              "ACT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuluku nderini ama drole okpo­sirisi, dru ’dini yi ’ba afa oguruni lile ’diyi o’be miria; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.18",
            "verseOrgIds": [
              "ACT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "drozi o’du nasi yi ngulupi ofu afa oguruni ’diyi, o’be yi drisi ceni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.19",
            "verseOrgIds": [
              "ACT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu pi ’bi’bio be ka asi di o’du kakau ku, yi ombupi olisirini oguru oyaria tu, vilerisi ama ega ama ngani di ama pa aluni ku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "O’du kakau yi ka nyaka nya ku, Paulo so pa yi eselia, kini, Ma agupi, emi ka ndra e’yo mani ’yoleri eri ra, ka ndra angu Kireteari ku ku, te’do emi isuni e’yo onzi ’dori, afa ezazu toko ’doni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.21",
            "verseOrgIds": [
              "ACT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te curu’do ma emi imba, emi ma ovu asi tezasi; a’disiku ’ba emi eselia aluni ngani dra ku, alu oguruni drani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.22",
            "verseOrgIds": [
              "ACT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ini ’dorisi malaika Munguni so pa ma ageia, Mungu mani ovuzu erini mani inzile azisi indiri, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.23",
            "verseOrgIds": [
              "ACT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.11"
              },
              "items": [
                {
                  "text": "’Yeta 23:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kini, Paulo, mi ru ku; mi ma so pa Kaisari drilia; mi ne, Mungu fe ’ba mupi mi be ’diyi dria mi dri ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.24",
            "verseOrgIds": [
              "ACT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini, ma agupi, emi ovu di asi tezasi, a’disiku ma ovu a’itasi Mungu vu e’yoni nga i ’ye ekile te erini ’yole ma tia ’borile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.25",
            "verseOrgIds": [
              "ACT.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
