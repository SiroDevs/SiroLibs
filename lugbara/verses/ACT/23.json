                  "text": "24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Pauloni ’ba e’yo amapi ’diyi ma mile garia okporu; eri ’yo ra, Ma adripi, ma asi otini ku e’yo dria mani ’yele Mungu drilia ’diyisi ecazu kpere andrurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.1",
            "verseOrgIds": [
              "ACT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 23:2"
          },
