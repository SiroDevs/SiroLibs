                  "text": "23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ini nderisi Opi so pa eri ageia, ’yo ra, Mi ti asi ku; ekile mini e’yo mani ma eti nzele Yerusale­muarile, mi ma nze e’yo mani ma eti Rumia indi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.11",
            "verseOrgIds": [
              "ACT.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 23:11"
          },
          "items": [
