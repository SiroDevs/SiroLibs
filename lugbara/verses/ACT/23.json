                "loc": "MAT.23.27+MAT.23.28"
              },
              "items": [
                {
                  "text": "Mat 23:27-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.10+EZK.13.11+EZK.13.12+EZK.13.13+EZK.13.14+EZK.13.15"
              },
              "items": [
