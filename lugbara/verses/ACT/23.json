              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilaudio Lusia zi gavena Felikeni Inzile Turi ci ci. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
