              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.22",
            "verseOrgIds": [
              "ACT.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri omve ’ba asikari turu alu drilia ’diyi iri i vu, ’yo ra, Emi oti asikari turu iri ngonde, dri kozu sawa na inisi muzu Kaisariaa, asikari akanya dria ’diyi kali aziri, aju be ’diyi turu iri. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.23",
            "verseOrgIds": [
              "ACT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ede akanya azini Pauloni jizu, emi ji eri onyiru gavena Felike vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.24",
            "verseOrgIds": [
              "ACT.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri si waraga ekile ’dinile:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.25",
            "verseOrgIds": [
              "ACT.23.25"
            ]
          }
        }
      ]
