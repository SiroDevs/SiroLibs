              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.11",
            "verseOrgIds": [
              "ACT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angu ka ati ’bo, ’ba Yahudini yi efi ti yi eselia oyo sozasi, kini yi ngani nyaka nya ku, kani yi mvu ku, de yi funi nga Pauloni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.12",
            "verseOrgIds": [
              "ACT.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba oyo sopi ’diyi yi aga kali su ra, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.13",
            "verseOrgIds": [
              "ACT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.2"
              },
              "items": [
                {
                  "text": "Yoh 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi mu kuhani amboru vu ’ba ’wara vu indi, kini, Ama otri ama ngulupi oyo amborusi ra, ama ngani nyaka nya ku de ama funi nga Pauloni oko ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.14",
            "verseOrgIds": [
              "ACT.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi emi’i, tualu ’ba e’yo amapi ’diyi be, emi omve opi asikarini eri ejizu emi vu ekile emini lele e’yo erini ndazu kilili aga rarile. Te ama ovu ngonde eri fuzu de eri ecani ogogo ku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.15",
            "verseOrgIds": [
              "ACT.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.15",
            "verseOrgIds": [
              "ACT.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Paulo amvipi ma mva eri e’yo yini eri mbazuri ra; e’yo ’disi eri mu fi kali asikarinia, e’yoni oluzu Paulo tia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.16",
            "verseOrgIds": [
              "ACT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo eri omve ’ba asikari turu alu driliari alu i vu, kini, Mi ji karilau ’diri opi asikarini vu, eri le e’yo olu eri tia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.17",
            "verseOrgIds": [
              "ACT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’du eri ji opi nderi vu, kini, Paulo arururi omve ma i vu, zi ma ma eji karilau ’dori mi vu, a’disiku eri ovu e’yo ’yoza be mi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.18",
            "verseOrgIds": [
              "ACT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opi asikarini bi eri dria, mu eri be kalaa, zi eri oyokolosi, Mi le ma be a’di e’yo ’yo ya? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.19",
            "verseOrgIds": [
              "ACT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ’yo, ’Ba Yahudini ede e’yo yi eselia mi zizu Pauloni ejizu ’ba e’yo amapi ’diyi ma drilia dru, ekile yini lele e’yo erini ndale kilili aga rarile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.20",
            "verseOrgIds": [
              "ACT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te mi a’i e’yo yini zileri ku; a’disiku ’ba yini kali su dri be ’dipi yi eri mba geria. ’Ba ’diyi otri yi yi eselia oyosi kini, yi ngani nyaka nya ku, ngani yi mvu ku, de yi funi nga Pauloni ku; curu’do yi ede yi ngonde, aziza mini tezu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.21",
            "verseOrgIds": [
              "ACT.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini opi asikarini fe karilau nderi dri geri ra, eri azi kini, Mi ece ’ba aluni dri kini mi olu e’yo ’diri ma dri ra ’dini ku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.22",
            "verseOrgIds": [
              "ACT.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
