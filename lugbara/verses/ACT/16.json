        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 16:6"
          },
          "items": [
            {
              "text": "6",
