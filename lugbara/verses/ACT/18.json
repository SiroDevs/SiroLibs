        },
        {
          "text": "Vilerisi eri fu Ateneasi, ca Korintoa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.1",
            "verseOrgIds": [
              "ACT.18.1"
            ]
          }
        },
        {
