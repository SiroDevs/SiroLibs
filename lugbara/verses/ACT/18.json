                  "text": "Yoh 10:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’disiku ma on mi be, ’ba aluni ecopi a’di ’dipi be mi ’yepi onzini yo; te ’ba mani aku ’dori ma alia ’diyi kakau ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.10",
            "verseOrgIds": [
              "ACT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ovu ’dale eli alu drinia mba azia, e’yo Munguni imbaria yi eselia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.11",
            "verseOrgIds": [
              "ACT.18.11"
            ]
          }
        }
      ]
