            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.3"
              },
              "items": [
                {
                  "text": "Rum 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri isu ’ba Ya­hudini alu engapi Pontoari runi Akula’i, eri eca nga 0’diru oku erini Pirisila be engazu Italiaa, a’disiku Kilaudioni azita fele ’ba Yahudini dri dria yi ma fu Rumiasi rarisi, Paulo mu yi vu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.2",
            "verseOrgIds": [
              "ACT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 18:3"
          },
          "items": [
