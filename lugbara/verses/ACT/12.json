              "type": "tag",
              "attrs": {
                "loc": "ACT.5.21"
              },
              "items": [
                {
                  "text": "’Yeta 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anguni atiria ’boria, o’yona ovu asikari ma eselia ambo Pete­roni muzu ngoa yari ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.18",
            "verseOrgIds": [
              "ACT.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode ka eri nda ti, eri ozi asikari arujo agei tepi ’diyi e’yo yini lizu, eri azi yi ofuzu. Te eri enga Yudiaa sizu Kaisariaa, eri te ’dale.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        }
      ]
    },
