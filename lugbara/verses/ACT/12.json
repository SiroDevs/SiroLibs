              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Eze 28:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ongulumuru yi otre o’duko urusi kini, ’Di o’duko munguni, ’baniri yo! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.22",
            "verseOrgIds": [
              "ACT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
