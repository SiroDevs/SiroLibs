                  "text": "Dan 5:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Coti malaika Opini co eri ra, a’disiku eri feni diza Mungu dri ku; o’bu nya aleni, dra ra.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.23",
