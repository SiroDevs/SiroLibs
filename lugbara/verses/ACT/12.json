                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.37"
              },
              "items": [
                {
                  "text": "15:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ka e’yo ’di iyiki ra, eri mu ca Maria vile akua, eri Yohana yini omvele ru azinisi Marako’iri ma andri’i, pari ’ba kakauni yi okuzu Mungu zizuria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.12",
            "verseOrgIds": [
              "ACT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri ka jotile kpo ra, zamva runi Roda’i emu eri alu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.13",
            "verseOrgIds": [
              "ACT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erini niria eri Petero ma o’duko, eri zini jotile ayiko dri ku, te eri fi ongusi, ’yo ra Petero so pa amve jotilea ’daa! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.14",
            "verseOrgIds": [
              "ACT.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.24"
              },
              "items": [
                {
                  "text": "’Yeta 26:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.37"
              },
              "items": [
                {
                  "text": "Luk 24:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi ’yo eri tia kini, Mi aza aza. Te eri ’yo yi tia ’dani okposi kini eri ’dini. Awa’dini yi ’yo ra, Eri ovu malaika erini! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.15",
            "verseOrgIds": [
              "ACT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Petero ri jotile kpo ’dani; te yini ziria yi ndre eri, yi ovu taisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.16",
            "verseOrgIds": [
              "ACT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te eri oga drisi yi dri e’yo ’yoko si, eri ece yi dri e’yo Opini eri ofuzu arujoari. Eri ’yo kini, Emi olu e’yo ’diri Yakobo pi dri adripi be indi. Eri ko dri muzu pari azinia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.17",
            "verseOrgIds": [
              "ACT.12.17"
            ]
          }
        }
      ]
    },
