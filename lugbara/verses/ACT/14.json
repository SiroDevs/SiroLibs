                "loc": "PSA.147.8"
              },
              "items": [
                {
                  "text": "Zab 147:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.24"
              },
              "items": [
                {
                  "text": "Yer 5:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ti, kuni i e’yo eti nzeza kokoru ku, te eri ’ye onyiru, eri fe emi dri ozoo ’buari, ewu nyakani kazu ’diyi be, erini feria emi aleni traria nyakasi azini emi asini garia ayikosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.17",
            "verseOrgIds": [
              "ACT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te e’yo yini ’yole ’diyisi yi oga ’ba ongulumuru ewasi edeta edezu yi dri,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.18",
            "verseOrgIds": [
              "ACT.14.18"
            ]
          }
        }
      ]
