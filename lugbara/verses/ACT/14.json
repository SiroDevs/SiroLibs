                "loc": "JAS.5.17"
              },
              "items": [
                {
                  "text": "Yak 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agu ’diyi la! Emi e’yo ’diyi ’ye ’dini ­a’disi ya? Ama’i ama ovu ’ba rua be ekile emile, re ama olu emi dri e’yo bari kini emi ma oja emi e’yo toko toko ’diyi kuzu, emi ma a’i Mungu idriru ’bu ’bapi nyaku pi, miri pie, afa alenia ’diyi pie driari, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.15",
            "verseOrgIds": [
              "ACT.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.30"
              },
              "items": [
                {
                  "text": "’Yeta 17:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ewu agapi ’boria, eri ku ndra ’ba Juruni dria acizu waa yini lelerile; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.16",
            "verseOrgIds": [
              "ACT.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
