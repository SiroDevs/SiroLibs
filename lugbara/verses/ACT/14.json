                "loc": "JHN.9.1"
              },
              "items": [
                {
                  "text": "Yoh 9:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Lusiteraa agu alu ripi valesi ecopi acipi kuri indi; eri osi trua andri ma alia pa acoza be ’dani, acini nga drio aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.8",
            "verseOrgIds": [
              "ACT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.4"
              },
              "items": [
                {
                  "text": "’Yeta 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.28"
              },
              "items": [
                {
                  "text": "Mat 9:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agu nderi eri Pauloni e’yo oluria; Paulo su mile ruania okposi, erini neria eri ovu a’ita i pazuri be, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.9",
            "verseOrgIds": [
              "ACT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ’yo o’duko urusi kini, Mi so pa urulesi. Eri mbu uru, ’ba ad aci, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.10",
            "verseOrgIds": [
              "ACT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.6"
              },
              "items": [
                {
                  "text": "’Yeta 28:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ongulumuru ka e’yo Pauloni ’yeleri ndre, yi enga o’duko yini uru, yi ’yo ti Lukaonianisi, Mungu yi esi va ama vu wura be ekile ’bale! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.11",
            "verseOrgIds": [
              "ACT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi ’da Baranaba ma ru Zeu’i, yi ’da Paulo ma ru Herima’i, erini ovule ’ba e’yo olupi turisi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.12",
            "verseOrgIds": [
              "ACT.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atalau edeta edepi Zeuniri, ojio erini ovu aku amboru nderi drilia amveleru, eri eji tiago edezaru patibi onyiafarusi ’diyi kalitilea, yi le edeta ede ’ba ongulu­muru be tualu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.13",
            "verseOrgIds": [
              "ACT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ’ba ti opele ’diyi Baranaba pi Paulo be, yi ka e’yo nderi eri ’bo, yi osi bongo yini, yi onzu ’ba ongulumuru ma eseliasi, yi otre okposi ’yozu kini, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.14",
            "verseOrgIds": [
              "ACT.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
