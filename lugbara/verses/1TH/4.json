                "loc": "1CO.6.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "emi dria alu alu ma ni ovuzu rua ini ma opiru alata pi ma alia inzita be, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
