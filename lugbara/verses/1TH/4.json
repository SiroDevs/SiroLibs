              "items": [
                {
                  "text": "1 Pet 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo Munguni leleri ’di, ’baza emini alatararuri: emini emi onazu ali ’bazasi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
        },
