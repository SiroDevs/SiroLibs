            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo acepiri ’di, adripi, ama matu ’ba emi vu emi asi omizu Opi Yesu ma alia, kini, ekile emini ndra e’yo a’ile ama vu acizu ani onyiru lazini ayiko fezu Mungu dririle, ada ekile emini acilerile, emi ma ere emi drile drile. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te emi ni e’yo amani azile emi dri Opi Yesusiri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        },
        {
