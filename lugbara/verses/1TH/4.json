                  "text": "Zab 94:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’dini ’ba aluni ma eza ku, adripi ini ’yezu onzi e’yo ’diri ma alia, Opini ovule ’ba arioti ofepiri’i e’yo ’diyi ma alia drianirisi, ekile amani emi bilendu lile drio, e’yo eti nzezu emi tia okorile. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
