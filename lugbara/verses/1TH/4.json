                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Mungu omveni ndra ama e’yo onzikanyarusi ku, te alata ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
