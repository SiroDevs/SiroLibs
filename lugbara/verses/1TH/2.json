                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ama kuni awa’difo i’yozu Mungu dri ku, a’disiku emini e’yo Munguni ’diri eriria ama vu, emi a’ini eri ekile e’yo ’banirile ku, te ekile erini ovule adadarurile, ekile e’yo Munguni, azi ngapi emi ’ba a’ipi ’diyi ma aliarile. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.13",
            "verseOrgIds": [
              "1TH.2.13"
            ]
          }
        },
