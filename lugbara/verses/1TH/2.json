                  "text": "’Yeta 20:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te emini nilerile, ama ri ’ye emi vusi emi vusi dria alu alu, ekile atani ’yele anzi ini vurile, emi asi omizu azini omvizu, e’yo eti nzezu emi dri, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
            ]
