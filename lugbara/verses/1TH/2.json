                {
                  "text": "’Yeta 20:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te emi ega, adripi, azi okporu azini maturu amani ngale ndrari; ama adri ndra azi nga inisi etusi, ama ma ovu nzizaru ’ba aluni emi eseliari dri ku beni, amani ndra riria e’yo baru Munguniri oluria emi tiaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.9",
            "verseOrgIds": [
              "1TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ovu ’ba e’yo amani ma eti nzepi ’diyi, azini Mungu’i indi, kini ama ri ndra ovu emi ’ba e’yo a’ipi, diyi ma eselia asi alarusi e’yo kililiruri be, asu suza ama ruaani ndra yo; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.10",
            "verseOrgIds": [
              "1TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 2:11"
          },
          "items": [
