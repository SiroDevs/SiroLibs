              "items": [
                {
                  "text": "1 Tim 1:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ekile Munguni ama o’bile lale onyiru erini ani e’yo bari kuzu ama dri oluzu ’borile, ’dinile ama olu ra, ayiko fezu ’ba dri ku, te Mungu asi amani o’bipiri dri, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.4",
            "verseOrgIds": [
              "1TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 2:5"
          },
