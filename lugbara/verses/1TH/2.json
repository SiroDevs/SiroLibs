                "loc": "2PE.2.3"
              },
              "items": [
                {
                  "text": "2 Pet 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te engazu drio ama ’yoni e’yo inzita lokiriruri be ku, ekile emini nilerile, kani ’baza afasiri ma ri a’buzu inzosi, ’dini ku, Munguni e’yo ’diri ma eti nipiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.5",
            "verseOrgIds": [
              "1TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 2:6"
