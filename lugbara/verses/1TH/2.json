            "number": "3",
            "style": "v",
            "sid": "1TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama oluni asi omiza amani inzo ma e’yosi ku, kani e’yo alatara kokorurisi, kani lokirisi, ’dini ku; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.3",
            "verseOrgIds": [
              "1TH.2.3"
            ]
          }
        },
        {
