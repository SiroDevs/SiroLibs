                  "text": "44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ama ndani inzita ’ba vu, kani emi vu, kani ’ba azini vu aluni ku, ama ka tro eco ovuzu nzizaru emi dri ekile ’ba Kristoni ti opele ’diyile ti. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.6",
            "verseOrgIds": [
              "1TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama ovu e’yere emi eselia, ekile endriani anzi ma ta mbalerile. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.7",
            "verseOrgIds": [
              "1TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini, ava eminiri ama vale turisi, ama ega ndra eri onyiru kiri e’yo baru Munguniri fezu emi dri a’dule ku, te asi amani fezu indi, emini ovule ’ba ama asini lele tu ’diyi’irisi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.8",
            "verseOrgIds": [
              "1TH.2.8"
            ]
          }
        }
