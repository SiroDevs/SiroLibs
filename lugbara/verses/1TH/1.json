                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ama kuni azi emini ’yele a’itasiri pi ma e’yo egazu Mungu Ata amani ma milia, azi okporu emini ’yele letasiri pie, asi teza emini Opi Yesu Kristo tezuri pie ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        },
