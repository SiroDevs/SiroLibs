              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adripi Munguni lele ’diyi, ama ni opeza eminiri ra; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.4",
            "verseOrgIds": [
              "1TH.1.4"
            ]
          }
        },
