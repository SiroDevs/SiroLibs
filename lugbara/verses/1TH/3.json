            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.22"
              },
              "items": [
                {
                  "text": "’Yeta 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Adaru amani ovuria ndra emi be, ama olu emi tia kililiru oko kini yi nga ama ecandi inzatasi; emi ni ra e’yoni ’ye i ’dinile ra. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.16"
              },
              "items": [
                {
                  "text": "Fil 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ma’i mani ecoria ma asi imbazu teztr ’dani ku, ma pe ani ’ba ti a’ita emini ma e’yo nizu, kani ’ba ’ba obepiri obe emi ra, ka’dini azi amani eri de di toko yani.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
