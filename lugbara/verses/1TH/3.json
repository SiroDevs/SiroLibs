                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "azini ama pe adripi amani Timo­teo, ’ba azi ngapi Mungu be e’yo baru Kristoniri ma ajiari ma ti, emi ’bazu okporu, asi emini omizu a’ita emini ma alia, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
