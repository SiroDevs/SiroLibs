              "items": [
                {
                  "text": "2 Tes 1:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba aluni ma asi ma oti inzata ’diyi ma e’yosi ku. Te emi ngulupi ni ra ama ovu pezaru e’yo ’diri isuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
