          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.34"
              },
              "items": [
                {
                  "text": "Ebra 10:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba dria alu jo pi kupi, adripi pie, amvipi pie, ati pie, andri pie, anzi pie, angu pie dria, ma rusiri, yi nga eri ofe pale turu, azini eri nga idri ’dani ’daniri bi awitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
