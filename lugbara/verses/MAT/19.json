                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga eca, Yesu ka e’yo’diyi’yo de’bo eri fu Galiliasi, nga eca Yudia ma kalati Yoridania ’aa’dasiria, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "’ba ongu­lumuru kakau bi eri ma vuti, eri nga yi ati ’dale.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.2",
            "verseOrgIds": [
              "MAT.19.2"
            ]
          }
        }
      ]
