              },
              "items": [
                {
                  "text": "Luk 10:26-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo eri tia, Mi zi onyi ma e’yo ma tia a’disi ya? ’Ba onyi beri eri alu. Te mi ka le fi idria, mi mba azita ma tao ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.17",
            "verseOrgIds": [
              "MAT.19.17"
            ]
          }
        },
        {
