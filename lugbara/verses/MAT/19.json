          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.20"
              },
              "items": [
                {
                  "text": "Mat 6:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.33"
              },
              "items": [
                {
                  "text": "Luk 12:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu nga ’yo eri tia, Mi ka le ovu kililiru, mi mu, mi ozi afa mini dria, mi fe ’ba alioru dri, te mi nga ovu lonyi be ’bua; azini mi emu ma vuti bizu ani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 19:22"
          },
          "items": [
