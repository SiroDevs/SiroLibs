              "items": [
                {
                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mi inzi ati pi mi andri be, azini Mi le mi agyi mini mi lelerile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.19",
            "verseOrgIds": [
              "MAT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karilau nga ’yo eri tia, Ma mba ’diyi ma ta dria ’bo; e’yo ngoni ace nga vinini ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
