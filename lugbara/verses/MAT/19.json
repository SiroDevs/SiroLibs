          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nga ’yo ’ba erini imbale ’diyi ma tia, Ma ’yo emi tia ndi, kini, eri nga ovu ewaru ’ba afa e’iru dri fizu suru ’buaria. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        },
        {
          "name": "verse",
