            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.13+MRK.10.14+MRK.10.15+MRK.10.16"
              },
              "items": [
                {
                  "text": "Mar 10:13-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.15+LUK.18.16+LUK.18.17"
              },
              "items": [
                {
                  "text": "Luk 18:15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etu ’dasi yi eji auzi nyiri eri vu, eri ma ti dri yi dria ani beni, ma a’i Mungu yi dri indi; te ’ba erini imba1e ’diyi nga ega yi ma dria. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.13",
            "verseOrgIds": [
              "MAT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.2"
              },
              "items": [
                {
                  "text": "Mat 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yesu nga ’yo ra, Emi ku anzi nyiri ma emu ma vu, emi ma oga yi si ku; suru ’buari ovu ’ba ’dinile ’diyini. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.14",
            "verseOrgIds": [
              "MAT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga i dri oti yi dria, nga fu ’darisi ndo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.15",
            "verseOrgIds": [
              "MAT.19.15"
            ]
          }
        }
      ]
    },
