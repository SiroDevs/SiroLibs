                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo eri tia, Ngoyi ya? Yesu nga ’yo ra, Mi fu ’ba ku, Mi ’ba ali ku, Mi ogu ku, Mi nze e’yo eri inzoru ku, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        },
