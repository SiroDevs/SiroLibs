              "items": [
                {
                  "text": "Zab 62:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te karilau, erini e’yo ’diri eriria, nga mvi asi candirusi; a’disiku eri afa be kakau.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
