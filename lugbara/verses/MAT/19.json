            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.6"
              },
              "items": [
                {
                  "text": "Zek 8:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesuni mile baria yi ruaa, nga yo yi tia, Ba vurisi e’yo ’diri econi ku, te Mungu vurisi e’yo dria eco ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero nga di e’yo omvi, ’yo eri tia, Mi ndre, ama ku afa dria ’bo, ama bi mi vuti. Ama nga ani a’di isu ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
