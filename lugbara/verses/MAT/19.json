              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu; nga ’yo yi tia, Ma ’yo emi ria ndi, emi ’ba ma vuti bipi ’diyi, ewu afa ’bazu o’dirurisi Mvi ’bani ka ri oguna erini dizaruri dria, emi’i indi, emi nga ri oguna mudri drini iri ma dria, suru mudri drini iri Israelini ’diyi ma e’yo lizu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
