                "loc": "MAT.5.31"
              },
              "items": [
                {
                  "text": "Mat 5:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
