          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.8.3"
              },
              "items": [
                {
                  "text": "Azi 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga e’yo omvi ’yo ra, E’yo si i ’bo ’dini,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
            ]
          }
        }
