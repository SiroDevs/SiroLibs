              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.47"
              },
              "items": [
                {
                  "text": "Mat 13:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.10"
              },
              "items": [
                {
                  "text": "Eze 47:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri nga ’yo yi tia, Emi bi ma vuti, ma nga emi ’ba ’ba ’ba okupi ’diyiru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.27"
              },
              "items": [
                {
                  "text": "Mat 19:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga emba yini ku coti, nga eri ma vuti bi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.20",
            "verseOrgIds": [
              "MAT.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engazu ’daarisi, eri nga mu drile, nga adripi iri azini ndre, Yakobo Zebedayo mvi pi adripi Yohana be, yi ovu oguru alia ati Zebedayo pie, emba yini ederia; eri nga yi omve. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.21",
            "verseOrgIds": [
              "MAT.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yi nga oguru pi ku yi ati be coti, nga eri vuti bi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
          }
        }
      ]
    },
