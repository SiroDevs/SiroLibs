                  "text": "Yoh 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri nga Nazaretini ku ra, nga emu ovu Kaperinaumua, aku nde miri tia, kala Zebuluni pini Nafutali beria; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
