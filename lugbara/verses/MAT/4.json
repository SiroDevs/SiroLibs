                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ka eri kini fe Yohanani aruru ’bo, eri nga mvi Gailia; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
