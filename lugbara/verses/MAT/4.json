                {
                  "text": "Efu 34:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.8"
              },
              "items": [
                {
                  "text": "1 Opi 19:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka de o’du kali su etusi inisi dria nyaka kokoru, vilerisi abiri nga eri fu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
