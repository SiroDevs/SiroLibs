                "loc": "MRK.1.15"
              },
              "items": [
                {
                  "text": "Mar 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi oja emi asi; suru ’buari eca ogogo ’bo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
          }
