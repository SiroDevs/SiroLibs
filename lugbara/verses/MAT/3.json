                  "text": "Yoh 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ’diri eri ’ba ndra nabi Isayani e’yoni ’yoleri’i, kini,",
          "type": "text",
