                "loc": "JHN.1.31+JHN.1.32+JHN.1.33+JHN.1.34"
              },
              "items": [
                {
                  "text": "Yoh 1:31-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu nga di enga Galiliarisi, nga mu Yoridania Yohana vu, baputizi bizu vunia beni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yohana le oga eri dri si, kini, Si te mani baputizi bizu mi vu, mi vini emu ma vu ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.14",
            "verseOrgIds": [
              "MAT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yesu nga e’yo omvi, ’yo tinia kini, Curu’do di mi a’i; onyiru amani e’yo kililiru ’yezu dria’i, Eri nga di a’i eri dri ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te Yesu ka baputizi bi ’bo, eri efu yiarisi, etu amve coti, te mi ndre, ’bu zi i eri dri ra, eri ndre Orindi Mungunini esiria va a’balau­le, emuria i dria; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.16",
            "verseOrgIds": [
              "MAT.3.16"
            ]
          }
        },
