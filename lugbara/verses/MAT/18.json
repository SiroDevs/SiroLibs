                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Etu ’dasi ’ba erini imbale ’diyi nga eca Yesu nga ’yo ra, A’dini nga ovu amboru suru ’buarima aliani ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga mva were omve i vu, nga eri ’ba pa sozu yi ma,eselia, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
