              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.24"
              },
              "items": [
                {
                  "text": "Mar 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia dika kini ’ba iri emi eselia ka ti eci tualu nyakua e’yo alu dria yini zile ’diyisi Ata mani ovupi buari nga eri ’ye yi dri ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
