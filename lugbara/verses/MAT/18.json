        },
        {
          "text": "Te eri ka eri ku, mi ji ’ba, alu, kani ’ba iri mi be indi, ’dini e’yo dria ma so pa ’ba e’yo eti nzepi ’ba iri kani na ’diyi ma tisi ani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
