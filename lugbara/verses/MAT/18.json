        },
        {
          "text": "Te ’ba azini ka mva were ’dinileru alu a’i ma rusi, eri a’i ma’i; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
