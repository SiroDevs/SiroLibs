                "loc": "JHN.3.3+JHN.3.4+JHN.3.5"
              },
              "items": [
                {
                  "text": "Yoh 3:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri nga ’yo ra, Ma ’yo emi,ria ndi, emi ka emi oja ovuzu anzi nyiri nyirile ku, emi ngani fi suru ’buaria aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E’yo ’disi ’ba,azini ka i oja afu kokoru ekile mva were’dirile, ’ba nderi eri ’ba amboru suru ’buari ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        }
      ]
