              },
              "items": [
                {
                  "text": "1 Kor 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eri ka e’yo yini ’yoleri ga si, mi ’yo kanisa tia; eri ka e’yo kanisani ga si, eri ma ovu mi dri ekile ’ba jurule kani ’ba musoro okupirile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.17",
            "verseOrgIds": [
              "MAT.18.17"
            ]
          }
        },
        {
