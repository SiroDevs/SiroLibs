              "items": [
                {
                  "text": "Yoh 14:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te pari ’ba iri kani ’ba na yini yi okuzu tualu ma rusiria pari ’daa ma indi yi eselia.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
