              "items": [
                {
                  "text": "Mat 16:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.23"
              },
              "items": [
                {
                  "text": "Yoh 20:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia ada, afa dria emini ombele nyakuari nga ovu ombezaru ’bua, azini afa dria emini trule nyakuari nga ovu truzaru ’bua indi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
