          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.1"
              },
              "items": [
                {
                  "text": "Luk 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba azini ka anzi nyiri ma a’ipi ’diyi ma azi alu fe aba ra, onyiru yi ma ombe oni amboru anya ’izuri eri ombelea, ma ’be eri yi aliru miriniri ma alia.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        }
      ]
