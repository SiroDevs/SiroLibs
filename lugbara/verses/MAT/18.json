              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ma ovu mile be emi ma ede anzi nyiri ’diyi ma azi aluni ku; te ma ’yo emi tia kini malaika yini ’bua ’diyi yi Ata mani ovupi ’buari ma mile ndre etu dria. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.10",
            "verseOrgIds": [
              "MAT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
