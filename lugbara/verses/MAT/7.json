              "items": [
                {
                  "text": "’Yeta 20:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi te emi agei nabi inzoru ’diyisi; ’ba nde emu emi vu ruasi kabilole, te alialeru yi ’balauni adraru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.15",
            "verseOrgIds": [
              "MAT.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.19+GAL.5.20+GAL.5.21+GAL.5.22"
              },
              "items": [
                {
                  "text": "Gal 5:19-22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.3.12"
              },
              "items": [
                {
                  "text": "Yak 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi nga yi ama, efi yini ’yale ’diyisi. ’Ba nga zabibu ti oci ruaa ya? Kani elio la ma ruaa ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.16",
            "verseOrgIds": [
              "MAT.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.33"
              },
              "items": [
                {
                  "text": "Mat 12:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini pati alu dria onyiruri eri efi onyiruri ’ya ra, te pati onzikanyaruri eri efi onzikanya­ruri-ya’i. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
              "MAT.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pati onyiru econi efi onzikanyaru yazu ku, ’dini pati onzikanyaru econi vini efi onyiru ’yazaru ku indi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.18",
            "verseOrgIds": [
              "MAT.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 7:19"
          },
          "items": [
