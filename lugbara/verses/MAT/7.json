              },
              "items": [
                {
                  "text": "16:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi zi, eri nga ovu fezaru emi dri; emi ndru, emi nga isu ra; emi kpo eri nga ovu zizaru emi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.7",
            "verseOrgIds": [
              "MAT.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’disiku’ba dria afa zipiri eria’i ra; ’ba ndrupiri isu ra; ’ba kpopiri dri yi nga zi ra, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.8",
            "verseOrgIds": [
              "MAT.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba emi eselia a’di’i, mva erinini enya a’izu, ngazu eri dri oni fezu’i ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.9",
            "verseOrgIds": [
              "MAT.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka e’bi a’i, eri nga eri dri uri fe’i ya?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.10",
            "verseOrgIds": [
              "MAT.7.10"
            ]
          }
        }
      ]
    },
