            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi fe afa alatararu oce dri ku; emi o’be vini nyoro ndrizaro emini ezo drilia ku, yi kazu yi otuzu yi ma pasi ku, kazu yi ojazu vile emi rua osizu ku indi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.6",
            "verseOrgIds": [
              "MAT.7.6"
            ]
          }
        }
      ]
    },
