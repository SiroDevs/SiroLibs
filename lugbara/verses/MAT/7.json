                  "text": "9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi fi kalitile luruarurisi; a’disiku kalitile walaru azini geri walaru muzu dri jaza vu, ’ba fipi alenia ’diyi kakau. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.24"
              },
              "items": [
                {
                  "text": "Mat 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.22"
              },
              "items": [
                {
                  "text": "’Yeta 14:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te kalitile luruaru azini geri izinaro muzu idri vu, ’ba eri isupi ’diyi were.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.14",
            "verseOrgIds": [
              "MAT.7.14"
            ]
          }
        }
      ]
