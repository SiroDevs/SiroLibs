          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "A’di’i emi eselia eco i ma zota erezaru wuale alusi asi otizasini ya?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.27",
            "verseOrgIds": [
              "MAT.6.27"
            ]
          }
        }
