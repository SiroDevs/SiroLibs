                  "text": "Mat 10:29-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi lu aria ’bua ’diyi: yi rini ori ku, loni ku, okuni ero alia ku, te Ata emini ’buari eri yi esu nyakasini. Emi, agani yi onyisini ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
