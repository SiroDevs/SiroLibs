                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ma ’yo emi tia, Sule­mani’i ti, diza eriniri be dria, suni i yi ma azile ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
