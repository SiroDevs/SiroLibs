          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi vu guka mi milia mini afa awaria ’ba alioru dri ku, ekile ’ba lokiri be ’diyini ’yele pari ’bani yi okuzuria azini geria, ’ba nde ma inzi yi ani benirile. Ma ’yo emi tia ndi, yi bi oya yini ’bo ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
