              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero nga eri bi, nga ’ba ega eri dria ’yozu kini, ’Dini yo fo, Opi la! E’yo ’diri ma ’ye i mi ruaa aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
