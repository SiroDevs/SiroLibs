                  "text": "Luk 11:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba Farisaini piyi nga eca ’ba Sadukayoni be eri o’bizu, nga zi eri tia eri ma ece eceta engapi ’buari yi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.1",
            "verseOrgIds": [
              "MAT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.54+LUK.12.55+LUK.12.56"
              },
              "items": [
                {
                  "text": "Luk 12:54-56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri nga e’yo omvi, ’yo yi tia kini, Ka eca ondresi, emi adri ’yo, Anguni nga ovu onyiru, ’buni ovule ekarurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.2",
            "verseOrgIds": [
              "MAT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.4"
              },
              "items": [
                {
                  "text": "Mat 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te o’bitisi, Andru angu mile onzi, ’buni ovule ekaru azini iritini ovule inirurisi. Emi ni ’bu ma mile amazu ra ’bo, te eceta ewuniri emi econi amazu ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.3",
            "verseOrgIds": [
              "MAT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.39"
              },
              "items": [
                {
                  "text": "Mat 12:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.29"
              },
              "items": [
                {
                  "text": "Luk 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.2.1"
              },
              "items": [
                {
                  "text": "Yon 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’bianzi onzi ali o’bapi ’diyi yi eceta nda, te yi ngani eceta fe yi dri ku, pe lu eceta Yonani. Eri nga yi ku ra, mu ra.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.4",
            "verseOrgIds": [
              "MAT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Ba erini imbale ’diyi nga ca ’aa’dasi, te yi ma dri avi mikate jizu ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.5",
            "verseOrgIds": [
              "MAT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.1"
              },
              "items": [
                {
                  "text": "Luk 12:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yesu nga ’yo yi tia, Emi ndre emi te emi agei akufi ’ba Farisaini pini ma e’yosi ’ba Sadu­kayoni be. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.6",
            "verseOrgIds": [
              "MAT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yingae’yo ega yi eselia, ’yo kini, Ama ejini mikate ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.7",
            "verseOrgIds": [
              "MAT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.30"
              },
              "items": [
                {
                  "text": "Mat 6:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu ka ni ra eri nga ’yo ra, Emi a’ita be were ’diyi la, emi e’yo ega emi eselia emini ovule mikate kokorurisi a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.8",
            "verseOrgIds": [
              "MAT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.17+MAT.14.18+MAT.14.19+MAT.14.20+MAT.14.21"
              },
              "items": [
                {
                  "text": "Mat 14:17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi vani nga kiri ku, emi egani mikate towi ’ba alifu towi driri ku ya? Emi o’du ndra evu si ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.9",
            "verseOrgIds": [
              "MAT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.34+MAT.15.35+MAT.15.36+MAT.15.37+MAT.15.38"
              },
              "items": [
                {
                  "text": "Mat 15:34-38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kani mikate aziri ’ba alifu su driri, emi o’du abaka si ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.10",
            "verseOrgIds": [
              "MAT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi vani ku kini ma ’yoni e’yo mikateni emi tia ku ngoni ya? Te emi te emi agei akufi ’ba Farisaini pini ma e’yosi ’bai Sadukayoni be. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.11",
            "verseOrgIds": [
              "MAT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.27"
              },
              "items": [
                {
                  "text": "Yoh 6:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yi nga di va ani kini eri ’yoni e’yo agei tezu akufi mikateni ma e’yosi ku, te yi agei tezu imbata ’ba Farisaini pini ma e’yosi ’ba Sadukayoni be.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.12",
            "verseOrgIds": [
              "MAT.16.12"
            ]
          }
        }
      ]
    },
