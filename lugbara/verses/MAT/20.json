              "items": [
                {
                  "text": "Luk 22:25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yesu nga yi omve i vu, nga ’yo ra, Emi ni ra ’ba ’ba juru dri cepi ’diyi adri yi ma drilia opiru, ’ba amboru yini adri yi ayu okposi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
