                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yini furia Yerikoarisi, ’ba ongulumuru kakau bi eri vuti. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
