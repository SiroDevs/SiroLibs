              "items": [
                {
                  "text": "Luk 22:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eri ngani ovu ’dinile emi eselia ku; te ’ba ka le ovu ’ba amboru emi eselia, eri ma ovu ’ba emi ma aza kopiriru, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
