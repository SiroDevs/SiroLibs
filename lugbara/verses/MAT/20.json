              },
              "items": [
                {
                  "text": "Luk 18:31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesuni turia Yerusalemua, eri nga ’ba erini imbale mudri drini iri ’diyi ’du kalaa, nga ’yo yi tia geria oyokolosi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.21"
              },
              "items": [
                {
                  "text": "Mat 16:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.22"
              },
              "items": [
                {
                  "text": "17:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Emi ndre, ama tu Yerusalemua; yi nga Mvi ’bani fe kuhani amboru piyi dri ’ba waraga sipi ’diyi be, ’ba ’diyi nga e’yo li drinia eri fuzu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi nga eri fe ’ba jururu ’diyi vu eri ecandizu, eri cozu, eri dizu pati ruaa, te o’du nasi eri nga enga ra.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        }
      ]
    },
