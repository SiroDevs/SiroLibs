              "items": [
                {
                  "text": "Luk 22:24-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba mudri ka e’yo ’diri eri ra, yi ovu aokosi adripi iri ’diyi vu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        },
        {
