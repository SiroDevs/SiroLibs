          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "te ’ba ka le ovu ’ba okoriru emi eselia, eri ma ovu ati’bo emini; ",
          "type": "text",
          "attrs": {
