          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "yi nga eri fu ra, o’du nasi eri nga enga ra. Yi ovu candisi tu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
            "verseOrgIds": [
              "MAT.17.23"
