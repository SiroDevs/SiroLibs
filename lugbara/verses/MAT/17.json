              "type": "text"
            }
          ]
        },
        {
          "text": "Yini ovuria Galilia, Yesu nga’yo yi tia, Yi nga Mvi ’bani fe ’ba dria, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
