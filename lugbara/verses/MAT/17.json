                "loc": "MAT.16.20"
              },
              "items": [
                {
                  "text": "Mat 16:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yini siria oni driarisi va, Yesu nga e’yo azi yi tia kini, Emi olu afa ndreza ’dori ma e’yo ’ba aluni ma ria ku, de nga Mvi ’bani engani ’ba draza ma eselia ku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.9",
            "verseOrgIds": [
              "MAT.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Mal 2:23",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.5"
              },
              "items": [
                {
                  "text": "4:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.14"
              },
              "items": [
                {
                  "text": "Mat 11:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba erini umbale ’diyi nga eri tia, yi ’yo ra, ’Ba waraga sipi ’diyi ’yo kini Eliya ma eca raka, ’dini a’disi ya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.10",
            "verseOrgIds": [
              "MAT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri nga e’yo omvi, nga ’yo ’ra, Eliyani nga eca ada, afa dria edezu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.11",
            "verseOrgIds": [
              "MAT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.14"
              },
              "items": [
                {
                  "text": "Mat 11:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.9"
              },
              "items": [
                {
                  "text": "14:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te ma ’yo emi tia, Eliya eca di ’bo, azini yi nini eri ku, te yi ’ye eri yini lelerile. Te Mvi ’banini nga candi, isu yi dri ’dinile indi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.12",
            "verseOrgIds": [
              "MAT.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.17"
              },
              "items": [
                {
                  "text": "Luk 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba erini imbale ’diyi nga di va eri ’yo yi tia Yohana baputizi fepiri e’yo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.13",
            "verseOrgIds": [
              "MAT.17.13"
            ]
          }
        }
      ]
    },
    {
