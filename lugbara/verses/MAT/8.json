              "items": [
                {
                  "text": "Luk 17:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu nga ’yo eri tia, Mi ndre mi ’yo ’ba azini ma tia ku; te mi mvi, mi ece mi kuhani vu, mi ji afa feza Musani ndra azileri, ecetaru yi dri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.4",
            "verseOrgIds": [
              "MAT.8.4"
            ]
          }
        }
