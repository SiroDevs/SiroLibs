              "items": [
                {
                  "text": "Luk 9:57-60",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba waraga sipiri alu nga eca eri vu, nga ’yo eri tia, ’Ba ’ba imbapiri, ma nga mi vuti bi pari mini muzuria dria. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.19",
            "verseOrgIds": [
