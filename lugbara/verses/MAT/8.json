                  "text": "Luk 13:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "te anzi suruni nga ovu ’bezaru angu inicici amveria; ’dale awu pi nga ovu indi sikala nyaza be. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.12",
            "verseOrgIds": [
              "MAT.8.12"
            ]
          }
        },
        {
