            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.29"
              },
              "items": [
                {
                  "text": "Mat 9:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.28"
              },
              "items": [
                {
                  "text": "15:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu nga ’yo ’ba asikari turu alu ma driliari tia, Mi mvi; ekile mini a’ilerile, ma ’ye i mi vu ’dini. Ati’bo erini ma rua ati coti sawa ’dasi ra.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
              "MAT.8.13"
            ]
          }
        }
      ]
