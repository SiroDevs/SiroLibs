                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ’yo emi tia kini ’ba kakau nga enga etuni efuria, azini etuni ’deria, yi nga ri va pari alua Iburahimu pi, Isaka pie, Yakobo pie, suru ’buaria, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.11",
            "verseOrgIds": [
              "MAT.8.11"
            ]
          }
        },
        {
