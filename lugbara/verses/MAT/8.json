            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuni firia Petero vile joa, eri nga eri ma idrini ndre lazaru azoru rua driza be; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.14",
            "verseOrgIds": [
              "MAT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri nga eri ma dri elo, rua drizani nga eri ku ra, eri nga enga ra, azi ngazu eri dri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.15",
            "verseOrgIds": [
              "MAT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka eca ondresi yi nga ’ba kakau orindi onzi be ’diyi eji eri vu; eri nga orindi onzi odro e’yo ’yozasi, nga ’ba dria azo be ’diyi ati ra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.16",
            "verseOrgIds": [
              "MAT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
