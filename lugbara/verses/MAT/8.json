              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.9"
              },
              "items": [
                {
                  "text": "2 Kor 8:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu nga ’yo eri tia, Obalako gule yini ci azini aria ’bua ’diyi jorovu rini ci; te Mvi ’bani dri pari erini dri ’bazuri yo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.20",
            "verseOrgIds": [
              "MAT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.20"
              },
              "items": [
                {
                  "text": "1 Opi 19:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ba eri ma vuti bipi ’diyi ma azi ’yo eri tia,Opi, mi ku ma mu ma atini sa oko raka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
            "verseOrgIds": [
              "MAT.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.43"
              },
              "items": [
                {
                  "text": "Yoh 1:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.25"
              },
              "items": [
                {
                  "text": "5:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.13"
              },
              "items": [
                {
                  "text": "Rum 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Yesu nga ’yo eri tia, Mi bi ma vuti,mi ku ’ba draza ma sa ’ba draza yiniri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.22",
            "verseOrgIds": [
              "MAT.8.22"
            ]
          }
