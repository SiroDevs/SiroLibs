              "type": "text"
            }
          ]
        },
        {
          "text": "Ama zi tile amani mgboru e’yo ’yozu emi tia, emi ’ba Korintoa ’diyi la; asi amani ovu walaru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
