        },
        {
          "text": "Emi fe pari ama dri emi asia; ama ’yeni ’ba aluni onzi ku, ama ezani ’ba aluni ku, ama nyani ’ba aluni ma afa lokirisi ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.2",
