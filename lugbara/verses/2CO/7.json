                  "text": "Isa 66:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te Mungu ’ba e’yere ’diyi ma asi omipiri omi ama asi Titoni ecalerisi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.6",
            "verseOrgIds": [
              "2CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "te erini ecalerisi a’dule ku, te omi vini ama asi indi asi omiza nde emini eri ma asi omizurisi, eri ka ava eminiri pi ma e’yo olu ama tia, candi emini pie, asi avaru emini masiri be, ’dini ma ovu ani ayikosi aga ra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.4"
              },
              "items": [
                {
                  "text": "2 Kor 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ka ndra candi fe emi dri waraga manisi, ma ojani di ani ma asi e’yo ’dirisi ku, ma ka mira ovu candi be okorisi ti, a’disiku ma ndre waraga nde ’dari fe ndra candi emi dri, ka tro o’du were a’dule ti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.8",
            "verseOrgIds": [
              "2CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te curu’do ma ovu ayikosi, emini ovule candi berisi ku, te candi eminini emi jile kpere cazu asi ojaza vurisi; a’disiku candi emini ovu candi Munguni feleniri’i, ka’dini ama ’yeri emi onzi aluni ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.9",
            "verseOrgIds": [
              "2CO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.3+MAT.27.4+MAT.27.5"
              },
              "items": [
                {
                  "text": "Mat 27:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.17"
              },
              "items": [
                {
                  "text": "Ebra 12:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini candi Munguni feleniri ’ba asi oja pata ’bani ani yi asi ojazu vile dika kuri vu; te candi nyakuni fele­niri eri dra fe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.10",
            "verseOrgIds": [
              "2CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini mi lu, e’yo nde candi emini Munguni feleniri, eri ’ye emi asia ava amboru ’dopi ’doni ya, e’yo e’daza pie, asi veza pie, uri pie, asi ’baza avasiri pie, ava e’yo ’yezuri pie, e’yo liza pie dria Geri driasi emi o’bi ndra emi ecezu ovuzu a1aru e’yo ’diri ma alia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.11",
            "verseOrgIds": [
              "2CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini ma si ndra waraga emi vu ra ’bo, te ma sini e’yo nde ’ba onzi ’yepiri ma e’yosi ku, kani ’ba yini e’yo onzi ’yele vuniari ma e’yosi ku indi, te leta emini ama vuri ma ovu ecezaru emi vu Mungu ma milia ani beni.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.12",
            "verseOrgIds": [
              "2CO.7.12"
            ]
          }
        }
      ]
    },
