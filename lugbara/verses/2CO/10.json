              "items": [
                {
                  "text": "Gal 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma’i Paulo, ma emi zi asi afu kokoru Kristonisi, azini e’yo e’yereru erinisi indi-ma’i ovupi e’yere emi eselia mani ovuria emi miliari, re mani ovuria emi be reria ma ovu asi okporu be emi vu- ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.1",
            "verseOrgIds": [
              "2CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
