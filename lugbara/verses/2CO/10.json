              "items": [
                {
                  "text": "1 Kor 1:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ’ba i enyapiri ma enya i Opisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
