              },
              "items": [
                {
                  "text": "’Yeta 19:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kpere amani ngaria e’yo bari oluria angu emi ma kala ’daleria, amani ani ama enyazu azi ovupi edezaru angu esele o’bile ’ba azini driri ma aliari ma e’yosi ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        },
