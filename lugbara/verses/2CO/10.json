                "loc": "ROM.15.20"
              },
              "items": [
                {
                  "text": "Rum 15:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A­ma enyani ama aga o’biza amani, ’ba azini ma azi okporu ma e’yosi ku; te ama ovu asi teza be, a’ita eminini zoria ’boria, esele amani nga ovu ’bazaru amboru aga ra e’yo eminisi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.15",
            "verseOrgIds": [
              "2CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
