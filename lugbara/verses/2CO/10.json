                "loc": "1CO.4.21"
              },
              "items": [
                {
                  "text": "1 Kor 4:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma mate ’ba emi vu, mani ngaria ovuria emi eselia indi ma ma ece asi okporu asi teza be, ekile mani egale ovuzu okporu ’ba azini egapi kini ama aci ruasi ’diyi vurile, ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.2",
            "verseOrgIds": [
              "2CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama ka aci rua ma alia ri, ama ’bani omba ruasi ku, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.3",
            "verseOrgIds": [
              "2CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.13+EPH.6.14+EPH.6.15+EPH.6.16+EPH.6.17"
              },
              "items": [
                {
                  "text": "Efe 6:13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "a’disiku afa ombani amani ’diyi ovuni afa ruani ku, te yi okporu Mungusi pari okporu ’diyi asuzu va. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.4",
            "verseOrgIds": [
              "2CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ama agata gaza asu va, afa dria i ’bapi uru nita Munguni ma geri ogapi ’diyi be, e’yo dria ’bani otule i asia ’diyi bizu ari’boru Kristo ma e’yo erizu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.5",
            "verseOrgIds": [
              "2CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.9"
              },
              "items": [
                {
                  "text": "2 Kor 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ama ovu edezaru ngonde panga fezu edematara dria ma e’yosi, e’yo eriza emini ka nga i ’ye raria.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        }
      ]
    },
    {
