                  "text": "1 Kor 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te e’yo baru amaniri ka ovu a’bu­zaru, eri ovu a’buzaru ’ba dri japi ’diyi dri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.3",
