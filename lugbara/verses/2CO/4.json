                  "text": "Rum 8:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disi-ku ama’i ovupi idriru ’diyi ovu fezaru o’du dria drata vu Yesu ma e’yosi, idri Yesuni ma e’da i ani rua draza amani ma alia indi beni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
