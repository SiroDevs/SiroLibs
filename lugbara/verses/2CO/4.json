                "loc": "2CO.1.24"
              },
              "items": [
                {
                  "text": "2 Kor 1:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama oluni ama ngulupi ma e’yo ku, te Kristo Yesu ma e’yo’i, kini eri Opi’i, azini ama’i ama ati’ba emini Yesu ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.5",
            "verseOrgIds": [
              "2CO.4.5"
            ]
          }
        },
