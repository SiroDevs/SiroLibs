              "items": [
                {
                  "text": "7:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inza ama e’yo driasi, te ombeni ama ku; fe ama dri asi otiza ra, te asi amani funi ku; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.8",
            "verseOrgIds": [
              "2CO.4.8"
            ]
