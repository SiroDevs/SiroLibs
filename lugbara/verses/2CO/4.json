                "loc": "1TH.2.5"
              },
              "items": [
                {
                  "text": "1 Tes 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama ga e’yo drinzaru zizaru ’diyi si, ama acini lokirisi ku, ama ojani e’yo Munguni inzo be ku; te amani e’yo adaru ecelerisi, ama ama e’da onyiru asisile ’ba driani vu Mungu ma milia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.2",
            "verseOrgIds": [
              "2CO.4.2"
            ]
          }
        },
        {
