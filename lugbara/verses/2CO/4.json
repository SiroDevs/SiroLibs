                  "text": "1 Kor 15:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "o’du vusi dria ama fuza yini Yesuni fuzu kairi oji ama ruaa, idri Yesuni ma e’da i ani ama ruaa indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
