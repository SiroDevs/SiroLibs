          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "dro ama vuti okposi ra, te kuni ama ari’ba dri ku; o’be ama va nyakua,te jania ma driku; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.9",
            "verseOrgIds": [
              "2CO.4.9"
            ]
