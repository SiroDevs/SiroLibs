                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "amani niria eri’i Opi Yesuni engapiri nga ama enga indi Yesu be, azini nga ama e’da emi be eri ma milia. ",
          "type": "text",
          "attrs": {
