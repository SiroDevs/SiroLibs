                  "text": "1 Kor 1:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo amani ama enyazuri ’di, e’yo eti nzeza nita ama asiarini nzeleri kini acita amani nyakua, azini tuni emi vuri, ovu e’yo alatararu ma alia azini asi lokiri kokoru Mungu ma miliarisi, ondua ruani ma alia ku, te ’yeta anzutiri Munguni ma alia, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama sini e’yo andini emi dri ku, te kiri e’yo emini ecole lale azini vale rari’i a’dule; azini ma ’ba ma asi emi dria kini emi nga e’yoni va kpere asizaniria, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
