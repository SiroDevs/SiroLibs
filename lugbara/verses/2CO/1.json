              },
              "items": [
                {
                  "text": "1 Pet 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Awa’difo Mungu Opi amani Yesu Kristo ma Ati vu, eri Ata yiki be azini Mungu asi omiza driani; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri ama asi omipi inzata amani ma alia driari, ’dini amani ecozu ’ba dria ovupi inzata ma alia ’diyi ma asi omizaru, asi omiza nde Munguni ama ngulupi ma asi omizurisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.19"
              },
              "items": [
                {
                  "text": "Zab 34:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.19"
              },
              "items": [
                {
                  "text": "94:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ekile candi Kristoni ’diyini gale ama ruaarile, ’dinile asi omiza amani ga tre Kristosi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.15"
              },
              "items": [
                {
                  "text": "2 Kor 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te yi ka ama inza ra, eri emini asi omiza pi isuzu pata be ani; yi ka ama asi omi ra, eri emini asi omiza isuzu ani, asi omiza nde emi ’bapi okporu candi trotro amani isulerile ’diyi nyazu asi tezasiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini asi teza amani e’yo eminisiri eri pa so kiri kiri; amani niria kini ekile emini ti ecile ama be candi ma aliarile, ’dinile emi nga ti eci asi omiza ma alia indi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
