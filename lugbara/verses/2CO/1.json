                {
                  "text": "’Yeta 19:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ama leni emi ma ovu nita kokoru ku, adripi, inzata amani ecapi ama ruaa Asiari ma e’yosi; te eri ovu nzizaru tu, aga okpo amani ra, ’dini ama ’bani ama asi kini ama nga ama idri pa ra, ’dini ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ama’iruni, ama ovu e’yo liza dratani be ama ngulupi ma dria, ama ma ’ba ani a’ita amani ama ma ngulupi ma dria ku, te Mungu ’ba draza engapiri ma dria; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.18"
              },
              "items": [
                {
                  "text": "2 Tim 4:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "eri ari ndra ama drata amboru ’dapiri ma alia ra, eri nga vini ama ari ra; ama ’ba ama asi eri ma dria e’yo drileri ma e’yosi ’bo, kini eri nga ama ari ’dani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi indi ma ko ama aza Mungu ziza eminisi, ’ba kakau ma fe ani awa’difo Mungu dri ama ma e’yosi beni, afa feza ovupi fezaru ama dri ’ba kakauni Mungu zilerisirisi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
