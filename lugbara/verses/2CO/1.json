                  "text": "Rum 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Yeta anzutiri pi ma ovu emi vu asi anzuru be engazu Mungu Ata amani pi vu Opi Yesu Kristo be.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
