              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo ’disi ma si e’yo ’diyi, mani de ovuria emi eselia yoria, ’dini mani ngaria ovuria emi be indiria, ma ma ’ye okposi okpo Opini fele ma dri emi sizu uru te anzuzu va kurisi lu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.10",
            "verseOrgIds": [
              "2CO.13.10"
            ]
          }
        }
