                "loc": "1CO.13.6"
              },
              "items": [
                {
                  "text": "1 Kor 13:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "A’disiku ama ovuni okpo be e’yo ’aluni ’yezu e’yo adaruri fuzu ku, te ’e’yo adaruri ma aza kozu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.8",
            "verseOrgIds": [
              "2CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini jama ovu ayikosi, ama ka ovu amani lokpo kokoru, te emi emini okpo be. E’yo amani zile Mungu tiari eri ’di’i, emini cazu kililiru kpere tiniri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.9",
            "verseOrgIds": [
              "2CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
