                {
                  "text": "Rum 12:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.17"
              },
              "items": [
                {
                  "text": "1 Sur 29:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Ba ma ’ye ekile erini e’yoni otule i asiarile, candisi ku, kani ’bani omile omirisi ku, a’disiku Mungu le ’ba fepi ayikosiri’i. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.7",
            "verseOrgIds": [
              "2CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azini Mungu eco ’ye­ta anzutiri dria agapi turi fezaru emi dri, ’dini emi’i ovupi afa dria dri fupi emi dri ci o’du dria e’yo driasiri be ’diyi, ma aga ani azi onyiru ma alia dria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.8",
            "verseOrgIds": [
              "2CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
