                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ’yo ’dini: ’ba ori ripi endrasiri nga afa lo were endrasi, te ’ba ori ripi asi avasiri nga afa lo pi asi avasiri be indi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.6",
            "verseOrgIds": [
              "2CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
