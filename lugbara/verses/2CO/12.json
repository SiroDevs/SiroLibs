              "2CO.12.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.5"
              },
              "items": [
                {
                  "text": "2 Kor 11:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eca azazaru ’bo! Te emi omi ma emi’i, de isu onyiruni emi ndra ma inzira. A’disiku ma ovuni ’ba ti opele ambo agapi tu tu ’diyi ma vutialeru aluni ku, ma ka tro ovu ’ba tokoni ti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.11",
            "verseOrgIds": [
              "2CO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.19"
              },
              "items": [
                {
                  "text": "Rum 15:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te eceta ’ba ti opelerini ’ye yi ndra emi eselia asi teza dria be, eceta piyisi, tali pie, tali okporu ’diyi pie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.12",
            "verseOrgIds": [
              "2CO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.19"
              },
              "items": [
                {
                  "text": "2 Kor 11:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E’yo emi ’bapi kanisa azini ma vutialeruri ngori ya? Eri kiri mani ma ’bazu emi dri nzizaru kuri’i ku ya? Emi ku onzi mani ’diri!",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.13",
            "verseOrgIds": [
              "2CO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
