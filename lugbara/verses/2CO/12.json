              "2CO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emi ega ecazu kpere curu’do ama e’yo amaniri ma eti nze emi tia, e’yo ama driari truzu ya? Mungu ma milia ama ’yo Kristo alia, te ’ba mani lele ’diyi la, ama e’yo dria ’yo emi sizu uru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.12.19",
            "verseOrgIds": [
              "2CO.12.19"
            ]
          }
        },
        {
