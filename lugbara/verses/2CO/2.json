              },
              "items": [
                {
                  "text": "1 Kor 1:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’Dini ama ovu Kristo ma aji arikariruri Mungu vu, ’ba yi opapi ra ’diyi pi ma eselia ’ba dri japi ’diyi be; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
