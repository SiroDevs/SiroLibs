              "items": [
                {
                  "text": "Luk 2:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "’ba azini ’diyi dri ama aji drataniriru cazu drata vu, ’ba lazini ’diyi dri ama aji idriniriru cazu idri vu. A’di eco e’yo ’diyisini ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
