              "items": [
                {
                  "text": "1 Kor 16:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ma ka ndra ca Troaa e’yo baru Kristonisi, azini jotile ka ovu zizaru ma dri Opi ma alia ra ti, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma asi ambini ku mani ma adripi Titoni isule kurisi. Te mani yi kuria, ma fu mu Makedoniaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        }
      ]
