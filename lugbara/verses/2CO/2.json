              "type": "text"
            }
          ]
        },
        {
          "text": "Te awa’difo Mungu vu, erini ama dri cele etuzu ari’ba agazu ari Ipezu Kristo ma aliarisi, erini nita iniri ma a ji ecele pari dri dria amasirisi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
