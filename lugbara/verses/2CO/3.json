                }
              ]
            }
          ]
        },
        {
          "text": "ka’dini azi Orindiniri ngani ovu diza be tunini ku ya? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.8",
            "verseOrgIds": [
              "2CO.3.8"
            ]
