          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "’Dini afa ’yepi i depi rari ka emu ndra diza be, afa ovupi ’dani ’daniri ovuni diza be tunini ku ya?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
