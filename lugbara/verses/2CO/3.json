                  "text": "Efu 34:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Te ada, afa nde ndra ovupi dizaruri eca ovu diza kokoru, diza agapi turi ma e’yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.10",
            "verseOrgIds": [
              "2CO.3.10"
            ]
          }
        },
