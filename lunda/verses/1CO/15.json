        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.57",
            "verseOrgIds": [
              "1CO.15.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1CO 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi enu ana kwetu twakeŋa a, ikalenu akola mbe chakadi kuswŋiewa. Swejenu kukalakala mudimu waMwanta mafuku ejima, muloŋa mweluka dehi kukalakala kwenu kumwakabakanaŋa mudi Mwanta hikwamukunkulwayuku.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.58",
            "verseOrgIds": [
              "1CO.15.58"
            ]
          }
        }
      ]
