        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu ana kwetu, hinakeŋenu kuyamba yuma yaSpirituku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.1",
            "verseOrgIds": [
              "1CO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muneluki dehi chimwadiŋi ajentili mwalumbukili nakulondelaakishi abulaŋa kuhosha, mwejima mwayitweluwu mwomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.2",
            "verseOrgIds": [
              "1CO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nakeŋenu mwiluki muntu wukuhosha nindi Yesu washiŋewa, hahoshaŋa mudi Spiritu yaNzambuku. Muntu wukuhosha nindi Yesu diyi Mwanta, kuchihosha chiŋa mudi Spiritu Wajila.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi yamukunkulu yacheŋi nayacheŋi, ilaŋa Spiritu yowumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.4",
            "verseOrgIds": [
              "1CO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi nyidimu yacheŋi nayacheŋi, ilaŋa Mwanta yowumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.5",
            "verseOrgIds": [
              "1CO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi kukalakala kwacheŋi nakwacheŋi, ilaŋa Nzambi yowumu wakalakalaŋa yuma yejima mudi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.6",
            "verseOrgIds": [
              "1CO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa ntu ejima, muntu himuntu, anayinki mwamwekena yamukunkulu yaSpiritu, kulonda kukwashaŋana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.7",
            "verseOrgIds": [
              "1CO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa muntu wumu anamwinki mazu amaana naSpiritu; mukwawu anamwinki mazu akwiluka, mwaya Spiritu yowumu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.8",
            "verseOrgIds": [
              "1CO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukwawu anamwinki kukuhwelela, naSpiritu yowumu; mukwawu anamwinki yamukunkulu yakuuka, naSpiritu yowumu;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.9",
            "verseOrgIds": [
              "1CO.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.11",
            "verseOrgIds": [
              "1CO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujimba chiwuneli wumu, wekala nayidi yayivulu, niyidi yamumujimba yejima, hela yayivulu, yineli mujimba wumu; dichi chekalayi niKristu nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.12",
            "verseOrgIds": [
              "1CO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wejima wetu atupapatisha dehi mudi Spiritu wumu twi kali mujimba wumu, hela tudi aYudeya hela aHeleni, hela tuyanduŋu hela anyana, wejima wetu atunwisha dehi kudi Spiritu wumu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.13",
            "verseOrgIds": [
              "1CO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mujimba hiwekala chidi chimu hohuku, yekala yayivulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.14",
            "verseOrgIds": [
              "1CO.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.26",
            "verseOrgIds": [
              "1CO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mudi mujimba waKristu, muntu himuntu mudi yidi yamujimbowu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
            "verseOrgIds": [
              "1CO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi nashi muchipompelu, akusambila apostolu, amuchiyedi atuprofwetu, amuchisatu ankuluŋaŋa; himukulondela akwakwila nyidimu yaŋovu; nkumininamu akwakuuka, niankwashi, niakwakuyula, niakwakuhosha madimi eŋi na eŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima liiyapostolu, tahindi? Antu ejima hiyatuprofwetu, tahindi? Antu ejima hiyankuluŋaŋa, tahindi? Antu ejima hiyakwakukoŋa nyidimu yaŋovu, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.29",
            "verseOrgIds": [
              "1CO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejima akweti yamukunkulu yakuuka, tahindi? Ejima ahoshaŋa madimi eŋi, tahindi? Ejima alumbululaŋa madimi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.30",
            "verseOrgIds": [
              "1CO.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa fwilenu nankashi yamukunkulu yabadika. Dichi nukuyileja njila yabadikamu nankashi kuwaha.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
            "verseOrgIds": [
              "1CO.12.31"
            ]
          }
        }
      ]
    }
  ],
