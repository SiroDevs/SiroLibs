        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.35",
            "verseOrgIds": [
              "1CO.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi hadi iyala natoŋojoki nindi hadi nakumwila mujiki windi chachiwahuku, niyena hakusweja kukula, hela hanatweshi kudi hembaku, akumini dakwila mwakeŋa ayi, asumbuki tuhu; hanavulumunuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila iyala wadikaŋa mumuchima windi, hikudi nsaŋu jakumukanjikijaku, wukweti nawa Ŋovu yakudihemba, nakoleshi mumuchima windi nindi mujiki windi ashakami tuhu, diyi wukwila chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu dinu, muntu wukusumbwisha wukwila chachiwahi; ilaŋa muntu wukubula kusumbwisha diyi nabadiki kwila chachiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        }
      ]
    },
