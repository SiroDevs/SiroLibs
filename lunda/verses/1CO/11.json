  "reference": "1 Makorinte 11",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CO 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikalenu akwakuŋi mbujola ami, neyi chinelaŋa ami nawa nembujolaŋa Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayihameki chimwaŋanukaŋa muyuma yejima, nichimwakakelaŋaa yaaku, mwomunayilejeli ninami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.2",
            "verseOrgIds": [
              "1CO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakeŋi mwiluki, mutu weyala diyi Kristu; na mutu wamumbanda diyi iyala; mutu waKristu diyi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.3",
            "verseOrgIds": [
              "1CO.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyala wukulomba hela kuprofweta, kunamutu kwakubuta, nasawuli namutu windi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.4",
            "verseOrgIds": [
              "1CO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mumbanda wukulomba hela kuprofweta, kunamutu kwakadi kubuta, nasawuli namutu windi, Muloŋa hichuma chochimu neyi natewuli nkumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.5",
            "verseOrgIds": [
              "1CO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi mumbanda wukubula kubuta kunamutu, aleli nsuki; ilaŋa neyi mumbanda namoni kumulela nsuki, hela kumutewula kawewa, chi kweti nsonyi, chiŋa adibuti.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.6",
            "verseOrgIds": [
              "1CO.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.16",
            "verseOrgIds": [
              "1CO.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinukuyileja mwenimu, hichakuvihameka nachuku; muloŋa mwapompaŋa chakutamisha, hichakuwahishaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.17",
            "verseOrgIds": [
              "1CO.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma chakusambila chinatiyi, nawu chimwapompaŋa mwambokaŋa mukachi kenu, ninami mwekwawu neteji nami mwalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.18",
            "verseOrgIds": [
              "1CO.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chiŋa hamwekana kudambula mukachi kenu, kulonda alumbuluka amwekani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.19",
            "verseOrgIds": [
              "1CO.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chimwapompaŋa mwakaŋanyaloŋa kudya yakudya yaMwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.20",
            "verseOrgIds": [
              "1CO.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chimwadyaloŋa wejima wenu, mwasambilaŋa kudidiila yakudya yenu; wumu hakutiya nzala, mukwawu hakusheta walwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.21",
            "verseOrgIds": [
              "1CO.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.22",
            "verseOrgIds": [
              "1CO.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma chinayilejeli enu, nachitambuli kudi Mwanta; cheliliyi Mwanta Yesu wufuku wamufukejeluwu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.23",
            "verseOrgIds": [
              "1CO.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wanoneni dinkendi, chanasakililiyi hakudihumuna, hakwila nindi, Denidi himujimba wami wanenkuwu hanyijimba yenwenu; ilenu mwenimu muŋanukaŋa nachu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.24",
            "verseOrgIds": [
              "1CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi cheliliyi nawa nilupasa, chaneluwu anadyi dehi, hakwila nindi, Lupasilu dichi chitiyaŋenu chachiha chamumashi ami; ilenuŋa mwenimu, chejima chimukunwaŋa, muŋanukaŋa nachu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chejima chimukudyaloŋa dinkendi idi, nichimukunwaŋa lupasilu, himukutiyakesha kufwa kwaMwanta nichakenzayi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
              "1CO.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
            "verseOrgIds": [
              "1CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi muntu wukudya dinkendi idi, hela wukunwa lupasa lwaMwanta chakadi kutela, wukumona muloŋa wamujimba namashi aMwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.27",
            "verseOrgIds": [
              "1CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu adeseki yomweni, kulonda atweshi kudya kudinkendi idi, nikunwa mulupasilu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.28",
            "verseOrgIds": [
              "1CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa muntu wukudya nakunwa chakubula kumwenamu mujimba, wukudya nakunwa chakudiletela muloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
            "verseOrgIds": [
              "1CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dihu hanafumi antu amavulu kuzeya mukachi kenu, nikukatakata, niamakwawu kuya namutulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.30",
            "verseOrgIds": [
              "1CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi twadishinshikaŋa etu aweni hiyadi kutusompeshaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.31",
            "verseOrgIds": [
              "1CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chatusompeshaŋawu, atufumbaŋa kudi Mwanta, kulonda tubuli kumwena muloŋa hamu nawantu ampata yamunu mwishina.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu ana kwami, chimukupompaŋa nakudya, dichiŋililenuŋa muntu namukwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.33",
            "verseOrgIds": [
              "1CO.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu natiyi nzala akumini dakudya kwitala dindi; kulonda chimukupompa nakudya chibuli kuyiletela Muloŋa nsaŋu jinashaluku nakaloŋesha hinamba kenza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
            "verseOrgIds": [
              "1CO.11.34"
            ]
          }
        }
      ]
    }
  ],
