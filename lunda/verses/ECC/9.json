  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ECC 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yuma yejimiyi nayishili kumuchima wami kulonda niihujolimwejimimu mwakwila niakwakuloŋa niakwamaana adi mumakasa aNzambi, ninyidimu yawu hamu; hela kudi kukeŋa, hela kudi kuhela, muntu kuchiluka nehi; yejima yidi kumesu awu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.1",
            "verseOrgIds": [
              "ECC.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yejima yashikenaŋa tuhu antu ejima mwomumu hohu, chuma chikushikena mukwakuloŋa chochikushikena nimukwakwila yatama; nimuwahi, niwakadi majilu, niwamajilu; niwaketulaŋa yimuna, niwabulaŋa kuketula yimuna; chadiyi muwahi, dichadiyi nimukwanshidi nawa; chadiyi wasanyikaŋa, dichadiyi niwatiyaloŋa woma wakusanyika nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.2",
            "verseOrgIds": [
              "ECC.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu chuma chinatami hayuma yejima yamonaŋawu antu munu mwishina detaŋwa, chakwila antu ejima amonaŋa chuma chochimu hohu; mwalala nawa, nyichima yawanyana kawantu yenzala kutama, hachiduwu amomi munyichima yawu mudi kwimika disu, nkumininaku hiyakuya kudi afu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.3",
            "verseOrgIds": [
              "ECC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kudi muntu wadibomba nawamomi ejima kudi kukuhwelela, muloŋa kawa kakomi kanabadiki mutupa wafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.4",
            "verseOrgIds": [
              "ECC.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋamomi eluka dehi nawu, Twakafwa; hakwila afu hiyeluka chumaku, hiyakamona nawa cheŋi wulokuku; muloŋa hiyayanukaŋa nawa cheŋuku, ayivulamena dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.5",
            "verseOrgIds": [
              "ECC.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwakeŋa elaŋawu, nimwahelelaŋawu, nimwatiyilaŋawu ichima mwajiya dehi; hiyamba kamona nawa cheŋi iseka dawu dakudya kuyuma yelaŋawu mwishina detaŋwaku chahaya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.6",
            "verseOrgIds": [
              "ECC.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaŋa kweyi, dyaloŋa yakudya yeyi nakuluŋa, nwaŋa vinyu yeyi nakutiya kuwaha mumuchima weyi; muŋa Nzambi netŋi dehi nyidimu yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.7",
            "verseOrgIds": [
              "ECC.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yeyi yakuvwala yiikali yitooka mafuku ejima; kunamutu weyi bayi kubula manjuku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.8",
            "verseOrgIds": [
              "ECC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.8",
            "verseOrgIds": [
              "ECC.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shakamaku nakuzaŋajala naŋodeyi wakeŋa a mafuku ejima akuhanda kweyi kwakuhemesha kwanakwinkiyi mwishina detaŋwa, mafuku eyi ejima akuhemesha; muŋa didu iseka deyi diwukudya kuwumi wunu, nikukukabakana kuwunakabakani mwishina detaŋwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.9",
            "verseOrgIds": [
              "ECC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.9",
            "verseOrgIds": [
              "ECC.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yejima yinawani chikasa cheyi kwila, ilaku naŋovu jeyi, muŋa mwijamu muwukuya mwosi mudimu, mwosi kufuukula, mwosi kwiluka, mwosi maana.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.10",
            "verseOrgIds": [
              "ECC.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukuhitamu cheŋi, hinukumona mwishina detaŋwa nami, Kukutemuka, akwalufuchi hidiwu ashiyaloŋamu akwawuku; hela kunjita, akwaŋovu hidiwu atapaŋa akwawuku; hela kudya, akwamaana hidiwu akumonaŋaku; hela maheta, akwakashinshi hidiwu ayihetaŋaku; hela wuselewa, akweti wukalawenu hidiwu awumonaŋaku; mpinji nakululakana chayilulakenaŋa tuhu wejima wawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.11",
            "verseOrgIds": [
              "ECC.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa muntu helukaŋa mpinji yinduku; chafwaŋa anshi muwanda watama, nichafwaŋa tujila muchidiya, dichi chafwaŋa anyana kawantu mumpinji yatama chiyayikulukilaŋa chakuyikasumwisha.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.12",
            "verseOrgIds": [
              "ECC.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu munamweneni maana mwishina detaŋwa, nayimweni nami alema. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.13",
            "verseOrgIds": [
              "ECC.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwadiŋi kamukala kanyanya niantu adiŋumu antesha; hikukwinza mwanta muneni, hakuwukuchika, hakutuŋilaku mpwembu jamaneni. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.14",
            "verseOrgIds": [
              "ECC.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenomu mwadiŋi kazweŋi mukwamaana, yena kazweŋi hakuhandisha mukala nama ana indi; hela chochu, owu kazweŋi hiyamwanukili kudi muntu niwumuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.15",
            "verseOrgIds": [
              "ECC.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukwila nami, Komana maana abadika Ŋovu; hela chochu, maana akazweŋi anayidiwuli, nimazu indi hiyanayitiyuku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.16",
            "verseOrgIds": [
              "ECC.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.16",
            "verseOrgIds": [
              "ECC.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu awakwamaana akuhoshela kwamwena, ayitiyaloŋa chakubadika chatiyaloŋawu mbila yanyuli wayulaŋa mukachi kawayisupi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.17",
            "verseOrgIds": [
              "ECC.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana abadika yitwa yanjita; ilaŋa mukwanshidi wumu wakisaŋanaŋa kuwaha kwakuvulu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.9.18",
            "verseOrgIds": [
              "ECC.9.18"
            ]
          }
        }
      ]
    }
