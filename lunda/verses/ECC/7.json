  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ECC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijina dadiwahi dabadika malasha evumba dadiwahi, niifuku dakufwa dabadika dakuvwalika.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuya kwitala kudi kudila madilu, nakuya kwitala kudi chawija, chinabadiki chidihi? Chinabadiki kuya kwitala kudi kudila madilu, muloŋa dimu mwakumishilaŋawu antu ejima, nimuntu wamumi wukuchisha kumuchima windi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuneŋa kunabadiki kuseha; muloŋa kudihomba kumesu kwawahishaŋa muchima. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyichjma yawakwamaana yekala kwitala kudi kudila madilu; ilaŋa nyichima yawayisupi yekala kwitala kudi kuzaŋajala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutiya mwakukuhosholawu kudi mukwamaana nakutiya tumina twawayisupi, chinabadiki chidihi? Chinabadiki kutiya mwakukuhosholawu kudi mukwamaana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kusehaŋa chisupi chidi neyi chabidimaŋa nyiŋa mwishina denuŋu. Chumichi nawa chakuhemesna.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wila neyi, Mafuku akusambila chanabadikuwu mafuku anu chinafumi hankaku? Muloŋa hansaŋu iyi hiwudi nakwihula chamaanaku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana anawahi hamu nawuswana; mwalala, maana diwu abadika kuyiwahila ekala kunu kumwaana.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa maana hichuma chakudihemba nachu, neyi chaneluwu mali hichuma chakudihemba nachu; ilaŋa kwiluka yuma chasweja kuwaha muloŋa maana ahembaŋa wumi wamuntu wayiheta. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinshikaku mudimu waNzambi chachiwahi, muloŋa chuma chaheŋeshayi dehi yena, akutwesha kucholola kudinyi?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wunamoni kuwaha zaŋalalaku, neyi wunamoni kutama shinshikaku nawa chachiwahi; Nzambi diyi neseki yejima yiyedi yiikali ichi iku, ichi iku, kulonda muntu akabuli kwiluka chuma chakamuhiŋa munyima.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yejimiyi nayimoni hamafuku akuhemesha kwami. Iwu muntu waloŋa hakunoŋa nakuloŋa kwindi, iwu muntu welaŋa yatama saŋa elilayi yatama hohu, kufwa swayi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.15",
            "verseOrgIds": [
              "ECC.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wuswejesha nankashi kuloŋaku, bayi nawa wuswejesha nankashi kwikala namaanaku; wudikisaŋani tuhu kweyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.16",
            "verseOrgIds": [
              "ECC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wuswejesha kwila yatamaku, bayi nawa wusupaku; wufwi tuhu kweyi chakadi kushika mumwaka weyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.17",
            "verseOrgIds": [
              "ECC.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chachiwahi kukwata hachumichi mbe; mwalala kwaamu, bayi wufumisha kwoku chikasa cheyuku; muloŋa muntu wamwakamaŋa Nzambi wamba kafuma muyuma yejimiyi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana aleteshaŋa Ŋovu kudi mukwamaana chakubadika ikumi dawanyuli adi mumukala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.19",
            "verseOrgIds": [
              "ECC.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.19",
            "verseOrgIds": [
              "ECC.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hamaseki hihekala muntu waloua welaŋa chachiwahi, wabulaŋa kuvulumunaku.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.20",
            "verseOrgIds": [
              "ECC.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.20",
            "verseOrgIds": [
              "ECC.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wushaŋa kumuchima mazu ejima ahoshaŋawu antuku, wakenza katiya chakukutuŋulayi nduŋu yeyi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.21",
            "verseOrgIds": [
              "ECC.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa weluka dehi mumuchima weyeyi aweni chiwatuŋulaŋahu dehi akwenu kakavulu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.22",
            "verseOrgIds": [
              "ECC.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.22",
            "verseOrgIds": [
              "ECC.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yejimiyi nayeseki dehi nama ana. Nelili nami, Niikali mukwamaana; chiikala nikwakulehi nanami. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
              "ECC.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chekala kwakulehi, chasweja kukunama, wukutwesha kuchiwana hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
              "ECC.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukusha muchima wami nankashi hakwiluka, nakutalatala nakukeŋakeŋa maana, nami niiluki mwaya yuma, niiluki nami komana kwila chatama hiwusupi, nikukenkama hikwimika disu; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
