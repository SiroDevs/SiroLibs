      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anukaŋa nawa Nleŋi yeyi mumafuku awukwenzi weyi, hachidi mafuku atama kanda enzi, ninyaka yiwakela neyi, Ami hinatiyilumu kuwahaku, yichidi kanda yinzi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "niitaŋwa, nimwaana, nikakweji, nitutumbwa, tuchidi kanda twiyili, nimavu kanda afunti cheŋi hakwila nvula yinachi dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ifuku dakelawu akwakuhemba itala hiyakuza ala, ni amayala adiŋi naŋovu hiyakubandama, niakwakutwa hiyakukeha, niakwakutalila munjanina hiyakwiyila, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakwenzela niyenzelu yatala hanzi; chakutwawu wuŋa kutiyakana chalala nehi, nimuntu hakuhinduka hakutiyayi izu dakajila, nikutiya chachiwahi chakwimbawu anyana awambanda tumina nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwalala, akatiya woma wachuma chidi hewulu, akafwa mutentu nayuma yidi munjila; mumondi hakakenuka, nimpasu hakadikoka chakudikoka, nikufwila kwamumuchima hikwakakuma; muloŋa muntu hakuya kumukala wawu wahaya nyaka, niakwamudimu wakudila hiyakukimboka hanzi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hachidi mwonji wasiliva wuchidi kanda wuketuki, nichitasu chawuru chichidi kanda chibaluki, ninsaba yichidi kanda yibaluki kukaseloki, nichuma chakunyoŋa nachu meji kanda chifwi kwishima; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nilunkuŋu luchidi kanda lufunti cheŋi mwiseki mulwadiŋi, nimuuya yichidi kanda yifunti cheŋi kudi Nzambi wayiheni. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakutaŋisha nindi, Kuhemesha kwayuma yakuhemesha; yuma yejima yakuhemesha hohu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheŋi nawa, mukwakutaŋisha nanochu chadiŋiyi mukwamaana, chalejayi antu kwiluka ho-o; mwalala, hakutoŋojokaŋa, hakukeŋakeŋaŋa, hakuloŋeshaŋa yishimu yayivulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakutaŋisha hakukeŋakeŋa mazu akutiyisha kuwaha, niakusoneka choloka, mazu alala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
