  "verseCount": 50,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1SA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AFwilistinu apompesheli njita jawu nawu asi, hiyakupompela kuSoko wakuYuda, hiyakutuŋa chilombu chawu muEfwesi Damimi, Soko iku, Azeka iku, wena hakachi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.1",
            "verseOrgIds": [
              "1SA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu nawaIsarela hiyakupompa niwena nawa, hiyakutuŋa chilombu chawu muchinekineki chaEla, hiyakutanjikila aFwilistinu njita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.2",
            "verseOrgIds": [
              "1SA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "AFwilistinu emeni hampidi ishinadi dimu, aIsarela niwena emeni hampidi ishinadi di kwawu, chinekineki mukachi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.3",
            "verseOrgIds": [
              "1SA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.3",
            "verseOrgIds": [
              "1SA.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchilombu chawaFwilistinu himukwidika mukwakulwa, ijina dindidiyi Goliyati wakuGati, chiminu chindi chashikili munkotweli jachikasa jitanu nayimu, kulunjikaku nimuchikasa chamuntu chakusamanesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.4",
            "verseOrgIds": [
              "1SA.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunamutu windi kudi itepa dawuneŋu, navwali nawa nichikovwelu chamaleŋi, pezu yachikovwelu yashika mumakombakaji atanu ajishekeli jawuneŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.5",
            "verseOrgIds": [
              "1SA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyendu yindi kudi yuma yawunepu, hahumaŋena mafwŋi indi hadichibasa chawuneŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.6",
            "verseOrgIds": [
              "1SA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulunda wevopa dindi wudi neyi mukambu wamukwakutuŋa mahina, ivopa dadeni dashika mupezu yajishekeli jachikuŋu makulakaji atanu nadimu; mukwakusenda nkebu yindi natwaminuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.7",
            "verseOrgIds": [
              "1SA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwimana nakubidika njita jawaIsarela nindi, Munatanjikilidi njitajenu? Ami hinikaFwilistinuku? Enu himuyambuŋa Sawulu ku? Tondenuiyala akunkumuki kunu kunidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.8",
            "verseOrgIds": [
              "1SA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wukutwesha kulwisha nanami anjaha, tukwikala anduŋu jenu; neyi yami nukwimika mushindu nimujahayena, enu mukwi kala anduŋu jetu, mwakatukalakelaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.9",
            "verseOrgIds": [
              "1SA.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaFwilistinu nindi, Njita jawaIsarela najiswidikŋi kwami lelu, nyinkenu iyala tulwishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.10",
            "verseOrgIds": [
              "1SA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu nawaIsarela ejima, chatiyiluwu mazu akaFwilistinu awa, akamani kwakama, atiya niwoma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.11",
            "verseOrgIds": [
              "1SA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.11",
            "verseOrgIds": [
              "1SA.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wadiŋi mwana kaka Efwarata wakuBetelemi Yuda, ijina dindi Jesi, wadiŋi nawanyanindi amayala atanu nasatu; hamafuku adiŋiyi Sawulu henohu yena iyalowu wela dehi kashinakaji, nyaka yamuvulila dehi mukachika wantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.12",
            "verseOrgIds": [
              "1SA.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kajesi awawakulumpi asatu ayili naSawulu kunjita. Majina awanyanindi asatu ayili kunjita adiŋi iwu Eliyabi yowu wedi, iwu Abinadabi chilondawedi, iwu Shama wamuchisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.13",
            "verseOrgIds": [
              "1SA.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wadiŋi diyi kabinda kawu; awakulumpi asatu ayili naSawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.14",
            "verseOrgIds": [
              "1SA.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi welilaŋa aya kudi Sawulu, afunta cheŋi nakudiisha nyikoku yatata yindi kuBetelemi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.15",
            "verseOrgIds": [
              "1SA.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.16",
            "verseOrgIds": [
              "1SA.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesi hakumwila mwanindi Davidi, nindi, Nonenaku ana kweyi chimpaya chatidiku iyi yakwocha, ninidi ikumi damankendi, wuyitweli ana kweyiadi kuchilombu lufuchi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.17",
            "verseOrgIds": [
              "1SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "awa mabuji achizi ikumi musendeli mukulumpi wekombakaji dawu, wakatali mwanashaka minuwu ana kweyi, wakadimwishinawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.18",
            "verseOrgIds": [
              "1SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu niSawulu, niwena, niaIsarela ejima, adi muchine kinekicha Ela, adi nakulwa nawaFwilistinu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.19",
            "verseOrgIds": [
              "1SA.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.19",
            "verseOrgIds": [
              "1SA.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumenekesha budidi yayeni, nyikoku hakuyishiya kudikabiŋa, hakunyamuna yuma, hakuya, mwomwa mulejeliyi Jesi; hakushika kwatentekelaŋawu matemba, kuwana antu hiyakuya nakwasa njita adina kudi kuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.20",
            "verseOrgIds": [
              "1SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela nawaFwilistinu atanjikili njita jawu jiditala njita nanjita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.21",
            "verseOrgIds": [
              "1SA.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakutulila yuma yindi kudi mukwakuhemba yuma, hakuya kunjita lufuchi, ashika nikudi ana kwindi, hakuyimwisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.22",
            "verseOrgIds": [
              "1SA.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahanjikilaŋayinawu, kutala mukwakulwa hakwinza, yowu kaFwilistinu waku-Gati, ijina dindi Goliyati, hakufuma munyisululu yawaFwilistinu, hakuhosha mwomwindi mwahoshelaŋayi, Davidi hakuchitiya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.23",
            "verseOrgIds": [
              "1SA.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.23",
            "verseOrgIds": [
              "1SA.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela ejima chamumwenuwu owu iyala, amutemoka nikumutemoka, atiya niwoma nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.24",
            "verseOrgIds": [
              "1SA.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela hiyakwila nawu, Iwu iyala munamumoni? Chalala chanenziyi ichi nenzi nakuswidikŋa aIsarela; iyala wakamujaha akamuhetesha maheta amavulu kudi mwanta, wakamwinkani mwanindi wamumbanda, nimutaŋa watata yindi wakabula kumona wuduŋu muIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.25",
            "verseOrgIds": [
              "1SA.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakuyila amayala emenuku, nindi, iyala wakajaha iwu kaFwilistinu, wakakololola aIsarela nsonyi akamwila ŋahi? Ochu yeniwu chidima chaka Fwilistinu hiiyalanyi ntahi mwaka aswidikŋaŋanjita jaNzambi wamumi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.26",
            "verseOrgIds": [
              "1SA.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu hiyakumwakula nawu, Eŋa, dichichaka mwilawu iyala wakamujaha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.27",
            "verseOrgIds": [
              "1SA.17.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.27",
            "verseOrgIds": [
              "1SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kwindi wawedi Eliyabi hakutiya chahosheliyi nawamayala; Eliyabi hakumuzuwila Davidi, hakumwila nindi, Wunenjilidi ntahi kunu? Tuna tunyikoku wunatushiyi nanyi mwisaŋa? Neluka dehi chiwadinka wanta, nichiwaluwa mumuchima weyi, wunenjili yowu kwila neyi nakamoninjita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.28",
            "verseOrgIds": [
              "1SA.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi nindi, Neli ŋahi? Hiizu hohu kwaduku? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.29",
            "verseOrgIds": [
              "1SA.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumufutalela, hakuhosha nawa cheŋi mwomumu, antu hiyakumwakula chenineyi mwomwakusambila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.30",
            "verseOrgIds": [
              "1SA.17.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.30",
            "verseOrgIds": [
              "1SA.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu aDavidi chiyanatiyakanuwu, hiyakumuhitulwila muSawulu, hakumutambika. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.31",
            "verseOrgIds": [
              "1SA.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila Sawulu, nindi, Antu bayi amufwamutentu munyichima yawuku; ami kambuŋeyi nukuya nakalwishi nayeniwu kaFwilistinu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.32",
            "verseOrgIds": [
              "1SA.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakumwila Davidi, nindi, Eyi hiwukutweshakuya nakulwisha nayeniwu kaFwilistinuku, muloŋa eyi wumukwenzihohu kweyi, yena himukwanjita hohu kufumisha kuwukwenzi windi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.33",
            "verseOrgIds": [
              "1SA.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.40",
            "verseOrgIds": [
              "1SA.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaFwilistinu niyena hakwinza, hakukundama kwakwihi naDavidi; kunatwamini iyala wasendelapa nkebu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.41",
            "verseOrgIds": [
              "1SA.17.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 17:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaFwilistinu nindi atalatali, hakumumona Davidi, hakumusekesha, muloŋa Davidi wadiŋi wuchidi mukwenzi hohu, wuchinana, walubanji. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.42",
            "verseOrgIds": [
              "1SA.17.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 17:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaFwilistinu hakumwila Davidi nindi, Ami nikawa mwaka winzi kudami nanyitondu? KaFwilistinu hakumushipa Davidi nakutena akishi indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.43",
            "verseOrgIds": [
              "1SA.17.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 17:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaFwilistinu hakumwila Davidi nindi, Inzaŋa kunu, ninki mujimba weyi kudi atujila ahaluzwizu nikudi anyama amumpata. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.44",
            "verseOrgIds": [
              "1SA.17.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 17:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila kaFwilistinu nindi, Eyi wunenzi kudami nampoku yakabali, neyoŋa, nankebu; ilaŋa ami nenzi kudeyi mwijina daYehova wamazaza, Nzambi yanjita jawaIsarela ŋawunaswidikŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.45",
            "verseOrgIds": [
              "1SA.17.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 17:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wukukwinka muchikasa chami lelu. Nukukutapa, nukukufumisha namutu weyi, yibimbi yanjita yawaFwilistinu nukuyinkayu atujila ahaluzwizu, niatunyama ahamaseki; kulonda mpata yejima yiilukinawu muIsarela mudi Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.46",
            "verseOrgIds": [
              "1SA.17.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 17:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda antu ejima anapompi kunu, eluki nawu, Chahandishaŋayi Yehova hahandishaŋa nampoku yakabali hela neyopaku; muloŋa hinjita yambala yaYehova, yena wakayihanakudetu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 17:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 17:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaFwilistinu cheliliyi nanyamuki dehi, hakwinza nakukunda makwakwihi, nindi abulakani naDavidi, Davidi hakunyakala kuya lufuchiná kubulakana nakaFwilistinu kunjita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.48",
            "verseOrgIds": [
              "1SA.17.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 17:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakwipiŋa chikasa chindimunfuba, hakufumishamu kadilola, hakukaasa namwonji, kamukwata nika-Fwilistinu mwihama, keŋila nilwe-e mwihama dindi, yodimbuka nichamesuheseki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.49",
            "verseOrgIds": [
              "1SA.17.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 17:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.49",
            "verseOrgIds": [
              "1SA.17.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 17:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Davidi wamwimikili kaFwilistinu mushindu namwonji wakwasanachu, nakadilola, wamutapili kaFwilistinu, wamujahili, kutoŋa Davidi hadiŋi nampoku yakabali muchikasa chinduku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.50",
            "verseOrgIds": [
              "1SA.17.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 17:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakuya lufuchi, hakumudata kaFwilistinu, hakumutambula mpoku yindi yakabali, hakuyihola muchindalu chayu, hakumunuŋulula, yomuketula ninachu namutu windi. AFwilistinu, chanamonuwu chilobu chawu nafwi dehi, atemoka nikutemoka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.51",
            "verseOrgIds": [
              "1SA.17.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1SA 17:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1SA 17:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu chamweniyi Davidi hakuya nakulwisha nakaFwilistinu, hakumwila mukulumpi wanjita Abineri, nindi, Eyi Abineri, yeniwu mukwenzi himwana kanyi? Abineri nindi, Mwanta chahanda wumi weyi kwaamu, ami kutwesha kukuleja nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1SA 17:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nindi, Ihulaku neyi, Iwu mwanahimwana kanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneliyi Davidi nafumi dehi kwayiliyi nakujaha kaFwilistinu, Abineri hakumutambula, hakumuleta kudi Sawulu ninamutuwa kaFwilistinu kuchikasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1SA 17:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakumwihula nindi, Eyi mukwenzi wumwana kanyi? Davidi hakwakula nindi, Ni mwana kakambuŋeyi Jesiwa kuBetelemi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
      ]
    }
