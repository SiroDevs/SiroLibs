{
  "id": "1SA.26",
  "number": "26",
  "bookId": "1SA",
  "reference": "1 Samuele 26",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "1SA 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AkwaZifwi enjili kuGibeya kudi Sawulu, elili nawu, Davidi hanabatami kumpidi yaHakila yekala kwakwihi nachibabaku?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.1",
            "verseOrgIds": [
              "1SA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.7",
            "verseOrgIds": [
              "1SA.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishayi hakumwila Davidi, nindi, Nzambi namuhani dehi chilumbu cheyikudeyi lelu, ŋitŋi nimutapi mwani iyoŋa dimu hohu zwa-a niheseki, hinukumutaŋa kaye duku. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila Abishayi, nindi, Bayi wumukisaŋa naku, wambala waYehova awayishawu dehi manji wukutwesha kumwolwela chikasa yobula muloŋa hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakwila nindi, Chahandayi Yehova kwaamu, Yehova diyi wakamutaŋa, hela ifuku dindi dakufwada kamuwana, indi kwiji wakaya kunjita hakafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.10",
            "verseOrgIds": [
              "1SA.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami kwolwela chikasa, wambala waYehova, awayishawu dehi manji, chinjila, nonaku kweyoŋa dindi didi kwakwihi nanamutu windi, ninsaba yameji, tuyi kwetu mwani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi anona niiyoŋa ninsaba yameji yadiŋi kwakwihi nanamutu waSawulu, hiyakudiyila kwawu, nimuntu wakuchimonahu hela kuchiluka nehi, kwosimuntu niwumu watonenuku, wonsu wawu adiŋi kwanamutulu ho-o, tulutwakudi Yehova twamuladika twayikwatili. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.12",
            "verseOrgIds": [
              "1SA.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakuya kwishinadi, hakwimana hewulu dampidi kwakulehi, hakachi kawu hadi iluŋa dadeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.13",
            "verseOrgIds": [
              "1SA.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakuyibidika antu, niAbineri mwana kaNeri, nindi, Eyi Abineri! Kwitiya nehi? Abineri hakwitiya nindi, Eyi wukumubidika mwanta yeyinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.14",
            "verseOrgIds": [
              "1SA.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila Abineri nindi, Hiyeyi iyala dalalaku tahindi? MuIsarela mudi iyalanyi wakwesekana neyi? Indi wunalekelidi kuhemba nkaka yeyi mwanta? Muchilombu mweŋila muntu nindi akisaŋani nkaka yeyi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.15",
            "verseOrgIds": [
              "1SA.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichichuma chiwunelihi chachiwahuku. Chahandayi Yehova kwaamu, enu munateleli kufwahohu, ochu chimunabuli kuhemba nkaka yenu wambala waYehova awayishawu dehi manji. Ichi dinu talenu ntahi niiyopa damwanta ninsabayameji yadiŋi kwakwihi nanamutu windi kuyenza dehi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.16",
            "verseOrgIds": [
              "1SA.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakwiluka izu daDavidi, hakwila nindi, Odizu hiizu deyeyi mwanami Davidi, tahindi? Davidi nindi, Eŋa hiizu damami, eyi nkakayami mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.17",
            "verseOrgIds": [
              "1SA.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila nindi, Indi nkaka wanhaŋilaŋadi ami kambuŋindi? Neli ŋahi? Chumanyi chatama chinidi nachu? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.18",
            "verseOrgIds": [
              "1SA.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinumwani, eyi nkaka yami mwanta, atiyi izu damami kambuŋeyi. Neyi Yehova diyi nakusaŋumuni wuzuwi nanami, eteji kutambula chamukunkulu, ilaŋa neyi chinafumi kudi antu, ekali ashiŋewa kumesu aYehova, muloŋadiwu anantemuni lelu mwaka nibulaŋa nikushakama muwuswana waYehova, nawu, Yaku wakapeshi akishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.19",
            "verseOrgIds": [
              "1SA.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu mashi ami bayi adivwilatuhu hamaseki chakadi Yehova kuyimonaku; mwanta wawaIsarela nenzinakukeŋakeŋa mbaleli, neyi muntu wudi nakuzomba ŋwadi mumapidi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.20",
            "verseOrgIds": [
              "1SA.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakwila nindi, Ami navulumuni, eyi mwanami Davidi difuntilaŋa kweyi, ami hinakakwila cheŋi mwatamaku, muloŋa wunawumoni wumiwami kulema lelu, tiya, ami neli mwawusupi kwami, nasweji nankashikuluwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.21",
            "verseOrgIds": [
              "1SA.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwakula nindi, Eyi mwanta, iyoŋa idi! Kwinzi mukwenzi wumu kunu atambuli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
              "1SA.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova alubwili antu ejima mwomwekalila kuloŋa kwawu nikashinshi kawu, muŋa Yehova nakuhani kudamilelu, ami naleki kwami nami kumwolwela wambala waYehova, awayishawu dehi manji, chikasa chami, chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya, munamwenami wumi weyikulema lelu, Yehova niyena amoni wumi wami kulema mwomumu nawa, aŋamwini mumakabi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulu hakumwila Davidi nindi, Kisukisu, mwanami Davidi, eyi wakakoŋa naŋovu hohu, wakemika mushindu chalala. Davidi hakudiyila, Sawulu niyena nawa hakufunta kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    }
  ],
