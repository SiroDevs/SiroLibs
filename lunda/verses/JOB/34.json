          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela nindi, Nleji chuma chinabuli kumona, neyi neli mwakuheŋa hinakafuntilamu nawa cheŋuku? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.32",
            "verseOrgIds": [
              "JOB.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komana yena afwetesha muntu muwukukeŋeyi, walekaŋamu? Yeyi wukutondamu, bayi amuku; dichi hoshaku yiweluka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.33",
            "verseOrgIds": [
              "JOB.34.33"
            ]
          }
        }
