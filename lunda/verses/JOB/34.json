          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu akweti muchima, mwalala, hela akwamaana ejima adi nakuntiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.34",
            "verseOrgIds": [
              "JOB.34.34"
            ]
          }
        },
        {
