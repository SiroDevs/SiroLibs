          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "akuŋila nawu, Yoba wudi nakuhosha mwakadi kwiluka, mazu indi hiyakweti maanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.35",
            "verseOrgIds": [
              "JOB.34.35"
            ]
          }
