          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutenowu Yoba adi kumweseka eseke-e ndo nikunsa, Muloŋa mwaakulaŋayi waakulaŋa neyi antu aluwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.34.36",
            "verseOrgIds": [
