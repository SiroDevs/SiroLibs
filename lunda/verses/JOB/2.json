      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadiŋi cheŋi nawa ifuku denjiluwu anyana kaNzambi nakwimanakumesu aYehova, Satana niyena nawa wenjili hamu nawu, emani kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumwila Satana nindi, Wudi nakufuma kudihi? Satana hakumwakula Yehova nindi, Nidi nakufuma kukutambatamba hamaseki, nikukwendujola mudahita. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumwila Satana nindi, Kambuŋami Yoba wunamushinshiki tahindi? Hikudi wakweseka nindi hamasekuku, iyala walala woloka, muntu waakama Nzambi, waambuka kuyuma yatama. Nihanu saŋa akakelelayi kashinshi kindi, kutoŋa eyi wunanshinjili nimwili chatama, nimukisaŋani tuhu chakadi ninsaŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.3",
            "verseOrgIds": [
              "JOB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satana hakumwakula Yehova nindi, Ikowa nekowa, muntu wukuhana yuma yakwetiyi yejima nawumi windi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.4",
            "verseOrgIds": [
              "JOB.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ololaku ntahi chikasa cheyi katataka wukwati hamujimba windi, wutali neyi wukubula kukuhosha chatama kumesu eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.5",
            "verseOrgIds": [
              "JOB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumwila Satana nindi, Tala, wudi muchikasa cheyi, Wumi windi diwu wukuleka hohu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.6",
            "verseOrgIds": [
              "JOB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.6",
            "verseOrgIds": [
              "JOB.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satana hakufuma kumesu aYehova, hakuya, hakukatisha Yoba namahuti akata nankashi akufumisha kumadachilu ndo nimwishina danamutu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabwambu jaYoba asatu chanatiyuwu kutama kwejimiku kunamuwani, hiyakufuma, iwu kwindi, iwu kwindi, iwu kwindi, hiyakwinza; iwu Elifwazi wakuTemani, iwu Bilidadi wakuShuhi, iwu Zofwari wakuNayamati; atiyaŋana dehi kuya nakumukwashaku kulonda kumukundeja. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.11",
            "verseOrgIds": [
              "JOB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu achidi tuhu kwakulehi, nawu amutali nikumwiluka nawa nehi, hiyakudila makumbu aweni, hiyakutabola niyikovwelu yawu wejima wawu, hiyakudisukwila maseki kunyitu yawu, hiyakuyinata nikwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.12",
            "verseOrgIds": [
              "JOB.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashakama ninindi hamaseki mafuku atanu nayedi, nimwaana niwufuku, hosi muntu niwumu wahosheluhu nindi izuku, muloŋa amweni chikela chindi chinamuswejeli nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.13",
            "verseOrgIds": [
              "JOB.2.13"
            ]
          }
        }
      ]
    }
