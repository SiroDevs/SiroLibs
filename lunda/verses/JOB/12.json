              "JOB.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihulaku ntahi anyama akuleji; nitujila twahaluzwizu akushimwini.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
