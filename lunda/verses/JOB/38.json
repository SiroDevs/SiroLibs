          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.38",
            "verseOrgIds": [
              "JOB.38.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOB 38:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyi wukumuzombela mukaji wamutupa mbiji yindi? Yeyi wukufumisha nzala yanyenzi yanyitupa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.39",
            "verseOrgIds": [
              "JOB.38.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOB 38:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "habatamaŋawu muyididi yawu, hashakamaŋawu mwavumba nakubelamina, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.40",
            "verseOrgIds": [
              "JOB.38.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOB 38:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinyi wadiishaŋa ikololu yakudya yindi hadililaŋa anyanindi kudi Nzambi, halumbwaŋi-laŋawu nákubula yakudya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.41",
            "verseOrgIds": [
              "JOB.38.41"
            ]
          }
        }
      ]
    }
