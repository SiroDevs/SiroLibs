  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "JOB 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi awa amayala asatu alekeli kumwakula Yoba nanochu chadimweniyi kuloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.1",
            "verseOrgIds": [
              "JOB.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaBarakeli Elihu wakuBuzi, wakuchisaka chaRami, ozuwa nikuzuwa; wazuwili naYoba nanochu chadiyiŋishiliyi yomweni abuli kuyiŋisha Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.2",
            "verseOrgIds": [
              "JOB.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wazuwili nawa nawamabwambu jindi asatu, nanochu chabuliluwu kumona mazu akumwakula Yoba; hela chochu, chamutanyishawu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.3",
            "verseOrgIds": [
              "JOB.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Elihu wuchidi kuchiŋilila kuhosha naYoba muloŋa akwawu diwu adiŋi awakulumpi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.4",
            "verseOrgIds": [
              "JOB.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihu chamweniyi awa amayala asatu anakaŋanyi dehi mazu akwakula ozuwa nikuzuwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaBarakeli Elihu wakuBuzi hakwakula nindi, Ami nikansi, enu mwakula dehi nankashi, dichi chinadilekeshela, hinukutiya woma wakuyileja munatoŋojoki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nela nami, Mafuku ahoshi, nyaka yayivulu yileji maana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.7",
            "verseOrgIds": [
              "JOB.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, mudi muntu mwekala spiritu; kwona kwonaŋayi Chinaweji kwayilukishaŋa mwalumbuluka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.8",
            "verseOrgIds": [
              "JOB.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaneni hidiwu akweti maanaku, hela atushinakaji hidiwu ashinshika mwaya wuŋajuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.9",
            "verseOrgIds": [
              "JOB.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chinukwila nami, Ntiyililenu, ninami nawa niyileji munatoŋojoki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.10",
            "verseOrgIds": [
              "JOB.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.10",
            "verseOrgIds": [
              "JOB.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami kwami nadiŋi nakuchiŋilila mazu enu, nadiŋi nakutiyilila mumunalumbululaŋa, chimwadiŋi nakukeŋakeŋa mwakuhosha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalala, nadiŋi nakutiya mwenwenu, aka, kumona wakuhosha mazu akumushika Yoba kumuchima nehi, hela mwinenu wumu wakumwakula mazu indi kwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalenu mubuli kuhosha nenu, Tunawani dehi maana. Nzambi diyi wukumwimika mushindu, bayi muntuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.13",
            "verseOrgIds": [
              "JOB.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yena hanatalishi mazu indi kudamuku, hela ami hinukumwakula namazu imunahoshenuku.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.14",
            "verseOrgIds": [
              "JOB.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.14",
            "verseOrgIds": [
              "JOB.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afwa nipuchi, kwakula nawa cheŋi nehi, nimwakuhosha nawa nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.15",
            "verseOrgIds": [
              "JOB.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichiŋililaŋa tuhu, nanichi chakubula kuhoshawu, kwakwimana zo-o hohu, nikwakula cheŋi nehi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.16",
            "verseOrgIds": [
              "JOB.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninami nawa nukwakula mwami, ninami nawa nukushimuna munatoŋojoki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.17",
            "verseOrgIds": [
              "JOB.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nenzali mazu, spiritu yidi mudami yidi nakunshinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.18",
            "verseOrgIds": [
              "JOB.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivumu dami didi neyi vinyu yinakaŋanyi mwakwidikila; didi neyi njeki jayitembi jinakeŋi kubuzika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.19",
            "verseOrgIds": [
              "JOB.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuhosha kulonda nitiyi pe-e; nukujikula nyivumbu yami nakuli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.20",
            "verseOrgIds": [
              "JOB.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mwani nakama muntu kumesu; hela kusama muntu majina akumulambishaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.21",
            "verseOrgIds": [
              "JOB.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hineluka kusama muntu namajina akumulambishaku; nili ochu, Nleŋi yami wukunfumishahu chakadi nikuleha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.22",
            "verseOrgIds": [
              "JOB.32.22"
            ]
          }
        }
      ]
    }
  ],
