            "sid": "JOB 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zofwari wakuNayamati hakwakula nindi:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.1",
            "verseOrgIds": [
              "JOB.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.1",
            "verseOrgIds": [
              "JOB.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu yitoŋojoka yami yidi nakunleja mwakwakwila, dihu hanafumi ami kunyakala. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natiyi kunhosha kwakuntiyisha nsonyi, spiritu yakashinshi kami yidi nakuŋakula.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumisha kushankulu hashiluwu muntu hanu hamaseki eyi kwiluka nehi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chayikaŋa muntu watama hihalehaŋaku, chazaŋalalaŋa wasekesha Nzambi champinji yantesha hohu, kuchiluka nehi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela kuwaha kwindi kukukandama nimwiwulu, ninamutu windi wukushika nimumavu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakakisika tuhu neyi tuji twindi; amumweni akela nawu, Hayodihi? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatúuka neyi chilota, hiyakamuwanaku; mwalala, akamukupisha neyi chimwenu chahawufuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Disu damumweni hidakamumona nawa cheŋuku, hindi hadiŋiyi hihakamumona nawa cheŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanindi akaya nakukeŋakeŋa nawu ayitiyi kuwaha kudi atuzweŋi, makasindi akafuntisha mahetindi kudi akwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafwahindi anenzali nawukwenzi windi, hela chochu, wakakambama hamu nindi mulunkuŋu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela neyi yatama yikutowala mukanwa kindi, hela wukuyisweka kwishina dedimi dindi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela wukuyanakena, kuyumbaku nehi, saŋa ayihembelayi mukanwa kindi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakudya yindi yinabalumuki dehi mwivumu dindi neyi wulembi watubandanjila mukachi kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nadyi maheta, wakayisanza cheŋi; Nzambi wakayifumisha mwivumu dindi, wakayinata. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaamwa wulembi watubandanjila, idimi dakabandayula dakamujaha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamona hela tuloŋa hela mpweji jawuchi namantekaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma chakabakeneniyi wakachifuntisha cheŋi, hakachiminyaku; hakaluŋa namaheta anahetiyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.18",
            "verseOrgIds": [
              "JOB.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yena nakabishi atuzweŋi, nayumbi dehi kwindi; nabuwi dehi itala, kudituŋa nehi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.19",
            "verseOrgIds": [
              "JOB.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.19",
            "verseOrgIds": [
              "JOB.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakaamwina chuma chatiyiliyi nachu kuwahaku, Muloŋa wabulili kwiluka kuwunda mumuchima windi mwivumu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.20",
            "verseOrgIds": [
              "JOB.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikwasheli chuma chabulili kudyayuku, dichi kufuka kwanamoniyi hikwakalehaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.21",
            "verseOrgIds": [
              "JOB.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakawaninayi yuma yayivulu wakamona kukala, antu ejima amona ihuŋu akamulundumukila. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.22",
            "verseOrgIds": [
              "JOB.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakelayi nindi enzeshi ivumu dindi, Nzambi wakamunatila ndombu yindi yazuwa nankashi, wakamunokeshelayi neyi nvula, iku wuchidi kudya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatemuka chitwa chachikuŋu, wuta wamukunji wawuneŋu wakamwasa zwa-a. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.24",
            "verseOrgIds": [
              "JOB.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakukokamu nsewu, hiyikufuma mumujimba windi, insa yayu yakekema yakedika mundulu yindi; wafwa dehi nimutentu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.25",
            "verseOrgIds": [
              "JOB.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anamutentekeli mwidima wejima wikali yozelu yindi; kesi kakadi kupeŋa kudi muntu kakamudya; kakanoŋesha yasheli mwitenti dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawulu akamwekesha kuluwa kwindi, niiseki dakamunyamukila. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.27",
            "verseOrgIds": [
              "JOB.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yikusemununa mwitala dindi yakamufuma, yakamwaŋala mwa-mwa mwifuku dakuzuwa kwaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.28",
            "verseOrgIds": [
              "JOB.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Didu iseka dakatambulayi muntu watama kudi Nzambi, diwu wuswana wanamufuukwiluwu kudi Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.29",
            "verseOrgIds": [
              "JOB.20.29"
            ]
          }
        }
      ]
    }
  ],
