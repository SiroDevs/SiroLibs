  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JHN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulondela hayumiyi, kwadiŋi chawija chawaYudeya; Yesu hakukanduka kuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.1",
            "verseOrgIds": [
              "JHN.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.1",
            "verseOrgIds": [
              "JHN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuYerusalema, kuchisu chanyikoku, kwekala ŋiya ijina dadu mwidimi daHeberu nawu Beteseda, dikweti makeki atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.2",
            "verseOrgIds": [
              "JHN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenomu mwakaminaŋa izaza dawantu akata, niamputamesu, niayifwayi, niakwakalepa, hiyakuchiŋililaŋa hakuvundulawu meji; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.3",
            "verseOrgIds": [
              "JHN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa kaŋelu wasulukilaŋa nakuvundula meji; hakuvundulawu meji, muntu wukusambilaŋahu dehi kudatamu hakukola kumusoŋu windi ngu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.4",
            "verseOrgIds": [
              "JHN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenoku kwadiŋi iyala wumu wakata dehi nyaka makumi asatu nanyaka yitanu nayisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.5",
            "verseOrgIds": [
              "JHN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu chamumweniyi nakami, welukili nindi wakata dehi hanalehi, hakumwihula nindi, Wukukeŋa akukoleshi tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.6",
            "verseOrgIds": [
              "JHN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu iyala wakata hakumwakula nindi, Mwanta, hinikweti muntu wakuŋinŋa mwijiya havundulaŋawu mejuku; hinélaŋami nami niyumu, muntu wacheŋi hakunyakala kwijila mu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.7",
            "verseOrgIds": [
              "JHN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Hiridukaku, sendaku yikaŋa yeyi, wendi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.8",
            "verseOrgIds": [
              "JHN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohe-nohu iyala yokola nikukola, hakusenda yikaŋa yindi, hakwenda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.9",
            "verseOrgIds": [
              "JHN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.9",
            "verseOrgIds": [
              "JHN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu dadiŋi dasabata. Dichi aYudeya hiyakumwila muntu anakoleshuwu dehi, nawu, Lelu hisabata, kusenda yikaŋa yeyi chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.10",
            "verseOrgIds": [
              "JHN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa yena hakuyakula nindi, Muntu nankoleshi diyi naŋili nindi, Sendaku yikaŋa yeyi, wendi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.11",
            "verseOrgIds": [
              "JHN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyakumwihula nawu, iyala wakwila nindi, Sendaku yikaŋa yeyi, wendi; hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.12",
            "verseOrgIds": [
              "JHN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa owu muntu kwiluka wamukolesha nehi; Yesu nawomboloki dehi nezaza dawantu dadiŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.13",
            "verseOrgIds": [
              "JHN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chihanalehi chanti Yesu hakumuwana mutembeli, hakumwila nindi, Tala, eyi anakukoleshi dehi, bayi wakavulumuna cheŋuku, chuma chabadika kutama chakamba kakuwana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.14",
            "verseOrgIds": [
              "JHN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu iyala hakudiyila kwindi, hakuleja aYudeya nindi, Yesu diyi wankolesha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.15",
            "verseOrgIds": [
              "JHN.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.15",
            "verseOrgIds": [
              "JHN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Yesu yumiyi hasabata dichi chamukabishiluwu kudi aYudeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.16",
            "verseOrgIds": [
              "JHN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yesu hakuyakula nindi, Tata yami wuchidi kukalakala nihanu, ninami nawa nidi nakukalakala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.17",
            "verseOrgIds": [
              "JHN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu dihu hafumini aYudeya kukeŋa nankashi kumujaha, nawu hanakumini dakujilola kwasabataku, ilaŋa nateni niNzambi nindi Tata yami; hakudibwambula naNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.18",
            "verseOrgIds": [
              "JHN.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.18",
            "verseOrgIds": [
              "JHN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yesu hakuyakula nindi, Chalala chalala, nukuyileja nami, Mwana hatweshaŋa kwila chuma chakanka winduku, chiŋa amona chadi nakwilayi Tata. Yuma yelaŋa Tata yejima, diyi yelaŋa ni mwana nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.19",
            "verseOrgIds": [
              "JHN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Tata wakeŋa a Mwana, wamulejaŋa yuma yejima yelaŋayi yomweni; wakamuleja ninyidimu yakubadika yeniyi, kulonda enu mwakahayami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.20",
            "verseOrgIds": [
              "JHN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chasaŋulaŋayi Tata afu nakuyihandisha, dichi nawa chahandishaŋayi Mwana antu anafuukuliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.21",
            "verseOrgIds": [
              "JHN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata hasompeshaŋa muntuku, nakunjiki kusompesha kwejima kudi Mwana; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.22",
            "verseOrgIds": [
              "JHN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda antu ejima alemeshi Mwana mwomwalemeshelaŋawu Tata. Muntu wabulaŋa kulemesha Mwana wabulaŋa kulemesha Tata yindi wamutemesheli. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.23",
            "verseOrgIds": [
              "JHN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala chalala, nukuyileja nami, muntu wukutiya mazu ami, hakukuhwelela yena wantemesheli, wukweti wumi wahaya nyaka; hakamona kumusompeshaku, nafumi dehi mukufwa, nepili dehi muwumi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.24",
            "verseOrgIds": [
              "JHN.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.24",
            "verseOrgIds": [
              "JHN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala chalala, nukuyileja nami, mpinji yikwinza, yashika dehi, mwakutiyilawu afu izu daMwana kaNzambi, akutiya akuhanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.25",
            "verseOrgIds": [
              "JHN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chahetayi Tata wumi mudi yomweni, dichi chanamwinkiyi ni mwana Ŋovu yakuheta wumi mudi yomweni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.26",
            "verseOrgIds": [
              "JHN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwinki niwanta wakusompesha nanochu chadiyi Mwana kamuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.27",
            "verseOrgIds": [
              "JHN.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi muhayama chumichuku; mpinji yakenza henohu antu ejima adi mumajamu akatiya izu dindi; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.28",
            "verseOrgIds": [
              "JHN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "akedikamu; elili chachiwahi akasaŋukila wumi, akoŋeli chatama akasaŋukila kuyisompesha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami hinukutwesha kwila chuma chakanka wami hela chimuku. Munatiyaŋa dimu nasompeshelaŋa, nikusompesha kwami kwaloŋa; muloŋa hinalondaŋa muchima wamami awenuku, chiŋa muchima waTata wantemesheli. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.30",
            "verseOrgIds": [
              "JHN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami neyi nukudishimwina wunsahu wamami aweni, wunsahu wami hiwukwikala walalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.31",
            "verseOrgIds": [
              "JHN.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wunsahu wami awushimunaŋa kudi wacheŋi; ami neluki mwakunshimunayi mwalala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.32",
            "verseOrgIds": [
              "JHN.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwatemesheli antu kudi Yowanu, yena washimwini mwalala hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wunsahu wunetejaŋami hiwakudi antuku; chinahoshaŋa mazu awa nalondi muhandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.34",
            "verseOrgIds": [
              "JHN.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena Yowanu wadiŋi inoŋu, dela nikubutuka nikutoŋaeka; enu mwetejeli kuzaŋalala chilaaka chimu muchejeji chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.35",
            "verseOrgIds": [
              "JHN.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wunsahu wunikwetami wabadika waYowanu, nyidimu yanyinkeliyi Tata kumanisha, yena nyidimu iyi vinelaŋa, diyi yanshimunaŋa wunsahu, nawu antemesheii kudi Tata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.36",
            "verseOrgIds": [
              "JHN.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiTata wantemesheli diyi nekali chinsahu chami, diyi nanshimuni dehi; enu kanda mutiyaloŋahu dehi izu dindi, hela kumumona chekalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu aNzambi hiyashakamaŋa mudenuku, muloŋa ona atemesheliyi himwamwitiyaloŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.38",
            "verseOrgIds": [
              "JHN.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwatalatalaŋa munyikanda yajila, muloŋa mwatoŋojokaŋa nenu dimu mumukumwena wumi wahaya nyaka; yeniyi diyi yanshimunaŋami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.39",
            "verseOrgIds": [
              "JHN.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa enu kwenu kwonti kwenu kwinza kudami kulonda mumoni wumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.40",
            "verseOrgIds": [
              "JHN.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami hinetejaŋa kunlemesha kudi antuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.41",
            "verseOrgIds": [
              "JHN.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mi nayiluki, nami mudenu himwekala kukeŋa kwaNzambuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.42",
            "verseOrgIds": [
              "JHN.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nenzi mwijina daTata yami, himunantambuluku; neyi wacheŋi wukwinza mwijina dindi yomweni, mukumutambula. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.43",
            "verseOrgIds": [
              "JHN.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwetejaŋa kuyilemesha kudi akwenu, ilaŋa kuyilemesha kudi Nzambi wumu hohu himwachikeŋaŋaku, mukutwesha kwitiya ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.44",
            "verseOrgIds": [
              "JHN.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mutoŋojoka nenu ami yami nukuyiholokela kudi Tataku; kudi wumu wayiholokelaŋa, diyi Mosi, imwakuhwelelaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.45",
            "verseOrgIds": [
              "JHN.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi enu mwamwitiyili Mosi mutenowu mwadi kuŋitiya ninami, muloŋa yena wasonekeli nakuntenami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.46",
            "verseOrgIds": [
              "JHN.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi mukubula kwitiya nyikanda yajila yasonekeliyi yena, indi mazu inahoshaŋami mukuyiitiya ŋahi?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.47",
            "verseOrgIds": [
              "JHN.5.47"
            ]
          }
        }
      ]
    }
