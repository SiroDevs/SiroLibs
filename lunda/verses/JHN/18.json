  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JHN 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanahoshiyi mazu awa, Yesu hakwidika nawatumbanji twindi, hakuya kwishinadi dakaloŋa Kidironi kwadiŋi itempa, hakwijila mu yomweni nawatumbanji twindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.1",
            "verseOrgIds": [
              "JHN.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa iwu Yudasi wamufukejeli, welukiluku, muloŋa Yesu wayilaŋaku kakavulu nawatumbanji twindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.2",
            "verseOrgIds": [
              "JHN.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yudasi chanatambuliyi chendu chamashidika niatulama kudi awakulumpi jawatupristu nikudi aFwarisi, hakuya kwenoku namanoŋu niyimunyi niyitwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.3",
            "verseOrgIds": [
              "JHN.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yesu weluka dehi yuma yejima yikukeŋa kumushikena, hakuyikinkilila. Hakuyihula nindi, Mukukeŋanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.4",
            "verseOrgIds": [
              "JHN.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwakula nawu, Yesu wakuNazareta. Yesu hakuyila nindi, Diyi ami. NiYudasi wamufukejeli, nemani chimu nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu chayililiyi nindi, Diyi ami; hiyakufunta mankinkanyima, adimbuka niheseki. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.6",
            "verseOrgIds": [
              "JHN.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyihula cheŋi nindi, Mukukeŋanyi? Nawu, Yesu wakuNazareta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.7",
            "verseOrgIds": [
              "JHN.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyakula nindi, Nayileji dehi nami diyi ami; dichi neyi yami mudi nakukeŋa, yilekenu awa adiyili kwawu; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.8",
            "verseOrgIds": [
              "JHN.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda izu dahoshayi dehi dilumbuluki, deliliyi nindi, Awa wanyinkeli hinajimbeshuhu hela wumuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.9",
            "verseOrgIds": [
              "JHN.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Shimona Petulu wadiŋi nampoku yakabali, hakuyihola hakutapa nduŋu yakapristu muneni, kutapa kwakumuketula itu dindi dachidiilu. Ijina danowu nduŋu Malikusa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.10",
            "verseOrgIds": [
              "JHN.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yesu hakumwila Petulu nindi, Somekaku mpoku yeyi muchindalu chayu; lupasa lwananyinkiyi Tata nibuli kunwa?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.11",
            "verseOrgIds": [
              "JHN.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.11",
            "verseOrgIds": [
              "JHN.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu chendu, nimukulumpi wawatulama, niatulama twawaYudeya, hiyakumukwata Yesu, hiyakumukasa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.12",
            "verseOrgIds": [
              "JHN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asambilili kumutwala kudi Anasi, muloŋa diyi mukwesanu waKayafwasi wadiŋi kapristu muneni hamwakowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.13",
            "verseOrgIds": [
              "JHN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena Kayafwasi diyi walejeli aYudeya maana akwila nindi, Chinawahi muntu wumu afwili awa antu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.14",
            "verseOrgIds": [
              "JHN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.14",
            "verseOrgIds": [
              "JHN.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimona Petulu hakumulonda Yesu, nikambanji mukwawu nawa. Owu kambanji mukwawu amwiluka dehi kudi kapristu muneni, hakwijila naYesu muchipaŋu chakapristu muneni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.15",
            "verseOrgIds": [
              "JHN.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Petulu hakwimana hanzi kuchisu. Owu kambanji mukwawu elukawu kudi kapristu muneni, hakwidika, hakuhosha namumbanda wahembelaŋa kuchisu, hakumwiŋija Petulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.16",
            "verseOrgIds": [
              "JHN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chaŋadima chamumbanda wahembelaŋa kuchisu, hakumwihula Petulu nindi, Nineyi nawa wukambanji kaniwu muntu, tahindi? Yena hakwila nindi, Nehi, hiyamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu anduŋu naawatulama adiŋi nakwimana kwenoku, abutula dehi kesi kamakala. Adiŋi nakwota kesi namashika adiŋuku, niPetulu nawa hakwimana nawu nakwota kesi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.18",
            "verseOrgIds": [
              "JHN.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.18",
            "verseOrgIds": [
              "JHN.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kapristu muneni hakumwihujola Yesu nsaŋu yawatumbanji twindi, nichalejelaŋayi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.19",
            "verseOrgIds": [
              "JHN.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwakula nindi, Ami nahosheli hatooka kumesu awantu ejima. Nayilejelaŋa mafuku ejima mumashikola nimutembeli mwapompelaŋa aYudeya ejima. Hinahoshuhu dehi chuma hambaduku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.20",
            "verseOrgIds": [
              "JHN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukupihujoleladi? Yihuli antu adiŋi nakuntiya chinahoshelaŋa. Wena eluka chinahosheli. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.21",
            "verseOrgIds": [
              "JHN.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanahoshiyi mwenimu, kalama wemenuku hakumweta Yesu mbaŋala, nindi, Kapristu muneni wumwakuli chenochu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.22",
            "verseOrgIds": [
              "JHN.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwakula nindi, Neyi nahoshi chatama, shimunaku chinatamishi, ilaŋa neyi chachiwahi wunaŋetelidi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.23",
            "verseOrgIds": [
              "JHN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anasi hakumutemesha kudi kapristu muneni Kayafwasi chochamukasawu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Shimona Petulu saŋa emenayi nakwota kesi. Dichi hiyakumwihula nawu, Nineyi nawa wukambanji kindi? Yena hakudikala nindi, Nehi, hiyamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka kambanji wumu kakapristu muneni, ntaŋa yanowu muntu aketulawu itu kudi Petulu, nindi, Ami hinakumona chimu nindi mwitempaku? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.26",
            "verseOrgIds": [
              "JHN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Petulu hakudikala cheŋi; ikombu edikila nihohenohu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.27",
            "verseOrgIds": [
              "JHN.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.27",
            "verseOrgIds": [
              "JHN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakumufumisha Yesu kudi Kayafwasi kwadiŋiyi, hiyakumwiŋija mwitala dakusompela. Henohu kunachi dehi. Ilaŋa wenawu kwijila mwitala dakusompela nehi, akenda kadiŋilola, kulonda atweshi kudya paseka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.28",
            "verseOrgIds": [
              "JHN.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Pilatu hakwidika hanzi hadi wena nindi, Iwu muntu munamuholokeli namuloŋanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.29",
            "verseOrgIds": [
              "JHN.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwakula nawu, Neyi yeniwu muntu hadiŋi mukwakutamishaku, twadikumuleta kudeyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.30",
            "verseOrgIds": [
              "JHN.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu hakuyila nindi, Mutambulenu mumusompeshi enu aweni mwaya nshimbi jenu. AYudeya hiyakumwila nawu, Etu kujaha muntu chinjila; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mazu ahosheliyi Yesu, ashimwiniyi mwakafwilayi alumbuluki.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.32",
            "verseOrgIds": [
              "JHN.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.32",
            "verseOrgIds": [
              "JHN.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Pilatu hakufunta cheŋi mwitala dakusompela, hakumutambi ka Yesu, hakumwila nindi, Eyi komana wuMwanta wawaYudeya? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.33",
            "verseOrgIds": [
              "JHN.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwakula nindi, Wunahoshi mwenimu eyi aweni, tahindi anakulejumu kudi antu acheŋi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.34",
            "verseOrgIds": [
              "JHN.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu hakwakula nindi, Ami nikaYudeya, tahindi? Muza weyeyi aweni niakulumpi jawatupristu, diwu anakuleti kudami. Wunelidi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.35",
            "verseOrgIds": [
              "JHN.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwakula nindi, Wanta wami hiwampata yamunu mwishinaku; neyi wanta wami wadiŋi wampata yamunu mwishina, ambuŋami adi kulwa, kulonda abuli kunhana kudi aYudeya; wanta wami hiwamunuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.36",
            "verseOrgIds": [
              "JHN.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Pilatu hakumwila nindi, Eyi komana wumwanta? Yesu hakumwakula nindi, Wunahoshi eyi aweni neyi nimwanta; dichi chinavwalikilili, dichi chinenjilili mumpata yamunu mwishina, kulonda nakeli chinsahu chansaŋu yalala. Akwansaŋu yalala ejima atiyaloŋa izu dami ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.37",
            "verseOrgIds": [
              "JHN.18.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu hakumwihula nindi, Nsaŋu yalala yika?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.38",
            "verseOrgIds": [
              "JHN.18.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanahoshiyi mwenimu hakwidika cheŋi hadi aYudeya, hakuyila nindi, Ami kwami hinamumoni nachitelaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.38",
            "verseOrgIds": [
              "JHN.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mukweti chaaku chakwila chiŋa niyumbiluku muntu wumu hapaseka. Dichi munakeŋi niyumbiluku Mwanta wawaYudeya, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.39",
            "verseOrgIds": [
              "JHN.18.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakuvwakuka nakubidika cheŋi naŋovu nawu, Bayi yeniwuku, chiŋa Baraba. Yena Baraba wadiŋi kapondu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.40",
            "verseOrgIds": [
              "JHN.18.40"
            ]
          }
        }
      ]
    }
  ],
