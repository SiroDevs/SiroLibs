  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JHN 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu chawija chapaseka chichidi kanda, Yesu welukili nindi mpinji yami yakufuma mumpata yamunu mwishina niyi kudi Tata yinashi ki dehi. Chakeŋeliyi antu indi adiŋi mumpata yamunu mwishina, wayikeŋeli hachikupu ndo nikunsa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.1",
            "verseOrgIds": [
              "JHN.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadiŋuwu nakudya, henohu diyabolu weŋa dehi mumuchima waYudasi Isakaroti, mwana ka Shimona, jakumufukeja, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.2",
            "verseOrgIds": [
              "JHN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu chanelukiyi nindi Tata nashi yuma yejima mumakasami, neluki nindi nafumini kudi Nzambi, hinukuya kudi Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.3",
            "verseOrgIds": [
              "JHN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakunyamuka kukudya, hakutenteka mahinindi ahewulu kumbadi, hakunona ditwayi, hakudivwala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.4",
            "verseOrgIds": [
              "JHN.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhuŋununa meji mumbashila, hakutachika kuwelesha nyendu yawatumbanji, nakuyikombola naditwayi danavwaliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.5",
            "verseOrgIds": [
              "JHN.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanashikiyi kudi Shimona Petulu, yena hakumwila nindi, Mwanta, keŋa wuweleshi nyendu yamami? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.6",
            "verseOrgIds": [
              "JHN.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwakula nindi, Ichi chinukwilami katataka hiwunachilukuku, ilaŋa chamba kakulumbulukila kunyaka yakenza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.7",
            "verseOrgIds": [
              "JHN.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu hakumwila nindi, Hiwamba kawelesha nyendu yamuku. Yesu hakumwakula nindi, Neyi nukubula kukuwelesha, hiwukutwesha kutiyaloŋana nanamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimona Petulu hakumwila nindi, Mwanta, bayi nyendu yami hohuku, ilaŋa nikumakasami nikunamutu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.9",
            "verseOrgIds": [
              "JHN.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Muntu naweli dehi kumujimba wejima hakukeŋa kuwela cheŋuku, chiŋa kunyendu hohu; natooki dehi mumujimba wejima. Enu munatooki dehi, ilaŋa himunatooki wejima wenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa welukili muntu wukukeŋa kumufukeja; dihu hafumini kwila nindi, Himunatooki wejima wenuku.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.11",
            "verseOrgIds": [
              "JHN.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.11",
            "verseOrgIds": [
              "JHN.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi naweleshi dehi nyendu yawu, nanoni dehi yuma yindi yakuvwala, nashakami dehi cheŋi, hakuyila nindi, Ichi chinayili munachiluki, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.12",
            "verseOrgIds": [
              "JHN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwaŋilaŋa nenu, Eyi Nkuluŋaŋa; cheŋi nawa nenu, Eyi Mwanta. Mwelaŋa chachiwahi, muloŋa dichi chinidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.13",
            "verseOrgIds": [
              "JHN.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami niMwanta wenu niNkuluŋaŋa nawa, naweleshi nyendu yenu, dichi ninenu nawa mwadi kuweleshaŋana nyendu yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.14",
            "verseOrgIds": [
              "JHN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami nayileji chuma chakwimbujola, kulonda ninenu nawa mwilaŋa neyi munayilenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.15",
            "verseOrgIds": [
              "JHN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala chalala, nukuyileja nami, nduŋu habadikaŋa nkaka yinduku; hela muntu atemeshawu habadikaŋa wamutemesheluku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.16",
            "verseOrgIds": [
              "JHN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi muneluki yumiyi himukuyila, munakooleki. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.17",
            "verseOrgIds": [
              "JHN.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinayiteni wejima wenuku; awa inatondi nayiluki; ilaŋa nalondi mukanda wajila wulumbuluki welawu nawu, Muntu wadyaloŋa yakudya yami nannyamwini dehi katutu kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.18",
            "verseOrgIds": [
              "JHN.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumisha hanu nukuyilejaŋa yuma yichidi kanda yimwekani, kulonda neyi yinamwekani dehi mwakatweshi kwitiya nenu diyi ami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.19",
            "verseOrgIds": [
              "JHN.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala chalala, nukuyileja nami, yowu wukutambula muntu nukutemesha, nantambulami; muntu wukuntambulami, natambuli yena wantemesheli.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.20",
            "verseOrgIds": [
              "JHN.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.20",
            "verseOrgIds": [
              "JHN.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu chanahoshiyi ochu, hakukaba muspiritu yindi, hakushimuna nindi, Chalala chalala, nukuyileja nami, hadi mwinenu wumu wukunfukeja.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.21",
            "verseOrgIds": [
              "JHN.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanedikiyi hanzi, Yesu hakuhosha nindi, Ichi dinu Mwana kamuntu anamulemeshi dehi; niNzambi nawa anamulemeshi mudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.31",
            "verseOrgIds": [
              "JHN.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamulemeshuwu Nzambi mudi yena, niNzambi keŋa alemeshi Mwana kamuntu kachawichi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.32",
            "verseOrgIds": [
              "JHN.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu anyana anyanya, nidi nenu kapinji kanti hohu. Mwakankeŋakeŋa; munahosha nawaYudeya nami, Kunukuya himukutwesha kushika kwoku; dimu nukuhosha nawa nanenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.33",
            "verseOrgIds": [
              "JHN.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, nukuyileja lushimbi lwalwiha nami, Mukeŋaŋani. Chinayikeŋami, ninenu nawa keŋaŋanenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.34",
            "verseOrgIds": [
              "JHN.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mukukeŋaŋana, dihu hakayilukilawu antu ejima nawu mudi atumbanji twami.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.35",
            "verseOrgIds": [
              "JHN.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimona Petulu hakumwihula nindi, Mwanta, wukuya kudihi? Yesu hakwakula nindi, Kunukuyami hiwukutwesha kunlondela katatakaku, ilaŋa wamba kanlondela. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.36",
            "verseOrgIds": [
              "JHN.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu hakumwila nindi, Mwanta nukukaŋenyadi kukulondela katataka? Hela kufwa hamujimba weyeyi nukufwa tuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.37",
            "verseOrgIds": [
              "JHN.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwakula nindi, Wukufwila hamujimba wamami, tahindi? Chalala chalala, nukukuleja nami, hakela ikombu kanda edikiluku, henohu eyi wadikala dehi mapampa kasatu neyi, Hinamwiluka Yesuku.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.38",
            "verseOrgIds": [
              "JHN.13.38"
            ]
          }
        }
      ]
    }
  ],
