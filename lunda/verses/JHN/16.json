  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JHN 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinayileji yumiyi nalondi akabuli kuyidimbwisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayihaŋa mumashikola; eŋa, mpinji yakenza yakela muntu wakayijaha, wakatoŋojoka nindi wudi nakukalakela Nzambi mudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.2",
            "verseOrgIds": [
              "JHN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akela yumiyi nanochu chabula kwilukawu Tata hela ami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.3",
            "verseOrgIds": [
              "JHN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayileji yumiyi kulonda neyi mpinji yawu yinenzi mwakaanukaŋa nenu nayilejelumu dehi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.4",
            "verseOrgIds": [
              "JHN.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachi hinayilejelaŋa yumiyuku, muloŋa nadiŋi nenu; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.4",
            "verseOrgIds": [
              "JHN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "katataka hinukuya kudi yena wantemesheli. Kwosi mwinenu wumu wukuŋihula nindi, Wukuya kudihuku? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.5",
            "verseOrgIds": [
              "JHN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinayileji mazu awa, munyichima yenu mudi kwakuneŋa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.6",
            "verseOrgIds": [
              "JHN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, nukuyileja mwalala nami, chinukufumahu chikuyiwahilenu; neyi nukubula kufumahu, Nkwashi hakwinza kudenuku; ilaŋa neyi nukuya, nakamutemesha enzi kudenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyena chakenzayi, wakakonkolola antu ampata yamunu mwishina nansaŋu yanshidi, nansaŋu yakuloŋa, ninansaŋu yakusompesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.8",
            "verseOrgIds": [
              "JHN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakayikonkolola hansaŋu yanshidi nanichi chabulaŋawu kuŋitiya; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.9",
            "verseOrgIds": [
              "JHN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "hansaŋu yakuloŋa nanichi chinukuya kudi Tata, himwakanmona cheŋuku; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "hansaŋu yakusompesha nanichi chaneliyi mwanta wampata yamunu mwishina anamusompeshi dehi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nichidi nayuma yayivulu yakuyileja, ilaŋa katataka himukuyitweshaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chakenzayi Spiritu wansaŋu yalala, wakayileja mwahita nsaŋu yalala yejima. Hakahoshaŋa yakumucnima windi yomwenuku, wakahoshaŋa mwatiyaloŋayi mwejima, wakashimunaŋahu dehi yuma yakenza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.15",
            "verseOrgIds": [
              "JHN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuhita kapinji kanti himukunmonaku; mwakahita kapinji kakwawu kanti mwakanmona. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.16",
            "verseOrgIds": [
              "JHN.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi atumbanji twindi amu hiyakudihula nawu, Chanatulejiyi nindi, Mukuhita kapinji kanti himukunmonaku, mwakahita kapinji kakwawu kanti mwakanmona; cheŋi nindi, muloŋa nukuya kudi Tata; chaya mudihi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakudihula nawu, Chanatulejiyi nindi, Mukuhita kapinji kanti; chaya mudihi? Etu hituneluki mwanatulejiyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu neluki dehi chakukeŋa kumwihulawu; hakuyila nindi, Mudi nakudihujola nsaŋu yamazu inahoshi nami mukuhita kapinji kanti himukunmonaku, mwakahita kapinji kakwawu kanti mwakanmona; tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala chalala, nukuyileja nami, mukudila, mukululuta, hakwila antu ampata yamunu mwishina akuzaŋalala. Enu mukuneŋa, ilaŋa kuneŋa kwenu kwakabalumuka muzaŋalu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.20",
            "verseOrgIds": [
              "JHN.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda waneŋaŋa hafunyishaŋayi, muloŋa mpinji yindi yinamuwani dehi; hakwila neyi navwali dehi mwanindi, hakwanuka nawa cheŋi ihuŋuku, nakuzaŋalala namuntu navwaliki mumpata yamunu mwishina. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.21",
            "verseOrgIds": [
              "JHN.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi enu mudi nakuneŋa katataka, ilaŋa nakayimona cheŋi, mwakazaŋalala munyichima yenu, nimuzaŋalu wenu kwosi wakayitambulawuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.22",
            "verseOrgIds": [
              "JHN.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu himwakaŋihula cheŋi chumaku. Chalala chalala, nukuyileja nami, neyi hadi chuma chimwakamulomba Tata, wakayinkachu mwijina dami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
            "verseOrgIds": [
              "JHN.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanda mulombaŋahu dehi chuma mwijina damuku. Lombenu mutambuli, kulonda muzaŋalu wenu wuwanini.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
            "verseOrgIds": [
              "JHN.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
            "verseOrgIds": [
              "JHN.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahoshi nenu mwenimu nayishimu, ilaŋa mpinji yakenza hinakahosha nenu nayishimuku, nakayileja Tata chalumbuluka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
              "JHN.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu mwakalomba mwijina dami; hinukuyila nami yami nakayilombela kudi Tataku, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
            "verseOrgIds": [
              "JHN.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa yomweni Tata wayikeŋa nanichi chimunankeŋami, nanichi chimunetiyi nenu ami nafumini kudi Tata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nafumini kudi Tata, nenzi mumpata yamunu mwishina; cheŋi nawa nukufuma mumpata yamunu mwishina, nukuya kudi Tata.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
            "verseOrgIds": [
              "JHN.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
            "verseOrgIds": [
              "JHN.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumbanji twindi hiyakwila nawu, Ichi dinu hiwukuhosha chalumbuluka, hiwudi nakuhosha nayishimuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
              "JHN.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu tuneluki dehi netu eyi weluka yuma yejima, hichikweti kukwihula chuma kudi muntuku. Dichi tunetiyi netu wafumini kudi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyakula nindi, Ichi dinu munetiyi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
