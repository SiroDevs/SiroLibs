            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.30",
            "verseOrgIds": [
              "JHN.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuhosha nawaYudeya amwitiyili nindi, Neyi mukushakama mumazu ami, mukwi kala atumbanji twami chalala; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.31",
            "verseOrgIds": [
              "JHN.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukwiluka nsaŋu yalala, ninsaŋu yalala yikuyifumisha muwuduŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.32",
            "verseOrgIds": [
              "JHN.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyakumwakula nawu, Etu anyana kaAbarahama, kanda tushakamaŋahu dehi muwuduŋuku, indi eyi wunahoshi ŋahi neyi, Akuyifumisha muwuduŋu?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.33",
            "verseOrgIds": [
              "JHN.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.33",
            "verseOrgIds": [
              "JHN.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyakula nindi, Chalala chalala, nukuvileja nami, antu ejima avulumunaŋa, diwu anduŋu janshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.34",
            "verseOrgIds": [
              "JHN.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nduŋu hashakamaŋa mwitala haya nyakaku; mwana washakamaŋa haya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.35",
            "verseOrgIds": [
              "JHN.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, neyi Mwana wukuyifumisha muwuduŋu mukufumamu chalala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.36",
            "verseOrgIds": [
              "JHN.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neluki nami enu mudi anyana kaAbarahama; hela chochu, enu mwafwilaŋa kunjaha, muloŋa himukweti mwakutambwila mazu amuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.37",
            "verseOrgIds": [
              "JHN.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nahoshaŋa yinamweni kudi Tata yami, enu mwelaŋa yuma yimwatiyili kudi tata yenu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.38",
            "verseOrgIds": [
              "JHN.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.38",
            "verseOrgIds": [
              "JHN.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyakumwakula nawu, Tata yetu Abarahama. Yesu hakuyila nindi, Neyi mwadiŋi anyana kaAbarahama, mutenowu mwadi kwila nyidimu yaAbarahama. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.39",
            "verseOrgIds": [
              "JHN.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa dinu enu mwafwilaŋa kunjaha, ami muntu nayileja dehi mwalala munatiyili kudi Nzambi; hidichi chelili Abarahamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.40",
            "verseOrgIds": [
              "JHN.8.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 8:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwelaŋa nyidimu yatata yenu. Hiyakumwila nawu, Hitudi anyana amuchiputaku, tukweti tata yetu wumu, yowu Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.41",
            "verseOrgIds": [
              "JHN.8.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 8:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyila nindi, Neyi Nzambi hitata yenu mwadi kukeŋami, muloŋa ami nafumini kudi Nzambi, diku nenjili; ami hinadinjila ami awenuku, yena diyi wantemesheli. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.42",
            "verseOrgIds": [
              "JHN.8.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 8:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munakaŋenyidi kwiluka munahoshaŋa? Chinafumi hákubula kutiya mazu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.43",
            "verseOrgIds": [
              "JHN.8.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 8:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu tata yenu diyabolu; mwakeŋa aŋa kwila mwafwilaŋayi tata yenu. Yena wadiŋi mbanji kufumisha kutachi; yena hemanaŋa munsaŋu yalalaku, muloŋa himwekala nsaŋu yalala mudi yenaku. Chahoshaŋayi yakutwamba wahoshaŋa yindi yomweni; yena hintwambi, hitata yachu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.44",
            "verseOrgIds": [
              "JHN.8.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 8:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwabulaŋa kuŋitiya muloŋa nahoshaŋ: nsaŋu yalala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.45",
            "verseOrgIds": [
              "JHN.8.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 8:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwinenwinyi wukunkonkolola nindi navulumuni Nzambi? Neyi nahoshaŋa nsaŋu yalala mwalekelaŋadi kuŋitiya? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.46",
            "verseOrgIds": [
              "JHN.8.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu waNzambi watiyaloŋa mazu aNzambi. Chimunabuli kwikala antu aNzambi, dihu lianafumi kubula kutiya mazu indi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.47",
            "verseOrgIds": [
              "JHN.8.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.47",
            "verseOrgIds": [
              "JHN.8.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 8:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYudeya hiyakwakula nawu, Chitwakutenaŋa netu eyi wukaSamariya wudi nademoni, hitwakutenaŋa mwalalaku? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.48",
            "verseOrgIds": [
              "JHN.8.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 8:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka Yesu nindi, Hinikweti demonuku; ami nalemeshaŋa Tata yami, enu mwansawulaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.49",
            "verseOrgIds": [
              "JHN.8.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 8:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa hinakeŋi kudilemesha ami awenuku; wakeŋa aŋa kunlemesha yowu mukwakusompesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.50",
            "verseOrgIds": [
              "JHN.8.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 8:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala chalala, nukuyileja nami, muntu wahembaŋa mazu ami hamba kamona kufwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.51",
            "verseOrgIds": [
              "JHN.8.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 8:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYudeya hiyakumwila nawu, Ichi dinu tuneluki netu wudi nademoni. Abarahama wafwa dehi, niatuprofwetu nawa, hakwila eyi hiwukwila neyi, Muntu wahembaŋa mazu ami hamba katompa kufwaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.52",
            "verseOrgIds": [
              "JHN.8.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi wunabadiki tata yetu Abarahama niatuprofwetu afwili, tahindi? Wudi nakuditena neyi yeyinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.53",
            "verseOrgIds": [
              "JHN.8.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwakula nindi, Neyi nukudilemesha ami aweni, kulema kwami kwamukunkulwayi. Tata yami diyi wanlemeshaŋa, iwu mwatenaŋa nenu Nzambi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.54",
            "verseOrgIds": [
              "JHN.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JHN 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu himunamwilukuku, ilaŋa ami namwiluka. Neyi nukwila nami hinamwilukaku, nukwi kala ntwambi neyi enu. Ilaŋa namwiluka, nahembaŋa mazu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.55",
            "verseOrgIds": [
              "JHN.8.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JHN 8:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yenu Abarahama waluŋili chamweniyi ifuku dami; chadimweniyi hakuzaŋalala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.56",
            "verseOrgIds": [
              "JHN.8.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JHN 8:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi aYudeya hiyakumwila nawu, Kanda wushiki munyaka makumi atanu, wunamoni dehi niAbarahama? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.57",
            "verseOrgIds": [
              "JHN.8.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JHN 8:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyila nindi, Chalala chalala, nukuyileja nami, hadiŋi Abarahama kanda avwaliki, ami nidi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.58",
            "verseOrgIds": [
              "JHN.8.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JHN 8:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakunona malola nawu amwasi; Ilaŋa Yesu hakubatama, edika nimutembeli.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.59",
            "verseOrgIds": [
              "JHN.8.59"
            ]
          }
        }
      ]
    }
  ],
