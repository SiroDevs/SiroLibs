  "copyright": "PUBLIC DOMAIN",
  "verseCount": 59,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JHN 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayili wejima wawu, iwu kwitala dindi, iwu kwitala dindi. Ilaŋa Yesu wayili kumpidi yaOliveta.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.1",
            "verseOrgIds": [
              "JHN.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.1",
            "verseOrgIds": [
              "JHN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwijila cheŋi mutembeli budidi yayeni; antu ejima hiyakwinza kudi yena, yena hakushakama nakuyileja. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.2",
            "verseOrgIds": [
              "JHN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ansoneki nawaFwarisi hiyakumuletela mumbanda akwatawu dehi nakwila wuvumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.3",
            "verseOrgIds": [
              "JHN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamushuwu mukachi hiyakumwila nawu, Eyi Nkuluŋaŋa, mumbandiwu anamukwati nakwila wuvumbi, anamushintakeshi wakushintakesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.4",
            "verseOrgIds": [
              "JHN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunshimbi jaMosi atuleja nawu muntu wudi ichi chiŋa kumwasa malola; indi eyi neyi tumwili ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.5",
            "verseOrgIds": [
              "JHN.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chahosheluwu chenochu alondeli kumweseka, kulonda amoni hakumwinkela muloŋa. Ilaŋa Yesu hakubandama, hakusoneka namunu windi hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.6",
            "verseOrgIds": [
              "JHN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamwihuluwu ihule-e, hakubanduka, hakuyila nindi, Muntu nabuli nshidi hakachi kenu asambili kunona ilola amwasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.7",
            "verseOrgIds": [
              "JHN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakubandama cheŋi nakusoneka namunu windi hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.8",
            "verseOrgIds": [
              "JHN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena chanachitiyuwu, hiyakwidikamu, wumu, wumu, kutachikila kudi mukulumpi, ndo nikudi kansi. Yesu yoshala nikanka windi, namumbanda saŋa adiyi mukachi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.9",
            "verseOrgIds": [
              "JHN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakubanduka, hakumwihula nindi, Eyi mumbanda, antu anakwinki muloŋa adi kudihi? Kwosi muntu nakuhishuku? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.10",
            "verseOrgIds": [
              "JHN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda nindi, Kwosi Mwanta. Yesu nindi, Hela ami hinakuhishuku; yaloŋa kweyi, kufumisha kulelu bayi wufuntilamu cheŋuku.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yesu hakuhosha cheŋi nawena, nindi, Ami yami chejeji champata yamunu mwishina, muntu wukunlondelami hakendela mumwidimaku, ilaŋa wakekala nachejeji chawumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.12",
            "verseOrgIds": [
              "JHN.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi aFwarisi hiyakumwila nawu, Wadishimunaŋa eyi aweni; wunsahu weyi hiwalalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.13",
            "verseOrgIds": [
              "JHN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyakula nindi, Hela neyi nadishimunaŋa ami aweni, wunsahu wami walala; muloŋa neluki kunafumini nikunukuya, ilaŋa enu himweluka kunafumini hela kunukuyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.14",
            "verseOrgIds": [
              "JHN.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwasompeshaŋa mwasompeshaŋawu antu. Ami hinasompeshaŋa muntuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.15",
            "verseOrgIds": [
              "JHN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala, hela neyi nasompeshana, kusompesha kwami kwalala; Muloŋa hinekala kanka wamuku, nidi naTata wantemesheli. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.16",
            "verseOrgIds": [
              "JHN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala, hela munshimbi jenu anasoneki nawu, Wunsahu wawantu ayedi walala. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.17",
            "verseOrgIds": [
              "JHN.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nadishimunaŋa ami aweni, niTata wantemesheli hakunshimuna wunsahu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.18",
            "verseOrgIds": [
              "JHN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakumwihula nawu, Tata yeyi wekala kudihi? Yesu hakwakula nindi, Hela ami, hela Tata yami himwatwilukaku; neyi mwaŋilukami mwadi kwiluka niTata yami. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.19",
            "verseOrgIds": [
              "JHN.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu awa wayihosheleli mwitala dakuswekela mali, chadiŋi nakuyilejayi mutembeli. Hi kwadiŋi muntu wamukwatiluku, muloŋa henohu mpinji yindi kanda yishiki.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.20",
            "verseOrgIds": [
              "JHN.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.20",
            "verseOrgIds": [
              "JHN.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hakuyila cheŋi nindi, Ami hinukufumahu, enu mwakankeŋakeŋa, mwakafwa nanshidi yenu. Kunukuyami himukutwesha kushika kwoku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.21",
            "verseOrgIds": [
              "JHN.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYudeya hiyakwila nawu, Chaneliyi nindi, Kunukuyami himukutwesha kushika kwoku, keŋa adŋahi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.22",
            "verseOrgIds": [
              "JHN.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyila nindi, Enu mudi antu ampata yamunu mwishina, ami nidi wamwiwulu; enu mudi ampata yinu, ami hinidi wampata yinuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.23",
            "verseOrgIds": [
              "JHN.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chinayili nami, Mwakafwa nanyiloŋa yenu. Muloŋa neyi mukubula kuŋitiya nenu diyi ami, mwakafwa nanyiloŋa yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.24",
            "verseOrgIds": [
              "JHN.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakumwihula nawu, Ochu yeyinyi? Yesu hakuyila nindi, Nayileja dehi kufumisha kutachi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.25",
            "verseOrgIds": [
              "JHN.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nidi nayuma yayivulu yakuhosha nakusompesha hansaŋu yenu; hakwila yena wantemesheli walala, ami nahoshaŋa nawantu ampata yamunu mwishina mazu inatiyili kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.26",
            "verseOrgIds": [
              "JHN.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyelukili nawu nateni Tata yinduku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.27",
            "verseOrgIds": [
              "JHN.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yesu hakuyila nindi, Chimwamba kanyamuna Mwana kamuntu kwiwulu, henohu dihu mwamba kelukila nenu diyi ami; nenu hinelaŋa chuma chakanka wamuku, ilaŋa nahoshaŋa mazu awa mwomwanlejeluwu kudi Tata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.28",
            "verseOrgIds": [
              "JHN.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wantemesheli nekala hamu nindi, hananshiyi kanka wamuku; muloŋa nelaŋa yuma yamutiyishaŋa kuwaha mafuku ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.29",
            "verseOrgIds": [
              "JHN.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakuhoshayi ochu antu amavulu amwitiya nikumwitiya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.30",
            "verseOrgIds": [
              "JHN.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
