        },
        {
          "text": "Wafuma mwiwulu wabadika ejima; wahamaseki hiwahamaseki kwindi, watenaŋa yahamaseki. Wafuma mwiwulu wabadika ejima; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.31",
            "verseOrgIds": [
