          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa iwu atemesheluwu kudi Nzambi wahoshaŋa mazu aNzambi, muloŋa hahanaŋa Spiritu nakwesekelaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
