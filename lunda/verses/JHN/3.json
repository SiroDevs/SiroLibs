          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "washimunaŋa mwanamoniyi nimwanatiyiyi; ilaŋa kwosi muntu wetiyaloŋa mwashimunaŋayuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.32",
            "verseOrgIds": [
