          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoŋa yami nayijilumwinini aAmori kumbidi yawu, adiŋi ataluka neyi nyisida, akola neyi nyikula; kutoŋa yami nakisaŋeni nyikabu yindi kwiwulu, ninyiji yindi kwishina. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yami nawa nayifumishili mwituŋa daEjipitu, hinukuyilombolaŋa mwisaŋa nyaka makumi awana, kulonda mwakaheti ituŋa dawaAmori. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.10",
            "verseOrgIds": [
              "AMO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi anyanenu amayala nanyamwinuhu amakwawu ekali atuprofwetu, nihadi anyikwenzi jenu nanyamwinuhu amakwawu ekali aNaziri. Enu anyana kaIsarela, hidimuku, tahindi? Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
