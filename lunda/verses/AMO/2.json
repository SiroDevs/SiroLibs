          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Hanyiloŋa yaMowabi yisatu, niyiwanayikwikala, hinakalekesha kubabesha kwawuku; muloŋa yena wocheli mafwaha amwanta wawaEdomi abalumukili hiswakala. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami nakatemesha kesi hadi Mowabi, kakalasha matala amuKeriyoti awanta; Mowabi wakafwa namuyoyu, nakudikuwa, nachivumu champùŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninsompeshi yawu nakamufumishahu mukachi kawu, nakajahila hamu niatulamba twawu ejima. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
