          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Naziri mwayinkeli vinyu nenu, Nwenu; atuprofwetu mwayile-kesheli nenu, Bayi muprofwetaŋaku.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        }
      ]
