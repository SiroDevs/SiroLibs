              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyiloŋa yaYuda yisatu, niyiwana yikwikala, hinakalekesha kubabesha kwawuku; muloŋa wena analeki dehi nshimbi jaYehova, hiyanalamati muyidika yinduku, kutwambatwamba kwawu kunayiluwishi, kwokutwambatwamba kwalondelaŋawu ankakulula jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami nakatemesha kesi hadi Yuda, kakalasha matala pamu Yerusalema awanta. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nahoshi nindi, Hanyiloŋa yaIsarela yisatu, niyiwana yikwikala, hinakalekesha kubabesha kwawuku; muloŋa wena analandishi waloŋa nasiliva, analandishi niwabula yuma namasapatu ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adatolaŋa nyitu yawatuzweŋi mulunkuŋu lwahamaseki, ateŋululaŋa njila yawantu amwovu; mwana natata yindi ayaloŋa kudi chaŋadima wumu, kulonda ajiloli ijina dami dajila. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutumeŋa twejima akamaŋa hamahina ayinkeluwu kudi akwanyikudi kukwataku; mwitala daNzambi yawu anwinaŋamu vinyu yanafutishuwu akwawu hanviloŋa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
