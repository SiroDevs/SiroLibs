          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayitemesheli chipupu chidi neyi chamwenuwu aEjipitu; natapi anyikwenzi jenu nampoku yakabali; natwali nawa tuwalu twenu; nanunkishi chilombu chenu ivumba datama, dinepili nimumazulu enu. Hela chochu, himunafunti kudamuku. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
            "verseOrgIds": [
              "AMO.4.10"
            ]
          }
        }
      ]
    },
    {
