          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayeti nakukonyata kunakonyati mbutu, nambuwa nawa. Mahenu amavulu, nimatempenu anyivinyu, niyikuyu, ninyiolive yenu, anayidyi kudi atubola amotokaŋa. Hela chochu, himunafunti kudamuku. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        }
      ]
    },
    {
