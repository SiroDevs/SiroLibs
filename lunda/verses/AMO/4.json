          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu amakwawu nayikindumuni neyi chakindumwinuwu Sodoma naGomora kudi Nzambi; mwadiŋi neyi luchawa lwakuhukula mukesi. Hela chochu, himunafunti kudamuku. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
