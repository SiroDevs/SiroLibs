          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chinakakwila eyi Isarela; ochu chinakakwila mwenimu, kadiloŋeshi wudimoni naNzambi yeyi, eyi Isarela.",
          "type": "text",
          "attrs": {
