              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu aAmosa, wadiŋi kudi atubiŋa akuTekowa, mazu amweniyi akutena Isarela hamafuku amwanta wawaYuda Uziya, nihamafukuamwanta wawaIsarela Yerobowami mwana kaYehowashi, henohu muchidi nyaka yiyedi nahenjili mutentanshi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        }
      ]
    },
