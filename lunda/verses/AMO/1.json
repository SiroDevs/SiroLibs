          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami nakabutula kesi kumpwembu yaRaba, kakalasha matalawu awanta, nakudikuwa kwamwifuku danjita, nampepela yasweja Ŋovu yefuku dachinjimbi; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.14",
            "verseOrgIds": [
              "AMO.1.14"
            ]
