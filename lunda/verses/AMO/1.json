          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Yehova wakabuluma kuZiyona, wakahosha izu dakaŋuka muYerusalema; kuwudiilu wawatubiŋa kwakadishona, insa yaKarameli yakalepuka.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
