            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami nakatemesha kesi haTemani, kakalasha matala aBozira awanta.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.12",
