              "type": "text"
            }
          ]
        },
        {
          "text": "Enu akwamutaŋa waIsarela, mwanleteli ayimuna akuketula ninyilambu nyaka makumi awana muna mwisaŋa, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.25",
