        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helili Davidi nashakami dehi mwitala dindi, Davidi hakumwila kaprofwetu Natani, nindi, Tala, ami nashakama mwitala danyisida, hakwila chimbaŋu chachitiyaŋenu chaYehova chidi mumahina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natanihakumwila Davidi, nindi, laku chejima chidi mumuchima weyi, muloŋa Nzambi wudi naneyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wowena wufuku owu izu daNzambi hidikwinza kudi Natani ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.3",
            "verseOrgIds": [
              "1CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yaku wakaleji kambuŋami Davidi, neyi, Yehova nahoshi nindi, Eyi kuntuŋilaitala dakushakama nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.4",
            "verseOrgIds": [
              "1CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa kufumisha kwifuku dinafumishili aIsarela muEjipitu, kushika nikwifuku dalelu, hinashakami kwami mwitalaku, nelaŋa nifuma itenti idi niya itenti di kwawu, nifuma tabanaka iyi niyayikwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.5",
            "verseOrgIds": [
              "1CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwejima munendojoli nawaIsarela ejima, nahoshahu dehi izu nansompeshi yawaIsarela wumu inalejeli kudiisha antu ami, nimwilanami, Munabulilidi kuntuŋila itala danyisida? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.6",
            "verseOrgIds": [
              "1CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu tiya chiwakamwila kambuŋami Davidi, kamwili neyi, Yehova wamazaza nahoshi nindi, Nakufumishili kwiyinda danyikoku, kumudimu wakulondela nyikoku, kulonda wikali lomboli yawantu ami aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.7",
            "verseOrgIds": [
              "1CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwejima kuwayilaŋa nadiŋi naneyi, nakufumishilili ayilumbu jeyi ejima kuwadiŋi nakwinzeyi; nakaditiyakesha ijina deyi dakekali neyi majina awamaneni ekala hamaseki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.8",
            "verseOrgIds": [
              "1CH.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Davidi hakwijila, hakushakama kumesu aYehova, hakwila nindi, Eyi Yehova Nzambi, yaminyi ntahi, nimutaŋa wamami himutaŋanyi, mwaka wunshileŋi mwejimimu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenimu wunamoni neyi munakehi dehi, eyi Nzambi, hiwukutena cheŋi mutaŋa wamami kambuŋeyi wakekalakunyaka yakenza kumbidi, hiwukuŋila mwelaŋawu muntu wabadika kulema, eyi Yehova Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.17",
            "verseOrgIds": [
              "1CH.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi Davidi wukuhosha nawa mwekwawu mudihinakulema iku kuwunanlemeshi ami kambuŋeyi? Muloŋa eyi waŋilukaami kambuŋeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.18",
            "verseOrgIds": [
              "1CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova chiwunakoŋi kutoha kwejimiku kwakwilukisha yuma yamaneni yejimiyi, wunachikoŋeli hamujimba wamamikambuŋeyi, nimwaya muchima weyeyi aweni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
            "verseOrgIds": [
              "1CH.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova, hikudiwakufwanaku, hikwekala niNzambi wacheŋuku, mwejima namutunatiyina matu etu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
              "1CH.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu hamaseki hadi muza wudi neyi antu eyi aIsarela, ayili nakukuulayi Nzambi kulonda akekali antu indi, wuditiyakeshi ijina nayuma yamaneni yikweti niwoma, chiwatemwini nyuza kwcnjilaŋa antu eyi lwakúulili muEjipitu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.21",
            "verseOrgIds": [
              "1CH.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa antu eyi aIsarela wunayibalumuni dehi kwikala antu ambala eyeyi aweni chahaya nyaka; nineyi Yehova wunekali dehi Nzambi yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.22",
            "verseOrgIds": [
              "1CH.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu, eyi Yehova izu dakutena ami kambuŋeyi, dakutena nimutaŋa wami, dikoli ngu haya nyaka, ilaku muwunahoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.23",
            "verseOrgIds": [
              "1CH.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijina deyi dikoli, ditohi haya nyaka, akahoshaŋa nawu, Yehova wamazazadiyi Nzambi yawaIsarela, nikudi aIsarela hiNzambi chikupu; mutaŋawamami kambuŋeyi Davidi wushimati kumesu eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala Nzambi yami, wunaleji ami kambuŋeyi neyi wakanyamwina mutaŋa, dihu hanafumi amikambuŋeyi kumona jakulomba kumesu eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.25",
            "verseOrgIds": [
              "1CH.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu eyi Yehova, yeyi Nzambi, wunankani ami kambuŋeyi chumichi chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
            "verseOrgIds": [
              "1CH.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichidinu wunatiyi kuwaha kukiswila mutaŋa wamami kambuŋeyi nkisu, kulonda wakashakamaŋa kumesu eyi haya nyaka; eyi Yehova ichi chiwunawukiswili dehi nkisu, wunakooleki dehi chahaya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.27",
            "verseOrgIds": [
              "1CH.17.27"
            ]
          }
        }
      ]
    }
  ],
