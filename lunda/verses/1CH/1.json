          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adama, Seta, Enoshi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.1",
            "verseOrgIds": [
              "1CH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenani, Mahalaleli, Yaredi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.2",
            "verseOrgIds": [
              "1CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enoki, Metusela, Lameki; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.3",
            "verseOrgIds": [
              "1CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowa, Shemi, Hami, Yafweta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.4",
            "verseOrgIds": [
              "1CH.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
