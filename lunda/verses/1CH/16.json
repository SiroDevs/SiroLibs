          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku denodu didásambililiyi Davidi kuyileja nindi akasakililaŋa Yehova kukanwa kaAsafwi nawana kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.36",
            "verseOrgIds": [
              "1CH.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumesu achimbaŋu chachitiyaŋenu chaYehova hakushiyaku Asafwinawana kwindi, kulonda akalakalaŋa kumesu achimbaŋu hefuku hefuku, mwashikila mudimu wefuku, mwashikila mudimu wefuku, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "niObedi Edomi hamu nawana kwawu makumi atanu nadimu natanu nasatu; ni mwana kaYedutuni Obedi Edomi nawa, niHosa, akekali akwakuhemba kuyisu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikapristu Zadoki, niana kwindi atupristu, kumesu atabanaka yaYehova kuchinaŋanaŋa chadiŋi kuGibeyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
            "verseOrgIds": [
              "1CH.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda kuhimulambu laŋa Yehova nyilambu yakushita, hakameŋa kahimulambu wakushita, hefukuhefuku nibudidi nimelela, mwomwaya mazu ejima asonekeluwu munshimbiji Yehova jalejeliyi aIsarela; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.40",
            "verseOrgIds": [
              "1CH.16.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubombelaku niHemani niYedutuni niatondeluwu asheluku, atenenuwu hejina hejina, kulonda amusakililaŋi Yehova naluwi lwindi lwahaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubombelaku niHemani niYedutuni na mpùŋa namachakayi yanawa akuvumishaŋa chakola, nayuma yakumwimbila nachu Nzambi tumina; nianyana kaYedutuni kulonda akemanaŋa kuchisu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 16:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima hiyakumwaŋala, hiyakufunta kumatalawu. Davidi niyena hakufunta nakukiswila itala dindi nkisu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.43",
            "verseOrgIds": [
              "1CH.16.43"
            ]
          }
        }
      ]
    }
