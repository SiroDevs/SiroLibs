          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "niZiza mwana kaShifwi, Shifwi mwana kaAloni, Aloni mwana kaYedaya, Yedaya mwana kaShimiri, Shimiri mwana kaShemaya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "awa anatenuwu hamajina diwu adiŋi atulamba amuyisaka yawu; nyitapa yawatata jawu yasemunwini nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.38",
            "verseOrgIds": [
              "1CH.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayili kuwiŋililu waku-Gedori, kumbadi yachinekineki yakumusela, nakukeŋakeŋa amatahu ayimunayawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
            "verseOrgIds": [
              "1CH.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aweni matahu amanji, amawahi, niituŋa datandumuka, dawunda, damwena; muloŋa ásambilili kushakamamu adiŋi akwaHami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa anasonekuwu majina enjili hamafuku adiŋi mwanta wawaYuda Hezekiya, hiyakutapa matenti awu, niaMewuni awenuwu kwenoku, hiyakuyijilu munaji-i, nikulelu, hiyakuhiŋa mwadi ŋuwu, hiyakushakama kwenoku; muloŋa kwadiŋi matahu ayimuna yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakwawu, adiŋi anyana kaSimeyona, amayala makulakaji atanu, ayili kumpidi yaSeyiri, adiŋi nawawakulumpi jawu anjita niPelatiya, niNeyariya, niRefwaya, niUziyeli, anyana kaIshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakutapa aAmaleki asheluku apulukili, hiyakushakama kwenokunikulelu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
