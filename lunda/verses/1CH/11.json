  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1CH 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela ejima hiyakupompela kudi Davidi kuHeberoni, hiyakwila nawu, Tala, wejima wetu mwivunu detu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.1",
            "verseOrgIds": [
              "1CH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka hadiŋiyi Sawulu wuchidi mwanta, yeyi welilaŋa wutwala aIsarela wuyileta cheŋi; Yehova Nzambi yeyi wakwilili nindi, Yeyi wakadiishaŋa antu ami aIsarela, yeyi wakekalaŋa nlomboli yawantu ami aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.2",
            "verseOrgIds": [
              "1CH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi ejima aIsarela hiyakwinza kudi mwanta kuHeheroni; Davidi hakutiyanana nawu chitiyaŋenu kumesu aYehova kuHeheroni; hiyakumuwayisha Davidi ekali mwanta wawaIsatela, mwomwizu daYehova dakukanwa kaSamweli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.3",
            "verseOrgIds": [
              "1CH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi nawaIsarela ejima iriyakuya kuYerusalema, yowu Yebusi. AYebusi eniituŋa dawu kwokwadinuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.4",
            "verseOrgIds": [
              "1CH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "EniYehusi itiyakumwila Davidi nawu, Eyi kwinza munu nehi. Hela chochu, Davidi watambwili chikooleha Ziyona; diwu mukala waDavidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.5",
            "verseOrgIds": [
              "1CH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi nindi, Yowu wukusamb kutapa aYehusi diyi wakekala mukuiumpi nikapiteni. Mwana kaZeruwi Yowahi diyi wasambilili kukanduka, hiyakumwinka niwtrkuiumpi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.6",
            "verseOrgIds": [
              "1CH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakushakama muchikooku; dichi chawutenenenuwu nawu mukala waDavidi ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.7",
            "verseOrgIds": [
              "1CH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutuŋaku mukala kwi-ndo, kuftunisha kuMilo kwi-ndo; Yowa hakulotesha mukala washeluku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.8",
            "verseOrgIds": [
              "1CH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutoha kwaDavidi hikukuya nakusweja muloŋa Yehova wamazaza wadiŋi nayena.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.9",
            "verseOrgIds": [
              "1CH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu awakulumpi awayilobu adiŋi aDavidi adikolesheli naŋovu hanina waIsarela ejima kulonda kumukwashakamisha muwanta windi kulonda kumushakamisha muwanta, mwomwizu daYehova dateneneniyi aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.10",
            "verseOrgIds": [
              "1CH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mwachindilawu ayilobu adiŋi aDavidi; Yashobeyami, mwana kamukwaHakimoni, mukulumpi wamakumi asatu; yowu wanyamwinini antu makulakaji asatu iyoŋa dindi hakuyitapa mpinji yawu yimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.11",
            "verseOrgIds": [
              "1CH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudi yena mwalondeli Eleyazari mwana kaDodo, mukwaAhoha, di; wadiŋi wawayilobu asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.12",
            "verseOrgIds": [
              "1CH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyi wadint naDavidi kuPasidamimi kwapompeleluwu aFwilistinu nawu adasi njita, kuchibalu cheha chakudima bali chejima; antu hiyakutemoka aFwilistinu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.13",
            "verseOrgIds": [
              "1CH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa asatu hiyakwimana mukachi keha, hiyakulwila iha odu, hiyakuyilaha aFwilistinu; Yehova hakuyamwina nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.14",
            "verseOrgIds": [
              "1CH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi awakulumpi makumi asatu hadiŋi asatu akunkumukili kwiyeti dakuAdulami, kwilola kwadiŋi Davidi; njita yawaFwilistinu atuŋili chile mbu chawu muchinekineki chawaRefwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.15",
            "verseOrgIds": [
              "1CH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Davidi wudi mumpwembu, henohu asha dehi mashidika awaFwilistinu muBetelemi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.16",
            "verseOrgIds": [
              "1CH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakudinaana, nindi Maya-ala! Hinyi wukunyinka meji amwishima dakuBetelemi dekala kuchisu chamukala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.17",
            "verseOrgIds": [
              "1CH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa asatu hiyakuhalula njita yawaFwilistinu, hiyakuhanukamu, hiyakutaha meji mwishima dakuBetelemi dadini kuchisu chamukala, hiyakunona, hiyakutwala kudi Davidi. Davidi kuyinwa kwonti kwindi, hakuyimwaŋila kumesta Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.18",
            "verseOrgIds": [
              "1CH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Nzambi yami kwaamu, ami kwila mwenimu kwakuieh tuhu ntahi. Ninwi mashi awantu awa aditwala kukufwa? Muiotta weni; chanayiietuwu anaketli kumwenamu kufwa. Dichi chalekeleliyi kuyinwa Diyi yutuna yejiluwu awa ayilohu asatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.19",
            "verseOrgIds": [
              "1CH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kwaYowabi Abishayi diyi wadiŋi mukulumpi wanawa asatu, wayinyamwinini antu makulakaji asatu iyoŋa dindi, hakuyijaha, hakutiyakana ijina hadi awa asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.20",
            "verseOrgIds": [
              "1CH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi awa asatu diyi wabadikili akwawu ayedi kulema. Amwilisha nimukulumpi wawu. Hela chochu, hashikili mudi asatu akusambilaku.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.21",
            "verseOrgIds": [
              "1CH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.21",
            "verseOrgIds": [
              "1CH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya mwana kaYehoyada, Yehoyada mwana keyala womika waku-Kabezeyeli, wakoŋeli nyidimu yaŋovu, niyena wajahili anyana kaAriyelia kuMowabi ayedi. Weŋilili nawa muwina ifuku danvula yachishikayitooka, hakujaha mutupa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.22",
            "verseOrgIds": [
              "1CH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajahili nikaEjipitu, iyala dataluka nankashi, chiminu chindi chashika munkotweli jachikasa jitanu; muchikasa chakaEjipitu mwadini iyoŋa didi neyi chipamba chamukwakutuŋa mahina. Hakukunkumuka kwadiŋi yi namutondu, hakumuhukula kaEjipitu iyoŋa muchikasa chindi, hakumujaha neyoŋa dindi yomwenindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.23",
            "verseOrgIds": [
              "1CH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyi yumayeliliyi mwana kaYehoyada Benaya, hakutiyakana ijina hadi awa ayilobu asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.24",
            "verseOrgIds": [
              "1CH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu, wabadikili owu makumi asatu kulema, ilaŋa kushikadinu mudi awa asatu akusambila nelri. Davidi hakumukunjika kwikala mukulumpi wawakwakumuhemba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.25",
            "verseOrgIds": [
              "1CH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niayilobu ahamajita nawa; Asaheli mana kwaYowabi, Elehanani mwana kaDodo wakuBetelemi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.26",
            "verseOrgIds": [
              "1CH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamoti wakuHarodi, Helezi waku-Peloni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.27",
            "verseOrgIds": [
              "1CH.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira, mwana kakeshi wakuTekowa, Abiyezeri wakuAnatoti; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.28",
            "verseOrgIds": [
              "1CH.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibekayi mukwaHusha, Ilayi mukwaAhowa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.29",
            "verseOrgIds": [
              "1CH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maharayi wakuNetofwa, Heledi mwana kaBayana wakuNetofwa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.30",
            "verseOrgIds": [
              "1CH.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itayi mwana kaRibayi waku-Gibeya wawanyana kaBenjamini, Benaya wakuPiratoni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.31",
            "verseOrgIds": [
              "1CH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hurayi wakutwanatwatuloŋa twakuGayashi, Abiyeli wakuAraba; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.32",
            "verseOrgIds": [
              "1CH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azimaveti waku-Baharumi, Eliyahaba wakuShayalaboni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.33",
            "verseOrgIds": [
              "1CH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "wawanyana kaHashemi mukwa-Gizoni, Jonatani mwana kaShaŋe wakuHarari; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.34",
            "verseOrgIds": [
              "1CH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiyami mwanakaSakari, wakuHarari, Elifwali mwana kaUri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.35",
            "verseOrgIds": [
              "1CH.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefwenai wakuMekerati, Ahiya wakuPeloni; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.36",
            "verseOrgIds": [
              "1CH.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezero wakuKarameli, Nayarayi mwana kaEzebayi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.37",
            "verseOrgIds": [
              "1CH.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoweli mana kwaNatani, Mibihari mwana kaHaŋiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.38",
            "verseOrgIds": [
              "1CH.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeleki kaAmoni, Naharayi wakuBeroti, mukwakusenda yitwa yaYowabi mwana kaZeruwiya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.39",
            "verseOrgIds": [
              "1CH.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira wakuYeteri, Garebi wakuYeteri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.40",
            "verseOrgIds": [
              "1CH.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uriya kaHiti, Zabadi mwanakaAhalayi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.41",
            "verseOrgIds": [
              "1CH.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adina mwana kaShiza kaRubeni, mukulumpi wawaRubeni, niantu indi makumi asatu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.42",
            "verseOrgIds": [
              "1CH.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanani mwana kaMayaka, niYoshafwati wakuMitini; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.43",
            "verseOrgIds": [
              "1CH.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziya wakuAshiteroti, Shama naYeyeli anyana kaHotamiwa kuArowenai; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.44",
            "verseOrgIds": [
              "1CH.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yediyayeli mwana kaShimiri, nimana kwindi Yohawa kuTiza; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.45",
            "verseOrgIds": [
              "1CH.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyeii wakuMahava, niYeribayi, niYoshaviya, anyana kaElinayami, niltima kaMowabi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.46",
            "verseOrgIds": [
              "1CH.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyeli, niObedi, niYayesili waku-Mezoba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.47",
            "verseOrgIds": [
              "1CH.11.47"
            ]
          }
        }
      ]
    }
