      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benjamini wavweli wedi windi Bela, chilondawedi Ashibeli, warchisatu Ahara;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.1",
            "verseOrgIds": [
              "1CH.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.5",
            "verseOrgIds": [
              "1CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Any kaEhudi diwu awa; diwu anyanta akumavumu awankakulula jawu ashamini muGeba, ayitweli muwukoli kuManahati; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.6",
            "verseOrgIds": [
              "1CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "niNayamani, niAhiniGera, wayitweli muwukoli; hakuvwala Uza, niAhihudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.7",
            "verseOrgIds": [
              "1CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaharaywavweli anyana mumpata yaMowabi, heliliyi nahapi dehi aŋodi jin aHushimi naBayara. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.8",
            "verseOrgIds": [
              "1CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobabi, niZibiya, niMesha, niMalikami, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.9",
            "verseOrgIds": [
              "1CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwuzi, niShakiya, niMirima, wayivweli napodindi Hodeshi. Diwu annindi, anyanta akumavumu awankakulula jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.10",
            "verseOrgIds": [
              "1CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abitubi naElipa; wayivweli naHushimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.11",
            "verseOrgIds": [
              "1CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaElipayali; Eberu, niMishami, niSmedi, watupili Ono naLodi ninyikala yawu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.12",
            "verseOrgIds": [
              "1CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "niBeriya, niShema, akanyanta akumavumu awankakulula jawa kwakushakama muAyŋaloni, atemwini akwakushakama muGati; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.13",
            "verseOrgIds": [
              "1CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "niAhiyo, niShashaki, niYereme",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.14",
            "verseOrgIds": [
              "1CH.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri wavweli Kishi; Kishi wavweli Sawulu; Sawulu wavweli Jonatani Malikishuwa, niAbinadabi, niEshibayali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kajonatani weyi diyi Meribaya li; Meribayali wavweli Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaMika amayala Pitoni, niMeleki, niTareya, niAhazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi wavweli Yehowada; Yelwada wavweli Alemeti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "niAzimaveti, niZimiri; Zimiri wavweli Moza Moza wavweli Bineya; Rafwa wadiŋi mwanindi, Eleyasa mwani naAzeli mwanindi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azeli wadiŋi nawanya nindi atanu nawumu, majina diwu awa; Aziri kami, Bokeru, nilshimeli, niSheyariya, niObadiya, niHana Ejimawa adiŋi anyana kaAzeli amayala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kamana kwindi Esheki wedi windi Ulami, chilondawedi Yewushi, niElifweleti wamuchisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaUlami adiŋi ayilobu akwaŋovu, akwakwasa, adiŋi nawanya amayala amavulu, niezukulu awu, nkulakaji namakumi atanu. Ejimawa adiŋi anyana kaBenjamini amayala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
    }
  ],
