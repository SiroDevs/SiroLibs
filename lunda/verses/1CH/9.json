          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwedi windi Abidoni, niZuri, niKishi, niBayali, niHeri, niNadabi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.36",
            "verseOrgIds": [
              "1CH.9.36"
            ]
          }
        },
