          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuGibeyoni mwashakamini tata yaGibeyoni dindi Mayaka; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.35",
            "verseOrgIds": [
              "1CH.9.35"
            ]
          }
        },
        {
          "name": "verse",
