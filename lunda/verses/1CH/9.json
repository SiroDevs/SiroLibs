          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa diwu akwakwimba, anyanta akatuna waLevi, ashakaminaŋa mumatala atupeka, abudilaŋa nyidimu yi kwawu; muloŋa akoŋelaŋa mudimu wawu nimwaana niwufuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.33",
            "verseOrgIds": [
              "1CH.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa diwu anyanta akunavumu awankakulula waLevi malema; diwu ashakamini muYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.34",
            "verseOrgIds": [
              "1CH.9.34"
            ]
          }
        }
      ]
