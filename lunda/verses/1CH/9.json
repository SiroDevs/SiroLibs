  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "1CH 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela ejima ayisonekeli mwavwali kililuwu; talenu, anayisoneki mumukanda wawanyanta awaIsarela; aYuda ayitweli kuBabiloni muwukoli namuloŋa wawu waputiluwu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.1",
            "verseOrgIds": [
              "1CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asambilili kushakama mwaheteluwu munyikala yawu adiŋi niaIsarela, niatupristu, niaLevi, niaNetini. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.2",
            "verseOrgIds": [
              "1CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuYerusalema mwashakamini anyana kaYuda amu, nianyana kaBenjamini amu, nianyana kaEfweremi naManaseamu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.3",
            "verseOrgIds": [
              "1CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utayi mwana kaAmihudi, Amihudi mwana kaOmiri, Omirimwana kaImiri, Imiri mwana kaBani, wakudi anyana kaPerezi mwana kaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.4",
            "verseOrgIds": [
              "1CH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aku Shilo; wedi Asaya, ni anyanindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.5",
            "verseOrgIds": [
              "1CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akudi anyana kaZera; Yewuweli, niana kwawu, makulakaji atanu nadimu namakumi atanu nawana.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.6",
            "verseOrgIds": [
              "1CH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.6",
            "verseOrgIds": [
              "1CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akudi anyana kaBenjamini amayala; Salumwana kaMeshulami, Meshulami mwana kaHodaviya, Hodaviya, mwana kaHasenuwa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.7",
            "verseOrgIds": [
              "1CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "niIbineya mwana kaYerohami, niEla mwana kaUzi, Uzi mwana kaMikiri, niMeshulami mwana kaShefwatiya, Shefwatiya mwana kaRewuweli, Rewuweli mwana kaIbiniya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.8",
            "verseOrgIds": [
              "1CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "niana kwawu mwavwali kililuwu, makulakaji atanu nawana, namakumi atanu natanu nawumu. Amayala ejimawa diwuadiŋi anyanta akumavumu awankakulula jawu mwahita mavumu awankakulula jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.9",
            "verseOrgIds": [
              "1CH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akudi atupristu; Yedaya, niYehoyaribi, niYakini; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.10",
            "verseOrgIds": [
              "1CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "niAzariya mwana kaHilikiya, Hilikiya mwana kaMeshulami, Meshulami mwana kaZadoki, Zadoki mwana kaMerayoti, Merayoti mwana kaAhitubi diyimukwakuyula itala daNzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.11",
            "verseOrgIds": [
              "1CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "niAdaya mwana kaYerohami, Yerohami mwana kaPashuri, Pashuri mwana kaMalikiya, niMayasayi mwana kaAdiyeli, Adiyeli mwana kaYahezera, Yahezera mwana kaMeshulami, Meshulami mwana kaMeshilemiti, Meshilemiti mwana kaImeri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.12",
            "verseOrgIds": [
              "1CH.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "niana kwawu, anyanta akumavumu awankakulula jawu, ikombakaji, namakulakaji atanu nayedi, namakumi atanu nadimu; ayilobu akwaŋovu jakukoŋa mudimuwakwitala daNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.13",
            "verseOrgIds": [
              "1CH.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.13",
            "verseOrgIds": [
              "1CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akudi aLevi; Shemaya mwana kaHashubi, Hashubi mwana kaAzirikami, Azirikami mwana kaHashabiya, wakudi anyana kaMerari; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.14",
            "verseOrgIds": [
              "1CH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "niBakibakari, Hereshi, niGalali, niMataniya mwana kaMika, Mika mwana kaZikiri, Zikiri mwana kaAsafwi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.15",
            "verseOrgIds": [
              "1CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "niObadiya mwana kaShemaya, Shema yamwana kaGalali, Galali mwana kaYedutuni, niBerekiya mwana kaAsa, Asamwana kaElekana, washakamini munyikala yawaNetofwati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.16",
            "verseOrgIds": [
              "1CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.16",
            "verseOrgIds": [
              "1CH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakuhemba kuchisu; Shalumi, niAkubi, niTalimoni, niAhimani, niana kwawu; Shalumi diyi wadiŋi walema; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.17",
            "verseOrgIds": [
              "1CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wowu emanaŋa nihanukuchisu chamwanta chakumusela; diwu adiŋi akwakuhemba kuchisucha kuchilombu chawanyana kaLevi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.18",
            "verseOrgIds": [
              "1CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiShalumi mwana kaKore, Kore mwana kaEbiyasafwi, Ebiyasafwi mwana kaKora niana kwindi, wakwivu mudankakulula yindi, wowu aKora, atalilaŋa akwakukoŋa mudimu, akwaku hembakuyisuya kutabanaka; ankakulula jawu diwu adiŋi akwakutala chilombu chaYehova, wowu akwakuhemba kuwipililu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.19",
            "verseOrgIds": [
              "1CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaEleyazari Fwineha si diyi wayiyulilaŋa hamwaka, Yehova wadiŋi nayena. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.20",
            "verseOrgIds": [
              "1CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekariya mwana kaMeshelamiya diyi wadiŋi mukwakuhemba kuchisu chetenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.21",
            "verseOrgIds": [
              "1CH.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejimawa atondeluwu kwikala akwakuhemba muyisuashikili mumakulakaji ayedi nekumi nayedi. Wenawa ayisonekeli mwahitamuyachi wawu hanyikala, hanyikala; diwu akunjikiluwu kunyidimu yawukudi aDavidi namukwakumona Samweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.22",
            "verseOrgIds": [
              "1CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa ni anyanawu adi kombwelaŋa kumudimu wakutala kuyisu yakwitala daYehova, doditaladatabanaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.23",
            "verseOrgIds": [
              "1CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbavu jiwana mwadiŋi akwakuhemba kuyisu, nikumuselani kumujika, nikukabeta kakuchimunswa, nikukabeta kakuchidiilu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.24",
            "verseOrgIds": [
              "1CH.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.27",
            "verseOrgIds": [
              "1CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakwawu adiŋi namudimu wakuhemba yi nyidimu; ayiŋiŋilaŋa yakuchinda, ayiidishilaŋa nawa yakuchinda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.28",
            "verseOrgIds": [
              "1CH.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakwawu nawa ayikunjikili kuhemba yuma, niyuma yejima yamumalala, niwuŋa wakusalulula, nivinyu, nimanji, nilibona, ninyitondu yanunka mavumba amawahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.29",
            "verseOrgIds": [
              "1CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kawatupristu amakwaku nyitondu yamavumba amawahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.30",
            "verseOrgIds": [
              "1CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaLevi wumu Kora Shalumi, wadini namudimu wakutala yuma yochelanawu hayikaŋu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.31",
            "verseOrgIds": [
              "1CH.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 9:32"
          },
          "items": [
            {
              "text": "32",
