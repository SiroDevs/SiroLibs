          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seta chavweliyi Enoshi wanuŋiluku nyaka makulakaji atanunama kulakaji asatu nanyaka yitanu nayiyedi, wavweli anyana amayalana wambanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubomba nyaka yejima yaSeta yashi kili munyakama kulakaji atanu namakulakaji awana nanyaka ikumi nayiyedi; yofwanikufwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
            "verseOrgIds": [
              "GEN.5.8"
            ]
          }
        }
