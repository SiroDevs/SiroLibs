              "type": "text"
            }
          ]
        },
        {
          "text": "Seta washakamini nyaka nkulakaji nanyaka yitanu, hakuvwala Enoshi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
            ]
