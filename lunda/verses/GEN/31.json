  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "GEN 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watiyili mazu akuhoshawu anyana kaLabani amayala, hiyakwilanawu, Yakoba namutambuli tata yetu yuma yindi yejima; kuhetakwejimiku nachimweni kuyuma yatata yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.1",
            "verseOrgIds": [
              "GEN.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba watalili kumesu aLabani, hikwacheyi hohu, kumutalaŋa neyi chamutalilaŋa hakusambila nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.2",
            "verseOrgIds": [
              "GEN.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Yakoba nindi, Funtaku kwituŋa dawankakajeyi, kudi antaŋa jeyi, ami nakekala neyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.3",
            "verseOrgIds": [
              "GEN.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba watumishili nakutambika niRacheli niLeya, nindi enzi kumpata kwadiŋi yimuna yindi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.4",
            "verseOrgIds": [
              "GEN.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuyilanindi, Namoni kumesu atata yenu hikwacheŋi hohu, hantalaŋa neyichantalilaŋayi hakusambilaku; ilaŋa Nzambi yawankaka jami, nadiŋinindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.5",
            "verseOrgIds": [
              "GEN.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mweluka chinamukalakeleli tata yenu naŋovu jami jejima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.6",
            "verseOrgIds": [
              "GEN.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yenu nandimbi, nabalumuni wufwetu wami mapampa ikumi, ilaŋa Nzambi hanamwiteji kuŋila chatamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.7",
            "verseOrgIds": [
              "GEN.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi welili nindi, Amaasamaasa diwu wufwetu weyi, ayimuna ejima hiyakusema amaasamaasa. Neyiwelili nindi, Anyileji diwu wufwetu weyi, ayimuna ejima hiyakusema anyileji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.8",
            "verseOrgIds": [
              "GEN.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chochina Nzambi namutambuli tata yenu yimuna yindi, nayinyinkuwuami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.9",
            "verseOrgIds": [
              "GEN.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikilaŋawu yimuna mavumu awu, ami nafumbwilimesu ami, naloteli ayizamba awampembi akukandama komana wowuanyileji, niamaasamaasa, niafuwala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.10",
            "verseOrgIds": [
              "GEN.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu kaNzambi hakuŋila, nindi, Eyi Yakoba. Ami nami, Vude. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.11",
            "verseOrgIds": [
              "GEN.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Fumbulaku mesu eyi, wutali, ayizamba ejima awampembi akukandama wowu anyileji, niamaasamaasa, niafuwala. Muloŋa namoni yuma yejima yadi nakukwilayi Labani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.12",
            "verseOrgIds": [
              "GEN.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yami Nzambi wakuBeteli, kuwawayishili ilola manji, kuwadishiililumu; nyamukaku dinu, fumaku mwituŋidi, wufunti mwituŋa diwavwalikilili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.13",
            "verseOrgIds": [
              "GEN.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiRacheli niLeya amwakwili nawu, Ochu mwitala datata yetu mwashalanawa cheŋi hela yuma yetu yakutwanjaŋenawu, hela wuswana wetu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.14",
            "verseOrgIds": [
              "GEN.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natufuukuli dehi kwindi nindi tuyenyi hohu. Watulanda dehi kwindi. Wadya dehi nimali etu ejima to-o. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.15",
            "verseOrgIds": [
              "GEN.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maheta ejima anamutambuluwu tata kudi Nzambi, etu nawanyanetu. Dichi dinu mwejima mwanakulejiyi Nzambi, ilakumu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wanyamukili, washili ni anyanindi ni aŋodi jindi hanŋameli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.17",
            "verseOrgIds": [
              "GEN.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasendeli niyimuna yindi yejima, niyuma yindi yaheteliyi yejima, yoyimuna yaheteliyi, yoyapompesheliyi muPadani Arama, nindi akayikudi tata yindi Isaka, mwituŋa daKenani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.18",
            "verseOrgIds": [
              "GEN.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Labani wadiŋiwaya nakutewula nyikoku yindi mavuji, Racheli hakwiya nkishi jakupandajatata yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.19",
            "verseOrgIds": [
              "GEN.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wamuwombolokeli kaSiriya Labani; chatemukiliyi hamulejeli mwokuku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.20",
            "verseOrgIds": [
              "GEN.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu watemukili nayuma yindi yejima. Wanyamukili nakuzambuka Kaloŋa, watalishili mesu indi kumpidi yakuGileyadi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chisatu amulejeli Labani, nawu Yakoba natemuki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.22",
            "verseOrgIds": [
              "GEN.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasendeli antaŋa jindi, wamulondeli kwenda kwamafuku atanu nayedi, wamuweni kumpidi yakuGileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.23",
            "verseOrgIds": [
              "GEN.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaSiriya Labani waloteli nawufuku Nzambi wenjili kudi yena, wamwilili nindi, Babalaku wakenza kahosha Yakoba hela mwamuwahi hela mwatama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.24",
            "verseOrgIds": [
              "GEN.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.24",
            "verseOrgIds": [
              "GEN.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wamushintakesheli Yakoba. Kumuwana Yakoba nalemi dehi itenti dindi hampidi. NiLabani niantaŋa jindi alemeni matenti awumwomumpidi yakuGileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.25",
            "verseOrgIds": [
              "GEN.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani hakumwila Yakoba, nindi, Wuneliŋahi chiwunanwomboloki, hiwukutwala ni anyanami neyi kwiji ankoli akukwata kunjita? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.26",
            "verseOrgIds": [
              "GEN.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi eyi watemukililidi kumbadi, wunwombolokichakunwomboloka? nikunlejamu ami nehi, kulonda nikwendeshi chachiwahi nakucha, natumina, nandimba, natudada; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.27",
            "verseOrgIds": [
              "GEN.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikuŋitiya kupwepujola anyanami amayala nawambanda nehi. Ichi chiwuneli chawusupi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.28",
            "verseOrgIds": [
              "GEN.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kweti Ŋovu yakukukatisha; ilaŋa Nzambi yatata yeyi wankumikawufuku walelu, nindi, Babalaku wakenza kahosha Yakoba hela mwamuwahihela mwatama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.29",
            "verseOrgIds": [
              "GEN.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi mwalala neyi wakeŋa eli kuya nanochu chiwafwilili nankashi kumona kumukala watata yeyi, ndochu weyiladi nkishi jami? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.30",
            "verseOrgIds": [
              "GEN.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wamwakwili Labani, nindi, Ami natiyili woma; nelilinami, wakenza kantambula anyaneyi naŋovu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.31",
            "verseOrgIds": [
              "GEN.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowu wukukwata nankishi jeyi hakuhandaku; kwokunu kumesu awana kwetu talaku chachiwahi yuma yeyi yidi kudi ami, wusendi kweyi. Muloŋa Yakoba kwindi hachilukilinindi Racheli diyi nayiyuku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani weŋilili mwitenti daYakoba, nimwitenti daLeya, nimwitentida wanduŋu awambanda ayedi; ilaŋa hayimwenuku. Wedi kili mwitenti daLeya hakwijila mwitenti daRacheli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.33",
            "verseOrgIds": [
              "GEN.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Racheli wanona dehi nkishi jakupanda, wajisha dehi muyuma yakukasa nachu anŋameli, hakusha kamahu. Labani wakwatakwatili mwitenti mwejima, hajiniwenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.34",
            "verseOrgIds": [
              "GEN.31.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Racheli hakumwila tata yindi, nindi, Mwanta wami bayi azuwa chinakaŋanyi kunyamuka kumesu eyuku; muloŋa kashidikilu kawambanda kanwana dehi. Tata yindi watalatalili, ilaŋa nkishi hajimwenuku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakuzuwa hakumuhoshola Labani; Yakoba hakumwila Labani, nindi, Muloŋa wami wanka? Ninshidi yami yanka? Mwakawunlondaŋa nakutaza mwejimimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.36",
            "verseOrgIds": [
              "GEN.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakwatakwata dehi hayuma yami yejima, haduhu chuma chimu chakwitala deyi chiwunawani, tahindi? Chishi kunu ni kumesu antaŋa jami ni kumesu antaŋa jeyi, kulonda atusompeli muŋa etu ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.37",
            "verseOrgIds": [
              "GEN.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka makumi ayedi awa nashakami naneyi; hela nyikoku yeyi yawakaji hela ampembi jeyi jawakaji hiyanafwisni anyanawuku, niayizamba hinayidyi kwamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.38",
            "verseOrgIds": [
              "GEN.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa anatabuli kudi ayisuma hinakuleteleluku, nahipishilumu acheŋi ami aweni; hela wakwiya namwaanahela wakwiya nawufuku, ami yami wehwili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.39",
            "verseOrgIds": [
              "GEN.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chinadiŋi, nkanza yaKacheli namwa ana, chishika chambabili nawufuku, nitulu twanfumini mumesu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.40",
            "verseOrgIds": [
              "GEN.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaka makumi ayedi awa nashakami kumukalaweyi, nyaka ikumi nayiwana yoyinakala keleli anyaneyi, nyaka yitanunawumu yayimuna yeyi; eyi wunabalumuni wufwetu wami mapampaikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.41",
            "verseOrgIds": [
              "GEN.31.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chákubula Nzambi yatata yami, Nzambi yaAbarahama, niWomawa Isaka kwikala nanami, mutenowu kwaamu wunanleki makasakasa. Nzambi namoni yihupu yami ni kukabakana kunakabakani namakasami, hakukuhosha wufuku walelu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wa akwili hakumwila Yakoba, nindi, Awa ambanda anyanami, awa anyana niwena anyanami, ninoyu yimuna yimuna yami, yuma yejima yiwukumona yamami hohu; ochu lelu awa anyanami ninawa anyana anavwaluwu nukuyila ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.43",
            "verseOrgIds": [
              "GEN.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuyi dinu tutiyaŋani chitiyaŋenu, ami naneyi; kulonda chili chinsahu mukachi ketu ninami nineyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.44",
            "verseOrgIds": [
              "GEN.31.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.44",
            "verseOrgIds": [
              "GEN.31.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakunona ilola, hakudi imika diikali kaposhi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.45",
            "verseOrgIds": [
              "GEN.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 31:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakuyila antaŋa jindi, nindi, Kuŋulenu malola. Hiyakunona malola, hiyakuyilumbika mulumba uwi; hiyakudya kwokwenoku kumulumba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.46",
            "verseOrgIds": [
              "GEN.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wawutumbili ijina dawu, nindi, Yega Sahaduta. Ilaŋa Yakoba kwindi wawutumbili ijina dawu, nindi Galeyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.47",
            "verseOrgIds": [
              "GEN.31.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 31:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani nindi, Mulumbiwu wuneli lelu chinsahu mukachi ketu ninami nineyi. Dichi chawutenenaŋawu ijina dawu, nawu Galeyedi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.48",
            "verseOrgIds": [
              "GEN.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "niMizipa nawa, muloŋa nindi, Yehova atali hakachi ketu ninami nineyi, neyi tuchidi kwambuka, eyi kweŋi, ami kweŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.49",
            "verseOrgIds": [
              "GEN.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wakakabisha anyanami, indi neyiwakalunjikaku aŋodi jeyi acheŋi, ochu tudi namuntu wanyi, tala, Nzambidiyi chinsahu hakachi ketu ninami nineyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.50",
            "verseOrgIds": [
              "GEN.31.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.50",
            "verseOrgIds": [
              "GEN.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wamwilili Yakoba, nindi, Talaku mulumbiwu, talaku nikaposhiaka, inemiki hakachi ketu ninami nineyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.51",
            "verseOrgIds": [
              "GEN.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulumbiwu wikalichinsahu, nikaposhi aka kekali chinsahu, ami kwami hinakapandakanahadi mulumbiwu nakuya kudeyi, nineyi kweyi hiwakapandakana helahadi mulumbiwu hela hadi kaposhi aka nakwinza kudami kulonda kutamishaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.52",
            "verseOrgIds": [
              "GEN.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi yaAbarahama, Nzambi yaNahori, Nzambi yatata yawu, asompi mukachi ketu. Yakoba wasanyikili Woma watata yindi Isaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba waketwili ayimuna mumpidi, watambikili antaŋa jindi akadyi yakudya. Wena adiili yakudya, akamini wufuku wejima hampidi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.54",
            "verseOrgIds": [
              "GEN.31.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 31:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wahindukili ntetemena yayeni, wayipwepujoleli anyanindi, niamayala niambanda, wayi kiswilili nkisu. Labani hakuya nikuya, hakufunta kwindi kwekalayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.55",
            "verseOrgIds": [
              "GEN.31.55"
            ]
          }
        }
      ]
    }
  ],
