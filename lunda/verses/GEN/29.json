          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova chamweniyi Leya anamuheli, wamujikwili lusemu mwivumu; hakwila Racheli welili nshinta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leya yoba aba niivumu, yovwala nimwanaweyala, yonamutumba ijina dindi, nindi Rubeni; nindi, Nanochu chanataliyi Yehova yihuŋu yami; ichi dinu nfumwami wukunkeŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabaabilicheŋi ivumudi kwawu, wavweli mwana weyala; nindi, Nanochu chanatiyiyi Yehova chananheluwu, dichi chananyinkeliyi niyeniwu nawa; yonamutumba ijina dindi, nindi Simeyona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabaabili cheŋi ivumudikwawu, wavweli mwana weyala; nindi, Ichi dinu chinavwali, nfumwamiwu kudi kunda nanami, nanochu chinamuvweli anyanindi amayala asatu. Wanamutumbili ijina dindi, nindi Levi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabaabili cheŋi ivumu, wavwelimwana weyala; nindi, Ichi chinavwali ichi nukumusakilila Yehova. Dichicha namutumbililiyi ijina dindi, nindi Yuda. Yokumisha nikuvwala.",
          "type": "text",
