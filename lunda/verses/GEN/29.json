  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "GEN 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakuya munjila yindi, hakushika kwituŋa dawantu akumusela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.1",
            "verseOrgIds": [
              "GEN.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watalili kumpatoyu kwadiŋi ishima, kutala kunakami nyikanka yanyikoku yisatu; mwishimodu dimu mwanwishila ŋawu yimuna; niilola dajikiluwu kwishima dadiŋi deneni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.2",
            "verseOrgIds": [
              "GEN.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yimuna yejima yapompelaŋa kwenoku; akunkumwinaŋa ilola kwishima hiyakunwisha nyikoku, hiyakusha cheŋi ilola kwishima kudadiŋi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.3",
            "verseOrgIds": [
              "GEN.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.3",
            "verseOrgIds": [
              "GEN.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakuyila nindi, Enu ana kwami, mwafuma kudihi? Nawu, Etu twekala kuHarana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayilili nindi, Enu mwamwiluka Labani mwana kaNahori? Nawu, Twamwiluka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayilili nindi, Wáshakama chachiwahi? Nawu, Wáshakama chachiwahi. Mwanindi Racheli iwu wukwinziwunanyikoku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Itaŋwa dichidi mwiwulu, hanu dihu hapompeshaŋa wuyi muna wanyi; yinwishenu nyikoku muyi nakuyidiisha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.7",
            "verseOrgIds": [
              "GEN.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawu, Hitukutweshaku, chiŋa yimuna yejima ayipompesha, hiyakukunkumuna ilola kwishima; hitukuyinwisha ninyikoku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.8",
            "verseOrgIds": [
              "GEN.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.8",
            "verseOrgIds": [
              "GEN.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuchidi kuhosha nawu, Racheli hakwinza nanyikoku yatata yindi, muloŋa diyi wayibiŋilaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba chamweniyi Racheli mwana kamandu miyindi Labani, ninyikoku yamandumi yindi Labani, Yakoba hakuswila kwakwihi, hakukunkumuna ilola dadiŋi kwishima, hakunwishanyikoku yamandumi yindi Labani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakumupwepujola Racheli, hakutwala izu dindi hewulu nekumbu dakudila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wamulejeli Racheli nindi, Ami nimwiha watata yeyi, ni mwana kaRebeka. Niyena hakuya lufuchi nakumuleja tata yindi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chatiyayi Labani nsaŋu yaYakoba mwiha windi, hakuya lufuchi nakumukinkilila, hakumukumbata nakumupwepujola, hakumutwala nikwitaladindi. Wamulejeli Labani yumiyi yejima to-o. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.13",
            "verseOrgIds": [
              "GEN.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wamwililinindi, Chalala mwayedi wetu mwivumu detu. Washakamini nindi mwahitilikakweji.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani hakumwila Yakoba, nindi, Ochu chiwudi ntaŋa yami wunkalakeli chamukunkulwayi? Nleji dinu munakakufwetela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.15",
            "verseOrgIds": [
              "GEN.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wadi ijina wanyanindi awambanda ayedi; wamukulumpi ijina dindi Leya, wakansi ijina dindi Racheli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.16",
            "verseOrgIds": [
              "GEN.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesu aLeya adiŋi kukola chalala nehi, hakwila Racheli wadiŋi walubanji nikumujimba ni kumesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wakeŋa eli Racheli; welili nindi, Nukukukalakela nyidimu nyaka yitanu nayiyedi, wakanyinki mwaneyi wakansi Racheli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
              "GEN.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani ninai, Chachi wahini kwinkiyi eyi, ochu nimwinki iyala wacheŋi? Shakamaku nanami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.19",
            "verseOrgIds": [
              "GEN.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wamukalakeleli Racheli nyaka yitanu nayiyedi; wayimwenineyi himafuku antesha hohu nanochu chamukeŋeliyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba wamwilili Labani, nindi, Nyinki iŋodami, muloŋa mafuku ami anawani dehi, kulonda niiŋili mudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.21",
            "verseOrgIds": [
              "GEN.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wapompesheli amayala ejima akwenoku, watelekeli chawija. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.22",
            "verseOrgIds": [
              "GEN.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamelela watambwili mwanindi Leya, hakumutwala kudi yena; yena wepilili mudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.23",
            "verseOrgIds": [
              "GEN.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wamwinkeli mwanindi Leya nduŋu yindi wamumbanda, ijina dindi Zilipa, kulonda akeli nduŋu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.24",
            "verseOrgIds": [
              "GEN.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hantetemena kutala komanahi Leya; hakumwila Labani, nindi, Eyi wunaŋili ŋahi? Ami nakalakalaŋa kudeyi nami wunyinki Racheluku? Ndochu wunandimbilidi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.25",
            "verseOrgIds": [
              "GEN.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchi nka Labani nindi, Kwenakunu kusambila kusumbwisha kansi, mukulumpi kanda, hitwachilaŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.26",
            "verseOrgIds": [
              "GEN.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanishaku mulungu wayeniwu, nimukwawutukukwinkayi nanyidimu yiwakakalakala kudami nyaka yi kwawu yitanu nayiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.27",
            "verseOrgIds": [
              "GEN.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimu mweliliyi Yakoba, wawanishili mulungu wamumbanda; Labani wamwinkeli nimwanindi Racheli kulonda akeli Iŋodindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.28",
            "verseOrgIds": [
              "GEN.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani wamwinkeli mwanindi Racheli nduŋu yindi wamumbanda, ijina dindiBiliha, kulonda akeli nduŋu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.29",
            "verseOrgIds": [
              "GEN.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wepilili nimudi Racheli, Rachelidiyi akeŋeliyi nankashi, Leya hamukeŋeli chalalaku. Wakalakeli nyakayikwawu yitanu nayiyedi kudi yena.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        }
      ]
    },
    {
