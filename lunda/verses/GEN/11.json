          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arapashadi washakamini nyaka makumi asatu nanyaka yitanu, yovwala niShela; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
