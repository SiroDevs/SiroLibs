          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku aTera ashikili munyakama kulakaji ayedi nanyaka yitanu; Tera yofwa ni kufwa muHarana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
