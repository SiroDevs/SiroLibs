          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arapashadi chavweliyi Shela wanuŋiluku ninyakayikwawu makulakaji awana nanyaka yisatu, wavweli anyana amayalana wambanda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
