          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu nsaŋu jaShemi; Shemi wadiŋi wanyaka nkulakaji yovwalani Arapashadi, munahiti dehi nyaka yiyedi nahamwaka wadibaji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chavweliyi Shemi Arapashadi wanuŋiluku ninyaka yi kwawu makulakaji atanu, wavweli anyana amayala nawambanda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
    {
