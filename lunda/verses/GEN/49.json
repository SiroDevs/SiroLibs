          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwomwiyeŋu dekalamwiha daMakapela, deleala kwakwihi naMamiri, mwituŋa daKenani, dalandiliyi Abarahama hamu neha dakaHiti Efwenaoni kulonda kwila nfukayetu yakuheta, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
