              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "diku kwajiikiluwu niAbarahama naŋodindi Sara; dikukwajiikiluwu niIsaka naŋodindi Rebeka; diku najiikili Leya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
