          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wahosheli nindi, Twilenu muntu wudi neyi chitwekaletu, adifwani nanetu; akekali mwanta niwawanshi amukaluŋalwiji, niwawatujila ahaluzwizu, niwawanyama, niweseki dejima, niwayuma yazalala ŋayi kuzalala hamaseki yejima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        }
      ]
