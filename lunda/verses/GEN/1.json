        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wahosheli nindi, Hamaseki hediki yuma yikweti wumi, hanamutundu, hanamutundu, ni ayimuna, niyuma yazalalaŋa, nianyama amumpata hanamutundu, hanamutundu; chila nikwila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.24",
            "verseOrgIds": [
              "GEN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi welilini anyama amumpata hanamutundu, hanamutundu, ni ayimuna hanamutundu, hanamutundu, niyuma yejima yazalalaya hamaseki hanamutundu, hanamutundu. Nzambi wachimweni nindi chinawahi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.25",
            "verseOrgIds": [
              "GEN.1.25"
            ]
          }
        }
      ]
    },
    {
