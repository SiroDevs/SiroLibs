    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachi Nzambi waleŋeli nimawulu nimaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.1",
            "verseOrgIds": [
              "GEN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maseki adiŋi akadi nimwayawu, adiŋa amukunkulu; hewulu denyiŋi hadiŋi mwidima. Spiritu yaNzambi wadiŋi nakuhitahita hewulu dameji.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wahosheli nindi, Muchi. Mucha nikucha to-o. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.3",
            "verseOrgIds": [
              "GEN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wamweni kucha nindi kunawahi; Nzambi wa ambwili kucha namwidima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.4",
            "verseOrgIds": [
              "GEN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi watumbili kucha nindi, Ifuku, mwidima wawutumbili nindi, Wufuku. Kwila nimelela, kwila nintetemena, ifuku dimu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wahosheli nindi, Mukachi kameji mwikali luzwizu, lwambuli meji nameji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.6",
            "verseOrgIds": [
              "GEN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi welili luzwizu, wa ambwili meji, awa kwishinada luzwizu, awa kwiwulu daluzwizu; chila nikwila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.7",
            "verseOrgIds": [
              "GEN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi watumbili luzwizu ijina, nindi, Iwulu. Kwila nimelela, kwila nintetemena, ifuku damu chiyedi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.8",
            "verseOrgIds": [
              "GEN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.8",
            "verseOrgIds": [
              "GEN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wahosheli nindi, Meji adi mwishina dewulu apompi kwawukumu, hawuma hamwekani. Chila nikwila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.9",
            "verseOrgIds": [
              "GEN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hana hawuma Nzambi watu mbiluhu ijina, nindi, Maseki; kwapompeleli meji watumbiluku ijina, nindi, Majiya; Nzambi wamweni nindi chinawahi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wahoshelinindi, Hamaseki hameni nimatahu, niyisakola yasoŋaŋa mbutu, ninyi tondu yasoŋaŋa nyikabu yikweti nyisoka yayu, iwu namwawu, iwu namwawu, hamaseki; chila nikwila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.11",
            "verseOrgIds": [
              "GEN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamaseki hamena nimatahu niyi sako laya soŋaŋa mbutu, iyi namwayu, iyi namwayu, ninyitondu yasoŋaŋa nyikabu yikweti nyisoka yayu, iwu namwawu, iwu namwawu. Nzambi wayimweni nindi yayiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.12",
            "verseOrgIds": [
              "GEN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwila nimelela, kwila nintetemena, ifuku damu chisatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.13",
            "verseOrgIds": [
              "GEN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.13",
            "verseOrgIds": [
              "GEN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wahosheli nindi, Haluzwizu lwahewulu hekali yuma yakutoŋeka, kulonda kwambula nimwaana niwufuku; yakekali niyayinjikijilu, niyayilaaka, niyamafuku, niyanyaka; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.14",
            "verseOrgIds": [
              "GEN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakekali yaku toneka haluzwi zulwahewulu, yakatoŋeki hanu hamaseki to-o; chila nikwila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.15",
            "verseOrgIds": [
              "GEN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi welili yuma yamaneni yakutoŋeka yiyedi; chasweja kutoha chakekali mwanta wahamwaana, chakehaku chakekali mwanta wahawufuku; welilini tutumbwa nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.16",
            "verseOrgIds": [
              "GEN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi washili yumiyi haluzwizu lwahewulu kulonda ya katoŋe kaŋa chejeji hamaseki to-o, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.17",
            "verseOrgIds": [
              "GEN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakekali nawanta niwamwa anani wawufuku, nakwambula kucha namwidima. Nzambi wachimweni nindi chinawahi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.18",
            "verseOrgIds": [
              "GEN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwila nimelela, kwila nintetemena ifuku damu chiwana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wahosheli nindi, mumeji mukumini dakulumbama yendu yayuma yendaŋa, yikweti wumi, niatujila atuukapa hewulu damaseki hejima hahita luzwizu lwahewulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.20",
            "verseOrgIds": [
              "GEN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi waleŋeli anyama amaneni amumeji, niyuma yejima yendaŋa yikweti wumi, yalumbama mumeji, hanyitundu, hanyitundu, niatujila akweti mpuula, hanamutundu, hanamutundu. Nzambi wachimweni nindi chinawahi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.21",
            "verseOrgIds": [
              "GEN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wayikiswilili nkisu, nindi, Semununenu muvuleŋa, inzeshenu mumeji amumaji yani atujila avuleŋa hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.22",
            "verseOrgIds": [
              "GEN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwiia nimelela, kwila nintetemena, ifukuda muchitanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
