        },
        {
          "text": "Esawu chashikiliyi munyaka makumi awana wasumbwili niYudita mwana kakaHiti Beyeri, niBasemati mwana kakaHiti Eioni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
