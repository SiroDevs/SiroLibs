  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "GEN 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzala yaholokeli mwituŋa, bayi nzala yakusambila yaholokeli hamafuku hadiŋi Abarahamaku, yacheŋi. Isaka wayili kuGera kudi Abimeleki mwanta wawaFwilistinu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.1",
            "verseOrgIds": [
              "GEN.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wadi mwekesheli kudi yena, hakumwila nindi, Bayi wukunkumuka wuyi muEjipituku, shakama kumwituŋa dinakakuleja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.2",
            "verseOrgIds": [
              "GEN.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shakamaku tuhu mwituŋa dinu, ninami nakekalaneyi, nakakukoolekesha. Nineyi nianyaneyi nakayinka matuŋa waejima, nakakolesha nimukusanyika kunasanyikili natata yeyi Abarahama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakavulisha anyaneyi neyi tutumbwa twamwiwulu kuvula, anyaneyinakayinka matuŋawa ejima, kudi anyaneyi nyuza yahamaseki yejima yakawena kukukooleka, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.4",
            "verseOrgIds": [
              "GEN.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanochu chovwahililiyi Abarahama mwizu dami, nakuhemba munashiikili, nimunamulejeli, nimuyidika yami, nimunshimbomi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka washakamini muGerari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.6",
            "verseOrgIds": [
              "GEN.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enimbu amayala amwihwili yapodindi; nindi, Himuhelami; muloŋa watiyili woma wakuyila nindi, Hiŋodami; nindi, akenza kanjaha kudi enimbu hamujimba waRebeka; mulonwadiŋi walubanji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi nashakami dehi kwenoku hanalehi dehi, Abimeleki mwanta wawaFwilistinu watalilili munjanena hanzi, wamwenikomana Isaka hakuhema naŋodindi Rebeka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.8",
            "verseOrgIds": [
              "GEN.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wamutambi kili Isaka, wamwilili nindi, Komana chalala hiŋodeyi, indi eyi wahosheli ŋahineyi, Himuhelami? Isaka wamwilili nindi, Nelili nami nakenza kafwahamujimba windi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki nindi, Wunatwili ŋahi? Muntu wumuwadi kukama tuhu naŋodeyi, wadi kutukojeja muloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.10",
            "verseOrgIds": [
              "GEN.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wayikumikili antu ejima, nindi, Yowu wakakwata chikasa hadi iyaliwu, hela hadi Iŋodindi, chalala akamujaha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wadimini mwituŋa dina, wadiililumu mwaka yowumu mbutujakusemunwina nkulukaji. Yehova wamukoolekesheli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.12",
            "verseOrgIds": [
              "GEN.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenowu muntuwaswejeli kutoha, hakusweja nikusweja, yolema ni kulema chacheni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.13",
            "verseOrgIds": [
              "GEN.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waheteli ninyikanka yawampembi niyawanyikoku, ninyikanka yawaŋombi, ni aŋamba amavulu nankashi. AFwilistinu hiyakumutiyila ichima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.14",
            "verseOrgIds": [
              "GEN.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.14",
            "verseOrgIds": [
              "GEN.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu mashima ejima apundiluwu aŋamba jatata yindi, hadiŋiyitata yindi Abarahama, aFwilistinu ayijika dehi nakushikilamu maseki to-o. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wamwilili Isaka, nindi, Tufumi. Wunatubadiki etu nankashi ŋovu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.16",
            "verseOrgIds": [
              "GEN.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka hakufuma kwenoku, hakutuŋa yisolu muchine kinekicha muGerari, hakushakama kwokwenoku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.17",
            "verseOrgIds": [
              "GEN.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka walahulwili cheŋi mashima ameji apundiluwu hadiŋilaŋayi tata yindi Abarahama, muloŋa aFwilistinu ayishikilili hafwiliyi Abarahama, wayitumbili cheŋi majina mwomwayi tumbililiyi tata yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.18",
            "verseOrgIds": [
              "GEN.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋamba jaIsaka apundili muchinekineki, awenumu ishima dameji mwenda mufuuluka chakufuuluka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.19",
            "verseOrgIds": [
              "GEN.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atubiŋa akuGerari hiyakufwilaŋana natubiŋa twaIsaka, nawu, Mejietu. Ishimodu waditumbili ijina dadu, nindi Eseka, nanochu chazuŋiluwunindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apundili ishima di kwawu, nidena nawa adifwilaŋeneni. Hakuditumba niijina, nindi Sitina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafumini kwenoku, hakupunda niishima di kwawu. Denodu hiya difwilaŋenenuku. Hakudi tumba niijina daRehoboti, nindi, Ichi dinuYehova natushili mwakushakama, mwituŋa twakavulilamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafumini kwenoku, wayili kuBerisheba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.23",
            "verseOrgIds": [
              "GEN.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wadimwekesheli kudi yena wowena wufuku ovu, nindi, Yami Nzambi yatata yeyi Abarahama; bayi wutiyaŋa womaku, ami nidi naneyi, nakakukoolekeshapa, nakakuvulishila anyaneyi hamujimba waŋamba yami Abarahama. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.24",
            "verseOrgIds": [
              "GEN.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenoku watupililuku kameŋa, hakutambika niijina daYehova, hakulemenakuni itenti dindi. Kwenoku apamba jaIsaka apundiluku niishima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wafumini kuGerari hakuya kudi yena, niibwambu dindiAhuzati, niFwikoli wadiŋi mukulumpi wamashidikindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wayililinindi, Munenjilidi kudami, yenu mwanhelaku? Yenu mwanhapiluku? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka wena nawu, Twamweni chalala netu, Yehova wudi nindi; netu, Hekali kusanyika hakachi ketu, hakachi ketu naneyi, tutiyapani neyi chitiyaŋenu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.28",
            "verseOrgIds": [
              "GEN.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
