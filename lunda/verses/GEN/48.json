  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "GEN 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwahitili yumoyu amulejeli Yosefu, nawu, Tata yeyi wakata; hakuya nawanyanindi muyayedi wawu, aManase naEfweremi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.1",
            "verseOrgIds": [
              "GEN.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulejeli Yakoba, nawu, Mwaneyi Yosefu nenzi kudeyi. Yakoba hakudikolesha, hakushakama kwadiŋi yi kukadidi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.2",
            "verseOrgIds": [
              "GEN.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakoba hakuhosha kudi Yosefu, nindi, Nzambi Chinaweji wadi mwekesheli kudami kuLuzi mwituŋa daKenani, wankiswihli nkisu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.3",
            "verseOrgIds": [
              "GEN.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "waŋilili nindi, Ami nakakwilisha nsemi, wakasemununa, nakakuvulisha, hadeyi hakafuma nyichidi yayivulu; ituŋidi nakayinkadu anyaneyi akahiŋa mudeyi, dakekali dawu dakudihetela haya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.4",
            "verseOrgIds": [
              "GEN.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu awa anyaneyi ayedi awa, lwavweleli mwituŋa daEjipitu henohu kanda ninzi kudeyi muEjipituku, akwikala amami; aEfweremi na Manase akekala amami neyi chaduwu aRubeni naSimeyona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.5",
            "verseOrgIds": [
              "GEN.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila anyaneyi iwakalunjikaku akekala eyeyi; kuwuswana wawu akayitumbawowu majina awana kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.6",
            "verseOrgIds": [
              "GEN.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila ami kwami chinafumini kuPadani, Racheli wanfwilili mimesu, munjila mwituŋa daKenani, kwasheli kachinta mpunakushika kuEfwarata; namujiikili mwomuna munjila yaya kuEfwarata, diku kuBetelemi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.7",
            "verseOrgIds": [
              "GEN.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isarela chamweniyi anyana kaYosefu, welili nindi, Wenawa hiyanyintahi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.8",
            "verseOrgIds": [
              "GEN.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu wamwilili tata yindi, nindi, Diwu anyanami ananyinkiyi Nzambi kunu. Yena nindi, Yileti kunu kudami mwani, nukuyikiswilankisu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.9",
            "verseOrgIds": [
              "GEN.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesu aIsarela adiŋi ela dehi lwidi nakukula, hatwesheli kwindi kumonaku. Wayishikŋili kwakwihi, yena wayipwepujoleli nakuyikmbata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.10",
            "verseOrgIds": [
              "GEN.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isarela wamwilili Yosefu, nindi, Ami nehli nami hinamba kakumona cheŋi kumesuku, kwinza ichi Nzambi mwaka napiteji dehi kumona nianyaneyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.11",
            "verseOrgIds": [
              "GEN.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu wayiidishili mwadiŋuwu munkuma yindi, wabandaminini ihama dindi heseki. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.12",
            "verseOrgIds": [
              "GEN.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu wayikwatili mwayedi wawu, Efweremi muchikasa chindi chachidiilu hakumutwala kuchikasa chaIsarela chachimunswa, Manase muchikasa chindi chachimunswa hakumutwala kuchikasa chaIsarela chachidiilu, hakuyishikŋa kwakwihi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.13",
            "verseOrgIds": [
              "GEN.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isarela hakwolola chikasa chindi chachidiilu, hakuchinaŋika hanamutu waEfweremi, diyikansi, chikasa chindi chachimunswa hakunapika hanamutu waManase, wachililina kuchiluka kumuchima, muŋa Manase diyi wedi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.14",
            "verseOrgIds": [
              "GEN.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamukiswilili Yosefu nkisu, nindi, Nzambi kumesu indi kwendelaŋa atata jami niAbarahamani Isaka, diyi Nzambi wandiishapa nyaka yami yonsu yinahandina kushika nikwifuku dalelu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.15",
            "verseOrgIds": [
              "GEN.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "diyi kapelu wankuula kukutama kwejima, akiswili awa atwansi nkisu; akayitena nejina damami nimajina awatata jami Abarahama naIsaka; akasemununi hanu heseki akekali izaza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.16",
            "verseOrgIds": [
              "GEN.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamweniyi Yosefu tata yindi hakunaŋika chikasa chindi chachidiiluha namutu waEfweremi, watiyili kutama, wakwatili chikasa chatata yindikwiwulu nindi achifumishi kunamutu waEfweremi achinaŋiki hanamutu waManase. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.17",
            "verseOrgIds": [
              "GEN.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu hakumwila tata yindi, nindi, Bayi omuku tata, yeniwu diyi wedi, naŋikaku chikasa cheyi chachidiilu hanamutu windi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.18",
            "verseOrgIds": [
              "GEN.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yindi wakolamini, nindi, Neluki, mwanami, neluki; niyena nawawakela muchidi wawantu, niyena nawa wakela muneni, ilaŋa mwanyikindidiyi wakamubadika, ni anyanindi akela nyuza yayeni yayivulu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.19",
            "verseOrgIds": [
              "GEN.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayikiswilili nkisu dodena ifuku odu, nindi, Kudeyi kwokwakakiswilayi Isarela nkisu, nakwila nindi, Nzambi akwili wikah neyi chaduwu aEfweremi na Manase. Washili Efweremi kumbidi, Manase wamukumishili munyima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.20",
            "verseOrgIds": [
              "GEN.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isarela wamwilili Yosefu, nindi, Yami nukufwa onu; ilaŋa Nzambi wakekala nenu, wakayifuntisha cheŋi mwituŋa dawankaka jenu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.21",
            "verseOrgIds": [
              "GEN.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila ami nakwinki mukandu wumu wunabuli kwinkahu ana kweyi, diwu nayamukilia Amori nampoku yami yakabali, nawuta wami wamukunji.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.22",
            "verseOrgIds": [
              "GEN.48.22"
            ]
          }
        }
      ]
    }
  ],
