    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Sarayi iŋoda Abarama hamuvweleli anyanaku; yena wadi ijina nduŋu yindi wamumbanda, kaEjipitu, ijina dindi Haga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.1",
            "verseOrgIds": [
              "GEN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sarayi hakumwila Abarama, nindi, Tala dinu, Yehova nanlekeshi kuvwala anyana; epili mwani, mudi nduŋu yami, wamba kela nakamwena anyana kudiyena. Abarama wetejeli mwizu daSarayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi heliliyi Abarama nashakami dehi mwituŋa nyaka ikumi, iŋoda Abarama Sarayi hakunonanduŋu yindi kaEjipitu Haga, hakumwinka nfumwindi Abarama eli Iŋodindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.3",
            "verseOrgIds": [
              "GEN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakwijila mudi Haga, Haga hakuba aba niivumu. Chanamoni yinindi naba abi ivumu hakudiwula nkaka yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.4",
            "verseOrgIds": [
              "GEN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sarayi hakumwila abarama, nindi, Kutama kunamonami kushikeni hadeyi. Ami nakwinkelinduŋu yami muntulu yeyi; chanamoniyi nindi naba abi dehi ivumu, hanimona nawa cheŋi kulemaku; Yehova atusompeshi ninami nineyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.5",
            "verseOrgIds": [
              "GEN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarama hakumwila Sarayi, nindi, Hinduŋu yeyeyi aweni, kamwili mwonsu muwunakeŋi eyi aweni. Sarayi hakumukabisha, niyena yomute mukaniku mutemuka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.6",
            "verseOrgIds": [
              "GEN.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.6",
            "verseOrgIds": [
              "GEN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu kaYehova wamuweni kukaseloki kameji mwikuna, kwokukaselokikekala munjila yakuya kuShuri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.7",
            "verseOrgIds": [
              "GEN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwihula nindi, Eyi Haga, eyi nduŋu yaSarayi, wunafumi kudihi? Wudi nakuya kudihi? Yena nindi, Nidi nakutemuka nkaka yami Sarayi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.8",
            "verseOrgIds": [
              "GEN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu kaYehova hakumwila nindi, Funtaku kudi nkaka yeyi wakamwovwahilaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.9",
            "verseOrgIds": [
              "GEN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapelu kaYehova hakumwila nindi, Nakavulisha nankashi anyaneyi, akakaŋanya kuyichinda, nanochu chiyakavula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.10",
            "verseOrgIds": [
              "GEN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu kaYehova hakumwila nindi, Eyi wudi nevumu, wakavwala mwana weyala, wakanamutumba ijina dindineyi Ishimeli, nanochu chanatiyiyi Yehova chiwunamoni yihuŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena mukachi kawantu wakekala neyi chadiyi chimbulu wamumpata; yena wakazuŋa nawantu ejima, niantu ejima akazuŋa nayena; wakashaka makumesu awana kwindi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga wanamutumbili Yehova wahosheliyi nindi ijina, nindi yeyi Nzambi Wamonaŋa; nindi, Hela kunu hinamoniyena wanmonaŋaku, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chatumbiluwu ishima dina ijina, nawu Ishima daWahandaŋa Wanimonaŋa; dekala hakachi kaKadeshi naBeredi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga wamuvweleli Abarama mwana weyala; Abarama wanamutumbili mwanindi wavweliyi Haga ijina dindi, nindi Ishimeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka wamuvweleluwu Abarama Ishimeli kudi Haga, Abarama washi kili munya kamakumi atanu nasatu nanyaka yitanu nawumu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
        }
      ]
    }
  ],
