          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chinakakama tulu hamu nawatata jami, wakansendapa nakunfumisha mwituŋa daEjipitu, wakantwali nakunjiika kwayijiikawu wena. Yena nindi, Nakela mwomu wunahoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
