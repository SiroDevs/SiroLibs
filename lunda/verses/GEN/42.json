          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenowu muntu neli mulopu wetuŋa, watwilili nindi, Tiyenu munukwilukila nami enu muyantu alala, shiyenuhu mwinenu wumu kudami, twalilenu antaŋa jenu yakudya, adi nanzala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.33",
            "verseOrgIds": [
              "GEN.42.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
