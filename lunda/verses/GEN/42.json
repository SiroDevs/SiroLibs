              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "twekala amayala ikumi nayedi, ivumu detu dimu, anyana katata wumu; netu, wumu wachachaŋana dehi, wakabinda lelu wudi kwatata yetu mwituŋa daKenani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.32",
            "verseOrgIds": [
              "GEN.42.32"
            ]
          }
        },
        {
          "name": "verse",
