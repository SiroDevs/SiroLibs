          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyi mwakanleteli kabinda kenu; henaha dihu namba kelukila nami enu himuyakwakwendesha ituŋaku, nami komana muyantu alala; chochina nakayilubwila mana kwenu, mwakalandojoli mwituŋa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        }
