    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu wadinatoleli hamesu atata yindi, hakudilila hadi yena, hakumupwepujola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.1",
            "verseOrgIds": [
              "GEN.50.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu walejeli ambuŋindi aŋaŋa, nindi, Muumishenu tata yami; aŋaŋa amuumishili Isarela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
              "GEN.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuwanishilili mafuku makumi awana, muloŋa dimu yawanishilaŋawu mafuku akuumisha nachu. AEjipitu amudilili mafuku makumi atanu nayedi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu mafuku akudila anahiti dehi, Yosefu hakuhosha nawantaŋa jaFwaro, nindi, Neyi munantoŋuhu, hoshenu mwani naFwaro, nenu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, Tata yami wansanyikishili chakunsanyikisha, nindi, Yami nukufwa onu, wakanjiika mwomwŋamu dami dinadiŋundilili mwituŋa daKenani. Dichi dinu aŋiteji mwani, niyi nakajiiki tata yami, nakenza cheŋi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwaro nindi, Yaŋa, kajiiki tata yeyi, mwomwakusanyikishihyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu wayili akajiiki tata yindi; ambuŋa Fwaro ejima ayili nindi, niakulumpi ahamukala windi, niakulumpi amwituŋa daEjipitu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.7",
            "verseOrgIds": [
              "GEN.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "niantaŋa jaYosefu ejima, niana kwindi, niantaŋa jatata yindi, ashiyili mwituŋa daGosheni anyanawu anyanya hohu, nimpembi jawu, ninyikoku yawu, niŋombi jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.8",
            "verseOrgIds": [
              "GEN.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayili hamu nindi nimakálu, niakwakwendela hatuwalu, hadiŋi chendu chacheni cheneni cheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.9",
            "verseOrgIds": [
              "GEN.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chashikiluwu kwakuhulilatidiku kuAtadi, kwishinadi daYodana, hiyakudililaku makumbu aweni asweja nankashi; wamudilili tata yindi mafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awenawu ashakama mwituŋa, wowu aKenani, chamwenuwu chadililuwu mwakuhulilatidiku muAtadi, elili nawu, Kudila kwakudilawu aEjipitu o kukala! Dichi atumbiluku ijina, nawu KuAbeli Mizirayimi, kwishinadi daYodana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanindi amwilili mwomwayilejeliyi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.12",
            "verseOrgIds": [
              "GEN.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "anyanindi amusendeli nakumutwala mwituŋa daKenani, amujiikili mwiyeŋu damwiha daMakapela, dalandiliyi Abarahama hamu neha dakaHiti Efwenaoni kulonda kwikalikunfuka yawu yakuheta kwakwihi naMamiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu chajiikiliyi tata yindi wafuntili cheŋi kuEjipitu, niyena nianakwindi, niantu ejima ayiliyi nawu nakujiika tata yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana kwaYosefu chamwenuwu tata yawu nafwi dehi, hivakwila nawu, Kwiji Yosefu wukutuhela nakutukoŋa chatama nachina chitwamutamishili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.15",
            "verseOrgIds": [
              "GEN.50.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atemesheli kaŋanda kudi Yosefu, nawu, Tata yeyi hadiŋiyi wuchidimumi, watulejeli nindi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.16",
            "verseOrgIds": [
              "GEN.50.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakamwila Yosefu, nenu, Anakenaku mwani, muloŋa wawana kweyi, ninshidi yawu, muloŋa akukoŋeli chatama; ichidinu mwani, anakeni muloŋa wawambuŋa Nzambi yatata yeyi. Chahosheluwu nindi Yosefu hakudila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.17",
            "verseOrgIds": [
              "GEN.50.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana kwindi ayili nakudinata hamasekikumesu indi; nawu, Etu ambuŋeyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.18",
            "verseOrgIds": [
              "GEN.50.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.18",
            "verseOrgIds": [
              "GEN.50.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu wayilili nindi Bayi mutiyaŋa womaku, ochu ami yami Nzambi? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.19",
            "verseOrgIds": [
              "GEN.50.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa enu mwatoŋojokeli kuŋila chatama, hakwinza Nzambi watoŋojokeli kwila chachiwahi, nindi ahandishi antu amavulu neyi chitunamoni lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.20",
            "verseOrgIds": [
              "GEN.50.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu bayi mutiyaŋa womaku, nukuyidiishaŋa ninenu ni anyanenu anyanya. Wayikundejeli nakuhoshanawu chachiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.21",
            "verseOrgIds": [
              "GEN.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.21",
            "verseOrgIds": [
              "GEN.50.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 50:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu washakamini muEjipitu niyena niantaŋa jatata yindi; Yosefu wahandili nyaka nkulakaji nanyaka ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.22",
            "verseOrgIds": [
              "GEN.50.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 50:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu wamweni anyana kaEfweremi, nianyana kamwizukulu windi; nianyana kaMakiri mwana kaManase niwena ayileleli kudi Yosefu hanyendu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.23",
            "verseOrgIds": [
              "GEN.50.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 50:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu wayililiana kwindi, nindi, Ami hinukufwa; ilaŋa Nzambi chalala wakenza nakuyitala, wamba kayifumisha mwituŋa dinakuyitwala mwituŋa dashiikiliyi. Abarahama naIsaka naYakoba nakusanyika chakusanyika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.24",
            "verseOrgIds": [
              "GEN.50.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 50:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu Kutach wayilili anyana kaIsarela, nindi, Sanyikenu. Nindi, Nzambi chalala wakenza nakuyitala, ninenu mwakasenda mafwahami nakuyifumisha kunu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.25",
            "verseOrgIds": [
              "GEN.50.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 50:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Yosefu wafwili, washi kili munyaka nkulakaji nanyaka ikumi. Amuumishili, amushili muchimbaŋu chakujiikila mufu muEjipitu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.26",
            "verseOrgIds": [
              "GEN.50.26"
            ]
          }
        }
      ]
    }
  ],
