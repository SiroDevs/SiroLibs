            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu aPawulu naSilasi niTimotewu tudi nakuyisonekela mukanda, enu akwachipompelu chawaTesalonika chekala mudi Nzambi, Tata yetu, nimudi Mwanta Yesu Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luwi lwikali nanenu nikuwunda kwakufuma kudi Nzambi, yowu Tata, nikudi Mwanta Yesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.2",
            "verseOrgIds": [
              "2TH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
