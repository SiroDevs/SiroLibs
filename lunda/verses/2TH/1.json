          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyi nsaŋu yakumwekesha nachu kusompesha kwaNzambi kwaloŋa, kulonda ayimonaŋa kutelela wanta waNzambi wumwamwenaŋa yihuŋu.",
          "type": "text",
