          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu ana kwetu, tunatiyi kuwaha kuyisakilila kudi Nzambi mafuku ejima; chinateli nankashi, muloŋa kukuhwelela kwenu hikukuya nakukula nankashi, nikukeŋaŋana kwenu hikukuya nakuvula. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.3",
            "verseOrgIds": [
              "2TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi etu aweni twadisambaŋa hansaŋu yenwenu muyipompelu yaNzambi, nakutatakena kwenu, nikukuhwelela kwenu kumwakuhwelelaŋa mumakabishenu ejima, nimulukadi lumwamonaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.4",
            "verseOrgIds": [
              "2TH.1.4"
            ]
          }
        }
      ]
    },
