          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa itaŋwodu hela mpinji oyu kwosi wayilukaku, chalala hela aŋelu amwiwulu hela Mwana, chiŋa Tata. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalenu, tonenu, lombenu; Muloŋa himuneluki mpinji oyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.33",
            "verseOrgIds": [
              "MRK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chidi neyi muntu nayi njila yayilehi kumpata yacheŋi, nashiyi itala dindi, nenki anduŋu jindi wuchakala, ninyidimu yawu, iwu nawindi iwu nawindi, naleji mukwakuhemba chisu nindi akatoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.34",
            "verseOrgIds": [
              "MRK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tonenu; Muloŋa himuneluki hakenza nkaka yetalaku, kwiji melela, kwiji mukachi kawufuku, kwiji hedikilaŋa ikombu, kwiji budidi; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.35",
            "verseOrgIds": [
              "MRK.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuchina kwila chakenzayi chakukasumwisha hakayiwana namutulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.36",
            "verseOrgIds": [
              "MRK.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinukuyilenu, nayili niantu ejima, nami, Tonenu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.37",
            "verseOrgIds": [
              "MRK.13.37"
            ]
          }
        }
