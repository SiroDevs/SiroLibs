            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudya mbiji yikweti mashi chinjila; kusansa nyiseŋu chinjila, kuhoŋanatutumbwa chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
