          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kukwinza muntu wukweti namutu wanvu wakanyamukaŋa, wakalemeshaŋapala kumesu indi, wakamwakamaŋa Nzambi yeyi; yami Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
