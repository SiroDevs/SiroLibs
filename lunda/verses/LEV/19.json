          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wakashakama namweni mwituŋa denu, kumwila chatama chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.33",
            "verseOrgIds": [
              "LEV.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyi mwashakama nindi akekalaŋi neyi mwcnimbu wenu, wakamukeŋaŋaneyi chiwadikeŋa eyi aweni, muloŋa ninenu mwadini enyi mwituŋa daEjipitu; yami Yehova Nzambi yenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        }
      ]
