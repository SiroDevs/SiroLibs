            "sid": "LEV 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubalumuka nakuya kudi azakukaŋa akishi hela kudi atutepa chinjila; kuyikeŋakeŋa kulonda muditamishi nawu chinjila; yami Yehova Nzambiyenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        }
