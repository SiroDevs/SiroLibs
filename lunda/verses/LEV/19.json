          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutamisha mwaneyi wamumbanda wumuhani muwuvumbi chinjila; ituŋa dakenda kaholokela muwuvumbi, hidakenzala nayatama mbe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
            "verseOrgIds": [
              "LEV.19.29"
            ]
          }
        }
