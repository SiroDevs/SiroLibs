          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhepesha wuŋaji hela mukweseka kuleha, hela mukupezelesha, helamukweseka wuna nayuma yidochu, chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipa mwakekalaŋa nayesekelu yaŋa, nipezu jaloŋa, niyimpaya yakweseka mwaŋa, ninswahajakweseka mwaloŋ; yami Yehova Nzambi yenu nayifumishili mwituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakashapa muchima kuyidika yami yejima, nakuwuŋajiwami wejima kulonda kwilamu; yami Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
