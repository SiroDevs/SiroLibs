    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi muntu navulumuni chakutiya chakusanyikayi mukwawu, neli chinsahu chakumona hela chakwiluka, neyi yena kushimunamu nehi, wakakoola kuluwa kwindi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela neyi muntu nakwati chikasa hachumachamajilu, hela hakanyama kamafumbu wamajilu fwafwa dehi, helahakanyama kanyikonu wamajilufwafwa dehi, hela kanyama kakayilaŋa wamajilu fwafwa dehi, yena kuchiluka nehi, niyena hakwikala wamajilu, natanyi dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela neyi wakakwata hayuma yamuntu yamajilu, yamajilu yonsu yadijilolaŋayi nachu muntu, yena kuchiluka nehi, wakatanya hakachilukayi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela neyi muntu wakasanyika lufuchi nakanwa kindi, nindieli hela chuma chatama hela chuma chachiwahi, chejima chakahoshayi muntu lufuchi nakusanyika, yena kuchiluka nehi, hakachilukayi wakatanyahachuma chimu chayumiyi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "chakelayi natanyi dehi hachuma chimu chayumiyi aketŋi mwanavulumuniyi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaleti kudi Yehova himulambu windi wakutanya wanshidi yindi yanavulumuniyi, mukaji wakwiyinda, helamukoku hela mpembi, wamulambu wahanshidi; kapristu akamwilili yakumubuta nachu hansaŋu yanshidi yindi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi haheta chakuhana mukokuku, akaleti kudi Yehova himulambu windi wakutanya nanochu chanavulumuniyi, tutela tuyedi, hela anyanakatupompa ayedi, kamu kahimulambu wahanshidi, kakwawu kahimulambu wakushita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatu leti kudi kapristu, yena kapristu akasambili kulambulaka himulambu wahanshidi, akakanyotomoni namutu waku wufumi hanshiŋuyaku, ilaŋa kukabalula nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mashi ahimulambu wahanshidi akayisampwili kumbaŋu yakameŋa; mashi anashali akayi kamwili kwishina dakameŋa; hihimulambu wahanshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamuchiyedi akeli nachu himulambu wakushita mwomwelilaŋawu; kapristu akamwilili yakumubuta nachu hansaŋu yanshidiyindi yanavulumuniyi, akamwanakena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi haheta chakuhana hela tutela tuyedi, hela anyana katupompa ayeduku, akaleti himulambu windi nanochu chanavulumuniyi, webaŋudawuŋa walembuluka wamulambu wahanshidi; bayi akasha hoku manjuku, hela kushahu libona nehi; muloŋa hihimulambu wahanshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akawuleti kudi kapristu, kapristu akazomonuhu wuŋa windi wakwanuka nachu chikasato-o, akawushiti hakameŋa bwi-i hanyilambu yakumwilila Yehova nakesi; hihimulambu wahanshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akamwilili yakumubuta nachunansaŋu yanshidi yindi yanavulumuniyi yayumiyi, akamwanakena; wakashalahuwakekali wakapristu neyi chelaŋawu nahimulambu wawuŋa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
