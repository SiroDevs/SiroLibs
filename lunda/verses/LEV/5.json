          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Neyi muntu wakamotoka nshimbi, neyi wakavulumuna chakuluwukila chuma chaYehova chajila chimu, akaleti kudi Yehova himulambu windi wakutanya, chizamba chamukoku chamwiyinda wakadi hataminayi, ndandu yindi yakashiki mwomuwakamwesekela musilivayajishekeli jakweseka mulushekeli lwakumalala, wamulambu wakutanya; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akafuti chuma chajila chanaputoliyi, akashuku nichibalu chamuchitanu, akamwinki kapristu, kapristu akamwilili yakumubuta nachu nachizamba chamulambu wakutanya, kamwanakena.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
