  "verseCount": 57,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LEV 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tiya lushimbi lwamukwambumba lwamwifuku dakumutookesha. Nawu, Akamuleti kudikapristu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akafumi muchilombu; kapristu akatali, neyi wakamonamusoŋu wambumba wunamufumi dehi mukwambumba, wunakusuki, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akayileji kumukwatila akukeŋa kutookeshawu atujila amomi iyadyaŋawu ayedi, akanoni nimutondu musida, niwanda wuchinana, ninamutuntamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akayileji kujahila kajila wumu mwinuŋu yewumba, hewulu dameji adi nakuhita; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila kajila wamumi akamunoni, nimutondu musida, niwanda wuchinana, ninamutuntamu, akayijimiki hamunakajila wamumi mumashi akajila anajahiluwu hewulu dameji adi nakuhita; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "owu akukeŋa kutookeshawu mbumba akamusampwili mapampa katanuna kayedi, akamuteni nindi natooki, kajila wamumi akamuumbuku akayituhu mumpata. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu akukeŋa kutookeshawu akakosi mahinindi, akatewulinsuki jindi jejima, akaweli mumeji, akatooki; neyi neli dehi chochochuakeŋili muchilombu, ilaŋa akakamaŋa hanzi yetenti dindi mafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chitanu nachiyedi akatewuli nsuki jindi jejimakunamutu windi, niwevu windi, ninkuku jindi, akatewuli kafwampi joji nsukŋindi jejima; akakosi mahinindi, akaweli mumeji, akatooki.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chitanu nachisatu akakwati anyana kanyikoku ayizamba akadi hataminawu ayedi, ni mwana kamukoku wamukaji wamwaka wumuwakadi hataminayi wumu, akanoni mabaŋu asatu awuŋa walembulukawamulambu wawuŋa, wakubomba namanji, nichipunda chamanji chimu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "owu kapristu wakamutookesha akamushi owu muntu akukeŋa kutookeshawu, niyumoyu, kuchisu chetenti dakubulakena, kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akanoni mwana kamukoku wachizamba wumu, akahimulambu lihihimulambu wakutanya, nichipunda chamanji, akayinyinkeshi kumesu aYehova, hihimulambu wakunyinkesha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kamukoku wachizamba akamujahili kwajahilaŋawu himulambu wahanshidi nihimulambu wakushita, mwomu mumalala; muloria neyi chiwuneli himulambu wahanshidi wambalawakapristu, dichi chiwuneli nihimulambu wakutanya, wasweja kujila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamashi ahimulambu wakutanya kapristu akanonuhu, akamwomoni owuakukeŋa kutookeshawu kunsa yetu dindi dachidiilu, nikumunu wedimbanu wakuchikasa chindi chachidiilu, nikumunu wedimbanu wakumwendu windi wachidiilu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akanoni manji muchipunda, akahuŋunwini muchikasa chindi yomweni chachimunswa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akatumpiki munuwindi wachidiilu mumanji adi muchikasa chindi chachimunswa, akasampulimanji namunu windi kumesu aYehova mapampa katanu nakayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamanji akushalahu muchikasa chindi kapristu akanonuhu, akamwo monuwuowu akukeŋa kutookeshawu kunsa yetu dindi dachidiilu, nikumunu wedimbanu wakuchikasa chindi chachidiilu, nikumunu wedimbanu wakumwendu windi wachidiilu, hohamashi ahimulambu wakutanya; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "manjiadi muchikasa chakapristu anashaluhu akahuŋununi hanamutu wanowu akukeŋa kutookeshawu; kapristu akamwilili yakumubuta nachu kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akalambuli himulambu wahanshidi, akamwilili yakumubuta nachu owu akukeŋa kutookeshawu nanochu hadiŋiyi wamajilu; nkumininaku hakajaha nihimulambu wakushita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akalambuli nimulambu wakushita, nihimulambu wawuŋa hakameŋa; kapristu akamwilili yakumubuta nachu, akatooki.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi hikazweŋi, nakaŋanyi yuma yejimoyu, akakumini dakukwata kwamwana kamukoku wachizamba, wamulambu wakutanya wakunyinkesha, kulonda kumwilila yakumubuta nachu, akanoni niibaŋu dimudawuŋa walembuluka wakubomba namanji, wamulambu wawuŋa, nichipundachamanji; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "akakwati nitutela tuyedi, hela anyana katupompa ayedi, wowu anamoniyi wowu, wumu wamulambu wahanshidi, mukwawu wamulambu wakushita. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damu chitanu nachisatu akaleti yumoyu kudikapristu, kumesu aYehova, kuchisu chetenti dakubulakena, kulondakumutookesha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akanoni mwana kamukoku wamulambu wakutanya, nichipunda chamanji, kapristu akayinyinkeshi hihimulambu wakunyinkesha kumesu aYehova; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "akajahi ni mwana kamukoku wamulambu wakutanya, hamashi ahimulambu wakutanya kapristu akanonuhu, akamwomonuwu owu akukeŋa kutookeshawu kunsa yetu dindi dachidiilu, nikumunu wedimbanu wakuchikasa chindi chachidiilu, nikumunu wedimbanu wakumwendu windi wachidiilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akahuŋunwini manji muchikasa chindi yomweni chachimunswa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "manji adi muchikasachindi chachimunswa kapristu akanonuhu antesha, akayisampuli namunuwindi wakuchidiilu kumesu aYehova mapampa katanu nakayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akanonuhu manji amakwawu adi muchikasa chindi, akamwomonuwu owu akukeŋa kutookeshawu kunsa yetu dindi dachidiilu, nikumunu wedimbanu wakuchikasa chindi chachidiilu, nikumunu wedimbanu wakumwendu windi wachidiilu, hohamashi ahimulambu wakutanya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manji adi muchikasa chakapristu anashaluhu akahuŋununi hanamutu wanowu akukeŋa kutookeshawu, kulonda kumwilila yakumubuta nachu kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akalambuli katela kamu, hela mwana kakapompa wumu, yowu anamoni yiyowu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "wumu wamulambu wahanshidi, mukwawu wamulambu wakushita, wowu anamoniyi wowu, nihimulambu wawuŋa hamu, kapristu akamwilili yakumubuta nachu owu akukeŋa kutookeshawu kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwenilu dilu lushimbi lwamukwamusoŋu wambumba nakaŋanyi yakuditookesha nachu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi naAroni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Chimwakashika mwituŋa daKenani dinukuyinka mwakadiheti denu, neyi nakasha musoŋu wambumbamwitala damwituŋa denu dimwakaheta, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34",
            "verseOrgIds": [
              "LEV.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "yenowu wukweti itala akenzinakumuleja kapristu, nindi, Namoni mwitala mudi neyi musoŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.35",
            "verseOrgIds": [
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hachi diyi kapristu kanda eŋili nakutala musoŋu, kapristu akayileji kwidisha yumayidi mwitala, kulonda yuma yejima yidi mwitala yakabuli majilu; nkumininaku kapristu hakeŋila nakutala mwitala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatali musoŋu, neyi wakamonamusoŋu wunapokoli pokoli mumbapu yetala, iku neyi meji amatamba, iku neyi kuchinana, nimusoŋu wunamwekani neyi wuneŋili mumbaŋu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akediki mwitala, akayi kuchisu chetala, akenzeli itala mwakahiti mafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akenzi cheŋi hefuku damuchitanu nachiyedi, akatali. Neyi wakamona musopu wudi nakuya nakuswilamumbaŋu jetala, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akayileji nindi, Fumishenumu malola akwetimusoŋu, akayinatili kunsa yamukala kumajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayileji akakooli italamukachi kwi-ndo, nimaseki anakooluwu akayimwaŋili kunsa yamukala kumajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanoni malola acheŋi, akayihiŋishi mwadiŋi malola amakwawu; akanoni maseki acheŋi, akasoti itala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakela nafumishi dehi malola, nakooli dehi itala, nadisoti dehi, kutala musoŋu hiwukwinza cheŋi nakwidika mwitala, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapristu akeŋilumu nakutala, neyi wakamona musoŋu wunayi nakuswila mwitala, himbumba yasumana mwitala; damajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odu itala akadisandi, nimalola adu, ninyitondu yadu, nimaseki etala ejima, akayifumishi hamukala, akayitwali kumajilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakeŋa ila mwitala hakela anadenzeli dehi, akekali wamajilu hohu nikumelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuntu wakakama mwitalodu akakosi mahinindi; ninowu wakadiila mwitalodu akakosi mahinindi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakela itala anadisoti dehi, nikapristu nenzi dehi nakuditala, neyinamoni musoŋu hiwunayi nakuswila mwitalaku, kapristu akateni itala nindidinatooki dehi, nanochu chimunakusuki dehi musoŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakwati tujilatuyedi, nimutondu musida, niwanda wuchinana, ninamutuntamu, kulondakutookesha nachu itala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kajila kamu akakajahili mwinuŋu yewumba, hewulu dameji adi nakuhita; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanoni mutondu musida, ninamutuntamu, niwanda wuchinana, nikajila kakomi, akayijimiki mumashi akajila kanajahuwu, nimumeji adi nakuhita, akasampuli itala mapampa katanu nakayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatookeshi itala namashi akajila, nameji adi nakuhita, nakajila kakomi, namutondu musida, nanamutuntamu, nawanda wuchinana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kajila kakomi akakombuku, kakafumi hamukala kakayi mumpata; dimu mwakelilayiyakubuta nachu itala; dakatooka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
    },
    {
