          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwenilu dilu lushimbi lwamusoŋu wambumba muwahitila mwejima, nilweyaji, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "nilwambumba yehina dakuvwala, nilwetala; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "nilwakunana, nilwachibata, nilwebeŋa ditokoloka, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 14:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda kuyileja nihadi majilu nihanatooki; dilu lushimbi lwambumba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
            "verseOrgIds": [
              "LEV.14.57"
            ]
          }
        }
