              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi muntu nakeŋikukuula chuma chayuma yindi yamwikumi, kundandu yachu akalunjikuku chibalu chamuchitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
