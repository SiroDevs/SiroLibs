      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi himulambu windi wakekala wachimuna chakuketula chanyila mbuya kuwunda, neyi wukulambula wakwitaŋa, hela nombi weyala, helawamukaji, akalambuli kumesu aYehova wakadi hataminayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.1",
            "verseOrgIds": [
              "LEV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akana ŋiki chikasa chindi hanamutu wamulambu windi, akawujahili kuchisu chetenti dakubulakena; atupristu anyana kaAroni akasampuli mashi hakameŋa kwi-ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
              "LEV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchimuna chakuketula chanyilambu yakuwunda akalambuluku himulambu wakumwilila Yehova nakesi, wowu manji ajikaŋa hayumaya mwivumu, namanji adi kunyijipwa ejima, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninshiya mujiyedi, nimanjiaduku, wowu ekala kumasweswa, nichibuta muchima, akayaluli hamunanshiya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.4",
            "verseOrgIds": [
              "LEV.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaAroni akayishiti hakameŋa bwi-i hewulu dahimulambu wakushita wudi hanchawa jidi hakesi, hihimulambu wakumwilila Yehova nakesi, wevumba dadiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.5",
            "verseOrgIds": [
              "LEV.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.5",
            "verseOrgIds": [
              "LEV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi himulambu windi wakalambulayi Yehova wachimuna chakuketula chanyilambu yakuwunda wukwi kala wakwiyinda, hela chizamba, helamukaji, akaleti wakadi hataminayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wakalambula himulambu windi wamwana kamukoku akamulambwili kumesu aYehova; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanaŋiki chi kasachindi hanamutu wamulambu windi, akawujahili kwokwitenti dakubulakena; anyana kaAroni akasampuli mashi awu hakameŋa kwi-ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchimuna chakuketula chanyilambu yakuwunda akalambuluku himulambu waYehova wakwila nakesi, wowu manji awu, nimukila wamanji wejima, akawuketwili kwakwihi namoŋu; nimanji ajikaŋa hayuma yamwivumu, nimanji akunyijiŋwa ejima, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninshiya mujiyedi, nimanji aduku wowu ekala kumasweswa, nichibutamuchima, akayaluli hamu nanshiya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akayochi hakameŋa bwi-i, hiyakudya yahimulambu wakumwilila Yehova nakesi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        }
      ]
    },
    {
