            "sid": "LEV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova watambikili Mosi, wahosheli nindi; izu dindi hidi kufuma mwitenti dakubulakena, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.1",
            "verseOrgIds": [
              "LEV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila nindi, Hoshaku nawanyana kaIsarela, wuyili neyi, Neyi hadi mukwenu wakahimulambu la Yehova, mwakala mbulaŋa himulambu wachimuna, hela wakwitaŋa hela wakwiyinda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi himulambu windi wakekala himulambu wakushita wakwitaŋa, akalambuli ŋombi weyala wakadi hataminayi; akamulambwili kuchisu chetenti dakubulakena, kulonda akamwitiji kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.3",
            "verseOrgIds": [
              "LEV.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaŋiki chi kasachindi hanamutu wamulambu wakushita, akawitija hamujimba windi, wakubutanachu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.4",
            "verseOrgIds": [
              "LEV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋombi akamujahili kumesu aYehova. Atupristu anyana kaAroni akashikiji mashi, owu mashi akayisampuli hakameŋa kwi-ndo, kokameŋa kekala kuchisu chetenti dakubulakena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu himulambu wakushita akawuwi, akawuhaboli. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.6",
            "verseOrgIds": [
              "LEV.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kakapristu Aroni akashikesi hakameŋa, akafwiki nchawa hakesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu anyana kaAroni aka ali chachiwahi, ninamutu, nimanji hanchawa jidi hakesi kadi hakameŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
            "verseOrgIds": [
              "LEV.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niya mwivumu, ninyendu, nimakasa, akayikosi nameji; kapristu akawushiti wejima muwukuma hakameŋa bwi-i, hihimulambu wakumwilila Yehova nakesi, wevumba dadiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi himulambu windi wakekala wakwiyinda hela wamukoku helawampembi, wamulambu wakushita, akalambuli chizamba wakadi hataminayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.10",
            "verseOrgIds": [
              "LEV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamujahili kumesu aYehova kumbadi yakameŋa yatala kuka beta kaku chidiilu, anyana kaAroni akasampuli mashindi hakameŋa kwi-ndo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.11",
            "verseOrgIds": [
              "LEV.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.11",
            "verseOrgIds": [
              "LEV.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamuhaboli ninamutu windi nimanji indi kumu, kapristu aka ali chachiwahi yejima hanchawa jidi hakesi kadi hakameŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.12",
            "verseOrgIds": [
              "LEV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niya mwivumu, ninyendu, nimakasa, akayikosi nameji; kapristu akalambuli weji mamu wukuya, akawushiti hakameŋa bwi-i, hihimulambu wakushita, himuza mbuwa kumwilila Yehova nakesi, wevumba dadiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi himulambu windi wakala mbulayi Yehova wakekala himulambu wakushita watujila, akalambuli himulambu windi wakushita hela tutela, hela nyana katupompa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.14",
            "verseOrgIds": [
              "LEV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu akakaleti kukameŋa, akakanyotomoni namutu akawufu mishuku, akakashiti hakameŋa bwi-i; mashi aku akayi kamwili kumbadi yakameŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.15",
            "verseOrgIds": [
              "LEV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akafumishuku isakwila dindi nimajilu adumu, akadi natili kumbadi yakameŋa yatala kumujika kwasukwilaŋawu mawuti; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.16",
            "verseOrgIds": [
              "LEV.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "akakabaluli lupúula iku, lupúula iku, bayi akaambula hachikupuku; kapristu akakashiti hakameŋa bwi-i, hanchawa jidi hakesi, hihimulambu wakushita, hihimulambu wakumwilila Yehova nakesi, wevumba dadiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.17",
            "verseOrgIds": [
              "LEV.1.17"
            ]
          }
        }
