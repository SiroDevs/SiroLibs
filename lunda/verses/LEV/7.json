          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dilu lushimbi lwamulambu wakushita, nilwamulambu wawuŋa, nilwamulambu wahanshidi, nilwamulambu wakutanya, nilwakudikunjika, nilwachimuna chanyilambu yakuwunda; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
