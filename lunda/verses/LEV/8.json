          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumafuku atanu nayedi kwidika muchisu chetenti dakubulakena nehi, sampu mafuku akuyikunjika kumudimu anawani dehi; muloŋayena wakayi kunjikaŋa kumudimu mafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.33",
            "verseOrgIds": [
              "LEV.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
