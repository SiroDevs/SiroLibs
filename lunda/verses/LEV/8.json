              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayilili aAroni nawanyanindi, nindi, Mbŋi yitelekenu kuchisuchetenti dakubulakena; kwokwenoku diku kumwakayidi ila namankendiadi mwibaŋu dakukunjika, mwomunayilejeli nami, Akayidyaŋa kudi aAroni nawanyanindi amayala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
