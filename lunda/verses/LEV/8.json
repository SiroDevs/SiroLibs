            "sid": "LEV 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutunelilelu, dimu mwatulejeliyi Yehova kwila, kulonda kuyilila yakubuta nachu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakashakamaŋa kuchisu chetenti dakubulakena nimwaana niwufuku mafuku atanu nayedi; mwakahembaria izu danayishiikiyi Yehova kulonda mwakabuli kufwa; muloŋa dimu mwananlejuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
