        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu idi datela kwitiya, delawu nawu, Muntu nakeŋi mudimu wakutala akwawu nakeŋi mudimu wawuwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mukwakutala akwawu chiŋa yobula hakumwinkela Muloŋa, wukweti mumbanda wumu hohu, wadihembaŋa, wawundisha mumesu, walumbuluka, wadiishaŋa ŋeji, wukweti kashinslii kakuleja akwawu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabula ndombu, hetanaŋaku; ilaŋa wawunda, hakweti ntadi nawakwawuku, wabula kufwila mali; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.3",
            "verseOrgIds": [
              "1TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "muntu wayulaŋa chachiwahi mwitala dindi yomweni, wukweti anyanindi amwovwahilaŋa nakalemesha kalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi muntu wabula kwiluka kuyula mwitala dindi yomweni, indi chipompelu chaNzambi wukuchihemba ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi ekala kadizaku, wakenda kadinka wanta, hakuholokela mwatanyinayi diyabolu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.6",
            "verseOrgIds": [
              "1TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiŋa ashimunaŋawu chachiwahi kudi antu adi hanzi, wakenda kaholokela mukusawuka, nakufwa mumuhetu wadiyabolu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwomumu niankoŋi ekali nakalemesha, hiyakwamazu ayeduku, hiyasweja kunwa walwaku, hiyafwila kuheta chatamaku; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "akwata kunsaŋu yakwitiya kwakukuhwelela yakujinda, nachinleji chamuchima chitooka.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakusonekeli yumiyi nakukuhwelela nami nakenza kudeyi mafuku anu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.14",
            "verseOrgIds": [
              "1TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi nakasweja kulaba, nalondi nami wakeluki mwakwililawu antu mwitala daNzambi, chochipompelu chaNzambi wamumi, chochishimi nihakolela nsaŋu yalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu yakwakama Nzambi yajindiluwu yasweja kulema nankashi, hiyatadikewaŋaku; Nzambi amwekesheluwu mumujimba, ayiŋishiluwu mudi Spiritu, amwenuwu kudi aŋelu, ashimwinuwu munyuza, etiyiluwu mumpata yamunu mwishina, atambwiluwu mwiwulu mulubanji lwakulema.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    }
  ],
