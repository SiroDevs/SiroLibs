  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "RUT 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muku windi Nyawomi wamwilili nindi, Eyi mwanami, ochu nibuli kukukeŋela kwakushakama, ochu neyi nehi, wakashakama chachiwahi ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.1",
            "verseOrgIds": [
              "RUT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenowu Bowazi wukweti yaŋadima yindi viwadiŋi nawu hintaŋa yetuku? Lelu wufuku owu hakuya nakupepa bali kwitala dakuhulila. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.2",
            "verseOrgIds": [
              "RUT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadi kuwela, wuwayi manji, wuvwali mahineyi, wuyi kwitala dakuhulila. Bayi akakumona kudi owu iyalaku, chiŋa nadyi dehi, nanwi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.3",
            "verseOrgIds": [
              "RUT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakelayi, nakami dehi, eyi wakashinshiki kwanakamiyi, wakeŋa ilumu, wakanyamuni mahina anabutiyi kunyendu yindi, wukama nikukama. Yena wakakuleja chiwakela. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.4",
            "verseOrgIds": [
              "RUT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili nindi, Mwejima muwunanleji dimu nukwila.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.5",
            "verseOrgIds": [
              "RUT.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.5",
            "verseOrgIds": [
              "RUT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayili kwitala dakuhulila, welili mwejima mwamulejeliyi muku windi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.6",
            "verseOrgIds": [
              "RUT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Bowazi nadyi dehi, nanwi dehi, natiyi dehi kuwaha kumuchima windi, hakuya nakukama kunsa yamulumba watidiku nabali. Luti hakuya chovu chovu, hakunyamuna mahina anabutiyi kunyendu yindi, yokama nikukama. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.7",
            "verseOrgIds": [
              "RUT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chi kwelili himukachi kawufuku, iyala hakubazumuka, yobalumuka nikubalumuka, nindi atali, mumbanda iwu nakami kunyendu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.8",
            "verseOrgIds": [
              "RUT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Yeyinyi? Yena nindi, Yami kambuŋeyi Luti, ambutuhu ami kambuŋeyi ihina deyi, muloŋa eyi yeyi wuteji kunkúula. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.9",
            "verseOrgIds": [
              "RUT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Yehova akukiswili nkisu, mwanami. Hela hakusambila wela chachiwahi, katataka wunasweji dehi, ochu chiwunabuli kukeŋa anyikwenzi hela abula kuheta, hela aheta. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.10",
            "verseOrgIds": [
              "RUT.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu, mwanami, bayi wutiya womaku. Nukukwila mwejima muwunahoshi. Muloŋa antu ejima amumukala wetu anakwiluki nawu wumumbanda washinshika. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.11",
            "verseOrgIds": [
              "RUT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala yami niteji kukukuula, ilaŋa kudi muntu mukwawu wakukukuula wakumbadikami. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.12",
            "verseOrgIds": [
              "RUT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hembelaku tuhu wufuku owu, habudidi twakatala; neyi yena waketeja kwila mwelaŋa mukwakukuula, chachiwahi; ilaŋa neyi yena wakaleka kwila mwelaŋa mukwakukuula, ami yami nakakwila mwelaŋa mukwakukuula. Yehova wudi kwoku. Kamaku tuhu wutalili chikukucha.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.13",
            "verseOrgIds": [
              "RUT.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.13",
            "verseOrgIds": [
              "RUT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamini kunyendu yindi nichikwachili. Wahindukili kuchidi hamesu bwi. Muloŋa Bowazi wahosheli nindi, Bayi chakatiyakana nawu mumbanda wenza mwitala dakuhulilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.14",
            "verseOrgIds": [
              "RUT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Letaku ilesu odu diwunadibuti, kwataku. Wakwatili. Yena wamwesekeleli yikopu yabali yitanu nachimu, yomutwika nikumutwika. Hakuya nikumukala. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.15",
            "verseOrgIds": [
              "RUT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjiliyi kudi muku windi, nindi, Wunendi chachiwahi mwanami, tahindi? Wamulejeli mwejima mwamwililiyi owu iyala. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.16",
            "verseOrgIds": [
              "RUT.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Wanyinka yeniyi yikopu yabali yitanu nachimu. Muloŋa wela nindi, Bayi wuya makasakasa kudi muku weyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.17",
            "verseOrgIds": [
              "RUT.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka yena nindi, Shakamaku tuhu mwanami, wutali mukuya nsaŋwiyi. Muloŋa owu iyala hakulekaku chiŋa chumichi chimana.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.18",
            "verseOrgIds": [
              "RUT.3.18"
            ]
          }
        }
      ]
    }
  ],
