            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalamba kevumu dawankakulula jayisaka yawaKohati yowu Eliza fwana mwana kaUziyeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
