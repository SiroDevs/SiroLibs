          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudimu wakayikunjikiluwu anyana kaMerari, wowu wakutalaŋa mapalanga atabanaka ninkaŋalu yayu, niyishimi yayu, nimayandayu, niyuma yayu, nimudimu wayu wejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyishimi yachipaŋu chanye ŋumu kakuni maya ndayu, nimpopu jayu, ninyonji yayu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        }
