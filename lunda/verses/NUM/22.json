  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "NUM 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela endeli cheŋi munjila yawu, atuŋili chilombuchawu muyana yaMowabi mwishinadi daYodana kwakwihi naYeriku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.1",
            "verseOrgIds": [
              "NUM.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki mwana kaZipori wamweni yejima yayikoŋeluwu aAmori kudi aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.2",
            "verseOrgIds": [
              "NUM.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mowabi wayitiyili aIsarela woma nankashi, muloŋa aswejelikuvula, Mowabi wafwili muchima mwivumu puchi nawanyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.3",
            "verseOrgIds": [
              "NUM.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mowabi wayilili awakulumpi jawaMidiyani, nindi, Luntu ilu lukulashatuhu yuma yamunu mwituŋa yejima, neyi chalashaŋayi ŋombi matahuamumpata. Balaki mwana kaZipori diyi wadiŋi mwanta wakuMowabi hamwakowu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.4",
            "verseOrgIds": [
              "NUM.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.4",
            "verseOrgIds": [
              "NUM.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watemesheli antemesha kudi Balami mwana kaBeyori kuPetori wekala kuKaloŋa kwokwituŋa dawanyana kantaŋa jindi, wamutambi kili nindi, Twa ya wutali, antu awa anafumi muEjipitu. Twaya wutali, anajiki hewulu deseki dejima wi-i, awa ananshakamini awa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.5",
            "verseOrgIds": [
              "NUM.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twa ya dinu mwani, wunshiŋiliantu awa, anambadiki Ŋovu, hadaha nakamona kuyimika mushindu, kulonda tuyitapi, niyitemuni mwituŋa. Muloŋa ami neluki nami muntuwukukisuleyi nkisu wukukisulewa, muntu wukushiŋeyi wukushiŋewa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niawakulumpi jawaMowabi niakulumpi jawaMidiyani ayili, asendelinsaŋa jakuhoŋa nachu. Ashikili kudi Balami, amulejeli mazu ahosheli Balaki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.7",
            "verseOrgIds": [
              "NUM.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wayilili nindi, Kamenu kunu wufuku wunu, niyileteli cheŋi izu dakuhoshayi Yehova nanami. Atulamba twaMowabi akamini kwaBalami. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.8",
            "verseOrgIds": [
              "NUM.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wenjili kudi Balami, nindi, Indi awa mayala wudinawuhiyanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.9",
            "verseOrgIds": [
              "NUM.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wamwilili Nzambi, nindi, Balaki mwana kaZipori, mwanta wakuMowabi nantemesheli mazu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.10",
            "verseOrgIds": [
              "NUM.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Twaya wutali, antuawa anafumi muEjipitu anajiki hewulu deseki dejima wi-i; twaya dinuwunshiŋiluwu, hadaha nakatwesha kulwa nawu nakayitemuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.11",
            "verseOrgIds": [
              "NUM.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wamwilili Balami, nindi, Bayi wuya nawuku. Owu antu bayi wakayishiŋaku, muloŋa akisulewa kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.12",
            "verseOrgIds": [
              "NUM.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wamenekeli budidi, wayilili atulamba twaBalaki, nindi, Yenuŋa kwenu mwituŋa denu, Yehova kwontikwindi kuŋitŋia kuya nenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.13",
            "verseOrgIds": [
              "NUM.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba twaMowabi anyamukili, ayilikudi Balaki, nawu, Balami kwonti kwindi kwinza nanetu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki watemesheli cheŋi atulamba amakwawu asweja kuvula, aswejanikulema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.15",
            "verseOrgIds": [
              "NUM.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enjili kudi Balami, amwilili nawu, Tiya chanahoshiyi Balaki mwana kaZipori, nindi, Bayi mwani, hakamwekana chuma chakukulekesha kwinza kudamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.16",
            "verseOrgIds": [
              "NUM.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami nakakulemesha nankashi, yejima yiwakanlejana kela hohu. Dichi twaya mwani, wunshiŋili antu awa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.17",
            "verseOrgIds": [
              "NUM.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wayakwili ambuŋa Balaki, nindi, Hela neyi Balaki wukunyinka tuhu italadindi dato-o dasiliva nawuru, ami kwami kumotoka izu daYehova Nzambi yami, hela kukumininamu, hela kulunjikamu kutwesha nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.18",
            "verseOrgIds": [
              "NUM.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinumwani, chiŋililenu wufuku owu nawa kulonda niiluki mwakanlejayi Yehova mwekwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.19",
            "verseOrgIds": [
              "NUM.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wenjili kudi Balami nawufuku, wamwilili nindi, Neyi amayalawa akwinza nakukutambika wakanyamuki wakayi nawu. Ilaŋa chiŋa wakela mwomunakakuleja hohu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.20",
            "verseOrgIds": [
              "NUM.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.20",
            "verseOrgIds": [
              "NUM.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wamenekeli budidi, walemeni sadi hachimbulu chindi, wayilinawatulamba twakuMowabi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.21",
            "verseOrgIds": [
              "NUM.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wazuwili nanochu chayiliyi; kaŋelu kaYehova wemeni munjila kulonda kudikaŋa nindi. Yena wadiijinakwenda hachimbulu chindi, wadiŋi naŋamba jindi ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.22",
            "verseOrgIds": [
              "NUM.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimbuluha kumona kaŋelu kaYehova nemani munjila, mpoku yindi yakabali yakuhola dehi yidi kuchikasa chindi. Chimbulu hakutenuluka munjila, hakuyamumpata. Balami wamweteli chimbulu, nindi amufuntishi cheŋi munjila. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.23",
            "verseOrgIds": [
              "NUM.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu kaŋelu kaYehova hakwimana mukakawoŋu hakachi kamatempa anyivinyu, hela ikoli iku, ikoli iku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.24",
            "verseOrgIds": [
              "NUM.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimbulu wamweni kaŋelu kaYehova, wadishintakesheli kumbariu, wachikili mwendu waBalami kumbaŋu. Wamweteli cheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.25",
            "verseOrgIds": [
              "NUM.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu kaYehova hakuya kumbidi hakwimana hanyiŋana hakadi hakubalumukila muntu aya hela kuchikasa chachidiilu hela kuchimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.26",
            "verseOrgIds": [
              "NUM.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimbulu wamweni kaŋelu kaYehova, wadimbukili mwishina daBalami. Balami wazuwili, wamweteli chimbulu namutondu windi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.27",
            "verseOrgIds": [
              "NUM.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova waasamishili kanwa kachimbulu, yena hakumwila Balami, nindi, Nakwili ŋahi mwaka wuŋeti mapampa kasatu aka? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.28",
            "verseOrgIds": [
              "NUM.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wamwilili chimbulu, nindi, Muloŋa wunansawuli dehi. Neyi nadinituhu nampoku yakabali muchikasa chami, mutenowu nakujahi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.29",
            "verseOrgIds": [
              "NUM.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimbulu hakumwila Balami, nindi, Hiyami chimbulu cheyuku? Kufumisha hiwanheteleli nyaka yejima yiwunahandi kushika nikwifuku dalelu ochu wendelaŋa hanka? Nakwilahu dehi chochichi? Nindi, Nehi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova watonesheli mesu aBalami, wamweni kaŋelu kaYehova nemanimunjila, mpoku yindi yakabali yakuhola dehi yidi kuchikasa chindi. Wabandamini namutu windi, wadinatili chamesu hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.31",
            "verseOrgIds": [
              "NUM.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapelu kaYehova wamwilili nindi, Wunamwetelidi chimbulu cheyi mapampa kasatu aka? Tiya, ami nenzi nakudikaŋaa naneyi, muloŋa namoni njila yeyi yatama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.32",
            "verseOrgIds": [
              "NUM.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimbulu wanmona, wabaaluka kumesu ami mapampa kasatu aka. Chákubula yena kubaaluka afuma kudami, mutenowu chalala nakujaha dehi, mutenowuyena namuhandishi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.33",
            "verseOrgIds": [
              "NUM.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wamwilili kaŋelu kaYehova, nindi, Navulumuni. Hinachiluka nami wunaŋimeni munjilaku. Dichidinu neyi wunatiyi dehi kutama, nifunti kwami. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.34",
            "verseOrgIds": [
              "NUM.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu kaYehova wamwilili Balami, nindi, Yaku nanawa amayala. Dodizu dinakakuleja didu diwakahosha. Dichi Balami wayili nawatulamba twaBalaki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki chatiyiliyi nawu Balami nenzi dehi, hakuya naku mukinkili laku mukala waMowabi wekala kuŋinza yaArinoni, kwakumina pinza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.36",
            "verseOrgIds": [
              "NUM.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki wamwilili Balami, nindi, Hinatemesha nakukuzebela nakukuta mbikaku? Walekeladi kwinza? Nikaŋanyi kukulemesha, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.37",
            "verseOrgIds": [
              "NUM.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wa mwilili Balaki, nindi, Nenzi dehi, yami awa. Hela chochu hinikweti Ŋovu yakuhosha chumaku. Dodizu dakanshilayi Nzambi mukanwa didunakahosha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.38",
            "verseOrgIds": [
              "NUM.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wayili naBalaki, ashikili kuKiriyati Huzoti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.39",
            "verseOrgIds": [
              "NUM.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki waketwili aŋombi nanyikoku, watemesheli nakuleja Balami natulamba adiŋiyi nawu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        }
      ]
    },
