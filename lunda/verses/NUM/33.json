              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 33:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi muyana yaMowabi kuYodana kuYeriku, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.50",
            "verseOrgIds": [
              "NUM.33.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 33:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshaku nawanyana kaIsarela, wuyili neyi, Chimwakazambu kaYodana muyi mwituŋa daKenani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.51",
            "verseOrgIds": [
              "NUM.33.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 33:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwakatemuni ashakaŋa mwituŋa ejima kumwakayenu, mwakakisaŋani niakishi awu akusuŋununa ejima, mwakakisaŋani ninkishi jawu jakusuŋununa jejima, mwakasandi niyinaŋanaŋa yawu yejima; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.52",
            "verseOrgIds": [
              "NUM.33.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 33:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwakatambuli ituŋa, mwakashakamumu; muloŋa ituŋa nayinki dehi denu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.53",
            "verseOrgIds": [
              "NUM.33.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 33:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituŋa mwakadiswani nachinjikijilu chakusakula nachu, mwahita yisaka yenu; amavulu mwakayinki wuswana wawuvulu, antesha mwakayinki wuswana wantesha; kwamuholokela muntuchinjikijilu chindi diku kwindi; mwakaswanini mwomwekalila nyichidi yawankakulula jenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.54",
            "verseOrgIds": [
              "NUM.33.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 33:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi ashakama mwituŋa mwakabula kuyitemuna kumwakayenu, awa mwakashiya akekala neyi chikwanyumba yakulemeka mumesu enu, neyi chikwanyiŋa yakulemeka mumbavu jenu, akayikabishaŋa mwituŋa dimwakashakama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.55",
            "verseOrgIds": [
              "NUM.33.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 33:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakela munayifuukwilili wena dimunakayikoŋenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.56",
            "verseOrgIds": [
              "NUM.33.56"
            ]
          }
        }
      ]
