          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaKenani, mwanta waAradi, washakamini kukabeta kakuchidiilu mwituŋa daKenani, watiyili chakwinzawu anyana kaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        }
      ]
    },
