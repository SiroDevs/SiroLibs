          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Aroni wakandamini hampidi yaHori mwomwamulejeliyi yehova, wafwilili kwenoku mumwaka wamakumi awana nahafuminuwu anyana kaIsarela mwituŋa daEjipitu, mukakweji kamuchitanu, hefukudakakweji dakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38",
            "verseOrgIds": [
              "NUM.33.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 33:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafwiliyi kumpidi yaHori, Aroni washikilimunyaka nkulakaji namakumi ayedi nanyaka yisatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
            "verseOrgIds": [
              "NUM.33.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
