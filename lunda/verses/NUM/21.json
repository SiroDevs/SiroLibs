  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "NUM 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaKenani, mwanta wakuAradi, washakamini kukabeta kakuchidiilu, watiyili nawu Isarela hakwinza njila yaAtarimi. Walwilina waIsarela, wakwatiluhu niankoli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela adishiilili kudi Yehova, nawu, Chalala neyi wakahana antu awa kudetu twakanoŋesha nyikala yawuchikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova watiyililili izu dawaIsarela, wayinkeli aKenani. Ayinopesheli chikupu ninyikala yawu kumu. Atumbiluku ijina nawu kuHorama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afumini kumpidi yaHori, ayilili njila yaKalupalwiji Kachinana, kulondakunyeŋu muka ituŋa daEdomi. Kunyichima yawantu kwakumini nanjilayendeluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ahosheli Nzambi naMosi chatama, nawu, Mwatufumishilili dimuEjipitu tufwili munu mwisaŋa? Mwakadi yakudya, mwakadimeji; iyi yakudya yahehuka tunayitiyi dehi kwetu kumuchima bwi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.5",
            "verseOrgIds": [
              "NUM.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.5",
            "verseOrgIds": [
              "NUM.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova watemesheli mukachi kawantu tupela twakesi, twasumini antu. AIsarela amavulu afwili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu enjili kudi Mosi, nawu, Tunavulumuni dehi nanichi chitunahoshi dehi niYehova nineyi chatama. Lombaku kudi Yehova atufumishili tupela. Mosi wayilombeleli antu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Ilaku kapela keyi kakesi, wukashi kumpandelu kulonda antu ejima anasumuwu chakakamonawu akahandi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.8",
            "verseOrgIds": [
              "NUM.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi welili kapela kawuneŋu, wakashili kumpandelu, elili neyi kapela kanasumi dehi muntu, chakutalayi kapela kawuneŋu swi-i hakuhanda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
              "NUM.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
              "NUM.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela endeli, ateekeli muOboti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.10",
            "verseOrgIds": [
              "NUM.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afumini kuOboti, ateekeli kuIye Abarimi, mwisaŋa dekala kwakwihi naMowabi mbadi yatuntukaŋa itaŋwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.11",
            "verseOrgIds": [
              "NUM.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afumini kwenoku, ateekeli muchinekineki chakuZeredi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.12",
            "verseOrgIds": [
              "NUM.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afumini kwenoku ateekeli mwishinadi daArinoni wekala mwisaŋa wafuma muŋinza yawaAmori. Muloŋa Arinoni diyi ŋinza yaMowabi, hakachi kaMowabi nawaAmori ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.13",
            "verseOrgIds": [
              "NUM.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chaneliluwu mumukanda wa-Majita aYehova, nawu, Cheliliyi muKaluŋalwiji Kachinana, nimutwanatwatuloŋa twasaŋila muArinoni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimumukandu wayinekineki wakunkumukila kwashakama Ari, wakundama kuŋinza yaMowabi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afumini kwenoku ayili kuBeyeri. Didu ishima damwililuwu Mosikudi Yehova, nindi, Pompeshaku antu niyinki meji. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu kaminakembiluwu aIsarela, nawu, Eyi ishima, sefukaku. Mwimbilenu kamina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Didu ishima dapundiluwu atulamba, dembiluwu ayilolu nandondananyitondu yawu. Afumini kwisaŋodu ayili kuMatana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afumini kuMatana ayili kuNahaliyeli. Afumini kuNahaliyeli ayili kuBamoti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.19",
            "verseOrgIds": [
              "NUM.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afumini kuBamoti ayili kuchinekineki chekala kumpata yaMowabini kwiwulu dampidi yaPisiga yatala kuchibaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.20",
            "verseOrgIds": [
              "NUM.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.20",
            "verseOrgIds": [
              "NUM.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela atemesheli antemesha kudi Sihoni mwanta wawaAmori, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.21",
            "verseOrgIds": [
              "NUM.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Twitŋi tuhiti mwituŋa deyi. Hitwakasenuka munjila tuya hela mwihahela mwitempa danyivinyuku. Hitwakanwa meji amumashimaku, twakayaya mukwakwa wambala wamwanta, ninichi chitwakapandakana ŋinza yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.22",
            "verseOrgIds": [
              "NUM.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihoni hetŋili aIsarela kuhita muŋinza yinduku. Sihoni hakupompesha antu indi ejima, hakuya nakulwa nawaIsarela mwisaŋa, oshika nikuYahazi. Hakulwa nawaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.23",
            "verseOrgIds": [
              "NUM.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela amutapili nawumwemu wampokuyakabali, atambwili ituŋa dindi kufumisha kuArinoni ndo nikuYaboki kwekala anyana kaAmoni; muloŋa ŋinza yawanyana kaAmoni yadiŋiyakola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela atambwili nyikala yejimiyi. AIsarela ashakamini munyikala yawaAmori, mwomuHeshiboni nimunyikala yekalaku yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Heshiboni diwu wadiŋi mukala waSihoni mwanta wawaAmori, yowu walwili namwanta wakuMowabi wásambilili, wamutambwilili ituŋidindi dejima ndo nikuArinoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chahoshelaŋawu muyishimu, nawu, Twayenu kuHeshiboni, mukala waSihoni awutuŋi, awukoleshi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa kesi kanafumi muHeshiboni, mulaŋu wunafumi mumukala waSihoni, wunalashi Ari waMowabi, niakwayinaŋanaŋa yakuArinoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayo! Eyi mukwetu Mowabi! Enu antu aKemoshi, munajile! Anyanindi amayala apulukili, ni anyanindi awambanda, wayiheni muwukoli kudiSihoni mwanta wawaAmori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunayisowi dehi. Heshiboni nanoŋidehi ndo nikuDiboni, tunakisaŋani dehi mpata yawu ndo nikuNofwa, kwokuMedeba kachi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi aIsarela ashakamini mwituŋa dawaAmori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi watemeshelina kwendesha Yazeri. Atambwili nyikala yawu, atemwinumu aAmoŋa shakaminumu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalumukili, akandukili njila yaBashani. Mwantawa kuBashani Oŋi, niantu indi ejima ayiluku, alwili nawu kuEdereyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.33",
            "verseOrgIds": [
              "NUM.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Bayi wumutiya womaku; namuhani dehi kudeyini antu indi ejima niituŋa dindi. Wakamukoŋa neyi chiwakoŋeli Sihoni mwanta wawaAmori washakamini kuHeshiboni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.34",
            "verseOrgIds": [
              "NUM.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amutaŋa nikumutaŋa, niyena ni anyanindi amayala, niantu indi ejima, niwindi wumu washeluhuhosi. Atambula niituŋa dindi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.35",
            "verseOrgIds": [
              "NUM.21.35"
            ]
          }
        }
