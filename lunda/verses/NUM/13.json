      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.1",
            "verseOrgIds": [
              "NUM.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Temeshaku amayala ayinakwendesha ituŋa daKenani dinukuyinka anyana kaIsarela, wakatemeshahanyichidi yejima yawankakulula jawu, hamuchidi wumu iyala, hamuchidi wumu iyala, wowu atulamba hohu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.2",
            "verseOrgIds": [
              "NUM.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayitemesheli mwomwamulejeliyi Yehova, afumini mwisaŋa daParani, owu amayala ejima adiŋi awakulumpi awanyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.3",
            "verseOrgIds": [
              "NUM.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Majinawu; wakumuchidi waRubeni, mwana kaZakuri Shamuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.4",
            "verseOrgIds": [
              "NUM.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waSimeyona, mwana kaHori Shafwati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.5",
            "verseOrgIds": [
              "NUM.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waYuda, mwana kaYefune Kalebi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.6",
            "verseOrgIds": [
              "NUM.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waIsakari, mwana kaYosefu Igali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.7",
            "verseOrgIds": [
              "NUM.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waEfweremi, mwana kaNuni Hosheya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.8",
            "verseOrgIds": [
              "NUM.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waBenjamini, mwana kaRafu Paliti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.9",
            "verseOrgIds": [
              "NUM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waZebuluni, mwana kaSodi Gadiyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.10",
            "verseOrgIds": [
              "NUM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waYosefu, wamuchidi waManase, mwana kaSusi Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.11",
            "verseOrgIds": [
              "NUM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waDani, mwana kaGemali Amiyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.12",
            "verseOrgIds": [
              "NUM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waAsheri, mwana kaMikayeli Seturi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.13",
            "verseOrgIds": [
              "NUM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waNafwatali, mwana kaVofwisi Nahibi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.14",
            "verseOrgIds": [
              "NUM.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakumuchidi waGadi, mwana kaMaki Geyuwcli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.15",
            "verseOrgIds": [
              "NUM.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa diwu majina awamayala atemesheliyi Mosi nakwendesha ituŋa. Mwana kaNuni Hosheya, Mosi wanamutumbili ijina nindi diyi Yoshuwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.16",
            "verseOrgIds": [
              "NUM.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayitemesheli nakwendesha ituŋa daKenani, wayilili nindi, Kandukilenu njiliyi yakukabeta kakuchidiilu, mwakakandami hamapidi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.17",
            "verseOrgIds": [
              "NUM.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwakatali mwekalila ituya niantu ashakamamu, neyi akola indi kwiji iyiazeya, neyi antesha indi kwiji amavulu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.18",
            "verseOrgIds": [
              "NUM.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "niituŋa dashakamawu neyidadiwahi indi kwiji datama; nichekala nyikala yashakamawu neyi adimuyilombu indi kwiji muyipaka yawu mwadikaŋilaŋawu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.19",
            "verseOrgIds": [
              "NUM.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwakataliniituŋa chidekala, dikweti manji indi kwiji dabula manji, neyi mwekala nyitondu indi kwiji nehi, mwakadikoleshaŋa mwakaleti yakudya yamwituŋa. Hadird hachila aka chanyikabu yavinyu yakahila.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.20",
            "verseOrgIds": [
              "NUM.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akandukili, endesheli ituŋa kufumisha kwisaŋa dakuZini kushika niku-Rehobi, kuwipililu wakuHamati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.21",
            "verseOrgIds": [
              "NUM.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akandukilili kukabeta kakuchidiilu, ashikili nikuHeberoni; Ahimani naSheshayi naTalimayi, anyana kaAnaki, adiŋi kwenoku, Heberoni awutuŋili kuchidi nyaka yitanu nayiyedi nahatuŋilu wuZowani muEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.22",
            "verseOrgIds": [
              "NUM.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashikili kuchinekineki chaEshikoli, akunkwilukuni mutayi wamuvinyu wukweti chizokosu chavinyu, achitembekeli hamutondu, asendeli nawa nimabula ninkuyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.23",
            "verseOrgIds": [
              "NUM.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenoku atumbiluku ijina nawu, kuchinekineki chaEshikoli, nanochu chizokosu chakunkwiluwu anyana kaIsarela kwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.24",
            "verseOrgIds": [
              "NUM.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamanini mafuku makumi awana afuntili kwayiluwu nakwendesha ituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.25",
            "verseOrgIds": [
              "NUM.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chashikiluwu, enjili kudi Mosi naAroni nachipompelu chawanyana kaIsarela chejima, kwisaŋa dakuParani, kwoku kuKade shi; ayishimwininu muwena nichipompelu chejima mwayiluwu, ayilejeli niyakudya ya mwituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.26",
            "verseOrgIds": [
              "NUM.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulejeli nawu, Tunashi ki mwituŋa diwatutemesheli, chalala datuloŋa twamayeli nawuchi, niyakudya yekalamu iyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.27",
            "verseOrgIds": [
              "NUM.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa dinu antu ashakama mwituŋa akola, ninyikala yawu yamwajika hohu yasweja nikutoha, twamonaku nawa anyana kaAnaki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.28",
            "verseOrgIds": [
              "NUM.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "AAmaleki ashakama mwituŋa dakukabeta kakuchidiilu, aHiti nawaYebusi nawaAmori ashakamahamapidi. AKenani ashakama kukaluŋalwiji, nimumukulishu waYodana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebi wamwenesheli antu kumesu aMosi, nindi, Tuyenuku katata katwa kadi tambuli; tunatweshi kwimika mushindu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.30",
            "verseOrgIds": [
              "NUM.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mayala ayiliyi nawu, elili nawu, Hitukutwesha kuya nakulwa nawantu awaku, muloŋa atubadika Ŋovu. ",
          "type": "text",
