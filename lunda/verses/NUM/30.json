  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "NUM 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wahosheli nawanyanta anyichidi yawanyana kaIsarela, nindi, Tiyenu chuma chanatulejiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Neyi iyala wukudishiilakudi Yehova, hela neyi wukusanyika kwakudishiŋa kwakudikasamumuchima windi, bayi akamotoka izu danahoshiyuku, chiŋa akela mumazuejima anafumi mukanwa kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimumbanda nawa neyi nadishiili kudi Yehova, nadikasi chakudikasa, wuchidi mwitala datata yindi, wuchidikansi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.3",
            "verseOrgIds": [
              "NUM.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nitata yindi natiyi kudishiila kwanadishiiliyi, chanadikasiyi mumuchimawindi, nitata yindi namumweneni zo; henohu mwejima mwanadishiiliyimwakakola, ninoyu yanadikasiyi nachu mumuchima windi yakakola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.4",
            "verseOrgIds": [
              "NUM.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋ neyi tata yindi wakamulekesha mwifuku dakatiyayi, hela yanadishiiliyi, hela oyu yanadikasiyi nachu mumuchima windi, hiyakakolaku; Yehovawakamwanakena nanochu chanamulekeshiyi tata yindi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wasumbuka dehi neyala ohu hakudishiilayi, indi kwiji hakuhosha yina kanwa kindi yalufuchi, hakudikasa nachu mumuchima windi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.6",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninfumwindinachitiyi, namumweneni zo mwifuku danachitiyiyi; henohu yanadishiiliyi yakakola, ninoyu yanadikasiyi nachu mumuchima windi yakakola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.7",
            "verseOrgIds": [
              "NUM.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila neyi nfumwindi wakamulekesha mwifuku dakachitiyayi najahi dehi mwadishiililiyi, nimazu amukanwa kindi ahoshayi lufuchi, adikasayinachu mumuchima win di; Yehova wakamwana kena. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza yakudishiilayi mumbanda wantuluwa hela aseŋawu, yadikasayi nachu mumuchima windi, yejima yakamukolela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wadishiilili mwitala danfumwindi, hela neyi wadikasili mumuchima windi namwonji chakusanyika kwakudishiŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.10",
            "verseOrgIds": [
              "NUM.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninfumwindi wachitiyili wamumweneneni zo kumulekesha nehi, henohu yadishiililiyi yejima yakakola, nimwadikasiliyi nachu mumuchima windi mwejima mwakakola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi nfumwindi wayijahili mwifuku dayitiyiliyi, henohu mazu edikili mukanwa kindi ejima akutena kudishiilamu, hela akutena mwadikasililiyi mumuchima windi, hiyakakolaku; nfumwindi nayijahi dehi, Yehova wakamwanakena. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakudishiilayi mwejima nakusanyika kwakudishiŋa kwejima kwakukabisha muchima windi, nfumwindi natweshikukoleshamu, hela kujaha nfumwindi natweshi kujahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyinfumwindi wakadimwenena zo chikupu hefuku hefuku, kumuhoshamu nehi, henohu nakoleshi mwejima mwadishiililiyi, nimwadikasililiyi mwejima; nakoleshumu dehi nanochu chamweneniyi chakubula kumuhoshamu hatiyiliyimazu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi wakajahamu munahiti dehi mafuku nahatiyayimazu indi, yena wakakoola kuluwa kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeniyi diyi yidika yalejeluwu Mosi kudi Yehova yeyala naŋodindi, niyatata yamuntu namwanindi wamumbanda wuchidi kansi, wuchidi mwitala datata yindi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
    }
  ],
