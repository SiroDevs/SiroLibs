          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaRubeni, wedi waIsarela mumakiriu awu mwahita yisakayawu, mwahita mavumu awankakulula jawu, mwachindililuwu majina awamayala ejima, kunamutu kunamutu, kutachikila hadi anyaka makumi ayedi nakubadikamu, ayilaŋa kunjita ejima; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "achindiluwu kumuchidi waRubeni, ashikili mumakombakaji makumi awana natanu nadimu, namakulakaji atanu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
