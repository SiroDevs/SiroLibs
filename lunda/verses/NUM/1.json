          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "achindiluwu kumuchidi waSimeyona, ashikili mumakombakaji makumi atanu natanu nawana, namakulakaji asatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
