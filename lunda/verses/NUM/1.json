        },
        {
          "text": "Akudi anyana kaSimeyona, mumakiŋu awu mwahita yisaka yawu; mwekalila mavumu awankakalula jawu, achindiluwu mwachindililuwu majina awamayala ejima, kunamutu kunamutu, kutachikila hadi anyaka makumi ayedi nakubadikamu, ayilaŋa kunjita ejima; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
