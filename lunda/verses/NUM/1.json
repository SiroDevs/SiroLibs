          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela akate-ekaŋa wejima wawu awa hohachilombu chawu, awa hohachilombu chawu, kumpandelu yawu, kumpandelu yawu, mwahitamajitawu. ",
          "type": "text",
          "attrs": {
