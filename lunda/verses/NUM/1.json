          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hakwila muchidi waLevi bayi wakawu chindaku, kuyichindila hamu nawanyana kaIsarela nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.49",
            "verseOrgIds": [
              "NUM.1.49"
            ]
          }
