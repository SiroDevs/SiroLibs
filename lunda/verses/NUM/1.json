              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova wahosheli, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.48",
            "verseOrgIds": [
              "NUM.1.48"
