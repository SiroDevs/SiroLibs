  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "NUM 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu hiyakutobatoba, Yehova watiyili chahosheluwu chatama; chachitiyiliyi Yehova wazuwili; kesi kaYehova kocheli mukachikawu, kanoŋesheli amakwawu kunsa yachilombu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.1",
            "verseOrgIds": [
              "NUM.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu abileleli kudi Mosi, Mosi walombeli kudi Yehova, kesi kajimini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.2",
            "verseOrgIds": [
              "NUM.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenoku atumbiluku ijina nawu kuTabera, nanochu chocheli kesi kaYehova mukachi kawu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.3",
            "verseOrgIds": [
              "NUM.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luntu lwawantu akwacheŋi nakwacheŋi adibombabombeli mukachi kawu, atachikili kutiya lwisu; anyana kaIsarela niwena nawa adilili makumbu, nawu, Wukutwinka mbiji hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.4",
            "verseOrgIds": [
              "NUM.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunaanuki inshi twadiilaŋa muEjipitu yakadi nindandu, nitutanda, nimachimpa, nimafu, nisapoli, nikanyenzi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.5",
            "verseOrgIds": [
              "NUM.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyichima yetu yatúuma dehi mumavumu chau, kwosi chuma chitunamoni nichimu, chiŋa yowu manina hohu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.6",
            "verseOrgIds": [
              "NUM.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manina adiŋi neyi masa, kuyitala adiŋi neyi chikwawusaŋa wutooka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.7",
            "verseOrgIds": [
              "NUM.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amwaŋelaŋa nakunona, ayihalilaŋa hamalola, ayitwilaŋa mumayanda, ayitelekelaŋa mwinuŋu, ayililaŋa mankendi, ivumba dayu dadiŋi neyimanji amaha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.8",
            "verseOrgIds": [
              "NUM.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaholokelaŋa wuumi hachilombu nawufuku manina aholokelelaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.9",
            "verseOrgIds": [
              "NUM.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi watiyili antu hiyakudila mwahita yisaka yawu, iwu hakudila kuchisu chetenti dindi, iwu hakudila kuchisu chetenti dindi, Yehova hakuzuwanankashi; Mosi atiya nikutama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.10",
            "verseOrgIds": [
              "NUM.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi hakumwila Yehova, nindi, Wunankoŋelidi ami kambuŋeyi chatama? Wunabulidi kuntoŋa, mwakawuntwiki chiteli chawantu ejimawa? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.11",
            "verseOrgIds": [
              "NUM.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami yami nemitili antu ejimawa? Yami nayivweli, mwaka winzi wuŋili neyi yeleki hantulu yeyi, neyi chelekapayinsemi mwana waamwapa, ninzi niyitwali kwituŋa diwasanyikililiankakulula jawu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.12",
            "verseOrgIds": [
              "NUM.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi ami mbiji yakwinka antu ejimawa nukuyiwanakudihi? Awa akundililawa nawu, Twinki mbiji tudyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.13",
            "verseOrgIds": [
              "NUM.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinatweshikweleka antu ejimawa kanka wamuku, chiteli chinasweji kulema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.14",
            "verseOrgIds": [
              "NUM.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi dichi chiwukuŋila, njahi tuhu kwami mwani, neyi wunantoŋuhu, indinimonaŋahu tuhu kwami ihuŋu didi chochichi!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.15",
            "verseOrgIds": [
              "NUM.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Mpompesheli awakulumpi awaIsarela makumi atanu nayedi, iwamona kwikala awakulumpi awantu, alema mukachika wakwawu; wuyishikŋi kwitenti dakubulakena, akemanuku chimu naneyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.16",
            "verseOrgIds": [
              "NUM.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuzelumuka nakuhanjika naneyi kwenakuna, kuspiritu yekala hadeyinukunonaku, nukusha hadi wena, kulonda akukwashi kusenda chisenda chawantu, wubuli kuchisenda kanka weyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.17",
            "verseOrgIds": [
              "NUM.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayili antu neyi, Dŋilikilenu nsaŋu yakumadiki, mwakadyi mbiji, muloŋa munadilili dehi kumatu aYehova, nenu, hinyi wukutwinka mbiji? Nenu, muEjipitu twadiŋi tuhukwetu chachiwahi. Dichi Yehova wakayinka mbiji, mwakadya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.18",
            "verseOrgIds": [
              "NUM.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Himwakadya ifuku dimu, hela mafuku ayedi, hela mafuku atanu, helamafuku ikumi, indi kwiji mafuku makumi ayeduku; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.19",
            "verseOrgIds": [
              "NUM.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiŋa kakwejikejima puchi chikupu, ninichi chiyakayofwoka mumazulu enu, himwa kayi tiyanikafulumba kumuchima; muloŋa munamúumbi dehi Yehova wekalamukachi kenu, munamudilili dehi yena, nenu, Twafumininidi muEjipitu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.20",
            "verseOrgIds": [
              "NUM.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi hakwila nindi, Awa antu nashakama nawu, chikaŋa mashidika hohuwowu adi makombakaji makulakaji atanu nadimu, wili neyi nukuyi nkambiji yakudya kakweji kejima chikupu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.21",
            "verseOrgIds": [
              "NUM.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuyŋahila nyikanka yampembina nyikoku naŋombi kulonda awanini tahindi? Indi ntahi akuyikuŋwilainshi jamukaluŋalwiji jejima kulonda awanini tahindi?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.22",
            "verseOrgIds": [
              "NUM.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumwila Mosi, nindi, Chikasa chaYehova chinakaŋanyi dehi komana? Wakatala munahoshi neyi mwakamwekana indi kwiji nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.23",
            "verseOrgIds": [
              "NUM.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wedi kili, walejeli antu mazu aYehova. Wapompesheli awakulumpi awantu makumi atanu nayedi wayimikili kwitenti kwi-ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.24",
            "verseOrgIds": [
              "NUM.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wazelu mukili mwivu, wahosheli nindi, kuspiritu yadiŋi hadi yena wanonenuku, wayishili hadi owu awakulumpi makumi atanu nayedi. Chelili spirituyinashiki dehi hadi wena, hiyakuprofweta chakukumishila hohenohu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa kuchilombu kwasheli amayala ayedi, wumu ijina dindi Eledadi, mukwawu ijina dindi Medadi; spiritu yashi kili hadi wena diwu owuasonekeluwu, ilaŋa wena kwitenti hiyayili kwoku. Wena aprofweteli muchilombu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.26",
            "verseOrgIds": [
              "NUM.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwenzi wumu wayili lufuchi nakuleja Mosi, nindi, Eledadi naMedadi hiyakuprofweta muchilombu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.27",
            "verseOrgIds": [
              "NUM.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaNuni Yoshuwa, kambanji kaMosi, mukwenzi wahadi atondeliyi, wahosheli nindi, Eyi mwanta wami Mosi, yilekeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.28",
            "verseOrgIds": [
              "NUM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka Mosi nindi, Wunatiyiichima hamujimba wamami? Neyi antu aYehova ejima adiŋi atuprofwetu, ayishila spiritu yindi, mutenowu o kuwaha! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.29",
            "verseOrgIds": [
              "NUM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wafuntili muchilombuniyena niakulumpi awaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.30",
            "verseOrgIds": [
              "NUM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi Yehova kwafumini mpepela yafumishili atupumbi kukalupalwŋi hiyi kuyiholwela kuchilombu, ishinadi dinu dachilombu kuleha neyi kwakwenda ifuku dimu, niishinadi di kwawu dachilombu kuleha neyi kwakwendaifuku dimu, chilombu chejima kwi-ndo, mudita wamulumba wawu wesekelimunkotweli jachikasa jiyedi kwiwulu neseki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.31",
            "verseOrgIds": [
              "NUM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu anyamukili nakukuŋula tuŋumbi mwaana wejimowu, niwufuku wejima, niifuku dalondelumu dejima. Wakuŋwili ngungungu ikumi diyi wakuŋwili yantesha. Ayanyikili chilombu chejima kwi-ndo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.32",
            "verseOrgIds": [
              "NUM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbŋi yichidi tuhu kumaji, nikuyitafunyatuhu kanda, Yehova wayizuwilili antu, Yehova wayeteli antu nachipúpucheneni nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
            "verseOrgIds": [
              "NUM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenoku atumbiluku ijina nawu, kuKibiroti Hatava; nanochu chiyajiikiluku antu adiŋi nalwisu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
            "verseOrgIds": [
              "NUM.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu endeli njilayawu, afumini kuKibiroti Hatava ayili kuHazeroti. Ashakamini kuHazeroti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.35",
            "verseOrgIds": [
              "NUM.11.35"
            ]
          }
        }
      ]
