  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "NUM 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaRubeni nianyana kaGadi adiŋi nayimuna yayivulunankashi. Chamwenuwu ituŋa daYazeri, netuŋa daGileyadi, kutalaku kwakuwahi kushakamaku nayimuna, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.1",
            "verseOrgIds": [
              "NUM.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "anyana kaGadi nianyana kaRubeni hiyakwinza nakuhosha naMosi, nakapristu Eleyazari, natulambatwachipompelu, nawu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.2",
            "verseOrgIds": [
              "NUM.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataroti, naDiboni, naYazeri, naNimira, naHeshiboni, naEleyale, naSebami, naNebo, naBeyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.3",
            "verseOrgIds": [
              "NUM.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "dodituŋa dalukukiliyi Yehova kumesu achipompelu chaIsarela, ituŋa dawayimuna, ninetu ambuŋeyitukweti yimuna. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.4",
            "verseOrgIds": [
              "NUM.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawu, Neyi wunatutoŋuhu mwani atwinki etuambuŋeyi ituŋidi diikali detu; bayi atuzambwisha Yodanaku.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.5",
            "verseOrgIds": [
              "NUM.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.5",
            "verseOrgIds": [
              "NUM.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayilili anyana kaGadi nianyana kaRubeni, nindi, Ana kwenuayi kunjita, enu mushakami kunu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.6",
            "verseOrgIds": [
              "NUM.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuzeyesheladi nyichima yawanyana kaIsarela akaŋanyi kuzambuka ayi mwituŋa danayinkiyi Yehova? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.7",
            "verseOrgIds": [
              "NUM.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi cheliluwu atata jenu hinayitemesheli afumi kuKadeshi Baraneya ayi nakutala ituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.8",
            "verseOrgIds": [
              "NUM.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wena chakandukiluwu muchinekinekicha Eshikoli, chamwenuwu ituŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.9",
            "verseOrgIds": [
              "NUM.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "azeyesheli nyichima yawanyana kaIsarela mwaka akaŋanyi kwijila mwituŋa dayinkeliyi Yehova. Yehova wazuwili, wasanyikili, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.10",
            "verseOrgIds": [
              "NUM.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Chalala kwosi iyala wafumini muEjipitu, washika munyaka makumi ayedi hela wamotokamu, wakamonaituŋa dinasanyikilili Abarahama naIsaka naYakobaku. Muloŋabulilikunlonda chikupu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.11",
            "verseOrgIds": [
              "NUM.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiŋa yowu mwana kaYefune Kalebi kaKenizi hohu, namwana kaNuni Yoshuwa, diwu akamonamu; nanochu chalondeluwu Yehova chikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.12",
            "verseOrgIds": [
              "NUM.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wazuwili naIsarela, wayikimbishili mwisaŋa nyaka makumi awana, ninichi chanoŋeluwu zo-o ikiŋu dawu dejima elilichatama kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.13",
            "verseOrgIds": [
              "NUM.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu ntahi, munahiŋi dehi mudi atata jenu, enu chitaŋa chanshidi, musaŋumuni cheŋi kuzuwa kwaYehova kwasweja kwakuzuwila aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.14",
            "verseOrgIds": [
              "NUM.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mukumushiya, niyena nawa wakayishi yacheŋi mwisaŋa, mwakajilisha tuhu antu awa ejima.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.15",
            "verseOrgIds": [
              "NUM.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.15",
            "verseOrgIds": [
              "NUM.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aswilili kwakwihi nayena, elili nawu, Tukutuŋa kunu mayinda ayimunayetu, ninyikala yawanyanetu anyanya; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.16",
            "verseOrgIds": [
              "NUM.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila etu kwetu tukumanye katu kutwamina kukuya anyana kaIsarela, nichi chitwamba kayishikŋa mwawu; anyanetu anyanya akashakami munyikala yampwembu kuchina antu ashakama mwituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.17",
            "verseOrgIds": [
              "NUM.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitwakafunta cheŋi kumataletuku, kufunta chiŋa anyana kaIsarela anatambuli dehi wejima wawu wuswanawawu, iwu nawindi, iwu nawindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.18",
            "verseOrgIds": [
              "NUM.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa etu kwetu hitwakaswaninahamu nawu kwishinadi daYodanaku, hela kumbidi; muloŋa wuswana wetutunawumoni dehi kwishinadi dinu daYodana kumusela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.19",
            "verseOrgIds": [
              "NUM.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.19",
            "verseOrgIds": [
              "NUM.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayilili nindi, Neyi mukwila mwenomu, neyi mukumanyekahi mukuya kumesu aYehova kunjita, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.20",
            "verseOrgIds": [
              "NUM.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi enu amayala ejima mwamanyeka dehi mukuzambuka Yodana kumesu aYehova, ninichi chamba katemunayi ayilumbu jindi kumesu indi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.21",
            "verseOrgIds": [
              "NUM.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "niituŋa hidinafwomoki dehi kumesu aYehova; nkumininaku henohu himwakafunta tuhu, himwakekalana muloŋa hela kudi Yehova, hela kudi aIsarelaku; niituŋa dinu dakekaladenu kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi kwonti kwenu, komana muna muvulumuni dehi Yehova; ilukenu nenu nshidi yenu yakayishintakesha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.23",
            "verseOrgIds": [
              "NUM.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuŋenu nyikala yawanyanenu anyanya nimayinda anyikoku yenu; mwakeli chimunahoshi namutunwa twenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.24",
            "verseOrgIds": [
              "NUM.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.24",
            "verseOrgIds": [
              "NUM.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaGadi nianyana kaRubeni amwilili Mosi, nawu, Etu ambuŋeyitwakela mwanatulejiyi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.25",
            "verseOrgIds": [
              "NUM.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni anyanetu anyanya, niaŋodŋetu, ninyikoku yetu, niyimuna yetu yejima, yakashala kuna kunyikalaya Gileyadi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.26",
            "verseOrgIds": [
              "NUM.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila etu ambuŋeyi tukuzambuka, etu amayala ejima twamanyeka dehi yanjita, tukuya kumesu aYehova kunjita, mwanahoshiyimwanta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi washiikili kapristu Eleyazari, namwana kaNuni Yoshuwa, nawanyanta amavumu awankakulula janyichidi yawanyana kaIsarela, hansaŋu yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.28",
            "verseOrgIds": [
              "NUM.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wayilili nindi, Neyi anyana kaGadi nianyana kaRubeni akuzambuka Yodana chimu nenu, amayala amanyeka dehi yanjita, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.29",
            "verseOrgIds": [
              "NUM.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumesu aYehova, niituŋa hidakafwomoka kumukuyenu; henohu mwakayinka ituŋa daGileyadi akadiheti; kwinza neyi akaleka kumanyeka nakuzambukanenu hamu, akatambula mpata jawu hamu nenu mwituŋa daKenani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.30",
            "verseOrgIds": [
              "NUM.32.30"
            ]
          }
        }
      ]
    },
    {
