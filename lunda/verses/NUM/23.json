  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "NUM 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wamwilili Balaki, nindi, Ntu ŋili kunu tumeŋa tutanunatuyedi, wunloŋesheli kunu aŋombi amayala atanu nayedi, niyizamba yanyikoku yitanu nayiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki welili mwomwahosheliyi Balami. Balaki naBalami ashitili hakameŋa ŋombi namukoku, tumeŋatwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.2",
            "verseOrgIds": [
              "NUM.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wamwilili Balaki, nindi, Imanaku kuhimulambu weyiwakushita, ami niyi, hadaha Yehova wukwinza nakumbulakana. Mwakanlejayimwejima nakakulejamu. Wayili hachinaŋanaŋa chankumbu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wabulakeni naBalami, Balami wamwilili nindi, Naloŋeshi dehi tumeŋa tutanu natuyedi, nashiti dehi hakameŋa ŋombi namukoku, tumeŋatwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova washili izu mukanwa kaBalami, nindi, Funtaku kudi Balaki wakahoshaŋa mwomwenomu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.5",
            "verseOrgIds": [
              "NUM.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafuntili cheŋi kudi yena, wamuwenisaŋa emenayi kuhimulambu windi wakushita, niyena natulamba twaMowabi twejima.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.6",
            "verseOrgIds": [
              "NUM.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.6",
            "verseOrgIds": [
              "NUM.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakwatili kuchishimu chindi, nindi, Balaki wanfumishili kuArami, mwanta wakuMowabi wanfumishili kumpidi jakumusela. Nindi, Twayawunshiŋili Yakoba, twaya wunzuwili Isarela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.7",
            "verseOrgIds": [
              "NUM.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi ami nukushiŋa ŋahianabuli kushiŋayi Nzambi? Nukuzuwila ŋahi anabuli kuzuwilayi Yehova? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.8",
            "verseOrgIds": [
              "NUM.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunu kwiwulu damalola namumoni, kunu kwiwulu dampidi namutali. Talenu hiyantu ashakama kanka wawu, hiyakayibomba hamu nanyuzaku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.9",
            "verseOrgIds": [
              "NUM.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinyi natweshi kuchinda lunkuŋu lwaYakoba hela kuchinda chibalu chaIsarela chamuchiwana? Nifwi kwami neyi chafwaŋawu aloŋa, nikumishikwami mwakumishaŋawu!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.10",
            "verseOrgIds": [
              "NUM.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki wamwilili Balami, nindi, Wunaŋili ŋahi? Ami nakukambilinami wunshiŋili ayilumbu jami, tala ntahi wunayikiswili dehi nkisu chikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka yena nindi, Ochu nibuli kusha muchima wakuhosha izu dananshiliyi Yehova mukanwa, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki wamwilili nindi, Tuyi neyi mwani kwacheŋi wakayimwenuku. Wakamona kwanakuminuwu hohu, kuyimona wejima wawu nehi; wakanshiŋiluwukwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamutweli mumpata yaZofwimi hewulu daPisiga, watuŋili tumeŋa tutanu natuyedi, washitili ŋombi weyala nichizambachamukoku hakameŋa, hakameŋa, tumeŋa twejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamwilili Balaki, nindi, Imanaku kunu kuhimulambu weyi wakushita, niyi nimubulakani Yehova kuna. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.15",
            "verseOrgIds": [
              "NUM.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wabulakeni naBalami, washili izu mukanwa kindi, nindi, Funtaku kudi Balaki, wakahoshaŋa mwomwenomu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
            "verseOrgIds": [
              "NUM.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenjili kudiyena, wamuweni saŋa emenayi kuhimulambu windi wakushita natulambatwa kuMowabi hamu. Balaki wamwilili nindi, Yehova nahoshi nindidi?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.17",
            "verseOrgIds": [
              "NUM.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.17",
            "verseOrgIds": [
              "NUM.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakwatili kuchishimu chindi, nindi, Eyi Balaki nyamukaku wutiyi; ntiyilili eyi mwana kaZipori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.18",
            "verseOrgIds": [
              "NUM.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi himuntuku mwaka atwambi; himwana kamuntuku mwaka abalumuki mumuchima. Nahoshi dehi, abuli kwilamu? Nahoshi dehi, abuli kukoleshamu? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.19",
            "verseOrgIds": [
              "NUM.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami anyinka dehi mudimu wakukisula. Yena wakisula dehi, indi ami nukubalumunamu ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.20",
            "verseOrgIds": [
              "NUM.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hanamoni kuluwa mudi Yakoba hela kubajama mudi Isarelaku; Yehova Nzambi yindi wudi nindi, mbila yamwanta walukanu adi nayu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi hakuyifumisha muEjipitu; wukweti ŋovu yakweseka naŋombi yampata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.22",
            "verseOrgIds": [
              "NUM.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikudi kusansa nyiseŋu yakusansila Yakobaku, hikudi helaŋombu yakumuhoŋa Isarelaku. Ichi chakatenawu Yakoba naIsarela akelanawu, Talenu chanakoŋiyi Nzambi! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.23",
            "verseOrgIds": [
              "NUM.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu owu antu hiyakunyamuka neyi chanyamukaŋa mukaji wamutupa, hiyakudolola neyi chadololaŋayi iyala damutupa. Kukambama chiŋa nadyi dehi mbiji, chiŋa nanwi dehi nimashi akanyama anakwatiyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.24",
            "verseOrgIds": [
              "NUM.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.24",
            "verseOrgIds": [
              "NUM.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki wamwilili Balami, nindi, Hela kushiŋa bayi wuyishiŋa nihantuku, hela kukisula bayi wuyikisula nihantuku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Balami wamwakwili Balaki, nindi, Hinakulejeli nami chiŋa nila mwejima mwakahoshayi Yehovaku? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki wamwilili Balami, nindi, Twaya tuyi, nikutwali kwacheŋi. Wamba kela Nzambi wukutiya kuwaha nindi wunshiŋiluwu kwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
