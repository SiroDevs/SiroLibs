          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwenilu dilu lushimbi lwakaNaziri wukudishiila, nilwamulambu wukuhimulambu layi Yehova wakwambuka kwakaambukayi, kulunjikahu niniyiyanamoniyi; mwahita kudishiila kwadishiililiyi dimu mwakwilayi, mwomwayalushimbi lwakwambuka kwakaambukayi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
