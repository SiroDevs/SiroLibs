  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "NUM 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami chamweniyi Yehova natiyi kuwaha kukisula Isarela, hayilina kuhoŋa neyi chayilaŋayi hakusambilaku, ilaŋa watalishili mesuindi kwisaŋa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wafumbwili mesu indi, wamweni aIsarela anashakami mwomwekalila nyichidi yawu. Spiritu yaNzambi wenjili hadiyena.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakwatili kuchishimu chindi, nindi, Balami mwana kaBeyori nahoshi, iyala wadiŋi wajima mesu nahoshi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "watiyaŋa mazu aNzambi, wamonaŋachimwenu chaChinaweji hakudimbuka nihamaseki, hakutona nimesu, nahoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yakoba o matenti eyi kuwaha! Eyi Isarela, o matabanaka eyikuwaha! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaditanjiki neyi chikwayinekineki, neyi chikwamatempa amumukulishu wakaloŋa, neyi chikwamakondi anatumbiyi Yehova, neyinyisida yekala kumeji. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munswaha jindi mwakahuŋunukaŋa meji; anyanindi akatuŋa kutuloŋa twatuvulu; mwanta windi walukanu wakabadi kaAgagi, wanta windi wakalema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi hakumufumisha muEjipitu, Ŋovu yindi yidi neyi yaŋombi yampata; nyuza yawakwankunyi nindi wakayidya kwindi, wakayikotola mafwahawu kotu-kotu, wakayilokolanansewu jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabutameni, wakambamini, neyi chikweyala damutupa, neyi chikwamukaji wamutupa; wakamuhindwisha hinyi? Yowuwakakukiswileyi nkisu wakakisulewa, yowu wakakushiŋeyi wakashiŋewa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki hakuzuwa naBalami, hakweta mumakasindi pwa. Balaki hakumwila Balami, nindi, Ami nakutambikili nami wunshiŋili ayilumbujami, tala ntahi eyi wunayikisuli dehi chacheni mapampa kasatu aka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.10",
            "verseOrgIds": [
              "NUM.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu temukaku wuyi kumukala weyi. Nelili nami nukukulemeshanankashi, ilaŋa Yehova nakukaŋeshi kumona kulema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wamwilili Balaki, nindi, Nahosheli nawantemesha jeyi iwantemesheleli namidi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinahosheli nami, Hela neyi Balaki wukunyinka itala dindi denzalato-o nasiliva nawuru, hinakatwesha kumotoka izu daYehova nakwila helachachiwahi hela chatama chakumuchima wamuku? Hinelili nami nakahoshamwomwaka hoshayi Yehovaku? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu yami nukuyawa kudi awusoku wami. Twa ya nikushimwini antu awa chamba kakoŋawu antu eyi kunyaka yakukuminina.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakwatili kuchishimu chindi, nindi, Balami mwana kaBeyori nahoshi, iyala wadiŋi wajima mesu nahoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watiyaŋa mazu aNzambi, welukamaana aMukwakubadika Kwiwulu, wamonaŋa chimwenu chaChinaweji hakudimbuka nihamaseki, hakutona nimesu, nahoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.16",
            "verseOrgIds": [
              "NUM.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namumoni, ilaŋa hikatatakaleu; namutahilaŋa hikwakwihuku. MuYakoba mwambakasoloka katumbwa, muIsarela mwamba kanyamuka ndonda, yaketa mwahita imbaŋu jaMowabi, yakanonesha nyana kaSheti yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.17",
            "verseOrgIds": [
              "NUM.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomi akatambula kwawu yakekala yawu; aSeyiri ayilumbu jindi nawa akayitambula akekala yawu; hakwila Isarela wakakoŋaŋa yawulobu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.18",
            "verseOrgIds": [
              "NUM.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuYakoba mwakafuma wumu wakela mwanta, wakanoŋesha akashala munyikala.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.19",
            "verseOrgIds": [
              "NUM.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.19",
            "verseOrgIds": [
              "NUM.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watalilili kudi Amaleki, hakukwata cheŋi kuchishimu chindi, nindi, Amaleki diyi wásambilili hanyuza; hela chochu kukuminina kwindi yowukujilumuka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watalilili kudi aKeni, hakukwata cheŋi kuchishimu chindi, nindi, Muwashakama mwakola, chisakala cheyi achisha mwilola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
              "NUM.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helachochu Kena akamujilisha, ninichi chamba kakutwalawu kudi Ashuri muwukoli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.22",
            "verseOrgIds": [
              "NUM.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakwatili cheŋi kuchishimu chindi, nindi, Yowe! chambakakoŋayi Nzambi yumiyi wamba kahanda hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.23",
            "verseOrgIds": [
              "NUM.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa maatu ambakafuma kuchi kumu chaKitimi, amba kakabisha Ashuri, amba kakabisha Eberu, niyena nawa wamba kajilumuka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.24",
            "verseOrgIds": [
              "NUM.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.24",
            "verseOrgIds": [
              "NUM.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balami wanyamukili, wayili kwindi, wafuntili kumukala wawu. Balakiniyena wadiyilili kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.25",
            "verseOrgIds": [
              "NUM.24.25"
            ]
          }
        }
      ]
    }
