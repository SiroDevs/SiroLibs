          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "himulambu waYehova wanyikoku wadiŋi makulakaji atanu nadimu namakumi atanu nayedi nayitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
            "verseOrgIds": [
              "NUM.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋombi adiŋi makombakaji makumi asatu natanu nadimu; kunonamu himulambu waYehova makumi atanu nayedi, nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
              "NUM.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayimbulu adiŋi makombakaji makumi asatu namakulakaji atanu; kunonamu himulambu waYehova makumi atanu nadimuna chimbulu wumu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
