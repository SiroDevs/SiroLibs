          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu himulambu, wowu himulambu waYehova wakuleleka, Mosi wawinkeli kapristu Eleyazari, mwomwalejeluwu Mosi kudi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
