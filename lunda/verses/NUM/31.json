          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "antu kuyibombaejima, wowambanda abulili kukamahu dehi neyala, makombakaji makumi asatu namakombakaji ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
