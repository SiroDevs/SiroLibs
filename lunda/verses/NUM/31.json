          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "aŋombi makombakaji makumi atanu nayedi, namakombakaji ayedi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.33",
            "verseOrgIds": [
