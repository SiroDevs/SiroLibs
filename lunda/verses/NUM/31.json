          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMosi nakapristu Eleyazari atambwili wuruwawu, yuma yakuchila chila chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuru wejima wamulambu wakuleleka wamulambwiluwu Yehova, walambwiluwu anyanta amakombakajina wanyanta amakulakaji, wadiŋi jishekeli makombakaji ikumi natanunadimu, namakulakaji atanu nayedi namakumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu ayilobu anjita adipupila dehi yuma yawu, muntu nayindi, muntu nayindi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMosi nakapristu Eleyazari atambwili wuru kudi awakulumpi amakombakaji namakulakaji awuleteli mwitenti dakubulakena, wakudi anyana kaIsarela wakwanukanachu kumesu aYehova.",
          "type": "text",
