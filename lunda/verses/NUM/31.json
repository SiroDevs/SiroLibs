          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chibalu chahafu, dodiseka dawantu ayili kunjita, kudichinda dashikili munyikoku makombakaji makulakaji asatu, namakombakaji makumi asatu natanu nayedi, namakulakaji atanu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
            "verseOrgIds": [
              "NUM.31.36"
            ]
          }
        },
        {
