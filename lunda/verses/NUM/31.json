          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunaleti himulambu waYehova wayuma yanamonuwu amayala ejima, yuma yawuru, tumaleŋi, nanyibulu, natuzeya, natuyingelingeli twakumatu, niyijiŋu, yakubuta nachu nyichimayetu kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
