    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.27",
            "verseOrgIds": [
              "NEH.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niantu asheluku, atupristu nawaLevi, nawakwakuhemba kuyisu, nawakwakwimba tumina, nawaNetini, kafwampi ejima adambwili munyuzayamumatupa kulonda akundami kunshimbi jaNzambi, niapodi jawu, nianyanawu amayala nawambanda, kafwampi ejimawu adiŋi nama ana nakashinshi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "wena akakeleli ana kwawu atulamba twawu, liyakudishiŋa nikusanyika, nawu, Tukwenda munshimbi jaNzambi jatwinkeluwu kudi kambuŋa-Nzambi Mosi, tukushaku muchima, tukwila kuleja kwaMwanta wetuYehova kwejima, niwuŋaji windi, niyidika yindi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "antu amwituŋa hitukuyinka anyanetu awambanda, hela kutambula anyanawu ekali aŋodi jawanyanetuku.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi antu amwituŋa akaleta hela yuma hela yakudya yakulandisha hefuku dasabata, hitwakalanda kudi wena hela hasabata, hela hefuku dajilaku; mumwaka wamu chitanu nachiyedi twakalekakutambula nyikudi yejima yatudiilawu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukuditwika chidika chakudifutisha hamwaka hamwaka chibalu chamuchisatu chalushekeli chamudimu wetala daNzambi yetu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "chamankendi akutenteka kumesu aNzambi, nichamulambu wawuŋa wahefukuhefuku, nichamulambu wakushita wahefuku hefuku, niwajisabata, niwatukwejitwatwiha, nichayawija yakushiika, nichayuma yajila, nichanyilambu yahanshidi yakubutaŋa nachu aIsarela, nichanyidimu yejima yetala daNzambi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukusakulaŋa navinjikijilu niatupristu, niaLevi, niantu, akuletaŋa himulambu wanchawa mwitala daNzambi yetu, mwahitamavumu awankakulula jetu, hohamafuku akuyishiikawu ahamwaka hamwaka, kulonda kulibutulaŋa hakameŋa kaYehova Nzambi yetu mwanasonekuwumunshimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twakaletaŋa hamwaka hamwaka kwitala daYehova niyakudya yatachi yamumahetu, nivakudya yatachi yanyikabu yejima yanyitondu yejima, yeŋi nayeŋi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twakaletaŋa kwitala daNzambi yetu kudi atupristu akalakalaŋa mwitala daNzambi yetu, niawedi awanyanetu amayala, niavimuna yetu, mwanasonekuwu munshimbi, niawedi akumataŋa etu, niakumayindetu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "twakaletaŋa kudi atupristu kumatala amwitala daNzambi vetu, niwuŋa wetu wakusambila wutwakafupa, ninyilambu yetu yakuleleka, niyikufuma kunyitondu yanyikabu yejima yejina yeŋi, yoyu vinyu namanji; twakaletelaŋa aLevi niyamwikumi yakumahetu, muŋa wena aLevi diwu atambulaŋa yamwikumi munyikala yejima kutwadimapa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu mwana kaAroni wakekalaŋa hamu nawaLevi hakutambulaŋawu aLevi yamwikumi. ALevi niwena akatwalaŋa yamwikumi yayamwikumi kwitala daNzambi yetu, kumatala adumu, mwitala dakuswekela yuma yalema. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nyana kaIsarela nianyana kaLevi akaletaŋa himulambu wakuleleka wakudya kwansaachi, niwavinyu, niwamanji, mumatala mwekala yuma yamumalala, mwekala niatupristu akalakalaŋa, niakwakuhemba kuyisu, niakwakwimba tumina. Hitwakaleka itala daNzambi yetuku.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
      ]
    }
  ],
