      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufumisha hanyinkeluwu wunguvulu wamwituŋa daYuda mumwakawamakumi ayedi, nakushika kumwaka wamakumi asatu nakayedi wamwanta Aratasheshe, kafwampi nyaka ikumi nayiyedi, hela ami hela ana kwamihitunasumi kuyakudya yawunguvuluku. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anguvulu akusambila eliliami kanda, akabishilaŋa antu nanyilambu, atambwilaŋa kudi wena niyakudyaivinyu, nijishekeli makumi awana nawa, hela tuhu aŋamba jawu adiŋi nakudinka wanta nawantu. Ami kwami kwila mwenomu nehi, muloŋawakumutiya Nzambi woma.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, ami nakakeleli kumudimu wampwembu iyi, hitwalandilihoku hela ihaku. Aŋamba jami ejima ahwililili kumudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumesayami kwashakaminaŋa aYudeya nawanyuli nkulakaji yawantu namakumi atanu, kulunjikaku niafumini munyuza yatunyeŋumukili. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.17",
            "verseOrgIds": [
              "NEH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudya kwaloŋeshelawu kwefuku dimu, ŋombi wumu, ninyikoku yanuna yitanunawumu, aloŋeshelaŋa nitujila nawa; nivinyu yeŋi nayeŋi, mafuku ikumikamu, mafuku ikumi kamu; mwejimimu hinayilejeli antu kunletela yakudya yawunguvuluku, muloŋa wuduŋu wayiswejeleli antu awa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Nzambi yami ntoŋuhu yayiwahi nayuma yejima yinayili awa antu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
    }
