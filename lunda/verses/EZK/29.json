          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku odu nakamenesha luseŋu kumuchidi waIsarela, nakakujikula kukanwa mukachi kawu. Akeluka nawu yami Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.21",
            "verseOrgIds": [
              "EZK.29.21"
            ]
          }
        }
