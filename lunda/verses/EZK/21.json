      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.1",
            "verseOrgIds": [
              "EZK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, talisha mesu eyi kuYerusalema, wushimuni izu deyi nakutalisha kumalala, wuprofweti nsaŋu jakuzuwila ituŋa daIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.2",
            "verseOrgIds": [
              "EZK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wili ituŋa daIsarela neyi, Yehova nindi, Tiya, ami nidi neyi nandombu, nakasomona mpoku yami yakabali muchindalu chayu, antu eyi aloŋa niatama nakayifumishahu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.3",
            "verseOrgIds": [
              "EZK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanochu chinakafumishahu antu eyi aloŋa niatama, dichi chiyakafumina mpoku yami yakabali muchindalu chayu, hiyakalotokela niantu ejima, kufumisha kukabeta kakuchidiilu, ndo nikukabeta kakuchimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.4",
            "verseOrgIds": [
              "EZK.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima akeluka nawu ami Yehova naholi dehi mpoku yami yakabali muchindalu chayu, hiyakafunta nawa cheŋuku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.5",
            "verseOrgIds": [
              "EZK.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.5",
            "verseOrgIds": [
              "EZK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi mwana kamuntu, dishishimuni. Dishishimuni kumesu awu chakuketuka nyima hakachi ngwa, chakutiya kumuchima kulula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.6",
            "verseOrgIds": [
              "EZK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakakwihulawu nawu, Wudi nakudishishimunadi? eyi wakayili neyi, Nidi nakudishishimuna nsaŋu, muloŋa yidi nakwinza. Nyichima yejima yakanowa, makasa ejima akalepuka, nispiritu jejima jakazeya, niantu ejima akatiya mumanuŋu zo-o neyi meji. Tiyenu, hiyikwinza, yakakoŋewa hohu. Dimu mwanahoshiyi Mwanta Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.8",
            "verseOrgIds": [
              "EZK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, profwetaku neyi, Yehova nindi, Mpoku yakabali, mpoku yakabali, ayihotola dehi, ayilezumwisha dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.9",
            "verseOrgIds": [
              "EZK.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anayihotoli kulonda yakajahani. Anayilezumwishi kulonda yakekali neyi nzaji. Tuzaŋajali nawa? Nkunyi yamwanami, diyi yikusekesha nyitondu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.10",
            "verseOrgIds": [
              "EZK.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anayihani dehi kulonda akayilezumwishi, kulonda akayikwati muchikasa, mpoku yakabali oyu anayihotoli, eŋa, anayilezumwishi kulonda akayihani muchikasa chamukwakutaŋana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.11",
            "verseOrgIds": [
              "EZK.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi mwana kamuntu, bilelaku nakukaloka nyiteti, muloŋa yinawani dehi antu ami, yinawani dehi tulamba twejima twawaIsarela. Anayihani dehi kumpoku yakabali hamu nawantu ami. Dichi etaku muchikasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.12",
            "verseOrgIds": [
              "EZK.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kudi kweseka. Indi neyi nkunyi yasekeshaŋa nyitondu yikwawu kwikalaku nawa nehi, tukwila ŋahi? Dimu mwanahoshiyi Mwanta Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.13",
            "verseOrgIds": [
              "EZK.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.13",
            "verseOrgIds": [
              "EZK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi eyi mwana kamuntu, profwetaku, weti mumakasa pwa, mpoku yakabali yitaŋani kayedi nikasatu, yoyi mpoku yataŋanaŋa chakujahana, mpoku yasweja kutoha, yataŋanaŋa chakujahana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natalishi dehi insa yampoku kuyisu yejima yampwembu jawu, kulonda nyichima yawu yakanowi, nikudimboka kwawu kwakavuli. Iyayi! Oyi mpoku yela dehi neyi nzaji, ayitwisha dehi kulonda yŋahani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.15",
            "verseOrgIds": [
              "EZK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaku hela iku hela iku, hela kuchidiilu hela kuchimunswa, kwonsu kuwunatalishi mesu kwoku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.16",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninami naketa mumakasa pwa, nakawanisha kulendumuka kwami. Ami Yehova nachihoshi dehi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili nawa cheŋi kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, fuukulaku njila jiyedi jakwinjila mpoku yakabali yamwanta wakuBabiloni; mujiyedi jakafuma mwituŋa dodimu. Funjikaku chuma chakuleja nachu njila, chifunjiki kumaakenu anjila yaya kumukala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuukulaku njila yakwinjila mpoku yakabali kuRaba wawanyana kaAmoni, nikuYuda muYerusalema ahatawu dehi mpwembu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mwanta wakuBabiloni wemeni haambukila njila, hamaakenu anjiloju jiyedi, kulonda ahoŋi. Hakunyinkesha nyivu, hakwihula nkishi jakuŋanda, hakutala mumuchima wakanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchikasa chindi chachidiilu mwadiŋi chuma chakuhoŋesha Yerusalema, kulonda emiki yuma yakusanda nachu mpwembu, kulonda aasami mukanwa, ataŋani, atwali kwiwulu izu dakudikuwa, ashi yuma yakusanda nachu mpwembu kuyisu yampwembu, adiminuku nyilundu, atuŋi mpwembu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wawena adishiŋili asanyikili, akamona kuhoŋoku neyi kwamukunkulwayi; ilaŋa yena wakaanukisha kuluwa kulonda akayikwati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Mwanta Yehova nindi, Ochu chimunaanukishi kuluwa kwenu, ninochu chinamwekani dehi nyiloŋa yenu, nichinamwekani nshidi jenu muyuma yejima yimwelaŋa, ochu chanayanukuwu dehi, komana akayikwata namakasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineyi ataŋawu dehi chakukujaha hohu, eyi watama, eyi kalamba kaIsarela, wukweti ifuku dinenzi dehi, mumpinji yakuluwa kwakukuminina, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiya chanahoshiyi Mwanta Yehova, nindi, Fumishaku makonku, fumishaku chibaŋula; yuma hiyakekala nawa cheŋi muyadiŋuku, chuma chadiŋi kwishina achitwali kwiwulu, chadiŋi kwiwulu achitwali kwishina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
            "verseOrgIds": [
              "EZK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakantumuna, nakakantumuna, nakakantumuna, chumichi hichakekala nawa kwoku, chiŋa mwenichiyulu chindi nenzi dehi, ninami namwinkichu dehi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
              "EZK.21.27"
            ]
          }
        }
      ]
    },
