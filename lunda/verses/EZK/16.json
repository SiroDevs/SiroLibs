          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nakakolesha chitiyaŋenu chami naneyi. Wakeluka neyi yami Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.16.62",
            "verseOrgIds": [
