    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kamuntu, profwetaku nsaŋu jakuprofweta mpidi jamuIsarela, neyi, Enu mpidi jamuIsarela, tiyenu izu daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.1",
            "verseOrgIds": [
              "EZK.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Yehova nindi, Ochu chayilayi dehi chilumbu nindi, Lelo! cheŋi nawa nindi, Yinaŋanaŋa yakufumisha kunyaka yela dehi yetu, twayiheta dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.2",
            "verseOrgIds": [
              "EZK.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi profwetaku neyi, Mwanta Yehova nindi, Mwalala, ochu chanayibalumunuwu kwikala mahembi hohu, chanayiminyuwu niniku niniku, kulonda akayihetaŋa kudi nyuza yinashaluku, chakuyitenawu nanyivumbu yawakwakuhoshahosha, nichimunatiyakani mpuhu yatama kudi nyuza yawantu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.3",
            "verseOrgIds": [
              "EZK.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi enu mapidi amuIsarela, tiyenu izu daMwanta Yehova. Mwanta Yehova hakuyila mpidi, nitupidi, ninyihoŋi, niyinekineki, niyinkalampata, ninyikala yinabúuki dehi antu, yakwatawu dehi, yasehawu dehi kudi nyuza yawantu yina nyeŋu mukuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.4",
            "verseOrgIds": [
              "EZK.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Mwanta Yehova nindi, Chalala nahoshi nakesi kamukawu wami, nayihoshi nyuza yinashaluku, niaEdomi ejima anasakeni dehi ituŋa dami, nawu diikali dawu nakuluŋa kwanyichima yawu yejima, nanyichima yakasawuntu kulonda adinati adikwatakwati kudi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.5",
            "verseOrgIds": [
              "EZK.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi profwetelaku ituŋa daIsarela wili mapidi, nitupidi, ninyihoŋi, niyinekineki, neyi, Mwanta Yehova nindi, Nahoshi namukawu wami, nakulendumuka kwami, muloŋa munatiyi nsonyi yatiyaloŋa nyuza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.6",
            "verseOrgIds": [
              "EZK.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Mwanta Yehova nindi, Ami nololi chikasa chami kwiwulu, nami, Chalala nyuza yayinyeŋumuka yakatiya nsonyi jawu niwena.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.7",
            "verseOrgIds": [
              "EZK.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.7",
            "verseOrgIds": [
              "EZK.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mpidi jamuIsarela, mwakasemena antu ami aIsarela nyitayi, mwakayisoŋela nyikabu yenu; muloŋa adi kwakwihi nakwinza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.8",
            "verseOrgIds": [
              "EZK.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu tiyenu, ami niwenu, nakabalumuka, nakatala kudenu, akayidima, akatumbamu nimbutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.9",
            "verseOrgIds": [
              "EZK.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadenu nakavulishahu antu akwamutaŋa waIsarela ejima, mwalala wejima wawu; munyikala mwakashakama antu, kuyinkalampata kwakatuŋa antu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.10",
            "verseOrgIds": [
              "EZK.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadenu nakavulishahu niantu nianyama. Akavula, akasemununa. Hadenu nakashakamisna antu neyi chadiŋuwu hakusambila, nakayila mwamuwahi kubadika chimwamweni hakusambila. Mwakeluka nenu yami Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.11",
            "verseOrgIds": [
              "EZK.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalala hadenu nakendeshahu antu, wowu antu ami aIsarela. Akayiheta, mwakekala wuswana wawu, himwakayibonda nawa cheŋi anyanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.12",
            "verseOrgIds": [
              "EZK.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Yehova nindi, Ochu chakuyilawu nawu, Eyi wumukwakudya antu, wadiŋi mukwakubonda muza weyi anyana wu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.13",
            "verseOrgIds": [
              "EZK.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi hiwakadya cheŋi antuku, hiwakabonda nawa cheŋi muza weyi anyanaku. Dimu mwanahoshiyi Mwanta Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.14",
            "verseOrgIds": [
              "EZK.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.15",
            "verseOrgIds": [
              "EZK.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili cheŋi kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.16",
            "verseOrgIds": [
              "EZK.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, chashakaminuwu akwamutaŋa waIsarela mwituŋa dawu, aditamishili nayaaku yawu nayuma yelilaŋawu. Yaaku yawu nayimweni yidi neyi majilu amumbanda wudi kwitala dikwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.17",
            "verseOrgIds": [
              "EZK.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nayiichililili kulendumuka kwami nansaŋu yamashi amwaŋiluwu mwituŋa, nanochu chaditamishiluwu nawakishi awu akutuŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.18",
            "verseOrgIds": [
              "EZK.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "hinukuyiŋalaŋesha nimunyuza, hinukuyimwaŋila mwahita matuŋa, hinukuyisompesha mwaya yaaku yawu, nimwaya yuma yelilaŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.19",
            "verseOrgIds": [
              "EZK.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chashikiluwu munyuza mwayiluwu hiyakujilola ijina dami dajila, nanochu chayitenenuwu nawu, Awa hiyantu aYehova, anafumi mwituŋa dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.20",
            "verseOrgIds": [
              "EZK.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mi natiyili luwi Iwejina dami dajiloleluwu akwamutaŋa waIsarela munyuza mwayiluwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi yili akwamutaŋa waIsarela, neyi, Mwanta Yehova nindi, Enu akwamutaŋa waIsarela, chumichi hinidi nakuchilila hansaŋu yenuku, nidi nakuchilila hansaŋu yejina dami dajila dimunajiloli munyuza mumwayili.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.22",
            "verseOrgIds": [
              "EZK.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.32",
            "verseOrgIds": [
              "EZK.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Yehova nindi, Ifuku dinakayitookesha kuluwa kwenu kwejima, nakashakamisha antu munyikala, nakatuŋisha antu muyinkalampata.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.33",
            "verseOrgIds": [
              "EZK.36.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.36",
            "verseOrgIds": [
              "EZK.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Yehova nindi, Akwamutaŋa waIsarela amba kaŋihula chumichi kulonda nakayikoŋelichu. Nakavulisha antu awu neyi mukanka wayimuna.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.37",
            "verseOrgIds": [
              "EZK.36.37"
            ]
          }
        }
      ]
