              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mama yeyi wudi neyi muvinyu wamwitempa danyivinyu, anamutumbulwila kumeji. Wasopeli nyikabu, wasemeni nyitayi nameji amavulu adiŋuku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
