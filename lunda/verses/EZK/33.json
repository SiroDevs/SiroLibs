          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.23",
            "verseOrgIds": [
              "EZK.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi mwana kamuntu, owu ashakama muna muyinkalampata yidi mwituŋa daIsarela, adi nakuhosha nawu, Abarahama wadiŋi wumu wasweneni ituŋa. Etu tudi amavulu, ituŋodu anatwinki dehi etu dawuswana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.24",
            "verseOrgIds": [
              "EZK.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kayili neyi, Mwanta Yehova nindi, Enu mwadyaloŋa mbiji yikweti mashi, mwafumbulaŋa mesu enu kudi akishi enu akutuŋa, mwapwekeshaŋa mashi, enu muswani ituŋa?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.25",
            "verseOrgIds": [
              "EZK.33.25"
            ]
          }
        }
      ]
    }
