              "EZK.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu kulema kwaYehova kwanyamuka dehi kukerubi kukwadiŋi, kwaya dehi mbadi yeluŋa dakuchisu chetala. Hakutambika owu iyala wavweli mahina amawahi, wadiŋi naluseŋu lwawulombu lwamukwakusoneka mumbunda yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.3",
            "verseOrgIds": [
              "EZK.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumwila nindi, Hitaku mukachi kamukala, mukachi kaYerusalema, wufundi mufunda hamahama awantu ejima adi nakushikoka nakudila nayishimashima yejima yadi nakukoŋakoŋawu mukachi kawu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila akwawu, iku nidi nakutiya, nindi, Kahitenu mumukala, mwakamulondeli nakutaŋa antu. Disu denu bayi daka anakena muntuku, bayi mwakatiya luwuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.5",
            "verseOrgIds": [
              "EZK.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kajilumunenu chikupu nimukulumpi nimukwenzi, nichaŋadima, nianyana anyanya, niambanda. Ilaŋa bayi mwaka kundama kwakwihi namuntu wukweti mufundaku; mwakatachikila kuma lalami. Hiyakutachikila kudi awakulumpi adiŋi kumesu etala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.6",
            "verseOrgIds": [
              "EZK.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Tamishenu itala, mwakenzeshi muyiŋaŋu nawafu mwakajaha. Idikenu, muyi. Hiyakwidika, hiyakuya nakutaŋa antu mumukala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.7",
            "verseOrgIds": [
              "EZK.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
