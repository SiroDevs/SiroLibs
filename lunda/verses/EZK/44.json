    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunfuntisha cheŋi njila yachisu chakumalala chahanzi, chatala kumusela; kuchiwana chakwenzela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.1",
            "verseOrgIds": [
              "EZK.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakuŋila nindi, Chisu ichi chakekalaŋa chakwenzela hohu, kuchenzulula nehi, muntu kwipililaku nehi, muloŋa kunepilili dehi Yehova, Nzambi yaIsarela; dichi chakekalaŋa chakwenzela hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.2",
            "verseOrgIds": [
              "EZK.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiŋa yowu kalamba hohu, diyi wakashakama mwenomu chawukalamba nakudya yakudya kumesu aYehova. Diyi wakeŋilila njila yekeki dakuchisu ochu, nikwidika akedikili kunjila yekeki odu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.3",
            "verseOrgIds": [
              "EZK.44.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.3",
            "verseOrgIds": [
              "EZK.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuntwala kumesu etala njila yakuchisu chakukabeta kakuchimunswa; nami nitali, hinukumona mwitala daYehova munenzali dehi kulema kwaYehova; hinukudimbuka chamesu ami heseki. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.4",
            "verseOrgIds": [
              "EZK.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakuŋila nindi, Eyi mwana kamuntu, shakuku muchima, wutali namesu eyi, wutiyi namatu eyi, yuma yejima yinukukuleja yakutena yidika yakwitala daYehova yejima, ninshimbi jadu jejima. Shaku muchima kuwipililu wakwitala, hamu nakumawidikilu ejima akumalala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.5",
            "verseOrgIds": [
              "EZK.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayili adikaŋa, wowu akwamutaŋa waIsarela, neyi, Mwanta Yehova nindi, Enu akwamutaŋa waIsarela, yishimashima yenu yinawani dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.6",
            "verseOrgIds": [
              "EZK.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yishimashima yakuleta mumalalami antu akumatuŋa acheŋi, ela kumuchima ayidima, nikumujimba ayidima, atamishaŋamu mwomwitala dami, himwalambulaŋa yakudya yami, nimanji nimashi, anajahi dehi nichitiyaŋenu chami nayishimashima yenu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.7",
            "verseOrgIds": [
              "EZK.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yami yajila yinayinkeli kuhemba himunayihembi enu awenuku, ilaŋa malalami nayinkeli kuhemba munayinki antu acheŋi ayihembeluwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.8",
            "verseOrgIds": [
              "EZK.44.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.8",
            "verseOrgIds": [
              "EZK.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Mwanta Yehova nindi, Muntu wakwacheŋi wakwila kumuchima chidima, nikumujimba chidima, kwipila mumalalami chinjila, hela antu akwacheŋi adi mukachi kawanyana kaIsarela chinjila; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.9",
            "verseOrgIds": [
              "EZK.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa aLevi ayili kwakulehi nanami hapwapukiluwu aIsarela, apwapukili kudami hiyakulondela akishi awu akutuŋa; diwu akasendaŋa kuluwa kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.10",
            "verseOrgIds": [
              "EZK.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akekalaŋa kwanamudimu wakukalakala mumalalami, nakutala kuyisu yetala, nakukalakala mwitala. Akayijahilaŋa antu nyilambu yakushita nikuyiketwila yimuna yawu, akemanaŋa kumesu awu nakuyikalakela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.11",
            "verseOrgIds": [
              "EZK.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Yehova nindi, Nayolweli chikasa chami kwiwulu, akasendaŋa kuluwa kwawu, nanochu chayikalakelaŋawu kumesu awakishi awu akutuŋa, hiyakwikala chuma chakudimbwisha nakuluwapesha mutaŋa waIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.12",
            "verseOrgIds": [
              "EZK.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakakundamaŋa kwakwihi nanami nakunkopela mudimu wawupristu, hela kukundama kwakwihi nayuma yami yajila nayuma yasweja kujilaku. Ilaŋa wena akasendaŋa nsonyi yawu niyishimashima yawu yakopeluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.13",
            "verseOrgIds": [
              "EZK.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa nukuyinka kwamudimu wakwikala akwakukalakala mudimu wakuhemba itala, nakukalakala nyidimu yadu yejima, nakwila yuma yejima yelaŋawu mwenomu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.14",
            "verseOrgIds": [
              "EZK.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.14",
            "verseOrgIds": [
              "EZK.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa tupristu aLevi anyana kaZadoki, ahembelaŋa malalami hapwapukiluwu anyana kaIsarela kwakulehi nanami, diwu akakundamaŋa kwakwihi nanami nakunkalakela; diwu akemanaŋa kumesu ami nakunlambula nimanji nimashi. Dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.15",
            "verseOrgIds": [
              "EZK.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diwu akeŋilaŋa mumalalami, diwu akakundamaŋa kwakwihi namesa yami nakunkalakela, diwu akahembaŋa yuma yinayinkeli kuhemba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.16",
            "verseOrgIds": [
              "EZK.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakepila ŋawu muyisu yachiŋapu chamukachi akavwalaŋa mahina awanda amawahi; bayi akavwalaŋa mahina amavuji anyikoku hachiduwu kukalakala muyisu yachiŋapu chamukachi, hela mwitalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.17",
            "verseOrgIds": [
              "EZK.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavwalaŋa mabonye awanda wawuwahi kunyitu yawu, akavwalaŋa tuputula twawanda wawuwahi mumbunda jawu; bayi akavwalaŋa chuma chaletaŋa masulwilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.18",
            "verseOrgIds": [
              "EZK.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakedika ŋawu nakuya muchiŋapu chahanzi, nakuya kudi antu muchiŋapu chahanzi, akavúulaŋa mahinawu akalakalaŋawu nachu, akayitentekaŋa mumatala ajila, akavwalaŋa mahina acheŋi kuchina kujilika antu namahinawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.19",
            "verseOrgIds": [
              "EZK.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela kutewulatuwewa, hela kuleka nsuki jawu jilehaŋa tuhu chinjila; akakumini dakutewula kwakunyitu yawu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
            "verseOrgIds": [
              "EZK.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakepila ŋawu atupristu muchiŋapu chamukachi, kunwa vinyuchinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusumbula mumbanda wantuluwa, hela mumbanda aseŋawu dehi, chinjila; kusumbula chiŋa mumbanda wamujiki wakudi anyana akumutaŋa waIsarela, hela ntuluwa wadipi iŋodakapristu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
            "verseOrgIds": [
              "EZK.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akalejaŋa antu ami haambukila yajila nayakadi kujila, akayishinshikishaŋa mwambukila yuma yamajilu nayuma yaka majilu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi kudi muloŋa diwu akemana nakuwusompesha; akawusompesha mwaya wuŋaji wami. Akahembaŋa nshimbi jami niyidika yami muyawŋa yami yakushiika yejima; akajilikaŋa sabata jami. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwinza kwakwihi namufu adijiloli chinjila. Kudijilola chiŋa hadi tata yindi, hela hadi mama yindi, hela hadi mwanindi weyala, hela hadi mwanindi wamumbanda, hela hadi mana kwindi, hela hadimuhelindi wakadi iyala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi anamutookeshi dehi akamuchindili mafuku atanu nayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku dakepilayi mumalala, muchiŋapu chamukachi, nakukalakala mumalala, akalambuli himulambu windi wahanshidi. Dimu mwanahoshiyi Mwanta Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        },
        {
