            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
