        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela neyi ami natemeshi dehi chipupu mwituŋa odu, nechiluhu dehi kulendumuka kwami kwamashi kulonda kufumishamu niantu niayimuna; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.19",
            "verseOrgIds": [
              "EZK.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela mukwikala niNowa, niDanyeli, niYoba, chinahandichi kwaamu, ami Mwanta Yehova nahoshi dehi, nami, hiyakapulwisha hela mwana weyala hela mwana wamumbandaku, akapulwisha kwawumi wawu awenawu hohu nakuloŋa kwawu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.20",
            "verseOrgIds": [
              "EZK.14.20"
            ]
          }
        }
