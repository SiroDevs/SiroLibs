          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela neyi ami naleti dehi mpoku yakabali mwituŋa odu, nayili dehi nami, Eyi mpoku, hitaku mwituŋa odu, chakwila ami nafumishamu dehi niantu, niayimuna; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.17",
            "verseOrgIds": [
              "EZK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela mukwikala awa amayala asatu, chinahandichi kwaamu, ami Mwanta Yehova nahoshi dehi, nami, hiyakapulwisha hela anyana amayala hela anyana awambandaku, akadiŋulwisha awenawu hohu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        }
      ]
    },
