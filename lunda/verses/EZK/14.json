            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.20",
            "verseOrgIds": [
              "EZK.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Mwanta Yehova nindi, Indi chinakatemesha muYerusalema kubabesha kwami kuwana, nimpoku yakabali, ninzala, nianyama atama, nichipupu, kulonda nifumishumu niantu nianyama, hichakaswejaku? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.21",
            "verseOrgIds": [
              "EZK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, tiyenu, mwakashala antu antesha akafumishawu mwenomu, nianyana amayala nianyana awambanda akafumamu, akayiwana kunu, mwakamona nimwendaŋawu nimwelaŋawu; akayikundeja nakutama kunaleteli Yerusalema, ninayuma yejima yinaletumu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.22",
            "verseOrgIds": [
              "EZK.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwakamona mwendaŋawu nimwelaŋawu akayikundeja. Mwakeluka nenu yuma yejima yinakoŋi mwenomu hinayikoŋi kwami chamukunkulwayuku. Dimu mwanahoshiyi Mwanta Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.23",
            "verseOrgIds": [
              "EZK.14.23"
            ]
          }
        }
