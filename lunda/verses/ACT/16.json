  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ACT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakushika kuDeribi nikuLisitira. Kutala kudi kambanji wumu kwenoku, ijina dindi Timotewu, mwana kamumbanda wakaYudeya wetiya; hakwila tata yindi wadiŋi kaHeleni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.1",
            "verseOrgIds": [
              "ACT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Himuntu ahamekawu kudi ana kwindi adiŋi kuLisitira nakuIkoniyumu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.2",
            "verseOrgIds": [
              "ACT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumukeŋa kudi Pawulu nindi ayaloŋa nindi. Chanamutambuliyi hakumwalamisha, kuchina aYudeya adiŋi munyikala yakwenoku, muloŋa antu ejima eluka dehi nawu tata yindi kaHeleni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.3",
            "verseOrgIds": [
              "ACT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chayilaŋawu nakuhitahita munyikala, hiyakuyilejaleja yijila yayilejeluwu kudi apostolu nawawakulumpi kuYerusalema, nawu ayovwahili. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yipompelu hiyikudikolesha mukwitiya kwakukuhwelela, akwakwitiya hiyakuya nakusemwaŋana hefuku hefuku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakupandakana kuFwilipa nakuFwilipa, muloŋa Spiritu Wajila wayilekesha dehi kushimuna mazu muAsiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanashikuwu kwatalaŋana naMisiya, nawu eseki kuya kuBitiniya, Spiritu yaYesu kuyiteja nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.7",
            "verseOrgIds": [
              "ACT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakupandakana haMisiya, akunkumukila nikuTirowasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.8",
            "verseOrgIds": [
              "ACT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulu hakumona chimwenu nawufuku; hakumona iyala wakuMasidoniya, nemani nakumulembelela nindi, Zambukilaku kunu kuMasidoniya, wutukwashuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.9",
            "verseOrgIds": [
              "ACT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamoniyi chimwenu ochu, hohenohu tukeŋa nikuya kuMasidoniya, tuneluki dehi netu Nzambi natutambiki, kulonda twakashimuni nsaŋu yayiwahi kudi antu akwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hitukufuma kuTirowasi muwatu, twimakana zwa nikuSamotirasi; chikunachi tushika nikuNeyapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.11",
            "verseOrgIds": [
              "ACT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tufuma nikwenoku tuya nikuFwilipi, yoŋanda yamuMasidoniya yalema, mwatuŋishawu dehi aRoma mashidikawu. Hitukulabila muŋandoyu mafuku amakwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.12",
            "verseOrgIds": [
              "ACT.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitukwidika kuchisu chamuŋanda hasabata, hitukuya kuchi kumu chakaloŋa, kutwatoŋojokeli netu kwiji diku kwapompelaŋawu nakulomba. Hitukushakama nakuhoshahosha nawambanda apompeli kwenoku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.13",
            "verseOrgIds": [
              "ACT.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda wumu, ijina dindi Lidiya, wakumukala waTiyatira, mukwakulandisha mahina awusombu, mukwakuhameka Nzambi, hakututiya. Mwanta hakwenzulula mumuchima windi, kulonda atiyi nsaŋu yakuhoshayi Pawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.14",
            "verseOrgIds": [
              "ACT.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamupapatishuwu niyena niakwetala dindi, hakutulembelela nindi, Neyi munanmoni nenu netiyi Mwanta, iŋilenu mwitala dami tushakami nenu. Hakutushinjila chakutushinjila.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili hitukuya kwalombelaŋawu, hiyakutubulakana kudi chaŋadima chamumbanda, wazakukaŋa demoni wakuhoŋa; ŋombu yindi diyi yaheteshaŋayi nachu anyanta jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.16",
            "verseOrgIds": [
              "ACT.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenowu hakulondaŋa Pawulu nanetu nakubidika nindi, Awa amayala hiyaloŋamba jaNzambi Mukwakubadika, hiyakuyishimwina njila yakuhandila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.17",
            "verseOrgIds": [
              "ACT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwilaŋa mwenimu mwahita mafuku amavulu. Ilaŋa Pawulu hakutiya kumuchima bwi; hakushetumuka nakumwila owu demoni nindi, Nakuleji mwijina daYesu Kristu, nami mufumi. Amufuma nihohenohu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanta jindi, chanamonuwu mwakuhwelelaŋawu leuheta munafumi dehi, hiyakukwata aPawulu naSilasi, hiyakuyikokela kuwulandilu, kumesu awanyuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.19",
            "verseOrgIds": [
              "ACT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanayitwaluwu kudi ansompeshi, hiyakwila nawu, AYudeya awa hiyatuvuba adi nakukabisha nankashi ŋanda yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.20",
            "verseOrgIds": [
              "ACT.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakutuleja yaaku, kuyitambula hela kuyovwahila kudetu aRoma chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.21",
            "verseOrgIds": [
              "ACT.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izaza hidikuyilu ndumukila nandombu, ansompeshi hiyakutabula mahinawu, hiyakuleja mashidika nawu yetenu natubama. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.22",
            "verseOrgIds": [
              "ACT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanayetuwu tubama twatuvulu hiyakuyinatila mukaleya; hiyakuleja mukwakuhemba kaleya, nawu ayihembi chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.23",
            "verseOrgIds": [
              "ACT.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena chanamulejuwu ochu, hakuyishinjikila mukatala kamukachi kakaleya, hakupata nyendu yawu mumpompa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mukachi kawufuku, aPawulu naSilasi adiŋi nakulomba nakwimbila Nzambi tumina, iku antu amukaleya enda ayitiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.25",
            "verseOrgIds": [
              "ACT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukasumuka himutentanshi waweni; chikuku chetala dakaleya hichikutenta nte-nte, yenzelu yejima yenzuluka nihohenohu, nyonji yawantu ejima amukaleya yisubuka nikusubuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.26",
            "verseOrgIds": [
              "ACT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakuhemba kaleya hakubazumuka namutulu, hakumona kuyenzelu yakaleya kwachashi; hakuhola mpoku yindi yakabali, nindi adŋahi, muloŋa natoŋojoki nindi antu amukaleya anatemuki dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.27",
            "verseOrgIds": [
              "ACT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Pawulu hakubidika nezu daŊovu nindi, Bayi wudikatishaku, yetu awa wejima wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutambika antu aleti yimunyi, hakukilukilamu, iku wudi nikuzaala woma, hakudinata heseki kunyendu yaPawulu naSilasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.29",
            "verseOrgIds": [
              "ACT.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyiidishamu nindi, Enu anyanta, nukwila ŋahi nihandi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena nawu, Mukuhwelelenu Mwanta Yesu, wuhandi nineyi niakwetala deyi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.31",
            "verseOrgIds": [
              "ACT.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili kunachi dehi, ansompeshi hiyakutemesha atulama, nawu, Yilekenu amayala ayi tuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakuhemba kaleya hakulejamu Pawulu, nindi, Ansompeshi anatemeshi izu dakwila nawu, Yenu. Dichi dinu fumenumu muyi chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
              "ACT.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Pawulu hakuyila nindi, Kutweta anatweteli hatooka chakadi kutuhisha, kutoŋa etu tuyaRoma; hiyakutunatila mukaleya, atufumishumu kumbadi? Chinjila! Enzaŋa kwawu awenawu atufumishumu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulama hiyakuleja ansompeshi mazu awa. Chanatiyuwu nawu hiyaRoma, atiya niwoma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.38",
            "verseOrgIds": [
              "ACT.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwinza nakuyilembelela. Chanayifumishuwu hiyakulomba nawu, Fumenu mwani kuŋanda yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.39",
            "verseOrgIds": [
              "ACT.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakufuma mukaleya hiyakuya kwaLidiya. Chanamonuwu ana kwetu nakuyikundeja, hiyakufuma kwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.40",
            "verseOrgIds": [
              "ACT.16.40"
            ]
          }
        }
      ]
    }
