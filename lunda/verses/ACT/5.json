          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwiteja mwanahoshiyi. Chanatambikuwu apostolu, hiyakuyeta, hiyakuyileja naŋovu nawu, Bayi muhosha mwijina daYesuku. Ayumbaku nikuyumbaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.40",
            "verseOrgIds": [
              "ACT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hiyakufuma muchota nakuzaŋalala, nanochu chanayifuukwiluwu kutela kusawuka nakukoola ijina. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.41",
            "verseOrgIds": [
              "ACT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyalekeli kuleja antu hefuku hefuku, nimutembeli, nikumatalawuku, nakushimuna Yesu nawu diyi Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.42",
            "verseOrgIds": [
              "ACT.5.42"
            ]
          }
        }
