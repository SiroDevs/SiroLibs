  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ACT 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuKesareya mwadiŋi iyala wumu, ijina dindi Konelisu, senturinu yamashidika atenaŋawu nawu aItaliya; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.1",
            "verseOrgIds": [
              "ACT.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "muntu wukweti kale-mesha kakulemesha Nzambi, waakamaŋa Nzambi hamu nawakwetala dindi ejima, wenkelaŋa antu yamukunkulu yayivulu, walombelaŋa kudi Nzambi hefuku hefuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.2",
            "verseOrgIds": [
              "ACT.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumona muchimwenu chalumbuluka, kaŋelu kaNzambi hakwinza kudi yena haora kwiji yamuchitanu nachiwanayefuku; hakumwila nindi, Eyi Konelisu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.3",
            "verseOrgIds": [
              "ACT.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyena chanamushinshikiyi kaŋelu swi-i, hakutiya woma nindi, Chika Mwanta? Yena hakumwila nindi, Kulomba kweyi kwakuvulu niyamukunkulu yeyi yinashi ki kudi Nzambi, anakwanuki nachu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.4",
            "verseOrgIds": [
              "ACT.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, temeshaku amayala kuYopa, akaleti Shimona atumbiluwu ijina di kwawu daPetulu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.5",
            "verseOrgIds": [
              "ACT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "washakamakwamuntu wumu ijina dindi Shimona, mukwakuloomba yitembi, wukweti itala dindi kwakwihi nakaluŋalwiji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.6",
            "verseOrgIds": [
              "ACT.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanayiyi kaŋelu wadiŋi nakuhosha nindi, Konelisu hakutambika aŋamba jindi ayedi, niishidika wumu wukweti kalemesha kakulemesha Nzambi, wowu akwakumwimena hefuku hefuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.7",
            "verseOrgIds": [
              "ACT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyihitila mwejima mwanamulejuwu kudi kaŋelu, hakuyitemesha kuYopa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.8",
            "verseOrgIds": [
              "ACT.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.8",
            "verseOrgIds": [
              "ACT.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi, achidi kuya munjila yawu, hiyakuya nakuswila kwakwihi namukalowu, Petulu hakukanduka hewulu detala alombi, kwiji neyi ora yamuchitanu nayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.9",
            "verseOrgIds": [
              "ACT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutachika kutiya nzala, hakukeŋa kudya. Hachidi kuloŋeshawu kudya, hakwila neyi wukukeŋa kuya namutulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.10",
            "verseOrgIds": [
              "ACT.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumona iwulu hiyakudijikula, nichuma kwiji chika, chidi neyi ihina deneni, hichikuzelumuka, hiyakuchizelumwina kumawombu achu awana, chishi ka niheseki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.11",
            "verseOrgIds": [
              "ACT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenomu mudi anyama anyitundu yejima, niyuma yazalalaŋa hamaseki, nitujila twahaluzwizu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.12",
            "verseOrgIds": [
              "ACT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi yena hikukwinza izu nawu, Eyi Petulu, nyamukaku, wujahi, wudyai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.13",
            "verseOrgIds": [
              "ACT.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Petulu nindi, Aha-a, Mwanta! Kanda dehi nidyi chuma chatama hela chajilaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.14",
            "verseOrgIds": [
              "ACT.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu hidikwinza kudi yena ipampa damu chiyedi nawu, Chuma chanatookeshiyi Nzambi, bayi wuchitena neyi chatamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.15",
            "verseOrgIds": [
              "ACT.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenichi achilili kasatu; chumochu atambula nikwiwulu hohenohu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.16",
            "verseOrgIds": [
              "ACT.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.16",
            "verseOrgIds": [
              "ACT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hachidiŋivi Petulu kujinoka nankashi, nindi chimwenu ichi chinamoni chinayi mudihi? kukasumuka owu amayala atemesheluwu kudi Konelisu, aneliuli dehi kwitala daShimona, anemani dehi kuchisu chachipaŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.17",
            "verseOrgIds": [
              "ACT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakutambika nakwihula nawu, Shimona atumbiluwu ijina di kwawu daPetulu, washakama kunu? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.18",
            "verseOrgIds": [
              "ACT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hachidiŋiyi Petulu kutoŋojoka nsaŋu yachimwenu ochu, Spiritu hakumwila nindi, Tala, amayala asatu anakukeŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.19",
            "verseOrgIds": [
              "ACT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nyamukaku wusuluki, wuyi nawu chakadi ntadi; yami nayitemeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.20",
            "verseOrgIds": [
              "ACT.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu hakusulukila kudi owu amayala nindi, Yami muntu mudi nakukeŋa; munenjilidi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.21",
            "verseOrgIds": [
              "ACT.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawu, Senturinu Konelisu, muntu waloŋa waakamaŋa Nzambi, amuhamekaŋa kudi muza wejima wawaYudeya, anamuleji kudi kaŋelu wajila nawu akakutumeshi wuyi mwitala dindi, kulonda atiyi mazu kudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.22",
            "verseOrgIds": [
              "ACT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyitambika mwitala hakuyileja kwakukama. Chikunachi hakunyamuka hakuya nawu, niana kwindi amakwawu akuYopa hiyakumutwalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.23",
            "verseOrgIds": [
              "ACT.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi ifuku di kwawu hiyakwijila muKesareya, kuwana Konelisu wudi nakuyichiŋilila, wapompesha dehi awusoku windi niamabwambu jindi akundayi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.24",
            "verseOrgIds": [
              "ACT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanepiliyi Petulu, Konelisu hakumubulakana, hakudinata kunyendu yindi nakudifukula kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.25",
            "verseOrgIds": [
              "ACT.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Petulu hakumuhindwisha nindi, Imanaku; ninami aweni nimuntu kwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.26",
            "verseOrgIds": [
              "ACT.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku wudi nakuhosha nindi hakwijila, hakuwana antu amavulu anapompi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.27",
            "verseOrgIds": [
              "ACT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Enu aweni muneluki kaYudeya kushakama namuntu wakumuza wacheŋi hela kwinza kwakwihi nindi, chinjila. Hela chochu, Nzambi nanleji nindi, kutena muntu neyi watama hela wajila, chinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.28",
            "verseOrgIds": [
              "ACT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chimwantumesha, hinukwinza chakadi ntadi. Dichi neliuli nami mwantumesheladi?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.29",
            "verseOrgIds": [
              "ACT.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.29",
            "verseOrgIds": [
              "ACT.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka Konelisu nindi, Munahiti mafuku awana nakushi ka hampinji yinu, nadiŋi nakulomba mwitala dami haora yamuchitanu nachiwana; kukasumuka iyala nemani kunidi, navwali mahina atoŋeka chejeji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.30",
            "verseOrgIds": [
              "ACT.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Eyi Konelisu, kulomba kweyi anakutiyi, niyamukunkulu yeyi anayanuki kudi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.31",
            "verseOrgIds": [
              "ACT.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, temesha antu kuYopa wakatambiki Shimona atumbiluwu ijina di kwawu daPetulu, akenzi kudeyi; yena wekala kwaShimona mukwakuloomba yitembi kuchi kumu chakaluŋalwiji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.32",
            "verseOrgIds": [
              "ACT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hinukukutemeshela antu hohenohu. Chinawahi mwani chiwunenzi. Dichi dinu, yetu awa tudi kunu kumesu aNzambi wejima wetu, kulonda tutiyi yejima yanakulejuwu kudi Mwanta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.33",
            "verseOrgIds": [
              "ACT.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.33",
            "verseOrgIds": [
              "ACT.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu hakuhosha nindi, Mwalala, namoni komana Nzambi haakaminaŋa antu kumesuku; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.34",
            "verseOrgIds": [
              "ACT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila munyuza yejima, muntu wamwakamaŋa yena, welaŋa mwaloŋa, amutiyaloŋa kudi Nzambi kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.35",
            "verseOrgIds": [
              "ACT.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu aweni mweluka mazu atemesheliyi Nzambi kudi aIsarela, nakushimuna nsaŋu yayiwahi yakuwunda naYesu Kristu, diyi Mwanta wawantu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.36",
            "verseOrgIds": [
              "ACT.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu iyi enu aweni mwayiluka, yatiyakeni mwahita Yudeya mwejima; yatachikilili kuŊaliliya hakumishiluwu chipapatishu chashimwiniyi Yowanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.37",
            "verseOrgIds": [
              "ACT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwatiya dehi nsaŋu yakutena Yesu wakuNazareta, chamuwayishiluwu kudi Nzambi naSpiritu Wajila naŋovu; yena wakimbukilaŋa nakwila yayiwahi, nakukolesha antu ejima akabishilaŋawu kudi diyabolu, muloŋa Nzambi wadiŋi nayena. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.38",
            "verseOrgIds": [
              "ACT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetu ayinsahu twamweni namesu mwejima mweliliyi mwituŋa dawaYudeya nimuYerusalema; yena nawa amujahili, nakumukudika hamutondu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.39",
            "verseOrgIds": [
              "ACT.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena amusaŋwili kudi Nzambi mudi afu ifuku damu chisatu; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.40",
            "verseOrgIds": [
              "ACT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakumumwekesha hatooka, bayi kudi antu ejimaku, ilaŋa kudetu ayinsahu akutondaŋahu dehi kudi Nzambi, yetu twelili nikudya nikunwa nindi helililiyi nasaŋuki dehi mudi afu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.41",
            "verseOrgIds": [
              "ACT.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakutuleja nindi tushimwini antu, tushimuni wunsahu wakutena netu yenowu diyi anafuukuluwu kudi Nzambi kwikala mukwakusompesha niamomi niafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.42",
            "verseOrgIds": [
              "ACT.10.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amushimunaŋa wunsahu kudi atuprofwetu ejima, nawu mwijina dindi antu ejima akumukuhwelela akamona kuyanakena nyiloŋa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.43",
            "verseOrgIds": [
              "ACT.10.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 10:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.43",
            "verseOrgIds": [
              "ACT.10.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 10:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku Petulu wuchidi kuhosha mazu awa, Spiritu Wajila hakuholokela hadi antu ejima adiŋi nakutiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.44",
            "verseOrgIds": [
              "ACT.10.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 10:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niakwakwalama enjili naPetulu adiŋi etiya, chanachimonuwu, hiyakuhayama wejima wawu nawu, Komana hadi aJentili nihena nawa anechiluhu chamukunkulu chaSpiritu Wajila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.45",
            "verseOrgIds": [
              "ACT.10.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 10:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋatiyili hiyakuhosha madimi acheŋi nakumutohesha Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.10.46",
            "verseOrgIds": [
              "ACT.10.46"
            ]
          }
        }
      ]
    }
