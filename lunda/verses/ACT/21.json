  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "ACT 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chituna ambuki nawu, hitukutachika kwenda muwatu, hitukwimakana nikuKosi zwa; chikunachi tushika nikuRodi, kufuma oku tuyani kuPatara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.1",
            "verseOrgIds": [
              "ACT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitukuwana watu wacheŋi wudi nakuzambukila kuFwenisiya, hitukwijila mu, tutachika nikwenda muwatu owu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.2",
            "verseOrgIds": [
              "ACT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitunashiki kwela chitutu chaKipirosi hichikumwekana, hitukuchibakila kuchikasa chachimunswa, hitukuyaloŋa tuhu muwatu kuSiriya. Hitukushika kuTira, tufuma nimuwatu; muloŋa kwenoku diku kwakeŋa eli kuloŋololawu yuma yadiŋi muwatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.3",
            "verseOrgIds": [
              "ACT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitunawani atumbanji, hitukulabila kwenoku mafuku atanu nayedi. Wenawa hiyakumwila Pawulu mudi Spiritu nawu bayi akadata mwendu muYerusalemaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.4",
            "verseOrgIds": [
              "ACT.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinamani mafuku owu, hitukunyamuka nakuya mulwendu lwetu; akwetu ejima, ni aŋodi jawu ni anyanawu, hiyakututwalaku munjila yetu. Chitunafumi muŋandoyu, hitukufukama kuchi kumu nakulomba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.5",
            "verseOrgIds": [
              "ACT.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitunadishaliki dehi chachiwahi, hitukuya cheŋi muwatu owu; wena afunta nikumatalawu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.6",
            "verseOrgIds": [
              "ACT.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.6",
            "verseOrgIds": [
              "ACT.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitunakumishi lwendu lwetu lwamuwatu lwakufuma kuTira, tushika nikuTolemayi. Hitukuyimwisha ana kwetu, tujiŋilaku niifuku dimu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.7",
            "verseOrgIds": [
              "ACT.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi hitukunyamuka, tushika nikuKesareya. Kwenoku hitukwijila mwitala damukwakushimuna nsaŋu yayiwahi Fwilipu, diyi wadiŋi wanawa ankoŋi atanu nayedi atondeluwu; hitukushakama nindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.8",
            "verseOrgIds": [
              "ACT.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenowu iyala wadiŋi nawanya nindi awambanda ajiki awana, aprofwetelaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.9",
            "verseOrgIds": [
              "ACT.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitunalabili kwenoku mafuku amavulu, kuYudeya hikukufuma kaprofwetu wumu, ijina dindi Aŋabusi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.10",
            "verseOrgIds": [
              "ACT.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza kudetu, hakukwata muya waPawulu, hakudikasawu kunyendu nikumakasa; hakwila nindi, Spiritu Wajila nindi, Dichi chakakasilawu muntu wukweti muyiwu kudi aYudeya akuYerusalema; akamuhana nikudi aJentili. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.11",
            "verseOrgIds": [
              "ACT.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitunatiyi mwenimu, etu nawakwetu akwenoku hitukumulembelela Pawulu, netu bayi akanduka kuYerusale maku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.12",
            "verseOrgIds": [
              "ACT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulu hakwakula nindi, Aka! Mudi nakudiladi? Mukumbalula muchima? Neteji kwami hela kunkasa, hela kukumina dakufwa kuYerusalema, kuko-ola ijina daMwanta Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.13",
            "verseOrgIds": [
              "ACT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneliyi kumulekesha kwonti kwindi, hituku mwena netu, Eli muchima waMwanta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.14",
            "verseOrgIds": [
              "ACT.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.14",
            "verseOrgIds": [
              "ACT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku alondelumu, hitukuloŋeja yuma yetu, tukanduka nikuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.15",
            "verseOrgIds": [
              "ACT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitukuya nawakwetu atumbanji akuKesareya, nimuntu wumu wakuKipirosi, ijina dindi Manasoni, kambanji wamukulu itwakeŋa a kushakama nindi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.16",
            "verseOrgIds": [
              "ACT.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.16",
            "verseOrgIds": [
              "ACT.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitunashiki kuYerusalema, akwetu hiyakutiya kuwaha kututambula. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.17",
            "verseOrgIds": [
              "ACT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikunachi hitukuya naPawulu kwaYakoba; mwadi ŋuwu niakulumpi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.18",
            "verseOrgIds": [
              "ACT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanayi mwishiyi, hakuyishi mwinamu mwejima mwakoŋeliyi Nzambi mukachi kawaJentili kumudimu windi, hachuma hachuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.19",
            "verseOrgIds": [
              "ACT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena chanachitiyuwu, hiyakulemesha Nzambi. Hiyakumwila nawu, Eyi mana kwetu, wunamoni chanetiyuwu aYudeya makombakaji namakombakaji; wejima wawu asweja Ŋovu yakudijilika nanshimbi jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.20",
            "verseOrgIds": [
              "ACT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu akwetu aYudeya, kulonda nakayi mulwendu lwa kuDamakasa, nakaleti akwakwitiya munyonji kuYerusalema, kulonda akayibabeshi, yeyi yatiyakana dehi, anatiyi nawu walejapa aYudeya ejima ekala mukachi kawaJentili, neyi aleki Mosi. Nawu wayilejaŋa neyi bayi aalamishaga anyanawu, hela kwenda mwaya yijila yaMosuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.21",
            "verseOrgIds": [
              "ACT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukwila pahi dinu? Chalala izaza kepa ditiyi nawu wenza dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.22",
            "verseOrgIds": [
              "ACT.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ilaku mutukukuleja. Tukweti amayala awana anadishiilumu dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.23",
            "verseOrgIds": [
              "ACT.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "twalaku wenawa wudijiliki nawu hamu, wuyikwashuku kufweta kulonda atewuli nyitu yawu. Mwenomu antu ejima eluki nawu nsapu yeyi yanayilejuwu yakutwamba; komana eyi aweni wendaga chachiwahi mwaya nshimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.24",
            "verseOrgIds": [
              "ACT.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila chansapu yawaJentili etiya dehi, twasonekeli dehi. Twaketwili dehi netu aleki yuma yakupesha nachu akishi, nimashi, nianyama akushotomona, niwuvumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.25",
            "verseOrgIds": [
              "ACT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulu hakutambula wenowu amayala; chikunachi hakudijilika nawu hamu, hakwipila mutembeli kulonda aleji mwakamanina mafuku akudijilikila; hakayikwashayi namulambu wawu wejima wawu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneluwu mafuku atanu nayedi hiyakuya nakumana, aYudeya afumini kuAsiya, chanamonuwu Pawulu mutembeli, hiyakusaŋumuna izaza dawantu dejima, amukwata nikumukwata. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.27",
            "verseOrgIds": [
              "ACT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakubilela nawu, Enu akwetu amayala aIsarela, tukwashenuku! Yeniwu diyi iyala walejaga antu ejima kwejima, nakutugula niaIsarela ninshimbi nitembeli iyi. Nabombeluku chuma chikwawu nawa, ncŋiji aHeleni mutembeli; najiloli dehi munu mwajila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.28",
            "verseOrgIds": [
              "ACT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloga henohu amumona dehi mupanda hamu nakaEfwesesa, Tirofwimusa; anatogojoki nawu Pawulu namwigiji mutembeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋanda yejima yivwakuka niipumba; antu hiyakupompa lufuchi, hiyakumukwata Pawulu, hiyakumukokela hanzi yatembeli. Enzela niyenzelu hohenohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.30",
            "verseOrgIds": [
              "ACT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heliluwu hiyakukena kumujaha, nsagu oyu yishika nikudi mukulumpi wamashidika ikombakaji, nawu Yerusalema yejima yavwakuka dehi kwepumba hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.31",
            "verseOrgIds": [
              "ACT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakusenda mashidika nimasenturinu hohenohu. Hiyakukunkumukila lufuchi kudi wena; chanamonuwu mukulumpi muneni nimashidika, aleka nikumweta Pawulu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.32",
            "verseOrgIds": [
              "ACT.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukulumpi muneni hakwinza kwakwihi, hakumukwata, hakuyila nindi mukasenu namalepi ayedi. Hakwihula nindi, Yeniwu hinyi? Neli pahi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.33",
            "verseOrgIds": [
              "ACT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwizaza amakwawu hiyakubideka chuma chimu, amakwawu nawa chuma chikwawu. Chanabuliyi kwiluka chakashinshi nepumba dadipuku, hakuyileja nindi mutwalenu mwitala damashidika. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.34",
            "verseOrgIds": [
              "ACT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanashikuwu kuwukandaminu, hiyakumweleka Pawulu kudi mashidika, nanochu chaswejeluwu antu kuzuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.35",
            "verseOrgIds": [
              "ACT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulopa izaza dawantu hidikuyilondela nakubideka nawu, Waadi! Waadi!",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakepeluwu kumwigija mwitala damashidika, Pawulu hakumwila owu mukulumpi muneni, nindi, Wukupiteja nikuleji chuma chimu? Yena nindi, Komana wahoshaŋa idimi daHeleni? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nami kwiji yeyi kaEjipitu wafumbili njita mafuku awa adipuku, watweli atupondu makombakaji awana mwisaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulu hakwakula nindi, Ami yami kaYudeya wakuTarusa muSilisiya, nimwinipanda yalerna. Nakulembeli nami agiteji mwani nihoshi nawantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamwitejiyi, Pawulu hakwimana hawukandaminu, hakuyolwela antu chikasa kwiwulu; chanamwenuwu chacheni zo, hakuhosha nawena mwidimi daHeberu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.40",
            "verseOrgIds": [
              "ACT.21.40"
            ]
          }
        }
      ]
    }
