  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ACT 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu ikabisha dakukabisha chipompelu chadiŋi muYerusalema divulumuka nikuvulumuka. Hiyakupalaŋena wejima wawumwahita matuŋa aYudeya naSamariya, kwasheli wowu apostolu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.1",
            "verseOrgIds": [
              "ACT.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Setefwanu hiyakumujiika kudi amayala akweti kalemesha kakulemesha Nzambi, hiyakumudila makumbu aweni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.2",
            "verseOrgIds": [
              "ACT.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Sawulu hakukisaŋana chipompelu, hakwijila mumatala ejima nakukokakoka ni amayala niambanda, hakuyisha mukaleya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.3",
            "verseOrgIds": [
              "ACT.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wena apalaŋeni hiyakukimbuka nakushimuna mazu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.4",
            "verseOrgIds": [
              "ACT.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwilipu hakukunkumukila kuŋanda yaSamariya, hakuyishimwina nsaŋu yaKristu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.5",
            "verseOrgIds": [
              "ACT.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazaza awantu chanatiyuwu mwahosheliyi Fwilipu, nikumona yinjikijilu yeliliyi, hiyakumutiyilila namuchima wawu wumu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.6",
            "verseOrgIds": [
              "ACT.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋademoni azonda, adiŋi nakuzakuka antu amavulu, hiyakuyifuma nakukaloka naŋovu. Antu amavulu adiŋi namusoŋu wakalepa, niadiŋi nakubalakata, hiyakukola. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.7",
            "verseOrgIds": [
              "ACT.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muŋandoyu mwadiŋi muzaŋalu wasweja.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.8",
            "verseOrgIds": [
              "ACT.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa muŋandoyu mwadiŋi iyala wumu, ijina dindi Shimona, yenowu wahoŋelaŋa nakuhayamisha akwaSamariya, nakudisamba nindi nalema. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.9",
            "verseOrgIds": [
              "ACT.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenowu antu ejima, kufumisha kudi akadi kulema kushika nikudi alema, hiyakumusha kumuchima nawu, Yeniwu diyi Ŋovu oyu yaNzambi yatenaŋawu nawu Muneni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.10",
            "verseOrgIds": [
              "ACT.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amusha kumuchima, muloŋa nayihayamishi naŋombu yindi hanalehi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.11",
            "verseOrgIds": [
              "ACT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chanetiyuwu mwakushimunayi Fwilipu nsaŋu yayiwahi yakutena wanta waNzambi niijina daYesu Kristu, hiyakuyipapatisha, ni amayala niambanda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.12",
            "verseOrgIds": [
              "ACT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimona yomweni niyena nawa hakwitiya; chanamupapatishuwu hakwenda hamu naFwilipu. Chanamoniyi yinjikijilu ninyidimu yaŋovu yakoŋeliyi, hakuhayama.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.13",
            "verseOrgIds": [
              "ACT.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu dinu apostolu adiŋi kuYerusalema, chanatiyuwu nawu aSamariya anatambuli mazu aNzambi, hiyakutemeshaku aPetulu naYowanu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.14",
            "verseOrgIds": [
              "ACT.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.14",
            "verseOrgIds": [
              "ACT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena chanashikuwu, hiyakuyilombela kulonda atambuli Spiritu Wajila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.15",
            "verseOrgIds": [
              "ACT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa henohu Spiritu wuchidi kanda aholokeli hela hadi muntu niwumu wakwenokuku; anakumini dakuyipapatisha mwijina daMwanta Yesu hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.16",
            "verseOrgIds": [
              "ACT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuyinaŋika makasa, atambula niSpiritu Wajila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.17",
            "verseOrgIds": [
              "ACT.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimona, chanamoniyi Spiritu Wajila ayinkaŋa hakunaŋika apostolu makasawu, hakwila nindi ayinki mali; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.18",
            "verseOrgIds": [
              "ACT.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Nyinkenu ninami Ŋovu iyi, kulonda yowu nakanaŋika makasami akatambuli Spiritu Wajila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.19",
            "verseOrgIds": [
              "ACT.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Petulu hakumwila nindi, Mali eyi akisikili kumu naneyi, muloŋa wunatoŋojoki neyi wutambuli namali chamukunkulu chaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.20",
            "verseOrgIds": [
              "ACT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwukweti mwakutukwashila hela mudimu kunsaŋu iyuku; muloŋa muchimaweyi hiwaloŋa kumesu aNzambuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.21",
            "verseOrgIds": [
              "ACT.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi balumukaku mumuchima wuleki ichichuma chatama, wumulombi Mwanta, wamba kela muwunatoŋojoki muchima weyi akakwanakeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.22",
            "verseOrgIds": [
              "ACT.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nakumoni wumuntu wunaluli dehi nandulu mumuchima, anakukasi dehi nakuluwa kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.23",
            "verseOrgIds": [
              "ACT.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimona hakwakula nindi, Nlombelenuku kudi Mwanta, kulonda yumoyu yimunateni yibuli kunwana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
            "verseOrgIds": [
              "ACT.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.24",
            "verseOrgIds": [
              "ACT.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wena, chanashimunuwu wunsahu wawu nakuhosha mazu aMwanta, hiyakufunta kuYerusalema nakushimuna nsaŋu yayiwahi munyikala yawaSamariya yayivulu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.25",
            "verseOrgIds": [
              "ACT.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.25",
            "verseOrgIds": [
              "ACT.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa kaŋelu kaYehova hakumwila Fwilipu nindi, Nyamukaku, wuyi kukabeta kakuchidiilu, kunjila yafuma kuYerusalema yakunkumukila kuGaza mwisaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.26",
            "verseOrgIds": [
              "ACT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunyamuka, hakuya. Kutala iyala wakuEtiyopiya, kalama kamwanta wamumbanda wawaEtiyopiya Kandesi, kalema nankashi, diyi wahembelaŋa yuma yaKandesi yalema yejima. Yenowu wenza dehi kuYerusalema kulonda kudifukula kudi Nzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.27",
            "verseOrgIds": [
              "ACT.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "wadiŋi munjila yakufunta, washakama mwikalu dindi nakutaŋa mukanda wakaprofwetu Isaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.28",
            "verseOrgIds": [
              "ACT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Spiritu hakumwila Fwilipu nindi, Yaku kwakwihi, wukundami kwikalu diŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.29",
            "verseOrgIds": [
              "ACT.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwilipu hakuyaku lufuchi, hakumutiya wudi nakutaŋa mukanda wakaprofwetu Isaya. Nindi, Chiwudi nakutaŋa chinakulumbulukili, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.30",
            "verseOrgIds": [
              "ACT.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka yena kalama nindi, Chikunlumbulukila ŋahi chakadi muntu kunleja? Hakumwila Fwilipu nindi akandami ashakami hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.31",
            "verseOrgIds": [
              "ACT.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komana wadiŋi nakutaŋa mwasonekawu nawu, Neyi mwana kamukoku akutwalawu nakujaha, neyi chamwenaŋayi mukoku hadi akwakumutewula zo-o, dichi niyena haasamini mukanwa kinduku. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.32",
            "verseOrgIds": [
              "ACT.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadizozeliyi, hiyakumutambula wuŋaji wakeŋa eli kumonayi. Muyachi windi akawushimuna kudinyi? Muloŋa wumi windi anawufumishi hanu hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.33",
            "verseOrgIds": [
              "ACT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu kalama hakumwihula Fwilipu nindi, Kaprofwetu nateninyi, mwani? Naditeni yomweni, tahindi nateni muntu wacheŋi? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.34",
            "verseOrgIds": [
              "ACT.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwilipu hakuhosha mazu akutachikila kumukandiwu, hakumushimwina nsaŋu yaYesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.35",
            "verseOrgIds": [
              "ACT.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chayilaŋawu munjila hiyakushika kumeji. Owu kalama nindi, Tala meji; chumanyi chikunlekesha kumpapatisha? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.36",
            "verseOrgIds": [
              "ACT.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwilipu hakwakula nindi, neyi wunetiyi namuchima weyi wejima wukutwesha. Yena hakwakula nindi, Netiyi nami Yesu Kristu diyi Mwana kaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.37",
            "verseOrgIds": [
              "ACT.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuleja antu kwimika ikalu. Hiyakukunkumukila mumeji mwayedi wawu, niFwilipu nikalama; hakumupapatisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.38",
            "verseOrgIds": [
              "ACT.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanakandukuwu mumeji, Spiritu yaYehova hakumuhukula Fwilipu; owu kalama hamumweni nawa cheŋuku, hakuyaloŋa kwindi munjila yindi nakuzaŋalala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.39",
            "verseOrgIds": [
              "ACT.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza Fwilipu hiyakumuwana kuAzotu; chahitiliyi, hakushimuna nsaŋu yayiwahi munyikala yeneni yejima, nichashikiliyi kuKesareya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.40",
            "verseOrgIds": [
              "ACT.8.40"
            ]
          }
        }
      ]
    }
