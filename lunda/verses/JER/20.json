        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kakapristu Imeri Pashuri wadiŋi mukulumpi wawakwakutala itala daYehova, hakutiya chakuprofwetayi Yeremiya yumiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pashuri hakumweta kaprofwetu Yeremiya, hakumusha mumpompa jadiŋi muchisu chaBenjamini champwembu chakundundamu, chamwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimunachi Pashuri hakufumisha Yeremiya mumpompa. Yeremiya hakumwila nindi, Yehova hanakutumbi ijina deyi nindi, Yeyi Pashuruku; ilaŋa nindi, Yeyi Magori Misabibi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nahoshi nindi, Tiya, nukukubalumuna kwikala wakufwa mutentu nineyi niamabwambu jeyi ejima, akafwa kumpoku yakabali yawayilumbu jawu, wakachimona namesu eyi. AYuda ejima nakayihana kudi mwanta wakuBabiloni, wakayitwala kuBabiloni muwukoli, wakayijaha nampoku yakabali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nakahana maheta amukaliwu ejima, ningalanyi yawu yejima, niyuma yawu yalema yejima, eŋa, yuma yawanyanta awaYuda yalema yejima nakayihana kudi ayilumbu jawu, akayibuwa, akayikwata, akayitwala kuBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.5",
            "verseOrgIds": [
              "JER.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineyi Pashuri, niantu ejima ashakama mwitala deyi, mwakaya muwukoli. Eyi wakashika kuBabiloni, diku kuwakafwila, akakujiika kwenoku, nineyi niamabwambu jeyi ejima iwaprofwetelaŋa chakutwamba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova wunandimbi dehi kweyi, ami nadimbewi kwami, eyi wambadika Ŋovu, wunanfwomoni dehi. Ami nekali dehi muntu wakusehewa mwaana wejima, hiyakunyiŋila kudi antu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhosha kwami kwakudila hohu, nabidikaŋa jandombu nŋakubuwa; izu daYehova dinansawishidakunsehaho-omwaanawejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyinukwilanami, Hinukumutenaku, ninukuhosha cheŋi mwijina dinduku, mumuchima wami himukwikala neyi kesi kadi nakuŋocha, kanjikiluwu mumafwahami, hinukuzeya nakudilekesha, kutwesha kumwena nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami natiyi chakuntuŋulawu kudi antu amavulu, mbadi jejima kwakufwa mutentu hohu. Nawu, Mushimunenu, ninetu tukumushimuna. Dimu mwadi nakuhoshawu akwetu ejima nashakaminaŋa nawu chachiwahi anchiŋejaŋa nawu keŋa adimbuki; nawu keŋa amudimbeki chatama, tumwimiki mushindu, twakaditendi hadi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yehova wudi nanami neyi chilobu akutiyawu woma. Dichi i akwakunkabisha akatedaŋila, akankaŋanya. Akayitiyisha nsonyi nankashi, akasawuka chahaya nyaka chakubula kuvulamena antu, muloŋa anabuli kwila mwamuwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yehova wamazaza, wesekaŋa aloŋa, wamonaŋa i niyitoŋojoka ninyichima yawantu; nimoni chiwukuditenda; muloŋa yeyi naleji dehi mwaya nsaŋu yami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.12",
            "verseOrgIds": [
              "JER.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwimbilenu Yehova tumina, muhamekenu Yehova, muloŋa yena napulwishi wumi wawabula yuma kudi akwakukoŋa chatama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.13",
            "verseOrgIds": [
              "JER.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku dinavwalikili diikali dashiŋewa. Ifuku danvweluwu kudi mama bayi dikiswilewa nkisuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.14",
            "verseOrgIds": [
              "JER.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu waleteli nsaŋu kudi tata yami, nindi, Kunavwaliki dehi mwaneyi weyala, hakumutiyisha kuwaha nankashi, ekali washiŋewa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.15",
            "verseOrgIds": [
              "JER.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena muntu owu ekali neyi nyikala yamwaŋiliyi Yehova chakadi kutiya kutama kumuchima windi. Muntu owu atiyi muteti nabudidi, nikudikuwahakachikamwaana, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.16",
            "verseOrgIds": [
              "JER.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanochu chabuliliyi kunjahila mwivumu, kulonda mama ekali ŋamu dami, niivumu dindi diikali saŋa datohela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.17",
            "verseOrgIds": [
              "JER.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi ami nedikililidi mwivumu nimonaŋa kukabakana nayihuŋu, mwaka mafuku ami amanaŋa nansonyi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.18",
            "verseOrgIds": [
              "JER.20.18"
            ]
          }
        }
      ]
    }
  ],
