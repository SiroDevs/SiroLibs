      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Yeremiya nakumishi dehi kuhosha kudi antu ejima mazu aYehova Nzambi yawu ejima amutemesheleliyi Yehova Nzambi yawu kuhoshe kudi wena, wowu mazu ejimawa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.1",
            "verseOrgIds": [
              "JER.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwana kaHoshaya Azariya, namwana kaKareya Yohanani, namayala adinka wanta ejima, hiyakuhosha chakumwila Yeremiya nawu, Wunatwambi. Yehova Nzambi yetu hidiyi nakutemeshi wili neyi, Bayi mwakaya nakushakama muEjipituku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.2",
            "verseOrgIds": [
              "JER.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaNeriya Baruki diyi nakusaŋumuni wutuzuwili, kulonda kutuhana kudi aKaladeya akatuja haŋa, akatutwali kuBabiloni muwukoli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.3",
            "verseOrgIds": [
              "JER.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.3",
            "verseOrgIds": [
              "JER.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mwana kaKareya Yohanani nawawakulumpi ayendu ejima, nawantu ejima, hiyovwahilili izu daYehova ashakami mwituŋa daYudaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.4",
            "verseOrgIds": [
              "JER.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mwana kaKareya Yohanani, niakulumpi ayendu ejima atweli aYuda ejima asheluku afunta funtili kunyuza yejima kwayitemwininuwu, nawu ashakami mwituŋa daYuda; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.5",
            "verseOrgIds": [
              "JER.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wowu amayala, nawambanda, nawanyana, nawanyana kamwanta awambanda, nawantu ejima ashiyiliyi Nebuzaradani mukulumpi wawatulama kudi Gedaliya mwana kaAhikami, Ahikami mwana kaShafwani, nikaprofwetu Yeremiya, nimwana kaNeriya Baruki, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.6",
            "verseOrgIds": [
              "JER.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakuya mwituŋa daEjipitu. Muloŋa wena hiyovwahilili izu daYehovaku. Ashika nikuTapanesi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.7",
            "verseOrgIds": [
              "JER.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova hidi kwinza kudi Yeremiya kuTapanesi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.8",
            "verseOrgIds": [
              "JER.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Nonaku malola amaneni mumakaseyi, wuyisweki musamendi mumatafwali adi kuwiŋililu wakwitala daFwaro muTapanesi, iku aYuda atalaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.9",
            "verseOrgIds": [
              "JER.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuyili neyi, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Tiyenu, nakatemesha mazu akutambula kambuŋami Nebukaneza mwanta wakuBabiloni, itanda dindi dawanta nakadisha hamalolawa inasweki; wakalemenahu niitenti dindi dawanta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.10",
            "verseOrgIds": [
              "JER.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakenza nakutapa ituŋa daEjipitu, akwakufwa akafwa, akwakuya muwukoli akaya muwukoli, akwakufwa kumpoku yakabali akafwa kumpoku yakabali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakabutula kesi mumatala awakishi awaEjipitu. Yena wakayocha, wakatwala antu muwukoli. Ituŋa daEjipitu wakadivwala neyi chavwalaŋayi kabiŋa ihina dindi. Wakafumamu naku-mwena. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.12",
            "verseOrgIds": [
              "JER.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakakotola nawa nituposhi twakupeshela twakuBetishemeshi, wekala mwituŋa daEjipitu. Nimatala awakishi awaEjipitu wakayocha nakesi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.13",
            "verseOrgIds": [
              "JER.43.13"
            ]
          }
        }
      ]
    }
  ],
