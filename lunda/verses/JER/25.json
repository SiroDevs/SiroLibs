            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamazaza nahoshi nindi, Tiyenu, katama kakela kafuma kumuza iwu kaya kumuza wukwawu, akasaŋumuna mpepela yasweja Ŋovu yakafuma kunsa jeseki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akajahawu kudi Yehova ifuku odu akekala heseki dejima, kufumisha kunsa yeseki yimu ndo nikunsa yeseki yikwawu. Hiyakayidila, hela kuyikuŋula, hela kuyijiikaku. Akekala wushi wahewulu deseki.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
