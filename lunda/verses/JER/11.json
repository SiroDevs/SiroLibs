    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu dakudi Yehova denjili kudi Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.1",
            "verseOrgIds": [
              "JER.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tiyenu mazu achitiyaŋenu ichi, wuhoshi nawaYuda nawashakama muYerusalema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.2",
            "verseOrgIds": [
              "JER.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wuyili neyi, Yehova Nzambi yaIsarela nindi, iyala wukubula kutiya mazu achitiyaŋenu ichi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "chinalejeli ankakulula jenu ifuku dinayifumishili mwituŋa daEjipitu muluteŋi lwachikuŋu, nami, Ovwahilenu izu dami, mwilumu, mwili mwejima munayilejeli kulonda mwikali antu ami, ninami niikali Nzambi yenu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.4",
            "verseOrgIds": [
              "JER.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda nikoleshi kusanyika kunasanyikilili ankakulula jenu, nami niyinki ituŋa datuloŋa twamayeli nawuchi, neyi chimunamoni lelu, iyala wukubula kutiya mazu achitiyaŋenu ichi ekali washiŋewa. Ami hinukwakula nami, Mwomwenomu, eyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakuŋila nindi, Bidikaku mazu awa ejima munyikala yamuYuda, nimunyikwakwa yamuYerusalema, neyi, Tiyenu mazu achitiyaŋenu ichi, mwilumu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.6",
            "verseOrgIds": [
              "JER.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami nayihampumwinini nankashi ankakulula jenu ifuku dinayikandwishili mwituŋa daEjipitu, hampumwine-e nikwifuku dalelu, chakumenekaŋa budidi nakuyi hampumwina, nami, Ovwahilenu izu dami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, hiyovwahilili hela kutegelekaku matu awuku, wejima wawu endeli kwawu mwaya kuchinchika kwanyichima yawu yatama. Dichi chinayishikijilili mazu ejima achitiyanenu ichi inayilejeli kwila, abulili kwilawu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakuŋila nindi, Chikuchi chanakwatuwu aYuda nawashakama muYerusalema chinatiyakani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.9",
            "verseOrgIds": [
              "JER.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anafuntili dehi kukuluwaluwa kwaluwilaŋawu ankakulula jawu alekelaŋa kutiya mazu ami, analondeli dehi mwaya akishi kulonda kuyipesha. Mutaŋa waIsarela namutaŋa waYuda anajahi dehi chitiyaŋenu chami chinatiyageni nawankakulula jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.10",
            "verseOrgIds": [
              "JER.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nahoshi nindi, Tiyenu, nukuyiletela yatama yakakaŋanya kuleyawu. Akambilela, ilaŋa ami hinakayitiyililaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu nyikala yamuYuda nawashakama muYerusalema akaya nakubilela akishi ochelelaŋawu insensi; ilaŋa hiyakayamwina nihanti mwifuku dakamonawu yatamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa eyi Yuda, inwashikila nyikala yeyi dimu mwashika niakishi eyi; mwashikila nyikwakwa yamuYerusalema dimu nawa mumunatuŋili tumeŋa twachuma chikweti ninsonyi, twotumeŋa twakwochela Bayali insensi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi bayi wuyilombela antu awa hela kuyikanjikila izu dakubilela, hela dakuyilombelaku, muloŋa hakamonawu yatama hiyakabilela kudami, ami kwami hinakayitiyaku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.14",
            "verseOrgIds": [
              "JER.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.14",
            "verseOrgIds": [
              "JER.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wami nakeŋa wukwetidi nawa mwakwila mwitala dami? Yena nabajami dehi nawantu amavulu, nimbiji yajila yinakufumi dehi. Chiwelaŋa yatama hiwukuluŋa nikuluŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakutumbili ijina nindi, Yeyi muolive wutuuta wawaha dehi nanyikabu yayiwahi. Nabutuluhu kesi nalushindu lwepumba deneni, nyitayi yawu yinakotoki dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulona Yehova wamazaza wakutumbili nakushimwini dehi yatama, nanoyu yatama yanadikokeluwu akwamutupa waIsarela nawakwamutupa wa Yuda, hananvulokuwu kulonda nizuwi nainsensi yanashitiluwu Bayali.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.17",
            "verseOrgIds": [
              "JER.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.17",
            "verseOrgIds": [
              "JER.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova waŋilukishilumu, ninami hinukuchiluka; hiwukunleja niyelilaŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.18",
            "verseOrgIds": [
              "JER.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nadiŋi neyi kana kamukoku kadiwundila zo-o kadi nakutwalawu nakujaha. Hinelukili nami adi nakunkasila yuma yatamaku, nawu, Tukisaŋanenu mutondu kumu nanyikabu yawu, tumufumishuhu afumi mwituŋa dawamomi, kulonda abuli kwanuka nawa cheŋi ijina dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa eyi Yehova wamazaza wasompeshaŋa chaloŋa, wesekaŋa nyichima yawantu mumavumu, aŋitŋi kumona chiwakaditenda hadi wena; muloŋa nakuleji dehi nsaŋu yami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nateni dehi antu akuAnatoti anafwili kunjaha, adi nakwila nawu, Bayi wakaprofwetaŋa mwijina daYehovaku wakenza kafwila kuchikasa chetu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi Yehova wamazazanindi, Tiyenu, nukuyihempula; anyikwenzi akafwanampo kuya kabali; anyanawu amayala nawambanda akafwa nanzala; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hikwakashala mwinawu niwumuku, muloŋa ami nakaletela antu akuAnatoti yuma yatama, kafwampi wowu mwaka wakuyihempula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.23",
            "verseOrgIds": [
              "JER.11.23"
            ]
          }
        }
      ]
    }
  ],
