      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli nindi, Yaku wakalandi nsaba yewumba yakwema kudi kagemi, wakatambiki awakulumpi awantu, niakulumpi awatupristu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakediki, wakayi kuchinekineki chamwana kaHinomi chidi kuwiŋililu wakuchisu champwembu chaHarisiti, wakashimuni kwenoku mazu inakakuleja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakeli neyi, Enu anyanta awaYuda, ninenu mwashakama muYerusalema, tiyenu izu daYehova; Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Tiyenu, henahanu nakaletelahu yatama, yakwila muntu chakuyitiyayi mumatu indi mwakashoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wena ananleki dehi, hanu anabalumunuhu dehi neyi kwiji hawenyi, anocheluhu akishi insensi, akishi abulili kwilukawu wena, hela ankakulula jawu, hela anyanta jawaYuda; anenzeshuhu dehi mashi awantu akadi nyiloŋa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "anatuni dehi yinaŋanaŋa yaBayali kulonda kwocha anyanawu amayala mukesi, ekali nyilambu yakumushitila Bayali; chuma chinabulili kuyileja, hela kuchitena, chabulili kwinza nikumuchima wami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu tiyenu, Yehova nindi, Kwakenza mafuku akabula kutenawu hanu nawu, HaTofweti, hela nawu, Hachinekineki chamwana kaHinomi, ilaŋa akatena nawu, Hachinekineki chaKujahana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.6",
            "verseOrgIds": [
              "JER.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpúŋa jakwatiluwu aYuda nawakwaYerusalema nakajimwaŋila hanu; nakayidimbwisha nampoku yakabali kumesu awayilumbu jawu, nikudi antu akukeŋa kuyijaha; yibimbi yawu nakayihana yakekali mbiji yakudya atujila ahaluzwizu nianyama ahamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.7",
            "verseOrgIds": [
              "JER.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukaliwu nakawubalumuna wikali wakuhayamewa niwakuyiŋilewaŋa, antu ejima akahitaŋaku akahayama, akayiŋila nansaŋu jayipupu yawu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.8",
            "verseOrgIds": [
              "JER.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayidiisha mbiji yawanyanawu amayala, nimbiji yawanyanawu awambanda, wejima wawu akadya mbiji yawamabwambu jawu, nakukuchika kwakayikuchikawu, nikukala kwakayimweshawu kudi ayilumbu jawu akakeŋa kuyijaha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu wakafumpa nsaba kumesu awantu wakaya nawu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakayili neyi, Yehova wamazaza nahoshi nindi, Chenichi dichi nakafumpa antu awa nimukaliwu, neyi chafumpaŋawu nsaba yakagemi yakaŋanyaloŋawu kunuŋa cheŋi; akajiika antu muTofweti, jiike-e kwakakaŋanya nikwakujiika antu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Tiyenu chinakela henahanu, chinakayila ashakamahu, mukaliwu nakawila neyi Tofweti; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "matala amuYerusalema, nimatala awanyanta awaYuda anatamishuwu, wowu matala ejima akweti ntuŋu janocheluwu yileŋaleŋa yamwiwulu yejima insensi, janahuŋunwinuwu akishi nyilambu yakuhuŋununa, akekala neyi hanu haTofweti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        }
      ]
    },
    {
