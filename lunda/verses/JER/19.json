          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya hakufuma kuTofweti kwamutemesheluwu kudi Yehova kuprofweta, hakwimana muchipaŋu chakwitala daYehova, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuyila antu ejima nindi, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Tiyenu, ŋandiyi ninyikala yayu yejima nakayiletela yuma yatama yejima yinayiteneni, nanochu chachinchikishiluwu nshiŋu jawu kulonda abuli kutiya mazu ami.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        }
      ]
    }
