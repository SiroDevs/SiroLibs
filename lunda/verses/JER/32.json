  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "JER 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu dakufuma kudi Yehova denjili kudi Yeremiya mumwaka wekumi wamwanta wawaYuda Zedekiya, wowu mwaka waNebu-kaneza wekumi nakatanu nakasatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.1",
            "verseOrgIds": [
              "JER.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu njita yamwanta wakuBabiloni yinakuchiki Yerusalema. NiYeremiya anamwenzeleli dehi muchipaŋu chaawatulama chekala kwitala damwanta wawaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.2",
            "verseOrgIds": [
              "JER.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa amwenzela dehi kudi mwanta wawaYuda Zedekiya, nindi, Wukuprofweteladi neyi, Yehova nahoshi nindi, Tiyenu, mukaliwu nukuwuhana kudi mwanta wakuBabiloni, wakawutambula? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.3",
            "verseOrgIds": [
              "JER.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi, Zedekiya mwanta wawaYuda hakapuluka kudi aKaladeyaku, chalala akamuhana kudi mwanta wakuBabiloni, wakahosha nindi kanwa nakanwa, akamonaŋana mesu namesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.4",
            "verseOrgIds": [
              "JER.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi, Wakatwala Zedekiya kuBabiloni, akekali kwokwenoku nichinakamuhempula; dimu mwanahoshiyi Yehova; neyi, Hela mwakalwa nawaKaladeva himwakamona kuwahaku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.5",
            "verseOrgIds": [
              "JER.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.5",
            "verseOrgIds": [
              "JER.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya nindi, Izu daYehova denjili kudami, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.6",
            "verseOrgIds": [
              "JER.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tiya, Hanameli mwana kamandumi yeyi Shalumi wukwinza kudeyi, wukukwila nindi, Landaku iha dami didi kuAnatoti, muloŋa eyi yeyi wuteji kudikúula kulonda wudilandi kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.7",
            "verseOrgIds": [
              "JER.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mwana kamandumi Hanameli wenjili kudami muchipaŋu chaawatulama mwomwizu daYehova, hakuŋila nindi, Landaku mwani, iha dami dekala kuAnatoti, dekala mwituŋa daBenjamini; muloŋa yeyi wuteji kudiswana, muloŋa yeyi mwenikudikúula; kadilandi diikali deyi. Niiluka nikwiluka nami, Hiizu daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.8",
            "verseOrgIds": [
              "JER.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iha dakuAnatoti hinukudilanda kudi mwana kamandumi Hanameli, hinukumupezeleshela mali jishekeli jasiliva ikumi najitanu najiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.9",
            "verseOrgIds": [
              "JER.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nisoneka ninsaŋoyu, hinukulamikahu chilamiki, hinukutambika ayinsahu, hinukumupezeleshela mali hapezu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.10",
            "verseOrgIds": [
              "JER.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukunona mukandowu wansaŋu yakulanda, ninowu wakulamika mwaya lushimbi natushidikilu, ninowu wakadi kulamika, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.11",
            "verseOrgIds": [
              "JER.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hinukumwinka Baruki mwana kaNeriya, mwana kaMahaseya mukanda wansaŋu yakulanda, iku mwana kamandumi Hanameli wudi nakutala, niayinsahu asonekeli majinawu kumukanda wansaŋu yakulanda adi nakutala, aYudeya ejima anashakami muchipaŋu chaawatulama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.12",
            "verseOrgIds": [
              "JER.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukumuhampumwina Baruki kumesu awu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.13",
            "verseOrgIds": [
              "JER.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Nonaku iyi nyikanda yansaŋu yakulanda, niwakulamika chilamiki nimukandiwu wansaŋu yakulanda wakadi kulamika, wuyishi munsaba yewumba, kulonda yakashakami mafuku amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.14",
            "verseOrgIds": [
              "JER.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Nimatala, nimaha, nimatempa anyivinyu amba kayilanda cheŋi mwituŋidi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinelili namwinki dehi mwana kaNeriya Baruki mukanda wansaŋu yakulanda, hinukulomba kudi Nzambi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.16",
            "verseOrgIds": [
              "JER.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami, Ala, Mwanta Yehova! Tiya, yeyi welili mawulu niiseki naŋovu jeyi jeneni, nichikasa cheyi chakwolola; hikwekala chuma chakukaŋanyeyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.17",
            "verseOrgIds": [
              "JER.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyi wamwekeshelaŋa makombakaji awantu luwi, yeyi nawa wafweteshaŋa kuluwa kwawankakulula muntulu jawanyanawu akalondelamu. Nzambi wela nikutoha niŋovu, ijina dindi diyi Yehova wamazaza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.18",
            "verseOrgIds": [
              "JER.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasweja hampùŋa, wasweja ŋovu kunyidimu, wukweti mesu atonena njila jawanyana kawantu jejima, kulonda kuyinka antu ejima yamwaya njila jawu, niyamwaya nyikabu yayuma yelaŋawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.19",
            "verseOrgIds": [
              "JER.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyi washili yinjikijilu nayuma yakuhayamisha mwituŋa daEjipitu, kushika nikulelu, nimuIsarela, nimukachi kawantu acheŋi; hiwukutiyakesha ijina deyi neyi chiwuneli ifuku dalelu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.20",
            "verseOrgIds": [
              "JER.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiwukufumisha antu eyi aIsarela mwituŋa daEjipitu nayinjikijilu, nayuma yakuhayamisha, nachikasa chaŋovu, nachikasa chakwolola, namutentu waweni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.21",
            "verseOrgIds": [
              "JER.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiwukuyinka ituŋidi diwasanyikilili ankakulula jawu neyi nakayinka; ituŋa datuloŋa twamayeli nawuchi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.22",
            "verseOrgIds": [
              "JER.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakwijila mu, hiyakudiheta. Ilaŋa wena kwawu hiyovwahilili izu deyi hela kwenda munshimbi jeyuku. Yuma yejima yiwa yilejeli kwila hiyaneluhu nichimuku. Dichi chiwunayileteli kutama kwejimiku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.23",
            "verseOrgIds": [
              "JER.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala nyikandu, eŋila dehi kwawu mumukala nawu awutambuli. Nimukala awuhana dehi kudi aKaladeya adi nakulwa nawu, nansaŋu yampoku yakabali, nanzala, nachipupu. Nichuma chiwunahoshi chinamwekani dehi. Tala, eyi aweni wunachimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.24",
            "verseOrgIds": [
              "JER.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Mwanta Yehova, wuŋili neyi, Landaku iha namali, wutambiki ayinsahu; kutala mukala awuhana dehi kudi aKaladeya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova hidikwinza kudi Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.26",
            "verseOrgIds": [
              "JER.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tiya, yami Yehova Nzambi yawantu ejima. Kwekala chuma chakukaŋanyami?",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.27",
            "verseOrgIds": [
              "JER.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.27",
            "verseOrgIds": [
              "JER.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nahoshi nindi, Tiya, mukaliwu nakawuhana kudi aKaladeya, nikudi mwanta wakuBabiloni Nebukaneza, wakawutambula kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.28",
            "verseOrgIds": [
              "JER.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "AKaladeya adi nakulwa namukaliwu akenza nakubutula kesi kakwocha mukaliwu hamu namatala akweti tupala twanalambwiluwu Bayali insensi, twanahuŋunwinuwu akishi nyilambu yakuhuŋununa, kulonda anvuloki nizuwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.29",
            "verseOrgIds": [
              "JER.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa anyana kaIsarela nianyana kaYuda mudimu wawu wakukoŋa yatama hohu kumesu ami kufumisha kuwansi wawu. Muloŋa anyana kaIsarela mudimu wawu wakunvulokaŋa hohu, nizuwi nanyidimu yakumakasawu. Dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.30",
            "verseOrgIds": [
              "JER.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mukaliwu ami nawumoni wakusaŋumuna kuzuwa kwami nikulendumuka kwami, kufumisha kwifuku dawutuŋiluwu kushika nikwifuku dalelu; kulonda nakawufumishi kumesu ami, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.31",
            "verseOrgIds": [
              "JER.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakutama kwawanyana kaIsarela nawanyana kaYuda kwejima kwanakoŋuwu niwena, nianyanta jawu, nitulamba twawu, nitupristu twawu, nituprofwetu twawu, niaYuda, niakwakushakama muYerusalema kulonda kunvuloka nizuwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.32",
            "verseOrgIds": [
              "JER.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananfutaleli nyima, hiyanantalishi mesuku. Kutoŋa ami nayilejelaŋa chakumenekaŋa budidi nakuyileja, hela chochu, hiyanantiyili kulonda ayileji maanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.33",
            "verseOrgIds": [
              "JER.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wena anashi yishimashima yawu mwitala natumbili ijina dami, kulonda aditamishi kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatuŋi yinaŋanaŋa yaBayali yidi muchine-kineki chamwana kaHinomi, kulonda kuhanwishaŋa nyanawu amayala nawambanda mukesi ayi kudi Moleki; chuma chakukoŋa chishimashima ichi, chakuvulumwisha aYuda, hiyami nayilejeluku, hichenjili nikumuchima wamuku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu Yehova Nzambi yaIsarela nateni dehi mukaliwu wumudi nakwila nenu, Anawuhani kudi mwanta wakuBabiloni nampoku yakabali, nanzala, nachipupu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tiyenu, nakayipompesha mumatuŋa ejima kunayitemuni chinazuwili, chinalendumukili, chinaswejeli ndombu. Nakayifuntisha cheŋi kwenakunu, nakayishakamisha chakadi kwakama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akekala antu ami, ninami nakekala Nzambi yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayinka muchimawumu ninjila yimu, kulonda akantiyaloŋa woma mafuku ejima, kulonda akamonaŋa kuwaha niwena nianyanawu amba kayilondelaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namba katiyaloŋana nawu chitiyaŋenu chahaya nyaka, nami, Hinakafuma kudi wenamwaka nileki kuyiwahishaku. Nakasha munyichima yawu jakuntiya woma, kulonda akabulaŋa kufuma kudami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayizaŋalela kulonda kuyila mwamuwahi, nakayitumba mwituŋidi chalala chamuchima wami wejima, chawumi wami wejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nahoshi nindi, Imu munaleteli antu awa kutama kweneni kwejimiku, dimu nawa nakayiletela kuwaha kwejima kunayikani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maha akayilandaŋa mwituŋidi dimudi nakwila nenu, Hichihembi chakadi antu hela anyama. Nenu, Adihana dehi kudi aKaladeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu akalandaŋa maha namali, akasonekaŋa nsaŋu oju, akayilamikaŋa yilamiki, akatambikaŋa ayinsahu, nimwituŋa daBenjamini, ninamutunyikala tudi kwakwihi naYerusalema, nimunyikala yamuYuda, nimunyikala yakwituŋa damapidi, nimunyikala yakunkulu, nimunyikala yakukabeta kakuchidiilu; muloŋa nakafuntisha antu awu ayili muwukoli. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
