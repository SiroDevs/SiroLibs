  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JER 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mazu amukanda watemesheliyi kaprofwetu Yeremiya, wafumini kuYerusalema, hakuwutemesha kudi awakulumpi adiŋi muwukoli, nikudi atupristu, nikudi atuprofwetu, nikudi antu ejima atweliyi Nebukaneza muwukoli, afumishiliyi kuYerusalema hakuyitwala kuBabiloni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu mwanta Yekoniya, nimama yamwanta, niatulala, niatulamba twamuYuda namuYerusalema, niakwawukalawenu, niachi afuma dehi kuYerusalema; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuwutemesha namwana kaShafwani Elasa, nimwana kaHiIikiya Gemariya atemesheliyi mwanta wawaYuda Zedekiya kuBabiloni kudi mwanta wakuBabiloni Nebukaneza, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yehova wamazaza, Nzambi yaIsarela, nahoshi nawantu ejima amuwukoli anakwatishiyi kulonda ayifumishi kuYerusalema ayitwali kuBabiloni muwukoli, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tugenu matala, mushakamumu; dimenumatempa, mudiilumuyakudya; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "sumbulenu aŋodi jenu muvwali anyana amayala nawambanda; sumbwilenu anyanenu aŋodi jawu, sumbwishenu anyanenu kudi anfumu jawu, kulonda niwena akavwali anyana amayala nawambanda, mwakasemunwini kwenoku mwakabuli kukeha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukala wunayitwalishi dehi muwukoli wukegelenu jakumwena, wulombelenu kudi Yehova, muloŋa kukumwena kwamukalowu diku kumwakamwena kumwena. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Bayi ayidimba kudi atuprofwetu twenu mwekala nawu, hela kudi akwakuyi hogelaku, bayi mutiyililaŋa yilota yenu yimwalotaŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wena adi nakuyiprofwetela mwakutwamba mwijina dami. Ami kwami hinayitemeshuku. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nahoshi nindi, Neyi nyaka yaBabiloni makumi atanu nayedi yinawani dehi, nakayihempula, nakakoŋa izu dami dadiwahi dinahosheli nenu dakuyifuntisha kwenakunu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami neluki yitogojoka yinayitogojokaŋa, hiyitogojoka yakumwena, hiyitogojoka yakutamaku, kulonda hanyaka yenu yakukuminina nakayinki yakukuhwelela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu dihu mwamba kantambika, mwamba kaya nakulomba kudami, ninami namba kayitiyilila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwamba kankeŋakeŋa, mwamba kanwana neyi Mwakankeŋa keŋa nanyichima yenu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Ninami akanwanaŋa kudenu, namba kabalumuna cheŋi wukoli wenu, namba kayikuŋula munyuza yejima nikumatuŋa ejima kuna yite mwinini. Dimu mwanahoshiyi Yehova. Namba kayifumisha cheŋi oku kunayitwalishili muwukoli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa munahoshi dehi nenu, Yehova natumwekesheli atuprofwetu muBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nateni dehi mwanta wudi nakushakama hetanda daDavidi dawanta, niantu ejima ashakama mumukala wunu, niana kwenumuna buli kuya nawu muwukoli; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamazaza nindi, Tiyenu, nakayitemeshela mpoku yakabali, ninzala, nichipupu, nakayibalumuna kwikala neyi yikuyu yatama, yaka ŋanya ŋawu kudya nanochu chiyasweja kutama. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakayihaŋa nampoku yakabali, nanzala, nichipupu, nakayihana kulonda akayizukumoni mwahita mawanta aheseki dejima, kulonda akayishiŋi, akayihayami, akayiyiŋili, akayisawuli mukachi kanyuza yejima munayitemwini; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanochu chanabuli kutiyililawu mazu ami, dimu mwanahoshiyi Yehova, chanabuli kutiyililawu mazu ami nayitemesheleli nawambuŋami atuprofwetu, chakumenekaŋa budidi nakuyitemesha. Ilaŋa enu kwenu kwonti kwenu kutiya. Dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi enu ejima mwekala muwukoli nafumishili muYerusalema natweli muBabiloni, tiyenu izu daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamazaza, Nzambi yaIsarela, nateni mwana kaKolaya Ahabi nimwana kaMayaseya Zedekiya, adi nakuyiprofwetela chuma chakutwamba mwijina dami, nindi, Tiyenu nukuyihana kudi mwanta wakuBabiloni Nebukaneza. Wukuyŋahila kumesu eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ankoli ejima awaYuda adi muBabiloni akakwatila ishiŋu hadi wena, akela nawu, Yehova akubalumuni neyi Zedekiya, neyi Ahabi nawa, ocheliyi mwanta wakuBabiloni mukesi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanochu chanakoŋuwu jawusupi muIsarela, chanakoŋuwu wuvumbi nawaŋodi jawakwawu, chanahoshuwu mwijina dami mazu akutwamba inabulili kuyilejami. Ami yami neluka, yami chinsahu. Dimu mwanahoshiyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kateni Shemaya wakuNehelami, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Ochu chiwunatemeshi nyikanda mwijina deyeyi aweni kudi antu ejima adi kuYerusalema, nikudi Zefwaniya mwana kakapristu Mayaseya, nikudi atupristu ejima, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakwila neyi, Yehova nakwinki dehi wupristu, nakuhiŋishi dehi mudi kapristu Yehoyada, kulonda mwakekalaŋa atulala amwitala daYehova, twansaŋu jawantu ejima azaluka, niakudinka wuprofwetu kulonda wakayishi mumpompa nimunyonji. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi yidinu wunalekelidi kumuhoshola Yeremiya wakuAnatoti, welaŋa nindi nikaprofwetu kenu? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yena natemeshi dehi mazu kudetu tudi muBabiloni nindi, Wukoli hiwakamana swayuku. Tuŋenu matala, mwakashakamumu. Dimenu matempa, mwakadyi yikusoŋamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Zefwaniya hakutaŋa mukandiwu kumatu akaprofwetu Yeremiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
