      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi ayendu ejima, ni mwana kaKareya Yohanani, nimwana kaHoshaya Yezaniya, niantu ejima kufumisha kudi akadi kulemakushika nikudi asweja kulema, hiyakukundama kwakwihi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.1",
            "verseOrgIds": [
              "JER.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiya kumwila kaprofwetu Yeremiya, nawu, Etŋi mwani namutukulemba, atulombeluku kudi Yehova Nzambi yeyi, alombeluku awa antu ejima anashaluku; muŋatwadiŋi amavulu, tunashali dehi antesha, neyi chiwunamoni namesu eyi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.2",
            "verseOrgIds": [
              "JER.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.3",
            "verseOrgIds": [
              "JER.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaprofwetu Yeremiya hakuyila nindi, Natiyi dehi. T iyenu, nukuyilombela kudi Yehova Nzambi yenu munayi mazu enu. Chakela, chonsucha kaya kulayi Yehova nakayileja. Hina kayi jinda chumaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.4",
            "verseOrgIds": [
              "JER.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwila Yeremiya nawu, Neyi twakabula kwila mwejima mwakaya izu dakakutemeshayi nachu Yehova Nzambi yeyi kudetu, Yehova ekali chinsahu chetu chalala chashinshika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela dakawaha hela dakatama twakovwahilaizu daYehova Nzambi yetu kutukukutemesha; kulonda chitwakovwahila izu daYehova Nzambi yetu chakatuwahili.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimuneli munahiti dehi mafuku ikumi, izu daYehova hidikwinza kudi Yeremiya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.7",
            "verseOrgIds": [
              "JER.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakutambika mwana kaKareya Yohanani niakulumpi yendu adiŋiyi nawu ejima, niantu ejima, kufumisha kudi akadi kulemakushika nikudi asweja kulema, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
              "JER.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuyila nindi, Kudi Yehova, Nzambi yaIsarela, kumwantemesha anamutuukishi kulembelela kwenu kumesu indi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
              "JER.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.17",
            "verseOrgIds": [
              "JER.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, China chinechilili kuzuwa kwami nakulendumuka kwami hadi ashakamini muYerusalema, dichi chinakechila kulendumuka kwami hadenu chimwakeŋa ala muEjipitu. Mwakekala shiŋewa, akuhayama, eshiŋu, asawuka. Henahanuhi mwamba kamona hoku cheŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.18",
            "verseOrgIds": [
              "JER.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu aYuda munashaluku, Yehova nayiteni nindi, Bayi muya muEjipitu ku. Ilukenu chalala nenu ami nayikonkomweni dehi lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwantemesheli kudi Yehova Nzambi yenu, nenu, Tulombeli kudi Yehova Nzambi yetu. Nenu, Mwejima mwakahoshayi Yehova Nzambi yetu, wakatulejumu, twakelamu, mwadi mbeni kwenu munyichima yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninami nayishimwinumu dehi lelu; enu kwovwahila izu daYehova Nzambi yenu, mukoŋuhuhela chuma chimu chanantemesheliyi kuyile ja, nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
            "verseOrgIds": [
              "JER.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu ilu kenu chalala nenu mwakafwa nampoku yakabali, nanzala, nachipupu, kwonsu kumukukeŋa kuyanakushakama.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.22",
            "verseOrgIds": [
              "JER.42.22"
            ]
          }
        }
      ]
    }
  ],
