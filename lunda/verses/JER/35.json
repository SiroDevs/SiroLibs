      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu dakudi Yehova denjilikudi Yeremiya mumafuku aYehovakimi mwana kaYosiya, mwanta wawaYuda, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yaku kumutaŋa wawakwaRekabi, wakahoshi nawu, wakayitwali mwitala daYehova, wakayiŋŋi mukapeka kamu, wakayinki vinyu anwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukwila Yazaniya mwana kaYeremiya, Yeremiya mwana kaHabaziniya, niana kwindi, nianyanindi amayala ejima, nimutaŋa wawakwaRekabi wejima, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "hinukuyitwala mwitala daYehova, mukapeka kawanyana kamwana kaIŋidaliya Hanani, muntu waNzambi, kapeka kadikuma nakapeka kawatulamba, kadiŋi hewulu dakapeka kamwana kaShalumi Maseya, mukwakuhemba kuchisu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukutulila anyana akumutaŋa wawakwaRekabi yeŋa yakunama yenzala vinyu, nimpasa, hinukuyila nami, Nwenu vinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawu, Hitwanwaŋa vinyuku. Muloŋa nkakulula yetu Yonadabi mwana kaRekabi watulejeli nindi, Bayi munwaŋa vinyuku, hela enu, hela anyanenu, chahaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela kutuŋa itala, hela kutumba mbutu, hela kudima itempa danyivinyu, hela kudiheta, chinjila. Mafuku enu ejima mwakashakamaŋa kwamumatenti hohu, kulonda mwakashakami mafuku amavulu mwituŋa dimunazonkami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunovwahili mwizu dankakulula yetu Yonadabi mwana kaRekabi muyuma yejima yatu hampumwininiyi, yatulekesheli kunwa vinyu mafuku etu ejima, ninetu niaŋodi jetu, nianyanetu amayala, nawambanda; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "watulekesheli nikutuŋa matala akushakama. Hitwaheta kwetu hela itempa danyivinyu, hela iha, hela mbutuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunashakami kwetu kwamumatenti, tunovwahili, tuneli mwejima mwatulejeleli nkakulula yetu Yonadabi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chenjiliyi mwanta wakuBabiloni Nebukaneza mwituŋa, hitukwila netu, Twatuyenu kuYerusalema kuchina njita yawaKaladeya nanjita yawaSiriya. Dichi twashakamina kuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova hidikwinza kudi Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Yaku, wakayili aYuda niakwakushakama muYerusalema, neyi, Yehova nindi, Kwonti kwenu kuyileja kulonda mutiyilili mazu ami, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu amwana kaRekabi Yonadabi alejeliyi anyanindi akuyilekesha kunwa vinyu saŋa ayikogelawu, nilelu hiyanwaŋaku, ovwahilaŋa mwayilejeluwu kudi nkakulula yawu; hakwila ami nahoshi nenu chakumenekaŋa budidi nakuhosha, enu kwenu kuntiyililaŋa nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nayitemeshelelaŋa ambuŋami atuprofwetu ejima, chakumenekaŋa budidi nakuyitemeshela, nakwila nami, Funtenu munjila jenu jatama wejima wenu, i wahishenu mumwelaŋa, bayi mulondelaŋa akishi nakuyipeshaku, kulonda mwakashakami mwituŋa dinayinki ninenu niankakulula jenu. Ilaŋa enu kutegelekaku itu, hela kuntiyilila nehi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi chaneluwu anyana kamwana kaRekabi Yonadabi, anakoŋi mwaya kuleja kwayilejeluwu kudi nkakulula yawu, hakwila antu awa kuntiyililami nehi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi Yehova Nzambi wamazaza, Nzambi yaIsarela, nahoshi nindi, Tiyenu, ami nakayiletela aYuda niakwakushakama muYerusalema kutama kwejima kunayiteneni. Muloŋa ami nahoshi nawu, wena kutiyilila nehi. Nayitambiki, wena kwitiya nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya hakwila akwamutaŋa waRekabi nindi, Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Chimunovwahili mwayilejeliyi nkakulula yenu Yonadabi, himukuhemba nikuleja kwindi kwejima, himukwila mwejima mwayilejeliyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi Yehova wamazaza, Nzambi yaIsarela, nahoshi nindi, Mwana kaRekabi Yonadabi hamba kabula muntu wakwimana kumesu amuku haya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.19",
            "verseOrgIds": [
              "JER.35.19"
            ]
          }
        }
      ]
    }
  ],
