  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "PHP 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi neyi mudi Kristu mudi kukundeja, neyi mudi kudikwasha kwakukeŋa, neyi mudi kukundaŋana kwaSpiritu, neyi mudi kudikunda niwushona, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.1",
            "verseOrgIds": [
              "PHP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wanishenu muzaŋalu wami; mutoŋojokaŋa mwomumu, mwikali nakukeŋa kwokumu, mwikali namuchima wowumu niyitoŋojoka yoyimu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.2",
            "verseOrgIds": [
              "PHP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mwila chuma chakuzuŋa hela chakudinka wantaku; chiŋa mutoŋojokaŋa yakudizoza, iwu atoŋojoki mukwawu, nindi wambadikami kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.3",
            "verseOrgIds": [
              "PHP.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi muntu atoŋojokaŋaa nsaŋu yindi hohuku, chiŋa nsaŋu jawakwawu nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitoŋojoka yadiŋi mudi Kristu Yesu yiikali nimudenu nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.5",
            "verseOrgIds": [
              "PHP.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wekala mwomwekalilayi Nzambi, watoŋojokeli nindi kubwambuka naNzambi hichuma chakuhukulaku, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.6",
            "verseOrgIds": [
              "PHP.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa wadibalumwini kwikala wakadi kulema, hakwikala mwekalila nduŋu, hakwikala chaduwu antu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.7",
            "verseOrgIds": [
              "PHP.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamumwenuwu himuntu, hakudizoza, hakwovwa hilana ho-o, ndo nikukufwa, ena kwokufwa kwakukulusu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.8",
            "verseOrgIds": [
              "PHP.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Nzambi nawa namutuumbakeshi chakubadika, namwinki ijina dabadika majina ejima; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.9",
            "verseOrgIds": [
              "PHP.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mwijina daYesu manunu ejima akafukami, niamwiwulu, niahamaseki, niamwishina damaseki; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.10",
            "verseOrgIds": [
              "PHP.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimadimi ejima aketeji nawu Yesu Kristu diyi Mwanta, kulonda kulemesha Nzambi Tata.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi enu akwetu nakena, chimwovwahilana mafuku ejima, kalakalenu wamwinu wenu aweni nawoma nakuzaala, bayi hinashakamana nanenu hohuku, china musweji nihanu hinidi kwacheni. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.12",
            "verseOrgIds": [
              "PHP.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Nzambi diyi wakonana mudenu nimuchima wakukena kwila, nikwila kwakweni, mwakutiyayi yena kuwaha.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.13",
            "verseOrgIds": [
              "PHP.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.13",
            "verseOrgIds": [
              "PHP.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilenuŋa yuma yejima chakadi kutoba hela kufwila ntadi; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.14",
            "verseOrgIds": [
              "PHP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mwikali akadi hakuyinkela Muloŋa, alala, anyana kaNzambi akadi hatama, mukachi kawantu amakonu áheŋa achinchika. Mukachi kawu mwatoŋekaŋa neyi manoŋu mumpata yamunu mwishina, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.15",
            "verseOrgIds": [
              "PHP.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakukwata mazu awumi kwiwulu; kulonda nakadisambi mwifuku daKristu nami hinatemukili chamukunkuluku, hela kukabakana hinakabakeni chamukunkuluku. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.16",
            "verseOrgIds": [
              "PHP.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena, hela akunhununwina hachimuna chakukuhwelela kwenu chimwamuketwilana Nzambi, neyi hihimulambu wakuhunununa, nukutiya kuwaha nakuzanalala hamu nanenu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.17",
            "verseOrgIds": [
              "PHP.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwomumu ninenu mukutiya kuwaha nakuzanalala hamu nanami nawa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.18",
            "verseOrgIds": [
              "PHP.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.18",
            "verseOrgIds": [
              "PHP.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuhweleli mudi Mwanta Yesu nami niyitemesheli Timotewu mafuku anu, kulonda nitiyi kuwaha chinukwiluka chimwashakama. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.19",
            "verseOrgIds": [
              "PHP.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nabuli mukwawu wudi neyi yena wukwakama chalala chimwashakama. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.20",
            "verseOrgIds": [
              "PHP.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ejima adikeŋelana yawu hohu, hiyakena nsanu yaYesu Kristuku.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.21",
            "verseOrgIds": [
              "PHP.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.24",
            "verseOrgIds": [
              "PHP.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natoŋojoki nami chachiwahi niyifuntishili mana kwami Epafwaditu, mukwetu nakalakalaŋa nindi, ishidika nami, ntemesha yenu, waleteli yuma yakunkwasha hinabulili. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.25",
            "verseOrgIds": [
              "PHP.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yena wafwilaŋa kuyimona wejima wenu, watiyili kumuchima bwi nansaŋu yimwatiyili nawu wakata. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.26",
            "verseOrgIds": [
              "PHP.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PHP 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala yena wadiŋi wakata, kwasheli hanti nakufwa; ilaŋa Nzambi wamutiyilili luwi; hatiyilili luwi yena hohuku, ilaŋa ninami nawa, kulonda kubuli kulunjika kuneŋa hakuneŋa kwakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.27",
            "verseOrgIds": [
              "PHP.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PHP 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nadi hindi kumufuntisha, kulonda chimwakamumona cheŋi mwakatiyi kuwaha nankashi, kuneŋa kwami kwakakehi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.28",
            "verseOrgIds": [
              "PHP.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PHP 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mutambulenu mudi Mwanta nakuzaŋalala kwakweni; yilemeshenu antu adochu; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.29",
            "verseOrgIds": [
              "PHP.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PHP 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wakeŋa eli kufwa kukoola mudimu waKristu; haakamini kufwaku, kulonda awanishi nyidimu yimwakaŋenyi kuŋilila.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.30",
            "verseOrgIds": [
              "PHP.2.30"
            ]
          }
        }
      ]
    }
  ],
