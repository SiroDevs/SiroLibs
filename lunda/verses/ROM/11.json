          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maheta amaana nayuma yelukayi Nzambi, o chiyakunama! Wuŋaji windi, o chiwakaŋanya kuwiluka! Njila jindi, o chijakaŋanya kujishinshika! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.33",
            "verseOrgIds": [
              "ROM.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwatoŋojokayi Yehova welukamu hinyi? Hinyi nashakami nindi hampùŋa? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntwinyi wasambilahu dehi kumwinka chuma, mwaka akamufuntishilichu? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.35",
            "verseOrgIds": [
              "ROM.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
