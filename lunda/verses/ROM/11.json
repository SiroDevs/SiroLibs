          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yuma yejima yafumaŋa kudi yena, ayilaŋa mudi yena, amwililaŋa yena. Kudi yena kwikali kulema haya nyaka. Amena.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.36",
