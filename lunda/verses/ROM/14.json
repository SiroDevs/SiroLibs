  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "ROM 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tambulenu muntu wabula Ŋovu mukukuhwelela, ilaŋa bayi chakutadika ninduku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.1",
            "verseOrgIds": [
              "ROM.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wumu wekala nakukuhwelela kwakudya yuma yonsu, mukwawu wabula Ŋovu wadyaloŋa kwamafu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.2",
            "verseOrgIds": [
              "ROM.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wadyaloŋa, bayi asekesha mukwawu walekaŋa kudyaku; muntu walekaŋa kudya, bayi asompesha mukwawu wadyaloŋaku, muloŋa Nzambi namutambuli. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.3",
            "verseOrgIds": [
              "ROM.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi wukusompesha ŋamba yambala, yeyinyi? Hela nemani hela nadimbuki, hinsaŋu yaMwanta windi omweni. Chalala akamwimika, muloŋa Mwanta natweshi kumwimika.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.4",
            "verseOrgIds": [
              "ROM.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.4",
            "verseOrgIds": [
              "ROM.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wumu walemeshaŋa ifuku dimu nindi dabadika di kwawu; mukwawu nindi mafuku ejima wowamu hohu. Chachiwahi antu ejima eluki chalala awenawu, iwu mwanatoŋojokiyi, iwu mwanatoŋojokiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.5",
            "verseOrgIds": [
              "ROM.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wajilikaŋa ifuku, wadiŋilikileŋa Mwanta; muntu wadyaloŋa, wadijilikaŋa Mwanta, muloŋa wamusakililaŋa Nzambi; muntu walekaŋa kudya walekelaŋa hansaŋu yaMwanta, niyena nawa wamusakililaŋa Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.6",
            "verseOrgIds": [
              "ROM.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwosi mwinetu wadihandilaŋa yomwenuku; kwosi wadifwilaŋa yomwenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.7",
            "verseOrgIds": [
              "ROM.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hela tukuhanda, tukumuhandila Mwanta; hela tukufwa, tukumufwila Mwanta. Dichi hela tukuhanda hela tukufwa, tudi ambala aMwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.8",
            "verseOrgIds": [
              "ROM.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dihu hafwililiyi Kristu hakuhanda cheŋi, kulonda akekali Mwanta wawafu niamomi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.9",
            "verseOrgIds": [
              "ROM.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.9",
            "verseOrgIds": [
              "ROM.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi mukwetu, wasompeshelaŋadi mana kweyi? Cheŋi nawa, eyi mukwetu mukwawu, wasekeshelaŋadi mana kweyi? Muloŋa wonsu wetu twamba kemana kwitanda daNzambi dakusompela. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.10",
            "verseOrgIds": [
              "ROM.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa nasoneki nawu, Yehova nahoshi nindi, Chinahandaŋichi, manuŋu ejima amba kanfukamina, madimi ejima amba keteja kudi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.11",
            "verseOrgIds": [
              "ROM.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, wejima wetu twamba kalumbulula kudi Nzambi mutwelaŋa hamuntu hamuntu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.12",
            "verseOrgIds": [
              "ROM.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.12",
            "verseOrgIds": [
              "ROM.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi tusompeshaŋa akwetu nawa cheŋuku. Chakala tubabalenu tubuli kushila mana kwetu chuma chakudimbukila hela chakuhukena munjila yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.13",
            "verseOrgIds": [
              "ROM.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neluki chikupu mudi Mwanta Yesu, nami hikwekala chuma chaditaminaŋa chachenuku; Ilaŋa muntu watoŋojokaŋa nindi chatama, chikwikala chuma chatama kudi yenowu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.14",
            "verseOrgIds": [
              "ROM.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi waneŋeshaŋa mukwenu nakudya kweyi, wunaleki dehi kwenda mukukeŋa. Bayi wukisaŋana mukwenu afwililiyi Kristu, nakudya kweyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.15",
            "verseOrgIds": [
              "ROM.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwelaŋa chachiwahi bayi achitenaŋa nawu chatamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.16",
            "verseOrgIds": [
              "ROM.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wanta waNzambi hiwalemena mukudya nakunwaku, walemena mukuloŋa, nimukuwunda, nimumuzaŋalu wamudi Spiritu Wajila. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.17",
            "verseOrgIds": [
              "ROM.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakalakelaŋa Kristu mwenimu, wamutiyishaŋa Nzambi kuwaha, amuhamekaŋa nikudi antu nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.18",
            "verseOrgIds": [
              "ROM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tushenu muchima hakwila yuma yaletaŋa kuwunda, niyuma yakudikolesha nachu wumu namukwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.19",
            "verseOrgIds": [
              "ROM.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mujaha mudimu waNzambi nansaŋu yakudyaku. Chalala yuma yejima yayiwahi; ilaŋa chatama muntu kudimbwisha mukwawu nachuma chadyaloŋayi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.20",
            "verseOrgIds": [
              "ROM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chachiwahi kuleka kudya mbiji, hela kunwa walwa, hela kwila chuma chimu chakudimbwisha nachu mana kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.21",
            "verseOrgIds": [
              "ROM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukuhwelela kweyi kuwekala naku, ikalaku naku eyi aweni kumesu aNzambi. Muntu wabulaŋa kudi bayisha nachuma chetejaŋayi, nakooleki. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.22",
            "verseOrgIds": [
              "ROM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila muntu wukudya nantadi nabayi, muloŋa nadyi chakadi kukuhwelela; Muloŋa yuma yejima yabula kuya mukukuhwelela hinshidi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.14.23",
            "verseOrgIds": [
              "ROM.14.23"
            ]
          }
        }
      ]
    }
  ],
