          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.10",
            "verseOrgIds": [
              "MIC.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katataka nyuza yayivulu yinakupompeli chandombu; adi nakwila nawu, Muleki amujiloli kwindi, disu detu ditali chuma chidakeŋa kumona Ziyona.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.11",
            "verseOrgIds": [
              "MIC.4.11"
            ]
          }
        }
      ]
