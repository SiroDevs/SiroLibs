    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu mwenimu namutukuhosha chaya mukwila netu tukweti kapristu muneni wudi ochu, washakama dehi kuchikasa chachidiilu chetanda dawanta daMukeleŋi mumawulu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yena Kristu mukwakukalakala mumalala, nimutabanaka yalala yalemenuwu kudi Mwanta bayi kudi muntuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋatupristu amaneni ejima ayikunjikaŋa kumudimu wakulambula yamukunkulu nikuketula yimuna, dichi chinawahi niyeniwu ekali nachuma chakulambula. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.3",
            "verseOrgIds": [
              "HEB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wadiŋi hamaseki hadi kutwesha kwikala kapristu nihantuku, muloŋa kwekala amakwawu alambulaŋa yamukunkulu mwaya nshimbi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.4",
            "verseOrgIds": [
              "HEB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma chakalakalaŋawu wena hichuma chakufwikija nachu, himwevulu wayuma yamwiwulu; muloŋa chakeŋeliyi Mosi kutuŋa tabanaka, amukonkomweneni nawu, Wutalaŋa chiŋa wakela mwejima mwaya chesekelu chayu, chiyakulejeluwu hampidi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwilichi yena natambuli dehi mudimu wabadika nankashi kuwaha, nanochu chaneliyi hiihaku dachitiyaŋenu chabadika kuwaha, chanatiyaŋenuwu nayikaninu yabadika kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi chakusambila chabulili hatama hiyadi kukeŋakeŋa chamuchiyeduku.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chayimweniyi kuluwa, Yehova hakwila nindi, Tiyenu, kwakenza mafuku inakatiyaloŋana chitiyaŋenu chachiha namutaŋa waIsarela nimutaŋa waYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hichakaya mwaya chitiyaŋenu chinatiyaŋeni nawankakulula jawu, ifuku dinayikwatili kuchikasa nakuyifumisha mwituŋa daEjipituku; chena chitiyaŋenochu achijahili, ninami hinayishili kumuchimaku; dimu mwanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Tiyenu chitiyaŋenu chinakatiyaloŋana namutaŋa waIsarela hakamana mafuku owu; nakasha nshimbi jami muyitoŋojoka yawu, nakajisoneka munyichima yawu. Nakekala Nzambi yawu, niwena akekala antu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakadilejaleja nawa cheŋa, iwu nakuleja mukwawu, iwu nakuleja mana kwindi, nindi, Ilukaku Yehovaku; muloŋa akaŋiluka wejima wawu, kufumisha kudi wakadi kulema, ndo nikudi wasweja kulema. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami nakayanakena kuluwa kwawu, ninyiloŋa yawu hinakayanuka nawa cheŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanateniyi chitiyaŋenu ochu nindi chachiha, komana chatachi nachilishi dehi chachikulu. Hakwila ochu chikuya nakunoŋa, chela dehi chanyaka, keŋa chimini.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
            "verseOrgIds": [
              "HEB.8.13"
            ]
          }
        }
      ]
    }
  ],
