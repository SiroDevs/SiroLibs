          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakukuhwelela ahitili mukaluŋalwiji kachinana nakwenda hamaseki awuma, cheliluwu aEjipitu nawu esekumu hiyakujilumukilamu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
