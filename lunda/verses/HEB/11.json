          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa Nzambi watumwenenaŋahu dehi chuma chabadika kuwaha, kulonda abuli kuyiwahishaŋahu dehi chikupu chakadi etu.",
          "type": "text",
