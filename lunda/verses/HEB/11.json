              "type": "text"
            }
          ]
        },
        {
          "text": "Wena ejimawa, hela atiyakeni mpuhu yayiwahi yakukuhwelela hiyatambwili chikaninuku, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.39",
