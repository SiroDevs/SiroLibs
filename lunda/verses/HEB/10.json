  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HEB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nshimbi jikweti mwevulu wayuma yayiwahi yikwinza, hidiyi yuma yayeni muyekalilaku. Dihu hafumaŋa kukaŋanya kuwahisha chikupu antu akundaminaŋa kwakwihi, nayimuna yaketulaŋawu yimu hohu hamwaka hamwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutenowu aleka dehi kuyilambula. Akwakudifukula, neyi anayitookeshi dehi, chinleji chawu chamuchima hichikuyihisha cheŋi nanyiloŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyimunoyu mwekala kwanukisha nyiloŋa hamwaka hamwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mashi awaŋombi amayala niawampembi hiyanatweshi kufumisha nyiloŋa hela hantuku.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chenjiliyi mumpata yamunu mwishina hakwila nindi, Kukuketwila chimuna hela kukulambula himulambu, hiwayikeŋeli kweyuku, hiwukunloŋeshela mujimba. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi hiwunakeŋi nyilambu yamukuma yakushita, hela nyilambu yahanshiduku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukwila nami, Tala, ami nenzi dehi nakwila muchima weyi, eyi Nzambi; chochanasonekuwu mumukanda wakuvuŋa nakuntenami. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanasambiliyi dehi kuhosha nindi, Yimuna yakuketula nanyilambu, hela nyilambu yamukuma yakushita niyahanshidi, yalambulaŋawu mwaya nshimbi, hiwayikeŋeli kweyuku; hela kuyitiya kuwaha hiwayitiyili kuwahaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.8",
            "verseOrgIds": [
              "HEB.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhosha cheŋi nindi, Tala, ami nenzi dehi nakwila muchima weyi. Hakufumisha chatachi kulonda akoleshi chamuchiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.9",
            "verseOrgIds": [
              "HEB.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawena muchimowu anatujiliki nahimulambu wamujimba waYesu Kristu walambwiliyi kamu hohu bweŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.10",
            "verseOrgIds": [
              "HEB.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala atupristu ejima emanaŋa hefuku hefuku nakukalakala, nakulambula kakavulu yimuna yakuketula yoyimu, yabulaŋa kutwesha kufumisha nyiloŋa hela hanti; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.11",
            "verseOrgIds": [
              "HEB.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakwila yena, chanadilambuliyi ekali chimuna chakuketula chahanyiloŋa chimu chahaya nyaka, hakushakama kuchikasa chaNzambi chachidiilu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.12",
            "verseOrgIds": [
              "HEB.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kufumisha henohu hakutalila hamba kabalumunawu akwankunyi nindi kwikala itanda dakunyendu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.13",
            "verseOrgIds": [
              "HEB.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yena nawahishi chikupu antu anajilikuwu, nahimulambu wumu chahaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.14",
            "verseOrgIds": [
              "HEB.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiSpiritu Wajila nawa hakutushimwina wunsahu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.15",
            "verseOrgIds": [
              "HEB.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa chanahoshiyi dehi nindi, Tiyenu chitiyaŋenu chinakatiyaloŋana nawu hakamana mafuku owu; dimu mwaneliyi Yehova nindi, Nakasha nshimbi jami muyitoŋojoka yawu, nakajisoneka munyichima yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhosha cheŋi nindi, Hinamba kaanuka nawa cheŋi nyiloŋa yawu hela kuluwa kwawuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwekala kwanakena antu yumiyi hikwekala nawa cheŋi kulambula himulambu wahanshiduku.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.18",
            "verseOrgIds": [
              "HEB.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.18",
            "verseOrgIds": [
              "HEB.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu enu ana kwetu, chitunabuli woma wakwijila mwajila namashi aYesu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.19",
            "verseOrgIds": [
              "HEB.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanjila yayiha yatubuzililiyi, yayumi, yamwihina daku jika, wowu mujimba windi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.20",
            "verseOrgIds": [
              "HEB.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "chitukweti kapristu muneni wakuyula mwitala daNzambi, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "tukundamenu kwakwihi namuchima walala, naku kuhwelela kwakweni, nanyichima yetu yakusampwila dehi, kulonda chinleji chamuchima chatama chitooki, namujimba wetu wakuwelesha dehi meji amawahi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukakelenu kwiteja kwakuchiŋeja kwetu mbe, kwakenda kahumeka, muloŋa wakanini washinshika. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuditoŋojokenu muntu himuntu, kulonda tusaŋumuni akwetu kukeŋaŋana nakwila nyidimu yayiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi tuleka kupompa neyi chelaŋawu amakwawuku, chiŋa kudilejaleja, chisweji nankashi nanichi chimunamoni ifuku odu hidikwinza nakuswila kwakwihi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi tukuvulumuna chakukeŋamu, iku tweluka dehi nsaŋu yalala, hikunashali chimuna chikwawu chakuketwila nyiloŋaku; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunashali kwawoma waweni wakutalila kusompesha ni kesi kabidima kakanoŋesha ayilumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
            "verseOrgIds": [
              "HEB.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu nadiwuli nshimbi jaMosi, chakumushimunawu kudi ayinsahu ayedi hela asatu, wukufwa chakadi luwi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu nadati Mwana kaNzambi, natoŋojoki mashi achitiyaŋenu amujilikiluwu nachu nindi hiyajilaku, nasawuli Spiritu waluwi, munatoŋojoki nenu akabula kumufuukula nawu nateli kubabesha kwabadikaku, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa twamwiluka yena welili nindi, Yami nukutenda, yami nukufweta. Cheŋi nawa nindi, Yehova wakasompesha antu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hi chuma chi kweti woma kuholokela mumakasa aNzambi wamumi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa nukenu mafuku akusambila, himwelili munamoni dehi chejeji, chimwatatakeneni mukulwisha nankashi namakabi; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
            "verseOrgIds": [
              "HEB.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "iku antu adi nakutala chakuyisawulawu nakuyikabisha, iku munadibombi nawakwenu aweni mwomumu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwatiyilili luwi antu adiŋi munyonji; chayibuwiluwu mahetenu kudi antu, mwovwahililumu nakuzaŋalala, nakwiluka enu aweni nenu mukweti iheta dabadika kuwaha dakakumaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi bayi muleka kuumika kwenuku, kukweti masomu abadika akayisomonawu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
              "HEB.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiŋa mutatakena kulonda chimukwila muneli dehi muchima waNzambi mwakatambuli chikaninu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
            "verseOrgIds": [
              "HEB.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawu, Hanashali hanti nakwinza yena elaŋawu nawu wakenza, hakalabaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheŋi nawu, Muntu wami waloŋa wuku handila kukwitiya kwakukuhwelela; hakwila neyi yena wukufuntamu, muchima wami hiwukumutiya kuwahaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila etu kwetu hitudi akwakufuntamu kulonda tunoŋuku; tukweti kwitiya kwakutambula wamwinu wawumi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.39",
            "verseOrgIds": [
              "HEB.10.39"
            ]
          }
        }
      ]
    }
