    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chanatushiyiluwu chikaninu chakwijila mukunooka kwindi, tutiyenu woma hakenda kamwekana mwinenu wumu wukufwana neyi nakaŋanyi kushikamu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala ninetu anatushimwini nsaŋu yayiwahi neyi chayishimwininuwu niwena; ilaŋa mazu atiyiluwu hiyayikwashiluku, muloŋa antu atiyili abulili kubombelaku kukuhwelela. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi etu tunakuhweleli tweŋilaŋa mukunookoku kwateneniyi nindi, Chinazuwili nasanyikili nami hiyakeŋila mukunooka kwamuku; kutoŋa chalala nyidimu yamanini kufumisha haaliluwu chikuku champata yamunu mwishina. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hamukanda wajila hacheŋi nateni ifuku damu chitanu nachiyedi nindi, Chamanishiliyi Nzambi nyidimu yindi yakoŋelaŋayi yejima, hakunooka hefuku damu chitanu nachiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.4",
            "verseOrgIds": [
              "HEB.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahoshelumu cheŋi nindi, Hiyakeŋila mukunooka kwamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.5",
            "verseOrgIds": [
              "HEB.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu kunashali kwijila amakwawu, hakwila wena ásambilili kushimwinawu nsaŋu yayiwahi akaŋenyi kwijila muloŋa wakujikwa, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.6",
            "verseOrgIds": [
              "HEB.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakutena cheŋi ifuku dimu mudi Davidi, henohu munahiti dehi nyaka, nindi, Lelu. Mwomwanahoshiyi dehi nindi, Lelu neyi mukutiya izu dindi bayi muchinchikisha nyichima yenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.7",
            "verseOrgIds": [
              "HEB.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi Yoshuwa wayinkeli kunooka, Nzambi hadi kutena nawa cheŋi ifuku di kwawu kukukumininaku. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.8",
            "verseOrgIds": [
              "HEB.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kudi antu aNzambi kunashali kunooka kwalala. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.9",
            "verseOrgIds": [
              "HEB.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa muntu nepili dehi mukunooka kwindi, niyena naleki nawa nyidimu yindi, nanooki dehi neyi chanookeliyi Nzambi hamanishiliyi nyidimu yindi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tushenu muchima hakwijila mukunookoku, hakenda kamwekana muntu wukudimbuka nakulondeja mwajikwiluwu wena. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mazu aNzambi amomi, akweti Ŋovu, atwa chakubadika mpoku yakabali yikweti wumwemu kuyedi, apwikaŋa nakwambula wumi naspiritu, manuŋi namanji, asweja kushinshika yitoŋojoka niyafuukulaŋa muchima. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwosi chuma chaleŋeluwu chinabuli kumwekana kumesu induku, yuma yejima yidi nzekesi, yidi hatooka kumesu ayena itwamba kadimona nindi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chitukweti kapristu muneni naŋandakani dehi mawulu, yowu Yesu, Mwana kaNzambi, tukakelenu kwiteja kwetu mbe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa tukweti kapristu muneni watweshaŋa kutiya wushona chitwazeyazeyaŋetu, niyena amwesekeli muyuma yejima neyi chatwesekaŋawu etu, ilaŋa mudi yena nshidi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tukundamenu kwakwihi netanda daluwi chakadi woma, tutambuli kwanakena, tumoni luwi lwakutukwasha hitukumona kukala.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.16",
            "verseOrgIds": [
              "HEB.4.16"
            ]
          }
        }
      ]
    }
  ],
