  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "DEU 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wakujikishaŋa muyitanu nayiyedi, yitanu nayiyedi, kudeyi wakekalaŋa wakuleka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya muwakalekelaŋa; antu ejimaasondamisha yuma yawu akaleka yuma yasondamishiluwu akwawu; hiyakakala yuma yawu kudi akwawu hela kudi ana kwawuku; muloŋanashimuni dehi kuleka kwakulekela Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakwacheŋiwukumukala tuhu; kwinza chadiiliyi mana kweyi wakachileka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helachochu, kudeyi hikwakekala atuzweŋuku; muloŋa Yehova wakabadika kukukoolekesha mwituŋa dakukwinkayi Yehova Nzambi yeyi dawuswana wakuheta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi wakatiyilila chachiwahi mwizu daYehova Nzambi yeyi nakusha muchima wakwila kulejiku kwejima kunukukuleja lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova Nzambi yeyi wakakukoolekesha mwakukaniniyi; eyi wakasondamishaŋa nyuza yayivulu, ilaŋa eyi kusondama nehi; eyiwakayulaŋa nyuza yayivulu, ilaŋ wena hiyakayuleyuku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi hamukala wumu wetuya deyi dakukwinkayi Yehova Nzambi yeyi hakekala mana kwenu wumu kazweŋi, bayi wakamuchinchikishila muchimaweyi hela kumukamatila chikasa cheyi owu mana kweyi kazweŋuku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "chalala chiŋa wakamukamunwina chikasa cheyi, eŋa chalala chiŋa wakamusonda mishahohu, wakawanishi yanabuliyi yanakaŋanyiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.8",
            "verseOrgIds": [
              "DEU.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalaku wakenzakatoŋojoka chuma chatama mumuchima weyi, chakwila neyi, Mwaka wamuchitanu nachiyedi, wowu mwaka wakuleka, wudi kwakwihi; nidisudeyi hidikumutamina mana kweyi wakazweŋi hiwukubula kumwinka chuma; niyena hakakudilila kudi Yehova, kudeyi hichakekala nshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.9",
            "verseOrgIds": [
              "DEU.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala chiŋa wakamwinkaŋa hohu, chiwukumwinka bayi wutiya kutama mumuchimaweyuku; muloŋa chena chumichi dichi chakakukoolekeshelayi Yehova Nzambi yeyi munyidimu yeyi yejima, nimuyuma yejima yiwaka kwata chikasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa himwamba kabula kazweŋi mwituŋa ku; dichi chinuku kulejela nami, Chalala chiŋa wakamukamunwina mana kweyi chikasacheyi, niweyi wabula, nikazweŋi keyi, mwituŋa deyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
            "verseOrgIds": [
              "DEU.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
            "verseOrgIds": [
              "DEU.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi akakulandisha mana kweyi kaHeberu weyala, hela kaHeberu wamumbanda, nakukalakeli dehi nyaka yitanu nawumu, mumwaka wamuchitanuna chiyedi wakamuleki akadiyili kwindi, nafumi dehi muwuduŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.12",
            "verseOrgIds": [
              "DEU.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwaka muleka afumi muwuduŋu, bayi wakamuleka akayi makasakasaku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.13",
            "verseOrgIds": [
              "DEU.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamwinki chachiwahi niyamwiyinda deyi niyahawuhulilu weyi, niyamuchikalaŋa cheyi, niyamuwukamwinu weyi wavinyu; mwanakukoolekesheliyi Yehova Nzambi yeyi dimu muwakamwinkela. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.14",
            "verseOrgIds": [
              "DEU.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaanukaŋi chiwadiŋi nduŋu mwituŋa daEjipitu, hiyakukukuula kudi Yehova Nzambi yeyi; dichi chinukukulejela chumichi lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwumoni hakukwila nindi, Ami kwami hinukufuma kudeyuku; nakukeŋi dehi nimutaŋa weyi, nanochuchanashakamiyi naneyi chachiwahi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.16",
            "verseOrgIds": [
              "DEU.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu hiwakatambula mumba, hiwakamulokwela itu dindi kuchenzelu, hakekala ndupu yeyi wahaya nyaka. Ninduŋu yeyi wamumbanda wakamwilaŋa chochimu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.17",
            "verseOrgIds": [
              "DEU.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwakamonakukala kumuleka afumi muwudupuku, muloŋa yena nakukalakeli dehi nyaka yitanu nawumu, mwakwila neyi wadiŋi ŋamba wakukwata wadikukalakalamu maŋampa kayedi; niYehova Nzambi yeyi wakakukoolekeshamuyuma yejima yiwakela.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awedi amayala ejima akuvwalika nimwitaŋa deyi nimwiyinda deyi wakamujilikilaŋawu Yehova Nzambi yeyi; ŋombi yeyi weyala wawedi bayi wakakalakala nachuku, hela mukoku weyi wawedi bayi wakamutewulaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamudiili, nineyi niakwitala deyi, kumesu aYehova Nzambi yeyi hamwaka hamwaka kuchipela chakatondayi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wukwetihindi hataminayi, kwiji wabalakataŋa, indi kwiji himputamesu, indi kwijiwatama ŋahi indi kwiji ŋahi, bayi wakamuketwila Yehova Nzambi yeyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamudiili hamukala weyi; akamudiila hamu niantu amajilu niatooka, neyi chimwadyaŋa mbaala nankayi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.22",
            "verseOrgIds": [
              "DEU.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila mashi awu bayi wakayidyaku; wakayimwaŋila hamaseki neyi meji.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.23",
            "verseOrgIds": [
              "DEU.15.23"
            ]
          }
        }
      ]
    }
  ],
