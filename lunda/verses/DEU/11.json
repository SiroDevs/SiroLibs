  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "DEU 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu kakeŋi Yehova Nzambi yeyi, kahembi nimwanashiikiyi, nimuyidika yindi, nimuwuŋaji windi, nimwanakulejiyi, mafuku ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilukenu lelu; ochu nidi nakuhosha nawanyanenu anabuli kwiluka wanyi, muloŋa wena abulili kumona mwababesheliyi Yehova Nzambi yenu, hela ŋovu yindi, hela chikasa chindi chaŋovu, hela chikasa chindi chakwolola, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela yinjikijilu, hela nyidimu yindi yakoŋeliyi muEjipitu, yamukopeliyi Fwaro mwanta wakuEjipitu niituŋa dindi dejima; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.3",
            "verseOrgIds": [
              "DEU.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimwakoŋeliyi njitaya muEjipitu nituwalu twawu nimakálu awu; chayikumpwiliyi nameji aKaluŋalwiji Kachinana hayihapiluwu, nichichayijilu mwiniyi Yehova nikwitaŋwa dalelu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichichayilililiyi mwisaŋa kushika ndo nikunu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.5",
            "verseOrgIds": [
              "DEU.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichichamukopeliyi Datani naAbirami, anyana kaEliyabi, mwana kaRubeni; chidaasamini iseki kanwa kadu hidikuyiminya, niwena niakwamatalawu, nimatenti awu niyuma yayumi yejima yadiŋuwu nayu, mukachika waIsarela ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.6",
            "verseOrgIds": [
              "DEU.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa enu aweni munamoni namesu enu mudimu waYehova weneni wakoŋeliyi wejima.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu mwakahembaŋa kuleja kwejima kunakuleji lelu, kulondamwakakoli, mwakeŋili nakuheta ituŋa dimukuzambuka nakuheta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.8",
            "verseOrgIds": [
              "DEU.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwakavulishi mafuku enu mwituŋa dasanyikililiyi Yehova ankakulula jenu kuyinkaduniwena ni anyanawu, ituŋa datuloŋa twamayeli nawuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.9",
            "verseOrgIds": [
              "DEU.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa tuŋa dimukuya nakuheta hididi neyi ituŋa daEjipitu dimwafumini, dakwila wutumba mbutu yeyi, hiwukuyitukumwina namwendu weyi, neyi itempada mbokaku; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.10",
            "verseOrgIds": [
              "DEU.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa ituŋodu dimukuzambuka nakuheta, hiituŋa damapidi nayinekineki, danwaŋa meji anvula yamwiwulu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.11",
            "verseOrgIds": [
              "DEU.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiituŋa dakuhemba kudi Yehova Nzambi yeyi; dihu hekala mesu aYehova Nzambi yeyi hefukuhefuku, kufumisha hakutachikila mwaka nihakumanina mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mona neyi mwakatiyilila chachiwahi kuleja kwami kunukuyileja lelu, nakumukeŋa Yehova Nzambi yenu nakumukalakela nanyichima yenu yejima, nawumi wenu wejima, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.13",
            "verseOrgIds": [
              "DEU.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakayinka nvula yamwituŋa denu hachilaakachayu, ninvula yakusambila ninvula yakukuminina, wakakuŋulinitidiku yeyi, nivinyu yeyi, nimanji eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.14",
            "verseOrgIds": [
              "DEU.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakamenesha mumpata yeyi matahu awayimuna yeyi, wakadya, wakekuta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.15",
            "verseOrgIds": [
              "DEU.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalenu kuchina nyichima yenu kuyidimba, himukusenuka hambadi nakupesha akishi, himukudifukula kudi wena; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.16",
            "verseOrgIds": [
              "DEU.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "niYehova hakayizuwila, hakajika iwulukulonda nvula yibuli kunoka, niituŋa dibuli kusoŋa mbutu yadu; himwakajilu mukachakadi nikuleha mwituŋa dadiwahi dakuyinkayi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu mwakaswekaŋa mazu ami munyichima yenu nimuyitoŋojoka yenu; mwakayikasilaŋa kumakasenu ekalaŋa chinjikijilu, mwakayivwalaŋa haneli disu iku, disu iku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.18",
            "verseOrgIds": [
              "DEU.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakalejaŋamu ni anyanenu, akekalaŋampanji yenu, nichiwakashakamaŋa mwitala deyi, nichiwakendaŋamunjila, nihakukama nihakuhinduka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.19",
            "verseOrgIds": [
              "DEU.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakayisoneki hayiŋamba yakwitala deyi, nikuyenzelu yakuyiŋaŋu yeyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.20",
            "verseOrgIds": [
              "DEU.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda nimafuku enu nimafuku awanyanenu akavulaŋa mwituŋa dasanyikililiyi Yehova ankakulula jenukuyinkadu, neyi chekala mafuku amwiwulu dichi chakekala nihamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa neyi mwakahembaŋa chachiwahi kulejiku kwejima kunukuyileja, himukwilamu, himukukeŋa Yehova Nzambi yenu, himukwenda mwayanjila jindi jejima, himukumulamata mbe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu Yehova hakatemunamunyuzoyu yejima kumukuya, himwakaheta ninyuza yayibadika nikutoha niŋovu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.23",
            "verseOrgIds": [
              "DEU.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hejima himwakadata nyendu yenu hakekala henu; ŋinza yenu yakekala kufumisha kwisaŋa, niLebanoni, nikufumisha kukaloŋa, yowukaloŋa Yufurati, lusu nikukaluŋalwiji kakumujika. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hosi iyala wakemanananenuku; ituŋa dejima dimwakadata, Yehova Nzambi yenu wakatiyisha antu woma wenwenu, akayizaala hohu, mwomwanahoshiyi nanenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu, lelu hinukuyishila kumesu enu ninkisu niishiŋu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkisu, yokutiyilila kuleja kwaYehova Nzambi yenu kunukuyileja lelu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ishiŋu, yokubula kutiyilila kuleja kwaYehova Nzambi yenu, himukusenuka munjilayinukuyileja lelu, mulondeli akishi imwabulili kwiluka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
