          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "chaŋadima kwindi kumwila chuma nehi; chapadimowu hakweti kwindi chitela chakufwilaku; chidi neyi muntu wukunyamukila mukwawu hakumutaŋa, dimu mwaya ninsaŋu iyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
