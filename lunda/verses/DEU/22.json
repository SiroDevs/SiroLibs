          ]
        },
        {
          "text": "Neyi iyala wakawana chapadima wamujiki, abula kwotawu, hakumukwata, hakukama nindi, hiyakayiwana; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
