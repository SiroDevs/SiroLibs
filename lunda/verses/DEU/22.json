          ]
        },
        {
          "text": "Neyi hakekala chaŋadima wamujiki, anamwoti kudi iyala, iyala wacheŋi hakumuwana hamukala, hakukama nindi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
