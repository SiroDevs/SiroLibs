          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwakayitwali mwayedi wawukuchisu chamukalowu, mwakayasi malola afwi; mumbanda, muloŋa hatambekeluku, kutoŋa wadiŋi hamukala; iyala, muloŋa nasawishi dehi iŋodamukwawu; dichi chiwakafumisha chuma chatama mukachi kenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
