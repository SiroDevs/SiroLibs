              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi chaŋadima otawu dehi akamuwana kudi iyala mumpata, iyala hakumukwata naŋovu hakukama nindi; iyala akamayi nindi diyiwakafwa hohu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
