          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "muŋa wamuwana mumpata, nichaŋadima otawu watambeka, hikwadiŋi wakumwamwinaku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
