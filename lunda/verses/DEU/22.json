          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi akawana iyala wudi nakukama namumbanda wasumbuka dehi nanfumwindi, akafwi mwayedi wawu, niiyala nakami namumbanda, nimumbanda; dichi chiwakafumisha chuma chatama muIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
