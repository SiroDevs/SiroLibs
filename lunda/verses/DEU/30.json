  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "DEU 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakela yuma yejimiyi yinakushikeni dehi, ninkisu niishiŋudinukukushila kumesu eyi, wamba kaanuka mukachi kanyuza yejima kwanakutemwiniyi Yehova Nzambi yeyi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wamba kafunta cheŋi kudi Yehova Nzambi yeyi, wamba kovwahila izu dindi dakwila mwejima munakulejilelu, nineyi nianyaneyi, namuchima weyi wejima, nawumi weyiwejima; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu Yehova Nzambi yeyi wakabalumuna wuduŋu weyi, wakakutiyila wushona, wakafunta cheŋi nakukupompesha mukachi kanyuza yejima mwakupalaŋesheliyi Yehova Nzambi yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela tuhu, neyi kudiantu eyi ayoŋela dehi kwakumina iwulu, Yehova Nzambi yeyi wakayakwenoku nakukuleta nakukupompesha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yeyi wakakuletacheŋi mwituŋa daheteluwu ankakulula jeyi, wakadiheta; wakakwila chachiwahi, wakakuvulisha, wakabadika mwadiŋi ankakulula jeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yeyi wakakwalamisha kumuchima weyi nikunyichima yawanyaneyi, kulonda wakakeŋi Yehova Nzambi yeyi namuchima weyi wejima, nawumiweyi wejima, kulonda wakahandi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yeyi wakasha mashiŋuawa ejima hadi ayilumbu jeyi, nihadi akuhela, akukabishili. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwakafuntacheŋi, wakovwahili izu daYehova, hiwakela mwaya kuleja kwindi kwejima kuna kuleji lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yeyi wakakuvulishila nyidimu yakuchikasa cheyi yejima, nimuwakasemunwina, nimwakasemunwina yimuna yeyi, niyiwakadima, kulonda wakamoni kuwaha. Muloŋa Yehova Nzambi yeyi wakakutiya cheŋi kuwaha kukwila mwamuwahi, neyi chatiyiliyi ankakululajeyi kuwaha, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi wakovwahilaŋa izu daYehova Nzambi yeyi, nakuhembanikuleja kwindi, niyidika yindi, yanasonekuwu mumukandiwu wanshimbi; neyi wakabalumuka hiwakafunta cheŋi kudi Yehova Nzambi yeyi namuchimaweyi wejima, nawumi weyi wejima.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa izu dinukukuleja lelu hidakalaku, hididi kwakulehuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
            "verseOrgIds": [
              "DEU.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hididi mwiwulu mwaka wakeli neyi, Hinyi wakatukandaminamu akatu letelidu kulonda twakatiyumu twakelumuku? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hididi kwishinadi dakaluŋalwiji, mwaka wakeli neyi, Hinyi wakatuzambukila kaluŋalwiji akatu leteli dutwa katiyumu twakelumuku? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu idi didi kwakwihi naneyi nankashi, didinimukanwa keyi nimumuchima weyi, kulonda wilumu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala nakushiii dehi lelu kumesu eyi niwumi nikuwaha, nikufwanikutama; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanichi chinakuleji lelu kukeŋa Yehova Nzambi yeyi, wendimunjila jindi, wuhembi nikuleja kwindi niyidika yindi, niwuŋaji windi, kulonda wakahandi, wakasemunwini, kulonda Yehova Nzambi yeyi akakukoolekeshi mwituŋa diwukuya nakuheta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi muchima weyiwakabalumuka, kwonti kweyi kutiya, hiwakakokekela nimwacheŋi, hiwakadifukulakudi akishi nakuyipesha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "hinukuyishimwinamu lelu nami, Chalala mwakajilu muka hohu, himwakashakama mafuku amavulu mwituŋa diwukuzambuka Yodana diwukuya nakuhetaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
            "verseOrgIds": [
              "DEU.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natambiki niiwuluni iseki ekali ayinsahu jenu lelu, ami nakushili dehi kumesu eyi niwuminikufwa, ninkisu niishipu; dichi dinu tondaku wumi kulonda wuhandi, nineyi nianyaneyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.19",
            "verseOrgIds": [
              "DEU.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "wukeŋi Yehova Nzambi yeyi, wovwahili mwizudindi, wumulamati, muloŋa yena diyi wumi weyi, diyi mafuku eyi amavulu; kulonda wakashakami mwituŋa dasanyikililiyi Yehova ankakulula jeyi aAbarahama, naIsaka, naYakoba kuyinka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.20",
            "verseOrgIds": [
              "DEU.30.20"
            ]
          }
        }
      ]
    }
  ],
