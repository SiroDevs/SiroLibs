            "sid": "DEU 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.38",
            "verseOrgIds": [
              "DEU.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ilukaku lelu, wushi kumuchima, neyi Yehova diyi Nzambi, ninomu mumawulu, nimunu mwishina hamaseki; hikudi wacheŋuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.39",
            "verseOrgIds": [
              "DEU.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kahembaŋa chachiwahi yidika yindi nikuleja kwindi, kunukukuleja lelu, kulonda wakamoni kuwaha nineyi nianyaneyi akakulondela munyima, wakashakami mafuku amavulu mwituŋa dakukwinkayi Yehova Nzambi yeyi, haya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.40",
            "verseOrgIds": [
              "DEU.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
