          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dŋu nshimbi jashililiyi Mosi anyana kaIsarela; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.44",
            "verseOrgIds": [
              "DEU.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "dimu muwunsahu, nimuyidika, nimuwuŋaji, mwahosheliyi Mosi nawanyana kaIsarela hafuminuwu muEjipitu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.45",
            "verseOrgIds": [
              "DEU.4.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 4:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwishinadi daYodana, muchinekineki chatalaŋana naBetipeyori, mwituŋa daSihoni mwanta wawaAmori walukanu washakamini kuHeshiboni, atapiluwu kudi aMosi nawanyana kaIsarela hafuminuwu muEjipitu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.46",
            "verseOrgIds": [
              "DEU.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "atambwili ituŋa dindi hiyakudiheta, niituŋa daOgi mwantawa kuBashani walukanu, diwu anyanta awaAmori alukanu ayedi, adiŋi kwishinadi daYodana kwaselelaŋi itaŋwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.47",
            "verseOrgIds": [
              "DEU.4.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DEU 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "kufumisha kuArowenai wekalakunsa yachinekineki chaArinoni, lusu nikumpidi yaZiyona, diyi Herimoni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.48",
            "verseOrgIds": [
              "DEU.4.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "nachana chejima kwishinadi daYodana kumusela, lusu nikwijiya dakuchana, kwakunkumukila nyikandu yaPisiga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.49",
            "verseOrgIds": [
              "DEU.4.49"
            ]
          }
        }
