  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "DEU 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakafumishayi Yehova Nzambi yeyi nyuzoyu yikweti ituŋa dikukwinkayi Yehova Nzambi yeyi, nineyi hiwukuhiŋamu, hiwukushakamanimunyikala yawu nimumatala awu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwituŋa deyi dakukwinkayi Yehova Nzambi yeyi kudiheta wakaambulumu nyikala yeyi yisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaloŋeshinjila yeyi, ŋinza jetuŋa deyi dakukuswanishayi Yehova Nzambi yeyi wakadibalula yibalu yisatu, kulonda mbanji akatemukiluku. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya nsaŋu yambanji wakatemukilaku hakuhanda; yowu wukujaha mukwawu chakuluwukila, wabulili kumukwatila nkunyi hadiŋiyi wamumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.4",
            "verseOrgIds": [
              "DEU.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chidi neyi muntu wukuya mwisaŋa namukwawu nakutema nyitondu, chakwilayi nindi anonaŋa chizembi atapi mumutondu awutemi, chizembi hichikuzokoka mumuhinyi, hichikukwata mukwawu, hakufwa; wakatemukilakumukala wumu wayena nyikaloyu, wakahanda; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.5",
            "verseOrgIds": [
              "DEU.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukwakutendamashi wakenza kamuhapa mbanji hachidiyi neyena kumuchima, hakumukwata nanochu chiyinalehi njila, hakumutaŋa, hakufwa; kutoŋa yena hateleleli kufwaku, muloŋa hadiŋiyi wamumi hadiŋi nindi nankunyuku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.6",
            "verseOrgIds": [
              "DEU.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.6",
            "verseOrgIds": [
              "DEU.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chinukukulejela nami wakaambulumu nyikala yeyi yisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.7",
            "verseOrgIds": [
              "DEU.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi Yehova Nzambi yeyi wakakutoheshela ŋinza yeyi mwasanyikililiyi ankakulula jeyi, hakakwinka ituŋa dejima dakaniniyi kwinka ankakululajeyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi wunalami mukuleja kwejimiku kunukukuleja lelu nakwilamu, nakukeŋa Yehova Nzambi yeyi, nakwenda munjila jindi haya nyaka, henohuwakalunjikuku nyikala yeyi yisatu yakubombela hayeniyi yisatu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.9",
            "verseOrgIds": [
              "DEU.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulondaakabuli kupwekesha mashi amuntu wakadi muloŋa, mwituŋa deyi dakukwinkayi Yehova Nzambi yeyi kudiswana; kuchina kukoola mashi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi hadi muntu wukukwatila mukwawu nkunyi, wukumubelamina, hakumunyamukila, hakumutapila hawumi, hakufwa, niyenahakutemukila kumukala wumu wayena nyikaloyu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu awakulumpi akumukala wawu akatemeshi nakumutambwilaku, akamuhani kudi mukwakutendamashi kulonda akafwi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Disu deyi bayi dakamutala naluwuku, mashi amuntu wakadi muloŋa chiŋa wakayifumisha muIsarela, kulondawakashakami chachiwahi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi wakatutulula chinjikijilu chakwiluka nachu ŋinza yamukwenu, chashiluwu dehi ahashankulu muwuswana weyi iwakaswana mwituŋa dakukwinkayi Yehova Nzambi yeyi kudihetaku.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinsahu wumu kumunyamukila muntu nansaŋu yakuluwa nehi, hela namuloŋa himuloŋa wanavulumuniyi; nsaŋu akayikoleshela kutunwatwawayinsahu ayedi, hela kutunwa twawayinsahu asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi chinsahuwakutwamba wakamunyamukila muntu nakumushimuna wunsahu wakwilanindi neli chuma chatama; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu wenowu antu ayedi, asamuŋanasa muloŋa, akemani kumesu aYehova ni kumesu awatupristu nawansompeshiakekalaku hamafuku owu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ansompeshi akehujoli chachiwahi; neyi akamona chinsahu hichinsahu wakutwamba, nashimuni dehi wunsahuwakutwambila mana kwindi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "henohu mwakamwili mwomwakeŋa eliyi kumwila mana kwindi; dichi chiwakafumisha chuma chatama mukachi keyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.19",
            "verseOrgIds": [
              "DEU.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anashali akachitiya akatiya woma, akabuli kwila cheŋi mukachi keyichuma chatama chidi neyi ochu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.20",
            "verseOrgIds": [
              "DEU.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Disu deyi bayi dakatala naluwuku; wumi nawumi, disu nadisu, ŋi neji, chikasa nachikasa, mwendu namwendu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.21",
            "verseOrgIds": [
              "DEU.19.21"
            ]
          }
        }
      ]
    }
  ],
