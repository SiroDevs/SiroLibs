    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi lekenu nkunyi yejima, nimakasu ejima, niwufwikŋi, niichima, nikuhosha kwatama kwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.1",
            "verseOrgIds": [
              "1PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwilenu mayeli awuspiritu akadimakasu, neyi anyikeki anavwaliki katataka, kulonda mukuli nachu mushiki kuwamwinu; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.2",
            "verseOrgIds": [
              "1PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "neyi munatompi Mwanta nenu muwahi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenzaŋa kudi yena ilola dadumi, chalala adilekeli kudi antu, ilaŋa kudi Nzambi dakutonda, dalema. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.4",
            "verseOrgIds": [
              "1PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu nawa, hiyakuyituŋa mwikali itala dawuspiritu, neyi malola amomi, kulonda mwikali wupristu wajila, himulambu laŋa yimuna yakuketula yawuspiritu yakutiyisha nachu Nzambi kuwaha mudi Yesu Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.5",
            "verseOrgIds": [
              "1PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋaneli mumukanda nawu, Tiyenu hinukusha muZiyona ilola dakwiwombu dalema, datondewa, dalema wuseya; muntu wukumukuhwelela, hiyakumutiyisha nsonyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi enu mwakuhwelelaŋa mwamumona kulema nankashi; hakwila antu ajikwa nawu, Ilola dalekeli antuŋi dabalumukili kwikala namutu wewombu; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Ilola dakuhukana, nilwilola lwakudimbwisha. Muloŋa wena adimbukilaŋa kumazu nansaŋu yakujikwa kwawu; mwenomu dimu mwayifuukwililuwu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila enu mumuza watondewa, muwupristu wawanta, mumuchidi wajila, mumuza wambala waNzambi; kulonda mutiyakeshaŋa kashinshi kakeni kayena wayitambikili nindi mufumi mumwidima, mwiŋili muchejeji chindi chakuhayama. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu hamwaka himwadiŋi muzaku, ilaŋa katataka mwela dehi muza wambala waNzambi; hiyayitiyilili luwuku, ilaŋa katataka ayitiyila dehi luwi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu akwetu twwakeŋa a, nayilembeleli chimuneli enyi niakwakwenda mwambala, nami lekenu kufwila kwachisemwa chaheseki kwatama, kwalwishaŋa nawumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela ajentili ayituŋalaŋa nawu mwelaŋa chatama, shakamenu chalumbuluka mukachi kawu; kulonda chakumonawu nyidimu yenu yayiwahi akamulemeshi Nzambi mwifuku dakumona kukala.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ovwahilenu mawanta ejima akubuzawu antu, hansaŋu yaMwanta Yesu; hela mwanta walukanu, Muloŋa diyi wabadika; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.13",
            "verseOrgIds": [
              "1PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela anguvulu akutemeshawu kudi yena mwanta, nindi ababeshi akwakwila chatama, ahameki akwakwila chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.14",
            "verseOrgIds": [
              "1PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa dichi chanakeŋiyi Nzambi, nindi mumweneshi kuyamba kwawantu akadi maana nakwila chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.15",
            "verseOrgIds": [
              "1PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Himudi anduŋuku; hakwila chimunabuli wuduŋu bayi chila chuma chakubuta nachu nkunyuku; shakamenu neyi anduŋu jaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.16",
            "verseOrgIds": [
              "1PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lemeshenu antu ejima. Keŋenu ana kwenu. Mutiyenu Nzambi woma. Lemeshenu mwanta wetuŋa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu aŋamba, ovwahilenu anyanta jenu nawoma hohu; bayi amawahi nawawunda hohuku, chiŋa niazuwa nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.18",
            "verseOrgIds": [
              "1PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi muntu wukwiteja kumona yihuŋu, nakukaba chakadi muloŋa, nanochu chadiyi kumesu aNzambi, dichi chachiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.19",
            "verseOrgIds": [
              "1PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi hakuyetelawu kuluwa mukudiwunjika hichikweti kuyihamekaku; hakwila neyi hakuyikabishilawu kuloŋa mukudiwunjika, chumichi chatiyishaŋa Nzambi kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.20",
            "verseOrgIds": [
              "1PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chayitambikililuwu, muloŋa Kristu niyena wayimweneni yihunu, wayishiyilili chuma chakutalilahu, kulonda mwendi mumahaji indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.21",
            "verseOrgIds": [
              "1PE.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena havulumwinuku; mukanwa kindi himwadiŋi makasuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena chanamutukiluwu, hafuntishili cheŋi matukaku; chamweniyi yihuŋu hazuwiluku, ilaŋa wadikunjikili kudi yena wasompeshaŋa chaloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.23",
            "verseOrgIds": [
              "1PE.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena yomweni wasendeli nyiloŋa yetu mumujimba windi hamutondu, kulonda etu tunafwi dehi kunshidi tuhandili kuloŋa; anayikuswishi nanyinkakambu yindi yena.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.24",
            "verseOrgIds": [
              "1PE.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.24",
            "verseOrgIds": [
              "1PE.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1PE 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mwapwapukilaŋa neyi anyikoku, ilaŋa katataka munafunti kudi Kabiŋa, Mukwakuhemba wumi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.25",
            "verseOrgIds": [
              "1PE.2.25"
            ]
          }
        }
      ]
    }
