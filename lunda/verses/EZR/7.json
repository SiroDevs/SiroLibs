    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulondela hayumiyi mumafuku awanta wamwanta wakuPeresi Aratasheshe, kwenjili Ezera mwana kaSeraya, Seraya mwana kaAzariya, Azariya mwana kaHilikiya, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilikiya mwana kaShalumi, Shalumi mwana kaZadoki, Zadoki mwana kaAhitubi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitubi mwana kaAmariya, Amariya mwana kaAzariya, Azariya mwana kaMerayoti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Merayoti mwana kaZerahiya, Zera hiya mwana kaUzi, Uzi mwana kaBuki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buki mwana kaAbishuwa, Abishuwa mwana kaFwineha si, Fwineha si mwana kaEleyazari, Eleyazari mwana kakapristu muneni Aroni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeniwu Ezera hakufuma kuBabiloni, hakuyaku. Wadiŋi nsoneki weluka chachiwahi nshimbi jaMosi, jaheniyi Yehova Nzambi yaIsarela. Mwanta wamwinkeli yalombeliyi yonsu, mwomwaya chikasa chaYehova Nzambi yindi chadiŋi hadi yena.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mwatutulwiluwu mukanda wenkeliyi mwanta Aratasheshe kapristu Ezera nsoneki, yowu nsoneki yamazu akuleja kwaYehova, niayidika yindi yenkeliyi aIsarela, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Aratasheshe, mwanta wawanyanta, nasonekeli kapristu Ezera, nsoneki yanshimbi yaNzambi wewulu, kolaku, nsaŋu oyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nashumu dehi lushimbi lwakwila nami, aIsarela ejima, niatupristu twawu, niaLevi, ekala mumatuŋami, anakeŋi kuya kuYerusalema chakunyichima yawu awenawu, akayi naneyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa eyi anakutemeshi kudi mwanta nawakwakumuleja maana atanu nayedi, kulonda wakehujoli nsaŋu jakuYuda naYerusalema, mwaya nshimbi jaNzambi yeyi ŋawudi naju mumakaseyi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda wakatwali siliva nawuru, wenkeluwu Nzambi yaIsarela washakama kuYerusalema kudi mwanta, nawakwakumuleja maana; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasiliva yejima, nawuru wejima, wuwakawana muwuloŋu waBabiloni wejima, hamu nahimulambu wawantu nawatupristu wakumuchima, wakalambwilawu itala daNzambi yawu wekala kuYerusalema, chakunyichima yawu awenawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wakalandaŋa swayi namali awa nyana kaŋombi amayala, niyizamba yanyikoku, ninyana kanyikoku, hamu nanyilambu yawu yawuŋa nanyilambu yawu yakuhuŋununa, wakayilambulaŋa hakameŋa kakwitala daNzambi yenu wekala muYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwonsu muwakamona eyi nawana kweyi nenu munawahi kwila nasiliva nawuru wakashalaku, kelenu mwaya muchima waNzambi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyu yuma yanakwinkuwu yakukalakala nachu mudimu wetala daNzambi yeyi, wakayishikŋaŋa kumesu aNzambi yaYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yidika yonsu yakamwekana yakwitala daNzambi yeyi yakwila chiŋa eyi wakahanaku yuma, wakayinonaŋa kwitala damwanta dakuswekela yuma yalema, hiwakahana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami aweni, yami mwanta Aratasheshe, nashumu dehi lushimbi lwawakwakuhemba yuma yalema ejima adi mwishinadi dakaloŋa, lwakwila nami, Mwakeli swayi hohu mwonsu mwakakeŋayi kapristu Ezera, nsoneki yanshimbi jaNzambi wewulu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.21",
            "verseOrgIds": [
              "EZR.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela chakumwinka ntalenta jasiliva nkulakaji, hela ngungungu jatidiku nkulakaji, hela nswaha jeneni javinyu nkulakaji, hela nswaha jeneni jamanji nkulakaji, hakwila muŋwa hichikweti kuwesekaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chonsu chakayilejawu kudi Nzambi wewulu, akelili itala daNzambi wewulu nakalemesha; indi matuŋa amwanta nawanyanindi amoni tuhu ndombu? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.23",
            "verseOrgIds": [
              "EZR.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunayilejumu nawa netu, atupristu nawaLevi, nawakwakwimba tumina, nawakwakuhemba kuyisu, nawaNetini, hela akalakalaŋa mudimu wetala daNzambi idi, chinjila kuyifutisha hela himulambu, hela kasitomi, hela mwombu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila eyi Ezera, wakakunjikaŋa akwakuhosha nyiloŋa nawansompeshi mwomwaya maana aNzambi yeyi iwekala nawu, kulonda akasompeshaŋa antu ejima adi mwishinadi dakaloŋa, eluka nshimbi jaNzambi yeyi; wabula kumwiluka mwakamulejaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.25",
            "verseOrgIds": [
              "EZR.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaleka kwila nshimbi jaNzambi yeyi, hela nshimbi yamwanta, akamusompeshi swayi, hela chakumujaha, hela chakumuhaŋa, hela chakumutambula yuma yindi, hela chakumusha mukaleya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
              "EZR.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
              "EZR.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisu kisu Yehova Nzambi yawankakulula jetu, nashichuma chi kuma hichi mumuchima wamwanta, kulonda awahishi itala daYehova wekala muYerusalema diikali dalubanji; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanmwekesheli luwi kumesu amwanta, nawakwakumuleja maana, nawatulamba twamwanta alema. Hinukudikolesha nachikasa chaYehova Nzambi yami chadiŋi hadami, hinukunonanona mudi aIsarela awakulumpi akuya nanami.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        }
      ]
    }
  ],
