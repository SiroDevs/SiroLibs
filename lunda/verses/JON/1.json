        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova denjili kudi mwana kaAmitayi Yona, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.1",
            "verseOrgIds": [
              "JON.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Nyamukaku, wuyi kuNineve, mukala wuna weneni, wakayibidiki; Muloŋa kutama kwawu kunakandami dehi kwiwulu kunashiki kudami. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iloŋa Yona kwindi wanyamukili akayi kuTarashishi, akamutemuki Yehova. Wayili kuYopa, kwenoku waweni watu hiwukuya kuTarashishi. Wafweteli mwombu wawu, wepililumu, kulonda akayi nawu kuTarashishi afumi kudi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.3",
            "verseOrgIds": [
              "JON.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iloŋa Yehova watemesheli mpepela yeneni kukaluŋalwiji, meji hiyakusweja nankashi kuzuwa, niwatu wakeŋa eli kubaluka. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.4",
            "verseOrgIds": [
              "JON.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakwendesha watu atiyili woma, hiyakukaloka wejima wawu kudi akishi awu; niyuma yadiŋi muwatu hiyakuyumbila mumeji kulonda awupepeshi. Iloŋa Yona wadiŋi weŋila dehi mukachi kawatu; nakami dehi, hadi ninamutulu twatweni. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.5",
            "verseOrgIds": [
              "JON.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawatu wayili kudi yena, hakumwila nindi, Ehee! Eyi Satulu! Wudi nakwila ŋahi? Hindukaku, tambikaku Nzambi yeyi, hadaha Nzambi wukututoŋahu, kulonda tubuli kujilumuka.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.6",
            "verseOrgIds": [
              "JON.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakudileja wejima wawu, nawu, Tuyenu tusakulenu nachinjikijilu chakusakula nachu, kulonda twiluki natukojeji chumichi chatama. Nochu asakwili nachinjikijilu, amukwatili Yona. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.7",
            "verseOrgIds": [
              "JON.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwila nawu, Atuleji mwani, chumichi chatama chinatuwani hanka? Indi eyi mudimu weyi wanka? Wafuma kudihi? Kwituŋa denu kudihi? Indi eyi muyakwamuza wanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.8",
            "verseOrgIds": [
              "JON.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wayilili nindi, Ami nikaHeberu, namwakamaŋa Yehova, Nzambi wamawulu, diyi waleŋeli nikaluŋalwiji namaseki awuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.9",
            "verseOrgIds": [
              "JON.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu amayala hiyakutiya woma waweni, hiyakumwila nawu, Indi eyi dinu wuneli ŋahi? Muloŋa owu amayala elukili nawu yena hakumutemuka Yehova, Muloŋa yena wayilejelumu.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.10",
            "verseOrgIds": [
              "JON.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwila nawu, Ndochu etu tukukwila ŋahi kulonda tumoni meji kumwena? Muloŋa meji hiyakusweja kuzuwa nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.11",
            "verseOrgIds": [
              "JON.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JON 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wayilili nindi, Nnyamunenu kwenu, muŋumbili mumeji; mukumona meji akumwena, Muloŋa neluki kwami nami iyi mpepela yeneni nankashi yinayiwani hansaŋu yamami. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.12",
            "verseOrgIds": [
              "JON.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JON 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu amayala avuwili naŋovu nawu afunti cheŋi kuchi kumu, kutwesha nehi, muloŋa meji hiyakusweja nankashi kuzuwa nakufuma kwakuyawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.13",
            "verseOrgIds": [
              "JON.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JON 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wena abileleli kudi Yehova, nawu, Tunalembi, eyi Yehova, tunalembi, bayi tujilumuka nakukoola wumi wayeniwu muntuku, bayi wututwika muloŋa wamukunkulwayuku. Muloŋa eyi Yehova wuneli kweyi mwejima mwaya muchima weyi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.14",
            "verseOrgIds": [
              "JON.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JON 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu amunyamwini Yona, amuumbilili mumeji, nimeji elili be-te-te, alekeli kuzuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.15",
            "verseOrgIds": [
              "JON.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JON 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu amayala hiyakumutiya Yehova woma nankashi, hiyakumuketwila Yehova chimuna, hiyakudishiilamu.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JON 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.16",
            "verseOrgIds": [
              "JON.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JON 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova waloŋesheli inshi muneni kulonda amuminyi Yona. Yona wadiŋi mwivumu danshi mafuku asatu nimwaana niwufuku.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        }
      ]
    }
  ],
