  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "2CH 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamanishiluwu kwila yumiyi yejima, aIsarela ejima adiŋuku hiyakufuma munyikala yawaYuda, hiyakuya nakuhumona tuposhitwakupeshela, nakutema ninyiyombu, hiyakuhumona yinaŋanaŋa natumeŋa muYuda namuBenjamini mwejima, nimuEfweremi naManase nawa, nichakisaŋenuwu yejima. Anyana kaIsarela hiyakufunta wejima wawu, kwawu kwahetawu munyikala yawu awenawu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hakuloŋesha mazanvu awatupristu nawaLevi, awa nezanvudawu, awa nezanvu dawu, mwomukwikalila nyidimu yawu wejima wawu, niatupristu niaLevi, kulonda elapa nyilambu yakushita ninyilambu yakuwunda, akalakalaŋa, asakililaŋa, ahamekaŋa muyisu yakuchilombu chaYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waambwiluku nawa iseka dayuma yayomweni mwanta, danyilambu yakushita, yoyi nyilambu yakushita yabudidi namelela, yajisabata, niyatukweji twatwiha, niyayawija yakushiika dehi, mwomwasonekeluwu munshimbi jaYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuleja antu ashakamini muYerusalema kuhana iseka dayuma yawatupristu nawaLevi, kulonda wena akatweshi kudinka kumudimu wanshimbi jaYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiyatiyakeninsaŋu oyu, anyana kaIsarela hiyakuhana nankashi yakudya yatachi, nitidiku, nivinyu, nimanji, niwuchi, niyuma yejima yasoŋasoŋaŋa mumaha. Aleteli nawa nankashi iseka yamwikumi yayuma yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela naYuda ashakamini munyikala yaYuda aleteli nawa amwikumi awaŋombi nanyikoku, niyamwikumi yayuma yakukunjika dehi yamukunjikililu wuYehova Nzambi yawu, hiyakuyilumbeka nyilumba nyilumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyilumba hiyakuyitachika mukakweji kamuchisatu, hiyakuyimanisha mukakweji kamuchitanu nachiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjiluwu aHezekiya nawatula mbana kutala nyilumba, hiyakukiswila Yehova nawantu indi nkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hakwihula atupristu nawaLevi nsaŋu yanyilumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu mune niAzariya, wakwivumu daZadoki, hakumuleja nindi, Kufumisha hatachikiluwu antu kuleta nyilambu mwitala daYehova, tunadyi, tunekuti, tunashiyuhu yayivulu, muloŋa Yehova nakiswili antu indi nkisu; yinashaluhu yoyi mpawuyejimiyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hakuyileja kuloŋesha tupeka mwitala daYehova; hiyakutuloŋesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwiŋijimu ninyilambu, niyamwikumi, niyuma yakunjikiluwu antu, chakashinshi. KaLevi Konaniya diyi wadiŋi nyuli wakutalayumiyi, mana kwindi Shimeyi diyi wamulondeli hanyima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiYehiyeli, niAzaziya, niNahati, niAsaheli, niYerimoti, niYozabadi, niEliyeli, nilsimakiya, niMahati, niBenaya, diwu adiŋi akwakutala nyidimu chakuyilejaŋa kudi Konaniya, namana kwindi Shimeyi, ayikunjikiluku kudi mwanta Hezekiya nanyuli wakwitala daNzambi Azariya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koremwana kaImina kaLevi, mukwakuhemba kuchisu chakumusela, diyi watalilaŋa nyilambu yaletelaŋawu antu kudi Nzambi chakunyichimayawu, kulonda kwanjaŋanaŋa nyilambu yaYehova niyuma yasweja kujila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atalilaŋa kudi yena Edeni niMiniyamini niYeshuwa, niShemaya, niAmariya, niShekaniya, munyikala yawatupristu, mumudimu wawuwayikuhwelelawu wakuyinkaŋa ana kwawu mwahita mazanvu awu, helaalema hela akadi kulema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulunjikaku amayala asonekeluwu nyiyachiyawu, kufumisha kudi anyaka yisatu niakubadikamu, wowu ejima eŋililaŋa mwitala daYehova, mwekalila mudimu wefuku, kulonda kwilaŋa nyidimuyawu yayishiikawu mwekalila mazanvu awu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "niatupristu asonekeluwu nyiyachi yawu mwahita mavumu awankakulula jawu, niaLevi akufumishakunyaka makumi ayedi niakubadikamu, hanyidimu yawu yayishiikawu mwekalila mazanvu awu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni anyanawu anyanya, niaŋodi jawu, nianyanawuamayala, ni anyanawu awambanda, ejima, mwahita chipompelu chejima, asonekeluwu kunyiyachi yawu; muloŋa adijilikili kumudimu wawu wayikuhwelela wuchakujila hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikudi atupristu anyana kaAroni adiŋi mumaha amumpata jadiŋi munyikala yawu yejima, hamukala hamukala, kwadiŋi nawa amayala atenenuwu majina, kulonda enkaŋ atupristu amayala maseka, kulonda enkaŋa niaLevi asonekeluwu nyiyachi yawu ejima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimu mweliliyi Hezekiya mwahita Yuda yejima. Wakoŋelaŋa chachiwahi chaloŋa chakashinshi kumesu aYehova Nzambi yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyidi muyejima yatachikiliyi yakukalakela itala daNzambi, nimunshimbi, nimukuleja, chakukeŋakeŋa Nzambi yindi, wayilili namuchima windi wejima, wayimweni kulumbuluka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
      ]
    }
  ],
