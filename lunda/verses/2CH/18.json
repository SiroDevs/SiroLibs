          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu mwanta wakuSiriya waleja dehi awakulumpi amakálu indi, nindi, Bayi mudasa nawakadi kulema hela nawalemaku, chiŋa namwanta wa waIsarela hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.30",
            "verseOrgIds": [
              "2CH.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi amakálu chamwenuwu Yehoshafwati, hiyakwila nawu, Diyi mwanta wawaIsarela. Hiyakufunta kwayilaŋwu, kulonda alwi nindi. Yehoshafwati hakubidika, Yehova hakumukwasha. Yehova hakuyifumisha kudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi amakálu chana monu wukomana hidiyi mwanta wa waIsarelaku, hiyakufunta mwayilaŋawu nakumuhaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.32",
            "verseOrgIds": [
              "2CH.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wumu hakwevula wuta windi chakadi kwiluka, hakumusowa mwanta wawaIsarela hahumaŋena wuvwalu wayikunu. Yena hakumwila mukwakwendesha ikalu, nindi, Teŋulukaku, wunfumishi munjita, chinankati nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.33",
            "verseOrgIds": [
              "2CH.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denodu ifuku njita yaswejeli; mwanta wa waIsarela wadikolesheli mwikalu dindi adasi nawaSiriya nikumelela. Chelili itaŋwa hidikuya nakuholoka hakufwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.34",
            "verseOrgIds": [
              "2CH.18.34"
            ]
          }
        }
