    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaYuda Yehoshafwati wafuntili lewitala dindi kuYerusalema chamwena.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.1",
            "verseOrgIds": [
              "2CH.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafwati washakamini kuYerusalema; hakuya cheŋi mukachikawantu, kufumisha kuBerisheba kushika nikwituŋa daEfweremi damapidi, hakuyifuntisha cheŋi kudi Yehova Nzambi yawankakulula jawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.4",
            "verseOrgIds": [
              "2CH.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakusha ansompeshi mwituŋa, mwahita nyikala yampwembu yejima yamuYuda hamukala hamukala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.5",
            "verseOrgIds": [
              "2CH.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila ansompeshi nindi, Toŋojokenucha chiwahi chimukwila; muloŋa himwasompeshelapa muntuku, mwamusompeshelapa Yehova, muŋa diyi mudi nakusompeshaŋ nindihamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.6",
            "verseOrgIds": [
              "2CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu ikalenu nawoma waYehova, babelenu yimukwila, muloŋa kudi Yehova Nzambi yetu hikwekala hela kuheŋ, hela kwakama antu kumesu, hela kutambula yamukunkuluku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "NimuYerusalema nawa Yehoshafwati washilumu aLevi nawatupristu, niakulumpi akumavumu awankakulula jawaIsarela, kulonda wuŋiji waYehova, ninyiloŋa. Hiyakufunta kuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyileja nindi, Mwakelaŋa mwomwenimu nakumutiya Yehova woma, nakashinshi, namuchimawalala chikupu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi ana kwenu ashakama munyikala yawu akaholoka kudenu namuloŋa wambandu, hela walushimbi, hela wakuleja, hela wayidika, hela wawuŋaji, mwakayikaandaŋa kulonda akabuli kutanyakudi Yehova, kuchina ndombu yikuyiwana ninenu niana kwenu; ilenumwenimu kulonda mwakabuli kutanya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu kapristu muneniAmariya diyi wukuyitalaŋa kunsaŋu jaYehova jejima; mwana kalshimeli Zebadiya, nyuli yakumutaŋa waYuda, diyi wukuyitalapa kunsaŋu jamwanta jejima; aLevi nawa diwu akwikala akwakuyimena kumesu enu. Dikwatishenu, Yehova ekali namuwahi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        }
      ]
    }
  ],
